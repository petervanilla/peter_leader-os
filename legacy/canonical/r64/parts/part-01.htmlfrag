<style>
      :root { color-scheme: light; font-family: Inter, Pretendard, system-ui, sans-serif; }
      * { box-sizing: border-box; }
      body { margin: 0; background: #f6f7f8; color: #16181d; }
      .shell { display: grid; grid-template-columns: 260px 1fr; min-height: 100vh; }
      .sidebar { border-right: 1px solid #e7e8eb; background: #fff; position: sticky; top: 0; height: 100vh; overflow: hidden; display:flex; flex-direction:column; }
      .sidebar-head { position: sticky; top: 0; z-index: 6; background: inherit; padding: 24px 18px 16px; border-bottom: 1px solid #e7e8eb; }
      .sidebar-nav-scroll { flex:1 1 auto; min-height:0; overflow:auto; padding: 14px 18px 24px; }
      .brand { font-weight: 800; font-size: 20px; margin-bottom: 8px; }
      .principle { font-size: 12px; color: #6b7280; line-height: 1.45; margin: 0; }
      nav { display: grid; gap: 5px; }
      .nav-section { display:grid; gap:4px; margin: 2px 0 12px; }
      .nav-label { padding: 8px 12px 3px; color:#9aa0a8; font-size:10px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
      nav a { text-decoration: none; color: #30343b; padding: 10px 12px; min-height:40px; border-radius: 10px; font-size: 14px; display:flex; align-items:center; justify-content:space-between; gap:8px; }
      nav a:hover, nav a.active { background: #f0f2f5; font-weight: 700; }
      nav a[aria-current="page"] { background:#eceff3; color:#111827; }
      nav a.review { margin-top: 8px; border: 1px solid #e1e4e8; }
      nav a.addons { margin-top: 4px; }
      main { min-width: 0; }
      .topbar { min-height: 68px; background: rgba(255,255,255,.92); backdrop-filter: blur(10px); border-bottom: 1px solid #e7e8eb; display: flex; align-items: center; justify-content: space-between; gap:16px; padding: 10px 32px; position: sticky; top: 0; z-index: 10; }
      .topbar-title { display:flex; align-items:center; gap:10px; min-width:0; }
      .workspace-badge { max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; border:1px solid #e1e4e8; border-radius:999px; padding:5px 8px; color:#6b7280; font-size:11px; }
      .topbar-actions { display:flex; align-items:center; justify-content:flex-end; gap:8px; flex-wrap:wrap; }
      .health { font-size:10px; color:#6b7280; padding:4px 7px; border-radius:999px; background:#f4f5f7; }
      .count-badge { display:inline-flex; min-width:18px; height:18px; align-items:center; justify-content:center; margin-left:4px; border-radius:999px; background:#16181d; color:#fff; font-size:10px; }
      .content { padding: 32px; max-width: 1180px; margin: 0 auto; }
      h1 { font-size: 30px; margin: 0 0 8px; }
      .sub { color: #6b7280; margin: 0 0 28px; }
      .grid { display: grid; grid-template-columns: 2fr 1fr; gap: 18px; }
      .card { background: #fff; border: 1px solid #e7e8eb; border-radius: 16px; padding: 20px; }
      .card h2 { font-size: 15px; margin: 0 0 14px; }
      .attention { display: grid; gap: 10px; }
      .attention-item { border: 1px solid #eceef1; border-radius: 12px; padding: 14px; display: grid; grid-template-columns: 78px 1fr auto; gap: 12px; align-items: center; }
      .attention-actions { display:flex; align-items:center; gap:8px; }
      .verb { font-size: 11px; font-weight: 800; letter-spacing: .06em; color: #4b5563; }
      .why { font-size: 13px; color: #6b7280; margin-top: 3px; }
      details { margin-top: 8px; }
      details summary { cursor: pointer; font-size: 12px; color: #4b5563; }
      .evidence-list { font-size: 12px; color: #6b7280; margin-top: 8px; display: grid; gap: 4px; }
      .status { font-size: 12px; color: #6b7280; }
      .metric { display: flex; align-items: baseline; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid #f0f1f3; }
      .metric:last-child { border-bottom: 0; }
      .metric strong { font-size: 22px; }
      .pill { display: inline-flex; padding: 5px 8px; border-radius: 999px; background: #f2f4f6; font-size: 11px; font-weight: 700; }
      .safe { margin-top: 14px; font-size: 12px; line-height: 1.5; color: #6b7280; padding: 12px; background: #f8f9fa; border-radius: 10px; }
      [data-page][hidden] { display: none !important; }
      .review-list { display: grid; gap: 14px; }
      .review-card { background: #fff; border: 1px solid #e7e8eb; border-radius: 16px; padding: 18px; }
      .review-head { display: flex; justify-content: space-between; gap: 14px; align-items: flex-start; }
      .review-meta { font-size: 12px; color: #6b7280; }
      .review-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
      button { border: 1px solid #dfe2e6; background: #fff; color:#16181d; border-radius: 9px; padding: 8px 10px; min-height:38px; cursor: pointer; font: inherit; font-size: 12px; }
      button.primary, button.selected { background:#16181d; color:#fff; border-color:#16181d; }
      button:focus-visible, a:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible { outline:3px solid rgba(37,99,235,.28); outline-offset:2px; }
      button:not(.primary):not(.selected):hover { background:#f4f5f7; color:#16181d; }
      button.primary:hover, button.selected:hover { background:#2b2f36; color:#fff; border-color:#2b2f36; }
      button:disabled { background:#f4f5f7; color:#9aa0a8; border-color:#e5e7eb; cursor:not-allowed; }
      .field { display: grid; gap: 6px; margin-top: 12px; }
      .field label { font-size: 12px; font-weight: 700; }
      .field input, .field textarea, .field select { width: 100%; border: 1px solid #dfe2e6; border-radius: 9px; padding: 9px 10px; min-height:42px; font: inherit; background:#fff; color:#16181d; }
      .review-result { margin-top: 12px; font-size: 12px; padding: 10px 12px; border-radius: 9px; background: #f6f7f8; }
      .stat-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; margin-bottom:18px; }
      .stat { background:#fff; border:1px solid #e7e8eb; border-radius:14px; padding:16px; }
      .stat strong { display:block; font-size:24px; margin-top:6px; }
      .people-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
      .person-card { background:#fff; border:1px solid #e7e8eb; border-radius:16px; padding:18px; }
      .person-card h3 { margin:0 0 4px; font-size:16px; }
      .context-list { display:grid; gap:8px; margin-top:14px; font-size:13px; }
      .context-row { display:grid; grid-template-columns:110px 1fr; gap:10px; }
      .context-row span:first-child { color:#6b7280; }
      .agenda { display:grid; gap:10px; }
      .agenda-item { background:#fff; border:1px solid #e7e8eb; border-radius:12px; padding:14px; }
      .agenda-item .type { font-size:11px; font-weight:800; color:#6b7280; letter-spacing:.05em; }
      .flow { display:grid; gap:10px; }
      .flow-step { background:#fff; border:1px solid #e7e8eb; border-radius:12px; padding:14px; }
      .flow-step .k { font-size:11px; font-weight:800; color:#6b7280; letter-spacing:.05em; }
      .decision-card { background:#fff; border:1px solid #e7e8eb; border-radius:16px; padding:18px; margin-bottom:14px; }
      .addon-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
      .addon-card { background:#fff; border:1px solid #e7e8eb; border-radius:16px; padding:18px; }
      .chips { display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; }
      .chip { background:#f1f3f5; border-radius:999px; padding:5px 8px; font-size:11px; }
      .trust-path { display:flex; gap:8px; align-items:center; flex-wrap:wrap; font-size:12px; color:#6b7280; margin-top:14px; }
      .report-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
      .ask-box { display:grid; gap:12px; }
      .ask-response { background:#fff; border:1px solid #e7e8eb; border-radius:14px; padding:16px; min-height:100px; }
      .phase-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; }
      .phase { background:#fff; border:1px solid #e7e8eb; border-radius:14px; padding:14px; }
      .state-badge { display:inline-flex; border-radius:999px; background:#f1f3f5; padding:4px 7px; font-size:10px; font-weight:800; }
      .skill-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:14px; }
      .skill-card { background:#fff; border:1px solid #e7e8eb; border-radius:16px; padding:18px; }
      .capture-grid { display:grid; grid-template-columns:180px 1fr auto; gap:10px; align-items:end; }
      .capture-list { display:grid; gap:8px; margin-top:12px; }
      .capture-item { display:flex; gap:10px; align-items:flex-start; justify-content:space-between; border:1px solid #eceef1; border-radius:10px; padding:10px 12px; font-size:13px; }
      .evidence-picker { display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }
      .evidence-picker button { min-height:32px; padding:5px 8px; font-size:11px; }


      .billing-summary { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; margin-bottom:18px; }
      .billing-stat { background:#fff; border:1px solid #e7e8eb; border-radius:14px; padding:16px; }
      .billing-stat span { color:#6b7280; font-size:12px; }
      .billing-stat strong { display:block; margin-top:6px; font-size:22px; }
      .billing-layout { display:grid; grid-template-columns:1.1fr .9fr; gap:18px; }
      .billing-mode { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; margin-top:12px; }
      .billing-mode button { text-align:left; min-height:72px; padding:12px; }
      .billing-mode button.selected { border-color:#111827; box-shadow:0 0 0 1px #111827 inset; }
      .billing-mode button strong { display:block; margin-bottom:4px; }
      .billing-mode button span { display:block; font-size:11px; opacity:.78; line-height:1.4; }
      .billing-table-wrap { overflow:auto; border:1px solid #eceef1; border-radius:12px; }
      .billing-table { width:100%; border-collapse:collapse; min-width:620px; font-size:12px; }
      .billing-table th, .billing-table td { padding:11px 12px; border-bottom:1px solid #eef0f2; text-align:left; }
      .billing-table th { color:#6b7280; background:#fafbfc; font-weight:700; }
      .billing-table tr:last-child td { border-bottom:0; }
      .billing-amount { font-weight:800; white-space:nowrap; }
      .billing-amount.credit { color:#166534; }
      .billing-amount.debit { color:#991b1b; }
      .billing-request, .billing-key { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; padding:12px 0; border-bottom:1px solid #eef0f2; }
      .billing-request:last-child, .billing-key:last-child { border-bottom:0; }
      .billing-warning { border:1px solid #f0d9a4; background:#fff9e9; color:#7c4a03; border-radius:12px; padding:12px 14px; font-size:12px; line-height:1.5; }
      .billing-architecture { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin-top:12px; }
      .billing-architecture > div { border:1px solid #e7e8eb; border-radius:12px; padding:12px; font-size:12px; line-height:1.45; }
      .billing-architecture strong { display:block; margin-bottom:5px; }
      .runtime-mode-card { margin:0 0 18px; background:#fff; border:1px solid #e2e5e9; border-radius:14px; padding:14px 16px; }
      .runtime-mode-head { display:flex; align-items:center; justify-content:space-between; gap:14px; }
      .runtime-mode-copy { display:grid; gap:3px; }
      .runtime-mode-copy span { color:#6b7280; font-size:12px; }
      .runtime-mode-actions { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
      .mode-badge { display:inline-flex; align-items:center; border-radius:999px; background:#eef1f4; color:#4b5563; padding:5px 8px; font-size:10px; font-weight:800; letter-spacing:.04em; }
      .mode-badge.live { background:#eaf7ee; color:#166534; }
      .mode-badge.connecting { background:#fff7df; color:#854d0e; }
      .mode-badge.signed-in { background:#eef2ff; color:#3730a3; }

      .today-welcome { margin:0 0 16px; padding:18px 20px; border:1px solid #e5e7eb; border-radius:16px; background:linear-gradient(135deg,#ffffff,#f7fafc); display:grid; gap:5px; }
      .today-welcome[hidden] { display:none !important; }
      .today-welcome .greeting { font-size:14px; font-weight:700; color:#667085; }
      .today-welcome h2 { margin:0; font-size:22px; letter-spacing:-.02em; }
      .today-welcome p { margin:0; color:#667085; line-height:1.55; }
      .first-use { margin-top:12px; padding:16px; border:1px solid #dfe4ea; border-radius:14px; background:#fbfcfd; display:grid; gap:14px; }
      .first-use[hidden] { display:none !important; }
      .first-use-head { display:grid; gap:5px; }
      .first-use-head strong { font-size:18px; }
      .first-use-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
      .first-use textarea { min-height:110px; resize:vertical; width:100%; border:1px solid #d8dde4; border-radius:10px; padding:10px; font:inherit; box-sizing:border-box; }
      .first-use-plan { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
      .first-use-plan-item { border:1px solid #e5e7eb; border-radius:12px; padding:12px; display:grid; gap:6px; background:#fff; }
      .first-use-status { color:#667085; font-size:13px; }
      .first-use-status.error { color:#b42318; }
      .personal-home { margin-top:12px; border-top:1px solid #edf0f2; padding-top:12px; display:grid; gap:10px; }
      .personal-home[hidden] { display:none !important; }

      .preference-panel { border:1px solid #e2e5e9; border-radius:12px; background:#fff; overflow:hidden; }
      .preference-panel summary { cursor:pointer; list-style:none; padding:10px 12px; display:flex; align-items:center; justify-content:space-between; gap:10px; font-size:12px; font-weight:800; }
      .preference-panel summary::-webkit-details-marker { display:none; }
      .preference-version { color:#6b7280; font-size:10px; font-weight:700; }
      .preference-form { padding:12px; border-top:1px solid #edf0f2; display:grid; gap:12px; }
      .preference-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; }
      .preference-grid .field { margin-top:0; }
      .working-row { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
      .weekday-row, .notification-row { display:flex; flex-wrap:wrap; gap:8px; }
      .weekday-row label, .notification-row label { display:inline-flex; align-items:center; gap:5px; min-height:32px; padding:5px 8px; border:1px solid #e2e5e9; border-radius:9px; background:#fafbfc; font-size:11px; color:#30343b; }
      .preference-actions { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
      .preference-status { font-size:11px; color:#59616d; line-height:1.45; }
      .preference-status.error { color:#b42318; }
      .personal-head { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; flex-wrap:wrap; }
      .personal-identity { display:grid; gap:2px; }
      .personal-identity strong { font-size:13px; }
      .personal-identity span { color:#6b7280; font-size:11px; }
      .my-projects { display:flex; flex-wrap:wrap; gap:8px; }
      .my-projects button { min-height:32px; padding:6px 9px; font-size:11px; }
      .decision-persist-box { margin-top:16px; padding:14px; border:1px solid #e2e5e9; border-radius:12px; background:#fafbfc; }
      .decision-persist-box[hidden] { display:none !important; }
      .decision-persist-box h3 { margin:0 0 6px; font-size:13px; }
      .decision-persist-status { margin-top:8px; color:#59616d; font-size:11px; line-height:1.5; }
      .decision-persist-status.error { color:#b42318; }
      .runtime-connect-form { display:grid; grid-template-columns:1.2fr 1fr auto auto; gap:8px; align-items:end; margin-top:12px; padding-top:12px; border-top:1px solid #edf0f2; }
      .workspace-picker { margin-top:12px; padding:12px; border:1px solid #e2e5e9; border-radius:12px; background:#fafbfc; display:grid; grid-template-columns:minmax(220px,1fr) auto; gap:10px; align-items:end; }
      .workspace-picker[hidden], .workspace-switcher[hidden] { display:none !important; }
      .workspace-picker-copy { grid-column:1 / -1; display:grid; gap:3px; }
      .workspace-picker-copy span { color:#6b7280; font-size:11px; }
      .workspace-switcher { display:flex; align-items:center; gap:8px; flex-wrap:wrap; padding:8px 10px; border:1px solid #e6e8ec; border-radius:10px; background:#fafbfc; }
      .workspace-switcher label { font-size:11px; font-weight:800; }
      .workspace-switcher select { min-width:220px; max-width:100%; border:1px solid #dfe2e6; border-radius:8px; padding:7px 9px; background:#fff; color:#16181d; font:inherit; }
      .workspace-role { font-size:10px; color:#6b7280; font-weight:700; }
      .runtime-connect-form .field { margin-top:0; }
      .runtime-connect-message { margin-top:10px; font-size:12px; color:#4b5563; }
      .runtime-connect-message.error { color:#b42318; }
      .empty-state { border:1px dashed #d9dde2; border-radius:12px; padding:22px; color:#6b7280; text-align:center; background:#fafbfc; }

      .detail-backdrop { position:fixed; inset:0; background:rgba(17,24,39,.26); z-index:70; }
      .detail-panel { position:fixed; top:0; right:0; bottom:0; z-index:80; width:min(480px,100vw); background:#fff; border-left:1px solid #e2e5e9; box-shadow:-18px 0 48px rgba(15,23,42,.12); display:flex; flex-direction:column; }
      .detail-panel[hidden], .detail-backdrop[hidden] { display:none !important; }
      .detail-head { display:flex; align-items:flex-start; justify-content:space-between; gap:16px; padding:22px 22px 16px; border-bottom:1px solid #edf0f2; }
      .detail-kicker { font-size:10px; font-weight:800; letter-spacing:.08em; color:#6b7280; }
      .detail-head h2 { margin:5px 0 0; font-size:22px; line-height:1.2; }
      .detail-body { padding:20px 22px 28px; overflow:auto; flex:1; }
      .detail-summary { margin:0 0 14px; color:#4b5563; line-height:1.55; }
      .scope-line { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:14px; }
      .scope-badge { display:inline-flex; border-radius:999px; padding:5px 8px; background:#f1f3f5; font-size:11px; font-weight:800; }
      .share-box { margin-top:18px; border:1px solid #e7e8eb; border-radius:14px; padding:14px; background:#fafbfc; }
      .share-box h3 { margin:0 0 8px; font-size:14px; }
      .share-actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
      .recipient-check { display:flex; align-items:flex-start; gap:8px; margin-top:10px; font-size:12px; color:#4b5563; }
      .recipient-check input { margin-top:2px; }
      .share-status { margin-top:10px; font-size:12px; color:#4b5563; line-height:1.5; }
      .share-status.error { color:#b42318; }
      .detail-close { min-width:40px; min-height:40px; font-size:18px; }
      body.detail-open { overflow:hidden; }
      .object-link-button { margin-top:12px; }

      .sr-only { position:absolute !important; width:1px !important; height:1px !important; padding:0 !important; margin:-1px !important; overflow:hidden !important; clip:rect(0,0,0,0) !important; white-space:nowrap !important; border:0 !important; }
      @media (max-width: 900px) {
        .shell { grid-template-columns: 1fr; }
        .sidebar { position: sticky; top:0; z-index:30; height:auto; padding:8px 12px; border-right:0; border-bottom:1px solid #e7e8eb; overflow:hidden; }
        .sidebar .brand, .sidebar .principle, .nav-label { display:none; }
        nav { display:flex; gap:6px; overflow-x:auto; scrollbar-width:none; }
        nav::-webkit-scrollbar { display:none; }
        .nav-section { display:contents; }
        nav a { flex:0 0 auto; white-space:nowrap; min-height:38px; padding:8px 11px; }
        .topbar { top:55px; padding:9px 16px; }
        .health, [data-onboarding-open] { display:none; }
        .grid, .people-grid, .addon-grid, .report-grid, .skill-grid { grid-template-columns:1fr; }
        .stat-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
        .phase-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
        .capture-grid { grid-template-columns:1fr; }
        .runtime-connect-form { grid-template-columns:1fr 1fr; }
        .runtime-connect-form .field { grid-column:1 / -1; }
      }
      @media (max-width: 620px) {
        .content { padding: 20px 16px; }
        .topbar { align-items:flex-start; }
        .workspace-badge { display:none; }
        .topbar-actions button { min-height:34px; padding:6px 8px; }
        [data-copy-today] { display:none; }
        .attention-item { grid-template-columns: 64px 1fr; }
        .attention-actions, .status { grid-column:2; justify-content:flex-start; }
        .runtime-mode-head { align-items:flex-start; flex-direction:column; }
        .runtime-connect-form { grid-template-columns:1fr; }
        .runtime-connect-form .field { grid-column:auto; }
        .workspace-picker { grid-template-columns:1fr; }
        .workspace-picker-copy { grid-column:auto; }
        .workspace-switcher { align-items:stretch; }
        .workspace-switcher select { min-width:0; width:100%; }
        .preference-grid, .working-row, .first-use-grid, .first-use-plan, .billing-layout, .billing-mode, .billing-architecture { grid-template-columns:1fr; }
        .billing-summary { grid-template-columns:repeat(2,minmax(0,1fr)); }
        h1 { font-size:26px; }
      }
    
/* PRODUCT-RECOVERY-01 — professional visual layer */
:root{
  --pro-accent:#111827;
  --pro-muted:#667085;
  --pro-border:#e5e7eb;
  --pro-surface:#ffffff;
  --pro-bg:#f7f8fa;
  --pro-radius:14px;
}
body{letter-spacing:-.012em}
.sidebar{width:232px}
.brand{
  display:flex!important;align-items:center;gap:10px;
  font-size:15px!important;font-weight:750!important;letter-spacing:-.02em
}
.brand::before{
  content:"";width:27px;height:27px;border:1.2px solid currentColor;border-radius:50%;
  display:inline-block;flex:0 0 auto;
  background:
    linear-gradient(currentColor,currentColor) 50% 31%/2px 7px no-repeat,
    linear-gradient(currentColor,currentColor) 62% 52%/7px 1.5px no-repeat;
}
.principle{font-size:10px!important;line-height:1.55!important;opacity:.72}
nav a{font-size:12px!important;min-height:34px!important;padding:7px 10px!important;border-radius:8px!important}
.nav-group-title{font-size:9px!important;letter-spacing:.09em!important}
.topbar{min-height:52px!important;padding:8px 18px!important}
.topbar-title strong{font-size:13px!important}
.workspace-badge,.health,.mode-badge,.pill{font-size:9px!important}
.topbar-actions{gap:6px!important}
.topbar-actions button{font-size:10px!important;min-height:29px!important;padding:6px 8px!important;border-radius:8px!important}
.content{max-width:1180px}
h1{font-size:28px!important;letter-spacing:-.035em!important;margin-bottom:6px!important}
.sub{font-size:12px!important;line-height:1.6!important;color:#697386!important}
h2{font-size:14px!important}
.card{border-radius:var(--pro-radius)!important}
.attention-item{border-radius:12px!important}
.review-meta,.why,.safe{font-size:11px!important;line-height:1.55!important}
button,input,select,textarea{font-size:12px}
[data-page="ADD_ONS"] .addon-grid,
[data-page="BILLING"] .billing-layout{align-items:start}
[data-page="ADD_ONS"]::before{
  content:"CORE EXTENSIONS · Human Review boundary enforced";
  display:inline-flex;margin:0 0 12px;padding:5px 8px;border:1px solid #dbe2ea;
  border-radius:999px;font-size:9px;font-weight:800;letter-spacing:.05em;color:#667085;background:#fff;
}
[data-page="BILLING"]::before{
  content:"AI FUNDING · Platform Credits / BYOK / Auto Fallback";
  display:inline-flex;margin:0 0 12px;padding:5px 8px;border:1px solid #dbe2ea;
  border-radius:999px;font-size:9px;font-weight:800;letter-spacing:.05em;color:#667085;background:#fff;
}
.product-recovery-note{
  position:fixed;right:14px;bottom:14px;z-index:50;
  padding:7px 10px;border:1px solid #e5e7eb;border-radius:999px;
  background:rgba(255,255,255,.92);backdrop-filter:blur(8px);
  font-size:9px;font-weight:800;color:#667085;box-shadow:0 8px 24px rgba(16,24,40,.08)
}
@media(max-width:900px){.product-recovery-note{display:none}}


/* WORKSPACE-RECOVERY-02 — canonical standalone work window */
:root{
  --ui-bg:#f6f7f8; --ui-surface:#ffffff; --ui-surface-2:#fafbfc;
  --ui-ink:#16181d; --ui-muted:#6b7280; --ui-line:#e7e8eb;
  --ui-soft:#f0f2f5; --ui-accent:#16181d; --ui-accent-ink:#ffffff;
}
html[data-theme="dark"]{
  color-scheme:dark;
  --ui-bg:#0e1115; --ui-surface:#15191e; --ui-surface-2:#11161b;
  --ui-ink:#f2f4f7; --ui-muted:#9ca4af; --ui-line:#2b323b;
  --ui-soft:#20262d; --ui-accent:#f2f4f7; --ui-accent-ink:#11151a;
}
html[data-theme="dark"] body{background:var(--ui-bg);color:var(--ui-ink)}
html[data-theme="dark"] .sidebar-head{background:var(--ui-surface);border-bottom-color:var(--ui-line)}
html[data-theme="dark"] .sidebar,
html[data-theme="dark"] .topbar,
html[data-theme="dark"] .card,
html[data-theme="dark"] .review-card,
html[data-theme="dark"] .person-card,
html[data-theme="dark"] .agenda-item,
html[data-theme="dark"] .flow-step,
html[data-theme="dark"] .decision-card,
html[data-theme="dark"] .addon-card,
html[data-theme="dark"] .ask-response,
html[data-theme="dark"] .phase,
html[data-theme="dark"] .skill-card,
html[data-theme="dark"] .runtime-mode-card,
html[data-theme="dark"] .preference-panel,
html[data-theme="dark"] .detail-panel,
html[data-theme="dark"] .share-box{
  background:var(--ui-surface);color:var(--ui-ink);border-color:var(--ui-line)
}
html[data-theme="dark"] nav a{color:#d6dbe2}
html[data-theme="dark"] nav a:hover,
html[data-theme="dark"] nav a.active,
html[data-theme="dark"] nav a[aria-current="page"]{background:var(--ui-soft);color:var(--ui-ink)}
html[data-theme="dark"] .sub,
html[data-theme="dark"] .why,
html[data-theme="dark"] .review-meta,
html[data-theme="dark"] .status,
html[data-theme="dark"] .principle,
html[data-theme="dark"] .runtime-mode-copy span,
html[data-theme="dark"] .safe,
html[data-theme="dark"] .preference-status{color:var(--ui-muted)}
html[data-theme="dark"] button,
html[data-theme="dark"] input,
html[data-theme="dark"] textarea,
html[data-theme="dark"] select{
  background:var(--ui-surface); color:var(--ui-ink); border-color:var(--ui-line)
}
html[data-theme="dark"] button.primary,
html[data-theme="dark"] button.selected{
  background:var(--ui-accent);color:var(--ui-accent-ink);border-color:var(--ui-accent)
}
html[data-theme="dark"] .safe,
html[data-theme="dark"] .empty-state,
html[data-theme="dark"] .workspace-picker,
html[data-theme="dark"] .workspace-switcher,
html[data-theme="dark"] .decision-persist-box{background:var(--ui-surface-2)}
.brand-live{display:flex!important;align-items:center;gap:10px}
.brand-live::before{display:none!important}
.clock-logo{
  width:30px;height:30px;min-height:30px!important;padding:0!important;
  border:0!important;background:transparent!important;display:grid;place-items:center;
  border-radius:8px;flex:0 0 auto;
}
.clock-logo:hover{background:var(--ui-soft)!important}
.clock-face{
  position:relative;width:23px;height:23px;border-radius:50%;
  background:transparent;border:1.2px solid currentColor;
}
.clock-hand{
  position:absolute;left:50%;bottom:50%;transform-origin:50% 100%;
  border-radius:999px;background:currentColor;will-change:transform;
}
.clock-hour{width:2.3px;height:6px;margin-left:-1.15px}
.clock-minute{width:1.8px;height:8.5px;margin-left:-.9px}
.clock-second{width:1px;height:9px;margin-left:-.5px;background:#e5484d}
.clock-pin{
  position:absolute;left:50%;top:50%;width:3.5px;height:3.5px;
  margin:-1.75px 0 0 -1.75px;border-radius:50%;background:currentColor;
}
.topbar-actions button{font-size:10px!important;min-height:30px!important;padding:6px 8px!important;border-radius:8px!important}
.theme-toggle{min-width:70px}
.theme-toggle-icon{width:31px;min-width:31px!important;height:31px;min-height:31px!important;padding:0!important;border:1px solid var(--ui-line)!important;background:var(--ui-surface-2)!important;color:var(--ui-ink)!important;border-radius:9px!important;display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;font-size:15px!important;line-height:1!important}
.theme-toggle-icon:hover{background:var(--ui-soft)!important;border-color:#cfd5dc!important}
.theme-toggle-icon span{display:block;transform:translateY(-.5px)}
html[data-theme="dark"] .theme-toggle-icon{background:#11161c!important;border-color:#34404c!important;color:var(--ui-ink)!important}
html[data-theme="dark"] .theme-toggle-icon:hover{background:#1c232b!important}
.demo-control{
  font-size:9px!important;font-weight:800!important;letter-spacing:.04em;
  color:#7a5b00!important;background:#fff9e6!important;border-color:#ead99a!important;
}
html[data-theme="dark"] .demo-control{
  color:#e7c96a!important;background:#2a2414!important;border-color:#514421!important;
}
.product-recovery-note{display:none!important}


/* RECOVERY-06 — 1:1 Leadership Mindset */
.leadership-lens{margin-bottom:14px}
.lens-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:16px}
.lens-head h2{font-size:17px!important;margin:4px 0 6px!important;letter-spacing:-.02em}
.lens-head p{margin:0;color:#6b7280;font-size:12px;line-height:1.6;max-width:760px}
.lens-kicker,.lens-step{font-size:9px;font-weight:900;letter-spacing:.08em;color:#7b8491}
.lens-three{display:grid;grid-template-columns:1.1fr 1fr 1fr;gap:10px}
.lens-panel{border:1px solid #e7e8eb;border-radius:12px;padding:14px;background:#fbfcfd}
.lens-panel strong{display:block;font-size:13px;margin-top:5px}
.compact-field{margin-top:10px!important}
.motive-chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.motive-chips button{min-height:30px;padding:5px 8px;font-size:10px;border-radius:999px}
.motive-chips button.selected{background:#16181d;color:#fff;border-color:#16181d}
.mode-explain{margin-top:9px;padding:9px 10px;border-radius:9px;background:#f3f5f7;color:#59616d;font-size:11px;line-height:1.5}
.lens-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.lens-grid textarea{min-height:82px;resize:vertical}
.lens-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:12px}
.lens-actions span{font-size:10px;color:#6b7280}
.lead-output{margin-top:12px;border:1px solid #e7e8eb;border-radius:12px;background:#fff;overflow:hidden}
.lead-empty{padding:14px;display:grid;gap:5px}
.lead-empty strong{font-size:12px}
.lead-empty span{font-size:11px;color:#6b7280;line-height:1.6}
.lead-note{display:grid;grid-template-columns:.8fr 1.2fr;gap:0}
.lead-note .summary-side{padding:14px;border-right:1px solid #edf0f2;background:#fafbfc}
.lead-note .question-side{padding:14px}
.lead-note h3{font-size:12px;margin:0 0 9px}
.lead-note .note-row{display:grid;grid-template-columns:88px 1fr;gap:8px;padding:7px 0;border-bottom:1px solid #edf0f2;font-size:11px;line-height:1.5}
.lead-note .note-row:last-child{border-bottom:0}
.lead-note .note-row span:first-child{color:#7b8491;font-weight:800}
.lead-note ol{margin:0;padding-left:18px;display:grid;gap:7px;font-size:11px;line-height:1.55}
.lead-principles{margin-top:10px;padding:10px;border-radius:9px;background:#f6f7f8;font-size:10px;line-height:1.6;color:#59616d}
html[data-theme="dark"] .lens-panel,
html[data-theme="dark"] .lead-output,
html[data-theme="dark"] .lead-note .summary-side{background:var(--ui-surface-2);border-color:var(--ui-line)}
html[data-theme="dark"] .mode-explain,
html[data-theme="dark"] .lead-principles{background:var(--ui-soft);color:var(--ui-muted)}
html[data-theme="dark"] .motive-chips button.selected{background:var(--ui-accent);color:var(--ui-accent-ink);border-color:var(--ui-accent)}
@media(max-width:900px){
  .lens-three,.lens-grid,.lead-note{grid-template-columns:1fr}
  .lead-note .summary-side{border-right:0;border-bottom:1px solid #edf0f2}
  .lens-head{flex-direction:column}
}


/* RECOVERY-07 — brand clock position + analog/digital toggle */
.brand-live{
  display:flex!important;
  align-items:center;
  justify-content:flex-start;
  gap:8px;
  min-height:34px;
}
.brand-home{
  border:0!important;
  background:transparent!important;
  color:inherit!important;
  padding:0!important;
  min-height:auto!important;
  font-size:15px!important;
  line-height:1!important;
  font-weight:800!important;
  letter-spacing:-.025em;
}
.brand-home:hover{opacity:.72;background:transparent!important}
.clock-toggle{
  width:31px;
  height:31px;
  min-height:31px!important;
  padding:0!important;
  border:1px solid var(--ui-line)!important;
  background:var(--ui-surface-2)!important;
  color:var(--ui-ink)!important;
  border-radius:9px!important;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  flex:0 0 auto;
  transition:width .18s ease, background .18s ease, border-color .18s ease;
}
.clock-toggle:hover{
  background:var(--ui-soft)!important;
  border-color:#cfd5dc!important;
}
.clock-toggle.digital{
  width:82px;
  padding:0 8px!important;
  justify-content:flex-start;
}
.clock-analog{display:grid;place-items:center;width:100%;height:100%}
.clock-digital{
  display:none;
  width:100%;
  align-items:baseline;
  justify-content:space-between;
  gap:6px;
  white-space:nowrap;
  font-variant-numeric:tabular-nums;
}
.clock-toggle.digital .clock-analog{display:none}
.clock-toggle.digital .clock-digital{display:flex}
.clock-digital [data-clock-digital-time]{
  font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono",monospace;
  font-size:11px;
  font-weight:800;
  letter-spacing:-.035em;
}
.clock-digital [data-clock-digital-day]{
  font-size:8px;
  font-weight:900;
  letter-spacing:.065em;
  color:var(--ui-muted);
}
.clock-face{
  position:relative;
  width:21px;
  height:21px;
  border-radius:50%;
  background:transparent;
  border:1.15px solid currentColor;
}
.clock-hour{width:2.4px;height:5.8px;margin-left:-1.2px}
.clock-minute{width:1.8px;height:8px;margin-left:-.9px}
.clock-second{width:1px;height:8.7px;margin-left:-.5px;background:#e5484d}
html[data-theme="dark"] .clock-toggle{
  background:#11161c!important;
  border-color:#34404c!important;
}
html[data-theme="dark"] .clock-toggle:hover{background:#1c232b!important}
@media (prefers-reduced-motion: reduce){
  .clock-toggle{transition:none}
}


/* RECOVERY-09 — square analog clock face */
.clock-toggle:not(.digital){
  border:0!important;
  background:transparent!important;
}
.clock-toggle:not(.digital):hover{background:var(--ui-soft)!important}
.clock-toggle:not(.digital) .clock-face{
  width:23px;
  height:23px;
  border-radius:5px!important;
  border:1.2px solid currentColor;
  background:transparent;
}
.clock-toggle:not(.digital) .clock-face::before{
  content:"";
  position:absolute;
  inset:2px;
  border-radius:3px;
  background:
    linear-gradient(currentColor,currentColor) 50% 1px/1px 3px no-repeat,
    linear-gradient(currentColor,currentColor) calc(100% - 1px) 50%/3px 1px no-repeat,
    linear-gradient(currentColor,currentColor) 50% calc(100% - 1px)/1px 3px no-repeat,
    linear-gradient(currentColor,currentColor) 1px 50%/3px 1px no-repeat;
  opacity:.42;
}
.clock-toggle:not(.digital) .clock-hour{width:2.5px;height:5.8px;margin-left:-1.25px}
.clock-toggle:not(.digital) .clock-minute{width:1.9px;height:8.4px;margin-left:-.95px}
.clock-toggle:not(.digital) .clock-second{width:1px;height:8.9px;margin-left:-.5px;background:#e5484d}


/* RECOVERY-09 — After 1:1 Leader Review */
.after-one-on-one{margin-bottom:14px}
.after-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:15px}
.after-head h2{font-size:17px!important;margin:4px 0 6px!important;letter-spacing:-.02em}
.after-head p{margin:0;color:#6b7280;font-size:12px;line-height:1.55}
.after-grid{display:grid;grid-template-columns:1fr;gap:9px}
.after-question{
  display:grid;grid-template-columns:32px 1fr;gap:10px;
  padding:12px;border:1px solid #e7e8eb;border-radius:12px;background:#fbfcfd;
}
.after-no{
  width:28px;height:28px;border-radius:8px;background:#eef1f4;
  display:grid;place-items:center;font-size:9px;font-weight:900;color:#667085;
}
.after-question strong{display:block;font-size:12px;margin:1px 0 9px}
.choice-row{display:flex;flex-wrap:wrap;gap:6px}
.choice-row button{min-height:30px;padding:5px 8px;font-size:10px;border-radius:999px}
.choice-row button.selected{background:#16181d;color:#fff;border-color:#16181d}
.after-fields{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}
.after-fields textarea{min-height:78px;resize:vertical}
.after-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:12px}
.after-actions span{font-size:10px;color:#6b7280}
.after-output{margin-top:12px;border:1px solid #e7e8eb;border-radius:12px;background:#fff;overflow:hidden}
.after-summary{display:grid;grid-template-columns:.8fr 1.2fr}
.after-summary .after-left{padding:14px;background:#fafbfc;border-right:1px solid #edf0f2}
.after-summary .after-right{padding:14px}
.after-summary h3{font-size:12px;margin:0 0 9px}
.after-summary .note-row{display:grid;grid-template-columns:92px 1fr;gap:8px;padding:7px 0;border-bottom:1px solid #edf0f2;font-size:11px;line-height:1.5}
.after-summary .note-row:last-child{border-bottom:0}
.after-summary .note-row span:first-child{color:#7b8491;font-weight:800}
.after-next{font-size:11px;line-height:1.6;color:#4b5563}
html[data-theme="dark"] .after-question,
html[data-theme="dark"] .after-output,
html[data-theme="dark"] .after-summary .after-left{background:var(--ui-surface-2);border-color:var(--ui-line)}
html[data-theme="dark"] .after-no{background:var(--ui-soft);color:var(--ui-muted)}
html[data-theme="dark"] .choice-row button.selected{background:var(--ui-accent);color:var(--ui-accent-ink);border-color:var(--ui-accent)}
@media(max-width:900px){
  .after-fields,.after-summary{grid-template-columns:1fr}
  .after-summary .after-left{border-right:0;border-bottom:1px solid #edf0f2}
  .after-head{flex-direction:column}
}


/* RECOVERY-11 — Leadership Practicum Design System + accessibility contrast */
:root{
  --lo-font-sans:Inter,Pretendard,"Apple SD Gothic Neo","Noto Sans KR",system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  --lo-fs-10:10px; --lo-fs-11:11px; --lo-fs-12:12px; --lo-fs-13:13px; --lo-fs-14:14px; --lo-fs-18:18px; --lo-fs-24:24px; --lo-fs-30:30px;
  --lo-space-1:4px; --lo-space-2:8px; --lo-space-3:12px; --lo-space-4:16px; --lo-space-5:20px; --lo-space-6:24px; --lo-space-8:32px;
  --lo-radius-sm:9px; --lo-radius-md:12px; --lo-radius-lg:16px; --lo-radius-xl:20px;
  --lo-blue:#2563eb; --lo-blue-soft:#eff6ff; --lo-teal:#0f766e; --lo-teal-soft:#f0fdfa;
  --lo-violet:#7c3aed; --lo-violet-soft:#f5f3ff; --lo-orange:#c2410c; --lo-orange-soft:#fff7ed;
  --lo-green:#166534; --lo-green-soft:#f0fdf4; --lo-red:#b42318; --lo-red-soft:#fef3f2; --lo-yellow:#854d0e; --lo-yellow-soft:#fffbeb;
}
body{font-family:var(--lo-font-sans)}
.content{max-width:1240px}
.content>h1{font-size:var(--lo-fs-30)!important;line-height:1.15!important;font-weight:850!important;letter-spacing:-.045em!important}
.content>.sub{max-width:860px;font-size:var(--lo-fs-13)!important;line-height:1.65!important;margin-bottom:24px!important}
.section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:16px}
.section-head-copy{display:grid;gap:4px;min-width:0}
.section-kicker{font-size:9px;font-weight:900;letter-spacing:.11em;color:var(--ui-muted);text-transform:uppercase}
.section-head h2{font-size:18px!important;line-height:1.25!important;letter-spacing:-.025em!important;margin:0!important;color:var(--ui-ink)!important}
.section-head p{font-size:12px;line-height:1.6;color:var(--ui-muted);margin:0;max-width:780px}
.section-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.card,.phase,.quest-box,.toolkit-card,.source-card,.coach-hero,.coach-level,.coach-manual-card,.sample-board,.sample-card,.setup-item,.artifact-shell,.artifact-editor,.artifact-preview,.today-nudge-card{
  color:var(--ui-ink)!important;
}
.state-badge{color:#475467;background:#f2f4f7;border:1px solid #e4e7ec}
html[data-theme="dark"] .state-badge{color:#d0d5dd;background:#232a32;border-color:#34404c}
.review-result{color:var(--ui-ink);border:1px solid var(--ui-line);background:var(--ui-surface-2)}
.review-result.success{color:var(--lo-green);background:var(--lo-green-soft);border-color:#bbf7d0}
.review-result.error{color:var(--lo-red);background:var(--lo-red-soft);border-color:#fecaca}
html[data-theme="dark"] .review-result.success{color:#86efac;background:#10261a;border-color:#245b36}
html[data-theme="dark"] .review-result.error{color:#fda4af;background:#2b1619;border-color:#613039}

/* 30-day hero */
.quest-hero{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(280px,.65fr);gap:16px;margin-bottom:18px}
.quest-hero-main,.quest-progress-card{border:1px solid var(--ui-line);border-radius:var(--lo-radius-lg);background:var(--ui-surface);padding:20px}
.quest-hero-main{background:linear-gradient(135deg,#ffffff 0%,#f8fafc 62%,#eef2ff 100%)}
.quest-hero-main h2{font-size:24px!important;letter-spacing:-.04em!important;margin:6px 0 8px!important}
.quest-hero-main p{font-size:12px;line-height:1.65;color:#5e6673;margin:0;max-width:760px}
.quest-principles{display:flex;flex-wrap:wrap;gap:6px;margin-top:16px}
.quest-principles span{font-size:9px;font-weight:900;letter-spacing:.07em;padding:5px 8px;border:1px solid #d9dee6;border-radius:999px;background:#fff;color:#475467}
.quest-progress-card{display:flex;flex-direction:column;justify-content:space-between;gap:16px}
.quest-progress-card strong{font-size:22px;letter-spacing:-.035em}
.quest-progress-track{height:9px;border-radius:999px;background:#edf0f3;overflow:hidden;margin-top:10px}
.quest-progress-track span{display:block;height:100%;border-radius:inherit;background:#16181d;width:0;transition:width .25s ease}
html[data-theme="dark"] .quest-hero-main{background:linear-gradient(135deg,#171c22 0%,#141920 60%,#1c1a2b 100%)}
html[data-theme="dark"] .quest-hero-main p{color:var(--ui-muted)}
html[data-theme="dark"] .quest-principles span{background:#11161b;color:#d0d5dd;border-color:#34404c}
html[data-theme="dark"] .quest-progress-track{background:#252c34}
html[data-theme="dark"] .quest-progress-track span{background:#f2f4f7}

/* start-here checklist */
.setup-checklist-card{margin-bottom:18px}
.setup-progress-line{display:flex;align-items:center;gap:12px;min-width:210px}
.setup-progress-track{height:8px;flex:1;border-radius:999px;background:#edf0f3;overflow:hidden}
.setup-progress-track span{display:block;height:100%;background:var(--lo-blue);border-radius:inherit}
.setup-progress-copy{font-size:11px;font-weight:850;white-space:nowrap;color:var(--ui-muted)}
.setup-groups{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.setup-group{border:1px solid var(--ui-line);border-radius:14px;background:var(--ui-surface-2);padding:12px}
.setup-group-head{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px}
.setup-group-head strong{font-size:12px}.setup-group-head span{font-size:9px;color:var(--ui-muted);font-weight:850}
.setup-list{display:grid;gap:6px}
.setup-item{width:100%;min-height:auto!important;text-align:left!important;display:grid!important;grid-template-columns:20px 1fr!important;gap:8px!important;align-items:start!important;padding:9px!important;border:1px solid transparent!important;background:transparent!important;border-radius:10px!important}
.setup-item:hover{background:var(--ui-surface)!important;border-color:var(--ui-line)!important}
.setup-check{width:18px;height:18px;border:1px solid #cfd5dc;border-radius:6px;display:grid;place-items:center;font-size:10px;color:transparent;background:var(--ui-surface)}
.setup-item.done .setup-check{background:#16181d;border-color:#16181d;color:#fff}
.setup-item-copy strong{display:block;font-size:11px;line-height:1.35;color:var(--ui-ink)}
.setup-item-copy small{display:block;margin-top:2px;font-size:9px;color:var(--ui-muted);line-height:1.35}
html[data-theme="dark"] .setup-item.done .setup-check{background:#f2f4f7;color:#11151a;border-color:#f2f4f7}

/* visual sample library */
.visual-playbook{margin-bottom:18px}
.sample-tabs,.artifact-tabs{display:flex;gap:6px;overflow-x:auto;padding-bottom:2px;scrollbar-width:none}
.sample-tabs::-webkit-scrollbar,.artifact-tabs::-webkit-scrollbar{display:none}
.sample-tabs button,.artifact-tabs button{flex:0 0 auto;min-height:32px!important;padding:6px 9px!important;font-size:10px!important;border-radius:999px!important}
.sample-tabs button.active,.artifact-tabs button.active{background:#16181d;color:#fff;border-color:#16181d}
html[data-theme="dark"] .sample-tabs button.active,html[data-theme="dark"] .artifact-tabs button.active{background:#f2f4f7;color:#11151a;border-color:#f2f4f7}
.sample-stage{margin-top:14px}
.sample-board{border:1px solid var(--ui-line);border-radius:16px;background:var(--ui-surface-2);padding:14px;overflow:hidden}
.sample-board-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;margin-bottom:12px}
.sample-board-head h3{font-size:15px;margin:0 0 4px}.sample-board-head p{font-size:10px;color:var(--ui-muted);margin:0;line-height:1.5}
.sample-legend{display:flex;gap:5px;flex-wrap:wrap}.sample-legend span{font-size:9px;border:1px solid var(--ui-line);background:var(--ui-surface);padding:4px 6px;border-radius:999px;color:var(--ui-muted)}
.sample-calendar{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
.sample-day{border:1px solid var(--ui-line);border-radius:12px;background:var(--ui-surface);padding:9px;min-height:150px}
.sample-day>strong{font-size:10px;letter-spacing:.06em;color:var(--ui-muted)}
.sample-event{margin-top:7px;padding:8px;border-radius:9px;border:1px solid #dbe2ea;background:#f8fafc}
.sample-event b{display:block;font-size:10px;line-height:1.3}.sample-event span{display:block;font-size:9px;line-height:1.4;color:#667085;margin-top:3px}
.sample-event.ritual{border-left:3px solid var(--lo-blue)}.sample-event.oneonone{border-left:3px solid var(--lo-teal)}.sample-event.milestone{border-left:3px solid var(--lo-violet)}.sample-event.decision{border-left:3px solid var(--lo-orange)}.sample-event.debrief{border-left:3px solid #b54708}
html[data-theme="dark"] .sample-event{background:#171d24;border-color:#34404c}.sample-event b{color:var(--ui-ink)}html[data-theme="dark"] .sample-event span{color:var(--ui-muted)}
.sample-org{display:grid;grid-template-columns:1fr 1.6fr;gap:12px;align-items:stretch}.sample-org-leader{display:grid;place-items:center;border:1px solid var(--ui-line);border-radius:14px;background:var(--ui-surface);padding:18px;text-align:center}.sample-org-leader b{font-size:15px}.sample-org-leader span{font-size:10px;color:var(--ui-muted);margin-top:4px}.sample-team-nodes{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.sample-person{border:1px solid var(--ui-line);background:var(--ui-surface);border-radius:12px;padding:10px}.sample-person b{font-size:11px}.sample-person p{font-size:9px;color:var(--ui-muted);margin:5px 0 0;line-height:1.45}.fact-tag,.hyp-tag,.unknown-tag{display:inline-flex;font-size:8px;font-weight:900;padding:3px 5px;border-radius:999px;margin-top:7px}.fact-tag{background:#ecfdf3;color:#027a48}.hyp-tag{background:#fffaeb;color:#b54708}.unknown-tag{background:#f2f4f7;color:#475467}
.sample-milestones{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}.sample-milestone{position:relative;border:1px solid var(--ui-line);border-radius:12px;background:var(--ui-surface);padding:10px}.sample-milestone::after{content:"→";position:absolute;right:-9px;top:50%;transform:translate(50%,-50%);color:#98a2b3;font-weight:900}.sample-milestone:last-child::after{display:none}.sample-milestone small{font-size:8px;color:var(--ui-muted);font-weight:900}.sample-milestone b{display:block;font-size:11px;margin:5px 0}.sample-milestone p{font-size:9px;line-height:1.45;color:var(--ui-muted);margin:0}
.sample-matrix-wrap{overflow:auto}.sample-matrix{width:100%;border-collapse:separate;border-spacing:0;font-size:10px}.sample-matrix th,.sample-matrix td{padding:8px;border-bottom:1px solid var(--ui-line);text-align:left;white-space:nowrap}.sample-matrix th{color:var(--ui-muted);font-size:9px;background:var(--ui-surface-2)}.role-pill{display:inline-grid;place-items:center;min-width:22px;height:22px;padding:0 5px;border-radius:7px;font-size:9px;font-weight:900;background:#eef2ff;color:#4338ca}.role-pill.d{background:#16181d;color:#fff}.delegate-level{font-size:9px;font-weight:900;padding:4px 6px;border-radius:7px;background:#f2f4f7;color:#475467}.delegate-level.l4,.delegate-level.l5{background:#ecfdf3;color:#027a48}.sample-debrief{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.sample-debrief-card{border:1px solid var(--ui-line);background:var(--ui-surface);border-radius:12px;padding:10px}.sample-debrief-card small{font-size:8px;color:var(--ui-muted);font-weight:900}.sample-debrief-card b{display:block;font-size:11px;line-height:1.45;margin-top:4px}

/* quest curriculum */
.phase-grid{margin-bottom:18px}.quest-phase-card{position:relative;overflow:hidden;min-height:112px}.quest-phase-card::before{content:"";display:block;width:28px;height:3px;border-radius:999px;background:#667085;margin-bottom:12px}.quest-phase-card[data-phase="UNDERSTAND"]::before{background:var(--lo-teal)}.quest-phase-card[data-phase="ALIGN"]::before{background:var(--lo-blue)}.quest-phase-card[data-phase="EMPOWER"]::before{background:var(--lo-violet)}.quest-phase-card[data-phase="COACH"]::before{background:var(--lo-orange)}.quest-phase-card h3{font-size:12px;margin:8px 0 5px}
.quest-layout{display:grid;grid-template-columns:300px minmax(0,1fr);gap:18px;align-items:start}
.quest-sidebar{display:grid;gap:12px;position:sticky;top:86px;max-height:calc(100vh - 110px)}
.quest-phase-filters{display:flex;gap:5px;flex-wrap:wrap}.quest-phase-filters button{min-height:28px!important;padding:5px 7px!important;font-size:9px!important}.quest-phase-filters button.active{background:#16181d;color:#fff;border-color:#16181d}
.quest-list{display:grid;gap:5px;overflow:auto;padding-right:3px}.quest-row{width:100%;min-height:auto!important;display:grid!important;grid-template-columns:30px minmax(0,1fr) 18px!important;gap:8px!important;align-items:center!important;padding:9px!important;text-align:left!important;background:var(--ui-surface)!important;color:var(--ui-ink)!important}.quest-row.selected{border-color:#98a2b3!important;box-shadow:0 0 0 1px #98a2b3 inset;background:var(--ui-surface-2)!important}.quest-row.done{background:#f6fef9!important;border-color:#abefc6!important}.quest-row.evidence:not(.done){background:#eff8ff!important;border-color:#b2ddff!important}.quest-day{font-size:9px;font-weight:900;color:var(--ui-muted)}.quest-row-copy{min-width:0}.quest-row-copy strong{display:block;font-size:10px;line-height:1.35;color:var(--ui-ink)}.quest-row-copy small{display:block;margin-top:2px;font-size:8px;color:var(--ui-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.quest-status{font-size:10px;text-align:center;color:var(--ui-muted)}
html[data-theme="dark"] .quest-row.done{background:#10261a!important;border-color:#245b36!important}html[data-theme="dark"] .quest-row.evidence:not(.done){background:#132331!important;border-color:#285375!important}html[data-theme="dark"] .quest-phase-filters button.active{background:#f2f4f7;color:#11151a;border-color:#f2f4f7}
.quest-detail{min-width:0}.quest-detail-head{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:12px}.quest-detail-head h2{font-size:20px!important;line-height:1.25!important;letter-spacing:-.03em!important;margin:5px 0 6px!important}.quest-outcome{font-size:12px;color:var(--ui-muted);line-height:1.6;margin:0}.quest-learning-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:9px}.quest-box{border:1px solid var(--ui-line);border-radius:13px;padding:13px;background:var(--ui-surface)}.quest-box>span:first-child{display:block;font-size:8px;font-weight:950;letter-spacing:.1em;color:var(--ui-muted);margin-bottom:5px}.quest-box>strong{display:block;font-size:11px;margin-bottom:5px;color:var(--ui-ink)}.quest-box p,.quest-box li{font-size:10px;line-height:1.58;color:var(--ui-muted)}.quest-box p{margin:0}.quest-box ol{margin:7px 0 0;padding-left:18px;display:grid;gap:5px}.quest-box.practice,.quest-box.reflection,.quest-box.sources{margin-bottom:9px}.quest-box.knowledge{border-left:3px solid var(--lo-blue)}.quest-box.case{border-left:3px solid var(--lo-orange)}.quest-box.practice{border-left:3px solid var(--lo-teal)}.quest-box.artifact{border-left:3px solid var(--lo-violet)}.quest-box.nudge{border-left:3px solid #b54708}.quest-reflection-questions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.quest-reflection-questions label{font-size:10px;font-weight:750;line-height:1.45;color:var(--ui-ink)}.quest-reflection-questions textarea,.quest-evidence-field textarea{width:100%;min-height:68px;margin-top:5px;padding:8px 9px;border:1px solid var(--ui-line);border-radius:9px;background:var(--ui-surface-2);color:var(--ui-ink);resize:vertical}.quest-source-list{display:flex;gap:6px;flex-wrap:wrap}.quest-source-link{font-size:9px;color:#175cd3;text-decoration:none;border:1px solid #b2ddff;background:#eff8ff;padding:5px 7px;border-radius:999px}.quest-evidence-field{margin-top:10px;padding-top:10px;border-top:1px dashed var(--ui-line)}.quest-evidence-actions{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-top:7px}.quest-evidence-state{font-size:9px;color:var(--ui-muted)}
html[data-theme="dark"] .quest-source-link{color:#84caff;background:#102a3f;border-color:#285375}

/* Toolkits / artifact workspace */
.toolkit-grid{display:grid;gap:8px;margin-top:12px}.toolkit-card{border:1px solid var(--ui-line);border-radius:12px;background:var(--ui-surface);overflow:hidden}.toolkit-card summary{padding:10px 11px;display:grid;grid-template-columns:150px 1fr;gap:10px;align-items:start;cursor:pointer}.toolkit-card summary strong{font-size:11px}.toolkit-card summary span{font-size:9px;line-height:1.5;color:var(--ui-muted)}.toolkit-table-wrap{overflow:auto;border-top:1px solid var(--ui-line)}.toolkit-table{width:100%;border-collapse:collapse;font-size:9px}.toolkit-table td{padding:7px 9px;border-bottom:1px solid var(--ui-line);color:var(--ui-ink)}
.artifact-shell{margin-top:18px}.artifact-body{display:grid;grid-template-columns:minmax(0,1fr) 1fr;gap:12px;margin-top:12px}.artifact-editor,.artifact-preview{border:1px solid var(--ui-line);border-radius:14px;background:var(--ui-surface-2);padding:13px}.artifact-editor h3,.artifact-preview h3{font-size:12px;margin:0 0 10px}.artifact-fields{display:grid;grid-template-columns:1fr 1fr;gap:8px}.artifact-fields .field{margin-top:0}.artifact-fields .full{grid-column:1/-1}.artifact-fields input,.artifact-fields select,.artifact-fields textarea{width:100%;border:1px solid var(--ui-line);background:var(--ui-surface);color:var(--ui-ink);border-radius:9px;padding:8px;font-size:10px;min-height:36px}.artifact-fields textarea{min-height:64px;resize:vertical}.artifact-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}.artifact-list{display:grid;gap:6px}.artifact-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:start;border:1px solid var(--ui-line);border-radius:10px;background:var(--ui-surface);padding:9px}.artifact-row b{display:block;font-size:10px;line-height:1.4}.artifact-row p{font-size:9px;line-height:1.5;color:var(--ui-muted);margin:3px 0 0}.artifact-row button{min-height:26px!important;padding:4px 6px!important;font-size:9px!important}.artifact-empty{padding:18px;border:1px dashed var(--ui-line);border-radius:10px;text-align:center;color:var(--ui-muted);font-size:10px}.artifact-count{font-size:9px;color:var(--ui-muted);font-weight:850}

/* Today leader nudge */
.today-nudge-card{margin:0 0 14px;border:1px solid #d7e3f4;border-left:4px solid var(--lo-blue);border-radius:14px;background:#f8fbff;padding:14px 16px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:center}.today-nudge-copy{display:grid;gap:4px}.today-nudge-copy span{font-size:8px;font-weight:950;letter-spacing:.1em;color:#175cd3}.today-nudge-copy strong{font-size:12px;line-height:1.4}.today-nudge-copy p{font-size:10px;line-height:1.5;color:#475467;margin:0}.today-nudge-actions{display:flex;gap:7px;flex-wrap:wrap}.today-nudge-actions button{min-height:30px!important;padding:5px 8px!important;font-size:10px!important}.today-nudge-card[data-state="complete"]{border-left-color:var(--lo-green);border-color:#bbf7d0;background:#f7fef9}.today-nudge-card[data-state="complete"] .today-nudge-copy span{color:var(--lo-green)}
html[data-theme="dark"] .today-nudge-card{background:#13202c;border-color:#28435d}.today-nudge-card p{color:var(--ui-muted)!important}html[data-theme="dark"] .today-nudge-card[data-state="complete"]{background:#10261a;border-color:#245b36}

/* Coach / knowledge */
.coach-hero{border:1px solid var(--ui-line);border-radius:16px;background:linear-gradient(135deg,#111827,#1f2937);padding:20px;margin-bottom:14px;color:#fff!important}.coach-hero .lens-kicker,.coach-hero h2,.coach-hero p{color:#fff!important}.coach-hero h2{font-size:22px!important;margin:6px 0 7px!important}.coach-hero p{font-size:11px;line-height:1.6;opacity:.82;margin:0}.coach-layout{display:grid;grid-template-columns:.75fr 1.25fr;gap:14px}.coach-control{display:grid;gap:12px}.coach-control label{display:block;font-size:10px;font-weight:850;margin-bottom:5px}.coach-control select{width:100%;border:1px solid var(--ui-line);background:var(--ui-surface);color:var(--ui-ink);border-radius:9px;padding:8px;font-size:10px}.coach-output{border:1px solid var(--ui-line);border-radius:12px;background:var(--ui-surface-2);padding:12px}.coach-output h3{font-size:13px;margin:8px 0 5px}.coach-output p{font-size:11px;line-height:1.6;color:var(--ui-muted);margin:0}.coach-script{margin-top:8px;border-radius:10px;background:#16181d;color:#fff;padding:10px 12px;font-size:10px;font-weight:750;line-height:1.5}.coach-levels{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:10px}.coach-level{border:1px solid var(--ui-line);border-radius:11px;background:var(--ui-surface);padding:9px}.coach-level b{display:block;font-size:10px;margin:6px 0 2px}.coach-level p{font-size:9px;line-height:1.45;color:var(--ui-muted);margin:0}.coach-manual-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.coach-manual-card{border:1px solid var(--ui-line);border-radius:12px;background:var(--ui-surface-2);padding:11px}.coach-manual-card h3{font-size:11px;margin:0 0 5px}.coach-manual-card p{font-size:9px;line-height:1.55;color:var(--ui-muted);margin:0}.leadership-sources{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:12px}.source-card{border:1px solid var(--ui-line);border-radius:12px;background:var(--ui-surface);padding:12px}.source-card h3{font-size:11px;line-height:1.4;margin:8px 0 5px}.source-card p{font-size:9px;line-height:1.55;color:var(--ui-muted);margin:0 0 7px}.source-card a{font-size:9px;color:#175cd3;text-decoration:none}

/* Explicit dark-mode text contrast — never inherit white onto light surfaces */
html[data-theme="dark"] .quest-hero-main,html[data-theme="dark"] .quest-progress-card,html[data-theme="dark"] .setup-group,html[data-theme="dark"] .sample-board,html[data-theme="dark"] .sample-day,html[data-theme="dark"] .sample-org-leader,html[data-theme="dark"] .sample-person,html[data-theme="dark"] .sample-milestone,html[data-theme="dark"] .sample-debrief-card,html[data-theme="dark"] .quest-box,html[data-theme="dark"] .toolkit-card,html[data-theme="dark"] .artifact-editor,html[data-theme="dark"] .artifact-preview,html[data-theme="dark"] .artifact-row,html[data-theme="dark"] .coach-output,html[data-theme="dark"] .coach-level,html[data-theme="dark"] .coach-manual-card,html[data-theme="dark"] .source-card{background:var(--ui-surface);color:var(--ui-ink);border-color:var(--ui-line)}
html[data-theme="dark"] .setup-group,html[data-theme="dark"] .sample-board,html[data-theme="dark"] .artifact-editor,html[data-theme="dark"] .artifact-preview,html[data-theme="dark"] .coach-manual-card{background:var(--ui-surface-2)}
html[data-theme="dark"] .role-pill.d{background:#f2f4f7;color:#11151a}

@media(max-width:1050px){.setup-groups{grid-template-columns:repeat(2,1fr)}.sample-calendar{grid-template-columns:repeat(3,1fr)}.sample-milestones{grid-template-columns:repeat(2,1fr)}.coach-manual-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:900px){.quest-hero,.quest-layout,.artifact-body,.coach-layout{grid-template-columns:1fr}.quest-sidebar{position:static;max-height:none}.quest-list{max-height:360px}.quest-reflection-questions{grid-template-columns:1fr}.sample-org{grid-template-columns:1fr}.leadership-sources{grid-template-columns:1fr}}
@media(max-width:620px){.setup-groups,.sample-calendar,.sample-team-nodes,.sample-milestones,.sample-debrief,.coach-levels,.coach-manual-grid,.artifact-fields{grid-template-columns:1fr}.section-head{flex-direction:column}.today-nudge-card{grid-template-columns:1fr}.toolkit-card summary{grid-template-columns:1fr}.quest-learning-grid{grid-template-columns:1fr}}
@media(max-width:900px){.sidebar{position:static;height:auto;overflow:visible}.sidebar-head{position:static}.sidebar-nav-scroll{overflow:visible;padding-top:12px}.quest-chief-rail{max-height:none;overflow:visible;padding-right:0}.quest-chief-rail>.chief-rail-card:first-child{position:static;box-shadow:0 1px 2px rgba(16,24,40,.03)}}

.reference-image-card{margin-top:14px;border:1px solid var(--ui-line);border-radius:14px;background:var(--ui-surface-2);overflow:hidden}
.reference-image-card summary{cursor:pointer;padding:10px 12px;display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:10px;font-weight:850;color:var(--ui-ink)}
.reference-image-wrap{border-top:1px solid var(--ui-line);background:#eef0eb;padding:10px}.reference-image-wrap img{display:block;width:100%;height:auto;border-radius:9px;box-shadow:0 8px 28px rgba(16,24,40,.08)}.reference-image-note{padding:9px 11px;font-size:9px;line-height:1.5;color:var(--ui-muted);border-top:1px solid var(--ui-line)}
.ref-layout{display:grid;grid-template-columns:1.25fr .75fr;gap:10px}.ref-main,.ref-rail{display:grid;gap:8px}.ref-card{border:1px solid var(--ui-line);border-radius:11px;background:var(--ui-surface);padding:10px}.ref-card .ref-k{font-size:8px;font-weight:950;letter-spacing:.08em;color:var(--ui-muted)}.ref-card h4{font-size:12px;margin:4px 0 3px}.ref-card p{font-size:9px;line-height:1.5;color:var(--ui-muted);margin:0}.ref-attention{display:grid;grid-template-columns:34px 1fr auto;gap:8px;align-items:start;padding:8px 0;border-bottom:1px solid var(--ui-line)}.ref-attention:last-child{border-bottom:0}.ref-attention .no{font-size:18px;color:#98a2b3;font-weight:800}.ref-attention .verb{font-size:8px;font-weight:900;color:var(--lo-orange)}.ref-attention b{display:block;font-size:10px;margin:2px 0}.ref-attention small{font-size:8px;color:var(--ui-muted)}.ref-progress{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.ref-stage{border:1px solid var(--ui-line);border-radius:10px;padding:8px;background:var(--ui-surface)}.ref-stage strong{font-size:9px}.ref-stage span{display:block;font-size:8px;color:var(--ui-muted);margin-top:3px}.ref-progressbar{height:5px;border-radius:999px;background:#e4e7ec;margin-top:7px;overflow:hidden}.ref-progressbar i{display:block;height:100%;background:#2f6b52}.ref-stepper{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:9px}.ref-step{text-align:center;font-size:8px;color:var(--ui-muted)}.ref-step b{display:block;width:20px;height:20px;border-radius:50%;margin:0 auto 4px;border:1px solid var(--ui-line);display:grid;place-items:center;background:var(--ui-surface)}.ref-step.active b{background:#2f6b52;color:#fff;border-color:#2f6b52}.decision-options{display:grid;grid-template-columns:1fr 1fr;gap:8px}.decision-option{border:1px solid var(--ui-line);border-radius:12px;padding:10px;background:var(--ui-surface)}.decision-option.selected{border-color:#2f6b52;box-shadow:0 0 0 1px #2f6b52 inset}.decision-option h4{font-size:13px;margin:0 0 5px}.decision-option ul{margin:6px 0 0;padding-left:15px;font-size:8px;color:var(--ui-muted);line-height:1.5}
html[data-theme="dark"] .reference-image-wrap{background:#101418}
@media(max-width:760px){.ref-layout,.decision-options{grid-template-columns:1fr}.ref-progress,.ref-stepper{grid-template-columns:repeat(2,1fr)}}


/* RECOVERY-12 — Artifact-linked practice, diagnostics, role packs, skill persistence */
.role-pack-bar{display:grid;grid-template-columns:minmax(0,1fr) minmax(190px,250px);gap:12px;align-items:center;margin-top:16px;padding:11px 12px;border:1px solid #dbe1ea;border-radius:12px;background:rgba(255,255,255,.72)}
.role-pack-copy{display:grid;gap:2px}.role-pack-copy strong{font-size:12px;color:var(--ui-ink)}.role-pack-copy small{font-size:9px;line-height:1.45;color:var(--ui-muted)}
.role-pack-bar select{width:100%;border:1px solid var(--ui-line);border-radius:9px;background:var(--ui-surface);color:var(--ui-ink);padding:8px 9px;font-size:10px;font-weight:750}
html[data-theme="dark"] .role-pack-bar{background:#141a21;border-color:#34404c}

.setup-item{position:relative}
.setup-item .setup-source{display:inline-flex;margin-top:4px;font-size:8px;font-weight:850;color:#667085}
.setup-item.done .setup-source{color:var(--lo-green)}
.setup-item.auto-done{background:#f7fef9!important;border-color:#d1fadf!important}
html[data-theme="dark"] .setup-item.auto-done{background:#10261a!important;border-color:#245b36!important}

.artifact-diagnostics{display:grid;gap:7px;margin-top:12px}
.diag-card{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:9px;align-items:start;border:1px solid var(--ui-line);border-radius:11px;background:var(--ui-surface-2);padding:9px 10px;color:var(--ui-ink)}
.diag-card .diag-icon{width:22px;height:22px;border-radius:7px;display:grid;place-items:center;font-size:10px;font-weight:900;background:#f2f4f7;color:#475467}
.diag-card strong{display:block;font-size:10px;line-height:1.4}.diag-card p{font-size:9px;line-height:1.5;color:var(--ui-muted);margin:2px 0 0}.diag-card small{font-size:8px;font-weight:850;color:var(--ui-muted);white-space:nowrap}
.diag-card.warn{border-color:#fedf89;background:#fffaeb}.diag-card.warn .diag-icon{background:#fef0c7;color:#b54708}
.diag-card.critical{border-color:#fecdca;background:#fef3f2}.diag-card.critical .diag-icon{background:#fee4e2;color:#b42318}
.diag-card.good{border-color:#abefc6;background:#ecfdf3}.diag-card.good .diag-icon{background:#d1fadf;color:#067647}
html[data-theme="dark"] .diag-card{background:var(--ui-surface);border-color:var(--ui-line)}
html[data-theme="dark"] .diag-card.warn{background:#291f0f;border-color:#6c5321}
html[data-theme="dark"] .diag-card.critical{background:#2b1619;border-color:#613039}
html[data-theme="dark"] .diag-card.good{background:#10261a;border-color:#245b36}

.artifact-linker{margin-top:8px;padding:9px;border:1px solid var(--ui-line);border-radius:10px;background:var(--ui-surface-2)}
.artifact-linker-head{display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:6px}.artifact-linker-head b{font-size:9px}.artifact-linker-head span{font-size:8px;color:var(--ui-muted)}
.artifact-linker-controls{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px}
.artifact-linker select{width:100%;border:1px solid var(--ui-line);border-radius:8px;background:var(--ui-surface);color:var(--ui-ink);padding:7px 8px;font-size:9px}
.artifact-linker button{min-height:30px!important;padding:5px 8px!important;font-size:9px!important}
.evidence-ref-list{display:flex;gap:5px;flex-wrap:wrap;margin-top:7px}.evidence-ref{display:inline-flex;align-items:center;gap:5px;border:1px solid #b2ddff;background:#eff8ff;color:#175cd3;border-radius:999px;padding:4px 6px;font-size:8px;font-weight:800}.evidence-ref button{all:unset;cursor:pointer;color:#175cd3;font-size:10px}
html[data-theme="dark"] .artifact-linker{background:var(--ui-surface)}html[data-theme="dark"] .evidence-ref{background:#12263b;border-color:#244f75;color:#84caff}html[data-theme="dark"] .evidence-ref button{color:#84caff}

.artifact-fields .field select,.artifact-fields .field textarea{width:100%;border:1px solid var(--ui-line);background:var(--ui-surface);color:var(--ui-ink);border-radius:9px;padding:8px;font-size:10px;min-height:36px}.artifact-fields .field textarea{min-height:64px;resize:vertical}
.artifact-record-meta{display:flex;gap:5px;flex-wrap:wrap;margin-top:5px}.artifact-record-meta span{font-size:8px;border:1px solid var(--ui-line);border-radius:999px;padding:3px 5px;color:var(--ui-muted);background:var(--ui-surface-2)}
.artifact-record-meta .fact{color:#067647;background:#ecfdf3;border-color:#abefc6}.artifact-record-meta .hypothesis{color:#b54708;background:#fffaeb;border-color:#fedf89}.artifact-record-meta .unknown{color:#475467;background:#f2f4f7;border-color:#e4e7ec}
html[data-theme="dark"] .artifact-record-meta .fact{background:#10261a;border-color:#245b36;color:#86efac}
html[data-theme="dark"] .artifact-record-meta .hypothesis{background:#291f0f;border-color:#6c5321;color:#fbbf24}
html[data-theme="dark"] .artifact-record-meta .unknown{background:#232a32;border-color:#34404c;color:#d0d5dd}

.calendar-import{margin-top:10px;border-top:1px dashed var(--ui-line);padding-top:10px}.calendar-import summary{cursor:pointer;font-size:9px;font-weight:850;color:var(--ui-ink)}.calendar-import textarea{width:100%;min-height:92px;margin-top:7px;border:1px solid var(--ui-line);border-radius:9px;background:var(--ui-surface);color:var(--ui-ink);padding:8px;font-size:9px;line-height:1.5;resize:vertical}.calendar-import-help{font-size:8px;line-height:1.5;color:var(--ui-muted);margin-top:5px}

.milestone-mini{display:grid;gap:5px;margin-top:5px}.milestone-mini span{font-size:8px;color:var(--ui-muted)}.milestone-mini b{font-size:9px;color:var(--ui-ink)}
.team-state{display:inline-flex;font-size:8px;font-weight:900;border-radius:999px;padding:3px 6px;margin-top:5px}
.team-state.fact{background:#ecfdf3;color:#067647}.team-state.hypothesis{background:#fffaeb;color:#b54708}.team-state.unknown{background:#f2f4f7;color:#475467}
html[data-theme="dark"] .team-state.fact{background:#10261a;color:#86efac}html[data-theme="dark"] .team-state.hypothesis{background:#291f0f;color:#fbbf24}html[data-theme="dark"] .team-state.unknown{background:#232a32;color:#d0d5dd}

.skill-card .skill-progress{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin:10px 0 8px}.skill-card .skill-step{min-height:28px!important;padding:4px 5px!important;font-size:8px!important;border-radius:8px!important}.skill-card .skill-step.active{background:#16181d;color:#fff;border-color:#16181d}.skill-card .skill-step.done{background:#ecfdf3;color:#067647;border-color:#abefc6}
.skill-card .skill-state-row{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:8px}.skill-card .skill-state-row span{font-size:8px;color:var(--ui-muted)}.skill-card .skill-reset{min-height:26px!important;padding:3px 6px!important;font-size:8px!important}
html[data-theme="dark"] .skill-card .skill-step.active{background:#f2f4f7;color:#11151a;border-color:#f2f4f7}html[data-theme="dark"] .skill-card .skill-step.done{background:#10261a;color:#86efac;border-color:#245b36}

.backend-contract-note{margin-top:8px;padding:8px 9px;border-left:3px solid #667085;background:var(--ui-surface-2);font-size:8px;line-height:1.5;color:var(--ui-muted);border-radius:0 8px 8px 0}
@media(max-width:720px){.role-pack-bar,.artifact-linker-controls{grid-template-columns:1fr}.diag-card{grid-template-columns:auto 1fr}.diag-card small{grid-column:2}.skill-card .skill-progress{grid-template-columns:repeat(2,1fr)}}


/* RECOVERY 13 · Leadership Operating Review */
.quest-layout{grid-template-columns:270px minmax(0,1fr) 280px!important;gap:16px!important}
.quest-chief-rail{position:sticky;top:86px;display:grid;gap:10px;align-self:start;max-height:calc(100vh - 106px);overflow:auto;padding-right:4px;scrollbar-gutter:stable}
.quest-chief-rail>.chief-rail-card:first-child{position:sticky;top:0;z-index:3;background:var(--ui-surface);box-shadow:0 10px 24px rgba(16,24,40,.08)}
.chief-rail-card{border:1px solid var(--ui-line);border-radius:13px;background:var(--ui-surface);padding:13px;color:var(--ui-ink);box-shadow:0 1px 2px rgba(16,24,40,.03)}
.chief-rail-card strong{display:block;font-size:11px;line-height:1.45;margin:5px 0;color:var(--ui-ink)}
.chief-rail-card p{font-size:10px;line-height:1.55;margin:0;color:var(--ui-muted)}
.chief-rail-card.emphasis{border-color:#a7c7b5;background:#f3faf6}
.chief-rail-card.emphasis .primary{margin-top:10px;width:100%}
.chief-evidence{display:inline-flex;margin-top:8px;padding:4px 6px;border-radius:999px;background:var(--ui-surface-2);border:1px solid var(--ui-line);font-size:8px;font-weight:800;color:var(--ui-muted)}
.chief-question{width:100%;text-align:left!important;background:var(--ui-surface-2)!important;color:var(--ui-ink)!important;border:1px solid var(--ui-line)!important;margin-top:6px!important;font-size:9px!important;line-height:1.45!important;white-space:normal!important}
.r13-sample-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}
.r13-sample-card{border:1px solid var(--ui-line);border-radius:12px;padding:12px;background:var(--ui-surface);display:grid;gap:5px}
.r13-sample-card small,.weekly-review-cell small{font-size:8px;font-weight:900;letter-spacing:.08em;color:var(--ui-muted)}
.r13-sample-card b,.weekly-review-cell b{font-size:10px;line-height:1.5;color:var(--ui-ink)}
.r13-sample-card span{font-size:9px;color:var(--ui-muted)}
.r13-sample-card.muted-card{background:var(--ui-surface-2)}
.artifact-editor-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:8px}
.artifact-editor-head h3{margin:3px 0 0}
.artifact-row-actions{display:flex;flex-direction:column;align-items:flex-end;gap:6px;min-width:86px}
.artifact-row-actions button{min-width:66px}
.artifact-version{font-size:8px;font-weight:850;color:var(--ui-muted);padding:3px 6px;border:1px solid var(--ui-line);border-radius:999px;background:var(--ui-surface-2)}
.artifact-history{margin-top:9px;border-top:1px dashed var(--ui-line);padding-top:7px}
.artifact-history summary{font-size:8px;font-weight:850;color:var(--ui-muted);cursor:pointer}
.artifact-history-item{display:grid;grid-template-columns:30px 1fr;gap:6px;padding:6px 0;border-bottom:1px solid var(--ui-line)}
.artifact-history-item:last-child{border-bottom:0}
.artifact-history-item b{font-size:8px}.artifact-history-item span{font-size:8px;color:var(--ui-muted);line-height:1.45}.artifact-history-item small{grid-column:2;font-size:7px;color:var(--ui-muted)}
.weekly-review-shell{margin-top:18px}
.weekly-review-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:12px}
.weekly-review-cell{border:1px solid var(--ui-line);border-radius:12px;padding:12px;background:var(--ui-surface);display:grid;gap:5px;min-height:72px}
.weekly-review-cell.emphasis{background:#f3faf6;border-color:#a7c7b5}
.weekly-review-attention{margin-top:10px;border-left:3px solid var(--lo-teal);background:var(--ui-surface-2);border-radius:0 12px 12px 0;padding:12px 14px}
.weekly-review-attention strong{display:block;font-size:11px;margin:5px 0;color:var(--ui-ink)}
.weekly-review-attention p{font-size:9px;color:var(--ui-muted);margin:0}
html[data-theme="dark"] .chief-rail-card.emphasis,html[data-theme="dark"] .weekly-review-cell.emphasis{background:#10261a;border-color:#245b36}
@media(max-width:1180px){.quest-layout{grid-template-columns:250px minmax(0,1fr)!important}.quest-chief-rail{position:static;grid-column:1/-1;grid-template-columns:repeat(4,minmax(0,1fr))}.chief-rail-card{min-height:120px}}
@media(max-width:900px){.quest-layout{grid-template-columns:1fr!important}.quest-chief-rail{grid-template-columns:1fr 1fr}.r13-sample-grid,.weekly-review-grid{grid-template-columns:1fr 1fr}}
@media(max-width:620px){.quest-chief-rail,.r13-sample-grid,.weekly-review-grid{grid-template-columns:1fr}.artifact-row-actions{flex-direction:row;align-items:center;min-width:0;flex-wrap:wrap}}

      /* Recovery 14 — Team OS Charter / confirmation / transition */
      .artifact-version.confirmed,.state-badge.confirmed{background:#ecfdf3!important;color:#067647!important;border-color:#abefc6!important}
      .artifact-relations{margin-top:10px;padding:10px;border:1px dashed var(--ui-line);border-radius:11px;background:var(--ui-surface)}
      .artifact-link-summary{display:flex;flex-wrap:wrap;gap:5px;margin-top:7px}.artifact-link-summary span{font-size:8px;color:#344054;background:#f2f4f7;border:1px solid #e4e7ec;border-radius:999px;padding:3px 6px}
      .r14-context-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:0 0 16px}.r14-context-card{background:#fff;border:1px solid #e7e8eb;border-radius:14px;padding:14px}.r14-context-card .section-kicker{display:block;margin-bottom:5px}.r14-context-card strong{display:block;font-size:12px;line-height:1.45}.r14-context-card p{font-size:10px;line-height:1.55;color:#667085;margin:5px 0}.r14-context-card .review-meta{font-size:9px}
      .charter-shell,.day30-transition-shell{margin-top:18px}.charter-status{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:11px;font-size:9px;color:var(--ui-muted)}.charter-grid,.next60-preview{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.charter-grid>div,.next60-preview>div{border:1px solid var(--ui-line);border-radius:11px;background:var(--ui-surface-2);padding:11px}.charter-grid small,.next60-preview small{display:block;font-size:8px;font-weight:900;letter-spacing:.08em;color:var(--ui-muted);margin-bottom:5px}.charter-grid b,.next60-preview b{display:block;font-size:10px;line-height:1.55;color:var(--ui-ink)}
      .transition-gate{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;padding:13px;border:1px solid var(--ui-line);border-left:4px solid var(--lo-orange);border-radius:12px;background:var(--ui-surface);margin-bottom:10px}.transition-gate strong{display:block;font-size:12px;margin:4px 0}.transition-gate p{font-size:10px;color:var(--ui-muted);line-height:1.55;margin:0}.next60-preview{grid-template-columns:repeat(3,minmax(0,1fr))}
      .report-os-card{margin-top:14px}
      html[data-theme="dark"] .r14-context-card,html[data-theme="dark"] .artifact-relations,html[data-theme="dark"] .charter-grid>div,html[data-theme="dark"] .next60-preview>div,html[data-theme="dark"] .transition-gate{background:var(--ui-surface);color:var(--ui-ink);border-color:var(--ui-line)}html[data-theme="dark"] .artifact-link-summary span{background:#232a32;border-color:#34404c;color:#d0d5dd}
      @media(max-width:760px){.r14-context-grid,.charter-grid,.next60-preview{grid-template-columns:1fr}.transition-gate{flex-direction:column}}

    
      /* Recovery 15 · Integration & Reliability */
      .integration-shell { margin-top:18px; border:1px solid #dfe3e7; background:linear-gradient(180deg,#fff,#fbfcfc); }
      .integration-grid { display:grid; grid-template-columns:1.15fr .85fr; gap:14px; }
      .dependency-map { display:grid; gap:12px; }
      .dependency-lane { border:1px solid #e4e7ea; background:#fff; border-radius:16px; padding:14px; }
      .dependency-lane-head { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:11px; }
      .dependency-lane-head strong { font-size:14px; color:#15181d; }
      .dependency-flow { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:8px; align-items:stretch; }
      .dependency-node { min-width:0; border:1px solid #e2e5e8; background:#f8f9fa; border-radius:12px; padding:10px; color:#20242a; text-align:left; }
      button.dependency-node { cursor:pointer; }
      button.dependency-node:hover { border-color:#94a3a0; background:#f2f6f4; }
      .dependency-node small { display:block; color:#747b84; font-size:9px; font-weight:800; letter-spacing:.06em; margin-bottom:5px; }
      .dependency-node b { display:block; font-size:11px; line-height:1.35; overflow-wrap:anywhere; }
      .dependency-node.missing { border-style:dashed; color:#8a5a15; background:#fff9ed; }
      .dependency-node.confirmed { background:#eef7f1; border-color:#c8dfd0; color:#184b35; }
      .dependency-arrow { display:none; }
      .system-health-list { display:grid; gap:8px; }
      .health-item { display:grid; grid-template-columns:26px 1fr auto; gap:9px; align-items:start; padding:10px 11px; border-radius:12px; border:1px solid #e2e5e8; background:#fff; }
      .health-item.critical { border-color:#efc4c4; background:#fff4f4; }
      .health-item.warn { border-color:#ead7b7; background:#fffaf1; }
      .health-item.good { border-color:#c9dfd1; background:#f2f8f4; }
      .health-item .health-icon { width:24px; height:24px; border-radius:8px; display:grid; place-items:center; background:#eef0f2; font-weight:900; font-size:11px; color:#374151; }
      .health-item strong { display:block; font-size:11px; color:#252930; }
      .health-item p { margin:3px 0 0; font-size:10px; color:#666e78; line-height:1.45; }
      .health-item button { font-size:9px; padding:6px 8px; }
      .evidence-inspector { display:grid; gap:10px; }
      .evidence-summary { display:flex; flex-wrap:wrap; gap:7px; margin-bottom:4px; }
      .evidence-row { display:grid; grid-template-columns:1fr auto; gap:10px; align-items:center; border:1px solid #e2e5e8; border-radius:12px; padding:10px 12px; background:#fff; }
      .evidence-row strong { display:block; font-size:11px; color:#20242a; }
      .evidence-row small { display:block; margin-top:3px; color:#747b84; font-size:9px; }
      .evidence-state { font-size:9px; font-weight:850; padding:4px 7px; border-radius:999px; background:#f0f2f4; color:#434952; }
      .evidence-state.ok { background:#eaf6ef; color:#17623e; }
      .evidence-state.warn { background:#fff1da; color:#8a5a15; }
      .evidence-state.bad { background:#fdeaea; color:#9c3030; }
      .graduation-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; margin-top:10px; }
      .graduation-card { border:1px solid #e1e5e8; border-radius:14px; padding:12px; background:#fff; }
      .graduation-card small { display:block; color:#7a818a; font-size:9px; font-weight:850; letter-spacing:.05em; }
      .graduation-card strong { display:block; margin-top:5px; font-size:18px; color:#171a1f; }
      .graduation-gate { margin-top:12px; border-radius:14px; padding:13px 14px; display:flex; justify-content:space-between; gap:14px; align-items:center; background:#f4f6f7; border:1px solid #e1e5e8; }
      .graduation-gate.ready { background:#eef7f1; border-color:#c6dece; }
      .next60-tracker-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
      .outcome-board { display:grid; gap:8px; }
      .outcome-card { border:1px solid #e1e5e8; background:#fff; border-radius:13px; padding:11px 12px; }
      .outcome-card small { color:#7a818a; font-size:9px; font-weight:850; }
      .outcome-card strong { display:block; margin-top:4px; font-size:12px; color:#1e2228; }
      .outcome-card .checkin-meta { margin-top:6px; font-size:9px; color:#68707a; }
      .next60-form { display:grid; gap:9px; border:1px solid #e1e5e8; border-radius:14px; padding:12px; background:#fafbfb; }
      .next60-form .row2 { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
      .next60-form label { display:grid; gap:4px; font-size:9px; font-weight:800; color:#59616a; }
      .next60-form input,.next60-form select,.next60-form textarea { width:100%; border:1px solid #d9dde1; border-radius:9px; background:#fff; color:#20242a; padding:8px 9px; font-size:10px; }
      .brief-shell { display:grid; grid-template-columns:1fr auto; gap:12px; align-items:start; }
      .manager-brief { border:1px solid #dfe3e7; border-radius:15px; background:#fff; padding:14px; white-space:pre-wrap; color:#282d34; font-size:11px; line-height:1.65; }
      .brief-actions { display:grid; gap:7px; min-width:126px; }
      .r15-inline-report { margin-top:12px; padding-top:12px; border-top:1px solid #e1e5e8; }
      .r15-inline-report strong { display:block; margin:5px 0; color:#22262c; }
      .r15-inline-report p { margin:0; color:#626a74; font-size:10px; line-height:1.5; }
      @media (max-width: 1100px) {
        .integration-grid,.next60-tracker-grid { grid-template-columns:1fr; }
        .dependency-flow { grid-template-columns:1fr; }
        .graduation-grid { grid-template-columns:1fr 1fr; }
      }
      @media (max-width: 720px) { .graduation-grid { grid-template-columns:1fr; } .brief-shell { grid-template-columns:1fr; } }


      /* Recovery 16 · Operating Graph */
      .r16-filterbar { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin:0 0 14px; padding:12px; background:#f8faf9; border:1px solid #e2e7e4; border-radius:14px; }
      .r16-filterbar label { display:grid; gap:6px; font-size:11px; font-weight:750; color:#66736d; }
      .r16-filterbar select { width:100%; min-height:38px; border:1px solid #d9dfdc; border-radius:9px; background:#fff; color:#18201c; padding:7px 9px; }
      .dependency-flow.r16-flow { display:grid; grid-template-columns:minmax(180px,1.2fr) repeat(4,minmax(150px,1fr)); align-items:stretch; gap:8px; }
      .dependency-cluster { min-width:0; border:1px solid #e6e9e7; border-radius:12px; padding:8px; background:#fbfcfb; }
      .dependency-cluster > small { display:block; margin-bottom:6px; color:#758079; font-weight:800; font-size:9px; letter-spacing:.08em; }
      .dependency-node + .dependency-node { margin-top:6px; }
      .dependency-node.calendar-node { border-style:dashed; }
      .r16-attention { display:inline-flex; align-items:center; border-radius:999px; padding:3px 7px; font-size:9px; font-weight:850; letter-spacing:.05em; }
      .r16-attention.clear { background:#edf8f0; color:#22633b; }
      .r16-attention.check { background:#fff7df; color:#875d00; }
      .r16-attention.critical { background:#fff0f0; color:#9f3030; }
      .artifact-relations select[multiple] { min-height:112px; padding:6px; }
      .artifact-relations .relation-help { display:block; margin-top:5px; color:#7a817d; font-size:10px; line-height:1.4; }
      .relation-chip-set { display:flex; gap:5px; flex-wrap:wrap; margin-top:8px; }
      .relation-chip-set span { padding:4px 7px; border-radius:999px; border:1px solid #dfe5e1; background:#f7faf8; color:#45514a; font-size:10px; }
      .r16-diff-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; }
      .r16-diff-card { border:1px solid #e2e7e4; border-radius:12px; padding:12px; background:#fbfcfb; }
      .r16-diff-card small { display:block; color:#758079; font-size:9px; font-weight:850; letter-spacing:.07em; margin-bottom:5px; }
      .r16-diff-card strong { display:block; font-size:12px; line-height:1.45; }
      .r16-diff-card.changed { border-color:#d8be73; background:#fffaf0; }
      .r16-diff-card.same { opacity:.72; }
      .r16-trend-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; }
      .r16-trend-card { border:1px solid #e1e6e3; border-radius:13px; padding:13px; background:#fff; }
      .r16-trend-line { display:flex; gap:5px; flex-wrap:wrap; margin-top:10px; }
      .r16-status-point { padding:5px 7px; border-radius:7px; font-size:9px; font-weight:850; background:#eef1ef; color:#53605a; }
      .r16-status-point.on_track { background:#edf8f0; color:#22633b; }
      .r16-status-point.at_risk { background:#fff7df; color:#875d00; }
      .r16-status-point.blocked { background:#fff0f0; color:#9f3030; }
      .r16-status-point.done { background:#eaf3ff; color:#24588e; }
      .commitment-bridge-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
      .commitment-bridge-grid .full { grid-column:1/-1; }
      .commitment-bridge-list { display:grid; gap:8px; margin-top:12px; }
      .commitment-bridge-item { display:grid; grid-template-columns:1fr auto; gap:10px; padding:11px; border:1px solid #e2e7e4; border-radius:12px; background:#fbfcfb; }
      .commitment-bridge-item p { margin:4px 0 0; color:#65716b; font-size:11px; }
      .r16-mini-link { color:#35634a; font-weight:750; }
      @media(max-width:1100px){ .dependency-flow.r16-flow{grid-template-columns:1fr 1fr}.r16-filterbar,.r16-diff-grid,.r16-trend-grid{grid-template-columns:1fr 1fr} }
      @media(max-width:720px){ .dependency-flow.r16-flow,.r16-filterbar,.r16-diff-grid,.r16-trend-grid,.commitment-bridge-grid{grid-template-columns:1fr}.commitment-bridge-grid .full{grid-column:auto} }
      @media(prefers-color-scheme:dark){
        .r16-filterbar,.dependency-cluster,.r16-diff-card,.commitment-bridge-item{background:#171a18;border-color:#303632;color:#f0f3f1}
        .r16-filterbar label,.dependency-cluster>small,.r16-diff-card small,.commitment-bridge-item p{color:#a9b2ad}
        .r16-filterbar select,.r16-trend-card{background:#111412;color:#f0f3f1;border-color:#343a36}
        .relation-chip-set span{background:#1b211d;color:#d8e0db;border-color:#39423c}
      }
    
      /* Recovery 17 · Time / Follow-up / Decision Velocity */
      .r17-shell{margin-top:18px;border:1px solid #dfe3e8;border-radius:18px;background:#fff;padding:20px;box-shadow:0 8px 28px rgba(17,24,39,.04)}
      .r17-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:14px}.r17-head h2{font-size:18px;margin:2px 0 5px}.r17-head p{font-size:12px;color:#667085;line-height:1.55;margin:0;max-width:720px}
      .r17-controls{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.r17-controls select{min-width:135px}
      .r17-group{border:1px solid #e7e8eb;border-radius:14px;padding:14px;margin-top:12px;background:#fafbfc}.r17-group-title{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:10px}.r17-group-title strong{font-size:13px}.r17-group-title span{font-size:10px;color:#667085;font-weight:800}
      .r17-lanes{display:grid;gap:10px}.r17-lane{border:1px solid #e6e8ec;border-radius:12px;padding:12px;background:#fff}.r17-lane summary{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;list-style:none}.r17-lane summary::-webkit-details-marker{display:none}.r17-lane-title{font-size:13px;font-weight:800}.r17-lane-meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:5px}
      .r17-chip{display:inline-flex;align-items:center;padding:4px 7px;border-radius:999px;font-size:9px;font-weight:850;border:1px solid #e1e4e8;background:#f6f7f8;color:#475467}.r17-chip.overdue{background:#fff1f2;border-color:#fecdd3;color:#9f1239}.r17-chip.due-soon{background:#fffbeb;border-color:#fde68a;color:#92400e}.r17-chip.clear{background:#ecfdf3;border-color:#bbf7d0;color:#166534}.r17-chip.open{background:#eef2ff;border-color:#c7d2fe;color:#3730a3}
      .r17-detail-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:10px}.r17-node{border:1px solid #eceef1;border-radius:10px;padding:9px;background:#fbfcfd}.r17-node small{display:block;font-size:9px;color:#667085;font-weight:800;margin-bottom:3px}.r17-node b{font-size:11px;line-height:1.35}.r17-node p{font-size:10px;color:#667085;margin:4px 0 0;line-height:1.4}
      .r17-metrics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.r17-metric{padding:12px;border:1px solid #e7e8eb;border-radius:12px;background:#fff}.r17-metric small{font-size:9px;color:#667085;font-weight:800}.r17-metric strong{display:block;font-size:22px;margin-top:4px}.r17-metric p{font-size:10px;color:#667085;margin:4px 0 0;line-height:1.4}
      .r17-followups{display:grid;gap:8px}.r17-followup{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;border:1px solid #e7e8eb;border-radius:12px;padding:12px;background:#fff}.r17-followup.overdue{border-color:#fecdd3;background:#fff7f8}.r17-followup.blocked{border-color:#fde68a;background:#fffdf5}.r17-followup strong{font-size:12px}.r17-followup p{font-size:10px;color:#667085;margin:4px 0 0}.r17-followup button{white-space:nowrap}
      .r17-decision-list{display:grid;gap:8px;margin-top:12px}.r17-decision{display:grid;grid-template-columns:1.4fr .7fr .7fr .8fr;gap:8px;align-items:center;padding:10px;border:1px solid #e7e8eb;border-radius:10px}.r17-decision b{font-size:11px}.r17-decision span{font-size:10px;color:#667085}.r17-decision .risk{color:#9f1239;font-weight:800}
      .r17-priority-proposal{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.r17-priority-proposal div{padding:10px;border:1px solid #e7e8eb;border-radius:10px;background:#fafafa}.r17-priority-proposal small{display:block;font-size:9px;color:#667085;font-weight:800}.r17-priority-proposal b{font-size:11px;line-height:1.35}.r17-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:12px;flex-wrap:wrap}
      .r17-report-ext{margin-top:12px;padding-top:12px;border-top:1px solid #e7e8eb}.r17-report-ext strong{display:block;font-size:11px;margin-bottom:5px}.r17-report-ext p{font-size:10px;color:#667085;line-height:1.5;margin:0}
      @media(max-width:900px){.r17-detail-grid,.r17-metrics,.r17-priority-proposal{grid-template-columns:1fr 1fr}.r17-decision{grid-template-columns:1fr 1fr}.r17-head{flex-direction:column}}
      @media(max-width:600px){.r17-detail-grid,.r17-metrics,.r17-priority-proposal,.r17-decision{grid-template-columns:1fr}}

    

/* RECOVERY 18 · Ways of Working */
.wow-hero{background:linear-gradient(135deg,#17211c 0%,#26382f 100%);color:#fff;border-radius:22px;padding:28px;display:grid;grid-template-columns:1.25fr .75fr;gap:24px;align-items:end;margin-bottom:18px;overflow:hidden;position:relative}
.wow-hero::after{content:"";position:absolute;width:260px;height:260px;border:46px solid rgba(255,255,255,.055);border-radius:50%;right:-85px;top:-95px;pointer-events:none}
.wow-hero h2{font-size:27px;line-height:1.16;margin:7px 0 10px;letter-spacing:-.025em}
.wow-hero p{margin:0;color:#d7e2dc;line-height:1.7;font-size:13px;max-width:720px}
.wow-hero .wow-book{position:relative;z-index:1;border:1px solid rgba(255,255,255,.18);background:rgba(255,255,255,.08);border-radius:16px;padding:16px;font-size:12px;line-height:1.6;color:#eaf1ed}
.wow-kicker{font-size:10px;font-weight:850;letter-spacing:.12em;text-transform:uppercase;color:#b7c9bf}
.wow-section{margin-top:18px}
.wow-section-head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;margin-bottom:12px}
.wow-section-head h2{font-size:18px;margin:3px 0 5px}.wow-section-head p{margin:0;color:#6b7280;font-size:12px;line-height:1.6;max-width:720px}
.wow-compass{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.wow-quadrant{border:1px solid #e1e5e2;border-radius:14px;padding:15px;background:#fff;min-height:125px}.wow-quadrant strong{display:block;font-size:13px;margin-bottom:7px}.wow-quadrant p{font-size:11px;line-height:1.55;color:#68716c;margin:0}.wow-quadrant.good{border-color:#9bc3ad;background:#f2faf5}.wow-quadrant.good strong{color:#1f6b44}
.wow-principle{display:grid;grid-template-columns:1fr 1fr;gap:14px}.wow-principle .card{min-height:100%}
.wow-cycle{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:7px;align-items:stretch}.wow-cycle-step{border:1px solid #e0e4e1;background:#fff;border-radius:12px;padding:12px 9px;text-align:left;min-height:118px;transition:.16s}.wow-cycle-step:hover{transform:translateY(-1px);border-color:#9aae9f}.wow-cycle-step.done{background:#edf7f0;border-color:#81ad91}.wow-cycle-step .num{font-size:10px;color:#8a948e}.wow-cycle-step b{display:block;font-size:12px;margin:7px 0 5px}.wow-cycle-step span{font-size:10px;color:#747d78;line-height:1.4;display:block}.wow-cycle-progress{height:7px;background:#ecefec;border-radius:999px;overflow:hidden;margin-top:11px}.wow-cycle-progress i{height:100%;display:block;background:#2f7650;width:0;transition:.2s}
.wow-example-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.wow-example{border:1px solid #e3e5e4;border-radius:14px;padding:15px;background:#fff}.wow-example .badline{font-size:11px;background:#fff4f3;border:1px solid #ffd7d3;color:#9a3f36;padding:9px 10px;border-radius:9px;margin:9px 0}.wow-example .goodline{font-size:11px;background:#f0f8f3;border:1px solid #cee6d5;color:#285f3e;padding:9px 10px;border-radius:9px;line-height:1.55}.wow-example h3{font-size:13px;margin:0}.wow-example p{font-size:11px;color:#717a75;line-height:1.55}
.wow-core{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.wow-core article{border-radius:13px;background:#f7f8f7;border:1px solid #e3e6e4;padding:13px}.wow-core b{display:block;font-size:17px;color:#2f7650}.wow-core strong{display:block;font-size:11px;margin:4px 0}.wow-core p{font-size:10px;color:#707975;line-height:1.5;margin:0}
.wow-practice{display:grid;grid-template-columns:.84fr 1.16fr;gap:14px}.wow-control{display:grid;gap:11px}.wow-control label{font-size:11px;font-weight:750;color:#3f4642}.wow-control select,.wow-control textarea,.wow-control input{width:100%;margin-top:5px;border:1px solid #dfe3e0;background:#fff;color:#1d2420;border-radius:9px;padding:9px 10px;font-size:12px}.wow-control textarea{min-height:95px;resize:vertical}.wow-output{border:1px solid #dbe4de;background:#f5faf7;border-radius:15px;padding:16px;min-height:220px}.wow-output .wow-output-title{font-size:10px;color:#567260;font-weight:850;letter-spacing:.08em;text-transform:uppercase}.wow-output pre{white-space:pre-wrap;font-family:inherit;font-size:12px;line-height:1.65;color:#26312b;margin:10px 0 0}.wow-btns{display:flex;gap:7px;flex-wrap:wrap}.wow-route-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}.wow-route{border:1px solid #e0e4e1;border-radius:12px;background:#fff;padding:12px;text-align:left}.wow-route b{font-size:11px;display:block}.wow-route span{display:block;font-size:10px;color:#7a837e;margin-top:4px;line-height:1.4}
.wow-operating-rules{display:grid;grid-template-columns:1fr 1fr;gap:8px}.wow-rule{display:flex;align-items:flex-start;gap:8px;border:1px solid #e3e6e4;background:#fff;border-radius:11px;padding:10px;font-size:11px;line-height:1.45}.wow-rule input{margin-top:2px}
.wow-source-list{display:grid;gap:8px}.wow-source{border-left:3px solid #879b8e;padding:6px 0 6px 11px}.wow-source b{display:block;font-size:11px}.wow-source span{font-size:10px;color:#747d78;line-height:1.5}
.wow-saved-list{display:grid;gap:8px;margin-top:9px}.wow-saved{border:1px solid #e2e5e3;background:#fff;border-radius:10px;padding:10px;font-size:11px}.wow-saved b{display:block;margin-bottom:3px}.wow-note{border:1px dashed #cfd7d2;background:#fafcfb;color:#5f6963;border-radius:10px;padding:10px;font-size:10px;line-height:1.55}
html[data-theme="dark"] .wow-quadrant,html[data-theme="dark"] .wow-cycle-step,html[data-theme="dark"] .wow-example,html[data-theme="dark"] .wow-route,html[data-theme="dark"] .wow-rule,html[data-theme="dark"] .wow-saved{background:#171b19;border-color:#333a36;color:#edf2ef}
html[data-theme="dark"] .wow-quadrant.good{background:#15241b;border-color:#315c43}html[data-theme="dark"] .wow-quadrant p,html[data-theme="dark"] .wow-cycle-step span,html[data-theme="dark"] .wow-example p,html[data-theme="dark"] .wow-route span,html[data-theme="dark"] .wow-source span{color:#aeb8b2}
html[data-theme="dark"] .wow-core article{background:#161a18;border-color:#333a36}html[data-theme="dark"] .wow-control select,html[data-theme="dark"] .wow-control textarea,html[data-theme="dark"] .wow-control input{background:#111513;color:#eef3f0;border-color:#39413c}html[data-theme="dark"] .wow-output{background:#142019;border-color:#304a3a}html[data-theme="dark"] .wow-output pre{color:#e5ede8}html[data-theme="dark"] .wow-note{background:#151917;border-color:#3a443e;color:#b8c1bc}
@media(max-width:980px){.wow-hero,.wow-practice,.wow-principle{grid-template-columns:1fr}.wow-cycle{grid-template-columns:repeat(2,1fr)}.wow-example-grid{grid-template-columns:1fr}.wow-route-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:620px){.wow-compass,.wow-core,.wow-operating-rules{grid-template-columns:1fr}.wow-cycle{grid-template-columns:1fr}.wow-route-grid{grid-template-columns:1fr}}

    
/* RECOVERY 24 · AI Work OS */
.ai24-hero{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(260px,.75fr);gap:18px;padding:28px;border-radius:24px;background:linear-gradient(135deg,#14251c,#254333);color:#fff;margin-bottom:18px;overflow:hidden}
.ai24-hero h2{font-size:clamp(26px,4vw,44px);line-height:1.05;margin:8px 0 12px;letter-spacing:-.035em}.ai24-hero p{color:#d7e7dd;line-height:1.7;max-width:780px}.ai24-hero-side{display:grid;gap:10px;align-content:start}.ai24-hero-side>div{padding:14px;border:1px solid rgba(255,255,255,.16);background:rgba(255,255,255,.07);border-radius:14px}.ai24-kicker{font-size:11px;letter-spacing:.12em;text-transform:uppercase;font-weight:800;color:#9fd2b4}
.ai24-session-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.ai24-session{padding:16px;border:1px solid var(--border);border-radius:16px;background:var(--panel);min-width:0}.ai24-session b{display:block;margin-bottom:5px}.ai24-session span{font-size:12px;line-height:1.55;color:var(--muted)}
.ai24-split-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}.ai24-split{border:1px solid var(--border);border-radius:16px;padding:16px;background:var(--panel);min-width:0;cursor:pointer}.ai24-split:hover,.ai24-split.active{background:#eef6f1;border-color:#8aab98;box-shadow:0 8px 24px rgba(30,70,49,.08);transform:translateY(-1px)}.ai24-split h3{font-size:14px;margin:0 0 8px}.ai24-meter{display:flex;height:10px;overflow:hidden;border-radius:999px;background:#e7ece9;margin:10px 0}.ai24-meter i:nth-child(1){background:#3c7659}.ai24-meter i:nth-child(2){background:#91a69a}.ai24-meter i:nth-child(3){background:#d8a54a}.ai24-split-legend{display:grid;grid-template-columns:repeat(3,1fr);gap:5px;font-size:10px;color:var(--muted)}
.ai24-ratio-editor{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}.ai24-ratio-editor label,.ai24-form label{font-size:11px;font-weight:700;color:var(--muted);display:grid;gap:6px}.ai24-ratio-editor input,.ai24-form input,.ai24-form select,.ai24-form textarea{width:100%;min-width:0;border:1px solid var(--border);border-radius:10px;padding:10px 11px;background:var(--panel);color:var(--text)}.ai24-ratio-status{margin-top:8px;font-size:11px;font-weight:700}
.ai24-architecture{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;align-items:stretch}.ai24-node{border:1px solid var(--border);background:var(--soft);border-radius:14px;padding:14px;min-width:0}.ai24-node b{display:block;font-size:12px}.ai24-node span{display:block;font-size:11px;line-height:1.5;color:var(--muted);margin-top:5px}
.ai24-budget-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(300px,.9fr);gap:16px}.ai24-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.ai24-form .wide{grid-column:1/-1}.ai24-summary{display:grid;gap:10px}.ai24-metric{padding:14px;border:1px solid var(--border);border-radius:14px;background:var(--soft)}.ai24-metric small{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.09em}.ai24-metric strong{display:block;font-size:24px;margin-top:4px;letter-spacing:-.03em}.ai24-bands{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.ai24-band{padding:10px;border-radius:11px;font-size:11px;font-weight:800;text-align:center}.ai24-band:nth-child(1){background:#eef7f2;color:#2f6349}.ai24-band:nth-child(2){background:#fff4dc;color:#835b13}.ai24-band:nth-child(3){background:#fff0ef;color:#9a4039}
.ai24-routing{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}.ai24-route-card{border:1px solid var(--border);border-radius:14px;padding:14px;background:var(--panel)}.ai24-route-card h3{font-size:13px;margin:0 0 8px}.ai24-route-card ul{padding-left:17px;margin:0;color:var(--muted);font-size:11px;line-height:1.65}
.ai24-ssot-flow{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}.ai24-ssot-step{position:relative;border:1px solid var(--border);border-radius:14px;padding:14px;background:var(--panel);min-width:0}.ai24-ssot-step b{display:block;font-size:12px}.ai24-ssot-step span{font-size:11px;line-height:1.5;color:var(--muted);display:block;margin-top:5px}.ai24-ssot-table{width:100%;border-collapse:collapse;font-size:11px}.ai24-ssot-table th,.ai24-ssot-table td{padding:10px;border-bottom:1px solid var(--border);text-align:left;vertical-align:top}.ai24-ssot-table th{color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.07em}
.ai24-rule-list{display:grid;gap:8px}.ai24-rule{display:flex;gap:10px;align-items:flex-start;border:1px solid var(--border);border-radius:13px;padding:12px;background:var(--panel)}.ai24-rule input{margin-top:3px}.ai24-rule span{font-size:12px;line-height:1.5}.ai24-rule small{display:block;color:var(--muted);margin-top:3px}.ai24-policy-preview{border:1px solid #9bb5a6;background:#f2f7f4;border-radius:16px;padding:16px}.ai24-policy-preview h3{margin:0 0 10px}.ai24-policy-preview pre{white-space:pre-wrap;word-break:break-word;font:inherit;font-size:11px;line-height:1.65;margin:0;color:#294435}
.ai24-note{padding:12px 14px;background:#fff8e8;border:1px solid #efd89e;border-radius:12px;font-size:11px;line-height:1.6;color:#6e561d}.ai24-source{font-size:10px;color:var(--muted);line-height:1.6}.ai24-action-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.ai24-primary{background:#355f49!important;color:#fff!important;border-color:#355f49!important}.ai24-secondary{background:var(--panel)!important;color:var(--text)!important}
body.dark .ai24-split:hover,body.dark .ai24-split.active{background:#1f3027;border-color:#668773}.dark .ai24-policy-preview{background:#1d2b23;border-color:#668773}.dark .ai24-policy-preview pre{color:#d9eadf}.dark .ai24-note{background:#302b1d;border-color:#655a34;color:#e8d9a9}
@media(max-width:1180px){.ai24-split-grid,.ai24-routing{grid-template-columns:repeat(2,minmax(0,1fr))}.ai24-session-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.ai24-ssot-flow{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:900px){.ai24-hero,.ai24-budget-grid{grid-template-columns:1fr}.ai24-ssot-flow{grid-template-columns:1fr 1fr}.ai24-architecture{grid-template-columns:1fr 1fr}}
@media(max-width:620px){.ai24-session-grid,.ai24-split-grid,.ai24-routing,.ai24-architecture,.ai24-ssot-flow,.ai24-ratio-editor,.ai24-form{grid-template-columns:1fr}.ai24-form .wide{grid-column:auto}.ai24-bands{grid-template-columns:1fr}.ai24-hero{padding:20px}.ai24-hero h2{font-size:28px}}


/* RECOVERY 29 — Leader Language + Customer Workflow Map */
.r29-hero{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(260px,.65fr);gap:14px;margin-bottom:16px}
.r29-hero-main,.r29-hero-side,.r29-card{border:1px solid var(--ui-line,#e7e8eb);border-radius:16px;background:var(--ui-surface,#fff);padding:18px;min-width:0}
.r29-hero-main h1{font-size:27px!important;margin:5px 0 8px!important;letter-spacing:-.04em}
.r29-hero-main p,.r29-card p,.r29-card li{color:var(--ui-muted,#6b7280);font-size:11px;line-height:1.65}
.r29-kicker{font-size:9px;font-weight:950;letter-spacing:.1em;color:var(--ui-muted,#6b7280)}
.r29-pills{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}.r29-pill{font-size:9px;font-weight:850;padding:5px 8px;border:1px solid var(--ui-line,#dfe2e6);border-radius:999px;background:var(--ui-surface-2,#f7f8fa)}
.r29-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin-bottom:16px}.r29-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}
.r29-language-card{border:1px solid var(--ui-line,#e7e8eb);border-radius:14px;background:var(--ui-surface,#fff);padding:14px;min-width:0;transition:background .16s,border-color .16s,transform .16s}
.r29-language-card:hover{background:var(--ui-soft,#f4f5f7);border-color:#98a2b3;transform:translateY(-1px)}
.r29-language-card h3{font-size:13px;margin:5px 0 8px}.r29-bad,.r29-good{padding:9px 10px;border-radius:10px;font-size:10px;line-height:1.55}.r29-bad{background:#fff5f5;border:1px solid #fecaca;color:#991b1b;margin-bottom:6px}.r29-good{background:#f0fdf4;border:1px solid #bbf7d0;color:#166534}
html[data-theme="dark"] .r29-bad{background:#2b1619;border-color:#613039;color:#fda4af}html[data-theme="dark"] .r29-good{background:#10261a;border-color:#245b36;color:#86efac}
.r29-practice{display:grid;grid-template-columns:1fr 1fr;gap:12px}.r29-practice textarea{min-height:112px}.r29-output{min-height:112px;border:1px dashed var(--ui-line,#dfe2e6);border-radius:12px;padding:12px;background:var(--ui-surface-2,#f8f9fa);font-size:11px;line-height:1.65;white-space:pre-wrap}
.r29-actions{display:flex;gap:7px;flex-wrap:wrap;align-items:center;margin-top:10px}.r29-log{display:grid;gap:7px;margin-top:10px}.r29-log-item{border:1px solid var(--ui-line,#e7e8eb);border-radius:10px;padding:10px;background:var(--ui-surface-2,#f8f9fa);font-size:10px;line-height:1.5}.r29-log-item b{display:block;margin-bottom:3px}
.r29-drill{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:7px}.r29-drill div{padding:10px;border:1px solid var(--ui-line,#e7e8eb);border-radius:11px;background:var(--ui-surface-2,#f8f9fa);font-size:10px;line-height:1.5}.r29-drill b{display:block;font-size:9px;color:var(--ui-muted,#6b7280);margin-bottom:4px}
.r29-sample-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px}.r29-sample{overflow:hidden;border:1px solid var(--ui-line,#e7e8eb);border-radius:16px;background:var(--ui-surface,#fff)}.r29-sample img{width:100%;height:180px;object-fit:cover;display:block;background:#111}.r29-sample-body{padding:14px}.r29-sample h3{font-size:15px;margin:3px 0 7px}.r29-source{font-size:8px;color:var(--ui-muted,#6b7280);margin-top:8px;line-height:1.4}
.r29-flow-strip{display:flex;gap:6px;overflow-x:auto;padding:3px 0 6px;scrollbar-width:thin}.r29-node{flex:0 0 132px;border:1px solid var(--ui-line,#dfe2e6);border-radius:10px;padding:8px;background:var(--ui-surface-2,#f8f9fa);font-size:9px;line-height:1.45}.r29-node b{display:block;font-size:10px;margin-bottom:3px}.r29-node em{font-style:normal;color:var(--ui-muted,#6b7280)}
.r29-workflow-builder{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:12px}.r29-flow-list{display:grid;gap:7px;max-height:540px;overflow:auto;padding-right:3px}.r29-flow-row{border:1px solid var(--ui-line,#e7e8eb);border-radius:12px;padding:10px;background:var(--ui-surface,#fff);display:grid;grid-template-columns:38px minmax(0,1fr) auto;gap:8px;align-items:start}.r29-flow-no{width:30px;height:30px;border-radius:8px;background:var(--ui-soft,#eef1f4);display:grid;place-items:center;font-size:9px;font-weight:900}.r29-flow-copy strong{font-size:11px}.r29-flow-copy small{display:block;color:var(--ui-muted,#6b7280);font-size:9px;line-height:1.5;margin-top:3px}.r29-flow-row button{min-height:28px!important;padding:4px 6px!important;font-size:9px!important}
.r29-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.r29-form-grid .field{margin-top:0}.r29-form-grid .wide{grid-column:1/-1}
.r29-cadence{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.r29-cadence article{border:1px solid var(--ui-line,#e7e8eb);border-radius:12px;padding:12px;background:var(--ui-surface,#fff)}.r29-cadence b{display:block;font-size:10px;margin-bottom:5px}.r29-cadence span{font-size:9px;line-height:1.5;color:var(--ui-muted,#6b7280)}
.r29-customer-lens{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.r29-customer-lens div{border-left:3px solid #667085;background:var(--ui-surface-2,#f8f9fa);padding:10px;border-radius:0 10px 10px 0}.r29-customer-lens b{display:block;font-size:9px;margin-bottom:4px}.r29-customer-lens span{font-size:9px;line-height:1.45;color:var(--ui-muted,#6b7280)}
@media(max-width:980px){.r29-hero,.r29-workflow-builder{grid-template-columns:1fr}.r29-grid.three{grid-template-columns:1fr 1fr}.r29-drill,.r29-cadence,.r29-customer-lens{grid-template-columns:1fr 1fr}}
@media(max-width:680px){.r29-grid,.r29-grid.three,.r29-practice,.r29-sample-grid,.r29-drill,.r29-cadence,.r29-customer-lens,.r29-form-grid{grid-template-columns:1fr}.r29-form-grid .wide{grid-column:auto}.r29-sample img{height:150px}}



/* RECOVERY 43 — Leader Language Emotional-to-Operational Cases */
.r43-language-cases{margin-bottom:16px}
.r43-language-cases .r43-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:14px}
.r43-language-cases .r43-head h2{font-size:16px;margin:4px 0 7px}
.r43-language-cases .r43-head p{margin:0;max-width:780px}
.r43-language-table{display:grid;gap:8px}
.r43-language-row{display:grid;grid-template-columns:minmax(180px,.85fr) minmax(180px,.8fr) minmax(0,1.8fr) auto;gap:10px;align-items:stretch;border:1px solid var(--ui-line,#e7e8eb);border-radius:14px;padding:12px;background:var(--ui-surface,#fff)}
.r43-language-row:hover{background:var(--ui-soft,#f7f8fa);border-color:#b6bec9}
.r43-language-cell{min-width:0}
.r43-language-cell .r43-label{display:block;font-size:8px;font-weight:950;letter-spacing:.08em;color:var(--ui-muted,#667085);margin-bottom:5px}
.r43-emotional{font-size:12px;font-weight:850;line-height:1.55;color:#991b1b}
.r43-situation{font-size:10px;line-height:1.55;color:var(--ui-muted,#667085)}
.r43-adult{font-size:11px;line-height:1.65;color:var(--ui-text,#16181d);font-weight:650}
.r43-practice-btn{align-self:center;white-space:nowrap}
.r43-principle{margin-top:10px;padding:11px 12px;border:1px solid #d9e2ee;border-radius:12px;background:#f6f9fc;font-size:10px;line-height:1.6;color:#475467}
html[data-theme="dark"] .r43-principle{background:#17202b;border-color:#344054;color:#cbd5e1}
html[data-theme="dark"] .r43-emotional{color:#fda4af}
@media(max-width:980px){.r43-language-row{grid-template-columns:1fr 1fr}.r43-practice-btn{justify-self:start}}
@media(max-width:620px){.r43-language-row{grid-template-columns:1fr}.r43-language-cases .r43-head{display:block}}


/* RECOVERY 31 — Team Directory + Versioned DRI + Flow Time/SLA */
.r31-card{background:var(--ui-surface,#fff);border:1px solid var(--ui-line,#e7e8eb);border-radius:16px;padding:18px;min-width:0}.r31-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:12px}.r31-head h2{font-size:15px;margin:4px 0 7px}.r31-head p,.r31-card p{font-size:10px;line-height:1.6;color:var(--ui-muted,#667085);margin:0}.r31-kicker{font-size:8px;font-weight:950;letter-spacing:.1em;color:var(--ui-muted,#667085)}.r31-badge{display:inline-flex;align-items:center;border:1px solid var(--ui-line,#e7e8eb);border-radius:999px;padding:4px 7px;font-size:8px;font-weight:900;white-space:nowrap}.r31-badge.good{background:#ecfdf3;border-color:#abefc6;color:#067647}.r31-badge.warn{background:#fffaeb;border-color:#fedf89;color:#b54708}.r31-badge.bad{background:#fff1f3;border-color:#fda29b;color:#b42318}.r31-badge.info{background:#eff8ff;border-color:#b2ddff;color:#175cd3}.r31-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:10px 0}.r31-stat{border:1px solid var(--ui-line,#e7e8eb);border-radius:12px;background:var(--ui-surface-2,#fafbfc);padding:10px;min-width:0}.r31-stat span{display:block;font-size:7px;font-weight:900;letter-spacing:.06em;color:var(--ui-muted,#667085)}.r31-stat strong{display:block;margin-top:4px;font-size:17px;overflow-wrap:anywhere}.r31-owner-list,.r31-flow-list,.r31-signal-list,.r31-checklist,.r31-candidates{display:grid;gap:7px}.r31-owner-row{display:grid;grid-template-columns:minmax(160px,1fr) minmax(145px,.9fr) minmax(145px,.9fr) minmax(150px,1fr) auto auto;gap:7px;align-items:center;border:1px solid var(--ui-line,#e7e8eb);border-radius:12px;padding:9px;background:var(--ui-surface,#fff);min-width:0}.r31-owner-copy{min-width:0}.r31-owner-copy b{display:block;font-size:10px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.r31-owner-copy small{display:block;font-size:8px;color:var(--ui-muted,#667085);margin-top:2px;overflow-wrap:anywhere}.r31-owner-row select,.r31-owner-row input,.r31-flow-form input,.r31-flow-form select,.r31-flow-form textarea{width:100%;min-width:0;border:1px solid var(--ui-line,#dfe2e6);border-radius:9px;padding:7px 8px;background:var(--ui-surface-2,#fff);color:var(--ui-ink,#16181d);font:inherit;font-size:9px}.r31-owner-row button{min-height:29px!important;padding:5px 7px!important;font-size:8px!important}.r31-dir-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.r31-member{border:1px solid var(--ui-line,#e7e8eb);border-radius:12px;padding:10px;background:var(--ui-surface-2,#fafbfc);min-width:0}.r31-member b{font-size:10px}.r31-member small{display:block;font-size:8px;color:var(--ui-muted,#667085);margin-top:3px;overflow-wrap:anywhere}.r31-flow-shell{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(280px,.9fr);gap:12px}.r31-flow-row{display:grid;grid-template-columns:32px minmax(0,1fr) auto;gap:8px;align-items:start;border:1px solid var(--ui-line,#e7e8eb);border-radius:12px;padding:9px;background:var(--ui-surface,#fff)}.r31-flow-row.selected{border-color:#98a2b3;box-shadow:0 0 0 1px #98a2b3 inset}.r31-flow-no{width:27px;height:27px;display:grid;place-items:center;border-radius:8px;background:var(--ui-soft,#eef1f4);font-size:8px;font-weight:950}.r31-flow-copy b{font-size:10px}.r31-flow-copy small{display:block;margin-top:2px;font-size:8px;line-height:1.45;color:var(--ui-muted,#667085)}.r31-mini-bars{display:flex;gap:4px;flex-wrap:wrap;margin-top:5px}.r31-mini{border:1px solid var(--ui-line,#e7e8eb);border-radius:999px;padding:3px 5px;font-size:7px;font-weight:850}.r31-flow-form{border:1px solid var(--ui-line,#e7e8eb);border-radius:12px;padding:11px;background:var(--ui-surface-2,#fafbfc)}.r31-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.r31-form-grid label{display:grid;gap:4px;font-size:8px;font-weight:850;color:var(--ui-muted,#667085)}.r31-form-grid .wide{grid-column:1/-1}.r31-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.r31-actions button{min-height:30px!important;padding:5px 8px!important;font-size:8px!important}.r31-signal{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:8px;align-items:center;border:1px solid var(--ui-line,#e7e8eb);border-radius:11px;padding:9px}.r31-signal b{font-size:9px}.r31-signal span{display:block;font-size:8px;line-height:1.45;color:var(--ui-muted,#667085)}.r31-check{display:grid;grid-template-columns:auto minmax(0,1fr);gap:8px;align-items:start;border:1px solid var(--ui-line,#e7e8eb);border-radius:10px;padding:9px;background:var(--ui-surface,#fff)}.r31-check input{margin-top:2px}.r31-check b{display:block;font-size:9px}.r31-check span{display:block;font-size:8px;color:var(--ui-muted,#667085);line-height:1.45;margin-top:2px}.r31-runtime{margin:12px 0;border-left:3px solid #2e90fa;background:#f5fbff;border:1px solid #b2ddff;border-left-width:3px;border-radius:12px;padding:12px}.r31-runtime h2{font-size:12px;margin:3px 0 6px}.r31-runtime p{font-size:9px;line-height:1.5;color:#475467;margin:0}.r31-candidate{border:1px solid var(--ui-line,#e7e8eb);border-radius:11px;padding:10px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px}.r31-candidate b{font-size:9px}.r31-candidate span{display:block;font-size:8px;color:var(--ui-muted,#667085);line-height:1.45;margin-top:2px}.r31-note{font-size:8px;line-height:1.5;color:var(--ui-muted,#667085);padding:8px 9px;background:var(--ui-surface-2,#fafbfc);border-radius:9px;margin-top:8px}.r31-card button{font-size:9px}.r31-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.r31-hidden-r30-owner{display:none!important}
