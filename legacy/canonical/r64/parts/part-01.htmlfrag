/* RECOVERY 40 — Leadership Practicum Universal Search */
.lo-search-trigger{display:inline-flex;align-items:center;gap:7px;min-width:145px;justify-content:space-between;background:#fff!important;border:1px solid #dfe2e6!important;color:#344054!important}
.lo-search-trigger .lo-search-left{display:flex;align-items:center;gap:6px}.lo-search-kbd{font-size:9px;font-weight:800;color:#667085;background:#f2f4f7;border:1px solid #e4e7ec;border-radius:5px;padding:2px 5px}
.lo-search-overlay{position:fixed;inset:0;z-index:9999;background:rgba(15,23,42,.42);backdrop-filter:blur(5px);display:none;align-items:flex-start;justify-content:center;padding:9vh 18px 24px}
.lo-search-overlay.open{display:flex}.lo-search-dialog{width:min(820px,100%);max-height:78vh;background:var(--ui-surface,#fff);color:var(--ui-ink,#16181d);border:1px solid var(--ui-line,#e4e7ec);border-radius:20px;box-shadow:0 28px 80px rgba(15,23,42,.24);overflow:hidden;display:grid;grid-template-rows:auto auto minmax(0,1fr) auto}
.lo-search-head{padding:14px 16px;border-bottom:1px solid var(--ui-line,#e4e7ec);display:grid;grid-template-columns:28px minmax(0,1fr) auto;gap:9px;align-items:center}.lo-search-icon{font-size:18px;color:#667085}.lo-search-input{border:0!important;outline:0!important;box-shadow:none!important;background:transparent!important;color:var(--ui-ink,#16181d)!important;font:inherit!important;font-size:16px!important;min-height:42px!important;padding:0!important}.lo-search-close{border:0!important;background:transparent!important;color:var(--ui-muted,#667085)!important;font-size:11px!important;padding:6px!important;min-height:auto!important}
.lo-search-filters{display:flex;gap:6px;padding:10px 16px;border-bottom:1px solid var(--ui-line,#e4e7ec);overflow:auto}.lo-search-filter{min-height:30px!important;padding:5px 9px!important;font-size:10px!important;border-radius:999px!important}.lo-search-filter.active{background:#16181d!important;color:#fff!important;border-color:#16181d!important}
.lo-search-results{overflow:auto;padding:8px;display:grid;gap:3px;min-height:220px}.lo-search-result{width:100%;display:grid!important;grid-template-columns:78px minmax(0,1fr) auto;gap:10px!important;align-items:center!important;text-align:left!important;padding:10px 11px!important;border:1px solid transparent!important;background:transparent!important;color:var(--ui-ink,#16181d)!important;border-radius:12px!important;min-height:58px!important}.lo-search-result:hover,.lo-search-result.selected{background:var(--ui-surface-2,#f7f8fa)!important;border-color:var(--ui-line,#e4e7ec)!important}.lo-search-type{font-size:9px;font-weight:950;letter-spacing:.08em;color:#475467}.lo-search-type.quest{color:#0f766e}.lo-search-type.artifact{color:#7c3aed}.lo-search-type.result{color:#b54708}.lo-search-type.addon{color:#2563eb}.lo-search-copy{min-width:0}.lo-search-copy strong{display:block;font-size:12px;line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.lo-search-copy small{display:block;font-size:10px;color:var(--ui-muted,#667085);line-height:1.4;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.lo-search-route{font-size:9px;color:var(--ui-muted,#667085);white-space:nowrap}.lo-search-empty{padding:34px 22px;text-align:center;color:var(--ui-muted,#667085);font-size:12px;line-height:1.6}.lo-search-foot{padding:10px 16px;border-top:1px solid var(--ui-line,#e4e7ec);display:flex;justify-content:space-between;gap:12px;align-items:center;font-size:9px;color:var(--ui-muted,#667085);background:var(--ui-surface-2,#fafbfc)}.lo-search-foot span{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.lo-search-foot kbd{border:1px solid var(--ui-line,#e4e7ec);border-radius:5px;padding:2px 5px;background:var(--ui-surface,#fff);font:inherit;color:inherit}
.lo-search-privacy{margin:12px 0 0;padding:10px 12px;border:1px solid #d0d5dd;border-radius:10px;background:#f8fafc;font-size:10px;color:#667085;line-height:1.55}
html[data-theme="dark"] .lo-search-trigger{background:#181d23!important;color:#f2f4f7!important;border-color:#34404c!important}html[data-theme="dark"] .lo-search-kbd{background:#252c34;color:#d0d5dd;border-color:#475467}html[data-theme="dark"] .lo-search-filter.active{background:#f2f4f7!important;color:#11151a!important;border-color:#f2f4f7!important}html[data-theme="dark"] .lo-search-privacy{background:#171c22;border-color:#34404c;color:#98a2b3}
@media(max-width:680px){.lo-search-overlay{padding:4vh 8px 10px}.lo-search-dialog{max-height:90vh;border-radius:15px}.lo-search-result{grid-template-columns:64px minmax(0,1fr)}.lo-search-route{display:none}.lo-search-trigger{min-width:auto}.lo-search-trigger .lo-search-kbd{display:none}}

</style>
<style id="recovery-19-styles">
  .r19-policy-card{border:1px solid #dbe3dd;background:#fbfdfb;border-radius:16px;padding:16px 18px;margin:0 0 16px;box-shadow:0 1px 0 rgba(25,45,32,.02)}
  .r19-policy-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;margin-bottom:12px}
  .r19-policy-head h2{font-size:16px;margin:3px 0 4px;color:#1d2621}.r19-policy-head p{margin:0;color:#69736d;font-size:11px;line-height:1.55}
  .r19-kicker{font-size:10px;font-weight:850;letter-spacing:.08em;color:#4d6b59;text-transform:uppercase}
  .r19-live-badge{display:inline-flex;align-items:center;gap:5px;white-space:nowrap;border:1px solid #b9d5c3;background:#edf8f1;color:#23613c;border-radius:999px;padding:5px 8px;font-size:10px;font-weight:800}
  .r19-empty{border:1px dashed #ccd5cf;border-radius:12px;padding:13px;background:#f8faf8;color:#66716b;font-size:11px;line-height:1.55}
  .r19-rule-strip{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0 2px}.r19-rule-chip{display:inline-flex;align-items:center;gap:5px;border:1px solid #dde4df;background:#fff;border-radius:999px;padding:5px 8px;font-size:10px;color:#455048}.r19-rule-chip b{color:#245f3b}
  .r19-prompt-list{display:grid;gap:8px}.r19-prompt{display:grid;grid-template-columns:22px 1fr auto;gap:9px;align-items:start;border:1px solid #e1e6e2;background:#fff;border-radius:12px;padding:11px 12px}.r19-prompt input{margin-top:2px;accent-color:#2f7650}.r19-prompt strong{display:block;font-size:11px;color:#263029;margin-bottom:3px}.r19-prompt span{display:block;font-size:10px;color:#727c76;line-height:1.45}.r19-prompt .r19-rule-code{font-size:9px;color:#557563;background:#edf5ef;border-radius:999px;padding:4px 6px;font-weight:800}
  .r19-prompt.done{background:#f1f8f3;border-color:#b8d4c2}.r19-prompt.done strong{text-decoration:line-through;text-decoration-thickness:1px;text-decoration-color:#8baa96;color:#5f6a63}
  .r19-policy-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:11px}.r19-policy-actions button{font-size:10px;padding:7px 9px}
  .r19-decision-grid{display:grid;gap:7px}.r19-decision-row{display:grid;grid-template-columns:minmax(150px,1.4fr) .75fr .75fr auto;gap:8px;align-items:center;border:1px solid #e2e6e3;background:#fff;border-radius:11px;padding:10px 11px;font-size:10px}.r19-decision-row b{font-size:11px}.r19-state-ok{color:#23613c;font-weight:800}.r19-state-check{color:#a05e19;font-weight:800}.r19-state-risk{color:#a43838;font-weight:800}
  .r19-runtime-board{border:1px solid #d8e1db;background:#f7fbf8;border-radius:14px;padding:15px;margin-top:12px}.r19-runtime-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-top:10px}.r19-runtime-surface{border:1px solid #e0e5e1;background:#fff;border-radius:11px;padding:10px}.r19-runtime-surface b{display:block;font-size:10px;color:#26302a}.r19-runtime-surface span{display:block;font-size:9px;color:#7a837e;line-height:1.4;margin-top:4px}
  .r19-learning-box{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.r19-learning-item{border-left:3px solid #6b9479;background:#f7faf8;border-radius:0 10px 10px 0;padding:10px 12px}.r19-learning-item b{font-size:11px;display:block}.r19-learning-item span{font-size:10px;color:#6d7771;line-height:1.45;display:block;margin-top:4px}
  body.dark .r19-policy-card{background:#171b18;border-color:#323b35}.dark .r19-policy-head h2{color:#f0f4f1}.dark .r19-policy-head p{color:#a5afa8}.dark .r19-live-badge{background:#183022;border-color:#355643;color:#b8e0c4}.dark .r19-rule-chip,.dark .r19-prompt,.dark .r19-decision-row,.dark .r19-runtime-surface{background:#1c211e;border-color:#353d38;color:#e8eee9}.dark .r19-prompt strong,.dark .r19-decision-row b,.dark .r19-runtime-surface b{color:#e7eee9}.dark .r19-prompt span,.dark .r19-runtime-surface span{color:#a4aea7}.dark .r19-empty{background:#1a1f1c;border-color:#39423c;color:#a8b2ab}.dark .r19-runtime-board,.dark .r19-learning-item{background:#171d19;border-color:#354139}.dark .r19-learning-item b{color:#e8eee9}.dark .r19-learning-item span{color:#a4aea7}
  @media(max-width:900px){.r19-runtime-grid{grid-template-columns:1fr 1fr}.r19-decision-row{grid-template-columns:1fr 1fr}.r19-learning-box{grid-template-columns:1fr}}
</style>
<script id="leader-os-shared-storage-bridge">
(function(){
  if(window.__leaderOsStorage) return;
  try{const t='__leader_os_storage_test__';window.localStorage.setItem(t,'1');window.localStorage.removeItem(t);window.__leaderOsStorage=window.localStorage;}
  catch{const m=new Map();window.__leaderOsStorage={getItem:k=>m.has(String(k))?m.get(String(k)):null,setItem:(k,v)=>m.set(String(k),String(v)),removeItem:k=>m.delete(String(k)),clear:()=>m.clear()};}
})();
</script>
<style id="recovery-20-style">
  .r20-hero{display:grid;grid-template-columns:1.35fr .65fr;gap:16px;padding:24px;border-radius:18px;background:#172019;color:#f5f8f6;border:1px solid #2f3d33;margin-bottom:18px;overflow:hidden;position:relative}
  .r20-hero h2{font-size:25px;line-height:1.14;margin:4px 0 9px;color:#fff}.r20-hero p{font-size:12px;line-height:1.65;color:#cbd5ce;margin:0}.r20-kicker{font-size:9px;font-weight:900;letter-spacing:.11em;color:#91b89d}.r20-hero-side{border:1px solid #34463a;background:#1d2821;border-radius:14px;padding:14px;font-size:11px;line-height:1.55;color:#dce8df}.r20-hero-side b{color:#fff}
  .r20-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin-bottom:16px}.r20-stat{background:#fff;border:1px solid #e3e8e4;border-radius:13px;padding:12px}.r20-stat span{display:block;font-size:9px;color:#78837c;font-weight:800;letter-spacing:.06em}.r20-stat strong{display:block;font-size:22px;margin-top:3px;color:#202923}.r20-layout{display:grid;grid-template-columns:.9fr 1.1fr;gap:16px}.r20-form{display:grid;gap:10px}.r20-form label{display:grid;gap:5px;font-size:10px;font-weight:800;color:#49534d}.r20-row{display:grid;grid-template-columns:1fr 1fr;gap:9px}.r20-form input,.r20-form select,.r20-form textarea{width:100%}.r20-rule-picker{display:grid;grid-template-columns:1fr 1fr;gap:7px}.r20-rule-option{display:flex!important;grid-template-columns:none!important;align-items:flex-start;gap:7px!important;border:1px solid #e4e8e5;border-radius:10px;padding:9px;background:#fafcfb;color:#27312a!important;font-size:10px!important}.r20-rule-option input{width:auto;margin-top:1px}.r20-rule-option b{display:block;font-size:10px}.r20-rule-option span{display:block;font-weight:500;color:#778079;margin-top:2px;line-height:1.35}.r20-actions{display:flex;gap:7px;flex-wrap:wrap}.r20-list{display:grid;gap:9px}.r20-agreement{border:1px solid #e2e7e3;border-radius:13px;padding:13px;background:#fff}.r20-agreement-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.r20-agreement h3{font-size:13px;margin:0 0 4px}.r20-meta{font-size:9px;color:#7a847d;line-height:1.5}.r20-state{display:inline-flex;padding:4px 7px;border-radius:999px;font-size:8px;font-weight:900;letter-spacing:.05em;background:#eff3f0;color:#465148;border:1px solid #dce4de}.r20-state.confirmed{background:#eaf6ee;color:#2f6840;border-color:#c6e3cf}.r20-state.expired{background:#fff4e8;color:#895d20;border-color:#f1d9b7}.r20-state.archived{background:#f2f3f4;color:#747b80}.r20-state.draft{background:#f1f3f7;color:#525c68}.r20-chiprow{display:flex;gap:5px;flex-wrap:wrap;margin:9px 0}.r20-chip{display:inline-flex;padding:4px 6px;border-radius:7px;background:#f3f6f4;border:1px solid #e0e7e2;font-size:8px;font-weight:800;color:#3b463e}.r20-exception{font-size:10px;color:#68726b;background:#f7f9f8;border-left:3px solid #9bb3a2;padding:8px 9px;border-radius:0 8px 8px 0;line-height:1.45}.r20-card-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.r20-history{margin-top:8px}.r20-history summary{font-size:9px;font-weight:800;color:#606b63}.r20-history-row{font-size:9px;color:#707a73;padding:5px 0;border-bottom:1px solid #eef1ef}.r20-context{margin-top:18px}.r20-context-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:9px}.r20-context-card{border:1px solid #e3e8e4;border-radius:12px;padding:12px;background:#fff}.r20-context-card b{display:block;font-size:10px}.r20-context-card span{display:block;font-size:9px;color:#758078;line-height:1.45;margin-top:4px}.r20-review{margin-top:18px}.r20-review-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:14px}.r20-review-list{display:grid;gap:7px}.r20-review-item{border:1px solid #e4e8e5;border-radius:10px;padding:10px;background:#fafcfb}.r20-review-item b{font-size:10px;display:block}.r20-review-item span{font-size:9px;color:#747e77;display:block;line-height:1.4;margin-top:3px}.r20-runtime-card{border:1px solid #dce5df;background:#fbfdfc;border-radius:14px;padding:13px;margin-bottom:12px}.r20-runtime-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.r20-runtime-head h2{font-size:13px;margin:2px 0 3px;color:#222c25}.r20-runtime-head p{font-size:9px;color:#768078;margin:0;line-height:1.45}.r20-runtime-list{display:grid;gap:6px;margin-top:9px}.r20-runtime-rule{display:grid;grid-template-columns:88px 1fr;gap:7px;border:1px solid #e5eae7;border-radius:9px;padding:8px;background:#fff}.r20-runtime-rule b{font-size:9px;color:#314038}.r20-runtime-rule span{font-size:9px;color:#65716a;line-height:1.45}.r20-runtime-empty{font-size:9px;color:#7d8781;border:1px dashed #dbe3dd;background:#fff;border-radius:9px;padding:9px}.r20-meeting-template{margin-top:9px;padding:10px;border-radius:10px;background:#f5f8f6;border:1px solid #e0e7e2;font-size:9px;line-height:1.55;color:#4f5c54;white-space:pre-line}.r20-runtime-tools{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-top:9px}.r20-runtime-tools select{max-width:220px}.r20-link-btn{font-size:9px!important;min-height:30px!important;padding:5px 8px!important}.r20-warn{border-left:3px solid #c39355;background:#fff9f0;padding:8px 9px;border-radius:0 8px 8px 0;font-size:9px;color:#765b37;line-height:1.45}.r20-source-disabled{opacity:.72}.r20-agreement[data-expired="1"]{background:#fffdf9}
  html[data-theme="dark"] .r20-stat,html[data-theme="dark"] .r20-agreement,html[data-theme="dark"] .r20-context-card,html[data-theme="dark"] .r20-runtime-card,html[data-theme="dark"] .r20-runtime-rule,html[data-theme="dark"] .r20-review-item{background:#171c18;border-color:#343d36;color:#e9efeb}html[data-theme="dark"] .r20-stat strong,html[data-theme="dark"] .r20-agreement h3,html[data-theme="dark"] .r20-context-card b,html[data-theme="dark"] .r20-runtime-head h2,html[data-theme="dark"] .r20-runtime-rule b,html[data-theme="dark"] .r20-review-item b{color:#edf3ef}html[data-theme="dark"] .r20-stat span,html[data-theme="dark"] .r20-meta,html[data-theme="dark"] .r20-context-card span,html[data-theme="dark"] .r20-runtime-head p,html[data-theme="dark"] .r20-runtime-rule span,html[data-theme="dark"] .r20-review-item span{color:#a7b1aa}html[data-theme="dark"] .r20-rule-option,html[data-theme="dark"] .r20-exception,html[data-theme="dark"] .r20-meeting-template{background:#1c221e;border-color:#374039;color:#dce5df}html[data-theme="dark"] .r20-rule-option{color:#e9efeb!important}html[data-theme="dark"] .r20-rule-option span{color:#a7b1aa}html[data-theme="dark"] .r20-chip{background:#202722;border-color:#39433c;color:#dfe8e2}html[data-theme="dark"] .r20-warn{background:#292116;color:#dec39d}html[data-theme="dark"] .r20-runtime-empty{background:#171c18;border-color:#38413b;color:#a7b1aa}
  @media(max-width:900px){.r20-hero,.r20-layout,.r20-review-grid{grid-template-columns:1fr}.r20-stats{grid-template-columns:1fr 1fr}.r20-context-grid{grid-template-columns:1fr}.r20-rule-picker{grid-template-columns:1fr}.r20-row{grid-template-columns:1fr}}
</style>
<style id="recovery-21-styles">
  .r21-hero{display:grid;grid-template-columns:1.5fr .8fr;gap:18px;padding:26px;border-radius:18px;background:linear-gradient(135deg,#18251f,#2f5142);color:#fff;margin-bottom:18px;overflow:hidden;position:relative}.r21-hero:after{content:"";position:absolute;right:-55px;top:-75px;width:220px;height:220px;border-radius:50%;border:40px solid rgba(255,255,255,.05)}.r21-hero h2{font-size:26px;line-height:1.16;margin:5px 0 10px}.r21-hero p{margin:0;color:#dce9e2;line-height:1.65;font-size:13px}.r21-kicker{font-size:9px;font-weight:900;letter-spacing:.13em;color:#a9cabb}.r21-hero-side{align-self:stretch;border:1px solid rgba(255,255,255,.12);border-radius:14px;padding:16px;background:rgba(255,255,255,.06);font-size:12px;line-height:1.6;position:relative;z-index:1}.r21-progressbar{height:8px;border-radius:99px;background:rgba(255,255,255,.15);overflow:hidden;margin:12px 0 7px}.r21-progressbar span{display:block;height:100%;background:#d8f3e5;border-radius:inherit}.r21-layout{display:grid;grid-template-columns:1.1fr .9fr;gap:16px;margin-top:16px}.r21-setup-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.r21-step{border:1px solid #e3e7e5;background:#fff;border-radius:14px;padding:14px;display:grid;gap:7px;min-height:150px}.r21-step.done{background:#f3f8f5;border-color:#c9ddd1}.r21-step.current{border-color:#779d89;box-shadow:0 0 0 2px rgba(74,116,94,.08)}.r21-step-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.r21-step-no{font-size:10px;font-weight:900;color:#6b7f74;letter-spacing:.08em}.r21-step h3{font-size:14px;margin:0}.r21-step p{font-size:11px;line-height:1.55;color:#68736d;margin:0}.r21-state{display:inline-flex;border-radius:999px;padding:4px 7px;background:#eef1ef;color:#55625b;font-size:9px;font-weight:900}.r21-step.done .r21-state{background:#dcebe2;color:#315743}.r21-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:auto}.r21-actions button{min-height:32px;padding:6px 8px}.r21-form{display:grid;gap:11px}.r21-form label{display:grid;gap:5px;font-size:10px;font-weight:800;color:#59645e}.r21-form input,.r21-form select,.r21-form textarea{width:100%;border:1px solid #dfe4e1;border-radius:10px;background:#fff;color:#16181d;padding:9px 10px;font-size:12px}.r21-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.r21-resume{border:1px solid #dfe4e1;border-radius:14px;padding:15px;background:#f8faf9;display:grid;gap:8px;margin-top:12px}.r21-resume strong{font-size:14px}.r21-resume span{font-size:11px;color:#66716b;line-height:1.55}.r21-fastpaths{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:12px}.r21-fastpath{border:1px solid #e5e8e6;border-radius:12px;padding:10px;background:#fff;text-align:left}.r21-fastpath b{display:block;font-size:11px}.r21-fastpath span{display:block;font-size:9px;color:#7b847f;margin-top:4px;line-height:1.4}.r21-agreement-list{display:grid;gap:8px}.r21-agreement-card{border:1px solid #e1e5e3;border-radius:13px;padding:12px;background:#fff}.r21-agreement-card h4{margin:0 0 5px;font-size:12px}.r21-agreement-card p{margin:0;font-size:10px;color:#6c7771;line-height:1.5}.r21-rulechips{display:flex;gap:5px;flex-wrap:wrap;margin-top:7px}.r21-rulechip{display:inline-flex;padding:4px 6px;border-radius:999px;background:#f0f3f1;color:#45534b;font-size:9px;font-weight:800}.r21-onboard-summary{border-left:3px solid #5f8f75;padding:11px 12px;background:#f5f9f7;border-radius:0 10px 10px 0;font-size:11px;line-height:1.65;color:#4d5c54}.r21-divider{height:1px;background:#ebeeec;margin:16px 0}.r21-proposal-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}.r21-proposal-list{display:grid;gap:9px}.r21-proposal{border:1px solid #e2e6e3;border-radius:13px;padding:13px;background:#fff}.r21-proposal-head{display:flex;justify-content:space-between;gap:10px}.r21-proposal h3{font-size:12px;margin:0}.r21-proposal p{font-size:10px;line-height:1.55;color:#69756e}.r21-proposal-status{font-size:9px;font-weight:900;padding:4px 7px;border-radius:999px;background:#eef1ef;color:#536159;height:max-content}.r21-proposal-status.reviewed{background:#edf4f0;color:#38614c}.r21-proposal-status.applied{background:#dcebe2;color:#315743}.r21-rule-picker{display:grid;grid-template-columns:1fr 1fr;gap:7px}.r21-rule-option{display:flex!important;grid-template-columns:none!important;align-items:flex-start;gap:8px;border:1px solid #e4e7e5;border-radius:10px;padding:8px;background:#fafbfa;font-size:10px!important}.r21-rule-option input{width:auto}.r21-inspector{display:grid;gap:8px}.r21-evidence{border:1px solid #e5e8e6;border-radius:11px;padding:10px;background:#fafbfa;font-size:10px;line-height:1.55}.r21-new-member{display:grid;grid-template-columns:.9fr 1.1fr;gap:16px}.r21-checklist{display:grid;gap:7px}.r21-check{display:flex;gap:8px;align-items:flex-start;border:1px solid #e6e9e7;border-radius:10px;padding:9px;background:#fff;font-size:10px;line-height:1.5}.r21-check input{margin-top:2px}.r21-banner{margin:0 0 16px;border:1px solid #cfdcd4;background:#f5f9f7;border-radius:14px;padding:13px 15px;display:flex;align-items:center;justify-content:space-between;gap:12px}.r21-banner strong{font-size:12px}.r21-banner span{font-size:10px;color:#69756f}.r21-banner-copy{display:grid;gap:3px}.r21-inline-btn{white-space:nowrap}.r21-empty{font-size:11px;color:#7a847f;padding:12px;border:1px dashed #dfe4e1;border-radius:10px;text-align:center;background:#fafbfa}.r21-ack-note{font-size:10px;color:#69756e}.r21-review-notice{border-radius:10px;padding:9px 10px;background:#fff8e9;border:1px solid #f2dfb4;color:#76591e;font-size:10px;line-height:1.5}html[data-theme="dark"] .r21-step,html[data-theme="dark"] .r21-fastpath,html[data-theme="dark"] .r21-agreement-card,html[data-theme="dark"] .r21-proposal,html[data-theme="dark"] .r21-check{background:#171a18;border-color:#343a36;color:#f2f5f3}html[data-theme="dark"] .r21-step p,html[data-theme="dark"] .r21-fastpath span,html[data-theme="dark"] .r21-agreement-card p,html[data-theme="dark"] .r21-proposal p,html[data-theme="dark"] .r21-banner span,html[data-theme="dark"] .r21-ack-note{color:#adb7b1}html[data-theme="dark"] .r21-form input,html[data-theme="dark"] .r21-form select,html[data-theme="dark"] .r21-form textarea{background:#151816;color:#f4f6f5;border-color:#3a403c}html[data-theme="dark"] .r21-resume,html[data-theme="dark"] .r21-onboard-summary,html[data-theme="dark"] .r21-evidence,html[data-theme="dark"] .r21-rule-option,html[data-theme="dark"] .r21-empty{background:#1c211e;border-color:#353b37;color:#dfe6e2}html[data-theme="dark"] .r21-banner{background:#18231e;border-color:#34493e}html[data-theme="dark"] .r21-state,html[data-theme="dark"] .r21-rulechip{background:#29302c;color:#d8e1dc}@media(max-width:900px){.r21-hero,.r21-layout,.r21-proposal-grid,.r21-new-member{grid-template-columns:1fr}.r21-setup-grid{grid-template-columns:1fr}.r21-fastpaths{grid-template-columns:1fr 1fr}.r21-rule-picker{grid-template-columns:1fr}}@media(max-width:560px){.r21-fastpaths,.r21-row{grid-template-columns:1fr}.r21-banner{align-items:flex-start;flex-direction:column}}
</style>
<style id="recovery-22-styles">
/* RECOVERY 22 — Personalized onboarding + interaction polish */
:root{--r22-hover:#f2f7f4;--r22-hover-strong:#e8f1ec;--r22-hover-border:#9cb7a8;--r22-focus:#416c56;--r22-selected:#e4efe8;--r22-ink:#16181d;--r22-muted:#65716a;--r22-surface:#fff;--r22-soft:#f8faf9}
html[data-theme="dark"]{--r22-hover:#202722;--r22-hover-strong:#26322b;--r22-hover-border:#668773;--r22-focus:#9cc4ac;--r22-selected:#243128;--r22-ink:#f3f6f4;--r22-muted:#aeb8b2;--r22-surface:#171a18;--r22-soft:#1c211e}
button:not(:disabled),[data-primary-nav] a,.r21-step,.r21-fastpath,.r21-agreement-card,.r21-proposal,.r21-check,.quest-item,.quest-card,.working-agreement-card,.r20-agreement-card,.r19-policy-card,.r18-principle-card,.r22-interactive{transition:background-color .16s ease,border-color .16s ease,color .16s ease,box-shadow .16s ease,transform .16s ease}
button:not(:disabled):hover,[data-primary-nav] a:hover{background:var(--r22-hover-strong)!important;border-color:var(--r22-hover-border)!important;color:var(--r22-ink)!important}
.r21-step:hover,.r21-fastpath:hover,.r21-agreement-card:hover,.r21-proposal:hover,.r21-check:hover,.quest-item:hover,.quest-card:hover,.working-agreement-card:hover,.r20-agreement-card:hover,.r19-policy-card:hover,.r18-principle-card:hover,.r22-interactive:hover{background:var(--r22-hover)!important;border-color:var(--r22-hover-border)!important;box-shadow:0 8px 24px rgba(28,52,39,.08);transform:translateY(-1px)}
button:focus-visible,[data-primary-nav] a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,[tabindex]:focus-visible{outline:3px solid color-mix(in srgb,var(--r22-focus) 32%,transparent);outline-offset:2px;border-color:var(--r22-focus)!important}
button[aria-pressed="true"],.r22-selected{background:var(--r22-selected)!important;border-color:var(--r22-focus)!important;color:var(--r22-ink)!important}
button:disabled{opacity:.48;cursor:not-allowed}
.r22-context-strip{display:flex;flex-wrap:wrap;gap:7px;margin:10px 0 0}.r22-context-pill{display:inline-flex;align-items:center;gap:6px;border:1px solid #dce5df;background:#f7faf8;color:#42564b;border-radius:999px;padding:5px 9px;font-size:10px;font-weight:800}.r22-context-pill strong{color:#244936}
.r22-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.r22-grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.r22-card{border:1px solid #e0e6e2;border-radius:14px;background:#fff;padding:15px;min-width:0}.r22-card h3{margin:0 0 6px;font-size:14px}.r22-card p{margin:0;color:#66716b;font-size:11px;line-height:1.6}.r22-list{display:grid;gap:8px;margin-top:10px}.r22-item{display:grid;grid-template-columns:26px 1fr;gap:9px;align-items:start;padding:9px;border:1px solid #e8ece9;border-radius:10px;background:#fbfcfb}.r22-item-no{width:24px;height:24px;border-radius:7px;display:grid;place-items:center;background:#e7f0ea;color:#365b46;font-size:9px;font-weight:900}.r22-item b{display:block;font-size:11px;margin-bottom:3px}.r22-item span{display:block;font-size:10px;color:#6e7a73;line-height:1.45}.r22-question{border-left:3px solid #6f9a80;background:#f6faf7;border-radius:0 10px 10px 0;padding:9px 11px;font-size:11px;line-height:1.55;color:#405047}.r22-warning{border-left-color:#c08a32;background:#fff9ef;color:#6d552c}.r22-prep-meta{display:flex;gap:7px;flex-wrap:wrap;margin:8px 0}.r22-tag{display:inline-flex;border-radius:999px;padding:4px 7px;background:#eef3f0;color:#516159;font-size:9px;font-weight:900}.r22-calendar-preview{display:grid;gap:7px;margin-top:10px}.r22-calendar-row{display:grid;grid-template-columns:92px 1fr auto;gap:9px;align-items:center;border:1px solid #e5e9e7;border-radius:10px;padding:9px;background:#fff;font-size:10px}.r22-calendar-row b{font-size:10px}.r22-calendar-type{border-radius:999px;padding:4px 7px;background:#eff4f1;color:#52645a;font-weight:900;font-size:9px}.r22-completion{border:1px solid #c8dbcf;background:linear-gradient(135deg,#f6faf7,#edf5f0);border-radius:16px;padding:16px;display:grid;grid-template-columns:1fr auto;gap:14px;align-items:center}.r22-completion h3{margin:0 0 5px;font-size:15px}.r22-completion p{margin:0;color:#5f6c65;font-size:11px;line-height:1.55}.r22-top3{display:grid;gap:7px;margin-top:10px}.r22-top3 div{padding:8px 10px;border-radius:9px;background:#fff;border:1px solid #dfe7e2;font-size:10px}.r22-reviewers{display:grid;gap:7px;margin-top:8px}.r22-comment{border:1px solid #e1e6e3;border-radius:10px;padding:9px;background:#fbfcfb;font-size:10px;line-height:1.5}.r22-comment-head{display:flex;justify-content:space-between;gap:8px;margin-bottom:4px}.r22-stance{font-size:9px;font-weight:900;border-radius:999px;padding:3px 6px;background:#eef2ef;color:#53645b}.r22-inline-form{display:grid;grid-template-columns:120px 130px 1fr auto;gap:7px;margin-top:9px;align-items:end}.r22-inline-form input,.r22-inline-form select{min-width:0}
html[data-theme="dark"] .r22-context-pill,html[data-theme="dark"] .r22-card,html[data-theme="dark"] .r22-item,html[data-theme="dark"] .r22-calendar-row,html[data-theme="dark"] .r22-top3 div,html[data-theme="dark"] .r22-comment{background:#171a18;border-color:#353c38;color:#edf3ef}html[data-theme="dark"] .r22-context-pill{background:#202720;color:#c8d5cd}html[data-theme="dark"] .r22-context-pill strong{color:#dcebe2}html[data-theme="dark"] .r22-card p,html[data-theme="dark"] .r22-item span,html[data-theme="dark"] .r22-completion p{color:#aeb8b2}html[data-theme="dark"] .r22-question{background:#1c2720;color:#d7e2dc}html[data-theme="dark"] .r22-warning{background:#2b261b;color:#e5d7b7}html[data-theme="dark"] .r22-completion{background:linear-gradient(135deg,#18231e,#202b24);border-color:#385044}html[data-theme="dark"] .r22-tag,html[data-theme="dark"] .r22-calendar-type,html[data-theme="dark"] .r22-stance{background:#29302c;color:#d8e1dc}
@media(max-width:1100px){.r22-grid{grid-template-columns:1fr 1fr}.r22-grid.two{grid-template-columns:1fr}.r22-inline-form{grid-template-columns:1fr 1fr}.r22-inline-form button{grid-column:1/-1}}
@media(max-width:700px){.r22-grid{grid-template-columns:1fr}.r22-completion{grid-template-columns:1fr}.r22-inline-form{grid-template-columns:1fr}.r22-calendar-row{grid-template-columns:1fr}.r22-calendar-row>*{min-width:0}}
@media(prefers-reduced-motion:reduce){button,[data-primary-nav] a,.r21-step,.r21-fastpath,.r21-agreement-card,.r21-proposal,.r21-check,.quest-item,.quest-card,.working-agreement-card,.r20-agreement-card,.r19-policy-card,.r18-principle-card,.r22-interactive{transition:none!important}.r21-step:hover,.r21-fastpath:hover,.r22-interactive:hover{transform:none!important}}
</style>
<style id="recovery-23-layout-reliability">
/* RECOVERY 23 — Layout Reliability Guardrails
   Goal: new content must shrink, wrap and scroll instead of breaking the shell. */
:root{
  --r23-layout-max:1240px;
  --r23-gutter:clamp(14px,2.35vw,32px);
  --r23-focus:#416c56;
  --r23-soft:#f2f7f4;
  --r23-border:#dfe6e1;
  --r23-ink:#1f2923;
  --r23-muted:#66736c;
}
html,body{max-width:100%;overflow-x:hidden}
.shell{grid-template-columns:minmax(220px,260px) minmax(0,1fr)!important;width:100%;max-width:100%;}
.shell>main,main{min-width:0!important;width:100%;max-width:100%;overflow-x:clip}
.sidebar{min-width:0;max-width:100%;}
.content{
  width:min(100%,var(--r23-layout-max))!important;
  max-width:var(--r23-layout-max)!important;
  min-width:0!important;
  padding-inline:var(--r23-gutter)!important;
  margin-inline:auto!important;
}
.content>*,.card,.review-card,.person-card,.agenda-item,section,article,details,
[class*="-card"],[class*="-panel"],[class*="-item"],[class*="-body"],[class*="-copy"]{min-width:0;max-width:100%}
.content :is(h1,h2,h3,h4,p,li,span,strong,b,a,button,label,summary,code,small){overflow-wrap:anywhere;word-break:normal}
.content :is(img,svg,video,canvas){max-width:100%;height:auto}
button,a,input,select,textarea{max-width:100%}
input,select,textarea{min-width:0}
button{white-space:normal;line-height:1.35}
pre,code{white-space:pre-wrap;overflow-wrap:anywhere}
.topbar{min-width:0;max-width:100%}
.topbar-title{min-width:0;flex:1 1 auto;flex-wrap:wrap}
.topbar-title>strong{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.topbar-actions{min-width:0;max-width:100%}
.workspace-badge{min-width:0;max-width:min(180px,28vw)}
.attention-item{min-width:0}
.attention-item>*{min-width:0}
.attention-actions{min-width:0;flex-wrap:wrap;justify-content:flex-end}
.layout-table-scroll{width:100%;max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch;border-radius:inherit}
.layout-table-scroll>table{width:100%;min-width:680px}
[data-page] table{max-width:100%}
.reference-image-wrap{overflow:auto}
.reference-image-wrap img{max-width:100%;height:auto}

/* Robust grid shrink behavior */
.content :is(.grid,[class$="-grid"],[class*="-grid "]){min-width:0}
.content :is(.grid,[class$="-grid"],[class*="-grid "])>*{min-width:0}

/* R23 Leadership JD */
.r23-hero{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(260px,.65fr);gap:18px;padding:26px;border:1px solid #dce6df;border-radius:22px;background:linear-gradient(135deg,#f9fbfa 0%,#eef5f0 100%);margin-bottom:18px;overflow:hidden;position:relative}
.r23-hero:after{content:"";position:absolute;width:260px;height:260px;border:44px solid rgba(65,108,86,.05);border-radius:50%;right:-90px;top:-100px;pointer-events:none}
.r23-kicker{font-size:9px;font-weight:900;letter-spacing:.11em;color:#4f6c5c;text-transform:uppercase}
.r23-hero h2{font-size:28px!important;line-height:1.12!important;letter-spacing:-.04em!important;margin:7px 0 10px!important;color:#1b2720!important}
.r23-hero p{font-size:12px;line-height:1.7;color:#5f6d65;margin:0;max-width:760px}
.r23-hero-side{position:relative;z-index:1;background:#1f2f26;color:#eef6f1;border-radius:16px;padding:18px;display:grid;gap:11px;align-content:start}
.r23-hero-side b{font-size:11px;letter-spacing:.04em}
.r23-hero-side span{font-size:11px;line-height:1.55;color:#d3e2d8}
.r23-jd-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.r23-jd-card{border:1px solid var(--ui-line);border-radius:14px;background:var(--ui-surface);padding:16px;display:grid;gap:8px}
.r23-jd-card .num{font-size:10px;font-weight:900;color:#668071;letter-spacing:.08em}
.r23-jd-card h3{font-size:14px;margin:0;color:var(--ui-ink)}
.r23-jd-card p{font-size:11px;line-height:1.6;color:var(--ui-muted);margin:0}
.r23-case-grid{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:14px}
.r23-fact,.r23-lesson{border:1px solid var(--ui-line);border-radius:14px;padding:16px;background:var(--ui-surface-2)}
.r23-fact h3,.r23-lesson h3{font-size:13px;margin:0 0 10px}
.r23-fact ul,.r23-lesson ol{margin:0;padding-left:18px;display:grid;gap:7px;font-size:11px;line-height:1.6;color:var(--ui-muted)}
.r23-caveat{margin-top:12px;padding:10px 12px;border-left:3px solid #b7791f;background:#fff8e8;border-radius:8px;font-size:10px;line-height:1.55;color:#6f5420}
.r23-map{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;align-items:stretch}
.r23-map-step{border:1px solid #dce5df;border-radius:12px;background:#fbfcfb;padding:13px;position:relative}
.r23-map-step:not(:last-child)::after{content:"→";position:absolute;right:-9px;top:50%;transform:translateY(-50%);color:#829288;font-weight:900;z-index:2}
.r23-map-step b{display:block;font-size:10px;letter-spacing:.05em;color:#486252;margin-bottom:5px}
.r23-map-step span{font-size:10px;line-height:1.5;color:#66736c}
.r23-lab{display:grid;grid-template-columns:minmax(0,1fr) minmax(300px,.75fr);gap:14px}
.r23-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.r23-form label{display:grid;gap:5px;font-size:10px;font-weight:800;color:var(--ui-muted)}
.r23-form label.wide{grid-column:1/-1}
.r23-form input,.r23-form textarea,.r23-form select{width:100%;border:1px solid var(--ui-line);border-radius:10px;background:var(--ui-surface);color:var(--ui-ink);padding:9px 10px;font:inherit}
.r23-form textarea{min-height:74px;resize:vertical}
.r23-result{border:1px solid #cfe0d5;border-radius:14px;background:#f4f8f5;padding:16px;min-height:100%;display:grid;gap:10px;align-content:start}
.r23-result h3{font-size:13px;margin:0;color:#274232}
.r23-result .row{padding:9px 0;border-bottom:1px solid #dce7df;display:grid;gap:3px}
.r23-result .row:last-child{border-bottom:0}
.r23-result .row b{font-size:9px;color:#60766a;letter-spacing:.06em;text-transform:uppercase}
.r23-result .row span{font-size:11px;line-height:1.55;color:#32483a}
.r23-route-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.r23-route{border:1px solid var(--ui-line);border-radius:12px;background:var(--ui-surface);color:var(--ui-ink);padding:13px;text-align:left;display:grid;gap:4px;transition:.16s ease}
.r23-route:hover,.r23-route:focus-visible{background:var(--r23-soft);border-color:#9cb7a8;transform:translateY(-1px)}
.r23-route b{font-size:11px}.r23-route span{font-size:10px;color:var(--ui-muted);line-height:1.45}
.r23-save-row{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:12px}
.r23-primary{border:1px solid #274232;background:#274232;color:#fff;border-radius:9px;padding:8px 11px;font-weight:850;font-size:11px}
.r23-secondary{border:1px solid var(--ui-line);background:var(--ui-surface);color:var(--ui-ink);border-radius:9px;padding:8px 11px;font-weight:800;font-size:11px}
.r23-primary:hover{background:#355b45}.r23-secondary:hover{background:var(--r23-soft);border-color:#9cb7a8}
.r23-log{margin-top:12px;display:grid;gap:8px}
.r23-log-item{border:1px solid var(--ui-line);border-radius:11px;padding:11px;background:var(--ui-surface-2);display:grid;gap:4px}
.r23-log-item b{font-size:10px}.r23-log-item span{font-size:10px;color:var(--ui-muted);line-height:1.5}

html[data-theme="dark"] .r23-hero{background:linear-gradient(135deg,#171d19 0%,#202b24 100%);border-color:#334238}
html[data-theme="dark"] .r23-hero h2{color:#edf4ef!important}
html[data-theme="dark"] .r23-hero p{color:#aebbb3}
html[data-theme="dark"] .r23-fact,html[data-theme="dark"] .r23-lesson,html[data-theme="dark"] .r23-map-step,html[data-theme="dark"] .r23-result{background:var(--ui-surface-2);border-color:var(--ui-line)}
html[data-theme="dark"] .r23-caveat{background:#2d2719;color:#ddc987;border-color:#9d7b32}
html[data-theme="dark"] .r23-result .row{border-color:#334038}
html[data-theme="dark"] .r23-result .row span{color:#d7e0da}

@media(max-width:1180px){
  .shell{grid-template-columns:minmax(205px,225px) minmax(0,1fr)!important}
  .content{max-width:100%!important}
  .r23-jd-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .r23-map{grid-template-columns:repeat(3,minmax(0,1fr))}
  .r23-map-step::after{display:none}
  .r23-route-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(max-width:980px){
  .content :is([class$="-grid"],[class*="-grid "]){grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .content>.grid{grid-template-columns:1fr!important}
  .attention-item{grid-template-columns:minmax(70px,auto) minmax(0,1fr)!important}
  .attention-actions{grid-column:1/-1;justify-content:flex-start}
  .r23-hero,.r23-case-grid,.r23-lab{grid-template-columns:1fr}
}
@media(max-width:900px){
  .shell{grid-template-columns:1fr!important}
  .sidebar{width:100%;max-width:100%;}
  .topbar{max-width:100%;}
  .content{padding-inline:clamp(12px,3vw,20px)!important}
}
@media(max-width:720px){
  .topbar{align-items:flex-start!important;flex-direction:column!important;gap:8px!important;padding-inline:14px!important}
  .topbar-title{width:100%}
  .topbar-actions{width:100%;justify-content:flex-start!important;overflow-x:auto;flex-wrap:nowrap!important;padding-bottom:2px;scrollbar-width:none}
  .topbar-actions::-webkit-scrollbar{display:none}
  .topbar-actions>*{flex:0 0 auto}
  .workspace-badge{max-width:42vw}
  .content :is([class$="-grid"],[class*="-grid "]){grid-template-columns:1fr!important}
  .stat-grid,.people-grid,.addon-grid,.report-grid,.skill-grid,.phase-grid{grid-template-columns:1fr!important}
  .attention-item{grid-template-columns:1fr!important;align-items:start}
  .attention-actions{grid-column:auto;width:100%;justify-content:flex-start}
  .context-row{grid-template-columns:1fr!important;gap:3px}
  .section-head,[class$="-head"],[class*="-head "]{flex-direction:column!important;align-items:stretch!important}
  .r23-jd-grid,.r23-map,.r23-route-grid,.r23-form{grid-template-columns:1fr!important}
  .r23-form label.wide{grid-column:auto}
  .r23-hero{padding:18px}.r23-hero h2{font-size:23px!important}
  .r23-save-row>*{width:100%}
}
@media(max-width:460px){
  .content{padding-inline:12px!important}
  h1,.content>h1{font-size:25px!important}
  .card,[class*="-card"]{border-radius:12px!important;padding:14px!important}
  nav a{padding-inline:10px!important}
}
@media(prefers-reduced-motion:reduce){
  .r23-route,.r23-primary,.r23-secondary{transition:none!important;transform:none!important}
}

/* ============================================================
   RECOVERY 24.1 · QUEST PANEL LAYOUT + EDITABILITY HOTFIX
   - keep the 30-day list inside its own scroll container
   - prevent sticky sidebar content from escaping/overlapping later sections
   - allow local title/artifact label edits without mutating core curriculum
   ============================================================ */
.quest-layout{
  align-items:start!important;
  min-width:0;
}
.quest-layout>*{min-width:0;}
.quest-sidebar{
  display:grid!important;
  grid-template-rows:auto minmax(0,1fr)!important;
  gap:10px!important;
  position:sticky;
  top:86px;
  height:min(760px,calc(100vh - 112px));
  max-height:min(760px,calc(100vh - 112px));
  min-height:420px;
  overflow:hidden!important;
  align-self:start;
  border:1px solid var(--ui-line);
  border-radius:16px;
  padding:12px;
  background:var(--ui-surface);
  box-shadow:0 8px 26px rgba(16,24,40,.05);
}
.quest-sidebar>div:first-child{
  min-width:0;
  position:relative;
  z-index:2;
  padding-bottom:8px;
  border-bottom:1px solid var(--ui-line);
  background:var(--ui-surface);
}
.quest-phase-filters{margin-top:8px;}
.quest-list{
  min-width:0!important;
  min-height:0!important;
  height:100%!important;
  max-height:none!important;
  align-content:start!important;
  overflow-y:auto!important;
  overflow-x:hidden!important;
  overscroll-behavior:contain;
  scrollbar-gutter:stable;
  padding:2px 5px 14px 1px!important;
}
.quest-list::-webkit-scrollbar{width:8px;}
.quest-list::-webkit-scrollbar-track{background:transparent;}
.quest-list::-webkit-scrollbar-thumb{background:#d0d5dd;border-radius:999px;border:2px solid transparent;background-clip:padding-box;}
html[data-theme="dark"] .quest-list::-webkit-scrollbar-thumb{background:#475467;border:2px solid transparent;background-clip:padding-box;}
.quest-row{
  box-sizing:border-box!important;
  min-width:0!important;
  width:100%!important;
  min-height:58px!important;
  max-height:none!important;
  padding:9px 10px!important;
  border-radius:13px!important;
  overflow:hidden!important;
  flex:none!important;
}
.quest-row-copy{overflow:hidden!important;}
.quest-row-copy strong{
  font-size:11px!important;
  line-height:1.32!important;
  white-space:normal!important;
  overflow-wrap:anywhere!important;
}
.quest-row-copy small{
  font-size:9px!important;
  line-height:1.35!important;
  white-space:nowrap!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
}
.quest-editor-bar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:6px;
  margin-top:9px;
}
.quest-editor-bar .quest-edit-help{font-size:8px;color:var(--ui-muted);line-height:1.35;}
.quest-editor-actions{display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end;}
.quest-editor-actions button{
  min-height:28px!important;
  padding:5px 8px!important;
  font-size:9px!important;
  border-radius:8px!important;
}
.quest-editor-actions button.active{
  background:#16181d!important;
  color:#fff!important;
  border-color:#16181d!important;
}
.quest-row.is-editing .quest-row-copy strong,
.quest-row.is-editing .quest-row-copy small{
  outline:1px dashed #84adff;
  outline-offset:2px;
  border-radius:4px;
  cursor:text;
  background:#eff8ff;
  color:#102a56!important;
  padding:1px 2px;
}
html[data-theme="dark"] .quest-row.is-editing .quest-row-copy strong,
html[data-theme="dark"] .quest-row.is-editing .quest-row-copy small{
  background:#102a3f;
  color:#d1e9ff!important;
  outline-color:#53b1fd;
}
.quest-sidebar.is-collapsed{
  height:auto!important;
  min-height:0!important;
  max-height:none!important;
  grid-template-rows:auto!important;
}
.quest-sidebar.is-collapsed .quest-list{display:none!important;}
.quest-sidebar.is-collapsed .quest-edit-help{display:none;}
.quest-detail,.quest-chief-rail{position:relative;z-index:1;}

/* prevent the quest card itself from being made visually shorter by later sections */
.quest-layout.closest-guard{overflow:visible;}

@media(max-width:1180px){
  .quest-sidebar{
    height:min(650px,calc(100vh - 108px));
    max-height:min(650px,calc(100vh - 108px));
    min-height:360px;
  }
}
@media(max-width:900px){
  .quest-sidebar{
    position:relative!important;
    top:auto!important;
    height:auto!important;
    max-height:none!important;
    min-height:0!important;
    overflow:visible!important;
  }
  .quest-list{
    height:auto!important;
    max-height:420px!important;
    min-height:0!important;
    overflow-y:auto!important;
  }
}
@media(max-width:620px){
  .quest-sidebar{padding:10px;}
  .quest-list{max-height:360px!important;}
  .quest-row{min-height:54px!important;padding:8px 9px!important;}
  .quest-editor-bar{align-items:flex-start;flex-direction:column;}
  .quest-editor-actions{width:100%;justify-content:flex-start;}
}
</style>
<style id="recovery-25-ai-usage-css">
/* RECOVERY 25 · AI Usage Runtime */
.ai25-shell{display:grid;gap:16px;min-width:0}
.ai25-hero{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(260px,.65fr);gap:16px;padding:24px;border-radius:22px;background:linear-gradient(135deg,#13251b,#284f39);color:#fff;overflow:hidden}
.ai25-hero h2{font-size:clamp(25px,3.5vw,40px);line-height:1.08;letter-spacing:-.035em;margin:7px 0 11px}.ai25-hero p{color:#dcebe2;line-height:1.65;max-width:820px}.ai25-hero-side{display:grid;gap:9px;align-content:start}.ai25-hero-side>div{padding:13px;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.07);border-radius:13px}.ai25-hero-side span{display:block;color:#dcebe2;font-size:11px;line-height:1.55;margin-top:4px}.ai25-kicker{font-size:10px;letter-spacing:.12em;font-weight:900;color:#9dd4b3;text-transform:uppercase}
.ai25-toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:end}.ai25-toolbar label{display:grid;gap:5px;font-size:10px;font-weight:800;color:var(--muted)}.ai25-toolbar select,.ai25-toolbar input{min-width:150px;max-width:220px;border:1px solid var(--border);background:var(--panel);color:var(--text);border-radius:10px;padding:9px 10px}
.ai25-metrics{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px}.ai25-metric{border:1px solid var(--border);background:var(--panel);border-radius:15px;padding:14px;min-width:0}.ai25-metric small{display:block;font-size:9px;letter-spacing:.08em;color:var(--muted);font-weight:900;text-transform:uppercase}.ai25-metric strong{display:block;font-size:clamp(18px,2vw,28px);margin-top:8px;letter-spacing:-.035em;overflow-wrap:anywhere}.ai25-metric span{display:block;margin-top:6px;font-size:10px;color:var(--muted);line-height:1.45}
.ai25-grid2{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr);gap:14px;min-width:0}.ai25-grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.ai25-card{border:1px solid var(--border);background:var(--panel);border-radius:17px;padding:16px;min-width:0}.ai25-card h3{font-size:14px;margin:0 0 6px}.ai25-card p{font-size:11px;line-height:1.55;color:var(--muted);margin:0}
.ai25-state{display:inline-flex;align-items:center;padding:4px 8px;border-radius:999px;font-size:9px;font-weight:900;letter-spacing:.06em;border:1px solid var(--border);background:var(--soft);white-space:nowrap}.ai25-state.notice{background:#f3f8f4;border-color:#b9d4c1;color:#356148}.ai25-state.review{background:#fff7e8;border-color:#ebd29c;color:#8a5c12}.ai25-state.stop{background:#fff0ee;border-color:#e5b4ad;color:#a33a35}.ai25-state.clear{background:#f3f5f4;color:#54605a}
.ai25-alerts{display:grid;gap:8px}.ai25-alert{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:10px;align-items:center;border:1px solid var(--border);border-radius:13px;padding:11px 12px;background:var(--panel);min-width:0}.ai25-alert:hover{background:var(--soft);border-color:#a5b6ac}.ai25-alert strong{font-size:11px;display:block}.ai25-alert span{font-size:10px;color:var(--muted);display:block;margin-top:2px;overflow-wrap:anywhere}.ai25-alert button{min-height:30px!important;padding:5px 9px!important;font-size:9px!important}
.ai25-budget-list{display:grid;gap:8px}.ai25-budget-row{display:grid;grid-template-columns:minmax(120px,1fr) 90px 90px 85px;gap:8px;align-items:center;border-bottom:1px solid var(--border);padding:9px 0;font-size:10px}.ai25-budget-row:last-child{border-bottom:0}.ai25-budget-row b{font-size:11px}.ai25-budget-track{height:7px;border-radius:999px;background:var(--soft);overflow:hidden;margin-top:5px}.ai25-budget-track i{display:block;height:100%;background:#5f8b70;border-radius:999px}.ai25-budget-track i.review{background:#d4a34a}.ai25-budget-track i.stop{background:#bc5c54}
.ai25-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.ai25-form .wide{grid-column:1/-1}.ai25-form label{display:grid;gap:5px;font-size:10px;font-weight:800;color:var(--muted)}.ai25-form input,.ai25-form select,.ai25-form textarea{width:100%;min-width:0;border:1px solid var(--border);border-radius:10px;padding:9px 10px;background:var(--panel);color:var(--text)}.ai25-form textarea{min-height:74px;resize:vertical}.ai25-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}.ai25-actions button{min-height:34px!important;padding:7px 11px!important;font-size:10px!important}.ai25-primary{background:#204c34!important;color:#fff!important;border-color:#204c34!important}.ai25-secondary{background:var(--panel)!important;color:var(--text)!important}
.ai25-context-list,.ai25-registry{display:grid;gap:7px}.ai25-context{display:grid;grid-template-columns:22px minmax(0,1fr) auto;gap:9px;align-items:start;border:1px solid var(--border);border-radius:12px;padding:10px;background:var(--panel);min-width:0}.ai25-context:hover{background:var(--soft);border-color:#a8b8ae}.ai25-context.is-stale{border-color:#e2bf79;background:#fffaf0}.ai25-context.is-blocked{opacity:.62}.ai25-context input{margin-top:2px}.ai25-context b{display:block;font-size:11px}.ai25-context span,.ai25-context small{display:block;font-size:9px;color:var(--muted);line-height:1.45;margin-top:2px}.ai25-context .meta{font-size:9px;text-align:right;color:var(--muted);white-space:nowrap}
.ai25-route-preview{border:1px solid var(--border);border-radius:14px;background:var(--soft);padding:13px;margin-top:10px}.ai25-route-preview b{font-size:11px}.ai25-route-preview p{margin:5px 0 0;font-size:10px;line-height:1.5}.ai25-route-preview .route-line{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.ai25-chip{display:inline-flex;padding:4px 7px;border:1px solid var(--border);border-radius:999px;background:var(--panel);font-size:9px;color:var(--text);max-width:100%;overflow-wrap:anywhere}
.ai25-table-wrap{width:100%;overflow:auto;overscroll-behavior-inline:contain;border:1px solid var(--border);border-radius:13px}.ai25-table{width:100%;min-width:760px;border-collapse:collapse}.ai25-table th,.ai25-table td{padding:9px 10px;border-bottom:1px solid var(--border);font-size:9px;text-align:left;vertical-align:top;white-space:nowrap}.ai25-table th{font-size:8px;color:var(--muted);letter-spacing:.06em;text-transform:uppercase;background:var(--soft)}.ai25-table tr:last-child td{border-bottom:0}.ai25-table td.wrap{white-space:normal;min-width:160px}.ai25-table button{min-height:28px!important;padding:4px 8px!important;font-size:8px!important}
.ai25-rate-head,.ai25-reg-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;margin-bottom:10px}.ai25-rate{border:1px solid var(--border);border-radius:13px;padding:11px;background:var(--panel);display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px}.ai25-rate strong{font-size:11px}.ai25-rate span{display:block;font-size:9px;color:var(--muted);margin-top:3px;line-height:1.45}.ai25-rate .buttons{display:flex;gap:5px;align-items:start}.ai25-rate .buttons button{min-height:28px!important;padding:4px 7px!important;font-size:8px!important}
.ai25-tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}.ai25-tabs button{min-height:30px!important;padding:5px 9px!important;font-size:9px!important}.ai25-tabs button.active{background:#1f4e35!important;color:#fff!important;border-color:#1f4e35!important}
.ai25-today-attention{border-left:4px solid #d0a34b!important;margin-bottom:14px!important}.ai25-today-head{display:flex;justify-content:space-between;gap:12px;align-items:center}.ai25-today-head h2{margin:0;font-size:14px}.ai25-today-list{display:grid;gap:7px;margin-top:9px}.ai25-today-item{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;border-top:1px solid var(--border);padding-top:8px}.ai25-today-item:first-child{border-top:0;padding-top:0}.ai25-today-item b{font-size:10px}.ai25-today-item span{display:block;color:var(--muted);font-size:9px;margin-top:2px;line-height:1.45}
.ai25-top-btn{position:relative}.ai25-top-btn .count-badge{margin-left:4px}
html[data-theme="dark"] .ai25-context.is-stale{background:#2a2419;border-color:#6d5726}.ai25-primary{box-shadow:none!important}
@media(max-width:1180px){.ai25-metrics{grid-template-columns:repeat(3,minmax(0,1fr))}.ai25-grid2{grid-template-columns:1fr}.ai25-grid3{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:760px){.ai25-hero{grid-template-columns:1fr}.ai25-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.ai25-form{grid-template-columns:1fr}.ai25-grid3{grid-template-columns:1fr}.ai25-budget-row{grid-template-columns:1fr 80px 80px}.ai25-budget-row>:nth-child(4){grid-column:1/-1}.ai25-toolbar label{width:100%}.ai25-toolbar select,.ai25-toolbar input{width:100%;max-width:none}}
@media(max-width:460px){.ai25-metrics{grid-template-columns:1fr}.ai25-alert{grid-template-columns:auto minmax(0,1fr)}.ai25-alert button{grid-column:1/-1;width:100%}.ai25-hero{padding:18px}.ai25-rate{grid-template-columns:1fr}.ai25-rate .buttons{justify-content:flex-start}}
</style>
<style id="recovery-26-team-ssot-css">
/* RECOVERY 26 · Team Credit → SSOT */
.ai26-top-btn{border-color:#9cc7b0!important;background:#eff8f2!important;color:#25563b!important;font-weight:850!important}.ai26-top-btn:hover{background:#dff1e5!important;border-color:#6aa481!important}
.ai26-shell{display:grid;gap:16px;min-width:0}.ai26-hero{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(260px,.7fr);gap:16px;padding:25px;border-radius:22px;background:linear-gradient(135deg,#10251c,#244c39);color:#fff;overflow:hidden}.ai26-hero h2{font-size:clamp(25px,3.4vw,40px);line-height:1.08;letter-spacing:-.035em;margin:7px 0 11px}.ai26-hero p{color:#dcebe2;line-height:1.65;max-width:830px}.ai26-hero-side{display:grid;gap:9px;align-content:start}.ai26-hero-side>div{padding:13px;border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.07);border-radius:13px}.ai26-hero-side span{display:block;color:#dcebe2;font-size:11px;line-height:1.55;margin-top:4px}.ai26-kicker{font-size:10px;letter-spacing:.12em;font-weight:900;color:#9dd4b3;text-transform:uppercase}
.ai26-toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:end}.ai26-toolbar label{display:grid;gap:5px;font-size:10px;font-weight:850;color:var(--muted)}.ai26-toolbar select,.ai26-toolbar input{min-width:170px;border:1px solid var(--border);background:var(--panel);color:var(--text);border-radius:10px;padding:9px 10px}
.ai26-metrics{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}.ai26-metric{border:1px solid var(--border);background:var(--panel);border-radius:15px;padding:14px;min-width:0}.ai26-metric small{display:block;font-size:9px;letter-spacing:.08em;color:var(--muted);font-weight:900;text-transform:uppercase}.ai26-metric strong{display:block;font-size:clamp(18px,2vw,28px);margin-top:8px;letter-spacing:-.035em;overflow-wrap:anywhere}.ai26-metric span{display:block;margin-top:6px;font-size:10px;color:var(--muted);line-height:1.45}
.ai26-grid2{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.85fr);gap:14px;min-width:0}.ai26-grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.ai26-card{border:1px solid var(--border);background:var(--panel);border-radius:17px;padding:16px;min-width:0}.ai26-card h3{font-size:14px;margin:0 0 6px}.ai26-card p{font-size:11px;line-height:1.6;color:var(--muted);margin:0}.ai26-section-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:12px}.ai26-section-head h2{font-size:19px;margin:2px 0 5px}.ai26-actions{display:flex;gap:7px;flex-wrap:wrap}.ai26-state{display:inline-flex;align-items:center;padding:4px 8px;border-radius:999px;font-size:9px;font-weight:900;letter-spacing:.05em;border:1px solid var(--border);background:var(--soft);white-space:nowrap}.ai26-state.p0{background:#fff0ee;border-color:#e6b2aa;color:#9b3b35}.ai26-state.p1{background:#fff7e8;border-color:#e8cf9a;color:#855b18}.ai26-state.p2,.ai26-state.good{background:#eff8f2;border-color:#b8d5c3;color:#356148}.ai26-state.draft{background:#f2f4f7;color:#59606a}.ai26-state.confirmed{background:#e8f5ec;border-color:#a8cfb5;color:#28583b}
.ai26-plan-list,.ai26-signal-list,.ai26-review-list,.ai26-resolver-list,.ai26-anomaly-list{display:grid;gap:8px}.ai26-plan-item,.ai26-signal,.ai26-review,.ai26-resolver-item,.ai26-anomaly{border:1px solid var(--border);border-radius:13px;padding:11px 12px;background:var(--panel);min-width:0}.ai26-plan-item:hover,.ai26-review:hover{background:var(--soft);border-color:#a9b9ae}.ai26-plan-top,.ai26-review-top{display:flex;gap:8px;align-items:flex-start;justify-content:space-between}.ai26-plan-item b,.ai26-review b{font-size:11px}.ai26-plan-item span,.ai26-review span,.ai26-signal span,.ai26-resolver-item span,.ai26-anomaly span{display:block;font-size:10px;line-height:1.55;color:var(--muted);margin-top:3px;overflow-wrap:anywhere}.ai26-plan-meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.ai26-chip{font-size:9px;border:1px solid var(--border);background:var(--soft);padding:4px 7px;border-radius:999px;color:var(--muted)}
.ai26-progress{height:8px;border-radius:999px;background:var(--soft);overflow:hidden;margin-top:7px}.ai26-progress i{height:100%;display:block;border-radius:999px;background:#5f8b70}.ai26-progress i.warn{background:#d3a04a}.ai26-progress i.stop{background:#b95851}
.ai26-roadmap{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.ai26-roadstep{border:1px solid var(--border);border-radius:13px;padding:12px;background:var(--panel);min-width:0}.ai26-roadstep small{display:block;color:var(--muted);font-size:9px;font-weight:900;letter-spacing:.06em}.ai26-roadstep b{display:block;font-size:11px;margin-top:5px}.ai26-roadstep span{font-size:10px;color:var(--muted);line-height:1.5;display:block;margin-top:4px}
.ai26-table-wrap{width:100%;max-width:100%;overflow-x:auto;border:1px solid var(--border);border-radius:13px}.ai26-table{width:100%;min-width:760px;border-collapse:collapse;font-size:10px}.ai26-table th,.ai26-table td{padding:9px 10px;border-bottom:1px solid var(--border);text-align:left;vertical-align:top}.ai26-table th{font-size:9px;letter-spacing:.05em;color:var(--muted);background:var(--soft)}
.ai26-empty{padding:20px;border:1px dashed var(--border);border-radius:13px;color:var(--muted);font-size:11px;line-height:1.6;text-align:center}.ai26-note{padding:11px 12px;border:1px solid #bad4c3;background:#f3f8f4;border-radius:12px;color:#345f46;font-size:10px;line-height:1.6}.ai26-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.ai26-form .wide{grid-column:1/-1}.ai26-form label{display:grid;gap:5px;font-size:10px;font-weight:800;color:var(--muted)}.ai26-form select,.ai26-form input,.ai26-form textarea{width:100%;min-width:0;border:1px solid var(--border);background:var(--panel);color:var(--text);border-radius:10px;padding:9px 10px}.ai26-form textarea{min-height:76px;resize:vertical}
html[data-theme="dark"] .ai26-top-btn{background:#183126!important;border-color:#365f48!important;color:#d8f2e2!important}html[data-theme="dark"] .ai26-state.p0{background:#3d2220;border-color:#6f3b36;color:#ffd9d3}html[data-theme="dark"] .ai26-state.p1{background:#3d321d;border-color:#6f5b30;color:#ffe1a3}html[data-theme="dark"] .ai26-state.good,html[data-theme="dark"] .ai26-state.p2,html[data-theme="dark"] .ai26-state.confirmed{background:#173225;border-color:#345e46;color:#d5f3df}
@media(max-width:1180px){.ai26-metrics{grid-template-columns:repeat(3,minmax(0,1fr))}.ai26-roadmap{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:900px){.ai26-hero,.ai26-grid2{grid-template-columns:1fr}.ai26-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:620px){.ai26-metrics,.ai26-grid3,.ai26-roadmap,.ai26-form{grid-template-columns:1fr}.ai26-section-head{flex-direction:column}.ai26-toolbar label,.ai26-toolbar select{width:100%;max-width:none}.ai26-toolbar button{width:100%}}
</style>
<style id="recovery-26-1-dark-contrast">
/* RECOVERY 26.1 · Dark Mode Contrast Guardrail */
html[data-theme="dark"]{
  --ui-bg:#0b0f13;
  --ui-surface:#151a20;
  --ui-surface-2:#10151a;
  --ui-surface-3:#1b222a;
  --ui-ink:#f4f7fa;
  --ui-muted:#aeb7c2;
  --ui-muted-2:#88939f;
  --ui-line:#303943;
  --ui-line-strong:#46515d;
  --ui-soft:#202832;
  --ui-accent:#f4f7fa;
  --ui-accent-ink:#11161b;
  --ui-success-bg:#14271d;
  --ui-success-ink:#9ee0b7;
  --ui-warning-bg:#2b2313;
  --ui-warning-ink:#f2ce7e;
  --ui-danger-bg:#2b1718;
  --ui-danger-ink:#f3aaa4;
  --ui-info-bg:#142236;
  --ui-info-ink:#9ec5ff;
}
html[data-theme="dark"] body,
html[data-theme="dark"] main,
html[data-theme="dark"] .content{background:var(--ui-bg);color:var(--ui-ink)}

/* canonical surfaces */
html[data-theme="dark"] :where(
  .sidebar,.topbar,.card,.review-card,.person-card,.agenda-item,.flow-step,.decision-card,.addon-card,.ask-response,.phase,.skill-card,
  .billing-stat,.runtime-mode-card,.first-use,.first-use-plan-item,.preference-panel,.decision-persist-box,.workspace-picker,.workspace-switcher,
  .detail-panel,.share-box,.lens-panel,.lead-output,.after-question,.after-output,.lead-note,.reference-image-wrap,
  .artifact-card,.artifact-panel,.artifact-preview,.tool-card,.sample-card,.setup-card,.quest-card,.quest-shell,.quest-panel
){background:var(--ui-surface)!important;color:var(--ui-ink)!important;border-color:var(--ui-line)!important}
html[data-theme="dark"] :where(.safe,.empty-state,.review-result,.mode-explain,.lead-principles,.after-summary .after-left,.lead-note .summary-side){
  background:var(--ui-surface-2)!important;color:var(--ui-muted)!important;border-color:var(--ui-line)!important
}

/* common text hierarchy */
html[data-theme="dark"] :where(.sub,.why,.review-meta,.status,.principle,.preference-status,.meta,.muted,.helper,.caption,.hint,.artifact-meta,.quest-meta){color:var(--ui-muted)!important}
html[data-theme="dark"] :where(h1,h2,h3,h4,h5,h6,strong,b,.card-title,.section-title,.quest-title){color:var(--ui-ink)}
html[data-theme="dark"] :where(p,li,td,th,label){border-color:var(--ui-line)}

/* form controls and utility controls */
html[data-theme="dark"] :where(button,input,textarea,select,.field input,.field textarea,.field select,.workspace-switcher select,.r21-form input,.r21-form select,.r21-form textarea){
  background:var(--ui-surface-2)!important;color:var(--ui-ink)!important;border-color:var(--ui-line)!important
}
html[data-theme="dark"] :where(input,textarea)::placeholder{color:var(--ui-muted-2)!important;opacity:1}
html[data-theme="dark"] button:not(.primary):not(.selected):not(:disabled):hover{background:var(--ui-soft)!important;color:var(--ui-ink)!important;border-color:var(--ui-line-strong)!important}
html[data-theme="dark"] button:disabled{background:#171c22!important;color:#747e89!important;border-color:#29313a!important}
html[data-theme="dark"] button.primary,
html[data-theme="dark"] button.selected{background:var(--ui-accent)!important;color:var(--ui-accent-ink)!important;border-color:var(--ui-accent)!important}

/* tables */
html[data-theme="dark"] table{color:var(--ui-ink)}
html[data-theme="dark"] th{background:var(--ui-surface-2)!important;color:var(--ui-muted)!important;border-color:var(--ui-line)!important}
html[data-theme="dark"] td{color:var(--ui-ink);border-color:var(--ui-line)!important}
html[data-theme="dark"] tr:hover td{background:#192028!important}

/* generic neutral chips/badges */
html[data-theme="dark"] :where(.pill,.chip,.state-badge,.scope-badge,.mode-badge,.health,.delegate-level,.diag-card .diag-icon,.r20-chip,.r20-state,.r21-state,.r21-rulechip,.r21-proposal-status,.r22-context-pill,.r22-tag,.r22-calendar-type,.r22-stance,.ai25-state.clear,.ai26-state.draft){
  background:var(--ui-soft)!important;color:#d7dde5!important;border-color:var(--ui-line)!important
}

/* Newer recovery modules: default readable ink + borders */
html[data-theme="dark"] :where(
  [class^="r16-"],[class*=" r16-"],
  [class^="r17-"],[class*=" r17-"],
  [class^="r18-"],[class*=" r18-"],
  [class^="r19-"],[class*=" r19-"],
  [class^="r20-"],[class*=" r20-"],
  [class^="r21-"],[class*=" r21-"],
  [class^="r22-"],[class*=" r22-"],
  [class^="r23-"],[class*=" r23-"],
  [class^="ai24-"],[class*=" ai24-"],
  [class^="ai25-"],[class*=" ai25-"],
  [class^="ai26-"],[class*=" ai26-"],
  [class^="wow-"],[class*=" wow-"]
){color:var(--ui-ink);border-color:var(--ui-line)}

/* surface-like components added after the original dark theme */
html[data-theme="dark"] :where(
  .r16-filterbar,.dependency-cluster,.r16-diff-card,.commitment-bridge-item,.r16-trend-card,
  .r17-shell,.r17-group,.r17-lane,.r17-node,.r17-metric,
  .r19-policy-card,.r19-rule-chip,.r19-prompt,.r19-decision-row,.r19-runtime-board,.r19-runtime-surface,.r19-learning-item,
  .r20-stat,.r20-rule-option,.r20-agreement,.r20-context-card,.r20-review-item,.r20-runtime-card,.r20-runtime-rule,.r20-runtime-empty,.r20-meeting-template,
  .r21-step,.r21-resume,.r21-fastpath,.r21-agreement-card,.r21-proposal,.r21-rule-option,.r21-evidence,.r21-check,.r21-banner,.r21-empty,
  .r22-card,.r22-item,.r22-calendar-row,.r22-top3>div,.r22-comment,
  .r23-map-step,.r23-result,
  .wow-card,.wow-saved,.wow-note,
  .ai24-policy-preview,
  .ai25-card,.ai25-panel,.ai25-context,.ai25-context-card,.ai25-table-wrap,
  .ai26-card,.ai26-panel,.ai26-kpi,.ai26-candidate,.ai26-plan,.ai26-table-wrap
){background:var(--ui-surface)!important;color:var(--ui-ink)!important;border-color:var(--ui-line)!important}

/* muted copy inside late modules */
html[data-theme="dark"] :where(
  [class^="r16-"],[class*=" r16-"],
  [class^="r17-"],[class*=" r17-"],
  [class^="r19-"],[class*=" r19-"],
  [class^="r20-"],[class*=" r20-"],
  [class^="r21-"],[class*=" r21-"],
  [class^="r22-"],[class*=" r22-"],
  [class^="r23-"],[class*=" r23-"],
  [class^="ai24-"],[class*=" ai24-"],
  [class^="ai25-"],[class*=" ai25-"],
  [class^="ai26-"],[class*=" ai26-"],
  [class^="wow-"],[class*=" wow-"]
) :where(p,small,.meta,.muted){color:var(--ui-muted)!important}

/* semantic status colours retain meaning in dark mode */
html[data-theme="dark"] :where(.diag-card.warn,.r20-warn,.r21-review-notice,.r22-warning,.r23-caveat,.ai25-state.review,.ai26-state.p1,.ai24-note){
  background:var(--ui-warning-bg)!important;color:var(--ui-warning-ink)!important;border-color:#665327!important
}
html[data-theme="dark"] :where(.diag-card.critical,.r17-chip.overdue,.ai25-state.stop,.ai26-state.p0){
  background:var(--ui-danger-bg)!important;color:var(--ui-danger-ink)!important;border-color:#6a3334!important
}
html[data-theme="dark"] :where(.r17-chip.clear,.r19-prompt.done,.r20-state.confirmed,.r21-step.done,.today-nudge-card[data-state="complete"],.setup-item.auto-done,.ai25-state.notice,.ai26-state.p2,.ai26-state.good,.ai26-note){
  background:var(--ui-success-bg)!important;color:var(--ui-success-ink)!important;border-color:#315b41!important
}
html[data-theme="dark"] :where(.r17-chip.open,.evidence-ref,.quest-source-link,.role-pill,.mode-badge.signed-in){
  background:var(--ui-info-bg)!important;color:var(--ui-info-ink)!important;border-color:#31547c!important
}

/* Quest states */
html[data-theme="dark"] .quest-row{background:var(--ui-surface)!important;color:var(--ui-ink)!important;border-color:var(--ui-line)!important}
html[data-theme="dark"] .quest-row:hover{background:var(--ui-surface-3)!important;border-color:var(--ui-line-strong)!important}
html[data-theme="dark"] .quest-row.done{background:#14271d!important;color:var(--ui-ink)!important;border-color:#315b41!important}
html[data-theme="dark"] .quest-row.evidence:not(.done){background:#142236!important;color:var(--ui-ink)!important;border-color:#31547c!important}
html[data-theme="dark"] .quest-row.is-editing .quest-row-copy strong,
html[data-theme="dark"] .quest-row.is-editing .quest-row-copy small{background:#142236!important;color:#dbeafe!important;outline-color:#5f88c8!important}

/* inline hard-coded legacy colours/backgrounds */
html[data-theme="dark"] [style*="background:#fff"],
html[data-theme="dark"] [style*="background: #fff"],
html[data-theme="dark"] [style*="background:#ffffff"],
html[data-theme="dark"] [style*="background: #ffffff"],
html[data-theme="dark"] [style*="background:#fafbfc"],
html[data-theme="dark"] [style*="background: #fafbfc"],
html[data-theme="dark"] [style*="background:#fbfcfd"],
html[data-theme="dark"] [style*="background: #fbfcfd"]{background:var(--ui-surface)!important;color:var(--ui-ink)!important;border-color:var(--ui-line)!important}
html[data-theme="dark"] [style*="color:#16181d"],
html[data-theme="dark"] [style*="color: #16181d"],
html[data-theme="dark"] [style*="color:#30343b"],
html[data-theme="dark"] [style*="color: #30343b"],
html[data-theme="dark"] [style*="color:#475467"],
html[data-theme="dark"] [style*="color: #475467"],
html[data-theme="dark"] [style*="color:#59616d"],
html[data-theme="dark"] [style*="color: #59616d"],
html[data-theme="dark"] [style*="color:#667085"],
html[data-theme="dark"] [style*="color: #667085"]{color:var(--ui-muted)!important}

/* focus / hover must remain visible in dark mode */
html[data-theme="dark"] :where(a,button,input,textarea,select):focus-visible{outline:2px solid #7fb1ff!important;outline-offset:2px}
html[data-theme="dark"] nav a:hover,
html[data-theme="dark"] nav a[aria-current="page"]{background:var(--ui-soft)!important;color:var(--ui-ink)!important}

</style>
<style id="recovery-27-ai-operating-review-css">
/* RECOVERY 27 · AI Operating Review / Knowledge Ops */
.ai27-shell{display:grid;gap:14px;min-width:0}.ai27-hero{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(280px,.7fr);gap:18px;padding:24px;border:1px solid var(--line,#d9dedb);border-radius:20px;background:linear-gradient(135deg,#f7faf8 0%,#eef5f1 100%);min-width:0}.ai27-hero h2{font-size:30px;line-height:1.08;margin:6px 0 10px;letter-spacing:-.04em}.ai27-hero h2 em{font-style:normal;color:#2f6a51}.ai27-hero p{max-width:760px;color:#5e6b65;line-height:1.65}.ai27-hero-side{display:grid;gap:8px;align-content:start}.ai27-hero-side>div{padding:12px 13px;border:1px solid #d8e4dd;border-radius:13px;background:rgba(255,255,255,.72);display:grid;gap:4px}.ai27-hero-side b{font-size:12px}.ai27-hero-side span{font-size:11px;color:#66736d;line-height:1.45}
.ai27-toolbar{display:flex;flex-wrap:wrap;gap:9px;align-items:end}.ai27-toolbar label{display:grid;gap:5px;font-size:10px;font-weight:800;color:#69756f}.ai27-toolbar select,.ai27-toolbar input{min-width:150px;max-width:100%;padding:9px 10px;border:1px solid #d7ded9;border-radius:10px;background:#fff;color:#1b2420}.ai27-actions{display:flex;flex-wrap:wrap;gap:8px;align-items:center}.ai27-actions button,.ai27-btn{border:1px solid #d4dcd7;background:#fff;color:#25312b;border-radius:10px;padding:9px 12px;font-weight:800;font-size:11px}.ai27-actions button:hover,.ai27-btn:hover{background:#eef5f1;border-color:#97b8a5}.ai27-actions .primary,.ai27-btn.primary{background:#315f4c;border-color:#315f4c;color:#fff}.ai27-actions .primary:hover,.ai27-btn.primary:hover{background:#244b3b}
.ai27-metrics{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:9px}.ai27-metric{padding:13px;border:1px solid #dde3df;border-radius:13px;background:#fbfcfb;min-width:0}.ai27-metric small{display:block;color:#6d7973;font-weight:800;font-size:9px;text-transform:uppercase;letter-spacing:.08em}.ai27-metric strong{display:block;font-size:22px;margin:7px 0 4px;letter-spacing:-.04em}.ai27-metric span{display:block;color:#6e7974;font-size:10px;line-height:1.4;overflow-wrap:anywhere}.ai27-grid2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:12px;min-width:0}.ai27-card{padding:16px;border:1px solid #dde3df;border-radius:15px;background:#fff;min-width:0}.ai27-card h3{margin:4px 0 5px}.ai27-card p{color:#69756f;line-height:1.55;font-size:11px}
.ai27-trend{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;align-items:end;margin-top:14px;min-height:150px}.ai27-trend-col{display:grid;grid-template-rows:1fr auto auto;gap:6px;align-items:end;text-align:center;min-width:0}.ai27-trend-bar-wrap{height:100px;display:flex;align-items:flex-end;justify-content:center;border-bottom:1px solid #dce3df}.ai27-trend-bar{width:min(42px,70%);min-height:5px;border-radius:9px 9px 3px 3px;background:linear-gradient(180deg,#77a88e,#315f4c)}.ai27-trend-col b{font-size:11px}.ai27-trend-col small{font-size:9px;color:#78837d;overflow-wrap:anywhere}.ai27-demo-badge{display:inline-flex;padding:3px 7px;border-radius:999px;border:1px solid #d7cfa8;background:#fffbe8;color:#796817;font-size:9px;font-weight:900}
.ai27-registry,.ai27-list{display:grid;gap:8px;margin-top:10px}.ai27-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;padding:11px 12px;border:1px solid #e0e5e2;border-radius:12px;background:#fbfcfb;min-width:0}.ai27-row-main{min-width:0}.ai27-row b{display:block;font-size:11px;overflow-wrap:anywhere}.ai27-row span,.ai27-row small{display:block;font-size:10px;color:#6d7973;line-height:1.45;overflow-wrap:anywhere;margin-top:3px}.ai27-row-actions{display:flex;gap:6px;align-items:center;justify-content:flex-end;flex-wrap:wrap}.ai27-state{display:inline-flex;align-items:center;padding:4px 7px;border-radius:999px;font-size:9px;font-weight:900;border:1px solid #d8dfda;background:#f7f9f8;color:#56635d;white-space:nowrap}.ai27-state.good{border-color:#b8d6c5;background:#eef8f2;color:#27603f}.ai27-state.warn{border-color:#e2d09a;background:#fff8e7;color:#7a5d12}.ai27-state.bad{border-color:#e2bcbc;background:#fff2f2;color:#873737}.ai27-state.info{border-color:#b9cde5;background:#f1f6fc;color:#315b85}
.ai27-dep{display:grid;gap:9px;margin-top:12px}.ai27-lane{display:grid;grid-template-columns:minmax(120px,.65fr) 26px minmax(0,1.15fr) 26px minmax(0,1fr);gap:8px;align-items:stretch;min-width:0}.ai27-node{padding:10px;border:1px solid #dce3df;border-radius:12px;background:#fbfcfb;min-width:0}.ai27-node.route{background:#edf5f0;border-color:#c9ddd1}.ai27-node.output{background:#f5f5fb;border-color:#d8d8e9}.ai27-node b{font-size:10px;display:block}.ai27-node span{display:block;margin-top:4px;font-size:9px;color:#69756f;line-height:1.4;overflow-wrap:anywhere}.ai27-arrow{display:flex;align-items:center;justify-content:center;color:#84918a;font-weight:900}.ai27-node-stack{display:grid;gap:5px}.ai27-node-stack .mini{padding:6px 8px;border:1px solid #e1e6e3;border-radius:8px;background:#fff;font-size:9px;overflow-wrap:anywhere}
.ai27-charge-table-wrap{overflow:auto;max-width:100%;margin-top:10px}.ai27-table{width:100%;border-collapse:collapse;min-width:760px}.ai27-table th,.ai27-table td{text-align:left;padding:9px 10px;border-bottom:1px solid #e3e7e4;font-size:10px;vertical-align:top}.ai27-table th{font-size:9px;text-transform:uppercase;letter-spacing:.06em;color:#738078;background:#f7f9f8}.ai27-table td b{font-size:10px}.ai27-pack{display:grid;gap:10px;margin-top:10px}.ai27-pack-section{padding:13px;border:1px solid #dce3df;border-radius:12px;background:#fbfcfb}.ai27-pack-section small{display:block;font-size:9px;text-transform:uppercase;letter-spacing:.08em;color:#718078;font-weight:900}.ai27-pack-section h4{margin:5px 0 4px;font-size:13px}.ai27-pack-section p,.ai27-pack-section li{font-size:10px;color:#606d66;line-height:1.55}.ai27-pack-section ul{margin:6px 0 0;padding-left:17px}.ai27-reminder-draft{margin-top:9px;padding:10px;border:1px dashed #c9d4cd;border-radius:10px;background:#f8faf9;font-size:10px;line-height:1.5;color:#536059;white-space:pre-wrap;overflow-wrap:anywhere}.ai27-rbac-grid{display:grid;grid-template-columns:220px minmax(0,1fr);gap:12px;margin-top:10px}.ai27-rbac-summary{padding:12px;border:1px solid #dce3df;border-radius:12px;background:#fbfcfb}.ai27-empty{padding:14px;border:1px dashed #cbd5cf;border-radius:12px;color:#6e7974;font-size:10px;background:#fafcfb}
@media(max-width:1180px){.ai27-metrics{grid-template-columns:repeat(3,minmax(0,1fr))}.ai27-hero{grid-template-columns:1fr}.ai27-grid2{grid-template-columns:1fr}.ai27-lane{grid-template-columns:minmax(105px,.6fr) 22px minmax(0,1fr) 22px minmax(0,1fr)}}
@media(max-width:900px){.ai27-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.ai27-lane{grid-template-columns:1fr}.ai27-arrow{transform:rotate(90deg);min-height:20px}.ai27-rbac-grid{grid-template-columns:1fr}}
@media(max-width:620px){.ai27-metrics,.ai27-trend{grid-template-columns:1fr 1fr}.ai27-toolbar>*{width:100%}.ai27-toolbar select,.ai27-toolbar input{width:100%}.ai27-row{grid-template-columns:1fr}.ai27-row-actions{justify-content:flex-start}.ai27-hero{padding:17px}.ai27-hero h2{font-size:25px}}
@media(max-width:430px){.ai27-metrics,.ai27-trend{grid-template-columns:1fr}.ai27-actions>*{width:100%}}
html[data-theme="dark"] .ai27-hero{background:linear-gradient(135deg,#151a20,#18221d);border-color:#303943;color:#f4f7fa}html[data-theme="dark"] .ai27-hero p,html[data-theme="dark"] .ai27-hero-side span,html[data-theme="dark"] .ai27-card p,html[data-theme="dark"] .ai27-row span,html[data-theme="dark"] .ai27-row small,html[data-theme="dark"] .ai27-node span,html[data-theme="dark"] .ai27-pack-section p,html[data-theme="dark"] .ai27-pack-section li{color:#aeb7c2}html[data-theme="dark"] .ai27-hero-side>div,html[data-theme="dark"] .ai27-card,html[data-theme="dark"] .ai27-row,html[data-theme="dark"] .ai27-node,html[data-theme="dark"] .ai27-node-stack .mini,html[data-theme="dark"] .ai27-pack-section,html[data-theme="dark"] .ai27-rbac-summary{background:#151a20;border-color:#303943;color:#f4f7fa}html[data-theme="dark"] .ai27-node.route{background:#16251e;border-color:#2f5541}html[data-theme="dark"] .ai27-node.output{background:#1b1c29;border-color:#3b3d55}html[data-theme="dark"] .ai27-metric{background:#151a20;border-color:#303943;color:#f4f7fa}html[data-theme="dark"] .ai27-metric small,html[data-theme="dark"] .ai27-metric span{color:#aeb7c2}html[data-theme="dark"] .ai27-actions button,html[data-theme="dark"] .ai27-btn{background:#1b222a;border-color:#46515d;color:#f4f7fa}html[data-theme="dark"] .ai27-actions button:hover,html[data-theme="dark"] .ai27-btn:hover{background:#242d36;border-color:#668075}html[data-theme="dark"] .ai27-actions .primary,html[data-theme="dark"] .ai27-btn.primary{background:#3f765e;border-color:#5d9478;color:#fff}html[data-theme="dark"] .ai27-toolbar select,html[data-theme="dark"] .ai27-toolbar input{background:#151a20;border-color:#46515d;color:#f4f7fa}html[data-theme="dark"] .ai27-table th{background:#1b222a;color:#aeb7c2}html[data-theme="dark"] .ai27-table td,html[data-theme="dark"] .ai27-table th{border-color:#303943}html[data-theme="dark"] .ai27-reminder-draft{background:#14191f;border-color:#46515d;color:#c7d0d8}html[data-theme="dark"] .ai27-empty{background:#14191f;border-color:#46515d;color:#aeb7c2}html[data-theme="dark"] .ai27-state{background:#1b222a;border-color:#46515d;color:#d7dfe6}html[data-theme="dark"] .ai27-state.good{background:#13271c;border-color:#315f44;color:#8dd0a5}html[data-theme="dark"] .ai27-state.warn{background:#2a2414;border-color:#6f5d27;color:#e3c86d}html[data-theme="dark"] .ai27-state.bad{background:#2b1818;border-color:#713f3f;color:#e5a4a4}html[data-theme="dark"] .ai27-state.info{background:#172332;border-color:#365675;color:#9ec5ea}
</style>
<!-- RECOVERY_27: AI Operating Review + SSOT trend/dedup/dependency/freshness/chargeback -->
<style id="recovery-28-header-sync-css">
:root{--leader-shell-header-h:68px}
.sidebar-head{height:var(--leader-shell-header-h);min-height:var(--leader-shell-header-h);padding:5px 18px 4px!important;display:flex;flex-direction:column;justify-content:center;gap:2px}
.sidebar-head .brand{margin:0!important}
.sidebar-head .principle{font-size:10px!important;line-height:1.2!important;margin:0!important}
.topbar{min-height:var(--leader-shell-header-h)}
@media(max-width:900px){.sidebar-head{height:auto;min-height:0;padding:10px 14px!important}.topbar{min-height:0}}
</style>
<style id="recovery-28-css">
.ai28-shell{display:grid;gap:16px}.ai28-hero{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(260px,.7fr);gap:14px;padding:22px;border:1px solid var(--ui-line);border-radius:18px;background:linear-gradient(135deg,var(--ui-surface) 0%,var(--ui-surface-2) 100%);overflow:hidden}.ai28-hero h2{font-size:25px!important;letter-spacing:-.04em!important;margin:6px 0 8px!important}.ai28-hero p{margin:0;color:var(--ui-muted);font-size:11px;line-height:1.65}.ai28-hero-side{display:grid;gap:8px}.ai28-hero-side div{padding:10px;border:1px solid var(--ui-line);border-radius:11px;background:var(--ui-surface)}.ai28-hero-side b{display:block;font-size:9px;letter-spacing:.08em}.ai28-hero-side span{display:block;margin-top:4px;font-size:9px;color:var(--ui-muted);line-height:1.45}
.ai28-toolbar{display:flex;align-items:end;gap:8px;flex-wrap:wrap}.ai28-toolbar label{display:grid;gap:5px;font-size:9px;font-weight:800;color:var(--ui-muted)}.ai28-toolbar select,.ai28-toolbar input{min-height:34px;border:1px solid var(--ui-line);border-radius:8px;background:var(--ui-surface-2);color:var(--ui-ink);padding:6px 8px}.ai28-state{display:inline-flex;align-items:center;padding:4px 7px;border:1px solid var(--ui-line);border-radius:999px;font-size:8px;font-weight:900;letter-spacing:.04em}.ai28-state.good{background:#ecfdf3;border-color:#abefc6;color:#067647}.ai28-state.warn{background:#fffaeb;border-color:#fedf89;color:#b54708}.ai28-state.bad{background:#fff1f3;border-color:#fda29b;color:#b42318}.ai28-state.info{background:#eff8ff;border-color:#b2ddff;color:#175cd3}.ai28-grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}.ai28-card{border:1px solid var(--ui-line);border-radius:15px;background:var(--ui-surface);padding:16px;min-width:0}.ai28-card h3{font-size:13px;margin:5px 0 6px}.ai28-card p{font-size:10px;line-height:1.55;color:var(--ui-muted);margin:0}.ai28-list{display:grid;gap:7px;margin-top:10px}.ai28-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:center;padding:10px;border:1px solid var(--ui-line);border-radius:10px;background:var(--ui-surface-2);min-width:0}.ai28-row-main{min-width:0}.ai28-row-main b{display:block;font-size:10px;overflow-wrap:anywhere}.ai28-row-main span{display:block;margin-top:3px;font-size:8.5px;line-height:1.45;color:var(--ui-muted);overflow-wrap:anywhere}.ai28-actions{display:flex;gap:6px;align-items:center;flex-wrap:wrap}.ai28-actions button{min-height:30px!important;padding:5px 8px!important;font-size:9px!important}.ai28-lineage{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;align-items:stretch;margin-top:12px}.ai28-node{min-width:0;padding:11px;border:1px solid var(--ui-line);border-radius:11px;background:var(--ui-surface-2)}.ai28-node small{display:block;font-size:7.5px;font-weight:900;letter-spacing:.08em;color:var(--ui-muted)}.ai28-node b{display:block;font-size:9.5px;margin-top:5px;line-height:1.35;overflow-wrap:anywhere}.ai28-node span{display:block;font-size:8px;color:var(--ui-muted);margin-top:4px;line-height:1.4;overflow-wrap:anywhere}.ai28-node.confirmed{border-color:#75c69a;background:#f3faf6}.ai28-arrow{display:none}.ai28-compare{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:10px}.ai28-month{border:1px solid var(--ui-line);border-radius:11px;padding:11px;background:var(--ui-surface-2)}.ai28-month h4{font-size:10px;margin:0 0 8px}.ai28-month dl{display:grid;grid-template-columns:1fr auto;gap:6px 10px;margin:0}.ai28-month dt,.ai28-month dd{font-size:8.5px;margin:0}.ai28-month dt{color:var(--ui-muted)}.ai28-month dd{font-weight:800}.ai28-table-wrap{overflow:auto;max-width:100%;border:1px solid var(--ui-line);border-radius:11px;margin-top:10px}.ai28-table{width:100%;border-collapse:collapse;min-width:680px}.ai28-table th,.ai28-table td{padding:9px 10px;border-bottom:1px solid var(--ui-line);text-align:left;font-size:8.5px}.ai28-table th{font-size:7.5px;letter-spacing:.06em;color:var(--ui-muted);background:var(--ui-surface-2)}.ai28-table tr:last-child td{border-bottom:0}.ai28-gap-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px;margin-top:10px}.ai28-gap{border:1px solid var(--ui-line);border-radius:11px;padding:11px;background:var(--ui-surface-2);min-width:0}.ai28-gap b{font-size:9.5px;display:block}.ai28-gap span{display:block;font-size:8px;line-height:1.45;color:var(--ui-muted);margin-top:4px}.ai28-handoff{padding:12px;border:1px solid #b2ddff;border-radius:11px;background:#eff8ff;color:#175cd3;margin-top:10px;font-size:9px;line-height:1.55}.ai28-empty{padding:12px;border:1px dashed var(--ui-line);border-radius:10px;color:var(--ui-muted);font-size:9px;line-height:1.5}.ai28-life-form{display:grid;grid-template-columns:1fr 150px 1fr auto;gap:8px;align-items:end;margin-top:10px}.ai28-life-form label{display:grid;gap:4px;font-size:8px;color:var(--ui-muted);font-weight:800}.ai28-life-form select,.ai28-life-form input{min-height:34px;border:1px solid var(--ui-line);border-radius:8px;background:var(--ui-surface-2);color:var(--ui-ink);padding:6px 8px}.ai28-review-link{font-size:9px;text-decoration:none}.ai28-runtime-card{border-left:3px solid #175cd3}.ai28-manager-handoff{margin-top:10px;padding:10px;border:1px solid #b2ddff;border-radius:10px;background:#eff8ff;color:#175cd3;font-size:9px;line-height:1.5}.ai28-report-card{margin-top:14px}
html[data-theme="dark"] .ai28-state.good{background:#10261a;border-color:#245b36;color:#86efac}html[data-theme="dark"] .ai28-state.warn{background:#2b2413;border-color:#5c4a1f;color:#f5d77a}html[data-theme="dark"] .ai28-state.bad{background:#2b1619;border-color:#613039;color:#fda4af}html[data-theme="dark"] .ai28-state.info{background:#102a3f;border-color:#285375;color:#84caff}html[data-theme="dark"] .ai28-node.confirmed{background:#10261a;border-color:#245b36}html[data-theme="dark"] .ai28-handoff,html[data-theme="dark"] .ai28-manager-handoff{background:#102a3f;border-color:#285375;color:#84caff}
@media(max-width:1100px){.ai28-lineage{grid-template-columns:1fr 1fr}.ai28-gap-grid{grid-template-columns:1fr 1fr}.ai28-life-form{grid-template-columns:1fr 1fr}}@media(max-width:800px){.ai28-hero,.ai28-grid2,.ai28-compare{grid-template-columns:1fr}.ai28-lineage{grid-template-columns:1fr}.ai28-gap-grid{grid-template-columns:1fr}.ai28-life-form{grid-template-columns:1fr}.ai28-row{grid-template-columns:1fr}}
</style>
<style id="recovery-30-css">
/* RECOVERY 30 — Operating Context Graph */
.r30-card{background:var(--ui-surface,#fff);border:1px solid var(--ui-line,#e7e8eb);border-radius:16px;padding:18px;min-width:0}.r30-card h2{font-size:15px;margin:4px 0 8px}.r30-card p{font-size:11px;line-height:1.6;color:var(--ui-muted,#667085);margin:0}.r30-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:12px}.r30-head>div{min-width:0}.r30-kicker{font-size:8px;font-weight:950;letter-spacing:.1em;color:var(--ui-muted,#667085)}.r30-badge{display:inline-flex;align-items:center;border:1px solid var(--ui-line,#e7e8eb);border-radius:999px;padding:4px 7px;font-size:8px;font-weight:900;white-space:nowrap}.r30-badge.good{background:#ecfdf3;border-color:#abefc6;color:#067647}.r30-badge.warn{background:#fffaeb;border-color:#fedf89;color:#b54708}.r30-badge.bad{background:#fff1f3;border-color:#fda29b;color:#b42318}.r30-badge.info{background:#eff8ff;border-color:#b2ddff;color:#175cd3}.r30-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.r30-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.r30-stat{border:1px solid var(--ui-line,#e7e8eb);border-radius:12px;padding:11px;background:var(--ui-surface-2,#fafbfc);min-width:0}.r30-stat span{display:block;font-size:8px;color:var(--ui-muted,#667085);font-weight:800;letter-spacing:.05em}.r30-stat strong{display:block;font-size:18px;margin-top:4px}.r30-owner-list,.r30-risk-list,.r30-exp-list{display:grid;gap:7px}.r30-owner-row{display:grid;grid-template-columns:minmax(170px,1fr) minmax(120px,.65fr) minmax(140px,.8fr) minmax(160px,1fr) auto;gap:7px;align-items:center;border:1px solid var(--ui-line,#e7e8eb);border-radius:12px;padding:9px;background:var(--ui-surface,#fff);min-width:0}.r30-owner-copy{min-width:0}.r30-owner-copy b{display:block;font-size:10px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.r30-owner-copy small{font-size:8px;color:var(--ui-muted,#667085)}.r30-owner-row input,.r30-owner-row select,.r30-link-form input,.r30-link-form select,.r30-link-form textarea,.r30-exp-form input,.r30-exp-form select,.r30-exp-form textarea{width:100%;min-width:0;border:1px solid var(--ui-line,#dfe2e6);border-radius:9px;padding:7px 8px;background:var(--ui-surface-2,#fff);color:var(--ui-ink,#16181d);font:inherit;font-size:9px}.r30-owner-row button{min-height:30px!important;padding:5px 7px!important;font-size:8px!important}.r30-link-shell{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:12px}.r30-map{display:grid;gap:7px;max-height:560px;overflow:auto;padding-right:3px}.r30-map-row{display:grid;grid-template-columns:34px minmax(0,1fr) auto;gap:8px;align-items:start;border:1px solid var(--ui-line,#e7e8eb);border-radius:12px;padding:10px;background:var(--ui-surface,#fff)}.r30-map-row.selected{border-color:#98a2b3;box-shadow:0 0 0 1px #98a2b3 inset}.r30-map-no{width:28px;height:28px;border-radius:8px;background:var(--ui-soft,#eef1f4);display:grid;place-items:center;font-size:8px;font-weight:950}.r30-map-copy{min-width:0}.r30-map-copy b{font-size:10px}.r30-map-copy small{display:block;font-size:8px;line-height:1.45;color:var(--ui-muted,#667085);margin-top:3px;overflow-wrap:anywhere}.r30-tags{display:flex;gap:4px;flex-wrap:wrap;margin-top:5px}.r30-tag{font-size:7px;font-weight:850;border:1px solid var(--ui-line,#e7e8eb);border-radius:999px;padding:3px 5px;background:var(--ui-surface-2,#fafbfc);max-width:100%;overflow-wrap:anywhere}.r30-map-row button{min-height:28px!important;padding:4px 6px!important;font-size:8px!important}.r30-link-form{border:1px solid var(--ui-line,#e7e8eb);border-radius:12px;padding:12px;background:var(--ui-surface-2,#fafbfc)}.r30-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.r30-form-grid label{display:grid;gap:4px;font-size:8px;font-weight:850;color:var(--ui-muted,#667085)}.r30-form-grid .wide{grid-column:1/-1}.r30-actions{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-top:9px}.r30-actions button{min-height:31px!important;padding:5px 8px!important;font-size:9px!important}.r30-risk{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:8px;align-items:center;border:1px solid var(--ui-line,#e7e8eb);border-radius:11px;padding:9px;background:var(--ui-surface,#fff)}.r30-risk b{font-size:9px}.r30-risk span{font-size:8px;color:var(--ui-muted,#667085);line-height:1.45}.r30-risk code{font-size:7px;color:var(--ui-muted,#667085)}.r30-context-nudge{margin:12px 0;border:1px solid #b2ddff;border-left:3px solid #2e90fa;border-radius:12px;padding:12px;background:#f5fbff}.r30-context-nudge h2{font-size:12px;margin:4px 0 6px}.r30-context-nudge p{font-size:10px;line-height:1.55;color:#475467;margin:0}.r30-say{margin-top:8px;border-radius:9px;background:#fff;border:1px solid #d1e9ff;padding:9px;font-size:10px;line-height:1.55;color:#1849a9}.r30-diff-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.r30-diff-box{border:1px solid var(--ui-line,#e7e8eb);border-radius:12px;padding:11px;min-width:0}.r30-diff-row{font-size:9px;line-height:1.5;padding:5px 0;border-bottom:1px solid var(--ui-line,#eef0f2)}.r30-diff-row:last-child{border-bottom:0}.r30-exp-form{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}.r30-exp-form label{display:grid;gap:4px;font-size:8px;font-weight:850;color:var(--ui-muted,#667085)}.r30-exp-form .wide{grid-column:1/-1}.r30-exp-item{border:1px solid var(--ui-line,#e7e8eb);border-radius:11px;padding:10px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px}.r30-exp-item b{font-size:10px}.r30-exp-item span{display:block;color:var(--ui-muted,#667085);font-size:8px;line-height:1.5;margin-top:3px}.r30-today-card{margin-bottom:14px}.r30-empty{padding:12px;border:1px dashed var(--ui-line,#d0d5dd);border-radius:10px;color:var(--ui-muted,#667085);font-size:9px;line-height:1.55}.r30-divider{height:1px;background:var(--ui-line,#e7e8eb);margin:12px 0}
html[data-theme="dark"] .r30-badge.good{background:#10261a;border-color:#245b36;color:#86efac}html[data-theme="dark"] .r30-badge.warn{background:#2a2414;border-color:#514421;color:#f7d774}html[data-theme="dark"] .r30-badge.bad{background:#2b1619;border-color:#613039;color:#fda4af}html[data-theme="dark"] .r30-badge.info{background:#102a3f;border-color:#285375;color:#84caff}html[data-theme="dark"] .r30-context-nudge{background:#102331;border-color:#285375}html[data-theme="dark"] .r30-context-nudge p{color:var(--ui-muted)}html[data-theme="dark"] .r30-say{background:#111c26;border-color:#285375;color:#84caff}
@media(max-width:1100px){.r30-owner-row{grid-template-columns:minmax(150px,1fr) 1fr 1fr}.r30-owner-row>input:nth-of-type(2),.r30-owner-row>button{grid-column:auto}.r30-link-shell{grid-template-columns:1fr}.r30-grid.three{grid-template-columns:1fr 1fr}}
@media(max-width:760px){.r30-grid,.r30-grid.three,.r30-diff-grid,.r30-form-grid,.r30-exp-form{grid-template-columns:1fr}.r30-owner-row{grid-template-columns:1fr}.r30-form-grid .wide,.r30-exp-form .wide{grid-column:auto}.r30-risk{grid-template-columns:1fr}.r30-map{max-height:420px}}
</style>
<style id="recovery-34-ui-fix">
/* RECOVERY 34 · UI overlap / contrast / local sample image patch */
.quest-layout,.quest-learning-grid,.quest-chief-rail,.quest-detail,.weekly-review-grid,.system-health-list{min-width:0;align-items:start}
.quest-box,.chief-rail-card,.weekly-review-cell,.system-health-list>*{min-width:0;overflow:hidden;overflow-wrap:anywhere;word-break:keep-all}
.quest-box :where(p,li,strong,span),.chief-rail-card :where(p,li,strong,span,small),.system-health-list :where(p,span,small,strong,b),.weekly-review-cell :where(p,span,small,strong,b){overflow-wrap:anywhere;word-break:keep-all}
.quest-chief-rail{gap:12px}
.chief-rail-card{height:100%}
html[data-theme="dark"] .chief-rail-card,
html[data-theme="dark"] .quest-box,
html[data-theme="dark"] .weekly-review-cell,
html[data-theme="dark"] .weekly-review-grid>*,
html[data-theme="dark"] .weekly-review-banner,
html[data-theme="dark"] .weekly-review-summary,
html[data-theme="dark"] .weekly-review-status,
html[data-theme="dark"] .system-health-list>*{
  background:var(--ui-surface)!important;
  color:var(--ui-ink)!important;
  border-color:var(--ui-line)!important;
}
html[data-theme="dark"] .weekly-review-summary,
html[data-theme="dark"] .weekly-review-banner,
html[data-theme="dark"] .system-health-list>*:is(.safe,.notice,.warning){background:var(--ui-surface-2)!important}
html[data-theme="dark"] .quest-box :where(p,li,small,span),
html[data-theme="dark"] .chief-rail-card :where(p,li,small,span),
html[data-theme="dark"] .weekly-review-cell :where(p,li,small,span),
html[data-theme="dark"] .system-health-list :where(p,li,small,span){color:var(--ui-muted)!important}
html[data-theme="dark"] .quest-box :where(h2,h3,h4,strong,b),
html[data-theme="dark"] .chief-rail-card :where(h2,h3,h4,strong,b),
html[data-theme="dark"] .weekly-review-cell :where(h2,h3,h4,strong,b),
html[data-theme="dark"] .system-health-list :where(h2,h3,h4,strong,b){color:var(--ui-ink)!important}
html[data-theme="dark"] .section-kicker,
html[data-theme="dark"] .lens-kicker{color:var(--ui-muted)!important}
html[data-theme="dark"] .system-health-list button,
html[data-theme="dark"] .weekly-review-cell button,
html[data-theme="dark"] .chief-rail-card button{background:var(--ui-surface-2)!important;color:var(--ui-ink)!important;border-color:var(--ui-line)!important}
html[data-theme="dark"] .system-health-list .primary,
html[data-theme="dark"] .weekly-review-cell .primary,
html[data-theme="dark"] .chief-rail-card .primary{background:var(--ui-accent)!important;color:var(--ui-accent-ink)!important;border-color:var(--ui-accent)!important}
html[data-theme="dark"] .system-health-list .state-badge,
html[data-theme="dark"] .weekly-review-cell .state-badge,
html[data-theme="dark"] .chief-rail-card .state-badge{background:var(--ui-soft)!important;color:#d7dde5!important;border-color:var(--ui-line)!important}
.r29-sample img{background:#0f1216}
.r29-sample-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.r29-sample-actions button{min-height:34px!important}
.r29-image-modal{width:min(960px,calc(100vw - 32px));padding:0;border:1px solid var(--ui-line);border-radius:18px;overflow:hidden;background:var(--ui-surface);color:var(--ui-ink);box-shadow:0 30px 70px rgba(0,0,0,.35)}
.r29-image-modal::backdrop{background:rgba(7,10,15,.72)}
.r29-image-modal-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;padding:16px 18px;border-bottom:1px solid var(--ui-line);background:var(--ui-surface-2)}
.r29-image-modal-head h3{margin:0;font-size:18px;line-height:1.3}
.r29-image-modal-head p{margin:5px 0 0;font-size:11px;line-height:1.55;color:var(--ui-muted)}
.r29-image-modal-body{padding:18px}
.r29-image-modal figure{margin:0;display:grid;gap:12px}
.r29-image-modal img{width:100%;height:auto;border-radius:14px;border:1px solid var(--ui-line);background:#10151a;display:block}
.r29-image-modal figcaption{font-size:11px;line-height:1.6;color:var(--ui-muted)}
.r29-image-close{white-space:nowrap}
@media(max-width:900px){.quest-chief-rail{grid-template-columns:1fr}.r29-image-modal{width:calc(100vw - 20px)}}
</style>
<style id="recovery-35-workflow-review-style">
.r35-shell{display:grid;gap:18px;margin-top:18px}
.r35-card{border:1px solid var(--ui-line);background:var(--ui-surface);border-radius:18px;padding:18px;box-shadow:0 1px 2px rgba(16,24,40,.04)}
.r35-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:14px}
.r35-head h2{margin:3px 0 0;font-size:22px;line-height:1.25}
.r35-head p{margin:8px 0 0;font-size:12px;line-height:1.6;color:var(--ui-muted);max-width:72ch}
.r35-kicker{font-size:11px;font-weight:900;letter-spacing:.12em;color:var(--ui-muted)}
.r35-badge{display:inline-flex;align-items:center;gap:6px;padding:7px 10px;border-radius:999px;border:1px solid var(--ui-line);font-size:11px;font-weight:800;background:var(--ui-soft);color:var(--ui-ink)}
.r35-badge.good{background:#ecfdf3;border-color:#b7e2c4;color:#166534}
.r35-badge.warn{background:#fff7ed;border-color:#fed7aa;color:#9a3412}
.r35-grid-4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.r35-grid-3{display:grid;grid-template-columns:1.2fr .9fr .9fr;gap:16px}
.r35-grid-2{display:grid;grid-template-columns:1.15fr .85fr;gap:16px}
.r35-mini{border:1px solid var(--ui-line);border-radius:16px;padding:16px;background:var(--ui-surface-2);min-width:0}
.r35-mini h3,.r35-review-item h3{margin:0 0 8px;font-size:16px;line-height:1.35}
.r35-mini p,.r35-review-item p{margin:0;font-size:12px;line-height:1.6;color:var(--ui-muted)}
.r35-mini ul{margin:10px 0 0 16px;padding:0;display:grid;gap:6px;color:var(--ui-muted);font-size:12px;line-height:1.55}
.r35-number{display:block;font-size:26px;font-weight:900;line-height:1.1;margin:2px 0 4px;color:var(--ui-ink)}
.r35-label{display:block;font-size:11px;font-weight:800;letter-spacing:.08em;color:var(--ui-muted);text-transform:uppercase}
.r35-sub{display:block;font-size:11px;line-height:1.5;color:var(--ui-muted)}
.r35-checks{display:grid;gap:10px}
.r35-check{display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:flex-start;border:1px solid var(--ui-line);border-radius:14px;padding:12px;background:var(--ui-surface-2)}
.r35-check input{margin-top:3px}
.r35-check strong{display:block;font-size:13px;line-height:1.45;color:var(--ui-ink)}
.r35-check span{display:block;font-size:11px;line-height:1.55;color:var(--ui-muted)}
.r35-log-list{display:grid;gap:10px}
.r35-log-item{border:1px solid var(--ui-line);border-radius:14px;padding:14px;background:var(--ui-surface-2)}
.r35-log-item b{display:block;font-size:13px;line-height:1.45;margin-bottom:6px}
.r35-log-item span{display:block;font-size:11px;line-height:1.6;color:var(--ui-muted)}
.r35-log-meta{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:6px}
.r35-field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.r35-field-grid .full{grid-column:1/-1}
.r35-field-grid label{display:grid;gap:6px;font-size:11px;font-weight:800;color:var(--ui-muted);letter-spacing:.02em}
.r35-field-grid input,.r35-field-grid select,.r35-field-grid textarea{width:100%;border-radius:12px;border:1px solid var(--ui-line);background:var(--ui-surface);color:var(--ui-ink);padding:10px 12px;font:inherit}
.r35-field-grid textarea{min-height:88px;resize:vertical}
.r35-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}
.r35-actions button{min-height:36px!important;padding:8px 12px!important}
.r35-note{font-size:11px;line-height:1.6;color:var(--ui-muted)}
.r35-empty{border:1px dashed var(--ui-line);border-radius:14px;padding:16px;background:var(--ui-surface-2);font-size:12px;line-height:1.6;color:var(--ui-muted)}
.r35-timing{display:grid;gap:8px}
.r35-timing .r35-window{font-size:13px;font-weight:900;color:var(--ui-ink)}
.r35-review-item{border:1px solid var(--ui-line);border-radius:16px;padding:16px;background:var(--ui-surface-2)}
.r35-divider{height:1px;background:var(--ui-line);margin:4px 0}
html[data-theme="dark"] .r35-badge.good{background:#10261a;border-color:#245b36;color:#a7f3d0}
html[data-theme="dark"] .r35-badge.warn{background:#2a1c10;border-color:#7c2d12;color:#fdba74}
@media(max-width:1180px){.r35-grid-4{grid-template-columns:repeat(2,minmax(0,1fr))}.r35-grid-3{grid-template-columns:1fr}.r35-grid-2{grid-template-columns:1fr}}
@media(max-width:700px){.r35-grid-4,.r35-field-grid{grid-template-columns:1fr}.r35-head{flex-direction:column}.r35-actions{flex-direction:column}}
</style>
<style id="recovery-36-work-report-style">
.r36-shell{display:grid;gap:18px}.r36-hero{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.65fr);gap:16px;margin-bottom:18px}.r36-panel{border:1px solid var(--ui-line);border-radius:18px;background:var(--ui-surface);padding:18px;min-width:0;box-shadow:0 1px 2px rgba(16,24,40,.04)}.r36-hero-main{background:linear-gradient(135deg,var(--ui-surface) 0%,var(--ui-surface-2) 100%)}.r36-kicker{font-size:10px;font-weight:950;letter-spacing:.12em;color:var(--ui-muted);text-transform:uppercase}.r36-hero h1,.r36-panel h2{margin:5px 0 7px;color:var(--ui-ink);letter-spacing:-.035em}.r36-hero h1{font-size:30px}.r36-panel h2{font-size:20px}.r36-panel p,.r36-hero p{font-size:12px;line-height:1.65;color:var(--ui-muted);margin:0}.r36-rule{display:grid;gap:8px;margin-top:12px}.r36-rule div{border:1px solid var(--ui-line);border-radius:12px;padding:10px 12px;background:var(--ui-surface-2)}.r36-rule b{font-size:11px;color:var(--ui-ink)}.r36-rule span{display:block;margin-top:3px;font-size:10px;line-height:1.5;color:var(--ui-muted)}
.r36-tabs{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:14px}.r36-tabs button{min-height:35px!important;padding:7px 12px!important}.r36-tabs button.active{background:var(--ui-accent)!important;color:var(--ui-accent-ink)!important;border-color:var(--ui-accent)!important}.r36-mode{display:none}.r36-mode.active{display:block}.r36-grid{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(320px,.88fr);gap:16px}.r36-form{display:grid;gap:11px}.r36-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.r36-form-grid .wide{grid-column:1/-1}.r36-form label{display:grid;gap:5px;font-size:10px;font-weight:850;color:var(--ui-muted)}.r36-form input,.r36-form textarea,.r36-form select{width:100%;min-width:0;border:1px solid var(--ui-line);border-radius:11px;background:var(--ui-surface-2);color:var(--ui-ink);padding:10px 11px;font:inherit}.r36-form textarea{min-height:90px;resize:vertical;line-height:1.55}.r36-actions{display:flex;gap:7px;align-items:center;flex-wrap:wrap}.r36-status{font-size:10px;color:var(--ui-muted);margin-left:auto}.r36-preview{border:1px solid var(--ui-line);border-radius:16px;background:var(--ui-surface-2);padding:16px;min-height:420px}.r36-preview-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;padding-bottom:12px;border-bottom:1px solid var(--ui-line);margin-bottom:12px}.r36-preview-head strong{font-size:16px;color:var(--ui-ink)}.r36-state{display:inline-flex;padding:4px 8px;border-radius:999px;border:1px solid var(--ui-line);background:var(--ui-soft);font-size:9px;font-weight:900;color:var(--ui-muted);white-space:nowrap}.r36-state.confirmed{background:#ecfdf3;border-color:#a7d8b7;color:#166534}.r36-section{padding:10px 0;border-bottom:1px solid var(--ui-line)}.r36-section:last-child{border-bottom:0}.r36-section small{display:block;font-size:9px;font-weight:900;letter-spacing:.08em;color:var(--ui-muted);margin-bottom:4px;text-transform:uppercase}.r36-section div{white-space:pre-wrap;font-size:11px;line-height:1.62;color:var(--ui-ink);overflow-wrap:anywhere}.r36-context{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-bottom:14px}.r36-context-card{border:1px solid var(--ui-line);border-radius:13px;background:var(--ui-surface-2);padding:11px;min-width:0}.r36-context-card b{display:block;font-size:18px;color:var(--ui-ink)}.r36-context-card span{font-size:9px;line-height:1.4;color:var(--ui-muted)}.r36-history{display:grid;gap:9px}.r36-history-item{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:start;border:1px solid var(--ui-line);border-radius:13px;padding:12px;background:var(--ui-surface-2)}.r36-history-item b{font-size:11px;color:var(--ui-ink)}.r36-history-item span{display:block;font-size:9px;line-height:1.5;color:var(--ui-muted);margin-top:3px}.r36-history-actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}.r36-history-actions button{min-height:29px!important;padding:5px 7px!important;font-size:9px!important}.r36-empty{border:1px dashed var(--ui-line);border-radius:13px;background:var(--ui-surface-2);padding:18px;text-align:center;font-size:11px;line-height:1.6;color:var(--ui-muted)}.r36-guide{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:9px}.r36-guide>div{border:1px solid var(--ui-line);border-radius:13px;background:var(--ui-surface-2);padding:11px}.r36-guide b{display:block;font-size:10px;color:var(--ui-ink);margin-bottom:4px}.r36-guide span{font-size:9px;line-height:1.5;color:var(--ui-muted)}.r36-source-list{display:grid;gap:6px;margin-top:9px}.r36-source{font-size:9px;line-height:1.5;border:1px solid var(--ui-line);background:var(--ui-surface-2);border-radius:10px;padding:7px 9px;color:var(--ui-muted)}
html[data-theme="dark"] .r36-state.confirmed{background:#10261a;border-color:#245b36;color:#a7f3d0}
@media(max-width:1100px){.r36-context,.r36-guide{grid-template-columns:repeat(3,minmax(0,1fr))}.r36-grid{grid-template-columns:1fr}.r36-hero{grid-template-columns:1fr}}
@media(max-width:680px){.r36-context,.r36-guide,.r36-form-grid{grid-template-columns:1fr}.r36-form-grid .wide{grid-column:auto}.r36-history-item{grid-template-columns:1fr}.r36-history-actions{justify-content:flex-start}.r36-status{width:100%;margin-left:0}}
</style>
<style id="recovery-37-report-rhythm-css">
.r37-shell{display:grid;gap:16px;margin:0 0 18px}.r37-card{border:1px solid var(--ui-line);background:var(--ui-surface);border-radius:18px;padding:18px;min-width:0}.r37-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;margin-bottom:14px}.r37-head h2{margin:3px 0 4px;font-size:20px;letter-spacing:-.025em}.r37-head p{margin:0;color:var(--ui-muted);font-size:11px;line-height:1.6;max-width:760px}.r37-kicker{font-size:9px;font-weight:950;letter-spacing:.11em;color:var(--ui-muted)}.r37-state{display:inline-flex;align-items:center;padding:5px 8px;border:1px solid var(--ui-line);border-radius:999px;background:var(--ui-soft);color:var(--ui-muted);font-size:9px;font-weight:900;white-space:nowrap}.r37-state.ready{background:#ecfdf3;border-color:#bbf7d0;color:#166534}.r37-state.due{background:#fff7ed;border-color:#fed7aa;color:#9a3412}.r37-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(300px,.95fr);gap:14px}.r37-settings{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.r37-settings label{display:grid;gap:5px;font-size:10px;font-weight:850;color:var(--ui-muted)}.r37-settings input,.r37-settings select{width:100%;min-width:0;padding:9px 10px;border:1px solid var(--ui-line);border-radius:10px;background:var(--ui-surface-2);color:var(--ui-ink)}.r37-toggle{display:flex!important;align-items:center;gap:8px!important;grid-column:1/-1}.r37-toggle input{width:auto}.r37-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.r37-actions button{min-height:34px!important;padding:7px 10px!important}.r37-calendar{display:grid;gap:7px}.r37-cal-row{display:grid;grid-template-columns:92px minmax(0,1fr) auto;gap:9px;align-items:start;padding:10px;border:1px solid var(--ui-line);border-radius:11px;background:var(--ui-surface-2);min-width:0}.r37-cal-row b{font-size:10px}.r37-cal-row span{font-size:9px;color:var(--ui-muted);line-height:1.45;overflow-wrap:anywhere}.r37-cal-type{font-size:8px;font-weight:900;padding:4px 6px;border:1px solid var(--ui-line);border-radius:999px;text-align:center;background:var(--ui-surface);color:var(--ui-muted)}.r37-readiness{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.r37-ready-card{border:1px solid var(--ui-line);border-radius:13px;background:var(--ui-surface-2);padding:12px}.r37-ready-card small{display:block;font-size:8px;font-weight:900;letter-spacing:.09em;color:var(--ui-muted)}.r37-ready-card b{display:block;font-size:13px;margin:5px 0}.r37-ready-card p{margin:0;font-size:9px;line-height:1.5;color:var(--ui-muted)}
.r37-views{margin:0 0 18px}.r37-view-tabs{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:10px}.r37-view-tabs button{min-height:32px!important;padding:6px 10px!important;font-size:10px!important}.r37-view-tabs button.active{background:var(--ui-accent)!important;color:var(--ui-accent-ink)!important;border-color:var(--ui-accent)!important}.r37-view-output{border:1px solid var(--ui-line);border-radius:14px;background:var(--ui-surface-2);padding:14px;min-height:220px;white-space:pre-wrap;font-size:11px;line-height:1.7;color:var(--ui-ink);overflow-wrap:anywhere}.r37-view-meta{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:10px}.r37-view-meta b{font-size:11px}.r37-note{padding:10px 12px;border:1px solid var(--ui-line);border-radius:11px;background:var(--ui-surface-2);font-size:9px;line-height:1.55;color:var(--ui-muted);margin-top:10px}
html[data-theme="dark"] .r37-state.ready{background:#10261a;border-color:#245b36;color:#86efac}html[data-theme="dark"] .r37-state.due{background:#2b2313;border-color:#6b521c;color:#f2ce7e}
@media(max-width:900px){.r37-grid{grid-template-columns:1fr}.r37-settings,.r37-readiness{grid-template-columns:1fr}.r37-toggle{grid-column:auto}.r37-cal-row{grid-template-columns:80px minmax(0,1fr)}}
</style>
<!-- RECOVERY_41: speed/simplicity workflow reference thumbnail replaced with attached Starbucks Customer Journey visual; image modal reuses card img source -->
<style>
/* RECOVERY 42 — editable workflow sample-map library */
.r42-sample-library{margin-bottom:16px;border:1px solid var(--ui-line,#e7e8eb);border-radius:18px;background:var(--ui-surface,#fff);padding:16px}
.r42-library-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;margin-bottom:14px}.r42-library-head h2{font-size:17px;margin:4px 0 6px}.r42-library-head p{font-size:10px;line-height:1.6;color:var(--ui-muted,#667085);margin:0;max-width:720px}.r42-library-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.r42-sample-name{font-size:10px;font-weight:850;color:var(--ui-muted,#667085);margin:-1px 0 8px}.r42-sample-tools{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;padding-top:8px;border-top:1px solid var(--ui-line,#edf0f2)}.r42-sample-tools button{min-height:30px!important;padding:5px 8px!important;font-size:9px!important}.r42-sample-tools .danger{color:#b42318;border-color:#f2c7c2;background:#fff5f4}.r42-empty{grid-column:1/-1;padding:28px;border:1px dashed var(--ui-line,#dfe2e6);border-radius:14px;text-align:center;color:var(--ui-muted,#667085);font-size:11px}.r42-editor-modal{width:min(760px,calc(100vw - 28px));padding:0;border:1px solid var(--ui-line,#e7e8eb);border-radius:18px;background:var(--ui-surface,#fff);color:var(--ui-ink,#16181d);box-shadow:0 30px 80px rgba(0,0,0,.34)}.r42-editor-modal::backdrop{background:rgba(7,10,15,.72)}.r42-editor-form{padding:0}.r42-editor-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;padding:16px 18px;border-bottom:1px solid var(--ui-line,#e7e8eb);background:var(--ui-surface-2,#f8f9fa)}.r42-editor-head h3{font-size:18px;margin:4px 0}.r42-editor-head p{font-size:10px;color:var(--ui-muted,#667085);margin:0}.r42-editor-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:18px}.r42-editor-grid label{display:grid;gap:6px;font-size:10px;font-weight:800;color:var(--ui-muted,#667085)}.r42-editor-grid label.wide,.r42-image-editor-preview.wide{grid-column:1/-1}.r42-editor-grid input,.r42-editor-grid textarea,.r42-editor-grid select{width:100%;border:1px solid var(--ui-line,#dfe2e6);border-radius:10px;background:var(--ui-surface,#fff);color:var(--ui-ink,#16181d);padding:9px 10px;font:inherit;font-size:11px}.r42-image-editor-preview{display:grid;grid-template-columns:170px 1fr;gap:12px;align-items:center;border:1px solid var(--ui-line,#e7e8eb);border-radius:12px;padding:10px;background:var(--ui-surface-2,#f8f9fa)}.r42-image-editor-preview img{width:170px;height:96px;object-fit:cover;border-radius:8px;border:1px solid var(--ui-line,#e7e8eb);background:#111}.r42-image-editor-preview div{display:grid;gap:5px;font-size:10px}.r42-image-editor-preview span{color:var(--ui-muted,#667085);line-height:1.5}.r42-editor-actions{display:flex;justify-content:flex-end;gap:8px;padding:14px 18px;border-top:1px solid var(--ui-line,#e7e8eb)}
@media(max-width:760px){.r42-library-head{flex-direction:column}.r42-library-actions{justify-content:flex-start}.r42-editor-grid{grid-template-columns:1fr}.r42-editor-grid label.wide,.r42-image-editor-preview.wide{grid-column:auto}.r42-image-editor-preview{grid-template-columns:1fr}.r42-image-editor-preview img{width:100%;height:160px}}
</style><!-- RECOVERY_42: In-N-Out sample restored + editable sample-map library CRUD -->
<style id="recovery-44-server-search-css">
.lo-r44-server-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 14px 6px;border-top:1px solid var(--ui-line,#e7e8eb);margin-top:4px}
.lo-r44-server-head b{font-size:10px;letter-spacing:.06em}.lo-r44-server-state{font-size:9px;color:var(--ui-muted,#667085)}
.lo-r44-truth{display:inline-flex;align-items:center;border-radius:999px;padding:3px 6px;font-size:8px;font-weight:900;letter-spacing:.04em;background:#f2f4f7;color:#475467}
.lo-r44-truth.confirmed{background:#ecfdf3;color:#027a48}.lo-r44-truth.draft{background:#fff7ed;color:#b54708}.lo-r44-truth.candidate{background:#f2f4f7;color:#475467}
.lo-r44-truth.quest_evidence{background:#eef4ff;color:#3538cd}.lo-r44-truth.addon_evidence{background:#f4ebff;color:#6941c6}
.quest-server-link{margin-top:9px;padding:10px;border:1px solid var(--ui-line,#e7e8eb);border-radius:10px;background:var(--ui-surface-2,#fafbfc)}
.quest-server-link-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:7px}
.quest-server-link-head b{font-size:10px}.quest-server-link-head span{font-size:8px;color:var(--ui-muted,#667085)}
.quest-server-link-row{display:grid;grid-template-columns:1fr auto;gap:7px}.quest-server-link select{width:100%;min-width:0;border:1px solid var(--ui-line,#dfe2e6);border-radius:8px;padding:7px;background:var(--ui-surface,#fff);color:var(--ui-ink,#16181d);font-size:9px}
.quest-server-link-status{font-size:8px;color:var(--ui-muted,#667085);margin-top:6px;line-height:1.45}
@media(max-width:620px){.quest-server-link-row{grid-template-columns:1fr}}
</style>
<style id="recovery-45-functional-css">
.setup-list .setup-item{display:grid!important;grid-template-columns:minmax(0,1fr) auto!important;gap:8px!important;align-items:center!important;padding:8px!important}
.setup-item-main{display:grid;grid-template-columns:18px 18px minmax(0,1fr);gap:7px;align-items:start;cursor:pointer;min-width:0}
.setup-native-check{width:16px;height:16px;margin:1px 0 0;accent-color:#16181d;cursor:pointer}
.setup-native-check:disabled{cursor:not-allowed;opacity:.62}
.setup-item-main .setup-check{pointer-events:none}
.setup-open-btn{min-height:30px!important;padding:5px 8px!important;font-size:9px!important;white-space:nowrap}
.setup-item.auto-done .setup-source{color:#027a48;font-weight:750}
.setup-storage-status[data-storage-tone="server"]{background:#ecfdf3;color:#027a48}
.setup-storage-status[data-storage-tone="syncing"]{background:#eef4ff;color:#3538cd}
.setup-storage-status[data-storage-tone="conflict"],.setup-storage-status[data-storage-tone="error"]{background:#fff1f3;color:#c01048}
.lo-r45-detail-backdrop{position:fixed;inset:0;background:rgba(15,23,42,.46);z-index:9998;display:none;align-items:center;justify-content:center;padding:18px}
.lo-r45-detail-backdrop.open{display:flex}
.lo-r45-detail{width:min(760px,96vw);max-height:86vh;overflow:auto;background:var(--ui-surface,#fff);color:var(--ui-ink,#16181d);border:1px solid var(--ui-line,#e7e8eb);border-radius:18px;box-shadow:0 28px 80px rgba(15,23,42,.28)}
.lo-r45-detail-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;padding:18px;border-bottom:1px solid var(--ui-line,#e7e8eb)}
.lo-r45-detail-head h3{margin:3px 0 0;font-size:17px}.lo-r45-detail-body{padding:18px;display:grid;gap:12px}
.lo-r45-meta{display:flex;gap:6px;flex-wrap:wrap}.lo-r45-meta span{border:1px solid var(--ui-line,#e7e8eb);border-radius:999px;padding:4px 7px;font-size:9px}
.lo-r45-fields{display:grid;gap:7px}.lo-r45-field{display:grid;grid-template-columns:140px minmax(0,1fr);gap:10px;border-bottom:1px solid var(--ui-line,#edf0f2);padding:8px 0}
.lo-r45-field:last-child{border-bottom:0}.lo-r45-field b{font-size:10px;color:var(--ui-muted,#667085)}.lo-r45-field div{font-size:10px;line-height:1.55;overflow-wrap:anywhere}
.lo-r45-field pre{white-space:pre-wrap;word-break:break-word;margin:0;font:9px/1.55 ui-monospace,SFMono-Regular,Menlo,monospace;max-height:180px;overflow:auto;background:var(--ui-surface-2,#f8fafc);padding:8px;border-radius:8px}
.lo-r45-actions{display:flex;gap:7px;flex-wrap:wrap;padding-top:4px}
.lo-r45-review{border:1px solid #d9e2ee;border-radius:12px;padding:12px;background:var(--ui-surface-2,#fafbfc)}
.lo-r45-review textarea{width:100%;box-sizing:border-box;border:1px solid var(--ui-line,#dfe2e6);border-radius:8px;background:var(--ui-surface,#fff);color:inherit;padding:8px;font:inherit;font-size:10px}
.lo-r45-review-status{font-size:9px;color:var(--ui-muted,#667085);margin-top:7px}
.lo-r44-truth.reviewed_evidence{background:#ecfdf3;color:#027a48}
@media(max-width:620px){.lo-r45-field{grid-template-columns:1fr}.setup-list .setup-item{grid-template-columns:1fr!important}.setup-open-btn{justify-self:start;margin-left:43px}}
</style>
<style id="recovery-46-artifact-server-css">
.artifact-storage-status[data-storage-tone="server"]{background:#ecfdf3;color:#027a48}
.artifact-storage-status[data-storage-tone="syncing"]{background:#eef4ff;color:#3538cd}
.artifact-storage-status[data-storage-tone="error"],.artifact-storage-status[data-storage-tone="conflict"]{background:#fff1f3;color:#c01048}
.backend-contract-note{line-height:1.55}
</style>
<style id="recovery-47-ux-priority-css">
/* Recovery 47 — priority, consolidation, progressive disclosure */
.r47-flow{display:grid;gap:16px}
.r47-auth-shell{border:1px solid #ccd8d0;border-radius:18px;padding:14px;background:linear-gradient(180deg,#f6faf7 0%,#fff 100%);box-shadow:0 10px 28px rgba(28,47,37,.06)}
.r47-auth-shell.needs-login{border-color:#b7c9bd;background:linear-gradient(180deg,#eef7f1 0%,#fff 100%)}
.r47-auth-shell.personalized{border-color:#b7dac6}
.r47-stage-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px;margin-bottom:10px}
.r47-stage-kicker{font-size:9px;font-weight:950;letter-spacing:.12em;color:#416c56}
.r47-stage-head h2{margin:3px 0 4px;font-size:18px}
.r47-stage-head p{margin:0;color:var(--ui-muted,#667085);font-size:10px;line-height:1.55}
.r47-auth-state{display:inline-flex;align-items:center;gap:6px;border:1px solid #d0d5dd;border-radius:999px;padding:5px 8px;background:#fff;font-size:9px;font-weight:900;white-space:nowrap}
.r47-auth-state.active{background:#ecfdf3;color:#027a48;border-color:#abefc6}
.r47-auth-state.warn{background:#fff7ed;color:#b54708;border-color:#fed7aa}
.r47-auth-settings{margin-top:10px;border-top:1px solid #e4e9e5;padding-top:8px}
.r47-auth-settings>summary{cursor:pointer;font-size:10px;font-weight:850;color:#59645e;list-style:none}
.r47-auth-settings>summary::-webkit-details-marker{display:none}
.r47-auth-settings>summary:after{content:" +";font-weight:900}
.r47-auth-settings[open]>summary:after{content:" −"}
.r47-auth-settings-body{display:grid;gap:10px;margin-top:10px}
.r47-path{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}
.r47-path-step{border:1px solid var(--ui-line,#e7e8eb);border-radius:12px;padding:10px;background:var(--ui-surface,#fff);min-width:0}
.r47-path-step b{display:block;font-size:10px;margin-bottom:3px}.r47-path-step span{font-size:9px;color:var(--ui-muted,#667085);line-height:1.35}
.r47-path-step.done{border-color:#abefc6;background:#ecfdf3}.r47-path-step.current{border-color:#c7d7ff;background:#f3f6ff}
.r47-primary-card{border:1px solid #dce4df;border-radius:16px;background:var(--ui-surface,#fff);padding:16px}
.r47-primary-card .section-kicker{margin-bottom:4px}
.r47-cta-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
.r47-cta-row button{min-height:34px}
.r47-disclosure{border:1px solid var(--ui-line,#e7e8eb);border-radius:14px;background:var(--ui-surface,#fff);overflow:hidden}
.r47-disclosure>summary{cursor:pointer;list-style:none;padding:13px 15px;font-size:11px;font-weight:900;display:flex;align-items:center;justify-content:space-between;gap:12px}
.r47-disclosure>summary::-webkit-details-marker{display:none}
.r47-disclosure>summary:after{content:"보기";font-size:9px;color:var(--ui-muted,#667085);font-weight:800}
.r47-disclosure[open]>summary:after{content:"접기"}
.r47-disclosure-body{display:grid;gap:12px;padding:0 12px 12px}
.r47-disclosure-body>.card,.r47-disclosure-body>.r22-grid,.r47-disclosure-body>section{margin:0!important}
.r47-quest-checkpoint{border:1px solid #dfe6e1;border-radius:14px;padding:13px 15px;background:#f8fbf9;margin-bottom:14px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center}
.r47-quest-checkpoint h3{margin:2px 0 4px;font-size:14px}.r47-quest-checkpoint p{margin:0;font-size:9px;color:#667085}
.r47-mini-progress{height:6px;border-radius:999px;background:#e7ece9;overflow:hidden;margin-top:7px}.r47-mini-progress span{display:block;height:100%;width:0;background:#416c56;border-radius:inherit}
.r47-today-personalization{border:1px solid var(--ui-line,#e7e8eb);border-radius:14px;padding:12px 14px;background:var(--ui-surface,#fff);margin-bottom:14px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.r47-today-personalization strong{display:block;font-size:11px}.r47-today-personalization span{font-size:9px;color:var(--ui-muted,#667085)}
.r47-top-account{white-space:nowrap}
.r47-section-divider{display:flex;align-items:center;gap:10px;margin:4px 0 -4px;color:#59645e}
.r47-section-divider:after{content:"";height:1px;background:var(--ui-line,#e7e8eb);flex:1}.r47-section-divider b{font-size:9px;letter-spacing:.08em}
.r47-secondary-guidance .r21-fastpath[data-r21-path="DAY30"],.r47-secondary-guidance [data-r21-go-quest]{display:none!important}
.r47-review-scale>.r47-disclosure-body,.r47-advanced>.r47-disclosure-body{padding-top:2px}
.runtime-mode-card.r47-auth-card{margin:0!important;box-shadow:none!important;border-color:#e2e8e4!important}
.r47-auth-card .runtime-mode-head{margin-bottom:8px}
.r47-auth-card .first-use,.r47-auth-card .personal-home{margin:0!important}
.r47-context-focus{border-color:#cad7ff!important;box-shadow:0 8px 22px rgba(53,56,205,.05)}
.r47-context-focus .section-kicker:before{content:"2 · ";color:#3538cd}
.r47-setup-focus .section-kicker:before{content:"4 · ";color:#416c56}
.r47-personalized-focus .section-kicker:before{content:"3 · ";color:#416c56}
.r47-quest-core{display:grid;gap:14px}
.r47-quest-core>.card,.r47-quest-core>.grid,.r47-quest-core>.artifact-shell{margin:0!important}
.r47-status-note{font-size:9px;line-height:1.5;color:var(--ui-muted,#667085);margin-top:7px}
html[data-theme="dark"] .r47-auth-shell,html[data-theme="dark"] .r47-quest-checkpoint{background:var(--ui-surface,#151a20);border-color:var(--ui-line,#303943)}
html[data-theme="dark"] .r47-path-step.done{background:#14271d}html[data-theme="dark"] .r47-path-step.current{background:#172033}
@media(max-width:900px){.r47-path{grid-template-columns:1fr 1fr}.r47-stage-head,.r47-today-personalization{align-items:flex-start;flex-direction:column}.r47-quest-checkpoint{grid-template-columns:1fr}}
@media(max-width:560px){.r47-path{grid-template-columns:1fr}.r47-auth-shell{padding:10px}.r47-disclosure>summary{padding:11px}}
</style>
<style id="recovery-48-header-section-consolidation-css">
/* Header: exactly three visible controls */
.topbar{min-height:58px!important;justify-content:flex-end!important;padding:8px 24px!important}
.topbar-title{display:none!important}
.topbar-actions{width:100%;display:flex!important;justify-content:flex-end!important;align-items:center!important;gap:8px!important;flex-wrap:nowrap!important}
.topbar-actions>button{white-space:nowrap}
.topbar-actions [data-r47-top-account],.topbar-actions [data-r48-account]{
  order:1!important;background:#fff!important;border:1px solid #dfe3e6!important;color:#27352d!important
}
.topbar-actions [data-showcase-demo]{order:2!important}
.topbar-actions [data-lo-search-open]{order:3!important;min-width:auto!important;justify-content:center!important}
.topbar-actions [data-lo-search-open] .lo-search-kbd{display:none!important}

/* One hierarchy, fewer visible panels */
.r48-flow{display:grid;gap:16px}
.r48-concept{border:1px solid var(--ui-line,#e5e8e6);border-radius:18px;background:var(--ui-surface,#fff);padding:16px;box-shadow:0 8px 22px rgba(25,39,31,.035)}
.r48-concept-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:12px}
.r48-concept-kicker{font-size:9px;font-weight:950;letter-spacing:.1em;color:#416c56}
.r48-concept-head h2{font-size:18px;margin:3px 0 4px}
.r48-concept-head p{font-size:10px;line-height:1.55;color:var(--ui-muted,#667085);margin:0;max-width:780px}
.r48-concept-body{display:grid;gap:12px}
.r48-concept-body>.card,.r48-concept-body>section,.r48-concept-body>.r22-grid,.r48-concept-body>.r22-completion{margin:0!important}
.r48-principle{border:1px solid #dfe7e1;border-radius:14px;padding:12px 14px;background:#f8fbf9;display:flex;align-items:center;justify-content:space-between;gap:12px}
.r48-principle b{font-size:11px}.r48-principle span{font-size:9px;color:var(--ui-muted,#667085);line-height:1.5}
.r48-principle-copy{min-width:0}
.r48-primary-next{border-color:#c8d9ce;background:linear-gradient(180deg,#f6faf7 0%,var(--ui-surface,#fff) 100%)}
.r48-reference{border:1px solid var(--ui-line,#e5e8e6);border-radius:16px;background:var(--ui-surface,#fff);overflow:hidden}
.r48-reference>summary{list-style:none;cursor:pointer;padding:13px 15px;display:flex;justify-content:space-between;gap:12px;font-size:11px;font-weight:900}
.r48-reference>summary::-webkit-details-marker{display:none}
.r48-reference>summary:after{content:"필요할 때 열기";font-size:9px;color:var(--ui-muted,#667085);font-weight:750}
.r48-reference[open]>summary:after{content:"접기"}
.r48-reference-body{display:grid;gap:12px;padding:0 12px 12px}
.r48-reference-body>.card,.r48-reference-body>.grid,.r48-reference-body>section,.r48-reference-body>details{margin:0!important}
.r48-compact-status{font-size:9px;color:var(--ui-muted,#667085);padding:8px 10px;border-radius:10px;background:var(--ui-surface-2,#f7f8fa)}
.r48-quest-practice{display:grid;gap:12px}
.r48-quest-practice>.phase-grid,.r48-quest-practice>section{margin:0!important}
.r48-quest-resources>.r48-reference-body{padding-top:2px}
.r48-today-system{margin-top:14px}
.r48-today-system>summary{font-size:10px}
.r48-hidden-duplicate{display:none!important}
[data-r47-priority-path]{display:none!important}
.r47-secondary-guidance,.r47-quick-tools{display:none!important}
.r48-concept .r47-context-focus,.r48-concept .r47-personalized-focus,.r48-concept .r47-setup-focus{
  box-shadow:none!important;border-color:var(--ui-line,#e7e8eb)!important
}
.r48-concept .r47-context-focus .section-kicker:before,
.r48-concept .r47-personalized-focus .section-kicker:before,
.r48-concept .r47-setup-focus .section-kicker:before{content:""!important}
html[data-theme="dark"] .r48-principle{background:var(--ui-surface-2,#171c22);border-color:var(--ui-line,#303943)}
@media(max-width:720px){
  .topbar{padding:7px 10px!important}
  .topbar-actions{gap:5px!important}
  .topbar-actions>button{padding:7px 8px!important;font-size:9px!important}
  .r48-concept-head,.r48-principle{flex-direction:column;align-items:flex-start}
}
</style>
<style id="recovery-49-leadership-harness-css">
.r49-harness{border:1px solid #bfd5c7;border-radius:18px;background:linear-gradient(180deg,#f4faf6 0%,var(--ui-surface,#fff) 100%);padding:16px;box-shadow:0 10px 28px rgba(31,67,45,.06)}
.r49-harness-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}
.r49-harness-kicker{font-size:9px;font-weight:950;letter-spacing:.12em;color:#357451}
.r49-harness h2{font-size:18px;margin:3px 0 5px}.r49-harness p{font-size:10px;line-height:1.55;color:var(--ui-muted,#667085);margin:0}
.r49-finish-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-top:13px}
.r49-finish{border:1px solid var(--ui-line,#e3e8e5);border-radius:12px;padding:10px;background:var(--ui-surface,#fff);min-width:0}
.r49-finish.done{border-color:#abefc6;background:#ecfdf3}.r49-finish.current{border-color:#b2caff;background:#f4f7ff}
.r49-finish small{font-size:8px;font-weight:900;color:#667085}.r49-finish b{display:block;font-size:10px;margin:3px 0}.r49-finish span{display:block;font-size:9px;line-height:1.4;color:#667085}
.r49-finish-meter{height:5px;border-radius:999px;background:#e9eeeb;overflow:hidden;margin-top:7px}.r49-finish-meter i{display:block;height:100%;background:#357451;border-radius:inherit}
.r49-next{margin-top:12px;border-top:1px solid #e0e9e3;padding-top:12px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;align-items:center}
.r49-next strong{font-size:12px;display:block;margin-bottom:3px}.r49-next .r49-reason{font-size:9px;color:#667085;line-height:1.45}
.r49-next button{min-height:36px}
.r49-quest-harness{margin:0 0 14px}
.r49-quest-harness .r49-next{margin-top:10px}
.harness-coach-script{border:1px solid #e2e8f0;border-radius:10px;background:rgba(255,255,255,.7);padding:9px;margin:8px 0}.harness-coach-script small{display:block;font-size:8px;color:#667085;margin-bottom:3px}.harness-coach-script b{font-size:10px;line-height:1.4}
.harness-coach-learn{border-top:1px solid rgba(0,0,0,.07);padding-top:7px;margin-top:7px}.harness-coach-learn summary{cursor:pointer;font-size:9px;font-weight:850}
.harness-coach-finish{margin-top:8px;border-radius:9px;background:#f6f8fa;padding:8px;font-size:9px;line-height:1.45;color:#475467}
.harness-coach-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.r49-purpose-note{margin-top:9px;font-size:9px;color:#53645a;line-height:1.55}
.r49-server-state{font-size:8px;font-weight:850;border:1px solid #d8e3dc;border-radius:999px;padding:4px 7px;white-space:nowrap;background:#fff}
.r49-phase-gate{margin-top:10px;padding:9px 10px;border-radius:10px;background:var(--ui-surface-2,#f8faf9);font-size:9px;color:#526057}
html[data-theme="dark"] .r49-harness{background:var(--ui-surface,#151a20);border-color:#355043}
html[data-theme="dark"] .r49-finish.done{background:#14271d}html[data-theme="dark"] .r49-finish.current{background:#172033}
html[data-theme="dark"] .harness-coach-script{background:#182028;border-color:#344054}
@media(max-width:900px){.r49-finish-grid{grid-template-columns:1fr 1fr}.r49-next{grid-template-columns:1fr}.r49-harness-head{flex-direction:column}}
@media(max-width:560px){.r49-finish-grid{grid-template-columns:1fr}}
</style>
<style id="recovery-50-stability-css">
.r50-stability-note{border:1px solid #dbe5df;border-radius:12px;padding:9px 11px;background:#f8fbf9;font-size:9px;line-height:1.5;color:#526057;margin-top:8px}
.r50-stability-note b{color:#285f42}
html[data-theme="dark"] .r50-stability-note{background:#172019;border-color:#35483c;color:#c9d6ce}
</style>
<style id="recovery-51-error-recovery-css">
.r51-recovery-status{margin-top:8px;border:1px solid #d6e2da;border-radius:10px;padding:8px 10px;background:#f7faf8;font-size:9px;line-height:1.5;color:#4e5f55}
.r51-recovery-status b{color:#24633f}
html[data-theme="dark"] .r51-recovery-status{background:#172019;border-color:#35483c;color:#c9d6ce}
</style>
<style id="recovery-52-cross-section-css">
.r52-state-contract{margin-top:8px;border:1px solid #d8e3dc;border-radius:10px;padding:8px 10px;background:#f8faf9;font-size:9px;line-height:1.5;color:#536158}
.r52-state-contract b{color:#26623f}
html[data-theme="dark"] .r52-state-contract{background:#172019;border-color:#35483c;color:#cbd7cf}
</style>
<style id="recovery-56-resume-css">
.r56-resume-state{margin-top:10px;border:1px solid #d5e3da;border-radius:12px;background:#f7fbf8;padding:10px 12px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.r56-resume-copy{min-width:0}.r56-resume-copy b{display:block;font-size:10px;color:#21623d;margin-bottom:3px}.r56-resume-copy span{display:block;font-size:9px;line-height:1.45;color:#5b6b62}
.r56-resume-badge{font-size:8px;font-weight:900;border:1px solid #cce0d3;border-radius:999px;padding:4px 7px;background:#fff;white-space:nowrap}
.r56-resume-state.loading{opacity:.72}.r56-resume-state.error{background:#fff7ed;border-color:#fed7aa}.r56-resume-state.error .r56-resume-copy b{color:#b54708}
.r56-returning{border-color:#a9d6bc!important;box-shadow:0 12px 30px rgba(39,119,73,.07)!important}
html[data-theme="dark"] .r56-resume-state{background:#162019;border-color:#344b3d}.r56-resume-state button{min-height:32px}
@media(max-width:700px){.r56-resume-state{align-items:flex-start;flex-direction:column}}
</style>
<style id="recovery-57-unified-auth-css">
/* Canonical auth surface */
.r57-auth-dialog{
  width:min(680px,calc(100vw - 28px));
  max-height:min(86vh,820px);
  border:0;
  border-radius:20px;
  padding:0;
  background:var(--ui-surface,#fff);
  color:var(--ui-ink,#111827);
  box-shadow:0 28px 80px rgba(16,24,40,.24);
}
.r57-auth-dialog::backdrop{background:rgba(15,23,42,.38);backdrop-filter:blur(3px)}
.r57-auth-shell{display:grid;grid-template-rows:auto minmax(0,1fr)}
.r57-auth-head{
  position:sticky;top:0;z-index:2;
  display:flex;align-items:flex-start;justify-content:space-between;gap:16px;
  padding:18px 20px 14px;border-bottom:1px solid var(--ui-line,#e7e8eb);
  background:var(--ui-surface,#fff);
}
.r57-auth-kicker{font-size:9px;font-weight:950;letter-spacing:.12em;color:#416c56}
.r57-auth-head h2{margin:3px 0 3px;font-size:19px}
.r57-auth-head p{margin:0;font-size:10px;line-height:1.5;color:var(--ui-muted,#667085)}
.r57-auth-close{width:34px;height:34px;min-height:34px;padding:0;border-radius:999px;font-size:18px;line-height:1}
.r57-auth-body{padding:16px 20px 20px;overflow:auto}
.r57-auth-body>.runtime-mode-card{
  margin:0!important;border:0!important;padding:0!important;box-shadow:none!important;background:transparent!important
}
.r57-auth-body .runtime-mode-head{padding:0 0 12px;border-bottom:1px solid var(--ui-line,#e7e8eb)}
.r57-auth-body .runtime-mode-copy strong{font-size:14px}
.r57-auth-body .runtime-mode-copy span{font-size:10px;line-height:1.5}
.r57-auth-body [data-live-open],
.r57-auth-body [data-live-cancel]{display:none!important}
.r57-auth-body [data-live-form]{
  margin-top:14px;
  border:1px solid var(--ui-line,#e7e8eb);
  border-radius:14px;
  padding:14px;
  background:var(--ui-surface-2,#fafbfc)
}
.r57-auth-body [data-live-form][hidden]{display:none!important}
.r57-auth-body [data-live-form].r57-force-visible{display:grid!important}
.r57-auth-body .workspace-picker,
.r57-auth-body .first-use,
.r57-auth-body .personal-home{margin-top:14px}
.r57-auth-foot{
  display:flex;justify-content:space-between;align-items:center;gap:12px;
  margin-top:14px;padding-top:12px;border-top:1px solid var(--ui-line,#e7e8eb);
}
.r57-auth-state-copy{font-size:9px;color:var(--ui-muted,#667085);line-height:1.45}
.r57-auth-done{min-height:34px}
.r57-auth-source-note{
  margin-top:10px;padding:9px 11px;border-radius:10px;
  background:var(--ui-surface-2,#f7f8fa);font-size:9px;line-height:1.5;color:var(--ui-muted,#667085)
}

/* Old duplicate login surfaces are no longer visible. */
[data-r47-auth-shell]{display:none!important}
[data-r47-account-open]{display:none!important}
.r47-today-personalization{padding:10px 12px!important}
.r47-today-personalization button{display:none!important}

/* Header is the only account/login entry point. */
.topbar-actions [data-r47-top-account],
.topbar-actions [data-r48-account]{
  display:inline-flex!important;
  align-items:center!important;
}

/* Signed-out harness explains the prerequisite without rendering another login form. */
.r57-auth-prereq{
  font-size:9px;color:var(--ui-muted,#667085);line-height:1.45
}
html[data-theme="dark"] .r57-auth-dialog,
html[data-theme="dark"] .r57-auth-head{background:var(--ui-surface,#151a20);color:var(--ui-ink,#f5f7fa)}
@media(max-width:640px){
  .r57-auth-dialog{width:calc(100vw - 16px);max-height:92vh}
  .r57-auth-head,.r57-auth-body{padding-left:14px;padding-right:14px}
}
</style>
<style id="recovery-58-mission-checklist-css">
.mission-checklist-box{border-color:#b8d7c4!important;background:linear-gradient(180deg,#f3faf6 0%,var(--ui-surface,#fff) 100%)!important}
.mission-checklist-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:14px;align-items:start}
.mission-checklist-head>div:first-child>span{display:block;font-size:8px;font-weight:950;letter-spacing:.09em;color:#26734a;margin-bottom:4px}
.mission-checklist-head strong{display:block;font-size:15px;margin-bottom:4px}.mission-checklist-head p{margin:0;font-size:10px;color:var(--ui-muted,#667085);line-height:1.5}
.mission-day-progress{min-width:60px;text-align:center;border:1px solid #cce0d3;border-radius:12px;padding:8px;background:#fff}
.mission-day-progress b{display:block;font-size:16px;color:#21623d}.mission-day-progress small{font-size:8px;color:#667085}
.mission-meta-row{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}.mission-meta-row span{font-size:8px;border:1px solid var(--ui-line,#e7e8eb);border-radius:999px;padding:4px 7px;background:var(--ui-surface,#fff)}
.mission-check-items{display:grid;gap:7px}.mission-check-item{display:grid;grid-template-columns:18px minmax(0,1fr);gap:8px;align-items:start;border:1px solid var(--ui-line,#e7e8eb);border-radius:10px;padding:9px 10px;background:var(--ui-surface,#fff);font-size:10px;line-height:1.4;cursor:pointer}
.mission-check-item.checked{border-color:#abefc6;background:#ecfdf3}.mission-check-item input{margin:1px 0 0;width:15px;height:15px}
.mission-complete-rule{margin-top:8px;font-size:9px;color:#536158;line-height:1.45}
.self-verification{border-color:#d5d9f6!important;background:#f8f8ff!important}.self-levels{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;margin:10px 0}.self-levels button{min-height:38px;font-size:9px;padding:7px}.self-levels button.active{background:#3538cd;color:#fff;border-color:#3538cd}
.quest-row.mission-ready:not(.done){border-color:#a8d5b8}.quest-row.mission-ready:not(.done) .quest-status{color:#147a44}
.r58-hr-summary{border:1px solid #cbd9d0;border-radius:18px;padding:16px;background:var(--ui-surface,#fff);display:grid;gap:12px}
.r58-hr-summary-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}.r58-hr-summary h2{margin:2px 0 4px;font-size:18px}.r58-hr-summary p{margin:0;font-size:10px;color:var(--ui-muted,#667085);line-height:1.5}
.r58-summary-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.r58-metric{border:1px solid var(--ui-line,#e7e8eb);border-radius:12px;padding:10px}.r58-metric b{display:block;font-size:18px}.r58-metric span{font-size:8px;color:#667085}
.r58-pillars{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.r58-pillar{border:1px solid var(--ui-line,#e7e8eb);border-radius:12px;padding:10px}.r58-pillar strong{display:block;font-size:10px}.r58-pillar small{display:block;font-size:8px;color:#667085;margin-top:3px}.r58-bar{height:5px;border-radius:999px;background:#e9eeeb;overflow:hidden;margin-top:7px}.r58-bar i{display:block;height:100%;background:#357451;border-radius:inherit}
.r58-privacy{font-size:9px;line-height:1.5;padding:9px 10px;border-radius:10px;background:#f7f8fa;color:#59645e}
.r58-today-mission{border:1px solid #bfd5c7;border-radius:14px;padding:12px 14px;background:#f7fbf8;margin-bottom:14px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:center}.r58-today-mission b{display:block;font-size:11px}.r58-today-mission span{font-size:9px;color:#667085}.r58-today-mission button{min-height:34px}
html[data-theme="dark"] .mission-checklist-box,html[data-theme="dark"] .r58-today-mission{background:#162019!important}html[data-theme="dark"] .self-verification{background:#17182b!important}
@media(max-width:820px){.r58-pillars{grid-template-columns:1fr 1fr}.r58-summary-metrics{grid-template-columns:1fr 1fr 1fr}}
@media(max-width:560px){.mission-checklist-head,.r58-today-mission{grid-template-columns:1fr}.self-levels{grid-template-columns:1fr 1fr}.r58-pillars,.r58-summary-metrics{grid-template-columns:1fr}}
</style>
<style id="recovery-59-hr-review-css">
.r59-hr-review{border:1px solid #d8dfdc;border-radius:16px;background:var(--ui-surface,#fff);overflow:hidden}
.r59-hr-review>summary{cursor:pointer;list-style:none;padding:13px 15px;display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:11px;font-weight:900}
.r59-hr-review>summary::-webkit-details-marker{display:none}.r59-hr-review>summary:after{content:"Admin / HR";font-size:8px;color:#667085;border:1px solid #d0d5dd;border-radius:999px;padding:4px 7px}
.r59-hr-body{padding:0 12px 12px;display:grid;gap:10px}
.r59-hr-privacy{font-size:9px;line-height:1.5;padding:9px 10px;border-radius:10px;background:#f7f8fa;color:#59645e}
.r59-roster{display:grid;gap:8px}.r59-person{display:grid;grid-template-columns:minmax(140px,1.2fr) repeat(4,minmax(90px,.7fr));gap:8px;align-items:center;border:1px solid var(--ui-line,#e7e8eb);border-radius:12px;padding:10px}
.r59-person-main b{display:block;font-size:10px}.r59-person-main span{font-size:8px;color:#667085}.r59-cell b{display:block;font-size:11px}.r59-cell span{font-size:8px;color:#667085}
.r59-status{display:inline-flex;font-size:8px;font-weight:900;border-radius:999px;padding:4px 7px;border:1px solid #d0d5dd}.r59-status.completed{background:#ecfdf3;color:#027a48;border-color:#abefc6}.r59-status.in_progress{background:#f3f6ff;color:#3538cd;border-color:#c7d7ff}
.r59-hr-loading,.r59-hr-error{font-size:9px;color:#667085;padding:10px}
html[data-theme="dark"] .r59-hr-privacy{background:#171c22}
@media(max-width:900px){.r59-person{grid-template-columns:1fr 1fr}.r59-person-main{grid-column:1/-1}}
@media(max-width:560px){.r59-person{grid-template-columns:1fr}.r59-person-main{grid-column:auto}}
</style>

<style id="recovery-61-people-css">
.r61-people-hero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px;align-items:start;border:1px solid #c9dbd0;border-radius:18px;padding:16px 18px;margin-bottom:14px;background:linear-gradient(180deg,#f5faf7,var(--ui-surface,#fff))}
.r61-people-hero h2{margin:3px 0 5px;font-size:19px}.r61-people-hero p{margin:0;font-size:10px;line-height:1.55;color:var(--ui-muted,#667085)}
.r61-people-principles{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}.r61-people-principles span{font-size:8px;font-weight:900;padding:5px 7px;border:1px solid #cbd8d0;border-radius:999px;background:#fff;color:#355646}
.r61-people-workspace{display:grid;grid-template-columns:270px minmax(0,1fr);gap:14px}
.r61-roster,.r61-person-main{border:1px solid var(--ui-line,#e3e6e5);border-radius:16px;background:var(--ui-surface,#fff)}
.r61-roster{padding:12px;height:max-content;position:sticky;top:76px}.r61-roster-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px}.r61-roster-head strong{display:block;font-size:11px}
.r61-roster-item{width:100%;text-align:left;display:grid;grid-template-columns:34px minmax(0,1fr) auto;gap:8px;align-items:center;padding:9px;border:1px solid transparent;border-radius:11px;background:transparent;margin-bottom:5px}
.r61-roster-item:hover{background:var(--ui-surface-2,#f8faf9)}.r61-roster-item.active{border-color:#a9cfb8;background:#f1f9f4}.r61-avatar{width:32px;height:32px;border-radius:10px;background:#e9f2ed;display:grid;place-items:center;font-weight:900;font-size:10px}
.r61-roster-copy b{display:block;font-size:10px}.r61-roster-copy span{display:block;font-size:8px;color:#667085;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.r61-roster-state{font-size:8px;color:#667085}
.r61-person-main{padding:16px;min-height:520px}.r61-person-empty{min-height:450px;display:grid;place-content:center;text-align:center;gap:5px;color:#667085}.r61-person-empty strong{color:var(--ui-ink,#111827)}
.r61-person-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;border-bottom:1px solid var(--ui-line,#e7e8eb);padding-bottom:12px;margin-bottom:12px}.r61-person-head h2{margin:2px 0 3px;font-size:18px}.r61-person-head p{margin:0;font-size:9px;color:#667085}
.r61-person-actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
.r61-tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}.r61-tabs button.active{background:#183f2c;color:#fff;border-color:#183f2c}
.r61-panel{display:none}.r61-panel.active{display:block}
.r61-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.r61-field{display:grid;gap:4px}.r61-field.full{grid-column:1/-1}.r61-field label{font-size:8px;font-weight:850;color:#526057}.r61-field input,.r61-field textarea,.r61-field select{width:100%;box-sizing:border-box}.r61-field textarea{min-height:76px;resize:vertical}
.r61-safe{margin-top:10px;padding:9px 10px;border-radius:10px;background:#f7f8fa;font-size:9px;line-height:1.5;color:#59645e}
.r61-safe strong{color:#34443b}
.r61-pattern-list,.r61-source-list,.r61-instruction-history{display:grid;gap:8px;margin-top:10px}
.r61-pattern,.r61-source,.r61-instruction-item{border:1px solid var(--ui-line,#e4e7ec);border-radius:11px;padding:10px;background:var(--ui-surface,#fff)}
.r61-pattern-head,.r61-source-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.r61-pattern b,.r61-source b{font-size:10px}.r61-meta{font-size:8px;color:#667085;line-height:1.45}
.r61-badge{display:inline-flex;align-items:center;font-size:7px;font-weight:950;letter-spacing:.04em;border:1px solid #d0d5dd;border-radius:999px;padding:4px 6px;white-space:nowrap}.r61-badge.confirmed{background:#ecfdf3;color:#027a48;border-color:#abefc6}.r61-badge.candidate{background:#fffaeb;color:#b54708;border-color:#fedf89}.r61-badge.private{background:#f4f3ff;color:#5925dc;border-color:#d9d6fe}
.r61-pattern-add{display:grid;grid-template-columns:150px minmax(0,1fr) auto;gap:7px;margin-top:10px}
.r61-memory-form{border:1px solid #d9e2dd;border-radius:13px;padding:12px;background:#fbfcfb}
.r61-memory-top{display:grid;grid-template-columns:160px 160px minmax(0,1fr);gap:8px}
.r61-file-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:8px}.r61-file-row input[type=file]{font-size:9px}
.r61-consent{display:flex;align-items:flex-start;gap:7px;font-size:9px;line-height:1.4;color:#536158}.r61-consent input{margin-top:2px}
.r61-audio{margin-top:8px;width:100%;height:34px}
.r61-brief-form{display:grid;grid-template-columns:1fr 1fr;gap:9px}.r61-brief-output{border:1px solid #bfd5c7;border-radius:13px;padding:12px;background:#f5faf7;margin-top:10px}.r61-brief-output h3{margin:0 0 8px}.r61-brief-section{display:grid;grid-template-columns:120px minmax(0,1fr);gap:8px;border-top:1px solid #e0e8e3;padding:7px 0;font-size:9px;line-height:1.45}.r61-brief-section:first-of-type{border-top:0}.r61-brief-section b{font-size:8px;color:#416253}
.r61-rationale{margin-top:8px;font-size:8px;color:#667085}.r61-brief-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}
.r61-cross-context{border:1px solid #c8d8cf;border-radius:13px;padding:11px 12px;margin-bottom:14px;background:#f7fbf8}.r61-cross-context h3{margin:3px 0 4px;font-size:13px}.r61-cross-context p{margin:0;font-size:9px;line-height:1.5;color:#5d6a63}.r61-cross-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.r61-quest-link{margin:10px 0;border:1px solid #cadbd1;border-radius:11px;padding:9px 10px;background:#f7fbf8;font-size:9px;line-height:1.45}
html[data-theme="dark"] .r61-people-hero,html[data-theme="dark"] .r61-roster-item.active,html[data-theme="dark"] .r61-cross-context,html[data-theme="dark"] .r61-brief-output{background:#162019}.r61-source audio{max-width:100%}
@media(max-width:940px){.r61-people-workspace{grid-template-columns:1fr}.r61-roster{position:static}.r61-roster [data-r61-roster-list]{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px}.r61-grid,.r61-brief-form{grid-template-columns:1fr}}
@media(max-width:560px){.r61-people-hero{grid-template-columns:1fr}.r61-people-principles{justify-content:flex-start}.r61-roster [data-r61-roster-list]{grid-template-columns:1fr}.r61-pattern-add,.r61-memory-top{grid-template-columns:1fr}.r61-person-head{flex-direction:column}.r61-person-actions{justify-content:flex-start}.r61-brief-section{grid-template-columns:1fr}}
</style>


<style id="recovery-63-people-evidence-css">
.r63-preference-confirm{margin-top:10px;padding:10px;border:1px solid #d7e2dc;border-radius:11px;display:flex;align-items:center;justify-content:space-between;gap:10px;background:#f8faf9}
.r63-preference-confirm b,.r63-preference-confirm span{display:block}.r63-preference-confirm b{font-size:9px}.r63-preference-confirm span{font-size:8px;color:#667085;margin-top:2px}
.r61-badge.review-due{background:#fff4ed;color:#b42318;border-color:#fecdca}.r61-pattern.r63-review-due{border-color:#f5b8b0}
.r63-review-summary{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-bottom:10px}.r63-review-summary div{border:1px solid var(--ui-line,#e4e7ec);border-radius:11px;padding:9px}.r63-review-summary b{display:block;font-size:16px}.r63-review-summary span{font-size:8px;color:#667085}
.r63-review-note,.r63-outcome-caution{font-size:9px;line-height:1.5;padding:9px 10px;border-radius:10px;background:#f7f8fa;color:#59645e;margin-bottom:10px}
.r63-review-list{display:grid;gap:8px}.r63-review-card{border:1px solid var(--ui-line,#e4e7ec);border-radius:12px;padding:10px;display:grid;gap:5px}.r63-review-card.due{border-color:#fecdca}.r63-review-card.conflict{border-color:#fedf89;background:#fffcf5}.r63-review-card b{font-size:10px}.r63-review-card p{margin:0;font-size:9px;line-height:1.5;color:#667085}.r63-review-card textarea{width:100%;min-height:80px;box-sizing:border-box}
.r63-rationale-list{display:grid;gap:4px;margin-top:7px}.r63-rationale-list span{display:block;border-left:2px solid #9bc5aa;padding-left:7px;font-size:8px;line-height:1.4}.r63-rationale-list strong{font-size:8px;color:#355646}
.r63-outcome{margin-top:14px;border:1px solid #cbdad1;border-radius:13px;padding:12px}.r63-outcome h3{margin:3px 0 10px;font-size:13px}.r63-outcome-form{display:grid;grid-template-columns:2fr 1fr 1fr;gap:8px;align-items:end}.r63-outcome-form .full{grid-column:1/-1}.r63-outcome-form button{width:max-content}
.r63-outcome-compare{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:12px 0 8px}.r63-outcome-compare div{border:1px solid var(--ui-line,#e4e7ec);border-radius:10px;padding:9px}.r63-outcome-compare b{display:block;font-size:15px}.r63-outcome-compare span{display:block;font-size:8px;color:#667085;margin-top:2px}
html[data-theme="dark"] .r63-preference-confirm,html[data-theme="dark"] .r63-review-note,html[data-theme="dark"] .r63-outcome-caution{background:#171c22}
@media(max-width:760px){.r63-review-summary,.r63-outcome-compare{grid-template-columns:1fr 1fr}.r63-outcome-form{grid-template-columns:1fr}.r63-outcome-form .full{grid-column:auto}.r63-preference-confirm{align-items:flex-start;flex-direction:column}}
</style>


<style id="recovery-64-collaborative-persona-css">
.r64-member-confirm{margin-top:12px;border:1px solid #c9dbd0;border-radius:14px;padding:12px;background:#fbfdfb}.r64-member-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.r64-member-head h3{margin:3px 0 4px;font-size:13px}.r64-member-head p{margin:0;font-size:9px;line-height:1.5;color:#667085}
.r64-link-box{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:7px;margin-top:10px;align-items:center}.r64-link-box input{width:100%;font-size:8px}.r64-link-box span{grid-column:1/-1;font-size:8px;color:#667085}
.r64-request-card{margin-top:10px;border:1px solid var(--ui-line,#e4e7ec);border-radius:11px;padding:10px}.r64-request-card.submitted{border-color:#a7d4b8;background:#f5fbf7}.r64-request-top{display:flex;justify-content:space-between;gap:8px}.r64-request-top b{font-size:10px}.r64-request-top span{font-size:8px;color:#667085}.r64-no-request,.r64-no-change{margin-top:9px;font-size:9px;color:#667085}
.r64-diffs{display:grid;gap:6px;margin:9px 0}.r64-diff{display:grid;grid-template-columns:100px minmax(0,1fr) 18px minmax(0,1fr);gap:6px;align-items:start;font-size:8px}.r64-diff b{font-size:8px}.r64-diff .old{color:#667085;text-decoration:line-through}.r64-diff .new{font-weight:700;color:#155b35}.r64-diff .arrow{text-align:center;color:#98a2b3}.r64-comment{margin:8px 0;padding:8px 9px;border-radius:9px;background:#f7f8fa;font-size:9px}.r64-comment b{display:block;margin-bottom:3px}
.r64-pref-history{margin-top:10px;font-size:9px}.r64-pref-history summary{cursor:pointer;font-weight:800}.r64-pref-history>div{display:grid;grid-template-columns:80px minmax(0,1fr);gap:8px;padding:6px 0;border-bottom:1px solid var(--ui-line,#e7e8eb)}.r64-pref-history span{color:#667085}
.r63-review-card.member{border-color:#a7d4b8;background:#f7fcf8}
.r64-verified-note{font-size:8px;line-height:1.45;color:#536158;padding:8px 9px;border-radius:9px;background:#f7faf8;margin-top:8px}
html[data-theme="dark"] .r64-member-confirm,html[data-theme="dark"] .r64-request-card.submitted,html[data-theme="dark"] .r64-verified-note{background:#162019}
@media(max-width:700px){.r64-member-head{flex-direction:column}.r64-link-box{grid-template-columns:1fr}.r64-diff{grid-template-columns:1fr}.r64-diff .arrow{display:none}}
</style>


<script id="recovery-64-public-mode-early">
(()=>{try{if(location.hash.startsWith('#peopleConfirm='))document.documentElement.dataset.peopleConfirmMode='1'}catch{}})();
</script>
<style id="recovery-64-public-mode-css">
html[data-people-confirm-mode="1"] body{margin:0!important;background:#f5f7f5!important}
html[data-people-confirm-mode="1"] body>*:not(.r64-public-confirm){display:none!important}
.r64-public-confirm{position:fixed;inset:0;z-index:999999;overflow:auto;background:#f5f7f5;color:#18231d;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
.r64-public-wrap{max-width:720px;margin:0 auto;padding:24px 16px 48px}.r64-public-card{background:#fff;border:1px solid #dce5df;border-radius:20px;padding:22px;box-shadow:0 16px 45px rgba(22,47,33,.06)}
.r64-public-k{font-size:11px;font-weight:900;letter-spacing:.08em;color:#2e6b4b}.r64-public-card h1{font-size:24px;margin:5px 0 8px}.r64-public-card p{font-size:14px;line-height:1.55;color:#5c6a62}.r64-public-notice{background:#f3f8f5;border-radius:12px;padding:11px 12px;font-size:12px;line-height:1.5;color:#526057;margin:14px 0}
.r64-public-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.r64-public-field{display:grid;gap:5px}.r64-public-field.full{grid-column:1/-1}.r64-public-field label{font-size:12px;font-weight:800}.r64-public-field input,.r64-public-field textarea,.r64-public-field select{width:100%;border:1px solid #cfd9d3;border-radius:10px;padding:10px 11px;font:inherit;color:#18231d;background:#fff;box-sizing:border-box}.r64-public-field textarea{min-height:82px;resize:vertical}.r64-public-card button{margin-top:16px;border:0;border-radius:11px;padding:12px 16px;background:#183f2c;color:#fff;font-weight:800;cursor:pointer}.r64-public-foot{margin-top:14px;font-size:11px;color:#7a867f}.r64-public-status{text-align:center;padding:32px 10px}
@media(max-width:640px){.r64-public-grid{grid-template-columns:1fr}.r64-public-field.full{grid-column:auto}.r64-public-card{padding:18px}}
</style>

</head>
<body data-recovery="42">
<div class="shell">
<aside class="sidebar">
<div class="sidebar-head">
<div class="brand brand-live">
<button aria-label="Today로 이동" class="brand-home" data-brand-home="" type="button">Leader OS</button>
<button aria-label="아날로그 시계. 클릭하면 디지털 시계로 전환" class="clock-toggle" data-clock-toggle="" title="시계 표시 전환" type="button">
<span aria-hidden="true" class="clock-analog" data-clock-analog="">
<span class="clock-face">
<span class="clock-hand clock-hour" data-clock-hour=""></span>
<span class="clock-hand clock-minute" data-clock-minute=""></span>
<span class="clock-hand clock-second" data-clock-second=""></span>
<span class="clock-pin"></span>
</span>
</span>
<span aria-hidden="true" class="clock-digital" data-clock-digital="">
<span data-clock-digital-time="">15:43</span>
<span data-clock-digital-day="">FRI</span>
</span>
</button>
<button aria-label="라이트 모드 사용 중. 클릭하면 다크 모드로 전환" class="theme-toggle theme-toggle-icon" data-theme-toggle="" title="화면 테마 변경" type="button"><span aria-hidden="true">☀</span></button>
</div>
<div class="principle">Leadership Assurance</div>
</div>
<div class="sidebar-nav-scroll">
<nav aria-label="Leader OS 주요 메뉴" data-primary-nav="">
