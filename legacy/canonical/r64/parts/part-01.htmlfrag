nt-size:9px}.r33-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}.r33-actions button{min-height:30px!important;padding:5px 8px!important;font-size:8px!important}.r33-list{display:grid;gap:7px}.r33-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;border:1px solid var(--ui-line,#e7e8eb);border-radius:11px;padding:10px;background:var(--ui-surface,#fff);min-width:0}.r33-row b{display:block;font-size:9px}.r33-row span{display:block;font-size:8px;color:var(--ui-muted,#667085);line-height:1.5;margin-top:2px;overflow-wrap:anywhere}.r33-row code{font-size:7px;color:var(--ui-muted,#667085)}.r33-timeline{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin-top:7px}.r33-timeline div{padding:7px;border-radius:9px;background:var(--ui-surface-2,#fafbfc);border:1px solid var(--ui-line,#e7e8eb)}.r33-timeline small{display:block;font-size:7px;color:var(--ui-muted,#667085)}.r33-timeline strong{display:block;font-size:10px;margin-top:2px}.r33-scenario{display:grid;grid-template-columns:1fr 1fr;gap:8px}.r33-scenario-box{padding:12px;border:1px solid var(--ui-line,#e7e8eb);border-radius:12px;background:var(--ui-surface-2,#fafbfc)}.r33-scenario-box strong{display:block;font-size:18px;margin-top:5px}.r33-diff{display:grid;gap:5px}.r33-diff-item{font-size:8px;line-height:1.5;padding:7px 8px;border:1px solid var(--ui-line,#e7e8eb);border-radius:9px;background:var(--ui-surface-2,#fafbfc)}.r33-note{font-size:8px;line-height:1.55;color:var(--ui-muted,#667085);padding:8px 9px;background:var(--ui-surface-2,#fafbfc);border-radius:9px;margin-top:8px}.r33-runtime{margin:12px 0;border:1px solid #fedf89;border-left:3px solid #f79009;border-radius:12px;padding:12px;background:#fffcf5}.r33-runtime h2{font-size:12px;margin:3px 0 6px}.r33-runtime p{font-size:9px;line-height:1.55;color:#475467;margin:0}.r33-runtime-list{display:grid;gap:5px;margin-top:8px}
