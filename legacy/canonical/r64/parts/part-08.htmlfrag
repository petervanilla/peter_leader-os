<script id="recovery-56-returning-user-resume">
(()=>{
'use strict';
const q=(s,r=document)=>r.querySelector(s);
let resume=null,busy=false,lastScope=null,refreshTimer=null,lastError=null;
const state=()=>{try{return window.LeaderOsReportRuntimeBridge?.state?.()||{signedIn:false,userId:null,workspaceId:null}}catch{return{signedIn:false,userId:null,workspaceId:null}}};
const scope=()=>{const x=state();return x.signedIn&&x.userId&&x.workspaceId?`${x.userId}|${x.workspaceId}`:null};
const resumeLabel=(r)=>{
  const n=r?.nextBestAction;if(!n)return 'Resume 상태 없음';
  if(n.kind==='CONTEXT')return 'Context부터';
  if(n.kind==='SETUP')return `Setup · Day ${n.targetDay}`;
  if(n.kind==='QUEST')return `Quest · Day ${n.targetDay}`;
  return '30일 완료';
};
const run=()=>{
  const n=resume?.nextBestAction;if(!n)return false;
  if(n.kind==='CONTEXT'){
    window.LeaderOsR21?.showOnboarding?.();
    setTimeout(()=>q('[data-r21-context-form]')?.scrollIntoView({behavior:'smooth',block:'center'}),120);
    return true;
  }
  const day=Number(n.targetDay||30);
  return window.LeaderOsLeadershipHarness?.openDay?.(day)||false;
};
const render=()=>{
  for(const root of [q('[data-r49-harness-overview]'),q('[data-r49-quest-harness]')].filter(Boolean)){
    let box=q('[data-r56-resume-state]',root);
    if(!box){box=document.createElement('div');box.className='r56-resume-state';box.dataset.r56ResumeState='';root.append(box)}
    const s=state();
    if(!s.signedIn||!s.workspaceId){
      box.className='r56-resume-state';
      box.innerHTML='<div class="r56-resume-copy"><b>Returning User Resume</b><span>로그인하면 Context · Setup · 30-Day 진행을 Workspace에서 복원합니다.</span></div><span class="r56-resume-badge">LOCAL / DEMO</span>';
      continue;
    }
    if(busy){
      box.className='r56-resume-state loading';
      box.innerHTML='<div class="r56-resume-copy"><b>Returning User Resume</b><span>Workspace의 개인 Context와 30일 진행 상태를 확인하는 중…</span></div><span class="r56-resume-badge">SYNCING</span>';
      continue;
    }
    if(lastError){
      box.className='r56-resume-state error';
      box.innerHTML=`<div class="r56-resume-copy"><b>Resume 상태를 불러오지 못했습니다.</b><span>${String(lastError)}</span></div><button type="button" data-r56-retry>다시 시도</button>`;
      q('[data-r56-retry]',box)?.addEventListener('click',()=>refresh(true));
      continue;
    }
    const n=resume?.nextBestAction;
    box.className='r56-resume-state';
    box.innerHTML=`<div class="r56-resume-copy"><b>${n?.title||'Resume 준비 완료'}</b><span>${n?.reason||'현재 Workspace의 다음 행동을 계산했습니다.'}</span></div><span class="r56-resume-badge">${resumeLabel(resume)}</span>`;
    if(resume?.quest?.completionCount>0||resume?.setup?.completedCount>0)root.classList.add('r56-returning');
  }
};
async function refresh(force=false){
  const sc=scope();
  if(!sc){resume=null;lastScope=null;lastError=null;render();return null}
  if(busy)return resume;
  if(!force&&lastScope===sc&&resume)return resume;
  busy=true;lastError=null;render();
  try{
    const result=await window.LeaderOsReportRuntimeBridge.leadershipResumeStatus();
    resume=result?.resume||null;
    lastScope=sc;
    if(resume?.context?.version){
      try{window.LeaderOsOnboardingContextBridge?.apply?.(resume.context)}catch{}
    }
    try{window.dispatchEvent(new CustomEvent('leaderos:resume-ready',{detail:{resume}}))}catch{}
    return resume;
  }catch(error){
    lastError=error?.code||error?.message||String(error);
    return null;
  }finally{busy=false;render()}
}
function queueRefresh(){
  clearTimeout(refreshTimer);
  refreshTimer=setTimeout(()=>refresh(true),220);
}
Object.defineProperty(window,'LeaderOsResumeBridge',{
  value:{snapshot:()=>resume?JSON.parse(JSON.stringify(resume)):null,refresh:()=>refresh(true),run},
  enumerable:false,configurable:true
});
['leaderos:onboarding-context-changed','leaderos:setup-changed','leaderos:quest-progress-changed','leaderos:artifacts-changed'].forEach(name=>window.addEventListener(name,queueRefresh));
setInterval(()=>{const sc=scope();if(sc!==lastScope)refresh(true)},1400);
function init(){
  [0,450,1200,2600,4200].forEach(ms=>setTimeout(()=>render(),ms));
  setTimeout(()=>refresh(false),2100);
  setTimeout(()=>{document.title='Leader OS · Recovery 56 · Returning User Resume'},40);
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>
<script id="recovery-57-unified-auth-surface">
(()=>{
'use strict';
const q=(s,r=document)=>r.querySelector(s);
let dialog=null,body=null,card=null,observer=null,wasOpenedForLogin=false;
const runtime=()=>{try{return window.LeaderOsReportRuntimeBridge?.state?.()||{signedIn:false,workspaceId:null,workspaceName:null}}catch{return{signedIn:false,workspaceId:null,workspaceName:null}}};

function ensureDialog(){
  if(dialog&&dialog.isConnected)return dialog;
  dialog=document.createElement('dialog');
  dialog.className='r57-auth-dialog';
  dialog.dataset.r57AuthDialog='';
  dialog.innerHTML=`
    <div class="r57-auth-shell">
      <header class="r57-auth-head">
        <div>
          <div class="r57-auth-kicker">ACCOUNT · WORKSPACE</div>
          <h2>로그인과 Workspace는 여기서만 관리합니다.</h2>
          <p>Identity → Workspace 선택 → 개인화/Resume가 하나의 흐름으로 이어집니다.</p>
        </div>
        <button class="r57-auth-close" type="button" data-r57-auth-close aria-label="닫기">×</button>
      </header>
      <div class="r57-auth-body" data-r57-auth-body>
        <div class="r57-auth-source-note">Leader OS의 로그인 폼은 하나만 사용합니다. Onboarding·Today·Quest에는 별도 로그인 폼을 만들지 않습니다.</div>
        <div class="r57-auth-foot">
          <div class="r57-auth-state-copy" data-r57-auth-state>로그인 상태를 확인하고 있습니다.</div>
          <button class="r57-auth-done" type="button" data-r57-auth-done>완료</button>
        </div>
      </div>
    </div>`;
  document.body.append(dialog);
  body=q('[data-r57-auth-body]',dialog);
  q('[data-r57-auth-close]',dialog)?.addEventListener('click',close);
  q('[data-r57-auth-done]',dialog)?.addEventListener('click',close);
  dialog.addEventListener('click',(e)=>{if(e.target===dialog)close()});
  dialog.addEventListener('cancel',(e)=>{e.preventDefault();close()});
  return dialog;
}

function locateRuntimeCard(){
  if(card&&card.isConnected)return card;
  card=q('.runtime-mode-card');
  return card;
}

function normalizeCardCopy(){
  if(!card)return;
  const strong=q('.runtime-mode-copy strong',card);
  const copy=q('.runtime-mode-copy span',card);
  if(strong)strong.textContent='계정 / Workspace';
  if(copy)copy.textContent='로그인하면 가입된 ACTIVE Workspace를 찾고, 선택한 Workspace 기준으로 개인화·저장·Resume를 사용합니다.';
}

function mountCard(){
  ensureDialog();
  const found=locateRuntimeCard();
  if(!found||!body)return false;
  card=found;
  normalizeCardCopy();
  const note=q('.r57-auth-source-note',body);
  if(note && card.parentElement!==body)body.insertBefore(card,note);
  return true;
}

function syncForm(){
  if(!mountCard())return;
  const s=runtime();
  const form=q('[data-live-form]',card);
  const open=q('[data-live-open]',card);
  const state=q('[data-r57-auth-state]',dialog);
  if(open)open.hidden=true;

  if(!s.signedIn){
    if(form){
      form.hidden=false;
      form.classList.add('r57-force-visible');
    }
    if(state)state.textContent='로그인 전 · 이메일과 비밀번호로 연결하세요.';
  }else{
    if(form){
      form.classList.remove('r57-force-visible');
      form.hidden=true;
    }
    if(state)state.textContent=s.workspaceId
      ? `연결됨 · ${s.workspaceName||s.workspaceId}`
      : '로그인됨 · 사용할 Workspace를 선택하거나 새 Workspace를 만드세요.';
  }

  // Today status becomes status-only; account action lives in header.
  const today=q('[data-r47-today-personalization]');
  if(today){
    const title=q('strong',today),copy=q('span',today);
    if(title)title.textContent='개인화 상태';
    if(copy)copy.textContent=s.signedIn&&s.workspaceId
      ? `${s.workspaceName||s.workspaceId} 기준으로 저장·검색·Resume를 사용합니다.`
      : '로그인 / Workspace 관리는 상단 헤더에서만 합니다.';
    q('[data-r47-account-open]',today)?.remove();
  }
}

function open(){
  ensureDialog();
  mountCard();
  syncForm();
  wasOpenedForLogin=!runtime().signedIn;
  if(typeof dialog.showModal==='function'&&!dialog.open)dialog.showModal();
  else dialog.setAttribute('open','');
  setTimeout(()=>{
    const s=runtime();
    if(!s.signedIn)q('[data-live-email]',dialog)?.focus();
  },50);
}

function close(){
  if(!dialog)return;
  if(typeof dialog.close==='function'&&dialog.open)dialog.close();
  else dialog.removeAttribute('open');
  wasOpenedForLogin=false;
}

function removeDuplicateAuthShell(){
  const shell=q('[data-r47-auth-shell]');
  if(shell){
    const found=q('.runtime-mode-card',shell);
    if(found){
      card=found;
      mountCard();
    }
    shell.remove();
  }
  q('[data-r47-account-open]')?.remove();
}

function bindHeaderCanonicalEntry(){
  // Capture wins over legacy Recovery 47/48 onclick handlers.
  document.addEventListener('click',(e)=>{
    const btn=e.target.closest?.('[data-r47-top-account],[data-r48-account]');
    if(!btn)return;
    e.preventDefault();
    e.stopImmediatePropagation();
    open();
  },true);
}

function watchState(){
  let previous='';
  setInterval(()=>{
    const s=runtime();
    const key=`${s.signedIn?'1':'0'}|${s.workspaceId||''}|${s.workspaceName||''}`;
    if(key===previous)return;
    previous=key;
    syncForm();
  },650);
}

function init(){
  ensureDialog();
  // Let the app create/capture the original runtime controls first, then move them.
  [0,80,240,700,1600].forEach(ms=>setTimeout(()=>{mountCard();removeDuplicateAuthShell();syncForm()},ms));
  bindHeaderCanonicalEntry();
  watchState();

  // Legacy recoveries should not recreate auth UI, but guard periodically without observing our own DOM writes.
  setInterval(()=>{
    if(q('[data-r47-auth-shell]')||q('[data-r47-account-open]')) removeDuplicateAuthShell();
  },1800);

  Object.defineProperty(window,'LeaderOsAuthUi',{
    value:{open,close,state:()=>runtime(),dialog:()=>dialog},
    enumerable:false,configurable:true
  });
  document.title='Leader OS · Recovery 57 · Unified Auth Surface';
}

if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>
<script id="recovery-58-mission-checklist-ux">
(()=>{
'use strict';
const q=(s,r=document)=>r.querySelector(s);
const snapshot=()=>{try{return window.LeaderOsMissionBridge?.snapshot?.()||null}catch{return null}};
function openDay(day){return window.LeaderOsLeadershipHarness?.openDay?.(Number(day))}
function nextDay(summary){
  if(!summary)return 1;
  const pending=summary.days?.find((d)=>!d.questComplete)||summary.days?.find((d)=>!d.progress?.complete);
  return pending?.day||30;
}
function renderSummary(){
  const page=q('[data-page="LEADER_ONBOARDING"]'),flow=q('[data-r47-onboarding-flow]',page||document);
  if(!page||!flow)return;
  let card=q('[data-r58-hr-summary]',flow);
  if(!card){
    card=document.createElement('section');card.className='r58-hr-summary';card.dataset.r58HrSummary='';
    const harness=q('[data-r49-harness-overview]',flow);
    (harness||flow.firstElementChild)?.insertAdjacentElement('afterend',card);
  }
  const s=snapshot();
  if(!s){
    card.innerHTML='<div class="r58-hr-summary-head"><div><div class="r48-concept-kicker">30-DAY TEAM LEADER MISSION</div><h2>30일 온보딩 Mission Checklist</h2><p>Mission 데이터를 준비하고 있습니다.</p></div></div>';
    return;
  }
  const pillars=Object.values(s.pillars||{});
  card.innerHTML=`<div class="r58-hr-summary-head"><div><div class="r48-concept-kicker">30-DAY TEAM LEADER MISSION · HR ONBOARDING</div><h2>체크리스트로 실행하고, Evidence로 검증합니다.</h2><p>팀원 파악 → 회사/팀 목표 이해 → 운영 → 결정·위임 → 커뮤니케이션·코칭 → 자기검증을 30일 안에 실제 업무로 수행합니다.</p></div><button type="button" class="primary" data-r58-next>다음 Mission →</button></div>
  <div class="r58-summary-metrics">
    <div class="r58-metric"><b>${s.missionCompleteDays}/30</b><span>Mission Checklist 완료</span></div>
    <div class="r58-metric"><b>${s.evidenceDays}/30</b><span>Evidence 확인 Day</span></div>
    <div class="r58-metric"><b>${s.repeatableDays}/30</b><span>반복 가능한 리더 행동</span></div>
  </div>
  <div class="r58-pillars">${pillars.map((p)=>{const pct=p.days?Math.round(p.missionComplete/p.days*100):0;return `<div class="r58-pillar"><strong>${p.label}</strong><small>${p.missionComplete}/${p.days} Mission · Evidence ${p.evidence}</small><div class="r58-bar"><i style="width:${pct}%"></i></div></div>`}).join('')}</div>
  <div class="r58-privacy"><b>HR 원칙</b> · 팀원을 점수화하지 않습니다. HR/조직은 Mission 완료와 운영 결과물을 볼 수 있고, 리더의 Self Verification과 민감한 1:1·개인 메모는 개인 영역으로 유지합니다.</div>`;
  q('[data-r58-next]',card)?.addEventListener('click',()=>openDay(nextDay(s)));
}
function renderQuestCopy(){
  const page=q('[data-page="ONBOARDING"]');if(!page)return;
  const h=q(':scope > h1',page),sub=q(':scope > p.sub',page);
  if(h)h.textContent='30-Day Team Leader Mission Checklist';
  if(sub)sub.textContent='매일 실제 미션을 체크하고, Evidence와 자기검증을 남겨 30일 안에 팀장 온보딩을 완성합니다.';
  const hero=q(':scope > .quest-hero',page);
  if(hero){
    const title=q('h2',hero),copy=q('p',hero);
    if(title)title.textContent='Mission → Checklist → Evidence → Self Check → Coach';
    if(copy)copy.textContent='콘텐츠 수료가 아니라 실제 팀에서 해야 할 행동을 완료하는 것이 기준입니다.';
  }
}
function renderToday(){
  const page=q('[data-page="TODAY"]');if(!page)return;
  let card=q('[data-r58-today-mission]',page);
  if(!card){
    card=document.createElement('section');card.className='r58-today-mission';card.dataset.r58TodayMission='';
    const anchor=q('[data-r47-today-personalization]',page)||q(':scope > p.sub',page)||q(':scope > h1',page);
    anchor?.insertAdjacentElement('afterend',card);
  }
  const s=snapshot(),day=nextDay(s),d=s?.days?.find((x)=>x.day===day);
  if(!d){card.innerHTML='<div><b>오늘의 Leadership Mission</b><span>Mission 상태를 확인하고 있습니다.</span></div>';return}
  card.innerHTML=`<div><b>DAY ${String(day).padStart(2,'0')} · ${d.title}</b><span>${d.progress.done}/${d.progress.total} Checklist · ${d.evidence?'Evidence 있음':'Evidence 필요'} · ${d.selfLevel==='REPEATABLE'?'반복 가능':d.selfLevel==='EVIDENCED'?'Evidence 확인':d.selfLevel==='TRIED'?'실행해봄':'자기검증 대기'}</span></div><button type="button" data-r58-today-open>오늘 Mission →</button>`;
  q('[data-r58-today-open]',card)?.addEventListener('click',()=>openDay(day));
}
function render(){
  renderSummary();renderQuestCopy();renderToday();
}
['leaderos:mission-checklist-changed','leaderos:self-check-changed','leaderos:quest-progress-changed','leaderos:artifacts-changed'].forEach(name=>window.addEventListener(name,()=>setTimeout(render,50)));
function init(){[0,250,850,1800].forEach(ms=>setTimeout(render,ms));setInterval(render,1800);document.title='Leader OS · Recovery 58 · 30-Day Mission Checklist'}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>
<script id="recovery-59-hr-onboarding-review">
(()=>{
'use strict';
const q=(s,r=document)=>r.querySelector(s);
let roster=null,lastScope=null,busy=false,denied=false;
const state=()=>{try{return window.LeaderOsReportRuntimeBridge?.state?.()||{signedIn:false,userId:null,workspaceId:null}}catch{return{signedIn:false,userId:null,workspaceId:null}}};
const scope=()=>{const s=state();return s.signedIn&&s.userId&&s.workspaceId?`${s.userId}|${s.workspaceId}`:null};
const statusLabel=(v)=>v==='COMPLETED'?'30일 완료':v==='IN_PROGRESS'?'진행 중':'시작 전';
function host(){
  const flow=q('[data-r47-onboarding-flow]');
  const summary=q('[data-r58-hr-summary]',flow||document);
  return {flow,summary};
}
function remove(){q('[data-r59-hr-review]')?.remove()}
function render(){
  const {flow,summary}=host();
  if(!flow||!summary||denied||!state().signedIn||!state().workspaceId){remove();return}
  let box=q('[data-r59-hr-review]',flow);
  if(!box){
    box=document.createElement('details');box.className='r59-hr-review';box.dataset.r59HrReview='';
    summary.insertAdjacentElement('afterend',box);
  }
  if(busy){
    box.innerHTML='<summary>HR · 30-Day Onboarding Review</summary><div class="r59-hr-body"><div class="r59-hr-loading">권한과 진행 상태를 확인하고 있습니다.</div></div>';
    return;
  }
  const data=roster?.onboardingRoster;
  if(!data){remove();return}
  const rows=Array.isArray(data.roster)?data.roster:[];
  box.innerHTML=`<summary>HR · 30-Day Onboarding Review · ${rows.length}명</summary><div class="r59-hr-body">
    <div class="r59-hr-privacy"><b>Privacy Boundary</b> · HR/Admin은 Mission 완료·Evidence Day·운영 Artifact 진행만 봅니다. 개인 Self Verification, 1:1 메모, PRIVATE Context 내용은 포함하지 않습니다. 사람 점수화 기능도 없습니다.</div>
    <div class="r59-roster">${rows.map((r)=>`<article class="r59-person">
      <div class="r59-person-main"><b>${String(r.displayName||r.userId)}</b><span>${String(r.workspaceRole||'MEMBER')} · <i class="r59-status ${String(r.status||'').toLowerCase()}">${statusLabel(r.status)}</i></span></div>
      <div class="r59-cell"><b>${r.mission?.completeDays||0}/30</b><span>Mission Day</span></div>
      <div class="r59-cell"><b>${r.quest?.completeDays||0}/30</b><span>Quest 완료</span></div>
      <div class="r59-cell"><b>${r.evidenceDays||0}</b><span>Evidence Day</span></div>
      <div class="r59-cell"><b>${r.artifacts?.confirmed||0}/${r.artifacts?.total||0}</b><span>Confirmed / Artifact</span></div>
    </article>`).join('')}</div>
  </div>`;
}
async function refresh(force=false){
  const sc=scope();
  if(!sc){roster=null;lastScope=null;denied=false;remove();return}
  if(!force&&lastScope===sc&&roster)return;
  if(busy)return;
  busy=true;render();
  try{
    const result=await window.LeaderOsReportRuntimeBridge.leadershipOnboardingRoster();
    roster=result;
    lastScope=sc;
    denied=false;
  }catch(error){
    const code=String(error?.code||error?.message||error);
    if(/ROLE|FORBIDDEN|MEMBERSHIP|403/i.test(code))denied=true;
    roster=null;
  }finally{busy=false;render()}
}
['leaderos:mission-checklist-changed','leaderos:quest-progress-changed','leaderos:artifacts-changed'].forEach(name=>window.addEventListener(name,()=>setTimeout(()=>refresh(true),180)));
setInterval(()=>{if(scope()!==lastScope){denied=false;refresh(true)}},1600);
function init(){setTimeout(()=>refresh(false),2300);[80,2600].forEach(ms=>setTimeout(()=>{document.title='Leader OS · Recovery 59 · HR Onboarding Review'},ms))}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>
<script id="recovery-60-remove-ask-leader-os">
(()=>{
'use strict';
/*
  Recovery 60 product contract:
  - Today: next attention / mission
  - Global Search: retrieval
  - Leader Coach: contextual question + coaching
  - Leader Language: phrasing practice
  - Review: verification
  There is no parallel generic Ask surface.
*/
const apply=()=>{document.title='Leader OS · Recovery 60 · Focused Leadership Flow'};
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>{[0,800,2500,4000].forEach(ms=>setTimeout(apply,ms))},{once:true});else{apply();setTimeout(apply,2500)};
})();
</script>

<script id="recovery-61-people-collaboration-intelligence">
(()=>{
'use strict';
const q=(s,r=document)=>r.querySelector(s),qa=(s,r=document)=>Array.from(r.querySelectorAll(s));
const esc=(v)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const storage=window.__leaderOsStorage||(()=>{try{return localStorage}catch{return null}})();
const STORAGE_BASE='leader-os:people-collaboration:v1';
const AUDIO_BUCKET='leader-os-people-audio';
const state=()=>{try{return window.LeaderOsReportRuntimeBridge?.state?.()||{signedIn:false,userId:null,workspaceId:null,workspaceName:null}}catch{return{signedIn:false,userId:null,workspaceId:null,workspaceName:null}}};
const scope=()=>{const s=state();return s.signedIn&&s.userId&&s.workspaceId?`${s.userId}:${s.workspaceId}`:'guest'};
const key=()=>`${STORAGE_BASE}:${scope()}`;
const now=()=>new Date().toISOString();
const id=(prefix)=>`${prefix}-${Date.now().toString(36)}-${Math.random().toString(36).slice(2,8)}`;
const defaultStore=()=>({activePersonId:null,profiles:{},sources:{},instructions:{},serverReviewQueue:[],updatedAt:null});
let activeScope=scope(),store=read(),hydrating=false,lastInstruction=null;
let preferenceRequests=[];
const lastPreferenceLinks=new Map();
const ephemeralAudio=new Map();

function read(){
  try{
    const raw=storage?.getItem?.(`${STORAGE_BASE}:${scope()}`);
    const x=raw?JSON.parse(raw):defaultStore();
    return {
      activePersonId:x?.activePersonId||null,
      profiles:x?.profiles&&typeof x.profiles==='object'?x.profiles:{},
      sources:x?.sources&&typeof x.sources==='object'?x.sources:{},
      instructions:x?.instructions&&typeof x.instructions==='object'?x.instructions:{},
      serverReviewQueue:Array.isArray(x?.serverReviewQueue)?x.serverReviewQueue:[],
      updatedAt:x?.updatedAt||null
    };
  }catch{return defaultStore()}
}
function save(reason='LOCAL'){
  store.updatedAt=now();
  try{storage?.setItem?.(key(),JSON.stringify(store))}catch{}
  try{window.dispatchEvent(new CustomEvent('leaderos:people-context-changed',{detail:{reason,personId:store.activePersonId}}))}catch{}
}
function seedPeople(){
  const seed=Array.isArray(window.LeaderOsPeopleSeed)?window.LeaderOsPeopleSeed:[];
  const mapped=seed.map((p)=>({personId:String(p.id),personName:String(p.name||p.id),role:String(p.role||''),priority:p.currentPriority||'',project:p.currentProject||''}));
  for(const card of qa('[data-people-list] .person-card')){
    const pid=card.dataset.personId,name=card.dataset.personName,role=card.dataset.personRole;
    if(pid&&!mapped.some((x)=>x.personId===pid))mapped.push({personId:pid,personName:name||pid,role:role||'',priority:'',project:''});
  }
  for(const profile of Object.values(store.profiles)){
    if(profile?.personId&&!mapped.some((x)=>x.personId===profile.personId))mapped.push({personId:profile.personId,personName:profile.personName||profile.personId,role:profile.role||'',priority:'',project:''});
  }
  return mapped;
}
function blankProfile(person){
  return {
    personId:person.personId,personName:person.personName||person.personId,role:person.role||'',
    version:0,serverVersion:0,
    instructionPreference:'',autonomyPreference:'',checkpointPreference:'',
    feedbackPreference:'',reportingPreference:'',communicationPreference:'',
    focusPreference:'',availabilityPreference:'',styleLabel:'',preferenceConfirmedAt:'',preferenceHistory:[],
    patterns:[],updatedAt:null
  };
}
function profile(personId){
  const person=seedPeople().find((x)=>x.personId===personId)||{personId,personName:personId,role:''};
  return {...blankProfile(person),...(store.profiles[personId]||{}),personId};
}
function sources(personId){return Array.isArray(store.sources[personId])?store.sources[personId]:[]}
function instructions(personId){return Array.isArray(store.instructions[personId])?store.instructions[personId]:[]}
function selectedPerson(){const pid=store.activePersonId||seedPeople()[0]?.personId||null;return pid?seedPeople().find((x)=>x.personId===pid)||profile(pid):null}
function confirmedPatterns(p){return (p.patterns||[]).filter((x)=>String(x.state||'').toUpperCase()==='CONFIRMED')}
function candidatePatterns(p){return (p.patterns||[]).filter((x)=>String(x.state||'').toUpperCase()!=='CONFIRMED')}
function usableConfirmedPatterns(p){
  const current=confirmedPatterns(p).filter((x)=>!patternReviewDue(x));
  const grouped={};
  for(const x of current)(grouped[x.category]??=[]).push(x);
  const conflicted=new Set(Object.entries(grouped).filter(([,items])=>new Set(items.map(x=>String(x.statement||'').trim())).size>1).map(([cat])=>cat));
  return current.filter((x)=>!conflicted.has(x.category));
}
function patternFor(p,cat){
  const c=usableConfirmedPatterns(p).filter((x)=>x.category===cat);
  return c.length?c[c.length-1]:null;
}
function verifiedSelfReported(p){return Boolean(p.preferenceConfirmedAt)}
function workingSummary(p){
  const pieces=[];
  if(verifiedSelfReported(p)){
    if(p.instructionPreference)pieces.push(`지시: ${p.instructionPreference}`);
    if(p.autonomyPreference)pieces.push(`자율: ${p.autonomyPreference}`);
    if(p.checkpointPreference)pieces.push(`체크포인트: ${p.checkpointPreference}`);
    if(p.feedbackPreference)pieces.push(`피드백: ${p.feedbackPreference}`);
    if(p.reportingPreference)pieces.push(`보고: ${p.reportingPreference}`);
  }
  for(const x of usableConfirmedPatterns(p).slice(-3))pieces.push(`${x.category}: ${x.statement}`);
  return pieces;
}
function instructionRationale(p){
  const details=[],patternRefs=[];
  const addSelf=(field,label,value)=>{
    if(!verifiedSelfReported(p)||!value)return;
    details.push({field,sourceType:'SELF_REPORTED_CONFIRMED',sourceRef:`profile:selfReported:${field}`,explanation:`${label}: ${value}`});
  };
  addSelf('BRIEF','업무 지시 선호',p.instructionPreference);
  addSelf('AUTONOMY','자율 수준 선호',p.autonomyPreference);
  addSelf('CHECKPOINT','Checkpoint 선호',p.checkpointPreference);
  addSelf('FEEDBACK','Feedback 선호',p.feedbackPreference);
  addSelf('REPORTING','Reporting 선호',p.reportingPreference);
  addSelf('COMMUNICATION','Communication 선호',p.communicationPreference);
  for(const x of usableConfirmedPatterns(p)){
    patternRefs.push(x.id);
    details.push({field:x.category,sourceType:'CONFIRMED_PATTERN_CURRENT',sourceRef:x.id,explanation:x.statement});
  }
  return {
    patternRefs:[...new Set(patternRefs)].slice(0,20),
    rationaleDetails:details.slice(0,24),
    rationaleSources:details.map(x=>`${x.sourceType} · ${x.field} · ${x.sourceRef}`).slice(0,20)
  };
}
function generateInstruction(p,input){
  const autonomyPattern=patternFor(p,'AUTONOMY'),checkpointPattern=patternFor(p,'CHECKPOINT'),reportPattern=patternFor(p,'REPORTING'),feedbackPattern=patternFor(p,'FEEDBACK'),briefPattern=patternFor(p,'BRIEF'),commPattern=patternFor(p,'COMMUNICATION');
  const vp=verifiedSelfReported(p)?p:{};
  const autonomy=(autonomyPattern?.statement||vp.autonomyPreference||'COACH').toUpperCase().includes('DELEG')?'L5 · Own':
    (autonomyPattern?.statement||vp.autonomyPreference||'').toUpperCase().includes('GUIDE')?'L2 · Research':
    (autonomyPattern?.statement||vp.autonomyPreference||'').toUpperCase().includes('SUPPORT')?'L4 · Decide+Check':'L4 · Decide+Check';
  const checkpoint=checkpointPattern?.statement||vp.checkpointPreference||input.checkpoint||'30% 진행 시 Direction Check';
  const reporting=reportPattern?.statement||vp.reportingPreference||'진행 중 Blocker 발생 시 바로 공유 · Checkpoint에는 결과/질문 중심으로 보고';
  const feedback=feedbackPattern?.statement||vp.feedbackPreference||'수정 포인트는 관찰 가능한 결과와 Done Criteria 기준으로 구체적으로 피드백';
  const communication=commPattern?.statement||vp.communicationPreference||'업무지시는 문장으로 남기고 필요한 Context를 함께 제공';
  const briefHint=briefPattern?.statement||vp.instructionPreference||'Goal → Context → Output → Done Criteria 순서로 전달';
  const workflow=[
    `1. ${briefHint}`,
    `2. ${communication}`,
    `3. 권한 수준: ${autonomy}`,
    `4. Checkpoint: ${checkpoint}`,
    `5. Reporting: ${reporting}`,
    `6. Feedback: ${feedback}`
  ];
  const rationale=instructionRationale(p);
  return {
    instructionId:id('INST'),personId:p.personId,personName:p.personName,role:p.role,
    task:input.task||'',goal:input.goal||'',context:input.context||'',
    output:input.output||'',doneCriteria:input.doneCriteria||'',
    autonomy,guardrail:input.guardrail||'브랜드/정책/예산 등 명시된 Guardrail 안에서 진행',
    checkpoint,reporting,feedback,workflow,
    rationaleSources:rationale.rationaleSources,
    patternRefs:rationale.patternRefs,
    rationaleDetails:rationale.rationaleDetails,
    updatedAt:now(),version:0
  };
}

async function persistProfile(p){
  store.profiles[p.personId]=p;save('PROFILE_LOCAL');
  const s=state(); if(!s.signedIn||!s.workspaceId)return p;
  try{
    const result=await window.LeaderOsReportRuntimeBridge.savePeopleProfile({
      eventId:`PEOPLE-PROFILE-${Date.now().toString(36)}`,expectedVersion:Number(p.serverVersion||0),
      personId:p.personId,personName:p.personName,role:p.role,
      instructionPreference:p.instructionPreference,autonomyPreference:p.autonomyPreference,
      checkpointPreference:p.checkpointPreference,feedbackPreference:p.feedbackPreference,
      reportingPreference:p.reportingPreference,communicationPreference:p.communicationPreference,
      focusPreference:p.focusPreference,availabilityPreference:p.availabilityPreference,
      styleLabel:p.styleLabel,preferenceConfirmedAt:p.preferenceConfirmedAt||'',patterns:p.patterns||[]
    });
    const rec=result?.record||{};
    p.serverVersion=Number(rec.version||p.serverVersion||0);p.updatedAt=rec.updated_at||rec.updatedAt||now();
    store.profiles[p.personId]=p;save('PROFILE_SERVER');return p;
  }catch(error){announce(`Working Persona는 로컬에 저장됨 · 서버 동기화 실패: ${error?.code||error?.message||error}`);return p}
}
async function persistSource(source){
  const list=sources(source.personId);const idx=list.findIndex((x)=>x.sourceId===source.sourceId);
  if(idx<0)list.unshift(source);else list[idx]=source;store.sources[source.personId]=list;save('SOURCE_LOCAL');
  const s=state();if(!s.signedIn||!s.workspaceId)return source;
  try{
    const result=await window.LeaderOsReportRuntimeBridge.savePeopleSource({
      eventId:`PEOPLE-SOURCE-${Date.now().toString(36)}`,expectedVersion:Number(source.serverVersion||0),
      ...source,
      linkedInstructionId:source.linkedInstructionId||'',
      reworkRounds:source.outcomeSignals?.reworkRounds ?? source.reworkRounds ?? null,
      checkpointOutcome:source.outcomeSignals?.checkpointOutcome ?? source.checkpointOutcome ?? '',
      instructionOutcome:source.outcomeSignals?.instructionOutcome ?? source.instructionOutcome ?? ''
    });
    const rec=result?.record||{};source.serverVersion=Number(rec.version||source.serverVersion||0);source.updatedAt=rec.updated_at||rec.updatedAt||now();
    const next=sources(source.personId);const i=next.findIndex((x)=>x.sourceId===source.sourceId);if(i>=0)next[i]=source;
    store.sources[source.personId]=next;save('SOURCE_SERVER');return source;
  }catch(error){announce(`대화/업무 Source는 로컬에 저장됨 · 서버 동기화 실패: ${error?.code||error?.message||error}`);return source}
}
async function persistInstruction(inst){
  const list=instructions(inst.personId);const idx=list.findIndex((x)=>x.instructionId===inst.instructionId);
  if(idx<0)list.unshift(inst);else list[idx]=inst;store.instructions[inst.personId]=list.slice(0,40);lastInstruction=inst;save('INSTRUCTION_LOCAL');
  const s=state();if(!s.signedIn||!s.workspaceId)return inst;
  try{
    const result=await window.LeaderOsReportRuntimeBridge.savePeopleInstruction({
      eventId:`PEOPLE-INSTRUCTION-${Date.now().toString(36)}`,expectedVersion:Number(inst.serverVersion||0),...inst,
      patternRefs:Array.isArray(inst.patternRefs)?inst.patternRefs:[],
      rationaleDetails:Array.isArray(inst.rationaleDetails)?inst.rationaleDetails:[]
    });
    const rec=result?.record||{};inst.serverVersion=Number(rec.version||inst.serverVersion||0);inst.updatedAt=rec.updated_at||rec.updatedAt||now();
    const next=instructions(inst.personId);const i=next.findIndex((x)=>x.instructionId===inst.instructionId);if(i>=0)next[i]=inst;
    store.instructions[inst.personId]=next;lastInstruction=inst;save('INSTRUCTION_SERVER');return inst;
  }catch(error){announce(`업무지시 Draft는 로컬에 저장됨 · 서버 동기화 실패: ${error?.code||error?.message||error}`);return inst}
}

async function refreshPreferenceRequests(personId=null){
  const st=state();
  if(!st.signedIn||!st.workspaceId){preferenceRequests=[];return []}
  try{
    const result=await window.LeaderOsReportRuntimeBridge.listPeoplePreferenceRequests(personId);
    preferenceRequests=Array.isArray(result?.preferenceRequests)?result.preferenceRequests:[];
    return preferenceRequests;
  }catch(error){
    announce(`팀원 확인 요청 상태를 불러오지 못했습니다: ${error?.code||error?.message||error}`);
    return preferenceRequests;
  }
}

async function hydrate(force=false){
  const s=state();if(!s.signedIn||!s.workspaceId)return;
  if(hydrating)return;hydrating=true;
  try{
    const result=await window.LeaderOsReportRuntimeBridge.peopleCollaborationStatus();
    const data=result?.peopleCollaboration||{};
    for(const row of Array.isArray(data.profiles)?data.profiles:[]){
      const sr=row.selfReported||{};
      store.profiles[row.personId]={
        personId:row.personId,personName:row.personName||row.title||row.personId,role:row.role||'',
        instructionPreference:sr.instructionPreference||'',autonomyPreference:sr.autonomyPreference||'',
        checkpointPreference:sr.checkpointPreference||'',feedbackPreference:sr.feedbackPreference||'',
        reportingPreference:sr.reportingPreference||'',communicationPreference:sr.communicationPreference||'',
        focusPreference:sr.focusPreference||'',availabilityPreference:sr.availabilityPreference||'',
        styleLabel:sr.styleLabel||'',preferenceConfirmedAt:sr.preferenceConfirmedAt||'',
        preferenceHistory:Array.isArray(row.preferenceHistory)?row.preferenceHistory:[],
        patterns:Array.isArray(row.patterns)?row.patterns:[],
        serverVersion:Number(row.version||0),updatedAt:row.updatedAt||null
      };
    }
    const groupedSources={},groupedInstructions={};
    for(const row of Array.isArray(data.sources)?data.sources:[])(groupedSources[row.personId]??=[]).push({...row,serverVersion:Number(row.version||0)});
    for(const row of Array.isArray(data.instructions)?data.instructions:[])(groupedInstructions[row.personId]??=[]).push({...row,serverVersion:Number(row.version||0)});
    store.sources={...store.sources,...groupedSources};
    store.instructions={...store.instructions,...groupedInstructions};
    store.serverReviewQueue=Array.isArray(data.reviewQueue)?data.reviewQueue:[];
    await refreshPreferenceRequests();
    save('HYDRATE');
  }catch(error){announce(`People 서버 Context를 불러오지 못했습니다: ${error?.code||error?.message||error}`)}
  finally{hydrating=false;renderAll()}
}
async function uploadAudio(file,personId){
  const s=state();if(!file)return {storagePath:'',fileName:'',mimeType:'',sizeBytes:0,localOnly:false};
  if(!s.signedIn||!s.userId||!s.workspaceId){
    const localUrl=URL.createObjectURL(file);const localId=id('LOCAL-AUDIO');ephemeralAudio.set(localId,localUrl);
    return {storagePath:'',fileName:file.name,mimeType:file.type,sizeBytes:file.size,localOnly:true,localAudioId:localId};
  }
  if(file.size>25*1024*1024)throw new Error('AUDIO_FILE_TOO_LARGE_25MB');
  const token=await window.LeaderOsReportRuntimeBridge.authAccessToken();
  const cfg=window.LeaderOsReportRuntimeBridge.runtimeConfig();
  const safeName=String(file.name||'recording').replace(/[^A-Za-z0-9._-]+/g,'_').slice(-120);
  const storagePath=`${s.userId}/${s.workspaceId}/${personId}/${crypto.randomUUID()}-${safeName}`;
  const url=`${cfg.supabaseUrl}/storage/v1/object/${AUDIO_BUCKET}/${storagePath.split('/').map(encodeURIComponent).join('/')}`;
  const response=await fetch(url,{method:'POST',headers:{apikey:cfg.publishableKey,Authorization:`Bearer ${token}`,'Content-Type':file.type||'application/octet-stream','x-upsert':'false'},body:file});
  if(!response.ok)throw new Error(`AUDIO_UPLOAD_FAILED_${response.status}`);
  return {storagePath,fileName:file.name,mimeType:file.type,sizeBytes:file.size,localOnly:false};
}
async function playAudio(source,button){
  if(source.localAudioId&&ephemeralAudio.has(source.localAudioId)){setAudioPlayer(button,ephemeralAudio.get(source.localAudioId));return}
  if(!source.storagePath){announce('저장된 오디오 파일이 없습니다.');return}
  try{
    const token=await window.LeaderOsReportRuntimeBridge.authAccessToken();
    const cfg=window.LeaderOsReportRuntimeBridge.runtimeConfig();
    const url=`${cfg.supabaseUrl}/storage/v1/object/authenticated/${AUDIO_BUCKET}/${source.storagePath.split('/').map(encodeURIComponent).join('/')}`;
    const res=await fetch(url,{headers:{apikey:cfg.publishableKey,Authorization:`Bearer ${token}`}});
    if(!res.ok)throw new Error(`AUDIO_DOWNLOAD_FAILED_${res.status}`);
    const blob=await res.blob();setAudioPlayer(button,URL.createObjectURL(blob));
  }catch(error){announce(`오디오를 불러오지 못했습니다: ${error?.message||error}`)}
}
function setAudioPlayer(button,url){
  const sourceCard=button.closest('.r61-source');let audio=q('audio',sourceCard);
  if(!audio){audio=document.createElement('audio');audio.className='r61-audio';audio.controls=true;sourceCard.append(audio)}
  audio.src=url;audio.play().catch(()=>{});
}
function announce(text){try{window.LeaderOsReportRuntimeBridge?.announce?.(text)}catch{};const status=q('[data-r61-status]');if(status)status.textContent=text}

function selectPerson(personId){
  store.activePersonId=personId;save('SELECT_PERSON');renderAll();
}
function addPerson(){
  const personId=id('PERSON');
  store.profiles[personId]=blankProfile({personId,personName:'새 사람',role:''});
  store.activePersonId=personId;save('ADD_PERSON');renderAll();
  setTimeout(()=>q('[data-r61-profile-name]')?.focus(),60);
}

function requestStatusLabel(status){
  return ({ACTIVE:'확인 대기',SUBMITTED:'검토 필요',APPLIED:'적용 완료',REJECTED:'적용 안 함',REVOKED:'링크 취소',EXPIRED:'만료'})[status]||status;
}
function preferenceDiffHtml(p,req){
  const proposal=req.proposal||{},fields=[
    ['instructionPreference','업무 지시'],
    ['autonomyPreference','자율 수준'],
    ['checkpointPreference','Checkpoint'],
    ['feedbackPreference','Feedback'],
    ['reportingPreference','Reporting'],
    ['communicationPreference','Communication'],
    ['focusPreference','집중/작업 리듬'],
    ['availabilityPreference','연락 선호']
  ];
  const changed=fields.filter(([key])=>String(p[key]||'')!==String(proposal[key]||''));
  if(!changed.length)return '<div class="r64-no-change">현재 기록과 동일합니다.</div>';
  return `<div class="r64-diffs">${changed.map(([key,label])=>`<div class="r64-diff"><b>${esc(label)}</b><span class="old">${esc(p[key]||'—')}</span><span class="arrow">→</span><span class="new">${esc(proposal[key]||'—')}</span></div>`).join('')}</div>`;
}

function buildPreferenceShareUrl(token){
  try{
    const u=new URL(window.location.href);
    u.searchParams.delete('peopleConfirm');
    u.hash=`peopleConfirm=${encodeURIComponent(token)}`;
    return u.toString();
  }catch{return `#peopleConfirm=${encodeURIComponent(token)}`}
}

function teamMemberConfirmationHtml(p){
  const signed=state().signedIn&&state().workspaceId;
  const requests=preferenceRequests.filter((r)=>r.person_id===p.personId||r.personId===p.personId);
  const liveLink=lastPreferenceLinks.get(p.personId);
  const latest=requests[0]||null;
  const history=(p.preferenceHistory||[]).slice(-5).reverse();
  return `<section class="r64-member-confirm">
    <div class="r64-member-head"><div><div class="section-kicker">TEAM MEMBER CONFIRMATION</div><h3>본인이 업무 선호를 확인·수정할 수 있게 합니다.</h3><p>공개 링크에는 업무 선호 항목만 보입니다. PRIVATE 메모·1:1·Audio/Transcript·Pattern reasoning은 전달되지 않습니다.</p></div>
      <div class="artifact-actions"><button type="button" data-r64-refresh-requests ${signed?'':'disabled'}>상태 새로고침</button><button type="button" class="primary" data-r64-create-request ${signed?'':'disabled'}>7일 확인 링크 만들기</button></div></div>
    ${!signed?'<div class="r61-safe">실제 확인 링크 생성은 로그인 + Workspace 연결 후 사용할 수 있습니다.</div>':''}
    ${liveLink?`<div class="r64-link-box"><input readonly data-r64-link value="${esc(liveLink)}"><button type="button" data-r64-copy-link>링크 복사</button><span>보안상 이 링크는 생성 직후 현재 세션에서만 다시 볼 수 있습니다.${window.location.protocol==='file:'?' 현재는 로컬 Preview 주소이므로 외부 공유는 배포 URL에서 사용하세요.':''}</span></div>`:''}
    ${latest?`<div class="r64-request-card ${String(latest.status||'').toLowerCase()}">
      <div class="r64-request-top"><b>${requestStatusLabel(latest.status)}</b><span>${esc(String(latest.created_at||latest.createdAt||'').slice(0,16).replace('T',' '))} · 만료 ${esc(String(latest.expires_at||latest.expiresAt||'').slice(0,10))}</span></div>
      ${latest.status==='SUBMITTED'?`${preferenceDiffHtml(p,latest)}${latest.comment?`<div class="r64-comment"><b>팀원 메모</b>${esc(latest.comment)}</div>`:''}<div class="artifact-actions"><button type="button" class="primary" data-r64-apply-request="${esc(latest.request_id||latest.requestId)}">변경점 검토 후 Apply</button><button type="button" data-r64-reject-request="${esc(latest.request_id||latest.requestId)}">적용하지 않음</button></div>`:''}
      ${latest.status==='ACTIVE'?`<div class="artifact-actions"><button type="button" data-r64-revoke-request="${esc(latest.request_id||latest.requestId)}">확인 링크 취소</button></div>`:''}
    </div>`:'<div class="r64-no-request">아직 생성된 확인 요청이 없습니다.</div>'}
    ${history.length?`<details class="r64-pref-history"><summary>Preference 적용 이력 ${history.length}</summary>${history.map(h=>`<div><b>${esc(String(h.appliedAt||'').slice(0,10))}</b><span>${esc((h.changedFields||[]).join(', ')||'변경 없음')} · ${esc(h.source||'')}</span></div>`).join('')}</details>`:''}
  </section>`;
}

function profileFormHtml(p){
  return `<div class="r61-grid">
    <div class="r61-field"><label>이름</label><input data-r61-profile-name value="${esc(p.personName)}"></div>
    <div class="r61-field"><label>역할</label><input data-r61-profile-role value="${esc(p.role)}" placeholder="예: Creative Lead"></div>
    <div class="r61-field full"><label>업무 지시 선호 · Self-reported</label><textarea data-r61-instruction placeholder="예: 긴 설명보다 Goal → Reference → Done Criteria가 있으면 이해가 빠름">${esc(p.instructionPreference)}</textarea></div>
    <div class="r61-field"><label>자율 수준 선호</label><select data-r61-autonomy>
      ${[['','아직 확인하지 않음'],['GUIDE','GUIDE · 구체적 안내'],['COACH','COACH · 질문하며 설계'],['SUPPORT','SUPPORT · 판단 맡기고 지원'],['DELEGATE','DELEGATE · 결과 기준 중심']].map(([v,l])=>`<option value="${v}" ${p.autonomyPreference===v?'selected':''}>${l}</option>`).join('')}
    </select></div>
    <div class="r61-field"><label>Checkpoint 선호</label><input data-r61-checkpoint value="${esc(p.checkpointPreference)}" placeholder="예: 30% 시점 Direction Check"></div>
    <div class="r61-field"><label>Feedback 선호</label><input data-r61-feedback value="${esc(p.feedbackPreference)}" placeholder="예: 1:1에서 구체적인 수정 포인트"></div>
    <div class="r61-field"><label>Reporting 선호</label><input data-r61-reporting value="${esc(p.reportingPreference)}" placeholder="예: 문서/이미지로 결과 중심 보고"></div>
    <div class="r61-field"><label>Communication 선호</label><input data-r61-communication value="${esc(p.communicationPreference)}" placeholder="예: Slack 요약 + 문서 링크"></div>
    <div class="r61-field"><label>집중 / 작업 리듬</label><input data-r61-focus value="${esc(p.focusPreference)}" placeholder="예: 오전 집중업무, 오후 리뷰"></div>
    <div class="r61-field"><label>업무상 연락 가능/선호 시간</label><input data-r61-availability value="${esc(p.availabilityPreference)}" placeholder="예: 18시 이후 비동기 메시지 선호"></div>
    <div class="r61-field full"><label>자가표기 스타일 라벨 · Reference only</label><input data-r61-style value="${esc(p.styleLabel)}" placeholder="예: 본인이 공유한 MBTI 또는 업무 스타일 키워드"></div>
  </div>
  <div class="r61-safe"><strong>자동 최적화에서 제외</strong> · 나이, 가족관계, 집안사정, 건강, 종교, 정치성향 등 사적/민감 정보는 업무지시·평가·배분의 근거로 사용하지 않습니다. 자가표기 성향 라벨도 참고 표시만 하고 Brief 생성에는 사용하지 않습니다.</div>
  <div class="r63-preference-confirm">
    <div><b>Self-reported preference 확인</b><span>${p.preferenceConfirmedAt?`확인됨 · ${esc(String(p.preferenceConfirmedAt).slice(0,10))}`:'미확인 · 업무지시 자동 최적화에는 사용하지 않음'}</span></div>
    <div class="artifact-actions"><button type="button" data-r63-copy-preference-request>직접 확인용 문구 복사</button><button type="button" data-r63-confirm-preferences>직접 대화로 확인 완료</button></div>
  </div>
  ${teamMemberConfirmationHtml(p)}
  <div class="artifact-actions" style="margin-top:10px"><button class="primary" type="button" data-r61-save-profile>Working Persona 저장</button><span data-r61-status class="review-meta">${state().signedIn?'PRIVATE Workspace sync':'Local / Demo'}</span></div>`;
}

function addDaysIso(days){
  const d=new Date();d.setDate(d.getDate()+days);return d.toISOString();
}
function patternReviewDue(pattern){
  if(String(pattern?.state||'')!=='CONFIRMED')return false;
  const revalidate=pattern.revalidateAt?Date.parse(pattern.revalidateAt):NaN;
  if(Number.isFinite(revalidate))return revalidate<=Date.now();
  const reviewed=Date.parse(pattern.reviewedAt||pattern.confirmedAt||pattern.updatedAt||'');
  return Number.isFinite(reviewed)&&(Date.now()-reviewed)>90*86400000;
}
function localReviewQueue(p){
  const queue=[];
  const byCategory={};
  for(const x of p.patterns||[]){
    if(x.state==='CANDIDATE')queue.push({kind:'CANDIDATE_PATTERN',personId:p.personId,patternId:x.id,category:x.category,statement:x.statement,sourceRefs:x.sourceRefs||[],reason:'Human Confirm required'});
    if(x.state==='CONFIRMED'){
      (byCategory[x.category]??=[]).push(x);
      if(patternReviewDue(x))queue.push({kind:'REVALIDATION_DUE',personId:p.personId,patternId:x.id,category:x.category,statement:x.statement,reviewedAt:x.reviewedAt||x.confirmedAt||x.updatedAt,reason:'Confirmed pattern needs revalidation'});
    }
  }
  for(const [category,items] of Object.entries(byCategory)){
    const distinct=[...new Set(items.map(x=>String(x.statement||'').trim()).filter(Boolean))];
    if(distinct.length>1)queue.push({kind:'POSSIBLE_CONFLICT',personId:p.personId,category,patternIds:items.map(x=>x.id),statements:distinct,reason:'같은 카테고리에 서로 다른 Confirmed Pattern이 있습니다. 상황/업무 종류에 따른 차이인지 검토하세요.'});
  }
  for(const src of sources(p.personId)){
    if(src.sourceKind==='AUDIO_TRANSCRIPT'&&!String(src.transcriptExcerpt||'').trim())queue.push({kind:'TRANSCRIPT_NEEDED',personId:p.personId,sourceId:src.sourceId,fileName:src.fileName||'',reason:'Audio 저장됨 · Transcript 검토 필요'});
  }
  return queue;
}
function reviewQueueFor(p){
  const server=(store.serverReviewQueue||[]).filter(x=>x.personId===p.personId);
  const local=localReviewQueue(p);
  const member=preferenceRequests.filter((r)=>(r.person_id===p.personId||r.personId===p.personId)&&r.status==='SUBMITTED').map((r)=>({kind:'PREFERENCE_SUBMITTED',personId:p.personId,requestId:r.request_id||r.requestId,reason:'팀원이 Working Preference 수정안을 제출했습니다.'}));
  const seen=new Set(),out=[];
  for(const item of [...server,...local,...member]){
    const k=[item.kind,item.patternId||'',item.sourceId||'',item.category||'',JSON.stringify(item.patternIds||[])].join('|');
    if(seen.has(k))continue;seen.add(k);out.push(item);
  }
  return out;
}
function reviewQueueHtml(p){
  const items=reviewQueueFor(p);
  const counts={candidate:items.filter(x=>x.kind==='CANDIDATE_PATTERN'||x.kind==='SOURCE_PATTERN_REVIEW').length,due:items.filter(x=>x.kind==='REVALIDATION_DUE').length,conflict:items.filter(x=>x.kind==='POSSIBLE_CONFLICT').length,transcript:items.filter(x=>x.kind==='TRANSCRIPT_NEEDED').length,member:items.filter(x=>x.kind==='PREFERENCE_SUBMITTED').length};
  const cards=items.map(item=>{
    if(item.kind==='CANDIDATE_PATTERN')return `<article class="r63-review-card"><span class="r61-badge candidate">CANDIDATE</span><b>${esc(item.category)} · ${esc(item.statement)}</b><p>${esc(item.reason||'')}</p><div class="artifact-actions"><button type="button" data-r63-review-confirm="${esc(item.patternId)}">Human Confirm</button></div></article>`;
    if(item.kind==='REVALIDATION_DUE')return `<article class="r63-review-card due"><span class="r61-badge review-due">REVALIDATE</span><b>${esc(item.category)} · ${esc(item.statement)}</b><p>마지막 확인 ${esc(String(item.reviewedAt||'—').slice(0,10))}. 현재도 유효한지 실제 최근 업무에서 다시 확인하세요.</p><div class="artifact-actions"><button type="button" data-r63-review-revalidate="${esc(item.patternId)}">현재도 유효 · +90일</button></div></article>`;
    if(item.kind==='POSSIBLE_CONFLICT')return `<article class="r63-review-card conflict"><span class="r61-badge candidate">REVIEW</span><b>${esc(item.category)} · 상충 가능성</b><p>${(item.statements||[]).map(x=>`“${esc(x)}”`).join(' / ')}</p><div class="r61-meta">자동으로 어느 쪽도 삭제하지 않습니다. 업무 종류/상황별 조건을 Source에서 다시 확인하세요.</div></article>`;
    if(item.kind==='TRANSCRIPT_NEEDED')return `<article class="r63-review-card"><span class="r61-badge private">TRANSCRIPT</span><b>${esc(item.fileName||'Audio Source')}</b><p>${esc(item.reason||'')}</p><textarea data-r63-transcript-text="${esc(item.sourceId)}" placeholder="검토한 Transcript를 붙여 넣으세요. 자동 STT 제공자는 아직 연결되지 않았습니다."></textarea><div class="artifact-actions"><button type="button" data-r63-save-transcript="${esc(item.sourceId)}">Transcript 저장</button></div></article>`;
    if(item.kind==='SOURCE_PATTERN_REVIEW')return `<article class="r63-review-card"><span class="r61-badge candidate">SOURCE REVIEW</span><b>${esc(item.sourceKind||'SOURCE')}</b><p>${(item.candidatePatterns||[]).map(x=>`${esc(x.category)} · ${esc(x.statement)}`).join(' / ')}</p><div class="r61-meta">Source의 Candidate를 Working Persona에서 검토하세요.</div></article>`;
    if(item.kind==='PREFERENCE_SUBMITTED')return `<article class="r63-review-card member"><span class="r61-badge confirmed">TEAM MEMBER</span><b>Working Preference 수정안 제출</b><p>${esc(item.reason||'')}</p><div class="artifact-actions"><button type="button" data-r64-review-member>Working Persona에서 비교 →</button></div></article>`;
    return '';
  }).join('');
  return `<div class="r63-review-summary"><div><b>${counts.candidate}</b><span>Candidate</span></div><div><b>${counts.due}</b><span>Revalidate</span></div><div><b>${counts.conflict}</b><span>Possible conflict</span></div><div><b>${counts.transcript+counts.member}</b><span>Response / Transcript</span></div></div>
    <div class="r63-review-note">Review Queue는 ‘사람에 대한 진실’을 자동 확정하지 않습니다. Source → 검토 → Human Confirm 순서를 강제합니다.</div>
    <div class="r63-review-list">${cards||'<div class="r61-safe">현재 검토가 필요한 항목이 없습니다.</div>'}</div>`;
}

function patternsHtml(p){
  const items=(p.patterns||[]).map((x)=>{
    const due=x.state==='CONFIRMED'&&patternReviewDue(x);
    return `<article class="r61-pattern ${due?'r63-review-due':''}">
    <div class="r61-pattern-head"><div><b>${esc(x.category)}</b><div>${esc(x.statement)}</div><div class="r61-meta">${esc((x.sourceRefs||[]).join(' · ')||'Source 연결 필요')}${x.state==='CONFIRMED'?` · Last review ${esc(String(x.reviewedAt||x.confirmedAt||x.updatedAt||'—').slice(0,10))}`:''}</div></div><span class="r61-badge ${due?'review-due':x.state==='CONFIRMED'?'confirmed':'candidate'}">${due?'REVIEW DUE':esc(x.state)}</span></div>
    <div class="artifact-actions" style="margin-top:7px">
      ${x.state!=='CONFIRMED'?`<button type="button" data-r61-confirm-pattern="${esc(x.id)}">Human Confirm</button>`:`<button type="button" data-r63-revalidate-pattern="${esc(x.id)}">재확인 +90일</button>`}
      <button type="button" data-r61-remove-pattern="${esc(x.id)}">삭제</button>
    </div>
  </article>`}).join('');
  return `<div class="r61-pattern-add">
    <select data-r61-pattern-category>${['BRIEF','AUTONOMY','CHECKPOINT','FEEDBACK','REPORTING','COMMUNICATION','MEETING','DECISION'].map(v=>`<option>${v}</option>`).join('')}</select>
    <input data-r61-pattern-text placeholder="예: Visual Reference + Done Criteria가 있을 때 재작업이 적었음">
    <button type="button" data-r61-add-pattern>Candidate 추가</button>
  </div>
  <div class="r61-pattern-list">${items||'<div class="r61-safe">아직 관찰 패턴이 없습니다. 대화/업무 Source에서 Candidate를 만들고, 반복 Evidence를 확인한 뒤 Human Confirm하세요.</div>'}</div>`;
}
function sourceHtml(source){
  return `<article class="r61-source">
    <div class="r61-source-head"><div><b>${esc(source.sourceKind||'NOTE')} · ${esc(source.occurredAt||'날짜 미지정')}</b><div class="r61-meta">${esc(source.summary||'')}</div></div><span class="r61-badge private">PRIVATE</span></div>
    ${source.fileName?`<div class="r61-meta" style="margin-top:6px">Audio · ${esc(source.fileName)} · ${Math.round(Number(source.sizeBytes||0)/1024)}KB ${source.localOnly?'· current session only':''}</div><button type="button" data-r61-play-source="${esc(source.sourceId)}" style="margin-top:6px">녹음 재생</button>`:''}
    ${source.transcriptExcerpt?`<details style="margin-top:7px"><summary>Transcript / note</summary><div class="r61-meta" style="white-space:pre-wrap;margin-top:6px">${esc(source.transcriptExcerpt)}</div></details>`:''}
    ${(source.candidatePatterns||[]).length?`<div class="r61-meta" style="margin-top:7px">Candidate · ${(source.candidatePatterns||[]).map(x=>`${esc(x.category)}: ${esc(x.statement)}`).join(' / ')}</div>`:''}
  </article>`;
}

function linkedOperatingEvidence(p){
  const bridge=window.LeaderOsOperatingArtifactBridge;
  if(!bridge?.byType)return [];
  const name=String(p.personName||'').trim().toLowerCase();
  if(!name)return [];
  const rows=[];
  const add=(type,row,title,summary,sourceKind)=>{
    rows.push({type,id:row.id,title,summary,sourceKind,updatedAt:row.updatedAt||'',artifactState:row.artifactState||'DRAFT'});
  };
  for(const row of bridge.byType('DELEGATION')||[]){
    if(String(row.owner||'').trim().toLowerCase()===name)add('DELEGATION',row,row.task||'Delegation',`권한 ${row.level||''} · Guardrail ${row.guardrail||''} · Checkpoint ${row.checkpoint||''}`,'WORK_RESULT');
  }
  for(const row of bridge.byType('FEEDBACK_PRACTICE')||[]){
    if(String(row.person||'').toLowerCase().includes(name))add('FEEDBACK_PRACTICE',row,row.situation||'Feedback',`${row.behavior||''} → ${row.impact||''} · Next ${row.next||''}`,'FEEDBACK');
  }
  for(const row of bridge.byType('ONE_ON_ONE_COMMITMENT')||[]){
    if(String(row.person||'').toLowerCase().includes(name))add('ONE_ON_ONE_COMMITMENT',row,row.commitment||'1:1 Commitment',`Due ${row.due||''} · Status ${row.status||''} · Evidence ${row.evidence||''}`,'ONE_ON_ONE');
  }
  return rows.sort((a,b)=>String(b.updatedAt).localeCompare(String(a.updatedAt))).slice(0,20);
}
function linkedEvidenceHtml(p){
  const items=linkedOperatingEvidence(p);
  if(!items.length)return '<div class="r61-safe">아직 이 사람과 연결된 Delegation / Feedback / 1:1 Commitment Artifact가 없습니다.</div>';
  return `<div class="r61-source-list">${items.map((x)=>`<article class="r61-source">
    <div class="r61-source-head"><div><b>${esc(x.type)} · ${esc(x.title)}</b><div class="r61-meta">${esc(x.summary)}</div></div><span class="r61-badge ${String(x.artifactState).toUpperCase()==='CONFIRMED'?'confirmed':'candidate'}">${esc(x.artifactState)}</span></div>
    <div class="artifact-actions" style="margin-top:7px"><button type="button" data-r62-import-evidence="${esc(x.type)}|${esc(x.id)}">Collaboration Source로 가져오기</button></div>
  </article>`).join('')}</div>`;
}
async function importOperatingEvidence(p,type,idValue){
  const row=(window.LeaderOsOperatingArtifactBridge?.byType?.(type)||[]).find((x)=>x.id===idValue);
  if(!row)return;
  let sourceKind='WORK_RESULT',summary='';
  if(type==='DELEGATION')summary=`${row.task||'위임'} · ${row.level||''} · ${row.checkpoint||''}`;
  if(type==='FEEDBACK_PRACTICE'){sourceKind='FEEDBACK';summary=`${row.situation||'Feedback'} · ${row.behavior||''} → ${row.impact||''} · Next ${row.next||''}`;}
  if(type==='ONE_ON_ONE_COMMITMENT'){sourceKind='ONE_ON_ONE';summary=`${row.commitment||'1:1 Commitment'} · ${row.status||''} · Due ${row.due||''}`;}
  const source={sourceId:id('SRC'),personId:p.personId,sourceKind,occurredAt:String(row.updatedAt||'').slice(0,10),summary,transcriptExcerpt:'',candidatePatterns:[],consentConfirmed:false,fileName:'',mimeType:'',sizeBytes:0,storagePath:'',updatedAt:now(),serverVersion:0,linkedArtifactType:type,linkedArtifactId:idValue};
  await persistSource(source);renderAll();announce(`${type}를 Collaboration Source로 가져왔습니다. 패턴은 자동 확정하지 않습니다.`);
}

function memoryHtml(p){
  const list=sources(p.personId);
  return `<div class="r61-memory-form">
    <div class="r61-memory-top">
      <div class="r61-field"><label>Source</label><select data-r61-source-kind><option>ONE_ON_ONE</option><option>AUDIO_TRANSCRIPT</option><option>WORK_RESULT</option><option>FEEDBACK</option><option>NOTE</option></select></div>
      <div class="r61-field"><label>날짜</label><input type="date" data-r61-source-date></div>
      <div class="r61-field"><label>요약</label><input data-r61-source-summary placeholder="무엇을 확인했는지 한 문장"></div>
    </div>
    <div class="r61-field" style="margin-top:8px"><label>Transcript / 관찰 메모</label><textarea data-r61-source-transcript placeholder="동의된 대화 기록, 업무 결과 관찰, 피드백 내용을 기록"></textarea></div>
    <div class="r61-pattern-add">
      <select data-r61-source-pattern-category>${['BRIEF','AUTONOMY','CHECKPOINT','FEEDBACK','REPORTING','COMMUNICATION','MEETING','DECISION'].map(v=>`<option>${v}</option>`).join('')}</select>
      <input data-r61-source-pattern placeholder="이 Source에서 확인할 Working Pattern Candidate">
      <span></span>
    </div>
    <div class="r61-file-row"><input type="file" accept="audio/*" data-r61-audio-file><span class="r61-meta">로그인 시 PRIVATE Storage · 최대 25MB</span></div>
    <label class="r61-consent"><input type="checkbox" data-r61-audio-consent><span>녹음 파일을 저장하는 경우 해당 대화의 녹음·보관에 필요한 동의와 회사 정책을 확인했습니다. Audio는 리더 개인 PRIVATE 영역에 저장됩니다.</span></label>
    <div class="artifact-actions" style="margin-top:9px"><button class="primary" type="button" data-r61-save-source>Collaboration Source 저장</button></div>
  </div>
  <div class="r61-source-list">${list.map(sourceHtml).join('')||'<div class="r61-safe">1:1, 녹음/Transcript, 업무 결과, 피드백을 Source로 쌓으세요. Source 자체가 사람의 성격 Fact가 되지는 않습니다.</div>'}</div>
  <div style="margin-top:14px"><div class="section-kicker">LINKED WORK EVIDENCE · HUMAN IMPORT</div><h3 style="margin:3px 0 7px">기존 Work / Feedback / 1:1 결과를 다시 People Memory로 연결</h3>${linkedEvidenceHtml(p)}</div>`;
}

function instructionOutcomeHtml(p){
  const inst=instructions(p.personId)[0];
  const results=sources(p.personId).filter(x=>x.sourceKind==='WORK_RESULT'&&x.linkedInstructionId);
  const rows=results.map(src=>({src,inst:instructions(p.personId).find(x=>x.instructionId===src.linkedInstructionId)})).filter(x=>x.inst);
  const personalized=rows.filter(x=>(x.inst.patternRefs||[]).length>0&&Number.isFinite(Number(x.src.outcomeSignals?.reworkRounds)));
  const baseline=rows.filter(x=>(x.inst.patternRefs||[]).length===0&&Number.isFinite(Number(x.src.outcomeSignals?.reworkRounds)));
  const avg=(arr)=>arr.length?(arr.reduce((n,x)=>n+Number(x.src.outcomeSignals.reworkRounds||0),0)/arr.length).toFixed(1):'—';
  const worked=(arr)=>arr.length?`${arr.filter(x=>x.src.outcomeSignals?.checkpointOutcome==='WORKED').length}/${arr.length}`:'—';
  return `<section class="r63-outcome">
    <div class="section-kicker">INSTRUCTION OUTCOME LEARNING · 사람 평가 아님</div>
    <h3>지시 방식이 실제 협업에 어떤 영향을 줬는지 기록</h3>
    ${inst?`<div class="r63-outcome-form">
      <div class="r61-field"><label>최근 Instruction</label><input value="${esc(inst.task||inst.instructionId)}" disabled></div>
      <div class="r61-field"><label>재작업 회차</label><input type="number" min="0" max="20" data-r63-rework value=""></div>
      <div class="r61-field"><label>Checkpoint 결과</label><select data-r63-checkpoint-outcome><option value="">선택</option><option value="WORKED">WORKED</option><option value="MIXED">MIXED</option><option value="MISSED">MISSED</option><option value="NOT_APPLICABLE">N/A</option></select></div>
      <div class="r61-field full"><label>Instruction Outcome Note</label><textarea data-r63-instruction-outcome placeholder="예: 초기 방향 확인 후 이후 수정이 줄었음. 업무 난이도 등 다른 요인도 함께 기록"></textarea></div>
      <button type="button" data-r63-save-outcome>Work Result Source 저장</button>
    </div>`:'<div class="r61-safe">먼저 People-aware Instruction Draft를 저장하세요.</div>'}
    <div class="r63-outcome-compare">
      <div><b>${avg(personalized)}</b><span>Pattern 적용 Draft · 평균 재작업 (${personalized.length}건)</span></div>
      <div><b>${avg(baseline)}</b><span>기본 Draft · 평균 재작업 (${baseline.length}건)</span></div>
      <div><b>${worked(personalized)}</b><span>Pattern 적용 · Checkpoint WORKED</span></div>
    </div>
    <div class="r63-outcome-caution">이 비교는 지시 설계 개선을 위한 방향성 Evidence입니다. 업무 난이도·기간·프로젝트 차이를 통제한 직원 성과평가가 아닙니다.</div>
  </section>`;
}

function briefHtml(p){
  const last=instructions(p.personId)[0]||null;
  return `<div class="r61-brief-form">
    <div class="r61-field"><label>업무</label><input data-r61-brief-task placeholder="예: 신규 캠페인 SNS KV 초안"></div>
    <div class="r61-field"><label>Goal</label><input data-r61-brief-goal placeholder="왜 이 일을 하는가"></div>
    <div class="r61-field full"><label>Context</label><textarea data-r61-brief-context placeholder="프로젝트 배경, 우선순위, 필요한 판단 맥락"></textarea></div>
    <div class="r61-field"><label>Output</label><textarea data-r61-brief-output placeholder="무엇을 제출해야 하는가"></textarea></div>
    <div class="r61-field"><label>Done Criteria</label><textarea data-r61-brief-done placeholder="완료/승인 기준"></textarea></div>
    <div class="r61-field"><label>Guardrail</label><input data-r61-brief-guardrail placeholder="예산·브랜드·정책·권한 범위"></div>
    <div class="r61-field"><label>기본 Checkpoint</label><input data-r61-brief-checkpoint placeholder="예: 수요일 30% Direction Check"></div>
  </div>
  <div class="artifact-actions" style="margin-top:10px"><button class="primary" type="button" data-r61-generate-brief>Working Persona로 업무지시 만들기</button></div>
  <div data-r61-brief-result>${last?briefOutputHtml(last):'<div class="r61-safe">업무 입력 후 생성하면, 확인된 업무 선호와 Confirmed Pattern만 사용해 Delegation Brief를 만듭니다.</div>'}</div>
  <div class="r61-instruction-history">${instructions(p.personId).slice(0,5).map((x)=>`<article class="r61-instruction-item"><b>${esc(x.task||'업무지시')}</b><div class="r61-meta">${esc(x.updatedAt||'')} · ${esc(x.autonomy||'')} · Pattern ${Array.isArray(x.patternRefs)?x.patternRefs.length:0}</div></article>`).join('')}</div>
  ${instructionOutcomeHtml(p)}`;
}
function briefOutputHtml(inst){
  return `<div class="r61-brief-output">
    <h3>${esc(inst.personName||'')}에게 전달할 업무지시 Draft</h3>
    ${[['TASK',inst.task],['GOAL',inst.goal],['CONTEXT',inst.context],['OUTPUT',inst.output],['DONE',inst.doneCriteria],['AUTHORITY',inst.autonomy],['GUARDRAIL',inst.guardrail],['CHECKPOINT',inst.checkpoint],['REPORTING',inst.reporting],['FEEDBACK',inst.feedback]].map(([k,v])=>`<div class="r61-brief-section"><b>${k}</b><div>${esc(v||'—')}</div></div>`).join('')}
    <div class="r61-brief-section"><b>WORKFLOW</b><div>${(inst.workflow||[]).map(x=>`<div>${esc(x)}</div>`).join('')}</div></div>
    <div class="r61-rationale"><b>적용 근거</b>${(inst.rationaleDetails||[]).length?`<div class="r63-rationale-list">${inst.rationaleDetails.map(x=>`<span><strong>${esc(x.field)}</strong> · ${esc(x.sourceType)} · ${esc(x.explanation)}</span>`).join('')}</div>`:` · 확인된 개인화 근거 없음 — 기본 Leader OS Brief 사용`}</div>
    <div class="r61-brief-actions">
      <button type="button" data-r61-save-instruction>PRIVATE Draft 저장</button>
      <button type="button" data-r61-create-delegation>Delegation Artifact로 보내기</button>
      <button type="button" data-r61-open-work>Work에서 보기</button>
      <button type="button" data-r61-copy-brief>복사</button>
    </div>
  </div>`;
}
function detailHtml(p,tab='PROFILE'){
  return `<div class="r61-person-head"><div><div class="section-kicker">WORKING PERSONA · PRIVATE</div><h2>${esc(p.personName||p.personId)}</h2><p>${esc(p.role||'Role 미지정')} · ${confirmedPatterns(p).length} confirmed patterns · ${sources(p.personId).length} sources</p></div>
    <div class="r61-person-actions"><button type="button" data-r61-go-oneonone>1:1 준비</button><button type="button" data-r61-go-coach>Leader Coach</button><button type="button" class="primary" data-r61-go-brief>업무지시 만들기</button></div></div>
  <div class="r61-tabs">${[['PROFILE','Working Persona'],['MEMORY','Collaboration Memory'],['PATTERNS','Observed Patterns'],['REVIEW',`Review Queue ${reviewQueueFor(p).length?`(${reviewQueueFor(p).length})`:''}`],['BRIEF','Instruction Workflow']].map(([v,l])=>`<button type="button" data-r61-tab="${v}" class="${tab===v?'active':''}">${l}</button>`).join('')}</div>
  <section class="r61-panel ${tab==='PROFILE'?'active':''}" data-r61-panel="PROFILE">${profileFormHtml(p)}</section>
  <section class="r61-panel ${tab==='MEMORY'?'active':''}" data-r61-panel="MEMORY">${memoryHtml(p)}</section>
  <section class="r61-panel ${tab==='PATTERNS'?'active':''}" data-r61-panel="PATTERNS">${patternsHtml(p)}</section>
  <section class="r61-panel ${tab==='REVIEW'?'active':''}" data-r61-panel="REVIEW">${reviewQueueHtml(p)}</section>
  <section class="r61-panel ${tab==='BRIEF'?'active':''}" data-r61-panel="BRIEF">${briefHtml(p)}</section>`;
}
let activeTab='PROFILE';
function renderRoster(){
  const root=q('[data-r61-roster-list]');if(!root)return;
  const people=seedPeople();if(!store.activePersonId&&people[0])store.activePersonId=people[0].personId;
  root.innerHTML=people.map((p)=>{
    const pr=profile(p.personId),confirmed=confirmedPatterns(pr).length,src=sources(p.personId).length;
    return `<button type="button" class="r61-roster-item ${store.activePersonId===p.personId?'active':''}" data-r61-person="${esc(p.personId)}"><span class="r61-avatar">${esc((p.personName||'?').slice(0,1))}</span><span class="r61-roster-copy"><b>${esc(p.personName)}</b><span>${esc(p.role||'Role 미지정')} · ${confirmed} patterns · ${src} sources</span></span><span class="r61-roster-state">→</span></button>`;
  }).join('');
  qa('[data-r61-person]',root).forEach(btn=>btn.addEventListener('click',()=>{activeTab='PROFILE';selectPerson(btn.dataset.r61Person)}));
}
function bindDetail(p){
  qa('[data-r61-tab]').forEach(btn=>btn.addEventListener('click',()=>{activeTab=btn.dataset.r61Tab;renderDetail()}));

  q('[data-r64-create-request]')?.addEventListener('click',async()=>{
    if(!state().signedIn){announce('로그인 후 사용할 수 있습니다.');return}
    announce('팀원 확인 링크 생성 중…');
    try{
      const result=await window.LeaderOsReportRuntimeBridge.createPeoplePreferenceRequest(p.personId,7);
      const req=result?.preferenceRequest;
      if(req?.token)lastPreferenceLinks.set(p.personId,buildPreferenceShareUrl(req.token));
      await refreshPreferenceRequests(p.personId);
      renderDetail();announce('7일간 유효한 Working Preference 확인 링크를 만들었습니다.');
    }catch(error){announce(`확인 링크 생성 실패: ${error?.code||error?.message||error}`)}
  });
  q('[data-r64-copy-link]')?.addEventListener('click',async()=>{
    const link=lastPreferenceLinks.get(p.personId)||q('[data-r64-link]')?.value||'';
    try{await navigator.clipboard.writeText(link);announce('팀원 확인 링크를 복사했습니다.')}catch{announce('링크를 복사할 수 없습니다.')}
  });
  q('[data-r64-refresh-requests]')?.addEventListener('click',async()=>{await refreshPreferenceRequests(p.personId);renderDetail();announce('확인 요청 상태를 새로고침했습니다.')});
  qa('[data-r64-apply-request]').forEach(btn=>btn.addEventListener('click',async()=>{
    announce('팀원 수정안을 Working Persona에 적용 중…');
    try{
      await window.LeaderOsReportRuntimeBridge.applyPeoplePreferenceRequest({
        preferenceRequestId:btn.dataset.r64ApplyRequest,
        expectedProfileVersion:Number(p.serverVersion||0),
        eventId:`PEOPLE-PREF-APPLY-${Date.now().toString(36)}`
      });
      lastPreferenceLinks.delete(p.personId);
      await hydrate(true);activeTab='PROFILE';renderDetail();announce('팀원 확인 내용을 Human Review 후 적용했습니다.');
    }catch(error){announce(`적용 실패: ${error?.code||error?.message||error}`)}
  }));
  qa('[data-r64-reject-request],[data-r64-revoke-request]').forEach(btn=>btn.addEventListener('click',async()=>{
    const requestId=btn.dataset.r64RejectRequest||btn.dataset.r64RevokeRequest;
    const decision=btn.dataset.r64RejectRequest?'REJECTED':'REVOKED';
    try{
      await window.LeaderOsReportRuntimeBridge.resolvePeoplePreferenceRequest({preferenceRequestId:requestId,decision});
      if(decision==='REVOKED')lastPreferenceLinks.delete(p.personId);
      await refreshPreferenceRequests(p.personId);renderDetail();announce(decision==='REJECTED'?'수정안을 적용하지 않았습니다.':'확인 링크를 취소했습니다.');
    }catch(error){announce(`요청 처리 실패: ${error?.code||error?.message||error}`)}
  }));
  q('[data-r64-review-member]')?.addEventListener('click',()=>{activeTab='PROFILE';renderDetail();setTimeout(()=>q('.r64-member-confirm')?.scrollIntoView({behavior:'smooth',block:'center'}),60)});

  q('[data-r61-save-profile]')?.addEventListener('click',async()=>{
    const next={...p,
      personName:q('[data-r61-profile-name]')?.value?.trim()||p.personName,
      role:q('[data-r61-profile-role]')?.value?.trim()||'',
      instructionPreference:q('[data-r61-instruction]')?.value?.trim()||'',
      autonomyPreference:q('[data-r61-autonomy]')?.value||'',
      checkpointPreference:q('[data-r61-checkpoint]')?.value?.trim()||'',
      feedbackPreference:q('[data-r61-feedback]')?.value?.trim()||'',
      reportingPreference:q('[data-r61-reporting]')?.value?.trim()||'',
      communicationPreference:q('[data-r61-communication]')?.value?.trim()||'',
      focusPreference:q('[data-r61-focus]')?.value?.trim()||'',
      availabilityPreference:q('[data-r61-availability]')?.value?.trim()||'',
      styleLabel:q('[data-r61-style]')?.value?.trim()||'',
      preferenceConfirmedAt:p.preferenceConfirmedAt||''
    };
    announce('Working Persona 저장 중…');await persistProfile(next);renderAll();announce('Working Persona를 저장했습니다.');
  });
  q('[data-r61-add-pattern]')?.addEventListener('click',async()=>{
    const text=q('[data-r61-pattern-text]')?.value?.trim();if(!text)return;
    const next={...p,patterns:[...(p.patterns||[]),{id:id('PATTERN'),category:q('[data-r61-pattern-category]')?.value||'BRIEF',statement:text,state:'CANDIDATE',sourceRefs:[],updatedAt:now()}]};
    await persistProfile(next);renderAll();
  });
  qa('[data-r61-confirm-pattern]').forEach(btn=>btn.addEventListener('click',async()=>{
    const stamp=now(),reviewAt=addDaysIso(90);
    const next={...p,patterns:(p.patterns||[]).map(x=>x.id===btn.dataset.r61ConfirmPattern?{...x,state:'CONFIRMED',confirmedAt:x.confirmedAt||stamp,reviewedAt:stamp,revalidateAt:reviewAt,updatedAt:stamp}:x)};
    await persistProfile(next);renderAll();
  }));
  qa('[data-r61-remove-pattern]').forEach(btn=>btn.addEventListener('click',async()=>{
    const next={...p,patterns:(p.patterns||[]).filter(x=>x.id!==btn.dataset.r61RemovePattern)};
    await persistProfile(next);renderAll();
  }));

  q('[data-r63-copy-preference-request]')?.addEventListener('click',async()=>{
    const text=`함께 일하는 방식을 더 잘 맞추기 위해 확인하고 싶습니다.\n- 업무 지시: ${p.instructionPreference||'어떤 형식이 가장 도움이 되는지'}\n- Checkpoint: ${p.checkpointPreference||'언제 확인받는 것이 편한지'}\n- Feedback: ${p.feedbackPreference||'어떤 방식이 도움이 되는지'}\n- Reporting: ${p.reportingPreference||'어떤 형태가 효율적인지'}\n수정하거나 다르게 느끼는 부분이 있으면 알려주세요.`;
    try{await navigator.clipboard.writeText(text);announce('본인 확인 요청 문구를 복사했습니다.')}catch{announce('복사할 수 없습니다.')}
  });
  q('[data-r63-confirm-preferences]')?.addEventListener('click',async()=>{
    const next={...p,preferenceConfirmedAt:now()};await persistProfile(next);renderAll();announce('Self-reported preference의 본인 확인 시점을 기록했습니다.');
  });
  qa('[data-r63-revalidate-pattern],[data-r63-review-revalidate]').forEach(btn=>btn.addEventListener('click',async()=>{
    const pid=btn.dataset.r63RevalidatePattern||btn.dataset.r63ReviewRevalidate,stamp=now();
    const next={...p,patterns:(p.patterns||[]).map(x=>x.id===pid?{...x,reviewedAt:stamp,revalidateAt:addDaysIso(90),updatedAt:stamp}:x)};
    await persistProfile(next);renderAll();announce('Pattern을 재확인하고 90일 뒤 다시 검토하도록 설정했습니다.');
  }));
  qa('[data-r63-review-confirm]').forEach(btn=>btn.addEventListener('click',async()=>{
    const pid=btn.dataset.r63ReviewConfirm,stamp=now();
    const next={...p,patterns:(p.patterns||[]).map(x=>x.id===pid?{...x,state:'CONFIRMED',confirmedAt:x.confirmedAt||stamp,reviewedAt:stamp,revalidateAt:addDaysIso(90),updatedAt:stamp}:x)};
    await persistProfile(next);renderAll();announce('Review Queue에서 Pattern을 Human Confirm했습니다.');
  }));
  qa('[data-r63-save-transcript]').forEach(btn=>btn.addEventListener('click',async()=>{
    const sourceId=btn.dataset.r63SaveTranscript,src=sources(p.personId).find(x=>x.sourceId===sourceId);
    const text=q(`[data-r63-transcript-text="${sourceId}"]`)?.value?.trim()||'';
    if(!src||!text){announce('Transcript 내용을 입력하세요.');return}
    await persistSource({...src,transcriptExcerpt:text,consentConfirmed:true});renderAll();announce('검토한 Transcript를 Source에 저장했습니다.');
  }));
  q('[data-r63-save-outcome]')?.addEventListener('click',async()=>{
    const inst=instructions(p.personId)[0];if(!inst){announce('저장된 Instruction Draft가 없습니다.');return}
    const reworkRaw=q('[data-r63-rework]')?.value;
    const source={sourceId:id('SRC'),personId:p.personId,sourceKind:'WORK_RESULT',occurredAt:now().slice(0,10),
      summary:`Instruction Outcome · ${inst.task||inst.instructionId}`,transcriptExcerpt:'',candidatePatterns:[],consentConfirmed:false,
      fileName:'',mimeType:'',sizeBytes:0,storagePath:'',linkedInstructionId:inst.instructionId,
      reworkRounds:reworkRaw===''?null:Number(reworkRaw),checkpointOutcome:q('[data-r63-checkpoint-outcome]')?.value||'',
      instructionOutcome:q('[data-r63-instruction-outcome]')?.value?.trim()||'',outcomeSignals:{
        reworkRounds:reworkRaw===''?null:Number(reworkRaw),
        checkpointOutcome:q('[data-r63-checkpoint-outcome]')?.value||'',
        instructionOutcome:q('[data-r63-instruction-outcome]')?.value?.trim()||''
      },updatedAt:now(),serverVersion:0};
    await persistSource(source);renderAll();activeTab='BRIEF';renderDetail();announce('Instruction Outcome을 Work Result Source로 저장했습니다.');
  });

  q('[data-r61-save-source]')?.addEventListener('click',async()=>{
    const sourceKind=q('[data-r61-source-kind]')?.value||'NOTE',file=q('[data-r61-audio-file]')?.files?.[0]||null;
    const consent=Boolean(q('[data-r61-audio-consent]')?.checked);
    if(file&&!consent){announce('녹음 파일 저장 전 동의/정책 확인 체크가 필요합니다.');return}
    let audio={storagePath:'',fileName:'',mimeType:'',sizeBytes:0,localOnly:false};
    try{if(file){announce('녹음 파일 저장 중…');audio=await uploadAudio(file,p.personId)}}catch(error){announce(error?.message||String(error));return}
    const patternStatement=q('[data-r61-source-pattern]')?.value?.trim()||'';
    const source={sourceId:id('SRC'),personId:p.personId,sourceKind,occurredAt:q('[data-r61-source-date]')?.value||'',summary:q('[data-r61-source-summary]')?.value?.trim()||'',transcriptExcerpt:q('[data-r61-source-transcript]')?.value?.trim()||'',candidatePatterns:patternStatement?[{category:q('[data-r61-source-pattern-category]')?.value||'BRIEF',statement:patternStatement}]:[],consentConfirmed:consent,...audio,updatedAt:now(),serverVersion:0};
    if(sourceKind==='AUDIO_TRANSCRIPT'&&!consent){announce('AUDIO_TRANSCRIPT는 동의 확인이 필요합니다.');return}
    await persistSource(source);
    if(patternStatement){
      const next=profile(p.personId);next.patterns=[...(next.patterns||[]),{id:id('PATTERN'),category:source.candidatePatterns[0].category,statement:patternStatement,state:'CANDIDATE',sourceRefs:[source.sourceId],updatedAt:now()}];await persistProfile(next);
    }
    renderAll();announce('Collaboration Source를 저장했습니다.');
  });
  qa('[data-r61-play-source]').forEach(btn=>btn.addEventListener('click',()=>{const src=sources(p.personId).find(x=>x.sourceId===btn.dataset.r61PlaySource);if(src)playAudio(src,btn)}));
  qa('[data-r62-import-evidence]').forEach(btn=>btn.addEventListener('click',()=>{
    const [type,idValue]=String(btn.dataset.r62ImportEvidence||'').split('|');
    if(type&&idValue)importOperatingEvidence(p,type,idValue);
  }));
  q('[data-r61-generate-brief]')?.addEventListener('click',()=>{
    const inst=generateInstruction(p,{
      task:q('[data-r61-brief-task]')?.value?.trim()||'',goal:q('[data-r61-brief-goal]')?.value?.trim()||'',context:q('[data-r61-brief-context]')?.value?.trim()||'',output:q('[data-r61-brief-output]')?.value?.trim()||'',doneCriteria:q('[data-r61-brief-done]')?.value?.trim()||'',guardrail:q('[data-r61-brief-guardrail]')?.value?.trim()||'',checkpoint:q('[data-r61-brief-checkpoint]')?.value?.trim()||''
    });
    if(!inst.task&&!inst.goal){announce('업무 또는 Goal을 먼저 입력하세요.');return}
    lastInstruction=inst;q('[data-r61-brief-result]').innerHTML=briefOutputHtml(inst);bindBriefButtons(p,inst);
  });
  q('[data-r61-go-oneonone]')?.addEventListener('click',()=>openOneOnOne(p.personId));
  q('[data-r61-go-coach]')?.addEventListener('click',()=>openCoach(p.personId));
  q('[data-r61-go-brief]')?.addEventListener('click',()=>{activeTab='BRIEF';renderDetail()});
  const existing=instructions(p.personId)[0];if(existing)bindBriefButtons(p,existing);
}
function bindBriefButtons(p,inst){
  q('[data-r61-save-instruction]')?.addEventListener('click',async()=>{await persistInstruction(inst);renderAll();announce('People-aware 업무지시 Draft를 PRIVATE로 저장했습니다.')});
  q('[data-r61-create-delegation]')?.addEventListener('click',async()=>{
    await persistInstruction(inst);
    const artifact=window.LeaderOsOperatingArtifactBridge?.create?.('DELEGATION',{
      task:inst.task,owner:p.personName,level:inst.autonomy,guardrail:inst.guardrail,checkpoint:inst.checkpoint
    });
    announce(artifact?'Delegation Artifact Draft를 만들었습니다.':'Delegation Artifact를 만들지 못했습니다.');
    if(artifact)window.LeaderOsOperatingArtifactBridge?.openType?.('DELEGATION');
  });
  q('[data-r61-open-work]')?.addEventListener('click',()=>{lastInstruction=inst;openPage('WORK')});
  q('[data-r61-copy-brief]')?.addEventListener('click',async()=>{
    const text=[`[${p.personName}] ${inst.task}`,`Goal: ${inst.goal}`,`Context: ${inst.context}`,`Output: ${inst.output}`,`Done: ${inst.doneCriteria}`,`Authority: ${inst.autonomy}`,`Guardrail: ${inst.guardrail}`,`Checkpoint: ${inst.checkpoint}`,`Reporting: ${inst.reporting}`,`Feedback: ${inst.feedback}`,...(inst.workflow||[])].join('\n');
    try{await navigator.clipboard.writeText(text);announce('업무지시 Draft를 복사했습니다.')}catch{announce('복사할 수 없습니다.')}
  });
}
function renderDetail(){
  const root=q('[data-r61-person-detail]'),empty=q('[data-r61-person-empty]'),person=selectedPerson();
  if(!root||!empty)return;
  if(!person){root.hidden=true;empty.hidden=false;return}
  const p=profile(person.personId);root.hidden=false;empty.hidden=true;root.innerHTML=detailHtml(p,activeTab);bindDetail(p)
}
function openPage(page){
  const a=q(`[data-fallback-page="${page}"],[data-page-link="${page}"],[data-route="${page}"]`);
  if(a){a.click();return true}
  for(const el of qa('[data-page]'))el.hidden=el.dataset.page!==page;
  return true;
}
function openOneOnOne(personId){store.activePersonId=personId;save('1ON1');renderCrossSections();openPage('ONE_ON_ONE')}
function openCoach(personId){store.activePersonId=personId;save('COACH');renderCrossSections();openPage('LEADER_COACH')}
function renderCrossSections(){
  const person=selectedPerson();if(!person)return;
  const p=profile(person.personId),summary=workingSummary(p),candidates=candidatePatterns(p);
  const one=q('[data-r61-oneonone-context]'),oneBody=q('[data-r61-oneonone-context-body]');
  if(one&&oneBody){
    one.hidden=false;oneBody.innerHTML=`<h3>${esc(p.personName)} · 1:1 People Context</h3><p>${summary.length?esc(summary.slice(0,4).join(' · ')):'아직 확인된 Working Persona가 없습니다. 이번 1:1에서 업무 선호와 협업 방식을 직접 확인하세요.'}</p>${candidates.length?`<div class="r61-meta" style="margin-top:6px">확인할 Candidate · ${candidates.slice(0,3).map(x=>esc(x.statement)).join(' / ')}</div>`:''}<div class="r61-cross-actions"><button type="button" data-r61-back-people>People 열기</button></div>`;
    q('[data-one-on-one-person]')?.replaceChildren(Object.assign(document.createElement('div'),{innerHTML:`<strong>${esc(p.personName)}</strong><div class="review-meta">${esc(p.role||'')} · Working Persona는 Private Draft</div>`}));
    const agenda=q('[data-one-on-one-agenda]');
    if(agenda)agenda.innerHTML=[
      ['CONTEXT','이번 주 가장 중요한 결과와 막힘은 무엇인가?'],
      ['WORKING PREFERENCE',p.instructionPreference||'업무를 받을 때 어떤 정보와 형식이 가장 도움이 되나요?'],
      ['CHECKPOINT',p.checkpointPreference||'어느 시점에 확인받는 것이 가장 효율적인가요?'],
      ...candidates.slice(0,2).map(x=>['VERIFY',x.statement])
    ].map(([t,v])=>`<article class="agenda-item"><div class="type">${esc(t)}</div><div>${esc(v)}</div><div class="review-meta">Confirm in conversation</div></article>`).join('');
    const personInput=q('[data-r16-commitment-person]');if(personInput)personInput.value=p.personName;
  }
  const work=q('[data-r61-work-context]'),workBody=q('[data-r61-work-context-body]'),inst=lastInstruction||instructions(p.personId)[0]||null;
  if(work&&workBody){
    work.hidden=false;workBody.innerHTML=inst?`<h3>${esc(p.personName)} · People-aware Instruction</h3><p><b>${esc(inst.task)}</b> · ${esc(inst.autonomy)} · ${esc(inst.checkpoint)}</p><div class="r61-cross-actions"><button type="button" data-r61-work-open-people>People에서 수정</button><button type="button" data-r61-work-delegation>Delegation Artifact</button></div>`:`<h3>${esc(p.personName)} · Working Persona 연결</h3><p>People에서 업무지시 Draft를 만들면 이곳 Work Context에 연결됩니다.</p><div class="r61-cross-actions"><button type="button" data-r61-work-open-people>People에서 업무지시 만들기</button></div>`;
  }
  const coach=q('[data-r61-coach-context]'),coachBody=q('[data-r61-coach-context-body]');
  if(coach&&coachBody){
    coach.hidden=false;coachBody.innerHTML=`<h3>${esc(p.personName)}에게 말하기 전 Context</h3><p>${esc(summary.slice(0,4).join(' · ')||'확인된 Working Persona가 적습니다. 성향을 추정하지 말고 질문으로 확인하세요.')}</p><div class="r61-meta" style="margin-top:6px">Leader Coach는 이 Context를 참고하되 사람의 성격·역량을 확정하지 않습니다.</div><div class="r61-cross-actions"><button type="button" data-r61-coach-open-people>People 열기</button></div>`;
  }
  qa('[data-r61-back-people],[data-r61-work-open-people],[data-r61-coach-open-people]').forEach(btn=>btn.addEventListener('click',()=>openPage('PEOPLE')));
  q('[data-r61-work-delegation]')?.addEventListener('click',()=>{if(inst)window.LeaderOsOperatingArtifactBridge?.create?.('DELEGATION',{task:inst.task,owner:p.personName,level:inst.autonomy,guardrail:inst.guardrail,checkpoint:inst.checkpoint});window.LeaderOsOperatingArtifactBridge?.openType?.('DELEGATION')});
}
function renderQuestLink(){
  const detail=q('[data-quest-detail]');if(!detail)return;
  q('[data-r61-quest-link]',detail)?.remove();
  const snap=window.LeaderOsLeadershipHarness?.snapshot?.(),day=Number(snap?.selectedDay||0);
  const relevant={3:'Team Map을 만들며 실제 역할/업무 방식을 People에 기록하세요.',4:'첫 1:1에서 확인한 업무 선호를 Collaboration Memory로 남기세요.',5:'반복 패턴은 People의 Candidate Pattern으로 남기고 Human Confirm하세요.',20:'위임 전에 이 사람의 Checkpoint·자율 선호를 확인하세요.',22:'피드백 전 Working Persona의 Feedback 선호와 Confirmed Pattern을 확인하세요.',24:'1:1 질문을 만들기 전 People Context를 확인하세요.',25:'어려운 대화에서 사람 평가 대신 관찰 Evidence를 사용하세요.'};
  if(!relevant[day])return;
  const box=document.createElement('div');box.className='r61-quest-link';box.dataset.r61QuestLink='';
  box.innerHTML=`<b>People 연결 · Day ${day}</b><div>${esc(relevant[day])}</div><button type="button" data-r61-quest-people style="margin-top:6px">People Working Persona 열기 →</button>`;
  const mission=q('.mission-checklist-box',detail)||detail.firstElementChild;mission?.insertAdjacentElement('afterend',box);
  q('[data-r61-quest-people]',box)?.addEventListener('click',()=>openPage('PEOPLE'));
}
function renderAll(){renderRoster();renderDetail();renderCrossSections();renderQuestLink()}
async function switchScope(){
  const next=scope();if(next===activeScope)return;
  activeScope=next;store=read();lastInstruction=null;preferenceRequests=[];lastPreferenceLinks.clear();renderAll();if(state().signedIn)setTimeout(()=>hydrate(true),100)
}
function addPersonBindings(){q('[data-r61-add-person]')?.addEventListener('click',addPerson)}
Object.defineProperty(window,'LeaderOsPeopleBridge',{
  value:{
    snapshot:()=>JSON.parse(JSON.stringify(store)),
    active:()=>store.activePersonId?JSON.parse(JSON.stringify(profile(store.activePersonId))):null,
    select:(personId)=>selectPerson(personId),
    open:(personId)=>{if(personId)selectPerson(personId);openPage('PEOPLE')},
    prepareOneOnOne:openOneOnOne,
    coach:openCoach,
    hydrate:()=>hydrate(true),
    refreshPreferenceRequests:(personId=null)=>refreshPreferenceRequests(personId),
    generateInstruction:(personId,input)=>generateInstruction(profile(personId),input)
  },
  enumerable:false,configurable:true
});
function init(){
  addPersonBindings();renderAll();
  [250,900,1900].forEach(ms=>setTimeout(renderAll,ms));
  if(state().signedIn)setTimeout(()=>hydrate(false),2100);
  setInterval(()=>{switchScope();renderCrossSections();renderQuestLink()},1500);
  window.addEventListener('leaderos:artifacts-changed',()=>setTimeout(renderCrossSections,80));
  document.addEventListener('click',(e)=>{if(e.target?.closest?.('[data-quest-day],[data-route="PEOPLE"],[data-fallback-page="PEOPLE"],[data-fallback-page="ONE_ON_ONE"],[data-fallback-page="WORK"],[data-fallback-page="LEADER_COACH"]'))setTimeout(renderAll,100)},true);
  document.title='Leader OS · Recovery 61 · People Collaboration Intelligence';
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>


<script id="recovery-62-people-closed-loop">
(()=>{
'use strict';
function apply(){
  const hero=document.querySelector('.r61-people-hero');
  if(hero&&!hero.querySelector('[data-r62-loop]')){
    const note=document.createElement('div');
    note.dataset.r62Loop='';
    note.className='r61-safe';
    note.style.gridColumn='1/-1';
    note.innerHTML='<strong>Closed Loop</strong> · People → Instruction / Delegation → Work Result / Feedback / 1:1 → Collaboration Source → Candidate Pattern → Human Confirm → Working Persona 개선';
    hero.append(note);
  }
  document.title='Leader OS · Recovery 62 · People Closed Loop';
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>{[0,600,1800].forEach(ms=>setTimeout(apply,ms))},{once:true});else apply();
})();
</script>


<script id="recovery-63-people-evidence-quality">
(()=>{
'use strict';
const apply=()=>{
  const hero=document.querySelector('.r61-people-hero');
  if(hero&&!hero.querySelector('[data-r63-quality]')){
    const n=document.createElement('div');n.dataset.r63Quality='';n.className='r61-safe';n.style.gridColumn='1/-1';
    n.innerHTML='<strong>Evidence Quality</strong> · Candidate → Human Confirm → 90일 재검증 → 실제 Instruction Outcome 확인. 같은 카테고리의 상충 가능성은 자동 결론 대신 Review Queue로 보냅니다.';
    hero.append(n);
  }
  document.title='Leader OS · Recovery 63 · People Evidence Quality';
};
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>[0,700,1800,3200,4800].forEach(ms=>setTimeout(apply,ms)),{once:true});else{apply();[1800,3600].forEach(ms=>setTimeout(apply,ms))};
})();
</script>


<script id="recovery-64-collaborative-working-persona">
(()=>{
'use strict';
function apply(){
  const hero=document.querySelector('.r61-people-hero');
  if(hero&&!hero.querySelector('[data-r64-participation]')){
    const n=document.createElement('div');n.dataset.r64Participation='';n.className='r64-verified-note';n.style.gridColumn='1/-1';
    n.innerHTML='<strong>Collaborative Persona</strong> · 본인 미확인 Preference, 재검증 기한이 지난 Pattern, 상충 가능성이 있는 Pattern은 업무지시 자동 최적화에서 제외합니다. 팀원이 제출한 변경도 리더의 Review/Apply 전에는 Working Persona를 덮어쓰지 않습니다.';
    hero.append(n);
  }
  document.title='Leader OS · Recovery 64 · Collaborative Working Persona';
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>[0,700,1800,3200,5000,6200].forEach(ms=>setTimeout(apply,ms)),{once:true});else{apply();[1800,3600,5200].forEach(ms=>setTimeout(apply,ms))};
})();
</script>


<script id="recovery-64-public-preference-confirmation">
(()=>{
'use strict';
const esc=(v)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const tokenFromHash=()=>{
  let raw='';
  try{raw=location.hash.startsWith('#peopleConfirm=')?decodeURIComponent(location.hash.slice('#peopleConfirm='.length)):''}catch{}
  if(raw){
    try{sessionStorage.setItem('leaderos:peopleConfirmToken',raw)}catch{}
    try{history.replaceState(null,'',location.pathname+location.search)}catch{}
    return raw;
  }
  try{return sessionStorage.getItem('leaderos:peopleConfirmToken')||''}catch{return ''}
};
const token=tokenFromHash();
if(!token)return;
document.documentElement.dataset.peopleConfirmMode='1';

const apiUrl=()=>{
  try{
    const cfg=window.LeaderOsReportRuntimeBridge?.runtimeConfig?.();
    if(cfg?.supabaseUrl)return `${String(cfg.supabaseUrl).replace(/\/$/,'')}/functions/v1/leader-os-people-confirm`;
  }catch{}
  return 'https://lclibscjesyvsnxvdhoy.supabase.co/functions/v1/leader-os-people-confirm';
};
let confirmation=null;

function root(){
  let el=document.querySelector('.r64-public-confirm');
  if(!el){el=document.createElement('main');el.className='r64-public-confirm';document.body.append(el)}
  return el;
}
function status(title,copy){
  root().innerHTML=`<div class="r64-public-wrap"><div class="r64-public-card r64-public-status"><div class="r64-public-k">LEADER OS · WORKING PREFERENCE</div><h1>${esc(title)}</h1><p>${esc(copy)}</p></div></div>`;
}
function field(name,label,value='',type='input'){
  if(type==='textarea')return `<div class="r64-public-field full"><label>${esc(label)}</label><textarea name="${name}" maxlength="500">${esc(value)}</textarea></div>`;
  return `<div class="r64-public-field"><label>${esc(label)}</label><input name="${name}" maxlength="300" value="${esc(value)}"></div>`;
}
function render(){
  if(!confirmation){status('확인 정보를 불러오는 중입니다.','잠시만 기다려 주세요.');return}
  const c=confirmation,p=c.preference||{};
  if(c.status==='APPLIED'){status('확인 내용이 반영되었습니다.','리더가 검토 후 Working Persona에 적용했습니다. 감사합니다.');return}
  if(['REJECTED','REVOKED','EXPIRED'].includes(c.status)){status('현재 사용할 수 없는 확인 링크입니다.','필요한 경우 리더에게 새 확인 링크를 요청하세요.');return}
  root().innerHTML=`<div class="r64-public-wrap"><div class="r64-public-card">
    <div class="r64-public-k">LEADER OS · WORKING PREFERENCE</div>
    <h1>${esc(c.personName||'Working Preference')}님의 협업 선호 확인</h1>
    <p>더 명확하게 함께 일하기 위한 업무 방식 확인입니다. 사람을 평가하거나 성격을 점수화하는 설문이 아닙니다.</p>
    <div class="r64-public-notice">이 화면에는 리더의 개인 메모, 1:1 기록, 녹음/Transcript, 관찰 Pattern이나 평가 내용이 표시되지 않습니다. 업무에 필요한 선호만 직접 확인하거나 수정해 주세요.</div>
    ${c.status==='SUBMITTED'?'<div class="r64-public-notice"><b>이미 제출된 내용이 있습니다.</b> 리더가 적용하기 전까지 다시 수정해 제출할 수 있습니다.</div>':''}
    <form data-r64-public-form>
      <div class="r64-public-grid">
        ${field('instructionPreference','업무 지시를 받을 때 도움이 되는 방식',p.instructionPreference,'textarea')}
        <div class="r64-public-field"><label>자율 수준 선호</label><select name="autonomyPreference">
          ${[['','아직 모르겠음'],['GUIDE','구체적인 안내가 도움됨'],['COACH','질문하며 함께 설계'],['SUPPORT','판단은 맡고 필요할 때 지원'],['DELEGATE','결과 기준 중심으로 자율 진행']].map(([v,l])=>`<option value="${v}" ${String(p.autonomyPreference||'')===v?'selected':''}>${l}</option>`).join('')}
        </select></div>
        ${field('checkpointPreference','Checkpoint 선호',p.checkpointPreference)}
        ${field('feedbackPreference','Feedback 선호',p.feedbackPreference)}
        ${field('reportingPreference','Reporting 선호',p.reportingPreference)}
        ${field('communicationPreference','Communication 선호',p.communicationPreference)}
        ${field('focusPreference','집중/작업 리듬',p.focusPreference)}
        <div class="r64-public-field full"><label>업무상 연락 가능/선호 시간</label><input name="availabilityPreference" maxlength="300" value="${esc(p.availabilityPreference||'')}"></div>
        <div class="r64-public-field full"><label>리더에게 덧붙이고 싶은 말</label><textarea name="comment" maxlength="1200">${esc(c.comment||'')}</textarea></div>
      </div>
      <button type="submit">확인 내용 제출</button>
    </form>
    <div class="r64-public-foot">제출 내용은 리더의 Review/Apply 전에는 Working Persona를 자동 변경하지 않습니다.</div>
  </div></div>`;
  document.querySelector('[data-r64-public-form]')?.addEventListener('submit',submit);
}
async function load(){
  status('확인 정보를 불러오는 중입니다.','잠시만 기다려 주세요.');
  try{
    const res=await fetch(`${apiUrl()}?token=${encodeURIComponent(token)}`,{headers:{Accept:'application/json'},cache:'no-store'});
    const data=await res.json().catch(()=>({}));
    if(!res.ok)throw new Error(data?.error||`HTTP_${res.status}`);
    confirmation=data.confirmation;render();
  }catch(error){status('확인 링크를 열 수 없습니다.','링크가 만료되었거나 취소되었을 수 있습니다. 리더에게 새 링크를 요청하세요.')}
}
async function submit(e){
  e.preventDefault();
  const form=e.currentTarget,fd=new FormData(form),payload={token};
  for(const [k,v] of fd.entries())payload[k]=String(v);
  const button=form.querySelector('button[type=submit]');if(button){button.disabled=true;button.textContent='제출 중…'}
  try{
    const res=await fetch(apiUrl(),{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(payload)});
    const data=await res.json().catch(()=>({}));
    if(!res.ok)throw new Error(data?.error||`HTTP_${res.status}`);
    try{sessionStorage.removeItem('leaderos:peopleConfirmToken')}catch{}
    status('제출되었습니다.','리더가 변경 내용을 검토한 뒤 적용 여부를 결정합니다.');
  }catch(error){
    if(button){button.disabled=false;button.textContent='확인 내용 제출'}
    const foot=document.querySelector('.r64-public-foot');if(foot)foot.textContent='제출에 실패했습니다. 잠시 후 다시 시도해 주세요.';
  }
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',load,{once:true});else load();
})();
</script>

</body>
</html>
