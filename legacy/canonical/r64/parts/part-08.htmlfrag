"};
  const DEFAULTS=[
    {id:'starbucks-future-states',builtin:true,name:'Starbucks Future States Service Blueprint',title:'개인화와 서비스 경험 관점의 흐름 보기',kicker:'REFERENCE · STARBUCKS FUTURE STATES SERVICE BLUEPRINT',description:'고객 여정과 Touchpoint, Front Office, Back Office, Support Process가 어떻게 연결되는지 살펴봅니다. 모바일 주문·픽업·비대면 접점처럼 개인화된 서비스 경험을 운영 흐름과 함께 봅니다.',source:'첨부 원본 이미지 · 출처 표기: boardmix.com/kr/skills/service-blueprint/',template:'STARBUCKS',imageKey:'STARBUCKS'},
    {id:'innout-service-blueprint',builtin:true,name:'In-N-Out Burger Service Blueprint',title:'속도와 단순성 관점의 흐름 보기',kicker:'REFERENCE · IN-N-OUT BURGER SERVICE BLUEPRINT',description:'Word of Mouth → Travel → Drive-Thru/Enter → Line → Order → Wait → Eat → Depart 흐름을 Physical Evidence, Front-stage, Back-stage, Support Process와 함께 봅니다. 단계 수, 대기, 주문·조리·핸드오프의 단순성을 확인하기 좋은 샘플입니다.',source:'첨부 원본 이미지 · Service Blueprint of In-N-Out Burger · 출처 표기: boardmix.com/kr/skills/service-blueprint/',template:'INNOUT',imageKey:'INNOUT'}
  ];
  const TEMPLATE_NODES={
    STARBUCKS:[['Find / Arrive','Customer'],['Instruction','Touchpoint'],['Order in App','Decision'],['Prepare','Backstage'],['Pickup','Handoff'],['Leave','Experience']],
    INNOUT:[['Discover','Customer'],['Travel / Arrive','Customer'],['Line','Queue'],['Order','Frontstage'],['Make to Order','Backstage'],['Call / Handoff','Delivery'],['Eat','Experience'],['Depart','Signal']],
    NONE:[]
  };
  const q=(s,r=document)=>r.querySelector(s), qa=(s,r=document)=>Array.from(r.querySelectorAll(s));
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const safeId=()=>`custom-${Date.now().toString(36)}-${Math.random().toString(36).slice(2,7)}`;
  const emptyState=()=>({overrides:{},custom:[],deleted:[]});
  const storage=window.__leaderOsStorage||(()=>{const m=new Map();const s={getItem:k=>m.has(String(k))?m.get(String(k)):null,setItem:(k,v)=>m.set(String(k),String(v)),removeItem:k=>m.delete(String(k))};window.__leaderOsStorage=s;return s})();
  const load=()=>{try{const x=JSON.parse(storage.getItem(KEY)||'null');return x&&typeof x==='object'?{...emptyState(),...x}:emptyState()}catch{return emptyState()}};
  const save=s=>{try{storage.setItem(KEY,JSON.stringify(s));return true}catch(err){alert('샘플을 저장할 공간이 부족합니다. 큰 이미지를 줄인 뒤 다시 시도해주세요.');return false}};
  const resolveImage=item=>item.imageData||DEFAULT_IMAGES[item.imageKey]||`data:image/svg+xml;utf8,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 700"><rect width="1200" height="700" fill="#eef1f4"/><text x="600" y="330" text-anchor="middle" font-family="Arial" font-size="42" fill="#667085">Sample Map</text><text x="600" y="390" text-anchor="middle" font-family="Arial" font-size="22" fill="#98a2b3">이미지를 추가하세요</text></svg>')}`;
  function items(){
    const s=load(), deleted=new Set(s.deleted||[]);
    const base=DEFAULTS.filter(x=>!deleted.has(x.id)).map(x=>({...x,...(s.overrides?.[x.id]||{}),builtin:true}));
    return [...base,...(Array.isArray(s.custom)?s.custom:[])];
  }
  function card(item){
    const nodes=TEMPLATE_NODES[item.template]||[];
    const flow=nodes.length?`<div class="r29-flow-strip">${nodes.map(n=>`<div class="r29-node"><b>${esc(n[0])}</b><em>${esc(n[1])}</em></div>`).join('')}</div>`:'';
    const start=item.template&&item.template!=='NONE'?`<button type="button" class="primary" data-r42-start="${esc(item.id)}">이 샘플로 시작</button>`:'';
    return `<article class="r29-sample" data-r42-sample-id="${esc(item.id)}">
      <img loading="lazy" src="${resolveImage(item)}" alt="${esc(item.name||item.title)}" />
      <div class="r29-sample-body">
        <div class="r29-kicker">${esc(item.kicker||'REFERENCE · SAMPLE MAP')}</div>
        <h3>${esc(item.title||'Untitled sample')}</h3>
        <div class="r42-sample-name">${esc(item.name||'')}</div>
        ${flow}
        <p>${esc(item.description||'')}</p>
        <div class="r29-source">${esc(item.source||'Source not provided')}</div>
        <div class="r29-sample-actions"><button type="button" data-r29-view-image>이미지 보기</button>${start}</div>
        <div class="r42-sample-tools"><button type="button" data-r42-edit="${esc(item.id)}">수정</button><button type="button" class="danger" data-r42-delete="${esc(item.id)}">삭제</button></div>
      </div>
    </article>`;
  }
  function render(){
    const root=q('[data-r42-sample-grid]'); if(!root)return;
    const list=items();
    root.innerHTML=list.length?list.map(card).join(''):`<div class="r42-empty"><b>샘플맵이 없습니다.</b><br>‘샘플 추가’로 새로운 참조 맵을 등록하거나 ‘기본 샘플 복원’을 눌러주세요.</div>`;
  }
  let stagedImage=null;
  function openEditor(id=null){
    const modal=q('[data-r42-editor-modal]'); if(!modal)return;
    const item=id?items().find(x=>x.id===id):null;
    stagedImage=null;
    q('[data-r42-editor-id]',modal).value=item?.id||'';
    q('[data-r42-name]',modal).value=item?.name||'';
    q('[data-r42-title]',modal).value=item?.title||'';
    q('[data-r42-kicker]',modal).value=item?.kicker||'';
    q('[data-r42-description]',modal).value=item?.description||'';
    q('[data-r42-source]',modal).value=item?.source||'';
    q('[data-r42-template]',modal).value=item?.template||'NONE';
    q('[data-r42-image-file]',modal).value='';
    q('[data-r42-image-preview]',modal).src=item?resolveImage(item):resolveImage({});
    q('[data-r42-image-status]',modal).textContent=item?'새 파일을 선택하지 않으면 기존 이미지를 유지합니다.':'PNG / JPG / WebP 이미지를 추가할 수 있습니다.';
    q('[data-r42-editor-heading]',modal).textContent=item?'샘플 수정':'샘플 추가';
    if(typeof modal.showModal==='function')modal.showModal();
  }
  function persistForm(){
    const modal=q('[data-r42-editor-modal]'), id=q('[data-r42-editor-id]',modal).value.trim();
    const state=load(), original=id?items().find(x=>x.id===id):null;
    const next={
      id:id||safeId(), builtin:!!original?.builtin,
      name:q('[data-r42-name]',modal).value.trim(), title:q('[data-r42-title]',modal).value.trim(),
      kicker:q('[data-r42-kicker]',modal).value.trim(), description:q('[data-r42-description]',modal).value.trim(),
      source:q('[data-r42-source]',modal).value.trim(), template:q('[data-r42-template]',modal).value,
      imageKey:original?.imageKey||null, imageData:stagedImage||original?.imageData||null
    };
    if(!next.name||!next.title)return false;
    if(original?.builtin){
      state.overrides={...(state.overrides||{}),[next.id]:{name:next.name,title:next.title,kicker:next.kicker,description:next.description,source:next.source,template:next.template,imageData:next.imageData}};
    }else if(original){
      state.custom=(state.custom||[]).map(x=>x.id===next.id?next:x);
    }else{state.custom=[...(state.custom||[]),next]}
    if(!save(state))return false; render(); return true;
  }
  function remove(id){
    const item=items().find(x=>x.id===id); if(!item)return;
    if(!confirm(`‘${item.name||item.title}’ 샘플을 삭제할까요?`))return;
    const state=load();
    if(item.builtin){state.deleted=Array.from(new Set([...(state.deleted||[]),id])); delete state.overrides?.[id]}
    else state.custom=(state.custom||[]).filter(x=>x.id!==id);
    save(state); render();
  }
  function restoreDefaults(){
    const state=load(); state.deleted=[]; state.overrides={}; save(state); render();
  }
  function startSample(id){
    const item=items().find(x=>x.id===id); if(!item||!item.template||item.template==='NONE')return;
    const legacy=q(`[data-r42-template-triggers] [data-r29-load-sample="${item.template}"]`); legacy?.click();
    const msg=q('[data-r29-flow-save]'); if(msg){const prev=msg.textContent;msg.textContent=`${item.name} 불러옴`;setTimeout(()=>msg.textContent=prev,1200)}
    q('[data-r29-flow-list]')?.scrollIntoView({behavior:'smooth',block:'start'});
  }
  document.addEventListener('click',e=>{
    const add=e.target.closest('[data-r42-add-sample]'); if(add){openEditor();return}
    const edit=e.target.closest('[data-r42-edit]'); if(edit){openEditor(edit.dataset.r42Edit);return}
    const del=e.target.closest('[data-r42-delete]'); if(del){remove(del.dataset.r42Delete);return}
    const start=e.target.closest('[data-r42-start]'); if(start){startSample(start.dataset.r42Start);return}
    if(e.target.closest('[data-r42-restore-defaults]')){restoreDefaults();return}
    if(e.target.closest('[data-r42-editor-close],[data-r42-editor-cancel]')){q('[data-r42-editor-modal]')?.close();return}
  });
  const form=q('[data-r42-editor-form]');
  form?.addEventListener('submit',e=>{e.preventDefault();if(persistForm())q('[data-r42-editor-modal]')?.close()});
  q('[data-r42-image-file]')?.addEventListener('change',e=>{
    const file=e.target.files?.[0]; if(!file)return;
    if(file.size>3*1024*1024){alert('Standalone Preview에서는 3MB 이하 이미지를 권장합니다.');e.target.value='';return}
    const reader=new FileReader(); reader.onload=()=>{stagedImage=String(reader.result||'');q('[data-r42-image-preview]').src=stagedImage;q('[data-r42-image-status]').textContent=`${file.name} · ${Math.round(file.size/1024)}KB`;}; reader.readAsDataURL(file);
  });
  window.addEventListener('storage',e=>{if(e.key===KEY)render()});
  render();
  window.LeaderOsR42SampleLibrary={render,items,openEditor};
})();
</script>
<script id="recovery-45-server-search-detail-review">
(function(){
'use strict';
const q=(s,r=document)=>r.querySelector(s),qa=(s,r=document)=>Array.from(r.querySelectorAll(s));
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const bridge=()=>window.LeaderOsReportRuntimeBridge||null;
const state=()=>{try{return bridge()?.state?.()||{signedIn:false,workspaceId:null}}catch{return{signedIn:false,workspaceId:null}}};
const OBJECT_LINKABLE=new Set(['TEAM','PROJECT','MEETING','DECISION','ACTION','COMMITMENT','RISK','ATTENTION','RECOMMENDATION']);
const REVIEW_ROLES=new Set(['OWNER','ADMIN','LEADER']);
let seq=0,timer=null,serverCache=[],lastDetailRef=null;

function truthClass(v){return String(v||'candidate').toLowerCase()}
function uiType(x){if(x.type==='ADDON')return'ADDON';if(x.type==='ARTIFACT')return'ARTIFACT';if(x.type==='QUEST_EVIDENCE')return'QUEST';return'RESULT'}
function serverSection(){
  const root=q('[data-lo-search-results]');if(!root)return null;
  let el=q('[data-r44-server-results]',root);
  if(!el){el=document.createElement('div');el.dataset.r44ServerResults='';root.append(el)}
  return el
}
function renderServer(items,query,error=null){
  const el=serverSection();if(!el)return;
  const b=state();
  if(!b.signedIn||!b.workspaceId){el.innerHTML='<div class="lo-r44-server-head"><b>WORKSPACE SERVER</b><span class="lo-r44-server-state">로그인하면 실제 저장 결과도 검색합니다</span></div>';return}
  if(error){el.innerHTML=`<div class="lo-r44-server-head"><b>WORKSPACE SERVER</b><span class="lo-r44-server-state">${esc(error)}</span></div>`;return}
  const active=q('[data-search-filter].active')?.dataset.searchFilter||'ALL';
  const visible=(items||[]).filter(x=>active==='ALL'||uiType(x)===active);
  el.innerHTML=`<div class="lo-r44-server-head"><b>WORKSPACE SERVER · ${visible.length}</b><span class="lo-r44-server-state">한/영 Alias 검색 · PRIVATE 제외 · RESTRICTED 권한 필수</span></div>`+
  (visible.length?visible.map((x,i)=>`<button type="button" class="lo-search-result" data-r44-server-item="${i}">
    <span class="lo-search-type ${uiType(x).toLowerCase()}">${uiType(x)==='RESULT'?'결과':uiType(x)}</span>
    <span class="lo-search-copy"><strong>${esc(x.title)}</strong><small>${esc(x.subtitle||`${x.objectType} · ${x.objectId}`)}</small></span>
    <span class="lo-search-route"><span class="lo-r44-truth ${truthClass(x.truthStatus)}">${esc(x.truthStatus)}</span></span>
  </button>`).join(''):`<div class="lo-search-empty" style="padding:14px">“${esc(query)}”와 일치하는 서버 저장 결과가 없습니다.</div>`);
  qa('[data-r44-server-item]',el).forEach((btn)=>btn.onclick=()=>openServerDetail(visible[Number(btn.dataset.r44ServerItem)]));
}
async function fetchServerSearch(){
  const input=q('[data-lo-search-input]');if(!input)return;
  const query=input.value.trim(),b=state(),my=++seq;
  if(!b.signedIn||!b.workspaceId){serverCache=[];renderServer([],query);return}
  if(!query){serverCache=[];renderServer([],query);return}
  try{
    const res=await bridge().search(query,24);
    if(my!==seq)return;
    serverCache=Array.isArray(res?.search?.results)?res.search.results:[];
    renderServer(serverCache,query);
  }catch(e){if(my!==seq)return;renderServer([],query,e?.code||e?.message||String(e))}
}
function scheduleSearch(){clearTimeout(timer);timer=setTimeout(fetchServerSearch,180)}
document.addEventListener('input',e=>{if(e.target?.matches?.('[data-lo-search-input]'))scheduleSearch()},true);
document.addEventListener('click',e=>{if(e.target?.closest?.('[data-search-filter]'))setTimeout(()=>renderServer(serverCache,q('[data-lo-search-input]')?.value||''),0)},true);

function ensureDetailModal(){
  let back=q('[data-r45-detail-backdrop]');
  if(back)return back;
  back=document.createElement('div');back.className='lo-r45-detail-backdrop';back.dataset.r45DetailBackdrop='';
  back.innerHTML=`<section class="lo-r45-detail" role="dialog" aria-modal="true" aria-label="Workspace 검색 결과 상세">
    <div class="lo-r45-detail-head"><div><div class="section-kicker">WORKSPACE OBJECT DETAIL</div><h3 data-r45-detail-title>불러오는 중…</h3></div><button type="button" data-r45-detail-close>닫기</button></div>
    <div class="lo-r45-detail-body" data-r45-detail-body></div>
  </section>`;
  document.body.append(back);
  q('[data-r45-detail-close]',back).onclick=()=>back.classList.remove('open');
  back.addEventListener('click',e=>{if(e.target===back)back.classList.remove('open')});
  return back;
}
function valHtml(v){
  if(v===null||v===undefined||v==='')return '<span class="muted">—</span>';
  if(typeof v==='object'){
    let text='';try{text=JSON.stringify(v,null,2)}catch{text=String(v)}
    if(text.length>3000)text=text.slice(0,3000)+'\n…';
    return `<pre>${esc(text)}</pre>`;
  }
  return esc(String(v));
}
function detailTitle(d){
  const data=d?.data||{};
  return data.title||data.name||data.questTitle||data.decision||data.what||
    (d?.objectType==='WORK_REPORT'?`${data.reportType||'Work'} Report · ${data.periodKey||''}`:`${d?.objectType||'OBJECT'} · ${d?.objectId||''}`);
}
function routeDetail(detail){
  if(!detail)return;
  const data=detail.data||{},day=Number(data.questDay);
  if(Number.isInteger(day)&&day>=1&&day<=30){
    window.LeaderOsSearch?.openItem?.({type:'QUEST',title:detailTitle(detail),subtitle:'Server Evidence',page:'ONBOARDING',day,_key:`server|${detail.objectId}`});
  }else{
    window.LeaderOsSearch?.openItem?.({type:'RESULT',title:detailTitle(detail),subtitle:detail.objectType,page:detail.routePage||'REVIEW',_key:`server|${detail.objectId}`});
  }
  ensureDetailModal().classList.remove('open');
}
async function reviewEvidence(detail,disposition){
  const back=ensureDetailModal(),status=q('[data-r45-review-status]',back),note=q('[data-r45-review-note]',back)?.value||'';
  if(status)status.textContent='Review 저장 중…';
  try{
    const res=await bridge().reviewQuestEvidence({
      eventId:`QUEST-REVIEW-${Date.now().toString(36)}`,
      evidenceId:detail.objectId,
      expectedVersion:Number(detail.version),
      disposition,
      notes:note
    });
    if(status)status.textContent=`Review 저장됨 · ${disposition} · Evidence는 여전히 Confirmed Truth가 아닙니다.`;
    setTimeout(()=>openServerDetail({...lastDetailRef,version:res?.evidence?.version||detail.version}),180);
  }catch(error){
    const code=error?.code||error?.message||String(error);
    if(status&&String(code).includes('VERSION_CONFLICT')){
      status.textContent='다른 화면에서 Evidence가 변경되었습니다. 최신 버전을 다시 불러옵니다.';
      setTimeout(()=>openServerDetail(lastDetailRef),220);
    }else if(status)status.textContent=`Review 실패 · ${code}`;
  }
}
function renderDetail(detail,ref){
  const back=ensureDetailModal(),body=q('[data-r45-detail-body]',back);
  q('[data-r45-detail-title]',back).textContent=detailTitle(detail);
  const data=detail?.data||{};
  const keys=Object.keys(data).filter(k=>!['history'].includes(k)).slice(0,20);
  const canReview=detail.objectType==='EVIDENCE'&&data.sourceType==='QUEST'&&REVIEW_ROLES.has(detail.viewerRole);
  body.innerHTML=`<div class="lo-r45-meta">
    <span>${esc(detail.objectType)}</span><span>${esc(detail.truthStatus)}</span><span>v${esc(detail.version)}</span><span>${esc(detail.accessScope)}</span>
  </div>
  <div class="lo-r45-fields">${keys.map(k=>`<div class="lo-r45-field"><b>${esc(k)}</b><div>${valHtml(data[k])}</div></div>`).join('')}</div>
  ${detail.objectType==='EVIDENCE'&&data.sourceType==='QUEST'?`<div class="lo-r45-review">
    <div class="section-kicker">HUMAN EVIDENCE REVIEW</div>
    <p style="font-size:10px;line-height:1.55;margin:5px 0 8px">${canReview?'Evidence를 Context 후보로 검토할 수 있습니다. 승인해도 자동으로 Confirmed Truth가 되지는 않습니다.':'OWNER / ADMIN / LEADER만 Evidence Review 상태를 변경할 수 있습니다.'}</p>
    <textarea rows="2" data-r45-review-note placeholder="검토 메모 · 왜 승인/보완/기각하는가" ${canReview?'':'disabled'}>${esc(data.reviewNotes||'')}</textarea>
    <div class="lo-r45-actions" style="margin-top:7px">
      <button type="button" data-r45-review="ACCEPTED_FOR_CONTEXT" ${canReview?'':'disabled'}>Context 후보 승인</button>
      <button type="button" data-r45-review="NEEDS_WORK" ${canReview?'':'disabled'}>보완 필요</button>
      <button type="button" data-r45-review="REJECTED" ${canReview?'':'disabled'}>기각</button>
    </div><div class="lo-r45-review-status" data-r45-review-status>${data.reviewStatus?`현재 Review · ${esc(data.reviewStatus)}`:'아직 Human Review 전입니다.'}</div>
  </div>`:''}
  <div class="lo-r45-actions"><button type="button" class="primary" data-r45-route>해당 화면 열기</button><button type="button" data-r45-refresh>최신 버전 다시 불러오기</button></div>`;
  q('[data-r45-route]',body).onclick=()=>routeDetail(detail);
  q('[data-r45-refresh]',body).onclick=()=>openServerDetail(ref);
  qa('[data-r45-review]',body).forEach(btn=>btn.onclick=()=>reviewEvidence(detail,btn.dataset.r45Review));
  back.classList.add('open');
}
async function openServerDetail(ref){
  if(!ref)return;
  lastDetailRef=ref;
  const b=state();
  if(!b.signedIn||!b.workspaceId){
    window.LeaderOsSearch?.openItem?.({type:uiType(ref),title:ref.title,subtitle:ref.subtitle,page:ref.routePage||'REVIEW',day:ref.questDay||null,_key:`server|${ref.objectId}`});
    return;
  }
  const back=ensureDetailModal();
  q('[data-r45-detail-title]',back).textContent='Workspace 객체 불러오는 중…';
  q('[data-r45-detail-body]',back).innerHTML='<div class="safe">서버의 최신 Version과 Truth 상태를 확인하고 있습니다.</div>';
  back.classList.add('open');
  try{
    const res=await bridge().searchDetail(ref.objectType,ref.objectId);
    renderDetail(res?.detail,ref);
  }catch(error){
    q('[data-r45-detail-body]',back).innerHTML=`<div class="safe">상세 조회 실패 · ${esc(error?.code||error?.message||String(error))}</div><div class="lo-r45-actions"><button type="button" data-r45-fallback-route>화면으로 이동</button></div>`;
    q('[data-r45-fallback-route]',back)?.addEventListener('click',()=>routeDetail(ref));
  }
}

async function linkOptions(){
  const b=state();if(!b.signedIn||!b.workspaceId)return[];
  try{
    const res=await bridge().search('',30);
    return (res?.search?.results||[]).filter(x=>x.accessScope==='WORKSPACE'&&OBJECT_LINKABLE.has(x.objectType));
  }catch{return[]}
}
async function decorateQuest(){
  const root=q('[data-quest-detail]');if(!root)return;
  const artifact=q('.quest-box.artifact',root);if(!artifact||q('[data-r44-quest-server]',artifact))return;
  const box=document.createElement('div');box.className='quest-server-link';box.dataset.r44QuestServer='';
  const b=state();
  box.innerHTML=`<div class="quest-server-link-head"><b>SERVER EVIDENCE LINK</b><span>${b.signedIn&&b.workspaceId?'LIVE WORKSPACE':'PREVIEW LOCAL ONLY'}</span></div>
    <div class="quest-server-link-row"><select data-r44-object-link><option value="">실제 Workspace 객체 연결 없음</option></select><button type="button" data-r44-refresh-link>새로고침</button></div>
    <div class="quest-server-link-status" data-r44-quest-status>${b.signedIn&&b.workspaceId?'Evidence 저장 시 서버 EVIDENCE에도 기록합니다.':'로그인 전에는 기존 Local Evidence만 저장됩니다.'}</div>`;
  const actions=q('.quest-evidence-actions',artifact);actions?.insertAdjacentElement('beforebegin',box);
  const sel=q('[data-r44-object-link]',box),status=q('[data-r44-quest-status]',box);
  const load=async()=>{if(!b.signedIn||!b.workspaceId)return;status.textContent='연결 가능한 Workspace 객체를 불러오는 중…';const rows=await linkOptions();sel.innerHTML='<option value="">실제 Workspace 객체 연결 없음</option>'+rows.map(x=>`<option value="${esc(x.objectType)}|${esc(x.objectId)}">${esc(x.title)} · ${esc(x.objectType)} · ${esc(x.truthStatus)}</option>`).join('');status.textContent=`${rows.length}개 공유 범위 객체 연결 가능 · PRIVATE/RESTRICTED는 링크 후보에서 제외`;};
  q('[data-r44-refresh-link]',box)?.addEventListener('click',load);load();
}
const observer=new MutationObserver(()=>setTimeout(decorateQuest,0));
const questRoot=q('[data-quest-detail]');if(questRoot)observer.observe(questRoot,{childList:true,subtree:false});
setTimeout(decorateQuest,500);

document.addEventListener('click',e=>{
  const btn=e.target?.closest?.('[data-quest-evidence-save]');if(!btn)return;
  setTimeout(async()=>{
    const root=q('[data-quest-detail]'),b=state();if(!root||!b.signedIn||!b.workspaceId)return;
    const kicker=q('.lens-kicker',root)?.textContent||'',day=Number((kicker.match(/DAY\s+(\d+)/)||[])[1]);
    const title=q('.quest-detail-head h2',root)?.textContent?.trim()||'Leadership Quest';
    const artifactType=q('.quest-box.artifact > strong',root)?.textContent?.trim()||null;
    const evidenceText=q('[data-quest-evidence]',root)?.value?.trim()||null;
    const linkValue=q('[data-r44-object-link]',root)?.value||'';
    const [linkedObjectType,linkedObjectId]=linkValue?linkValue.split('|'):[null,null];
    const status=q('[data-r44-quest-status]',root);if(!Number.isInteger(day))return;
    if(status)status.textContent='Server Evidence 저장 중…';
    try{
      const res=await bridge().linkQuestEvidence({
        eventId:`QUEST-${String(day).padStart(2,'0')}-${Date.now().toString(36)}`,
        questDay:day,questTitle:title,artifactType,evidenceText,linkedObjectType,linkedObjectId
      });
      const record=res?.evidence;
      if(status)status.textContent=`Server Evidence 저장됨 · ${record?.object_id||record?.objectId||`Day ${String(day).padStart(2,'0')} Evidence`} · Candidate / Human Review 전`;
    }catch(err){
      const code=err?.code||err?.message||String(err);
      if(status&&String(code).includes('VERSION_CONFLICT'))status.textContent='다른 화면에서 Evidence가 변경되었습니다. 검색에서 최신 Evidence를 열어 확인하세요.';
      else if(status)status.textContent=`Server 저장 실패 · ${code}`;
    }
  },30);
},true);

document.addEventListener('DOMContentLoaded',()=>{setTimeout(()=>{renderServer([],q('[data-lo-search-input]')?.value||'');decorateQuest();window.LeaderOsSetupChecklistBridge?.hydrate?.()},850)});
document.title='Leader OS · Recovery 46 · Server-backed Operating Artifacts';
window.LeaderOsR44={search:fetchServerSearch,decorateQuest,state};
window.LeaderOsR45={search:fetchServerSearch,decorateQuest,state,openServerDetail};
})();
</script>
<script id="recovery-47-ux-priority-consolidation">
(()=>{
'use strict';
const q=(s,r=document)=>r.querySelector(s),qa=(s,r=document)=>Array.from(r.querySelectorAll(s));
const mk=(tag,cls,html='')=>{const el=document.createElement(tag);if(cls)el.className=cls;if(html)el.innerHTML=html;return el};
const bridgeState=()=>{try{return window.LeaderOsReportRuntimeBridge?.state?.()||{signedIn:false,workspaceId:null,workspaceName:null,mode:'DEMO'}}catch{return{signedIn:false,workspaceId:null,workspaceName:null,mode:'DEMO'}}};
const openPage=(id)=>{
  if(id==='LEADER_ONBOARDING'){window.LeaderOsR21?.showOnboarding?.();return}
  if(id==='ONBOARDING'){const b=q('[data-onboarding-open]');if(b){b.click();return}}
  const nav=q(`[data-fallback-page="${id}"]`);if(nav){nav.click();return}
  qa('[data-page]').forEach(p=>p.hidden=p.dataset.page!==id);
  const title=q('[data-topbar-title]');if(title)title.textContent=id;
  window.scrollTo({top:0,behavior:'smooth'});
};
const wrapMany=(summaryText,nodes,cls='')=>{
  const d=mk('details',`r47-disclosure ${cls}`.trim());
  const s=mk('summary','',summaryText);const body=mk('div','r47-disclosure-body');
  d.append(s,body);nodes.filter(Boolean).forEach(n=>body.append(n));return d
};
function directCardByKicker(root,text){
  return qa(':scope > section.card,:scope > div > section.card',root).find(x=>q('.section-kicker',x)?.textContent?.trim()===text)||null
}
function authShell(){
  const page=q('[data-page="LEADER_ONBOARDING"]'), card=q('.runtime-mode-card');if(!page||!card)return null;
  if(q('[data-r47-auth-shell]',page))return q('[data-r47-auth-shell]',page);
  const shell=mk('section','r47-auth-shell needs-login');shell.dataset.r47AuthShell='';
  shell.innerHTML=`<div class="r47-stage-head"><div><div class="r47-stage-kicker">1 · LOGIN & WORKSPACE</div><h2>먼저 로그인하면, 이 다음부터 ‘내 팀’ 기준으로 바뀝니다.</h2><p>Identity와 ACTIVE Workspace가 있어야 저장·검색·Quest Evidence·운영 Artifact가 한 사람의 흐름으로 이어집니다.</p></div><span class="r47-auth-state warn" data-r47-auth-state>로그인 필요 · 개인화 비활성</span></div>`;
  card.classList.add('r47-auth-card');
  const first= q('.first-use',card), personal=q('.personal-home',card);
  if((first||personal)&&!q('.r47-auth-settings',card)){
    const details=mk('details','r47-auth-settings');details.innerHTML='<summary>Workspace 생성 / 개인 설정</summary>';
    const body=mk('div','r47-auth-settings-body');if(first)body.append(first);if(personal)body.append(personal);details.append(body);card.append(details)
  }
  shell.append(card);
  return shell
}
function makePriorityPath(){
  const s=mk('section','r47-primary-card');s.dataset.r47PriorityPath='';
  s.innerHTML=`<div class="section-kicker">YOUR ONBOARDING PATH</div><h2 style="margin:3px 0 10px;font-size:16px">위에서 아래로 이 순서만 따라가면 됩니다.</h2>
  <div class="r47-path">
    <div class="r47-path-step" data-r47-step="LOGIN"><b>1. 로그인 / Workspace</b><span>개인화와 서버 저장의 시작점</span></div>
    <div class="r47-path-step" data-r47-step="CONTEXT"><b>2. 내 Context</b><span>역할·팀·상급자 기대를 최소 입력</span></div>
    <div class="r47-path-step" data-r47-step="SETUP"><b>3. 12 Setup</b><span>새 팀 파악과 운영 룰을 하나씩 완료</span></div>
    <div class="r47-path-step" data-r47-step="QUEST"><b>4. 30-Day Quest</b><span>실제 업무에서 Practice → Evidence</span></div>
  </div>`;
  return s
}
function consolidateLeaderOnboarding(){
  const page=q('[data-page="LEADER_ONBOARDING"]');if(!page||page.dataset.r47Ready)return;
  page.dataset.r47Ready='1';
  const h1=q(':scope > h1',page),sub=q(':scope > p.sub',page);
  const hero=q(':scope > .r21-hero',page),banner=q(':scope > .r21-banner',page),layout=q(':scope > .r21-layout',page);
  const layoutCards=layout?qa(':scope > section.card',layout):[];
  const guided=layoutCards.find(x=>q('.section-kicker',x)?.textContent?.includes('GUIDED SETUP'))||null;
  const context=layoutCards.find(x=>q('.section-kicker',x)?.textContent?.includes('YOUR CONTEXT'))||null;
  const personalized=q(':scope > [data-r22-personalized]',page);
  const quick=q(':scope > .r22-grid.two',page);
  const completion=q(':scope > [data-r22-completion]',page);
  const firstWeek=qa(':scope > section.card',page).find(x=>q('.section-kicker',x)?.textContent?.includes('FIRST WEEK PLAN'))||null;
  const howWork=qa(':scope > section.card',page).find(x=>q('.section-kicker',x)?.textContent?.includes('HOW WE WORK'))||null;
  const questPage=q('[data-page="ONBOARDING"]');
  const checklist=questPage?q('.setup-checklist-card',questPage):null;

  const flow=mk('div','r47-flow');flow.dataset.r47OnboardingFlow='';
  if(sub)sub.insertAdjacentElement('afterend',flow);else if(h1)h1.insertAdjacentElement('afterend',flow);else page.prepend(flow);
  const auth=authShell();if(auth)flow.append(auth);
  flow.append(makePriorityPath());
  if(hero)flow.append(hero);
  if(banner)flow.append(banner);
  if(context){context.classList.add('r47-context-focus');flow.append(context)}
  if(personalized){personalized.classList.add('r47-personalized-focus');personalized.style.marginTop='0';flow.append(personalized)}
  if(completion){completion.style.marginTop='0';flow.append(completion)}
  if(checklist){checklist.classList.add('r47-setup-focus');flow.append(checklist)}
  const cta=mk('section','r47-primary-card',`<div class="section-kicker">NEXT · 30-DAY PRACTICUM</div><h2 style="margin:3px 0 5px;font-size:16px">Setup이 준비되면 30-Day Quest에서 실제 업무로 연결합니다.</h2><p style="font-size:10px;color:var(--ui-muted,#667085);margin:0">30개를 한 번에 끝내는 과정이 아니라, 오늘 필요한 Day만 열어 Practice와 Evidence를 남깁니다.</p><div class="r47-cta-row"><button class="primary" type="button" data-r47-open-quest>30-Day Quest 시작 / 이어가기</button><button type="button" data-r47-go-today>Today로 이동</button></div>`);
  flow.append(cta);
  if(quick)flow.append(wrapMany('필요할 때 쓰는 Quick Tools · 첫 1:1 / Calendar',[quick],'r47-quick-tools'));
  const secondaryNodes=[guided,firstWeek,howWork].filter(Boolean);
  if(secondaryNodes.length){
    const sec=wrapMany('보조 가이드 보기 · 6 Setup Gate / First Week / Existing Rules',secondaryNodes,'r47-secondary-guidance');
    flow.append(sec)
  }
  if(layout)layout.remove();
  q('[data-r47-open-quest]',flow)?.addEventListener('click',()=>openPage('ONBOARDING'));
  q('[data-r47-go-today]',flow)?.addEventListener('click',()=>openPage('TODAY'));
}
function questSummary(){
  const page=q('[data-page="ONBOARDING"]');if(!page||q('[data-r47-quest-checkpoint]',page))return;
  const hero=q(':scope > .quest-hero',page);if(!hero)return;
  const box=mk('section','r47-quest-checkpoint');box.dataset.r47QuestCheckpoint='';
  box.innerHTML=`<div><div class="section-kicker">SETUP CHECKPOINT</div><h3>30-Day Quest 전에 Setup 상태를 확인합니다.</h3><p data-r47-quest-setup-copy>0 / 12 Setup · 개인화 상태 확인 중</p><div class="r47-mini-progress"><span data-r47-quest-setup-bar></span></div></div><button type="button" data-r47-back-setup>12 Setup 관리</button>`;
  hero.insertAdjacentElement('afterend',box);
  q('[data-r47-back-setup]',box).onclick=()=>openPage('LEADER_ONBOARDING');
}
function consolidateQuest(){
  const page=q('[data-page="ONBOARDING"]');if(!page||page.dataset.r47Ready)return;
  page.dataset.r47Ready='1';
  questSummary();
  const phase=q(':scope > .phase-grid',page);
  const curriculum=qa(':scope > section.card',page).find(x=>q('h2',x)?.textContent?.includes('30 Daily Quests'))||null;
  const visual=q(':scope > .visual-playbook',page);
  const toolkit=q(':scope > .grid',page);
  const artifacts=q(':scope > .artifact-shell',page);
  if(visual){
    const d=wrapMany('예시와 샘플맵 보기 · Example → My Team',[visual],'r47-examples');
    (curriculum||phase||q('[data-r47-quest-checkpoint]',page)).insertAdjacentElement('afterend',d)
  }
  const weekly=q(':scope > .weekly-review-shell',page);
  const charter=q(':scope > .charter-shell',page);
  const transition=q(':scope > .day30-transition-shell',page);
  const integrations=qa(':scope > .integration-shell',page);
  const graph=integrations.find(x=>q('h2',x)?.textContent?.includes('그래프'))||null;
  const inspector=integrations.find(x=>q('h2',x)?.textContent?.includes('역추적'))||null;
  const outcome=integrations.find(x=>q('h2',x)?.textContent?.includes('Evidence로 검증'))||null;
  const managerBrief=integrations.find(x=>q('h2',x)?.textContent?.includes('상급자 보고'))||null;
  const provenance=qa(':scope > section.card',page).find(x=>q('.section-kicker',x)?.textContent?.includes('KNOWLEDGE PROVENANCE'))||null;

  const anchor=artifacts||toolkit||curriculum;
  if(anchor){
    const divider=mk('div','r47-section-divider','<b>REVIEW & SCALE · 완료 후 필요할 때</b>');
    anchor.insertAdjacentElement('afterend',divider);
    const review=wrapMany('Review / Team OS Charter / 30→90 / Manager Reporting',[weekly,charter,transition,outcome,managerBrief],'r47-review-scale');
    divider.insertAdjacentElement('afterend',review);
    const advanced=wrapMany('Advanced Diagnostics · Operating Graph / Evidence Inspector / Provenance',[graph,inspector,provenance],'r47-advanced');
    review.insertAdjacentElement('afterend',advanced)
  }
}
function todayAccountCard(){
  const page=q('[data-page="TODAY"]');if(!page||q('[data-r47-today-personalization]',page))return;
  const card=mk('section','r47-today-personalization');card.dataset.r47TodayPersonalization='';
  card.innerHTML=`<div><strong>개인화 상태</strong><span data-r47-today-account-copy>로그인 상태 확인 중…</span></div><button type="button" data-r47-account-open>로그인 / Workspace</button>`;
  const target=q(':scope > h1',page);if(target)target.insertAdjacentElement('afterend',card);else page.prepend(card);
  q('[data-r47-account-open]',card).onclick=()=>{openPage('LEADER_ONBOARDING');setTimeout(()=>q('[data-r47-auth-shell]')?.scrollIntoView({behavior:'smooth',block:'start'}),120)}
}
function topAccountButton(){
  const top=q('.topbar-actions')||q('[data-topbar-actions]');if(!top||q('[data-r47-top-account]',top))return;
  const b=mk('button','r47-top-account','계정 / Workspace');b.type='button';b.dataset.r47TopAccount='';
  b.onclick=()=>{openPage('LEADER_ONBOARDING');setTimeout(()=>q('[data-r47-auth-shell]')?.scrollIntoView({behavior:'smooth',block:'start'}),120)};
  top.prepend(b)
}
function navClarity(){
  const reports=q('[data-fallback-page="REPORTS"]');if(reports)reports.textContent='Report Archive';
  const twa=q('[data-fallback-page="TEAM_WORKING_AGREEMENT"]');if(twa)twa.textContent='Working Agreement';
  const nav=q('[data-primary-nav]'), leader=q('[data-r21-onboarding-nav]',nav||document);
  if(nav&&leader&&!q('[data-r47-quest-nav]',nav)){
    const a=document.createElement('a');a.href='#30-day-quest';a.dataset.r47QuestNav='';a.textContent='30-Day Quest';a.onclick=e=>{e.preventDefault();openPage('ONBOARDING')};leader.insertAdjacentElement('afterend',a)
  }
}
function progressNumber(text,total){
  const m=String(text||'').match(/(\d+)\s*\/\s*(\d+)/);return m?{done:Number(m[1]),total:Number(m[2])}:{done:0,total}
}
function updateState(){
  const s=bridgeState(),auth=q('[data-r47-auth-shell]'),authState=q('[data-r47-auth-state]');
  const signed=!!s.signedIn, workspace=!!s.workspaceId;
  if(auth){auth.classList.toggle('needs-login',!signed||!workspace);auth.classList.toggle('personalized',signed&&workspace)}
  if(authState){
    authState.className='r47-auth-state '+(signed&&workspace?'active':'warn');
    authState.textContent=signed&&workspace?`개인화 활성 · ${s.workspaceName||s.workspaceId}`:signed?'Workspace 선택 필요':'로그인 필요 · 개인화 비활성'
  }
  const today=q('[data-r47-today-account-copy]');
  if(today)today.textContent=signed&&workspace?`${s.workspaceName||s.workspaceId} 기준으로 저장·검색·추천을 사용합니다.`:signed?'Workspace를 선택하면 개인화가 시작됩니다.':'현재 Demo/Local 상태입니다. 로그인하면 내 팀 기준으로 바뀝니다.';
  const top=q('[data-r47-top-account]');if(top)top.textContent=signed&&workspace?(s.workspaceName||'Workspace'):'로그인 / Workspace';

  const contextDone=!!(q('[data-r21-team-name]')?.value?.trim()||q('[data-r21-manager]')?.value?.trim());
  const setup=progressNumber(q('[data-setup-progress-copy]')?.textContent,12);
  const quest=progressNumber(q('[data-quest-progress-text]')?.textContent,30);
  const states={LOGIN:signed&&workspace,CONTEXT:contextDone,SETUP:setup.done>0,QUEST:quest.done>0};
  qa('[data-r47-step]').forEach(step=>{
    const key=step.dataset.r47Step,done=!!states[key];
    step.classList.toggle('done',done);
    step.classList.toggle('current',!done && ((key==='LOGIN')|| (key==='CONTEXT'&&states.LOGIN)||(key==='SETUP'&&states.LOGIN&&states.CONTEXT)||(key==='QUEST'&&states.LOGIN&&states.CONTEXT&&setup.done>0)))
  });
  const copy=q('[data-r47-quest-setup-copy]'),bar=q('[data-r47-quest-setup-bar]');
  if(copy)copy.textContent=`${setup.done} / 12 Setup · ${signed&&workspace?'Workspace 개인화 활성':'Local / Demo 상태'}`;
  if(bar)bar.style.width=`${Math.round(setup.done/12*100)}%`;
}
function consolidateLateMountedSections(){
  const leader=q('[data-page="LEADER_ONBOARDING"]');
  const secondaryBody=q('.r47-secondary-guidance > .r47-disclosure-body',leader||document);
  if(leader&&secondaryBody){
    qa(':scope > .r31-card',leader).forEach(node=>secondaryBody.append(node));
  }
  const quest=q('[data-page="ONBOARDING"]');
  if(quest){
    const reviewBody=q('.r47-review-scale > .r47-disclosure-body',quest);
    const advancedBody=q('.r47-advanced > .r47-disclosure-body',quest);
    if(reviewBody) qa(':scope > .r19-policy-card',quest).forEach(node=>reviewBody.append(node));
    if(advancedBody){
      qa(':scope > .r17-shell',quest).forEach(node=>advancedBody.append(node));
      qa(':scope > section.card',quest).forEach(node=>{
        const kicker=q('.section-kicker',node)?.textContent||'';
        if(kicker.includes('KNOWLEDGE PROVENANCE')) advancedBody.append(node);
      });
      qa(':scope > .integration-shell',quest).forEach(node=>{
        const title=q('h2',node)?.textContent||'';
        if(/graph|inspector|역추적|provenance|diagnostic/i.test(title)) advancedBody.append(node);
      });
    }
  }
}
function signedOutFirstPriority(){
  const s=bridgeState();
  if(s.signedIn)return;
  if(location.hash && !['','#today','#leader-onboarding'].includes(location.hash))return;
  if(window.LeaderOsR21?.showOnboarding) window.LeaderOsR21.showOnboarding();
}
function init(){
  consolidateLeaderOnboarding();
  consolidateQuest();
  todayAccountCard();
  topAccountButton();
  navClarity();
  updateState();
  [120,500,1200,2400].forEach(ms=>setTimeout(consolidateLateMountedSections,ms));
  setTimeout(signedOutFirstPriority,700);
  setInterval(updateState,1500);
  document.addEventListener('click',()=>setTimeout(updateState,100),true);
  document.addEventListener('change',()=>setTimeout(updateState,60),true);
  document.title='Leader OS · Recovery 47 · UX Priority & Consolidation';
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>
<script id="recovery-48-header-section-consolidation">
(()=>{
'use strict';
const q=(s,r=document)=>r.querySelector(s),qa=(s,r=document)=>Array.from(r.querySelectorAll(s));
const el=(tag,cls,html='')=>{const n=document.createElement(tag);if(cls)n.className=cls;if(html)n.innerHTML=html;return n};
const runtimeState=()=>{try{return window.LeaderOsReportRuntimeBridge?.state?.()||{signedIn:false,workspaceId:null,workspaceName:null}}catch{return{signedIn:false,workspaceId:null,workspaceName:null}}};

function openLeaderOnboarding(){
  if(window.LeaderOsR21?.showOnboarding){window.LeaderOsR21.showOnboarding();return}
  q('[data-r21-onboarding-nav]')?.click();
}
function concept(kicker,title,description,children=[],extra=''){
  const s=el('section',`r48-concept ${extra}`.trim());
  s.innerHTML=`<div class="r48-concept-head"><div><div class="r48-concept-kicker">${kicker}</div><h2>${title}</h2><p>${description}</p></div></div><div class="r48-concept-body"></div>`;
  const body=q('.r48-concept-body',s);children.filter(Boolean).forEach(n=>body.append(n));return s
}
function disclosure(title,children=[],extra=''){
  const d=el('details',`r48-reference ${extra}`.trim());
  d.innerHTML=`<summary>${title}</summary><div class="r48-reference-body"></div>`;
  const body=q('.r48-reference-body',d);children.filter(Boolean).forEach(n=>body.append(n));return d
}

/* ---------- HEADER ---------- */
let headerBusy=false;
function normalizeHeader(){
  if(headerBusy)return;
  const top=q('.topbar-actions');if(!top)return;
  headerBusy=true;
  try{
    let account=q('[data-r47-top-account]',top)||q('[data-r48-account]',top);
    if(!account){
      account=el('button','r47-top-account','로그인 / Workspace');
      account.type='button';account.dataset.r48Account='';
      account.onclick=()=>{openLeaderOnboarding();setTimeout(()=>q('[data-r47-auth-shell]')?.scrollIntoView({behavior:'smooth',block:'start'}),120)};
      top.prepend(account);
    }
    account.textContent='로그인 / Workspace';
    account.setAttribute('aria-label','로그인 및 Workspace 설정');
    const st=runtimeState();
    account.title=st.signedIn&&st.workspaceId?`현재 Workspace · ${st.workspaceName||st.workspaceId}`:'로그인 후 Workspace를 선택하면 개인화됩니다.';

    let demo=q('[data-showcase-demo]',top);
    let search=q('[data-lo-search-open]',top);
    if(!search&&window.LeaderOsSearch?.open){
      search=el('button','lo-search-trigger','⌕ 전체 검색');
      search.type='button';search.dataset.loSearchOpen='';search.onclick=()=>window.LeaderOsSearch.open();
      top.append(search);
    }
    if(search){
      search.innerHTML='<span class="lo-search-left"><span>⌕</span><span>전체 검색</span></span>';
      search.setAttribute('aria-label','전체 검색 · Command K');
      search.title='전체 검색 · ⌘K / Ctrl+K';
    }

    if(demo){
      demo.textContent='SHOWCASE DEMO';
      demo.setAttribute('aria-label','Showcase Demo');
    }
    const desired=[account,demo,search].filter(Boolean);
    const keep=new Set(desired);
    [...top.children].forEach(node=>{if(!keep.has(node))node.remove()});
    const current=[...top.children];
    const alreadyOrdered=current.length===desired.length && desired.every((node,index)=>current[index]===node);
    if(!alreadyOrdered)top.replaceChildren(...desired);
  }finally{headerBusy=false}
}
const headerObserver=new MutationObserver(()=>setTimeout(normalizeHeader,0));

/* ---------- LEADER ONBOARDING ---------- */
function rewriteOnboardingCopy(page){
  const h1=q(':scope > h1',page),sub=q(':scope > p.sub',page);
  if(h1)h1.textContent='새 팀을 맡은 리더의 시작';
  if(sub)sub.textContent='로그인 후 내 역할과 팀 Context를 설정하고, 12개 Setup을 거쳐 30일 실습으로 이어집니다.';
}
function consolidateLeaderOnboarding(){
  const page=q('[data-page="LEADER_ONBOARDING"]');if(!page)return;
  rewriteOnboardingCopy(page);
  const flow=q('[data-r47-onboarding-flow]',page);if(!flow||flow.dataset.r48Ready)return;
  flow.dataset.r48Ready='1';
  const auth=q('[data-r47-auth-shell]',flow);
  const path=q('[data-r47-priority-path]',flow);path?.remove();
  const hero=q('.r21-hero',flow),banner=q('.r21-banner',flow);
  const context=q('.r47-context-focus',flow);
  const personalized=q('.r47-personalized-focus',flow);
  const completion=q('.r22-completion',flow);
  const setup=q('.r47-setup-focus',flow);
  const questCta=qa(':scope > .r47-primary-card',flow).find(x=>q('.section-kicker',x)?.textContent?.includes('30-DAY'))||null;
  const quick=q('.r47-quick-tools',flow),secondary=q('.r47-secondary-guidance',flow);

  const resumeButton=banner?.querySelector('button')||null;
  const principle=el('section','r48-principle');
  principle.innerHTML='<div class="r48-principle-copy"><b>첫 30일의 원칙</b><br><span>빨리 바꾸기보다 사람·일·결정 흐름을 먼저 이해하고, 확인된 Context를 기준으로 운영 룰을 만듭니다.</span></div>';
  if(resumeButton)principle.append(resumeButton);

  if(context){
    const k=q('.section-kicker',context);if(k)k.textContent='입력 · 최소 Context';
    const h=q('h2',context);if(h)h.textContent='내 역할과 팀을 이해하는 데 필요한 정보';
  }
  if(personalized){
    const k=q('.section-kicker',personalized);if(k)k.textContent='개인화 · 첫 7일';
    const h=q('h2',personalized);if(h)h.textContent='내 상황에 맞춘 첫 7일 우선순위';
  }
  if(completion){
    const k=q('.section-kicker',completion);if(k)k.textContent='다음 행동 · Today';
    const h=q('h2',completion);if(h)h.textContent='오늘의 Top 3로 연결';
  }
  const contextConcept=concept(
    '2 · CONTEXT',
    '나와 팀의 Context를 먼저 맞춥니다.',
    '최소 정보만 입력하고, 그 Context로 첫 7일의 질문과 Today 우선순위를 만듭니다.',
    [context,personalized,completion]
  );

  if(setup){
    const k=q('.section-kicker',setup);if(k)k.textContent='SETUP · NEW LEADER';
    const h=q('h2',setup);if(h)h.textContent='12개 Setup · 팀 이해와 운영 기준 세우기';
    const p=q('p',setup);if(p)p.textContent='30개 기능을 먼저 배우지 않고, 실제로 필요한 12개 운영 결과물을 하나씩 만듭니다.';
  }
  const setupConcept=concept(
    '3 · SETUP',
    '12개 Setup으로 팀 운영의 기본 구조를 만듭니다.',
    '체크 → 필요한 Quest 열기 → Artifact 저장의 한 흐름으로 사용합니다.',
    [setup]
  );

  if(questCta){
    questCta.classList.add('r48-primary-next');
    const k=q('.section-kicker',questCta);if(k)k.textContent='PRACTICE · 30-DAY';
    const h=q('h2',questCta);if(h)h.textContent='30일 동안 실제 팀에서 연습합니다.';
    const p=q('p',questCta);if(p)p.textContent='하루 하나의 과제를 실행하고 Evidence와 Debrief를 남겨 리더십을 운영 습관으로 바꿉니다.';
  }

  const referenceNodes=[];
  if(quick){
    const body=q('.r47-disclosure-body',quick);
    if(body)referenceNodes.push(...[...body.children]);
  }
  if(secondary){
    const body=q('.r47-disclosure-body',secondary);
    if(body){
      [...body.children].forEach(n=>{
        const text=(q('.section-kicker',n)?.textContent||q('h2',n)?.textContent||'').toUpperCase();
        // 6 Setup Gate and First Week duplicate the canonical 12 Setup / personalized first 7 days.
        if(text.includes('GUIDED SETUP')||text.includes('FIRST WEEK')){n.remove();return}
        referenceNodes.push(n);
      });
    }
  }
  const reference=disclosure('REFERENCE · 첫 1:1 · Calendar · 기존 Working Agreement',[...referenceNodes]);
  quick?.remove();secondary?.remove();hero?.remove();banner?.remove();

  const nodes=[auth,principle,contextConcept,setupConcept,questCta,reference].filter(Boolean);
  flow.replaceChildren(...nodes);
}

/* ---------- 30-DAY QUEST ---------- */
function rewriteQuestCopy(page){
  const h1=q(':scope > h1',page),sub=q(':scope > p.sub',page);
  if(h1)h1.textContent='30일 리더 실습';
  if(sub)sub.textContent='하루 하나의 리더십 과제를 실제 팀에서 실행하고, 결과물과 Evidence·Debrief를 남깁니다.';
  const hero=q(':scope > .quest-hero',page);
  if(hero){
    const h=q('h2',hero);if(h)h.textContent='Practice → Evidence → Debrief';
    const p=q('p',hero);if(p)p.textContent='읽고 끝내지 않습니다. 오늘 필요한 과제만 열어 실제 업무에서 실행합니다.';
  }
}
function consolidateQuest(){
  const page=q('[data-page="ONBOARDING"]');if(!page)return;
  rewriteQuestCopy(page);
  if(page.dataset.r48Ready)return;
  const phase=q(':scope > .phase-grid',page);
  const curriculum=qa(':scope > section.card',page).find(x=>q('.section-kicker',x)?.textContent?.includes('CURRICULUM'))||null;
  const toolkit=q(':scope > .grid',page);
  const artifacts=q(':scope > .artifact-shell',page);
  const exampleDetails=q(':scope > .r47-examples',page);
  if(!curriculum||!artifacts)return;
  page.dataset.r48Ready='1';

  const practice=concept(
    'PRACTICE',
    '오늘 필요한 Quest만 실행합니다.',
    'Phase를 확인하고 Day를 선택한 뒤, Case → Practice → Evidence → Debrief 순서로 진행합니다.',
    [phase,curriculum],
    'r48-quest-practice'
  );
  const checkpoint=q('[data-r47-quest-checkpoint]',page);
  (checkpoint||q(':scope > .quest-hero',page))?.insertAdjacentElement('afterend',practice);

  const resources=[];
  if(exampleDetails){
    const b=q('.r47-disclosure-body',exampleDetails);
    if(b)resources.push(...[...b.children]);
  }
  if(toolkit)resources.push(toolkit);
  const ref=disclosure('REFERENCE · 예시 · Toolkit · Sample Map',resources,'r48-quest-resources');
  practice.insertAdjacentElement('afterend',ref);
  exampleDetails?.remove();

  const k=q('.section-kicker',artifacts);if(k)k.textContent='OUTPUT · OPERATING ARTIFACTS';
  const h=q('h2',artifacts);if(h)h.textContent='내 팀에서 실제로 쓸 운영 문서';
  const p=q('p',artifacts);if(p)p.textContent='Quest에서 만든 결과물을 내 팀의 문서로 저장·수정·Human Confirm합니다.';

  const review=q('.r47-review-scale',page);
  if(review){const s=q(':scope > summary',review);if(s)s.textContent='REVIEW & SCALE · 주간 리뷰 · Team OS · 다음 60일 · 보고'}
  const advanced=q('.r47-advanced',page);
  if(advanced){const s=q(':scope > summary',advanced);if(s)s.textContent='ADVANCED · 근거 · 연결 · 운영 진단'}

  // Remove any duplicate Setup checklist that was not moved by the previous recovery.
  qa(':scope > .setup-checklist-card',page).forEach(n=>n.remove());
}

/* ---------- TODAY ---------- */
function consolidateToday(){
  const page=q('[data-page="TODAY"]');if(!page||page.dataset.r48Ready)return;
  page.dataset.r48Ready='1';
  const h1=q(':scope > h1',page),sub=q(':scope > p.sub',page);
  if(h1)h1.textContent='Today';
  if(sub)sub.textContent='내 Workspace의 Priority · Decision · Follow-up을 한 곳에서 확인합니다.';
  const welcome=q(':scope > .today-welcome',page);
  const account=q(':scope > [data-r47-today-personalization]',page);
  const nudge=q(':scope > .today-nudge-card',page);
  const attention=q(':scope > .grid',page);
  const ai=q(':scope > .ai25-today-attention',page);
  const runtime=q(':scope > .runtime-mode-card',page);
  const auth=q('[data-page="LEADER_ONBOARDING"] [data-r47-auth-shell]');
  if(runtime&&auth)auth.append(runtime);
  const anchor=sub||h1;
  let cursor=anchor;
  [welcome,account,nudge,attention].filter(Boolean).forEach(n=>{cursor.insertAdjacentElement('afterend',n);cursor=n});
  if(ai){
    const d=disclosure('SYSTEM · AI 운영 상태',[ai],'r48-today-system');
    cursor.insertAdjacentElement('afterend',d);
  }
}

/* ---------- DOCUMENT LANGUAGE ---------- */
function normalizeLabels(){
  const replacements=[
    ['[data-page="WORK"] > p.sub','프로젝트의 Outcome · Owner · Milestone · Risk를 보고, 필요한 다음 행동을 정합니다.'],
    ['[data-page="MEETINGS"] > p.sub','회의 전 준비 → 결정 → 후속 행동을 한 흐름으로 관리합니다.'],
    ['[data-page="DECISIONS"] > p.sub','결정 내용 · 이유 · 근거 · Owner · Review Date를 기록하고 사람이 확정합니다.'],
    ['[data-page="REPORTS"] > p.sub','확정된 운영 변화와 미해결 흐름을 기간별로 다시 봅니다.']
  ];
  replacements.forEach(([sel,text])=>{const n=q(sel);if(n)n.textContent=text});
  const reports=q('[data-fallback-page="REPORTS"]');if(reports)reports.textContent='Report Archive';
}

/* ---------- DUPLICATE / ERROR GUARD ---------- */
function removeDuplicateSections(){
  // The same canonical checklist must exist in one visible place only.
  const setup=qa('.setup-checklist-card');
  setup.forEach((n,i)=>{if(i>0)n.remove()});
  // Old R47 path only repeats the visible section order.
  qa('[data-r47-priority-path]').forEach(n=>n.remove());
}
function updateAccountStatus(){
  const st=runtimeState(),a=q('[data-r47-top-account], [data-r48-account]');
  if(a){
    a.textContent='로그인 / Workspace';
    a.title=st.signedIn&&st.workspaceId?`현재 Workspace · ${st.workspaceName||st.workspaceId}`:'로그인 후 Workspace를 선택하면 개인화됩니다.';
  }
}
function run(){
  normalizeHeader();
  consolidateLeaderOnboarding();
  consolidateQuest();
  consolidateToday();
  normalizeLabels();
  removeDuplicateSections();
  updateAccountStatus();
}
function init(){
  const top=q('.topbar-actions');if(top)headerObserver.observe(top,{childList:true});
  [0,80,250,650,1400,2600].forEach(ms=>setTimeout(run,ms));
  setInterval(updateAccountStatus,1800);
  document.addEventListener('click',()=>setTimeout(run,70),true);
  document.addEventListener('change',()=>setTimeout(run,70),true);
  document.title='Leader OS · Recovery 48 · Header & Section Consolidation';
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>
<script id="recovery-49-leadership-harness">
(()=>{
'use strict';
const q=(s,r=document)=>r.querySelector(s),qa=(s,r=document)=>Array.from(r.querySelectorAll(s));
const st=()=>{try{return window.LeaderOsReportRuntimeBridge?.state?.()||{signedIn:false,workspaceId:null,workspaceName:null}}catch{return{signedIn:false,workspaceId:null,workspaceName:null}}};
const hs=()=>{try{return window.LeaderOsLeadershipHarness?.snapshot?.()||null}catch{return null}};
const contextReady=()=>!!(q('[data-r21-team-name]')?.value?.trim() && q('[data-r21-manager]')?.value?.trim());
const phaseOrder=['UNDERSTAND','ALIGN','EMPOWER','COACH'];
const phasePurpose={
 UNDERSTAND:['팀 이해','사람·일·관계의 실제 Context를 파악'],
 ALIGN:['운영 기준','시간·Work·Milestone·Priority를 연결'],
 EMPOWER:['결정·위임','누가 결정하고 어디까지 맡기는지 명확화'],
 COACH:['코칭·Team OS','피드백·1:1·회고를 운영 리듬으로 고정']
};
function accountScroll(){
  if(window.LeaderOsAuthUi?.open){window.LeaderOsAuthUi.open();return}
  window.LeaderOsR21?.showOnboarding?.();
}
function contextScroll(){
  window.LeaderOsR21?.showOnboarding?.();
  setTimeout(()=>q('[data-r21-team-name]')?.closest('section')?.scrollIntoView({behavior:'smooth',block:'start'}),120)
}
function chooseNext(){
  const state=st(),h=hs();
  if(!state.signedIn||!state.workspaceId)return {title:'로그인 / Workspace부터 연결',reason:'개인화·30일 진행 저장·Evidence 연결의 시작점입니다.',label:'로그인 / Workspace',run:accountScroll};
  const serverResume=window.LeaderOsResumeBridge?.snapshot?.();
  const serverNext=serverResume?.nextBestAction;
  if(serverNext){
    if(serverNext.kind==='CONTEXT')return {title:serverNext.title,reason:serverNext.reason,label:'Context 입력',run:contextScroll};
    if(serverNext.kind==='SETUP')return {title:serverNext.title,reason:serverNext.reason,label:'다음 Setup 실행',run:()=>window.LeaderOsLeadershipHarness?.openDay?.(serverNext.targetDay)};
    if(serverNext.kind==='QUEST')return {title:serverNext.title,reason:serverNext.reason,label:'Quest 이어가기',run:()=>window.LeaderOsLeadershipHarness?.openDay?.(serverNext.targetDay)};
    if(serverNext.kind==='COMPLETE')return {title:serverNext.title,reason:serverNext.reason,label:'Day 30 / Review',run:()=>window.LeaderOsLeadershipHarness?.openDay?.(30)};
  }
  if(!contextReady())return {title:'내 역할과 팀 Context를 먼저 맞추기',reason:'30일 과정의 코칭과 다음 행동이 실제 팀 기준으로 바뀝니다.',label:'Context 입력',run:contextScroll};
  if(h?.nextSetup)return {title:`Day ${h.nextSetup.day} · ${h.nextSetup.title}`,reason:`12 Setup의 다음 미완료 항목 · ${h.nextSetup.artifact}`,label:'다음 Setup 실행',run:()=>window.LeaderOsLeadershipHarness?.openDay?.(h.nextSetup.day)};
  if(h?.nextQuest)return {title:`Day ${h.nextQuest.day} · ${h.nextQuest.title}`,reason:`${h.nextQuest.phase} · ${h.nextQuest.artifact}`,label:'오늘 Quest 실행',run:()=>window.LeaderOsLeadershipHarness?.openDay?.(h.nextQuest.day)};
  return {title:'30일 완주 · Team OS를 다음 60일 운영으로 전환',reason:'Charter와 Next 60 Plan을 검토하고 실제 팀 리듬으로 고정합니다.',label:'Day 30 / Review',run:()=>window.LeaderOsLeadershipHarness?.openDay?.(30)};
}
function finishCards(h){
  return phaseOrder.map((phase)=>{
    const x=h?.phaseStatus?.[phase],p=phasePurpose[phase];
    const total=x?.questTotal||0,done=x?.questDone||0;
    const pct=total?Math.round(done/total*100):0;
    const current=h?.currentQuest?.phase===phase;
    const cls=x?.ready?'done':current?'current':'';
    return `<div class="r49-finish ${cls}"><small>${phase} · ${x?.days||''}</small><b>${p[0]}</b><span>${p[1]}</span><div class="r49-finish-meter"><i style="width:${pct}%"></i></div><span style="margin-top:5px">${done}/${total} Quest · Output ${x?.outputDone||0}/${x?.outputTotal||0}${x?.gateComplete?' · Gate ✓':''}</span></div>`;
  }).join('');
}
function harnessHtml(location){
  const h=hs(),state=st(),next=chooseNext();
  const server=state.signedIn&&state.workspaceId?(h?.server?.version?`Workspace 저장 · v${h.server.version}`:'Workspace 연결 · 동기화 대기'):'Local / Demo';
  const day=h?.nextQuest?.day||h?.currentQuest?.day||1;
  const phase=h?.nextQuest?.phase||h?.currentQuest?.phase||'UNDERSTAND';
  const gate=h?.phaseStatus?.[phase];
  return `<div class="r49-harness-head"><div><div class="r49-harness-kicker">30-DAY LEADERSHIP ONBOARDING HARNESS</div><h2>30일 안에 ‘팀 이해 → 운영 프로세스 → 결정·위임 → 코칭 리듬’을 만듭니다.</h2><p>이 앱의 목적은 리더십을 읽게 하는 것이 아니라, 실제 팀에서 실행하고 Evidence를 남기며 Team OS를 만드는 것입니다.</p></div><span class="r49-server-state">${server}</span></div>
  <div class="r49-finish-grid">${finishCards(h)}</div>
  <div class="r49-next"><div><small style="font-size:8px;font-weight:900;color:#357451">NEXT BEST ACTION · DAY ${day} · ${phase}</small><strong>${next.title}</strong><div class="r49-reason">${next.reason}</div></div><button type="button" class="primary" data-r49-next>${next.label} →</button></div>
  ${gate?`<div class="r49-phase-gate">Phase Gate · Day ${gate.gateDay} · ${gate.finish} · 현재 Output ${gate.outputDone}/${gate.outputTotal}</div>`:''}
  ${location==='ONBOARDING'?'<div class="r49-purpose-note"><b>App Coach</b>는 매일 실행 전 질문·대화 구조·Debrief를 제시합니다. COACH Phase는 반대로 리더가 팀원을 코칭하는 습관을 만드는 구간입니다.</div>':''}`;
}
function bindNext(root){const b=q('[data-r49-next]',root);if(b)b.onclick=()=>chooseNext().run()}
function renderOnboarding(){
  const page=q('[data-page="LEADER_ONBOARDING"]'),flow=q('[data-r47-onboarding-flow]',page||document),auth=q('[data-r47-auth-shell]',page||document);
  if(!page||!flow||!auth)return;
  let box=q('[data-r49-harness-overview]',flow);
  if(!box){box=document.createElement('section');box.className='r49-harness';box.dataset.r49HarnessOverview='';auth.insertAdjacentElement('afterend',box)}
  box.innerHTML=harnessHtml('LEADER_ONBOARDING');bindNext(box)
}
function renderQuest(){
  const page=q('[data-page="ONBOARDING"]'),hero=q(':scope > .quest-hero',page||document);
  if(!page||!hero)return;
  let box=q('[data-r49-quest-harness]',page);
  if(!box){box=document.createElement('section');box.className='r49-harness r49-quest-harness';box.dataset.r49QuestHarness='';const checkpoint=q('[data-r47-quest-checkpoint]',page);(checkpoint||hero).insertAdjacentElement('afterend',box)}
  box.innerHTML=harnessHtml('ONBOARDING');bindNext(box)
}
function clarifyCoachPage(){
  const page=q('[data-page="LEADER_COACH"]');if(!page)return;
  const h=q(':scope > h1',page),sub=q(':scope > p.sub',page);
  if(h)h.textContent='Leader Coach · 리더를 코칭하는 실전 가이드';
  if(sub)sub.textContent='업무·보고·피드백·1:1·위임·회의·결정·회고에서 리더가 어떤 질문과 언어를 사용할지 연습합니다.';
}
function update(){
  renderOnboarding();renderQuest();clarifyCoachPage();
}
function init(){
  [0,120,500,1200,2400].forEach(ms=>setTimeout(update,ms));
  setInterval(update,1800);
  document.addEventListener('click',()=>setTimeout(update,80),true);
  document.addEventListener('change',()=>setTimeout(update,80),true);
  document.title='Leader OS · Recovery 49 · 30-Day Leadership Harness';
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>
<script id="recovery-50-stability-recovery">
(()=>{
'use strict';
const q=(s,r=document)=>r.querySelector(s);
function addStabilityNote(){
  const root=q('[data-r49-harness-overview]');
  if(!root||q('[data-r50-stability-note]',root))return;
  const n=document.createElement('div');n.className='r50-stability-note';n.dataset.r50StabilityNote='';
  n.innerHTML='<b>저장 격리</b> · 로그인 사용자의 30일 진행·12 Setup·Local Artifact cache는 현재 User + Workspace 기준으로 분리됩니다. 다른 계정의 진행 상태를 자동 병합하지 않습니다.';
  root.append(n)
}
function init(){
  [0,300,1000,2200].forEach(ms=>setTimeout(addStabilityNote,ms));
  document.title='Leader OS · Recovery 50 · Stability Recovery';
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
