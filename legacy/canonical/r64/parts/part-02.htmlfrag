cks === 'object' ? parsed.missionChecks : {},\n            selfVerification: parsed.selfVerification && typeof parsed.selfVerification === 'object' ? parsed.selfVerification : {},\n            missionUpdatedAt: typeof parsed.missionUpdatedAt === 'string' ? parsed.missionUpdatedAt : null,\n            selfCheckUpdatedAt: typeof parsed.selfCheckUpdatedAt === 'string' ? parsed.selfCheckUpdatedAt : null,\n            setupChecks: Array.isArray(parsed.setupChecks) ? parsed.setupChecks.map(String) : [],\n            setupUpdatedAt: typeof parsed.setupUpdatedAt === 'string' ? parsed.setupUpdatedAt : null,\n            questProgressUpdatedAt: typeof parsed.questProgressUpdatedAt === 'string' ? parsed.questProgressUpdatedAt : null,\n            selectedDay: Number(parsed.selectedDay) || 1,\n            phase: typeof parsed.phase === 'string' ? parsed.phase : 'ALL',\n            sampleBoard: typeof parsed.sampleBoard === 'string' ? parsed.sampleBoard : 'TEAM_CALENDAR',\n            artifactTab: typeof parsed.artifactTab === 'string' ? parsed.artifactTab : 'TEAM_MAP',\n            rolePack: typeof parsed.rolePack === 'string' ? parsed.rolePack : 'TEAM_MANAGER'\n        };\n    }\n    catch { return defaultQuestStore(); }\n};\nlet questStore = readQuestStore();\nconst saveQuestStore = () => { try { browserStorage.setItem(activeQuestStorageKey, JSON.stringify(questStore)); } catch {} };\nconst switchQuestStoreScope = () => {\n    const nextScope=questStorageScope();\n    if(nextScope===activeQuestStorageScope) return false;\n    try { browserStorage.setItem(activeQuestStorageKey, JSON.stringify(questStore)); } catch {}\n    activeQuestStorageScope=nextScope;\n    activeQuestStorageKey=questStorageKey(nextScope);\n    questStore=readQuestStore(activeQuestStorageKey, nextScope==='guest');\n    setupServerVersion=0;\n    setupServerWorkspace=null;\n    questProgressServerVersion=0;\n    questProgressServerWorkspace=null;\n    missionServerVersion=0;\n    missionServerWorkspace=null;\n    selfCheckServerVersion=0;\n    selfCheckServerWorkspace=null;\n    return true;\n};\n\nlet setupServerVersion = 0;\nlet setupServerWorkspace = null;\nlet setupHydrating = false;\nlet setupSaveTimer = null;\nconst setupStatusNode = () => document.querySelector('[data-setup-storage-status]');\nconst setSetupStorageStatus = (message, tone = 'local') => {\n    const node = setupStatusNode();\n    if (!node) return;\n    node.textContent = message;\n    node.dataset.storageTone = tone;\n};\nconst setupRuntimeState = () => {\n    try { return reportRuntimeBridge.state(); }\n    catch { return { signedIn:false, workspaceId:null, workspaceName:null }; }\n};\nconst sameStringSet = (a,b) => {\n    const aa=[...new Set((a||[]).map(String))].sort();\n    const bb=[...new Set((b||[]).map(String))].sort();\n    return aa.length===bb.length && aa.every((v,i)=>v===bb[i]);\n};\nconst saveSetupChecklistToServer = async () => {\n    const state = setupRuntimeState();\n    if (!state.signedIn || !state.workspaceId) {\n        setSetupStorageStatus('브라우저 Local Storage에 저장됨 · 로그인하면 Workspace 서버와 동기화됩니다.','local');\n        return null;\n    }\n    switchQuestStoreScope();\n    const scopeKey=`${state.userId||'anon'}|${state.workspaceId}`;\n    setSetupStorageStatus('브라우저 저장 완료 · Workspace 서버 동기화 중…','syncing');\n    try {\n        const result = await reportRuntimeBridge.saveSetupChecklist({\n            eventId:`SETUP-12-${Date.now().toString(36)}`,\n            expectedVersion:setupServerVersion,\n            checkedIds:[...questStore.setupChecks]\n        });\n        const record=result?.record;\n        setupServerVersion=Number(record?.version ?? setupServerVersion);\n        setupServerWorkspace=scopeKey;\n        const serverUpdated=record?.updated_at || record?.updatedAt || new Date().toISOString();\n        questStore.setupUpdatedAt=serverUpdated;\n        saveQuestStore();\n        setSetupStorageStatus(`Workspace 서버 저장됨 · v${setupServerVersion} · ${state.workspaceName || state.workspaceId}`,'server');\n        try { window.dispatchEvent(new CustomEvent('leaderos:setup-changed')); } catch {}\n        return record;\n    } catch (error) {\n        const code=error?.code || error?.message || String(error);\n        if (String(code).includes('VERSION_CONFLICT')) {\n            setupServerWorkspace=null;\n            setSetupStorageStatus('다른 화면에서 체크리스트가 변경되었습니다. 최신 서버 상태를 다시 불러옵니다.','conflict');\n            setTimeout(()=>hydrateSetupChecklistFromServer(true),120);\n        } else {\n            setSetupStorageStatus(`Local 저장은 완료됨 · 서버 동기화 실패: ${code}`,'error');\n        }\n        return null;\n    }\n};\nconst queueSetupChecklistServerSave = () => {\n    const state=setupRuntimeState();\n    if (!state.signedIn || !state.workspaceId) {\n        setSetupStorageStatus('브라우저 Local Storage에 저장됨 · 로그인하면 Workspace 서버와 동기화됩니다.','local');\n        return;\n    }\n    clearTimeout(setupSaveTimer);\n    setSetupStorageStatus('브라우저 저장 완료 · 서버 저장 대기 중…','syncing');\n    setupSaveTimer=setTimeout(()=>saveSetupChecklistToServer(),320);\n};\nconst hydrateSetupChecklistFromServer = async (force=false) => {\n    const state=setupRuntimeState();\n    if (!state.signedIn || !state.workspaceId) {\n        setSetupStorageStatus('브라우저 Local Storage 모드 · 로그인하면 Workspace DB와 동기화됩니다.','local');\n        return;\n    }\n    switchQuestStoreScope();\n    const scopeKey=`${state.userId||'anon'}|${state.workspaceId}`;\n    if (setupHydrating) return;\n    if (!force && setupServerWorkspace===scopeKey) return;\n    setupHydrating=true;\n    try {\n        setSetupStorageStatus('Workspace 서버의 체크리스트 상태를 불러오는 중…','syncing');\n        const response=await reportRuntimeBridge.setupChecklistStatus();\n        const server=response?.setupChecklist || {};\n        const serverVersion=Number(server.version || 0);\n        const serverIds=Array.isArray(server.checkedIds) ? server.checkedIds.map(String) : [];\n        const serverTime=server.updatedAt ? new Date(server.updatedAt).getTime() : 0;\n        const localTime=questStore.setupUpdatedAt ? new Date(questStore.setupUpdatedAt).getTime() : 0;\n        setupServerVersion=serverVersion;\n        setupServerWorkspace=scopeKey;\n\n        if (serverVersion===0) {\n            if (questStore.setupChecks.length) {\n                await saveSetupChecklistToServer();\n            } else {\n                setSetupStorageStatus(`Workspace 서버 연결됨 · 아직 저장된 Setup 체크 없음 · ${state.workspaceName || state.workspaceId}`,'server');\n            }\n        } else if (localTime > serverTime + 1000 && !sameStringSet(questStore.setupChecks,serverIds)) {\n            await saveSetupChecklistToServer();\n        } else {\n            questStore.setupChecks=serverIds;\n            questStore.setupUpdatedAt=server.updatedAt || questStore.setupUpdatedAt;\n            saveQuestStore();\n            renderSetupChecklist();\n            renderTodayLeaderNudge();\n            setSetupStorageStatus(`Workspace 서버 상태 불러옴 · v${serverVersion} · ${serverIds.length}/12 수동 체크 저장`,'server');\n        }\n    } catch (error) {\n        setSetupStorageStatus(`Local Storage 유지 · 서버 상태 로드 실패: ${error?.code || error?.message || String(error)}`,'error');\n    } finally {\n        setupHydrating=false;\n    }\n};\n\n\nconst ARTIFACT_STORAGE_BASE = 'leader-os:operating-artifacts:v7';\nconst refArray = (value) => {\n    if (Array.isArray(value)) return [...new Set(value.map((x)=>String(x||'').trim()).filter(Boolean))];\n    const text=String(value||'').trim();\n    if(!text) return [];\n    return [...new Set(text.split(',').map((x)=>x.trim()).filter(Boolean))];\n};\nconst normalizeArtifactRows = (rows,type='') => Array.isArray(rows) ? rows.map((row) => {\n    const normalized={\n      ...row,\n      version: Number.isInteger(Number(row?.version)) ? Number(row.version) : 1,\n      artifactState: typeof row?.artifactState === 'string' ? row.artifactState : 'DRAFT',\n      history: Array.isArray(row?.history) ? row.history : []\n    };\n    const migrate=(plural,singular)=>{ normalized[plural]=refArray(row?.[plural] ?? row?.[singular]); if(singular in normalized) delete normalized[singular]; };\n    if(type==='WORK_MAP'){ migrate('milestoneRefs','milestoneRef');migrate('decisionRefs','decisionRef');migrate('delegationRefs','delegationRef');migrate('debriefRefs','debriefRef');migrate('calendarRefs','calendarRef'); }\n    if(type==='MILESTONES'){ migrate('workRefs','workRef');migrate('decisionRefs','decisionRef');migrate('calendarRefs','calendarRef'); }\n    if(type==='DECISION_RIGHTS'){ migrate('workRefs','workRef');migrate('milestoneRefs','milestoneRef'); }\n    if(type==='DELEGATION'){ migrate('workRefs','workRef');migrate('commitmentRefs','commitmentRef'); }\n    if(type==='DEBRIEF'){ migrate('workRefs','workRef');migrate('commitmentRefs','commitmentRef'); }\n    if(type==='TEAM_CALENDAR'){ migrate('workRefs','workRef');migrate('milestoneRefs','milestoneRef'); }\n    if(type==='ONE_ON_ONE_COMMITMENT'){ migrate('delegationRefs','delegationRef');migrate('debriefRefs','debriefRef'); }\n    return normalized;\n}) : [];\nconst artifactShape = (parsed = {}) => ({\n    workspaceId: typeof parsed.workspaceId === 'string' ? parsed.workspaceId : 'DEMO-WORKSPACE',\n    MANAGER_CONTRACT: normalizeArtifactRows(parsed.MANAGER_CONTRACT,'MANAGER_CONTRACT'),\n    TEAM_MAP: normalizeArtifactRows(parsed.TEAM_MAP,'TEAM_MAP'),\n    TEAM_PATTERN: normalizeArtifactRows(parsed.TEAM_PATTERN,'TEAM_PATTERN'),\n    STAKEHOLDER_MAP: normalizeArtifactRows(parsed.STAKEHOLDER_MAP,'STAKEHOLDER_MAP'),\n    TEAM_CALENDAR: normalizeArtifactRows(parsed.TEAM_CALENDAR,'TEAM_CALENDAR'),\n    WORK_MAP: normalizeArtifactRows(parsed.WORK_MAP,'WORK_MAP'),\n    MILESTONES: normalizeArtifactRows(parsed.MILESTONES,'MILESTONES'),\n    PRIORITY_CONTRACT: normalizeArtifactRows(parsed.PRIORITY_CONTRACT,'PRIORITY_CONTRACT'),\n    DECISION_RIGHTS: normalizeArtifactRows(parsed.DECISION_RIGHTS,'DECISION_RIGHTS'),\n    DELEGATION: normalizeArtifactRows(parsed.DELEGATION,'DELEGATION'),\n    FEEDBACK_PRACTICE: normalizeArtifactRows(parsed.FEEDBACK_PRACTICE,'FEEDBACK_PRACTICE'),\n    OPERATING_RHYTHM: normalizeArtifactRows(parsed.OPERATING_RHYTHM,'OPERATING_RHYTHM'),\n    DEBRIEF: normalizeArtifactRows(parsed.DEBRIEF,'DEBRIEF'),\n    ONE_ON_ONE_COMMITMENT: normalizeArtifactRows(parsed.ONE_ON_ONE_COMMITMENT,'ONE_ON_ONE_COMMITMENT'),\n    WEEKLY_REVIEW: normalizeArtifactRows(parsed.WEEKLY_REVIEW,'WEEKLY_REVIEW'),\n    TEAM_OS_CHARTER: normalizeArtifactRows(parsed.TEAM_OS_CHARTER,'TEAM_OS_CHARTER'),\n    NEXT_60_PLAN: normalizeArtifactRows(parsed.NEXT_60_PLAN,'NEXT_60_PLAN'),\n    NEXT_60_CHECKIN: normalizeArtifactRows(parsed.NEXT_60_CHECKIN,'NEXT_60_CHECKIN'),\n    REPORT_BRIEF: normalizeArtifactRows(parsed.REPORT_BRIEF,'REPORT_BRIEF')\n});\n\nconst artifactStorageScope = () => {\n    try {\n        const state=reportRuntimeBridge.state();\n        return state.signedIn && state.userId && state.workspaceId\n            ? `${state.userId}:${state.workspaceId}`\n            : 'guest';\n    } catch { return 'guest'; }\n};\nconst artifactStorageKey = (scope) => `${ARTIFACT_STORAGE_BASE}:${scope}`;\nlet activeArtifactStorageScope=artifactStorageScope();\nlet activeArtifactStorageKey=artifactStorageKey(activeArtifactStorageScope);\nconst readArtifactStore = (key=activeArtifactStorageKey, allowLegacy=activeArtifactStorageScope==='guest') => {\n    try {\n        const raw = browserStorage.getItem(key) || (allowLegacy\n            ? browserStorage.getItem('leader-os:operating-artifacts:v6')\n                || browserStorage.getItem('leader-os:operating-artifacts:v5')\n                || browserStorage.getItem('leader-os:operating-artifacts:v4')\n                || browserStorage.getItem('leader-os:operating-artifacts:v3')\n                || browserStorage.getItem('leader-os:operating-artifacts:v2')\n                || browserStorage.getItem('leader-os:operating-artifacts:v1')\n            : null);\n        return raw ? artifactShape(JSON.parse(raw)) : artifactShape();\n    } catch { return artifactShape(); }\n};\nlet artifactStore = readArtifactStore();\nconst notifyArtifactChange = (reason='SAVE') => {\n    try { window.dispatchEvent(new CustomEvent('leaderos:artifacts-changed',{detail:{reason,scope:activeArtifactStorageScope}})); } catch {}\n};\nconst saveArtifactStore = () => {\n    try { browserStorage.setItem(activeArtifactStorageKey, JSON.stringify(artifactStore)); } catch {}\n    notifyArtifactChange('SAVE');\n};\nconst switchArtifactStoreScope = () => {\n    const nextScope=artifactStorageScope();\n    if(nextScope===activeArtifactStorageScope) return false;\n    try { browserStorage.setItem(activeArtifactStorageKey, JSON.stringify(artifactStore)); } catch {}\n    activeArtifactStorageScope=nextScope;\n    activeArtifactStorageKey=artifactStorageKey(nextScope);\n    artifactStore=readArtifactStore(activeArtifactStorageKey,nextScope==='guest');\n    artifactServerWorkspace=null;\n    notifyArtifactChange('SCOPE_SWITCH');\n    return true;\n};\n\nlet artifactServerWorkspace = null;\nlet artifactHydrating = false;\nconst artifactSyncTimers = new Map();\nconst artifactRuntimeState = () => {\n    try { return reportRuntimeBridge.state(); }\n    catch { return { signedIn:false, userId:null, workspaceId:null, workspaceName:null }; }\n};\nconst artifactStatusMessage = (message, tone='local') => {\n    if (!artifactStorageStatus) return;\n    artifactStorageStatus.textContent = message;\n    artifactStorageStatus.dataset.storageTone = tone;\n};\nconst localArtifactRecord = (type,id) => artifactRows(type).find((row)=>row.id===id) || null;\nconst persistServerMeta = (type,id,patch) => {\n    const rows=artifactRows(type), index=rows.findIndex((row)=>row.id===id);\n    if(index<0) return null;\n    rows[index]={...rows[index],...patch};\n    artifactStore[type]=rows;\n    saveArtifactStore();\n    return rows[index];\n};\nconst syncOperatingArtifactToServer = async (type,id) => {\n    const state=artifactRuntimeState();\n    switchArtifactStoreScope();\n    const row=localArtifactRecord(type,id);\n    if(!row) return null;\n    if(!state.signedIn || !state.workspaceId){\n        artifactStatusMessage(`LOCAL · ${allArtifactRecords().length} OBJECTS · 로그인하면 Workspace DB와 동기화됩니다.`,'local');\n        return null;\n    }\n    artifactStatusMessage(`LOCAL 저장 완료 · ${type} 서버 동기화 중…`,'syncing');\n    try{\n        const result=await reportRuntimeBridge.saveOperatingArtifact({\n            eventId:`ARTIFACT-${String(id).slice(-20)}-${Date.now().toString(36)}`,\n            artifactId:id,\n            artifactType:type,\n            artifactState:String(row.artifactState||'DRAFT').toUpperCase(),\n            expectedVersion:Number(row.serverVersion||0),\n            localVersion:Number(row.version||1),\n            title:artifactPrimary(type,row),\n            payload:artifactDataSnapshot(row)\n        });\n        const record=result?.artifact||{};\n        const next=persistServerMeta(type,id,{\n            serverVersion:Number(record.version||row.serverVersion||0),\n            serverSyncedAt:record.updated_at||record.updatedAt||new Date().toISOString(),\n            serverSyncError:null\n        });\n        artifactServerWorkspace=`${state.userId||'anon'}|${state.workspaceId}`;\n        artifactStatusMessage(`WORKSPACE DB SYNC · ${type} · server v${next?.serverVersion||record.version||'?'}`,'server');\n        if(typeof renderSetupChecklist==='function') renderSetupChecklist();\n        return record;\n    }catch(error){\n        const code=error?.code||error?.message||String(error);\n        persistServerMeta(type,id,{serverSyncError:code});\n        if(String(code).includes('VERSION_CONFLICT')){\n            artifactStatusMessage(`${type} Version 충돌 · 서버 최신 상태를 다시 불러옵니다.`,'conflict');\n            artifactServerWorkspace=null;\n            setTimeout(()=>hydrateOperatingArtifactsFromServer(true),160);\n        }else{\n            artifactStatusMessage(`Local 저장 유지 · ${type} 서버 동기화 실패: ${code}`,'error');\n        }\n        return null;\n    }\n};\nconst queueOperatingArtifactSync = (type,id) => {\n    const state=artifactRuntimeState();\n    if(!state.signedIn || !state.workspaceId){\n        artifactStatusMessage(`LOCAL · ${allArtifactRecords().length} OBJECTS · 로그인하면 Workspace DB와 동기화됩니다.`,'local');\n        return;\n    }\n    const key=`${type}|${id}`;\n    clearTimeout(artifactSyncTimers.get(key));\n    artifactSyncTimers.set(key,setTimeout(()=>{artifactSyncTimers.delete(key);syncOperatingArtifactToServer(type,id)},260));\n};\nconst deleteOperatingArtifactFromServer = async (type,row) => {\n    const state=artifactRuntimeState();\n    if(!state.signedIn || !state.workspaceId || !row?.serverVersion) return null;\n    artifactStatusMessage(`${type} 서버 삭제 상태 반영 중…`,'syncing');\n    try{\n        const result=await reportRuntimeBridge.deleteOperatingArtifact({\n            eventId:`ARTIFACT-DELETE-${String(row.id).slice(-18)}-${Date.now().toString(36)}`,\n            artifactId:row.id,\n            expectedVersion:Number(row.serverVersion)\n        });\n        artifactStatusMessage(`WORKSPACE DB · ${type} 삭제 반영됨`,'server');\n        return result?.artifact||null;\n    }catch(error){\n        artifactStatusMessage(`로컬에서는 삭제됨 · 서버 삭제 반영 실패: ${error?.code||error?.message||String(error)}`,'error');\n        return null;\n    }\n};\nconst hydrateOperatingArtifactsFromServer = async (force=false) => {\n    const state=artifactRuntimeState();\n    if(!state.signedIn || !state.workspaceId){\n        artifactStatusMessage(`LOCAL · ${allArtifactRecords().length} OBJECTS · 로그인하면 Workspace DB와 동기화됩니다.`,'local');\n        return;\n    }\n    switchArtifactStoreScope();\n    const scopeKey=`${state.userId||'anon'}|${state.workspaceId}`;\n    if(artifactHydrating) return;\n    if(!force && artifactServerWorkspace===scopeKey) return;\n    artifactHydrating=true;\n    try{\n        artifactStatusMessage('Workspace Operating Artifacts 불러오는 중…','syncing');\n        const response=await reportRuntimeBridge.operatingArtifactsStatus(250);\n        const serverRows=Array.isArray(response?.artifacts)?response.artifacts:[];\n        const serverIds=new Set();\n        for(const item of serverRows){\n            const type=String(item.artifactType||'');\n            if(!artifactDefinitions[type]) continue;\n            const id=String(item.artifactId||'');\n            if(!id) continue;\n            serverIds.add(`${type}|${id}`);\n            if(!Array.isArray(artifactStore[type])) artifactStore[type]=[];\n            const rows=artifactStore[type], index=rows.findIndex((row)=>row.id===id);\n            const serverRow={\n                id,\n                ...(item.payload&&typeof item.payload==='object'?item.payload:{}),\n                version:Number(item.localVersion||1),\n                artifactState:String(item.artifactState||'DRAFT').toUpperCase(),\n                history:index>=0&&Array.isArray(rows[index].history)?rows[index].history:[],\n                updatedAt:item.updatedAt||new Date().toISOString(),\n                serverVersion:Number(item.version||0),\n                serverSyncedAt:item.updatedAt||null,\n                serverSyncError:null\n            };\n            if(index<0) rows.push(serverRow);\n            else if(rows[index].serverVersion && Number(item.version||0)>Number(rows[index].serverVersion||0)) rows[index]=serverRow;\n            artifactStore[type]=rows;\n        }\n        saveArtifactStore();\n        artifactServerWorkspace=scopeKey;\n\n        const unsynced=allArtifactRecords().filter((row)=>!row.serverVersion);\n        for(const row of unsynced.slice(0,40)){\n            const type=row.artifactType;\n            if(type&&artifactDefinitions[type]) queueOperatingArtifactSync(type,row.id);\n        }\n        renderArtifactWorkspace();\n        renderSetupChecklist();\n        renderQuestList();\n        renderTodayLeaderNudge();\n        artifactStatusMessage(`WORKSPACE DB · ${serverRows.length} server artifacts · ${unsynced.length} local pending`,'server');\n    }catch(error){\n        artifactStatusMessage(`Local-first 유지 · 서버 Artifact 로드 실패: ${error?.code||error?.message||String(error)}`,'error');\n    }finally{\n        artifactHydrating=false;\n    }\n};\n\n\nconst ROLE_PACKS = Object.freeze({\n    TEAM_MANAGER:{ name:'Team Manager', summary:'처음 팀을 맡은 리더의 기본 운영 루프: 사람 → 리듬 → 결정 → 위임 → 회고.', focus:'운영 명확성', starter:{ person:'민지', role:'Brand PM', milestone:'Team Operating Rhythm v1', decision:'주간 Top 3 우선순위', delegation:'주간 회의 운영' } },\n    MARKETING_LEADER:{ name:'Marketing Leader', summary:'캠페인·예산·성과 의사결정과 채널 간 역할 분담을 중심으로 봅니다.', focus:'성과와 의사결정 속도', starter:{ person:'준호', role:'Performance Lead', milestone:'Campaign Concept Lock', decision:'광고 예산 ±10%', delegation:'소재 A/B 테스트' } },\n    CREATIVE_DIRECTOR:{ name:'Creative Director', summary:'크리에이티브 기준·승인·피드백·외주 품질의 Decision Rights를 중심으로 봅니다.', focus:'기준과 승인 병목', starter:{ person:'서연', role:'Creative Lead', milestone:'Hero Visual Lock', decision:'최종 비주얼 방향', delegation:'콘셉트 보드 1차 선택' } },\n    PRODUCT_LEAD:{ name:'Product Lead', summary:'제품 우선순위·Discovery·Milestone·Cross-functional 결정 구조를 중심으로 봅니다.', focus:'제품 판단과 의존성', starter:{ person:'지훈', role:'Product Manager', milestone:'MVP Scope Lock', decision:'이번 Sprint Scope', delegation:'Discovery 인터뷰 운영' } }\n});\nconst renderRolePack = () => {\n    const pack = ROLE_PACKS[questStore.rolePack] || ROLE_PACKS.TEAM_MANAGER;\n    rolePackSelect.value = questStore.rolePack in ROLE_PACKS ? questStore.rolePack : 'TEAM_MANAGER';\n    rolePackTitle.textContent = pack.name;\n    rolePackSummary.textContent = `${pack.summary} · Focus: ${pack.focus}`;\n};\nrolePackSelect.addEventListener('change', () => {\n    questStore.rolePack = rolePackSelect.value;\n    saveQuestStore();\n    renderRolePack();\n    renderArtifactWorkspace();\n    renderTodayLeaderNudge();\nrenderRecovery14Surfaces();\n});\n\nconst QUEST_ARTIFACT_TYPE = Object.freeze({ 2:'MANAGER_CONTRACT', 3:'TEAM_MAP', 5:'TEAM_PATTERN', 6:'STAKEHOLDER_MAP', 8:'TEAM_CALENDAR', 10:'WORK_MAP', 11:'MILESTONES', 13:'PRIORITY_CONTRACT', 16:'DECISION_RIGHTS', 19:'DELEGATION', 20:'DELEGATION', 22:'FEEDBACK_PRACTICE', 26:'DEBRIEF', 28:'OPERATING_RHYTHM', 30:'TEAM_OS_CHARTER' });\nconst SETUP_ARTIFACT_TYPE = Object.freeze({\n    'OBSERVE-ROLE':'MANAGER_CONTRACT',\n    'OBSERVE-TEAM':'TEAM_MAP',\n    'OBSERVE-1ON1':'TEAM_PATTERN',\n    'MAP-CALENDAR':'TEAM_CALENDAR',\n    'MAP-WORK':'WORK_MAP',\n    'MAP-MILESTONE':'MILESTONES',\n    'ALIGN-PRIORITY':'PRIORITY_CONTRACT',\n    'ALIGN-DECISION':'DECISION_RIGHTS',\n    'ALIGN-DELEGATE':'DELEGATION',\n    'OPERATE-FEEDBACK':'FEEDBACK_PRACTICE',\n    'OPERATE-DEBRIEF':'DEBRIEF',\n    'OPERATE-RHYTHM':'TEAM_OS_CHARTER'\n});\nconst setupGroups = {\n    UNDERSTAND:'1 · UNDERSTAND · 팀 이해',\n    ALIGN:'2 · ALIGN · 운영 기준',\n    EMPOWER:'3 · EMPOWER · 결정·위임',\n    COACH:'4 · COACH · 코칭·회고'\n};\nconst QUEST_COACH_SCENARIO_BY_DAY = Object.freeze({\n    1:'DEBRIEF',2:'REPORT',3:'TASK',4:'ONEONONE',5:'ONEONONE',6:'TASK',7:'DEBRIEF',\n    8:'MEETING',9:'MEETING',10:'TASK',11:'TASK',12:'TASK',13:'REPORT',14:'DEBRIEF',\n    15:'DECISION',16:'DECISION',17:'DECISION',18:'DELEGATE',19:'DELEGATE',20:'DELEGATE',21:'DEBRIEF',\n    22:'FEEDBACK',23:'FEEDBACK',24:'ONEONONE',25:'FEEDBACK',26:'DEBRIEF',27:'DEBRIEF',28:'MEETING',29:'DEBRIEF',30:'REPORT'\n});\nconst LEADERSHIP_HARNESS_PHASES = Object.freeze({\n    UNDERSTAND:{days:'1–7',label:'팀 이해',finish:'사람·일·관계의 실제 Context를 설명할 수 있다.',gateDay:7,artifacts:['MANAGER_CONTRACT','TEAM_MAP','TEAM_PATTERN']},\n    ALIGN:{days:'8–14',label:'운영 기준',finish:'시간·Work·Milestone·Priority가 하나의 운영 기준으로 연결된다.',gateDay:14,artifacts:['TEAM_CALENDAR','WORK_MAP','MILESTONES','PRIORITY_CONTRACT']},\n    EMPOWER:{days:'15–21',label:'결정·위임',finish:'중요 결정의 D와 업무별 권한 범위를 팀이 이해한다.',gateDay:21,artifacts:['DECISION_RIGHTS','DELEGATION']},\n    COACH:{days:'22–30',label:'코칭·Team OS',finish:'피드백·회고·운영 리듬이 반복되고 Team OS Charter로 남는다.',gateDay:30,artifacts:['FEEDBACK_PRACTICE','DEBRIEF','OPERATING_RHYTHM','TEAM_OS_CHARTER']}\n});\nconst artifactRows = (type) => Array.isArray(artifactStore[type]) ? artifactStore[type] : [];\nconst allArtifactRecords = () => Object.entries(artifactStore).flatMap(([type, rows]) => Array.isArray(rows) ? rows.map((row) => ({ ...row, artifactType:type })) : []);\nconst artifactRecordById = (id) => allArtifactRecords().find((row) => row.id === id) || null;\nconst artifactPrimary = (type, row) => {\n    if (!row) return type;\n    if (type === 'MANAGER_CONTRACT') return `Manager Contract · ${row.manager || '상급자 미정'}`;\n    if (type === 'TEAM_MAP') return `${row.name || '팀원'} · ${row.role || '역할 미정'}`;\n    if (type === 'TEAM_PATTERN') return row.pattern || 'Team Pattern';\n    if (type === 'STAKEHOLDER_MAP') return `${row.stakeholder || 'Stakeholder'} · ${row.role || '역할 미정'}`;\n    if (type === 'TEAM_CALENDAR') return `${row.day || ''} ${row.time || ''} · ${row.title || '일정'}`.trim();\n    if (type === 'WORK_MAP') return `${row.project || 'Project'} · ${row.owner || 'Owner 미정'}`;\n    if (type === 'MILESTONES') return `${row.project || 'Project'} · ${row.milestone || 'Milestone'}`;\n    if (type === 'PRIORITY_CONTRACT') return row.priority1 || 'Priority Contract';\n    if (type === 'DECISION_RIGHTS') return row.decision || 'Decision';\n    if (type === 'DELEGATION') return row.task || 'Delegation';\n    if (type === 'FEEDBACK_PRACTICE') return `${row.person || 'Feedback'} · ${row.situation || 'Situation'}`;\n    if (type === 'OPERATING_RHYTHM') return row.name || 'Team Operating Rhythm';\n    if (type === 'DEBRIEF') return row.actual || row.expected || 'Debrief';\n    if (type === 'ONE_ON_ONE_COMMITMENT') return `${row.person || 'Person'} · ${row.commitment || 'Commitment'}`;\n    if (type === 'WEEKLY_REVIEW') return `Weekly Review · ${row.week || 'This week'}`;\n    if (type === 'TEAM_OS_CHARTER') return `Team OS Charter · ${row.versionLabel || 'v1'}`;\n    if (type === 'NEXT_60_PLAN') return `Next 60 Days · ${row.period || 'Day 31–90'}`;\n    if (type === 'NEXT_60_CHECKIN') return `${row.week || 'Weekly'} · ${row.outcomeKey || 'Outcome'} · ${row.status || 'CHECK-IN'}`;\n    if (type === 'REPORT_BRIEF') return `Manager Brief · ${row.week || 'This week'}`;\n    return type;\n};\nconst artifactRefsForDay = (day) => Array.isArray(questStore.evidenceRefs?.[String(day)]) ? questStore.evidenceRefs[String(day)].filter((id) => artifactRecordById(id)) : [];\nconst linkArtifactToQuest = (day, artifactId) => {\n    const key = String(day);\n    const refs = new Set(artifactRefsForDay(day));\n    refs.add(artifactId);\n    questStore.evidenceRefs[key] = [...refs];\n    saveQuestStore();\n};\nconst unlinkArtifactFromQuest = (day, artifactId) => {\n    const key = String(day);\n    questStore.evidenceRefs[key] = artifactRefsForDay(day).filter((id) => id !== artifactId);\n    saveQuestStore();\n};\nconst removeArtifactRefs = (artifactId) => {\n    for (const [day, refs] of Object.entries(questStore.evidenceRefs || {})) {\n        if (Array.isArray(refs) && refs.includes(artifactId)) questStore.evidenceRefs[day] = refs.filter((id) => id !== artifactId);\n    }\n    saveQuestStore();\n};\nconst setupDone = (item) => {\n    const type = SETUP_ARTIFACT_TYPE[item.id];\n    if (type && artifactRows(type).length > 0) return { done:true, auto:true, source:`${artifactRows(type).length} Artifact` };\n    if (questStore.completed.includes(item.day)) return { done:true, auto:true, source:`Day ${item.day} Evidence` };\n    if (questStore.setupChecks.includes(item.id)) return { done:true, auto:false, source:'Manual' };\n    return { done:false, auto:false, source:'Not started' };\n};\nconst renderSetupChecklist = () => {\n    setupChecklistRoot.innerHTML = Object.entries(setupGroups).map(([group,label]) => {\n        const items = LEADERSHIP_SETUP_CHECKLIST.filter((item) => item.group === group);\n        const doneCount = items.filter((item)=>setupDone(item).done).length;\n        return `<section class=\"setup-group\"><div class=\"setup-group-head\"><strong>${escapeHtml(label)}</strong><span>${doneCount}/${items.length}</span></div><div class=\"setup-list\">${items.map((item)=>{\n            const status=setupDone(item);\n            return `<div class=\"setup-item ${status.done?'done':''} ${status.auto?'auto-done':''}\" data-setup-id=\"${escapeHtml(item.id)}\">\n                <label class=\"setup-item-main\">\n                    <input type=\"checkbox\" class=\"setup-native-check\" data-setup-check-id=\"${escapeHtml(item.id)}\" ${status.done?'checked':''} ${status.auto?'disabled':''} aria-label=\"${escapeHtml(item.title)} 완료 체크\">\n                    <span class=\"setup-check\" aria-hidden=\"true\">✓</span>\n                    <span class=\"setup-item-copy\"><strong>${escapeHtml(item.title)}</strong><small>Day ${item.day} · ${escapeHtml(item.artifact)}</small><span class=\"setup-source\">${escapeHtml(status.source)}${status.auto?' · Evidence 기반 자동 완료':''}</span></span>\n                </label>\n                <button type=\"button\" class=\"setup-open-btn\" data-setup-open-id=\"${escapeHtml(item.id)}\">열기</button>\n            </div>`;\n        }).join('')}</div></section>`;\n    }).join('');\n    const done = LEADERSHIP_SETUP_CHECKLIST.filter((item)=>setupDone(item).done).length;\n    const pct = Math.round(done / LEADERSHIP_SETUP_CHECKLIST.length * 100);\n    setupProgressRoot.style.width = `${pct}%`;\n    setupProgressCopy.textContent = `${done} / ${LEADERSHIP_SETUP_CHECKLIST.length}`;\n\n    for (const input of setupChecklistRoot.querySelectorAll('[data-setup-check-id]')) {\n        input.addEventListener('change', () => {\n            const item = LEADERSHIP_SETUP_CHECKLIST.find((row)=>row.id===input.dataset.setupCheckId);\n            if (!item || setupDone(item).auto) return;\n            const set = new Set(questStore.setupChecks);\n            if (input.checked) set.add(item.id); else set.delete(item.id);\n            questStore.setupChecks = [...set];\n            questStore.setupUpdatedAt = new Date().toISOString();\n            saveQuestStore();\n            renderSetupChecklist();\n            renderTodayLeaderNudge();\n            queueSetupChecklistServerSave();\n        });\n    }\n    for (const btn of setupChecklistRoot.querySelectorAll('[data-setup-open-id]')) {\n        btn.addEventListener('click', () => {\n            const item = LEADERSHIP_SETUP_CHECKLIST.find((row)=>row.id===btn.dataset.setupOpenId);\n            if (!item) return;\n            const type = SETUP_ARTIFACT_TYPE[item.id];\n            if (type) {\n                questStore.artifactTab = type;\n                saveQuestStore();\n                renderArtifactWorkspace();\n            }\n            renderQuestDetail(item.day);\n        });\n    }\n};\nsetTimeout(()=>hydrateSetupChecklistFromServer(false),1200);\nwindow.addEventListener('focus',()=>hydrateSetupChecklistFromServer(false));\ndocument.addEventListener('click',(event)=>{\n    if (event.target?.closest?.('[data-route=\"ONBOARDING\"],[data-page-link=\"ONBOARDING\"],[data-r21-path=\"DAY30\"],[data-r21-go-quest]')) {\n        setTimeout(()=>hydrateSetupChecklistFromServer(false),260);\n    }\n},true);\nObject.defineProperty(window,'LeaderOsSetupChecklistBridge',{\n    value:{\n        hydrate:()=>hydrateSetupChecklistFromServer(true),\n        sync:()=>saveSetupChecklistToServer(),\n        state:()=>({checkedIds:[...questStore.setupChecks],updatedAt:questStore.setupUpdatedAt,serverVersion:setupServerVersion,workspaceId:setupServerWorkspace})\n    },\n    enumerable:false,configurable:true\n});\n\n\nlet missionServerVersion = 0;\nlet missionServerWorkspace = null;\nlet missionHydrating = false;\nlet missionSaveTimer = null;\nlet selfCheckServerVersion = 0;\nlet selfCheckServerWorkspace = null;\nlet selfCheckHydrating = false;\nlet selfCheckSaveTimer = null;\nconst missionRuntimeState = () => {\n    try { return reportRuntimeBridge.state(); }\n    catch { return { signedIn:false, userId:null, workspaceId:null, workspaceName:null }; }\n};\nconst normalizeMissionChecks = (raw={}) => {\n    const out={};\n    for(const mission of LEADERSHIP_MISSIONS){\n        const key=String(mission.day);\n        const allowed=new Set(mission.checklist.map((item)=>item.id));\n        const values=Array.isArray(raw?.[key])?raw[key]:[];\n        out[key]=[...new Set(values.map(String).filter((id)=>allowed.has(id)))].sort();\n    }\n    return out;\n};\nconst missionForDay = (day) => LEADERSHIP_MISSIONS.find((item)=>item.day===Number(day)) || LEADERSHIP_MISSIONS[0];\nconst missionCheckedIds = (day) => {\n    const key=String(day);\n    return normalizeMissionChecks(questStore.missionChecks)[key] || [];\n};\nconst missionCheckProgress = (day) => {\n    const mission=missionForDay(day);\n    const checked=new Set(missionCheckedIds(day));\n    const required=mission.checklist.filter((item)=>item.required!==false);\n    const done=required.filter((item)=>checked.has(item.id)).length;\n    return {checked:[...checked],done,total:required.length,complete:required.length>0&&done===required.length};\n};\nconst missionSummarySnapshot = () => {\n    const days=LEADERSHIP_MISSIONS.map((mission)=>{\n        const progress=missionCheckProgress(mission.day);\n        const evidence=Boolean(String(questStore.evidence[String(mission.day)]??'').trim())||artifactRefsForDay(mission.day).length>0;\n        const selfLevel=String(questStore.selfVerification[String(mission.day)]||'NOT_YET');\n        return {...mission,progress,evidence,selfLevel,questComplete:questStore.completed.includes(mission.day)};\n    });\n    const pillars=Object.fromEntries(Object.entries(LEADERSHIP_MISSION_PILLARS).map(([id,meta])=>{\n        const subset=days.filter((d)=>d.pillar===id);\n        return [id,{...meta,days:subset.length,missionComplete:subset.filter((d)=>d.progress.complete).length,evidence:subset.filter((d)=>d.evidence).length,repeatable:subset.filter((d)=>d.selfLevel==='REPEATABLE').length}];\n    }));\n    return {\n        days,\n        pillars,\n        missionCompleteDays:days.filter((d)=>d.progress.complete).length,\n        evidenceDays:days.filter((d)=>d.evidence).length,\n        repeatableDays:days.filter((d)=>d.selfLevel==='REPEATABLE').length,\n        totalDays:30\n    };\n};\nconst saveMissionChecklistToServer = async () => {\n    const state=missionRuntimeState();\n    if(!state.signedIn||!state.workspaceId)return null;\n    switchQuestStoreScope();\n    const scopeKey=`${state.userId||'anon'}|${state.workspaceId}`;\n    try{\n        const result=await reportRuntimeBridge.saveMissionChecklist({\n            eventId:`MISSION-CHECKLIST-${Date.now().toString(36)}`,\n            expectedVersion:missionServerVersion,\n            checksByDay:normalizeMissionChecks(questStore.missionChecks)\n        });\n        const record=result?.record||{};\n        missionServerVersion=Number(record.version||missionServerVersion||0);\n        missionServerWorkspace=scopeKey;\n        questStore.missionUpdatedAt=record.updated_at||record.updatedAt||new Date().toISOString();\n        saveQuestStore();\n        try{window.dispatchEvent(new CustomEvent('leaderos:mission-checklist-changed'))}catch{}\n        return record;\n    }catch(error){\n        if(String(error?.code||error?.message||error).includes('VERSION_CONFLICT')){\n            missionServerWorkspace=null;\n            setTimeout(()=>hydrateMissionChecklistFromServer(true),140);\n        }\n        return null;\n    }\n};\nconst queueMissionChecklistSave = () => {\n    clearTimeout(missionSaveTimer);\n    missionSaveTimer=setTimeout(()=>saveMissionChecklistToServer(),300);\n};\nconst hydrateMissionChecklistFromServer = async (force=false) => {\n    const state=missionRuntimeState();\n    if(!state.signedIn||!state.workspaceId)return;\n    switchQuestStoreScope();\n    const scopeKey=`${state.userId||'anon'}|${state.workspaceId}`;\n    if(missionHydrating)return;\n    if(!force&&missionServerWorkspace===scopeKey)return;\n    missionHydrating=true;\n    try{\n        const response=await reportRuntimeBridge.missionChecklistStatus();\n        const server=response?.missionChecklist||{};\n        missionServerVersion=Number(server.version||0);\n        missionServerWorkspace=scopeKey;\n        const serverChecks=normalizeMissionChecks(server.checksByDay||{});\n        const serverTime=server.updatedAt?new Date(server.updatedAt).getTime():0;\n        const localTime=questStore.missionUpdatedAt?new Date(questStore.missionUpdatedAt).getTime():0;\n        const hasLocal=Object.values(normalizeMissionChecks(questStore.missionChecks)).some((ids)=>ids.length);\n        if(missionServerVersion===0&&hasLocal){\n            missionHydrating=false;\n            return saveMissionChecklistToServer();\n        }\n        if(localTime>serverTime+1000&&hasLocal){\n            missionHydrating=false;\n            return saveMissionChecklistToServer();\n        }\n        questStore.missionChecks=serverChecks;\n        questStore.missionUpdatedAt=server.updatedAt||questStore.missionUpdatedAt;\n        saveQuestStore();\n        renderQuestList();\n        renderQuestDetail(questStore.selectedDay);\n        renderTodayLeaderNudge();\n    }catch{}\n    finally{missionHydrating=false}\n};\nconst saveLeadershipSelfCheckToServer = async () => {\n    const state=missionRuntimeState();\n    if(!state.signedIn||!state.workspaceId)return null;\n    switchQuestStoreScope();\n    const scopeKey=`${state.userId||'anon'}|${state.workspaceId}`;\n    try{\n        const result=await reportRuntimeBridge.saveLeadershipSelfCheck({\n            eventId:`LEADERSHIP-SELF-CHECK-${Date.now().toString(36)}`,\n            expectedVersion:selfCheckServerVersion,\n            levelsByDay:{...questStore.selfVerification}\n        });\n        const record=result?.record||{};\n        selfCheckServerVersion=Number(record.version||selfCheckServerVersion||0);\n        selfCheckServerWorkspace=scopeKey;\n        questStore.selfCheckUpdatedAt=record.updated_at||record.updatedAt||new Date().toISOString();\n        saveQuestStore();\n        try{window.dispatchEvent(new CustomEvent('leaderos:self-check-changed'))}catch{}\n        return record;\n    }catch(error){\n        if(String(error?.code||error?.message||error).includes('VERSION_CONFLICT')){\n            selfCheckServerWorkspace=null;\n            setTimeout(()=>hydrateLeadershipSelfCheckFromServer(true),140);\n        }\n        return null;\n    }\n};\nconst queueLeadershipSelfCheckSave = () => {\n    clearTimeout(selfCheckSaveTimer);\n    selfCheckSaveTimer=setTimeout(()=>saveLeadershipSelfCheckToServer(),300);\n};\nconst hydrateLeadershipSelfCheckFromServer = async (force=false) => {\n    const state=missionRuntimeState();\n    if(!state.signedIn||!state.workspaceId)return;\n    switchQuestStoreScope();\n    const scopeKey=`${state.userId||'anon'}|${state.workspaceId}`;\n    if(selfCheckHydrating)return;\n    if(!force&&selfCheckServerWorkspace===scopeKey)return;\n    selfCheckHydrating=true;\n    try{\n        const response=await reportRuntimeBridge.leadershipSelfCheckStatus();\n        const server=response?.selfCheck||{};\n        selfCheckServerVersion=Number(server.version||0);\n        selfCheckServerWorkspace=scopeKey;\n        const levels=server.levelsByDay&&typeof server.levelsByDay==='object'?server.levelsByDay:{};\n        const serverTime=server.updatedAt?new Date(server.updatedAt).getTime():0;\n        const localTime=questStore.selfCheckUpdatedAt?new Date(questStore.selfCheckUpdatedAt).getTime():0;\n        const hasLocal=Object.keys(questStore.selfVerification||{}).length>0;\n        if(selfCheckServerVersion===0&&hasLocal){\n            selfCheckHydrating=false;\n            return saveLeadershipSelfCheckToServer();\n        }\n        if(localTime>serverTime+1000&&hasLocal){\n            selfCheckHydrating=false;\n            return saveLeadershipSelfCheckToServer();\n        }\n        questStore.selfVerification={...levels};\n        questStore.selfCheckUpdatedAt=server.updatedAt||questStore.selfCheckUpdatedAt;\n        saveQuestStore();\n        renderQuestList();\n        renderQuestDetail(questStore.selectedDay);\n    }catch{}\n    finally{selfCheckHydrating=false}\n};\nsetTimeout(()=>hydrateMissionChecklistFromServer(false),2250);\nsetTimeout(()=>hydrateLeadershipSelfCheckFromServer(false),2350);\nwindow.addEventListener('focus',()=>{hydrateMissionChecklistFromServer(false);hydrateLeadershipSelfCheckFromServer(false)});\n\nlet questProgressServerVersion = 0;\nlet questProgressServerWorkspace = null;\nlet questProgressHydrating = false;\nlet questProgressSaveTimer = null;\nconst questProgressRuntimeState = () => {\n    try { return reportRuntimeBridge.state(); }\n    catch { return { signedIn:false, userId:null, workspaceId:null, workspaceName:null }; }\n};\nconst sameNumberSet = (a,b) => {\n    const aa=[...new Set((a||[]).map(Number))].filter(Number.isInteger).sort((x,y)=>x-y);\n    const bb=[...new Set((b||[]).map(Number))].filter(Number.isInteger).sort((x,y)=>x-y);\n    return aa.length===bb.length && aa.every((v,i)=>v===bb[i]);\n};\nconst saveQuestProgressToServer = async () => {\n    const state=questProgressRuntimeState();\n    if(!state.signedIn || !state.workspaceId) return null;\n    switchQuestStoreScope();\n    const scopeKey=`${state.userId||'anon'}|${state.workspaceId}`;\n    try{\n        const result=await reportRuntimeBridge.saveQuestProgress({\n            eventId:`QUEST-PROGRESS-${Date.now().toString(36)}`,\n            expectedVersion:questProgressServerVersion,\n            completedDays:[...questStore.completed],\n            selectedDay:Number(questStore.selectedDay)||1\n        });\n        const record=result?.record||{};\n        questProgressServerVersion=Number(record.version||questProgressServerVersion||0);\n        questProgressServerWorkspace=scopeKey;\n        questStore.questProgressUpdatedAt=record.updated_at||record.updatedAt||new Date().toISOString();\n        saveQuestStore();\n        try { window.dispatchEvent(new CustomEvent('leaderos:quest-progress-changed')); } catch {}\n        return record;\n    }catch(error){\n        const code=error?.code||error?.message||String(error);\n        if(String(code).includes('VERSION_CONFLICT')){\n            questProgressServerWorkspace=null;\n            setTimeout(()=>hydrateQuestProgressFromServer(true),140);\n        }\n        return null;\n    }\n};\nconst queueQuestProgressServerSave = () => {\n    const state=questProgressRuntimeState();\n    if(!state.signedIn || !state.workspaceId) return;\n    clearTimeout(questProgressSaveTimer);\n    questProgressSaveTimer=setTimeout(()=>saveQuestProgressToServer(),320);\n};\nconst hydrateQuestProgressFromServer = async (force=false) => {\n    const state=questProgressRuntimeState();\n    if(!state.signedIn || !state.workspaceId) return;\n    switchQuestStoreScope();\n    const scopeKey=`${state.userId||'anon'}|${state.workspaceId}`;\n    if(questProgressHydrating) return;\n    if(!force && questProgressServerWorkspace===scopeKey) return;\n    questProgressHydrating=true;\n    try{\n        const response=await reportRuntimeBridge.questProgressStatus();\n        const server=response?.questProgress||{};\n        const serverVersion=Number(server.version||0);\n        const serverDays=Array.isArray(server.completedDays)?server.completedDays.map(Number).filter((d)=>Number.isInteger(d)&&d>=1&&d<=30):[];\n        const serverSelected=Number(server.selectedDay||1);\n        const serverTime=server.updatedAt?new Date(server.updatedAt).getTime():0;\n        const localTime=questStore.questProgressUpdatedAt?new Date(questStore.questProgressUpdatedAt).getTime():0;\n        questProgressServerVersion=serverVersion;\n        questProgressServerWorkspace=scopeKey;\n        if(serverVersion===0){\n            if(questStore.completed.length || Number(questStore.selectedDay)>1) await saveQuestProgressToServer();\n        }else if(localTime>serverTime+1000 && (!sameNumberSet(questStore.completed,serverDays)||Number(questStore.selectedDay)!==serverSelected)){\n            await saveQuestProgressToServer();\n        }else{\n            questStore.completed=[...new Set(serverDays)].sort((a,b)=>a-b);\n            questStore.selectedDay=Number.isInteger(serverSelected)&&serverSelected>=1&&serverSelected<=30?serverSelected:1;\n            questStore.questProgressUpdatedAt=server.updatedAt||questStore.questProgressUpdatedAt;\n            saveQuestStore();\n            renderQuestProgress();\n            renderQuestList();\n            renderSetupChecklist();\n            renderQuestDetail(questStore.selectedDay);\n            renderTodayLeaderNudge();\n        }\n    }catch{}\n    finally{questProgressHydrating=false}\n};\nsetTimeout(()=>hydrateQuestProgressFromServer(false),2100);\nsetInterval(()=>{\n    if(!switchQuestStoreScope()) return;\n    if(typeof renderQuestProgress==='function') renderQuestProgress();\n    if(typeof renderQuestList==='function') renderQuestList();\n    if(typeof renderSetupChecklist==='function') renderSetupChecklist();\n    if(typeof renderQuestDetail==='function') renderQuestDetail(questStore.selectedDay);\n    if(typeof renderTodayLeaderNudge==='function') renderTodayLeaderNudge();\n    setTimeout(()=>hydrateSetupChecklistFromServer(true),80);\n    setTimeout(()=>hydrateQuestProgressFromServer(true),140);\n},1200);\nwindow.addEventListener('focus',()=>hydrateQuestProgressFromServer(false));\n\n\nconst leadershipHarnessSnapshot = () => {\n    const completed=new Set((questStore.completed||[]).map(Number));\n    const nextQuest=LEADERSHIP_QUESTS.find((quest)=>!completed.has(quest.day))||null;\n    const currentQuest=LEADERSHIP_QUESTS.find((quest)=>quest.day===Number(questStore.selectedDay))||nextQuest||LEADERSHIP_QUESTS[29];\n    const setupItems=LEADERSHIP_SETUP_CHECKLIST.map((item)=>({ ...item, ...setupDone(item) }));\n    const phaseStatus=Object.fromEntries(Object.entries(LEADERSHIP_HARNESS_PHASES).map(([phase,def])=>{\n        const phaseQuests=LEADERSHIP_QUESTS.filter((quest)=>quest.phase===phase);\n        const questDone=phaseQuests.filter((quest)=>completed.has(quest.day)).length;\n        const outputDone=def.artifacts.filter((type)=>artifactRows(type).length>0).length;\n        return [phase,{\n            ...def,\n            questDone,\n            questTotal:phaseQuests.length,\n            outputDone,\n            outputTotal:def.artifacts.length,\n            gateComplete:completed.has(def.gateDay),\n            ready:completed.has(def.gateDay)&&outputDone===def.artifacts.length\n        }];\n    }));\n    const nextSetup=setupItems.find((item)=>!item.done)||null;\n    return {\n        total:30,\n        completed:[...completed].sort((a,b)=>a-b),\n        done:completed.size,\n        percent:Math.round((completed.size/30)*100),\n        selectedDay:Number(questStore.selectedDay)||1,\n        currentQuest,\n        nextQuest,\n        nextSetup,\n        phaseStatus,\n        setupDone:setupItems.filter((item)=>item.done).length,\n        setupTotal:setupItems.length,\n        server:{version:questProgressServerVersion,workspaceId:questProgressServerWorkspace}\n    };\n};\nObject.defineProperty(window,'LeaderOsLeadershipHarness',{\n    value:{\n        snapshot:()=>leadershipHarnessSnapshot(),\n        openDay:(day)=>{\n            const target=LEADERSHIP_QUESTS.find((quest)=>quest.day===Number(day));\n            if(!target)return false;\n            navigation.goTo('ONBOARDING');\n            renderQuestDetail(target.day);\n            document.querySelector('[data-quest-detail]')?.scrollIntoView({behavior:'smooth',block:'start'});\n            return true;\n        },\n        hydrate:()=>hydrateQuestProgressFromServer(true),\n        sync:()=>saveQuestProgressToServer()\n    },\n    enumerable:false,\n    configurable:true\n});\n\nconst sampleRefTodayHtml = () => `<div class=\"sample-board\"><div class=\"sample-board-head\"><div><h3>01 · Today — 중요한 것만, 명확하게</h3><p>첨부 예시의 Top 3 Attention + Chief of Staff 보조 구조를 재구성했습니다.</p></div><div class=\"sample-legend\"><span>DECIDE</span><span>TALK</span><span>PREPARE</span></div></div><div class=\"ref-layout\"><div class=\"ref-main\"><div class=\"ref-card\"><div class=\"ref-attention\"><span class=\"no\">01</span><div><span class=\"verb\">DECIDE · 오늘</span><b>Project Alpha</b><small>런칭 일정을 오늘 결정해야 합니다.</small></div><span>›</span></div><div class=\"ref-attention\"><span class=\"no\">02</span><div><span class=\"verb\">TALK · 10:30</span><b>김민지</b><small>1:1에서 디자인 승인 현황을 확인하세요.</small></div><span>›</span></div><div class=\"ref-attention\"><span class=\"no\">03</span><div><span class=\"verb\">PREPARE · 14:00</span><b>Brand Strategy</b><small>내일 회의를 위한 주요 질문을 준비하세요.</small></div><span>›</span></div></div></div><div class=\"ref-rail\"><div class=\"ref-card\"><div class=\"ref-k\">CHIEF OF STAFF · I NOTICED</div><h4>Project Alpha</h4><p>오늘 결정이 지연되면 두 팀의 작업이 지연됩니다.</p></div><div class=\"ref-card\"><div class=\"ref-k\">SUGGESTED</div><h4>김민지와의 1:1 준비</h4><p>최근 승인 이슈 3개를 먼저 확인하세요.</p></div></div></div></div>`;\nconst sampleRefPlanHtml = () => `<div class=\"sample-board\"><div class=\"sample-board-head\"><div><h3>02 · 30-Day Leadership Plan</h3><p>현재 위치와 이번 주 Focus를 먼저 보여주고, 세부 Quest는 필요할 때 엽니다.</p></div></div><div class=\"ref-layout\"><div class=\"ref-main\"><div class=\"ref-card\"><div class=\"ref-k\">DAY 8 / 30</div><h4>지금은 UNDERSTAND → ALIGN 전환 구간</h4><div class=\"ref-progress\"><div class=\"ref-stage\"><strong>UNDERSTAND</strong><span>상황 이해하기</span><div class=\"ref-progressbar\"><i style=\"width:100%\"></i></div></div><div class=\"ref-stage\"><strong>ALIGN</strong><span>사람과 방향 맞추기</span><div class=\"ref-progressbar\"><i style=\"width:25%\"></i></div></div><div class=\"ref-stage\"><strong>EMPOWER</strong><span>결정권과 위임 만들기</span><div class=\"ref-progressbar\"><i style=\"width:0%\"></i></div></div><div class=\"ref-stage\"><strong>COACH</strong><span>코칭과 회고 리듬</span><div class=\"ref-progressbar\"><i style=\"width:0%\"></i></div></div></div></div><div class=\"ref-card\"><div class=\"ref-k\">이번 주의 FOCUS</div><h4>운영 기준을 같은 화면에 맞추기</h4><p>Team Calendar · Work Map · Milestone · Priority를 연결해 실제 시간이 무엇에 쓰이고 다음 판단 지점이 어디인지 봅니다.</p></div></div><div class=\"ref-rail\"><div class=\"ref-card\"><div class=\"ref-k\">PROGRESS INSIGHT</div><h4>Day 8 · ALIGN 시작</h4><p>첫 주의 관찰을 운영 기준으로 바꾸는 구간입니다. 먼저 반복 일정과 회의 리듬을 수집하세요.</p></div><div class=\"ref-card\"><div class=\"ref-k\">LEADERSHIP TIP</div><h4>말로 정한 우선순위가 캘린더와 Owner · Done 기준에도 보이는지 확인하세요.</h4></div></div></div></div>`;\nconst sampleRefSkillHtml = () => `<div class=\"sample-board\"><div class=\"sample-board-head\"><div><h3>03 · Skill Runner — 효과적인 1:1 진행하기</h3><p>한 번에 전체 매뉴얼을 보여주지 않고 한 단계씩 실행시킵니다.</p></div></div><div class=\"ref-layout\"><div class=\"ref-main\"><div class=\"ref-stepper\"><div class=\"ref-step active\"><b>1</b>Prepare</div><div class=\"ref-step\"><b>2</b>Run</div><div class=\"ref-step\"><b>3</b>Capture</div><div class=\"ref-step\"><b>4</b>Action</div></div><div class=\"ref-card\"><div class=\"ref-k\">01</div><h4>상대방의 현재 상황을 파악하세요.</h4><p>최근 가장 집중하고 있는 일 / 어려움 / 도움이 필요한 부분 / 기대하는 성장 등을 질문합니다.</p></div></div><div class=\"ref-rail\"><div class=\"ref-card\"><div class=\"ref-k\">FOR YOUR 1:1</div><h4>김민지 · Brand Manager</h4><p>최근 3개월간 디자인 관련 작업이 5건 지연되었습니다. 디자인 승인 지연과 추가 리소스를 확인하세요.</p></div><div class=\"ref-card\"><div class=\"ref-k\">SUGGESTED QUESTION</div><h4>“디자인 승인 프로세스에서 가장 개선이 필요한 부분은 무엇인가요?”</h4></div></div></div></div>`;\nconst sampleRefDecisionHtml = () => `<div class=\"sample-board\"><div class=\"sample-board-head\"><div><h3>04 · Decision — 런칭을 1주 연기할 것인가?</h3><p>결정 질문과 대안을 분리하고, 장점·리스크·영향·근거를 같은 화면에서 봅니다.</p></div></div><div class=\"ref-layout\"><div class=\"ref-main\"><div class=\"decision-options\"><div class=\"decision-option\"><div class=\"ref-k\">A</div><h4>기존 일정 유지</h4><p>계획된 일정에 맞춰 진행합니다.</p><ul><li>시장 타이밍 유지</li><li>캠페인 일정 유지</li><li>QA 이슈 잔존 리스크</li></ul></div><div class=\"decision-option selected\"><div class=\"ref-k\">B</div><h4>1주 연기</h4><p>추가 검증 후 출시합니다.</p><ul><li>품질 안정성 확보</li><li>더 나은 고객 경험</li><li>미디어 일정 조정 필요</li></ul></div></div></div><div class=\"ref-rail\"><div class=\"ref-card\"><div class=\"ref-k\">WHY NOW?</div><h4>QA 이슈 3건</h4><p>오늘 확인되었습니다. 지연 시 캠페인·마케팅 일정 영향이 있습니다.</p></div><div class=\"ref-card\"><div class=\"ref-k\">SUGGESTED</div><h4>리스크를 고려할 때 1주 연기를 권고</h4><p>다만 일정 조정 가능성을 함께 검토합니다.</p></div></div></div></div>`;\nconst sampleCalendarHtml = () => `<div class=\"sample-board\"><div class=\"sample-board-head\"><div><h3>Brand Team · Weekly Operating Calendar</h3><p>새 팀장이 기존 캘린더를 수집한 뒤 목적별로 재분류한 예시입니다.</p></div><div class=\"sample-legend\"><span>Ritual</span><span>1:1</span><span>Milestone</span><span>Decision</span><span>Debrief</span></div></div><div class=\"sample-calendar\">\n  <div class=\"sample-day\"><strong>MON</strong><div class=\"sample-event ritual\"><b>09:30 Weekly Priority</b><span>Top 3 확정 · Output: Weekly Commitments</span></div></div>\n  <div class=\"sample-day\"><strong>TUE</strong><div class=\"sample-event oneonone\"><b>14:00 1:1 · 민지</b><span>Priority / Blocker / Support</span></div><div class=\"sample-event oneonone\"><b>15:00 1:1 · 준호</b><span>권한 범위 확인</span></div></div>\n  <div class=\"sample-day\"><strong>WED</strong><div class=\"sample-event milestone\"><b>11:00 Concept Lock</b><span>Outcome + Evidence 확인</span></div></div>\n  <div class=\"sample-day\"><strong>THU</strong><div class=\"sample-event decision\"><b>15:00 Decision Review</b><span>막힌 결정 3건 · D: Team Lead</span></div></div>\n  <div class=\"sample-day\"><strong>FRI</strong><div class=\"sample-event debrief\"><b>16:00 Team Debrief</b><span>Keep / Change / Next</span></div></div>\n</div></div>`;\nconst sampleTeamMapHtml = () => `<div class=\"sample-board\"><div class=\"sample-board-head\"><div><h3>Team Map · 직함보다 실제 역할</h3><p>사람을 평가하지 않고 책임, 의존성, 아직 모르는 부분을 구분합니다.</p></div><div class=\"sample-legend\"><span>FACT</span><span>HYPOTHESIS</span><span>UNKNOWN</span></div></div><div class=\"sample-org\"><div class=\"sample-org-leader\"><b>Team Lead · Peter</b><span>Priority / Decision / Coaching</span></div><div class=\"sample-team-nodes\"><div class=\"sample-person\"><b>민지 · Brand PM</b><p>브랜드 전략 · 고객 커뮤니케이션<br>Dependency: Creative Lead</p><span class=\"fact-tag\">FACT</span></div><div class=\"sample-person\"><b>준호 · Performance</b><p>광고 운영 · 예산 최적화<br>예산 승인 반복 요청</p><span class=\"hyp-tag\">HYPOTHESIS</span></div><div class=\"sample-person\"><b>서연 · Creative Lead</b><p>Visual / Content Direction<br>외주사 품질 기준 관리</p><span class=\"fact-tag\">FACT</span></div><div class=\"sample-person\"><b>Finance Partner</b><p>실제 승인 영향 범위가 어디까지인지 확인 필요</p><span class=\"unknown-tag\">UNKNOWN</span></div></div></div></div>`;\nconst sampleMilestoneHtml = () => `<div class=\"sample-board\"><div class=\"sample-board-head\"><div><h3>Campaign Launch · Milestone Rail</h3><p>‘중간보고 날짜’ 대신 다음 판단이 가능한 결과 지점으로 정의합니다.</p></div></div><div class=\"sample-milestones\"><div class=\"sample-milestone\"><small>M1 · DISCOVERY</small><b>Insight Lock</b><p>Evidence: Customer problem 3<br>Owner: Brand PM</p></div><div class=\"sample-milestone\"><small>M2 · CREATIVE</small><b>Concept Lock</b><p>Evidence: Message + KV + Story<br>Decision: 제작 진행?</p></div><div class=\"sample-milestone\"><small>M3 · TEST</small><b>Market Signal</b><p>Evidence: CTR/CVR test<br>Owner: Performance</p></div><div class=\"sample-milestone\"><small>M4 · LAUNCH</small><b>Go / Revise</b><p>Evidence: QA + Budget<br>Decider: Team Lead</p></div></div></div>`;\nconst sampleDecisionHtml = () => `<div class=\"sample-board\"><div class=\"sample-board-head\"><div><h3>Decision Rights · RAPID</h3><p>D는 최종 결정권자 한 명. Input이 많아도 D가 흐려지지 않게 합니다.</p></div></div><div class=\"sample-matrix-wrap\"><table class=\"sample-matrix\"><thead><tr><th>Decision</th><th>R</th><th>I</th><th>A</th><th>D</th><th>P</th></tr></thead><tbody><tr><td>캠페인 전략</td><td><span class=\"role-pill\">CD</span></td><td>Brand / Perf.</td><td>—</td><td><span class=\"role-pill d\">Lead</span></td><td>PM</td></tr><tr><td>광고비 ±10%</td><td><span class=\"role-pill\">Perf.</span></td><td>Finance</td><td>—</td><td><span class=\"role-pill d\">Perf.</span></td><td>Perf.</td></tr><tr><td>외주 3천만원</td><td><span class=\"role-pill\">PM</span></td><td>Finance</td><td>Finance</td><td><span class=\"role-pill d\">Lead</span></td><td>PM</td></tr></tbody></table></div></div>`;\nconst sampleDelegationHtml = () => `<div class=\"sample-board\"><div class=\"sample-board-head\"><div><h3>Delegation Matrix · 업무별 권한 수준</h3><p>민지는 L5 사람이 아니라 ‘SNS 콘텐츠’에서 L5입니다. 수준은 사람의 등급이 아닙니다.</p></div></div><div class=\"sample-matrix-wrap\"><table class=\"sample-matrix\"><thead><tr><th>업무</th><th>Owner</th><th>Level</th><th>Leader Check</th></tr></thead><tbody><tr><td>SNS 콘텐츠</td><td>민지</td><td><span class=\"delegate-level l5\">L5 · Own</span></td><td>결과만 공유</td></tr><tr><td>광고 예산 ±10%</td><td>준호</td><td><span class=\"delegate-level l4\">L4 · Decide+Check</span></td><td>Weekly</td></tr><tr><td>신규 외주 계약</td><td>준호</td><td><span class=\"delegate-level\">L3 · Recommend</span></td><td>계약 전</td></tr><tr><td>채용 리서치</td><td>민지</td><td><span class=\"delegate-level\">L2 · Research</span></td><td>후보 5명</td></tr></tbody></table></div></div>`;\nconst sampleDebriefHtml = () => `<div class=\"sample-board\"><div class=\"sample-board-head\"><div><h3>Project Debrief · 승인 지연 사례</h3><p>사람 탓이 아니라 운영 시스템에서 바꿀 규칙을 찾습니다.</p></div></div><div class=\"sample-debrief\"><div class=\"sample-debrief-card\"><small>EXPECTED</small><b>콘셉트 승인 1회</b></div><div class=\"sample-debrief-card\"><small>ACTUAL</small><b>승인 3회 · 4일 지연</b></div><div class=\"sample-debrief-card\"><small>WHY</small><b>Final Decider 불명확</b></div><div class=\"sample-debrief-card\"><small>KEEP</small><b>초기 고객 리서치</b></div><div class=\"sample-debrief-card\"><small>CHANGE</small><b>Concept Lock에 D 명시</b></div><div class=\"sample-debrief-card\"><small>NEXT</small><b>다음 프로젝트에 Decision Rights 적용</b></div></div></div>`;\nconst sampleManagerContractHtml = () => `<div class=\"sample-board\"><div class=\"sample-board-head\"><div><h3>Manager Contract · 첫 30일 기대 합의</h3><p>상급자와 성공 기준·보고 리듬·즉시 에스컬레이션 범위를 한 장으로 맞춥니다.</p></div></div><div class=\"r13-sample-grid\"><div class=\"r13-sample-card\"><small>SUCCESS 30D</small><b>팀 Top 3와 Decision Rights가 보이는 상태</b></div><div class=\"r13-sample-card\"><small>REPORT RHYTHM</small><b>월요일 10분 브리프 · 금요일 리스크 업데이트</b></div><div class=\"r13-sample-card\"><small>ESCALATE NOW</small><b>예산 ±15% · 외부 약속 · 일정 3일+ 변경</b></div></div></div>`;\nconst sampleTeamPatternHtml = () => `<div class=\"sample-board\"><div class=\"sample-board-head\"><div><h3>Team Pattern Board · 개인 사례 → 운영 가설</h3><p>여러 1:1에서 반복된 신호만 패턴으로 올리고, 사람 평가 대신 확인 질문을 남깁니다.</p></div></div><div class=\"sample-matrix-wrap\"><table class=\"sample-matrix\"><thead><tr><th>Pattern</th><th>Observed</th><th>Hypothesis</th><th>Verify</th></tr></thead><tbody><tr><td>승인 대기</td><td>3명</td><td>D 불명확</td><td>누가 최종 결정?</td></tr><tr><td>회의 후 재작업</td><td>2개 프로젝트</td><td>Done 기준 모호</td><td>완료 기준을 누가 정함?</td></tr></tbody></table></div></div>`;\nconst sampleStakeholderHtml = () => `<div class=\"sample-board\"><div class=\"sample-board-head\"><div><h3>Stakeholder Map · 숨은 의존성 찾기</h3><p>공식 직급이 아니라 실제 영향, 기대, 필요한 접점을 기록합니다.</p></div></div><div class=\"r13-sample-grid\"><div class=\"r13-sample-card\"><small>CEO · HIGH</small><b>속도 / 리스크 가시성</b><span>주간 브리프</span></div><div class=\"r13-sample-card\"><small>FINANCE · HIGH</small><b>예산 통제</b><span>집행 전 확인</span></div><div class=\"r13-sample-card\"><small>SALES · MEDIUM</small><b>고객 약속 정합성</b><span>격주 Sync</span></div></div></div>`;\nconst sampleWorkMapHtml = () => `<div class=\"sample-board\"><div class=\"sample-board-head\"><div><h3>Work Map · 무엇이 왜 진행 중인가?</h3><p>프로젝트 수보다 Goal / Owner / Next Milestone / Open Decision의 명확성을 봅니다.</p></div></div><div class=\"sample-matrix-wrap\"><table class=\"sample-matrix\"><thead><tr><th>Project</th><th>Goal</th><th>Owner</th><th>Next Milestone</th><th>Open Decision</th></tr></thead><tbody><tr><td>Project Alpha</td><td>10/20 Launch</td><td>민지</td><td>Concept Lock</td><td>예산 증액?</td></tr><tr><td>Brand Refresh</td><td>Q4 Guide</td><td>서연</td><td>Visual Lock</td><td>외주 범위?</td></tr></tbody></table></div></div>`;\nconst samplePriorityContractHtml = () => `<div class=\"sample-board\"><div class=\"sample-board-head\"><div><h3>Priority Contract · Top 3 + Trade-off</h3><p>중요한 일만 정하는 것이 아니라 이번 주 하지 않을 것도 합의합니다.</p></div></div><div class=\"r13-sample-grid\"><div class=\"r13-sample-card\"><small>P1</small><b>Project Alpha Concept Lock</b></div><div class=\"r13-sample-card\"><small>P2</small><b>Decision Rights 정리</b></div><div class=\"r13-sample-card\"><small>P3</small><b>핵심 팀원 1:1 완료</b></div><div class=\"r13-sample-card muted-card\"><small>NOT NOW</small><b>회의 툴 교체 · 조직 개편</b></div></div></div>`;\nconst sampleWeeklyReviewHtml = () => `<div class=\"sample-board\"><div class=\"sample-board-head\"><div><h3>Weekly Operating Review · 운영 루프 한 장 요약</h3><p>Calendar → Milestone → Decision → Delegation → Debrief에서 다음 주 리더 행동을 뽑습니다.</p></div></div><div class=\"weekly-review-grid\"><div class=\"weekly-review-cell\"><small>CALENDAR</small><b>Decision 없는 Status 회의 2개</b></div><div class=\"weekly-review-cell\"><small>MILESTONE</small><b>Concept Lock · Evidence 보완 필요</b></div><div class=\"weekly-review-cell\"><small>DECISION</small><b>광고비 ±10% · D 명확</b></div><div class=\"weekly-review-cell\"><small>DELEGATION</small><b>SNS 콘텐츠 · L5 Own</b></div><div class=\"weekly-review-cell\"><small>LEARNING</small><b>승인 지연 → D 선명화</b></div><div class=\"weekly-review-cell emphasis\"><small>NEXT</small><b>다음 주 P1: Concept Lock</b></div></div></div>`;\nconst sampleBoardRenderers = { REF_TODAY:sampleRefTodayHtml, REF_PLAN:sampleRefPlanHtml, REF_SKILL:sampleRefSkillHtml, REF_DECISION:sampleRefDecisionHtml, TEAM_MAP:sampleTeamMapHtml, TEAM_CALENDAR:sampleCalendarHtml, MILESTONES:sampleMilestoneHtml, DECISION_RIGHTS:sampleDecisionHtml, DELEGATION:sampleDelegationHtml, DEBRIEF:sampleDebriefHtml, MANAGER_CONTRACT:sampleManagerContractHtml, TEAM_PATTERN:sampleTeamPatternHtml, STAKEHOLDER_MAP:sampleStakeholderHtml, WORK_MAP:sampleWorkMapHtml, PRIORITY_CONTRACT:samplePriorityContractHtml, WEEKLY_REVIEW:sampleWeeklyReviewHtml };\nconst renderSampleBoards = () => {\n    sampleTabsRoot.innerHTML = Object.entries(LEADERSHIP_SAMPLE_BOARDS).map(([id,item])=>`<button type=\"button\" class=\"${questStore.sampleBoard===id?'active':''}\" data-sample-id=\"${id}\">${escapeHtml(item.name)}</button>`).join('');\n    const selected = LEADERSHIP_SAMPLE_BOARDS[questStore.sampleBoard] ? questStore.sampleBoard : 'TEAM_CALENDAR';\n    sampleBoardRoot.innerHTML = sampleBoardRenderers[selected]?.() ?? sampleCalendarHtml();\n    for (const button of sampleTabsRoot.querySelectorAll('[data-sample-id]')) button.addEventListener('click',()=>{ questStore.sampleBoard=button.dataset.sampleId; saveQuestStore(); renderSampleBoards(); });\n};\nconst artifactDefinitions = {\n  MANAGER_CONTRACT:{\n    label:'Manager Contract',\n    fields:[\n      ['manager','상급자 / 보고 대상','본부장','text'],\n      ['success30','30일 성공 기준','팀의 Top 3와 운영 병목이 보이는 상태','textarea'],\n      ['topPriorities','Top 3 기대 결과','1) 팀 이해  2) 우선순위 정렬  3) 결정권 명확화','textarea'],\n      ['notNow','지금 하지 않을 것','조직 개편 · 대형 프로세스 교체','textarea'],\n      ['reportRhythm','보고 리듬','월요일 10분 브리프 · 금요일 리스크 업데이트','text'],\n      ['escalation','즉시 공유할 조건','예산 ±15% / 외부 약속 / 일정 3일+ 변경','textarea']\n    ]\n  },\n  TEAM_MAP:{\n    label:'Team Map',\n    fields:[\n      ['name','이름','민지','text'],\n      ['role','실제 역할','Brand PM','text'],\n      ['responsibility','핵심 책임','브랜드 전략 · 고객 커뮤니케이션','textarea'],\n      ['dependency','주요 의존성','Creative Lead','text'],\n      ['state','현재 판단 상태','FACT','select',['FACT','HYPOTHESIS','UNKNOWN']],\n      ['observation','근거 / 확인할 질문','브랜드 전략 리뷰와 고객 커뮤니케이션을 실제로 리드함','textarea']\n    ]\n  },\n  TEAM_PATTERN:{\n    label:'Team Pattern Board',\n    fields:[\n      ['pattern','반복 패턴','승인 대기','text'],\n      ['observedAcross','어디에서 반복됐나','3명의 1:1 · 2개 프로젝트','text'],\n      ['evidence','관찰 근거','승인 요청이 같은 단계에서 반복 정체됨','textarea'],\n      ['hypothesis','운영 가설','최종 결정권자(D)가 불명확할 가능성','textarea'],\n      ['verify','확인 질문','누가 최종 결정해야 한다고 이해하고 있나요?','textarea'],\n      ['state','현재 상태','HYPOTHESIS','select',['FACT','HYPOTHESIS','UNKNOWN']]\n    ]\n  },\n  STAKEHOLDER_MAP:{\n    label:'Stakeholder Map',\n    fields:[\n      ['stakeholder','이해관계자','Finance Partner','text'],\n      ['role','역할 / 관계','Budget Partner','text'],\n      ['expectation','상대가 기대하는 것','예산 리스크를 사전에 공유','textarea'],\n      ['influence','영향도','HIGH','select',['HIGH','MEDIUM','LOW','UNKNOWN']],\n      ['cadence','접점 리듬','주간 / 집행 전','text'],\n      ['nextTouch','다음 확인','Q4 예산 승인 범위 확인','textarea']\n    ]\n  },\n  TEAM_CALENDAR:{\n    label:'Team Calendar',\n    fields:[\n      ['date','Date (optional)','2026-10-05','text'],\n      ['day','요일','MON','select',['MON','TUE','WED','THU','FRI','SAT','SUN']],\n      ['time','시간','09:30','text'],\n      ['title','일정','Weekly Priority','text'],\n      ['type','Type','Ritual','select',['Ritual','1:1','Milestone','Decision','External','Debrief']],\n      ['purpose','목적','이번 주 Top 3 확정','textarea'],\n      ['owner','Owner','Team Lead','text'],\n      ['output','Output','Weekly Commitments','text']\n    ]\n  },\n  WORK_MAP:{\n    label:'Work Map',\n    fields:[\n      ['project','Project','Project Alpha','text'],\n      ['workstream','Workstream','Launch / Brand / Growth','text'],\n      ['goal','Goal','10/20 Launch','textarea'],\n      ['owner','Owner','Brand PM','text'],\n      ['nextMilestone','Next Milestone','Concept Lock','text'],\n      ['openDecision','Open Decision','예산 증액 여부','textarea'],\n      ['risk','Known Risk','승인 지연','textarea'],\n      ['status','Status','ACTIVE','select',['ACTIVE','AT_RISK','PAUSED','UNKNOWN']]\n    ]\n  },\n  MILESTONES:{\n    label:'Milestones',\n    fields:[\n      ['project','Project','Campaign Launch','text'],\n      ['milestone','Milestone','Concept Lock','text'],\n      ['date','Target date','2026-10-15','text'],\n      ['outcome','Outcome','캠페인 방향 1개 확정','textarea'],\n      ['evidence','Evidence','Message + Key Visual + Storyline','textarea'],\n      ['owner','Owner','Creative Lead','text'],\n      ['decision','Decision at this point','제작 진행 / 추가 검증 / 방향 수정','textarea']\n    ]\n  },\n  PRIORITY_CONTRACT:{\n    label:'Priority Contract',\n    fields:[\n      ['priority1','Priority 1','Project Alpha Concept Lock','text'],\n      ['priority2','Priority 2','Decision Rights 정리','text'],\n      ['priority3','Priority 3','핵심 팀원 1:1 완료','text'],\n      ['notNow','Not now','회의 툴 교체 · 조직 개편','textarea'],\n      ['successSignal','Success signal','3개 우선순위의 Owner / Done 기준 확인','textarea'],\n      ['reviewDate','Review date','FRI 16:00','text']\n    ]\n  },\n  DECISION_RIGHTS:{\n    label:'Decision Rights',\n    fields:[\n      ['decision','Decision','캠페인 전략','text'],\n      ['requestedAt','Requested at','2026-10-03 09:00','text'],\n      ['dueDate','Decision due','2026-10-05 18:00','text'],\n      ['decidedAt','Decided at (optional)','','text'],\n      ['decisionStatus','Status','OPEN','select',['OPEN','DECIDED','ESCALATED','CANCELLED']],\n      ['escalationHistory','Escalation history','2026-10-04 · 일정 영향 공유','textarea'],\n      ['recommend','Recommend','Creative Lead','text'],\n      ['input','Input','Brand / Performance','text'],\n      ['agree','Agree','—','text'],\n      ['decide','Decide','Team Lead','text'],\n      ['perform','Perform','PM','text']\n    ]\n  },\n  DELEGATION:{\n    label:'Delegation',\n    fields:[\n      ['task','업무','광고 예산 ±10%','text'],\n      ['owner','Owner','Performance Lead','text'],\n      ['level','Level','L4 · Decide+Check','select',['L1 · Do exactly','L2 · Research','L3 · Recommend','L4 · Decide+Check','L5 · Own']],\n      ['guardrail','Guardrail','월 총예산 한도 유지','textarea'],\n      ['checkpoint','Checkpoint','매주 목요일','text']\n    ]\n  },\n  FEEDBACK_PRACTICE:{\n    label:'Feedback Practice',\n    fields:[\n      ['person','대상 / 상황','김민지 · 리뷰 미팅','text'],\n      ['situation','Situation','어제 콘셉트 리뷰에서','textarea'],\n      ['behavior','Behavior','완료 기준을 확인하지 않고 다음 단계로 진행함','textarea'],\n      ['impact','Impact','재작업이 발생하고 승인 시간이 늘어남','textarea'],\n      ['inquiry','Inquiry','그때 어떤 기준으로 완료라고 판단했나요?','textarea'],\n      ['next','Next','다음 리뷰부터 시작 전에 Done 기준을 먼저 확인','textarea']\n    ]\n  },\n  OPERATING_RHYTHM:{\n    label:'Operating Rhythm',\n    fields:[\n      ['name','Rhythm name','Team Operating Rhythm v1','text'],\n      ['weeklyPriority','Weekly Priority','MON · 이번 주 Top 3와 Not Now 합의','textarea'],\n      ['oneOnOne','1:1 Rhythm','격주 30분 · Priority / Blocker / Support / Next','textarea'],\n      ['decisionReview','Decision Review','THU · 열린 결정과 D / Deadline 확인','textarea'],\n      ['debrief','Debrief','FRI · Expected / Actual / Learn / Next','textarea'],\n      ['reporting','Reporting','MON Brief · FRI Risk / Ask 업데이트','textarea']\n    ]\n  },\n  DEBRIEF:{\n    label:'Debrief / AAR',\n    fields:[\n      ['expected','Expected','콘셉트 승인 1회','textarea'],\n      ['actual','Actual','승인 3회 · 4일 지연','textarea'],\n      ['why','Why','Final Decider 불명확','textarea'],\n      ['keep','Keep','초기 고객 리서치','textarea'],\n      ['change','Change','Concept Lock에 D 명시','textarea'],\n      ['next','Next','다음 프로젝트부터 Decision Rights 적용','textarea']\n    ]\n  },\n  ONE_ON_ONE_COMMITMENT:{\n    label:'1:1 Commitment',\n    fields:[\n      ['person','Person','김민지','text'],\n      ['commitment','Commitment','다음 1:1 전까지 승인 기준 초안 작성','textarea'],\n      ['due','Due','FRI 16:00','text'],\n      ['evidence','Evidence','완료 문서 / 확인 가능한 산출물','textarea'],\n      ['status','Status','OPEN','select',['OPEN','DONE','BLOCKED','CANCELLED']]\n    ]\n  },\n  WEEKLY_REVIEW:{\n    label:'Weekly Operating Review',\n    fields:[\n      ['week','Week','2026-W40','text'],\n      ['attention','Attention','이번 주 가장 중요한 운영 신호','textarea'],\n      ['decisions','Decisions','막힌 결정 / 결정된 내용','textarea'],\n      ['delegation','Delegation','새로 넘긴 권한 / 체크포인트','textarea'],\n      ['learning','Learning','Debrief에서 확인된 학습','textarea'],\n      ['next','Next','다음 주 가장 먼저 바꿀 것','textarea']\n    ]\n  },\n  TEAM_OS_CHARTER:{\n    label:'Team OS Charter',\n    fields:[\n      ['versionLabel','Version','v1','text'],\n      ['successDefinition','Success Definition','30일 성공 기준과 팀이 만드는 핵심 가치','textarea'],\n      ['operatingRhythm','Operating Rhythm','Weekly Priority / 1:1 / Decision / Debrief','textarea'],\n      ['decisionRule','Decision Rule','D는 하나 · Input은 필요한 사람만','textarea'],\n      ['delegationRule','Delegation Rule','Outcome / Guardrail / Authority / Checkpoint','textarea'],\n      ['reviewRule','Review Rule','금요일 Weekly Review에서 Keep / Change / Next','textarea'],\n      ['escalationRule','Escalation','예산·외부 약속·핵심 일정 변경은 즉시 공유','textarea']\n    ]\n  },\n  NEXT_60_PLAN:{\n    label:'Next 60-Day Plan',\n    fields:[\n      ['period','Period','Day 31–90','text'],\n      ['outcome1','Outcome 1','핵심 프로젝트의 검증 가능한 결과','textarea'],\n      ['outcome2','Outcome 2','팀이 스스로 결정할 수 있는 영역 확대','textarea'],\n      ['outcome3','Outcome 3','운영 리듬의 반복 가능성 확인','textarea'],\n      ['systemUpgrade','System Upgrade','Decision → Delegation → Review 연결 강화','textarea'],\n      ['leaderExperiment','Leader Experiment','답을 주기 전에 질문 1회 더 하기','textarea'],\n      ['reviewRhythm','Review Rhythm','매주 금요일 + Day 60 / Day 90 리뷰','text']\n    ]\n  },\n  NEXT_60_CHECKIN:{\n    label:'Next 60 Weekly Check-in',\n    fields:[\n      ['week','Week','2026-W41','text'],\n      ['outcomeKey','Outcome','outcome1','select',['outcome1','outcome2','outcome3']],\n      ['status','Status','ON_TRACK','select',['ON_TRACK','AT_RISK','BLOCKED','DONE']],\n      ['evidence','Evidence','승인된 산출물 / 수치 / 관찰 근거','textarea'],\n      ['learning','Learning','이번 주 학습','textarea'],\n      ['next','Next','다음 행동','textarea']\n    ]\n  },\n  REPORT_BRIEF:{\n    label:'Manager Reporting Brief',\n    fields:[\n      ['week','Week','2026-W41','text'],\n      ['executiveSummary','Executive Summary','이번 주 핵심 상태','textarea'],\n      ['progress','Progress','진행 상황','textarea'],\n      ['decisionsNeeded','Decisions Needed','결정 필요 사항','textarea'],\n      ['risks','Risks / Escalation','리스크 및 즉시 공유 조건','textarea'],\n      ['next','Next','다음 행동','textarea'],\n      ['next60Trend','Next 60 Trend','Outcome 1 ON_TRACK · Outcome 2 AT_RISK · Outcome 3 CHECK','textarea']\n    ]\n  }\n};\nconst sampleArtifactRecordsForRole = () => {\n    const pack = ROLE_PACKS[questStore.rolePack] || ROLE_PACKS.TEAM_MANAGER;\n    return {\n      MANAGER_CONTRACT:{manager:'상급자',success30:`${pack.focus}가 보이고 팀 운영의 Top 3가 합의된 상태`,topPriorities:'1) 팀/업무 이해  2) 우선순위 정렬  3) 결정권 명확화',notNow:'대규모 조직 개편 · 도구 전면 교체',reportRhythm:'MON 10분 브리프 · FRI 리스크 업데이트',escalation:'예산/외부 약속/핵심 일정 변경'},\n      TEAM_MAP:{name:pack.starter.person,role:pack.starter.role,responsibility:questStore.rolePack==='CREATIVE_DIRECTOR'?'비주얼 기준 · 외주 품질 · 콘셉트 리뷰':questStore.rolePack==='PRODUCT_LEAD'?'제품 우선순위 · Discovery · 이해관계자 정렬':questStore.rolePack==='MARKETING_LEADER'?'채널 성과 · 예산 최적화 · 실험 설계':'핵심 업무 운영 · 협업 조율',dependency:'Cross-functional Partner',state:'FACT',observation:'실제 책임과 의존 관계를 1:1 / 프로젝트에서 확인'},\n      TEAM_PATTERN:{pattern:'승인 대기',observedAcross:'3명의 1:1 · 2개 프로젝트',evidence:'같은 승인 단계에서 반복 정체',hypothesis:'최종 결정권자(D)가 불명확할 가능성',verify:'누가 최종 결정해야 한다고 이해하고 있나요?',state:'HYPOTHESIS'},\n      STAKEHOLDER_MAP:{stakeholder:'Finance Partner',role:'Budget Partner',expectation:'예산 리스크 사전 공유',influence:'HIGH',cadence:'집행 전 + 주간',nextTouch:'Q4 예산 승인 범위 확인'},\n      TEAM_CALENDAR:{date:'2026-10-05',day:'MON',time:'09:30',title:'Weekly Priority',type:'Ritual',purpose:`${pack.focus} 기준으로 이번 주 Top 3 확정`,owner:pack.name,output:'Weekly Commitments'},\n      WORK_MAP:{project:'Priority Project',workstream:'Launch',goal:`${pack.focus}를 만드는 핵심 결과`,owner:pack.starter.role,nextMilestone:pack.starter.milestone,openDecision:pack.starter.decision,risk:'의존성 / 승인 병목 확인',status:'ACTIVE'},\n      MILESTONES:{project:'Priority Project',milestone:pack.starter.milestone,date:'2026-10-15',outcome:'다음 실행 단계로 이동 가능한 결과 확정',evidence:'Review 가능한 결과물 + 확인 근거',owner:pack.starter.role,decision:'Go / Revise / Validate'},\n      PRIORITY_CONTRACT:{priority1:pack.starter.milestone,priority2:pack.starter.decision,priority3:`${pack.starter.person} 1:1 완료`,notNow:'대형 프로세스 변경 · 도구 교체',successSignal:'Top 3 Owner / Done 기준 확인',reviewDate:'FRI 16:00'},\n      DECISION_RIGHTS:{decision:pack.starter.decision,requestedAt:'2026-10-03 09:00',dueDate:'2026-10-05 18:00',decidedAt:'',decisionStatus:'OPEN',escalationHistory:'',recommend:pack.starter.role,input:'Relevant Partners',agree:'—',decide:pack.name,perform:pack.starter.role},\n      DELEGATION:{task:pack.starter.delegation,owner:pack.starter.role,level:'L4 · Decide+Check',guardrail:'브랜드/예산/품질 가드레일 준수',checkpoint:'Weekly Review'},\n      FEEDBACK_PRACTICE:{person:pack.starter.person,situation:'최근 결과물 리뷰에서',behavior:'완료 기준 확인 없이 다음 단계로 진행',impact:'재작업과 승인 지연이 발생',inquiry:'그때 어떤 기준으로 완료라고 판단했나요?',next:'다음 리뷰부터 시작 전에 Done 기준 합의'},\n      OPERATING_RHYTHM:{name:'Team Operating Rhythm v1',weeklyPriority:'MON · Top 3 / Not Now',oneOnOne:'격주 · Priority / Blocker / Support / Next',decisionReview:'THU · Open Decision / D / Deadline',debrief:'FRI · Expected / Actual / Learn / Next',reporting:'MON Brief · FRI Risk / Ask'},\n      DEBRIEF:{expected:'한 번의 명확한 기준으로 진행',actual:'추가 확인과 재작업 발생',why:'결정권 또는 완료 기준이 모호했음',keep:'초기 맥락 공유',change:'Decision / Done 기준 명시',next:'다음 사이클부터 운영 Artifact 적용'},\n      ONE_ON_ONE_COMMITMENT:{person:pack.starter.person,commitment:`${pack.starter.person}가 다음 1:1 전까지 ${pack.starter.delegation}의 완료 기준을 초안으로 정리`,due:'FRI 16:00',evidence:'초안 문서 + 다음 1:1 확인',status:'OPEN'},\n      WEEKLY_REVIEW:{week:'2026-W40',attention:`${pack.focus}의 운영 병목 확인`,decisions:pack.starter.decision,delegation:pack.starter.delegation,learning:'완료 기준과 Decision Rights를 더 먼저 명시',next:pack.starter.milestone},\n      TEAM_OS_CHARTER:{versionLabel:'v1',successDefinition:`${pack.focus}가 팀의 일상적 판단 기준으로 작동하는 상태`,operatingRhythm:'MON Priority · TUE/WED 1:1 · THU Decision · FRI Debrief',decisionRule:'중요 결정은 RAPID로 D를 하나 명시',delegationRule:'Outcome / Guardrail / Authority / Checkpoint를 함께 합의',reviewRule:'Weekly Operating Review에서 Keep / Change / Next',escalationRule:'예산·외부 약속·핵심 일정 변경은 즉시 공유'},\n      NEXT_60_PLAN:{period:'Day 31–90',outcome1:pack.starter.milestone,outcome2:`${pack.starter.role}의 독립 결정 범위 확대`,outcome3:`${pack.focus} 운영 리듬을 4주 반복`,systemUpgrade:'Work → Milestone → Decision → Delegation 링크 완성',leaderExperiment:'답을 주기 전에 질문 한 번 더 하기',reviewRhythm:'매주 FRI + Day 60 / Day 90'},\n      NEXT_60_CHECKIN:{week:'2026-W41',outcomeKey:'outcome1',status:'ON_TRACK',evidence:'이번 주 검증 가능한 산출물 1개 완료',learning:'권한 범위를 먼저 합의할수록 재확인이 줄어듦',next:'다음 주 Outcome 1의 남은 의존성 제거'},\n      REPORT_BRIEF:{week:'2026-W41',executiveSummary:`${pack.focus} 기준으로 운영 구조를 정렬 중`,progress:pack.starter.milestone,decisionsNeeded:pack.starter.decision,risks:'승인/의존성 병목 확인',next:'다음 Weekly Review에서 변화 확인'}\n    };\n};\nlet editingArtifactId = null;\n\nconst RELATION_PAIRS = Object.freeze([\n    { aType:'WORK_MAP', aField:'milestoneRefs', bType:'MILESTONES', bField:'workRefs' },\n    { aType:'WORK_MAP', aField:'decisionRefs', bType:'DECISION_RIGHTS', bField:'workRefs' },\n    { aType:'WORK_MAP', aField:'delegationRefs', bType:'DELEGATION', bField:'workRefs' },\n    { aType:'WORK_MAP', aField:'debriefRefs', bType:'DEBRIEF', bField:'workRefs' },\n    { aType:'WORK_MAP', aField:'calendarRefs', bType:'TEAM_CALENDAR', bField:'workRefs' },\n    { aType:'MILESTONES', aField:'decisionRefs', bType:'DECISION_RIGHTS', bField:'milestoneRefs' },\n    { aType:'MILESTONES', aField:'calendarRefs', bType:'TEAM_CALENDAR', bField:'milestoneRefs' },\n    { aType:'ONE_ON_ONE_COMMITMENT', aField:'delegationRefs', bType:'DELEGATION', bField:'commitmentRefs' },\n    { aType:'ONE_ON_ONE_COMMITMENT', aField:'debriefRefs', bType:'DEBRIEF', bField:'commitmentRefs' }\n]);\nconst refsEqual=(a,b)=>{const aa=refArray(a).sort();const bb=refArray(b).sort();return aa.length===bb.length&&aa.every((v,i)=>v===bb[i]);};\nconst patchLinkedRecord = (type,id,patch) => {\n    if (!id) return false;\n    const rows=artifactRows(type); const index=rows.findIndex((row)=>row.id===id); if(index<0) return false;\n    const previous=rows[index];\n    const changed=Object.entries(patch).some(([key,value])=>Array.isArray(value)||Array.isArray(previous?.[key])?!refsEqual(previous?.[key],value):String(previous?.[key]||'')!==String(value||''));\n    if(!changed) return false;\n    const history=Array.isArray(previous.history)?[...previous.history]:[];\n    history.push({version:Number(previous.version)||1,updatedAt:previous.updatedAt||new Date().toISOString(),data:artifactDataSnapshot(previous),artifactState:previous.artifactState||'DRAFT'});\n    rows[index]={...previous,...patch,version:(Number(previous.version)||1)+1,artifactState:'DRAFT',history,updatedAt:new Date().toISOString()};\n    artifactStore[type]=rows; return true;\n};\nconst relationConfigFor = (type) => RELATION_PAIRS.flatMap((pair)=>{\n    if(pair.aType===type) return [{sourceField:pair.aField,targetType:pair.bType,targetField:pair.bField}];\n    if(pair.bType===type) return [{sourceField:pair.bField,targetType:pair.aType,targetField:pair.aField}];\n    return [];\n});\nconst syncArtifactRelations = (type,current,previous={}) => {\n    if(!current?.id) return;\n    for(const relation of relationConfigFor(type)){\n        const before=refArray(previous?.[relation.sourceField]);\n        const after=refArray(current?.[relation.sourceField]);\n        for(const removed of before.filter((id)=>!after.includes(id))){\n            const target=artifactRows(relation.targetType).find((row)=>row.id===removed);\n            if(target){const reciprocal=refArray(target[relation.targetField]).filter((id)=>id!==current.id);patchLinkedRecord(relation.targetType,removed,{[relation.targetField]:reciprocal});}\n        }\n        for(const added of after){\n            const target=artifactRows(relation.targetType).find((row)=>row.id===added);\n            if(target){const reciprocal=refArray(target[relation.targetField]);if(!reciprocal.includes(current.id))patchLinkedRecord(relation.targetType,added,{[relation.targetField]:[...reciprocal,current.id]});}\n        }\n    }\n};\nconst detachArtifactRelations = (artifactId) => {\n    for(const [type,rows] of Object.entries(artifactStore)){\n        if(!Array.isArray(rows)) continue;\n        for(const row of [...rows]){\n            if(row.id===artifactId) continue;\n            const patch={};\n            for(const relation of relationConfigFor(type)){\n                const refs=refArray(row[relation.sourceField]);\n                if(refs.includes(artifactId)) patch[relation.sourceField]=refs.filter((id)=>id!==artifactId);\n            }\n            if(Object.keys(patch).length) patchLinkedRecord(type,row.id,patch);\n        }\n    }\n};\n\nconst artifactDataSnapshot = (row) => Object.fromEntries(Object.entries(row || {}).filter(([key]) => !['id','updatedAt','version','history','artifactState','serverVersion','serverSyncedAt','serverSyncError'].includes(key)));\nconst updateArtifactRecord = (type, id, record) => {\n    const rows = artifactRows(type);\n    const index = rows.findIndex((item) => item.id === id);\n    if (index < 0) return false;\n    const previous = rows[index];\n    const history = Array.isArray(previous.history) ? [...previous.history] : [];\n    history.push({ version:Number(previous.version)||1, updatedAt:previous.updatedAt||new Date().toISOString(), data:artifactDataSnapshot(previous), artifactState:previous.artifactState||'DRAFT' });\n    rows[index] = { ...previous, ...record, version:(Number(previous.version)||1)+1, artifactState:'DRAFT', history, updatedAt:new Date().toISOString() };\n    artifactStore[type] = rows;\n    syncArtifactRelations(type, rows[index], previous);\n    saveArtifactStore();\n    queueOperatingArtifactSync(type,id);\n    return true;\n};\nconst setArtifactState = (type, id, nextState) => {\n    const rows=artifactRows(type);\n    const index=rows.findIndex((item)=>item.id===id);\n    if(index<0) return false;\n    const previous=rows[index];\n    const history=Array.isArray(previous.history)?[...previous.history]:[];\n    history.push({version:Number(previous.version)||1,updatedAt:previous.updatedAt||new Date().toISOString(),data:artifactDataSnapshot(previous),artifactState:previous.artifactState||'DRAFT'});\n    rows[index]={...previous,version:(Number(previous.version)||1)+1,artifactState:nextState,history,updatedAt:new Date().toISOString()};\n    artifactStore[type]=rows; saveArtifactStore(); queueOperatingArtifactSync(type,id); return true;\n};\nconst confirmedArtifactRows = (type) => artifactRows(type).filter((row)=>String(row.artifactState||'DRAFT').toUpperCase()==='CONFIRMED');\n\nconst addArtifactRecord = (type, record) => {\n    const id = `${type}-${Date.now()}-${Math.random().toString(36).slice(2,7)}`;\n    artifactStore[type].push({ id, ...record, version:1, artifactState:'DRAFT', history:[], updatedAt:new Date().toISOString() });\n    syncArtifactRelations(type, artifactStore[type][artifactStore[type].length-1], {});\n    saveArtifactStore();\n    queueOperatingArtifactSync(type,id);\n    const expectedType = QUEST_ARTIFACT_TYPE[Number(questStore.selectedDay)];\n    if (expectedType === type) linkArtifactToQuest(Number(questStore.selectedDay), id);\n    renderArtifactWorkspace();\n    renderSetupChecklist();\n    renderQuestList();\n    renderTodayLeaderNudge();\n    if(typeof renderRecovery17Surfaces==='function') renderRecovery17Surfaces();\n    return id;\n};\nconst parseCalendarImport = (raw) => {\n    return String(raw||'').split(/\\r?\\n/).map((line)=>line.trim()).filter(Boolean).flatMap((line)=>{\n        const cells=line.split('|').map((cell)=>cell.trim());\n        if (cells.length < 3) return [];\n        const hasDate=/^\\d{4}-\\d{2}-\\d{2}$/.test(cells[0]||''); const offset=hasDate?1:0; const date=hasDate?cells[0]:''; const [day,time,title,type='Ritual',purpose='',owner='',output='',projectHint='',milestoneHint=''] = cells.slice(offset);\n        const workMatch=projectHint?artifactRows('WORK_MAP').find((r)=>String(r.project||'').toLowerCase()===String(projectHint).toLowerCase()):null;\n        const milestoneMatch=milestoneHint?artifactRows('MILESTONES').find((r)=>String(r.milestone||'').toLowerCase()===String(milestoneHint).toLowerCase()):null;\n        return [{ date,day,time,title,type,purpose,owner,output,workRefs:workMatch?[workMatch.id]:[],milestoneRefs:milestoneMatch?[milestoneMatch.id]:[] }];\n    });\n};\nconst hasMultipleDeciders = (value) => {\n    const text=String(value||'').trim();\n    if (!text) return false;\n    return /\\s(?:\\/|&|\\+)\\s|,|·/.test(text);\n};\nconst artifactDiagnostics = () => {\n    const out=[];\n    const manager=artifactRows('MANAGER_CONTRACT');\n    if (manager.length && manager.some((r)=>!String(r.success30||'').trim() || !String(r.reportRhythm||'').trim())) out.push({level:'warn',icon:'↑',title:'Manager Contract의 성공 기준/보고 리듬이 비어 있습니다.',copy:'상급자와 첫 30일 성공의 정의와 보고 주기를 먼저 합의하세요.',meta:'Manager Contract'});\n    const patterns=artifactRows('TEAM_PATTERN');\n    if (patterns.some((r)=>String(r.state||'').toUpperCase()==='HYPOTHESIS' && !String(r.verify||'').trim())) out.push({level:'warn',icon:'?',title:'검증 질문 없는 Team Pattern 가설이 있습니다.',copy:'패턴은 사람 평가가 아니라 다음에 확인할 질문으로 남겨야 합니다.',meta:'Team Pattern'});\n    const work=artifactRows('WORK_MAP');\n    const looseWork=work.filter((r)=>!String(r.goal||'').trim() || !String(r.owner||'').trim() || !String(r.nextMilestone||'').trim());\n    if (looseWork.length) out.push({level:'critical',icon:'W',title:`Goal/Owner/Milestone이 불완전한 Work ${looseWork.length}개`,copy:'진행 중인 일은 왜 하는지, 누가 책임지는지, 다음 판단 지점이 무엇인지 보여야 합니다.',meta:'Work Map'});\n    const priorities=artifactRows('PRIORITY_CONTRACT');\n    if (priorities.length && priorities.some((r)=>![r.priority1,r.priority2,r.priority3].every((v)=>String(v||'').trim()))) out.push({level:'warn',icon:'3',title:'Top 3 Priority가 아직 완성되지 않았습니다.',copy:'중요한 일과 함께 이번 주 하지 않을 일도 명시하세요.',meta:'Priority'});\n    const team=artifactRows('TEAM_MAP');\n    const unknown=team.filter((r)=>String(r.state||'').toUpperCase()==='UNKNOWN');\n    if (!team.length) out.push({level:'warn',icon:'?',title:'Team Map이 아직 없습니다.',copy:'사람을 평가하기 전에 실제 역할·책임·의존성을 먼저 기록하세요.',meta:'Day 3'});\n    else if (unknown.length) out.push({level:'warn',icon:'?',title:`확인이 필요한 UNKNOWN ${unknown.length}개`,copy:'UNKNOWN은 결함이 아닙니다. 다음 1:1에서 사실 확인 질문으로 바꾸세요.',meta:'Team Map'});\n    else out.push({level:'good',icon:'✓',title:'Team Map 기본 맥락이 잡혔습니다.',copy:`${team.length}개의 역할/의존성 기록이 있습니다.`,meta:'Team Map'});\n\n    const miles=artifactRows('MILESTONES');\n    const badMiles=miles.filter((r)=>!String(r.owner||'').trim() || !String(r.evidence||'').trim() || !String(r.decision||'').trim());\n    if (miles.length && badMiles.length) out.push({level:'critical',icon:'!',title:`불완전한 Milestone ${badMiles.length}개`,copy:'Owner · Evidence · Decision이 모두 있어야 다음 판단 지점으로 기능합니다.',meta:'Milestones'});\n    else if (miles.length) out.push({level:'good',icon:'✓',title:'Milestone 완료 기준이 명확합니다.',copy:`${miles.length}개 마일스톤에 Outcome/Evidence/Owner/Decision이 연결되어 있습니다.`,meta:'Milestones'});\n\n    const decisions=artifactRows('DECISION_RIGHTS');\n    const noD=decisions.filter((r)=>!String(r.decide||'').trim());\n    const multiD=decisions.filter((r)=>hasMultipleDeciders(r.decide));\n    if (noD.length) out.push({level:'critical',icon:'D',title:`Decide(D) 없는 결정 ${noD.length}개`,copy:'최종 결정권자가 없으면 Input이 승인처럼 작동하며 병목이 생길 수 있습니다.',meta:'RAPID'});\n    if (multiD.length) out.push({level:'critical',icon:'D',title:`D가 여러 명으로 보이는 결정 ${multiD.length}개`,copy:'RAPID의 D는 원칙적으로 하나의 최종 결정 역할로 명확히 두세요.',meta:'RAPID'});\n    if (decisions.length && !noD.length && !multiD.length) out.push({level:'good',icon:'✓',title:'Decision Rights의 D가 명확합니다.',copy:`${decisions.length}개 결정의 최종 결정권자가 지정되어 있습니다.`,meta:'RAPID'});\n\n    const delegations=artifactRows('DELEGATION');\n    const loose=delegations.filter((r)=>!String(r.guardrail||'').trim() || !String(r.checkpoint||'').trim());\n    if (delegations.length && loose.length) out.push({level:'warn',icon:'↗',title:`가드레일/체크포인트가 빠진 위임 ${loose.length}개`,copy:'위임은 “알아서 해주세요”가 아니라 권한 범위와 다시 볼 시점을 함께 합의합니다.',meta:'Delegation'});\n\n    if (!out.length) out.push({level:'warn',icon:'→',title:'첫 Operating Artifact를 만들어보세요.',copy:'Example을 불러온 뒤 내 팀 상황에 맞게 수정하면 됩니다.',meta:'Start'});\n    return out;\n};\nconst fieldControlHtml = ([key,label,placeholder,kind='text',options=[]], index) => {\n    const cls = index >= 4 || kind === 'textarea' ? 'field full' : 'field';\n    if (kind === 'select') return `<div class=\"${cls}\"><label>${escapeHtml(label)}</label><select data-artifact-field=\"${key}\">${options.map((option)=>`<option value=\"${escapeHtml(option)}\">${escapeHtml(option)}</option>`).join('')}</select></div>`;\n    if (kind === 'textarea') return `<div class=\"${cls}\"><label>${escapeHtml(label)}</label><textarea data-artifact-field=\"${key}\" placeholder=\"${escapeHtml(placeholder)}\"></textarea></div>`;\n    return `<div class=\"${cls}\"><label>${escapeHtml(label)}</label><input data-artifact-field=\"${key}\" placeholder=\"${escapeHtml(placeholder)}\" /></div>`;\n};\nconst artifactHistoryHtml = (row) => {\n    const history = Array.isArray(row?.history) ? row.history : [];\n    if (!history.length) return '';\n    return `<details class=\"artifact-history\"><summary>Version history · ${history.length}</summary>${history.slice().reverse().map((item)=>{\n        const detail=Object.entries(item.data||{}).slice(0,6).map(([k,v])=>`${k}: ${v}`).join(' · ');\n        return `<div class=\"artifact-history-item\"><b>v${escapeHtml(item.version)}</b><span>${escapeHtml(detail)}</span><small>${escapeHtml(item.updatedAt||'')}</small></div>`;\n    }).join('')}</details>`;\n};\nconst artifactActionsHtml = (row) => { const confirmed=String(row.artifactState||'DRAFT').toUpperCase()==='CONFIRMED'; const db=row.serverVersion?` · DB v${row.serverVersion}`:' · LOCAL'; return `<div class=\"artifact-row-actions\"><span class=\"artifact-version ${confirmed?'confirmed':''}\">v${escapeHtml(row.version||1)} · ${escapeHtml(row.artifactState||'DRAFT')}${escapeHtml(db)}</span><button type=\"button\" class=\"${confirmed?'':'primary'}\" data-artifact-state=\"${escapeHtml(row.id)}\" data-next-state=\"${confirmed?'DRAFT':'CONFIRMED'}\">${confirmed?'다시 검토':'Human Confirm'}</button><button type=\"button\" data-artifact-edit=\"${escapeHtml(row.id)}\">수정</button><button type=\"button\" data-artifact-delete=\"${escapeHtml(row.id)}\">삭제</button></div>`; };\nconst artifactRowHtml = (active, def, row) => {\n    if (active === 'TEAM_MAP') {\n        const state=String(row.state||'UNKNOWN').toLowerCase();\n        return `<div class=\"artifact-row\"><div><b>${escapeHtml(row.name||'팀원')} · ${escapeHtml(row.role||'역할 미정')}</b><p>${escapeHtml(row.responsibility||'책임 미입력')} · Dependency: ${escapeHtml(row.dependency||'—')}</p><span class=\"team-state ${escapeHtml(state)}\">${escapeHtml(String(row.state||'UNKNOWN').toUpperCase())}</span><div class=\"artifact-record-meta\"><span>${escapeHtml(row.observation||'근거/질문 미입력')}</span></div>${artifactHistoryHtml(row)}</div>${artifactActionsHtml(row)}</div>`;\n    }\n    if (active === 'MILESTONES') {\n        return `<div class=\"artifact-row\"><div><b>${escapeHtml(row.project||'Project')} · ${escapeHtml(row.milestone||'Milestone')}</b><div class=\"milestone-mini\"><span>${escapeHtml(row.date||'날짜 미정')} · Owner ${escapeHtml(row.owner||'미정')}</span><b>${escapeHtml(row.outcome||'Outcome 미입력')}</b><span>Evidence: ${escapeHtml(row.evidence||'—')}</span><span>Decision: ${escapeHtml(row.decision||'—')}</span></div>${relationSummaryHtml(row)}${artifactHistoryHtml(row)}</div>${artifactActionsHtml(row)}</div>`;\n    }\n    const entries=Object.entries(row).filter(([k])=>!['id','updatedAt','version','history','artifactState','supportVersions','serverVersion','serverSyncedAt','serverSyncError'].includes(k) && !/(Ref|Refs)$/.test(k));\n    const primary=entries[0];\n    const detail=entries.slice(1).map(([k,v])=>`${k}: ${v}`).join(' · ');\n    return `<div class=\"artifact-row\"><div><b>${escapeHtml(primary?.[1]||def.label)}</b><p>${escapeHtml(detail)}</p>${relationSummaryHtml(row)}<div class=\"artifact-record-meta\"><span>ID ${escapeHtml(row.id)}</span></div>${artifactHistoryHtml(row)}</div>${artifactActionsHtml(row)}</div>`;\n};\nconst renderDiagnostics = () => {\n    artifactDiagnosticsRoot.innerHTML = artifactDiagnostics().map((d)=>`<div class=\"diag-card ${escapeHtml(d.level)}\"><span class=\"diag-icon\">${escapeHtml(d.icon)}</span><div><strong>${escapeHtml(d.title)}</strong><p>${escapeHtml(d.copy)}</p></div><small>${escapeHtml(d.meta)}</small></div>`).join('');\n};\nconst relationOptionHtml = (type, selected=[]) => {\n    const selectedRefs=refArray(selected);\n    return artifactRows(type).map((row)=>`<option value=\"${escapeHtml(row.id)}\" ${selectedRefs.includes(String(row.id))?'selected':''}>${escapeHtml(artifactPrimary(type,row))}</option>`).join('');\n};\nconst multiRelationControl=(label,field,type,selected=[])=>`<div class=\"field\"><label>${escapeHtml(label)}</label><select multiple size=\"4\" data-artifact-relation=\"${escapeHtml(field)}\">${relationOptionHtml(type,selected)}</select><span class=\"relation-help\">⌘/Ctrl 또는 Shift로 여러 항목을 선택할 수 있습니다.</span></div>`;\nconst relationControlsHtml = (active, row={}) => {\n    if (active==='WORK_MAP') return `<div class=\"artifact-relations\"><span class=\"section-kicker\">CROSS-LINKS · 1:N</span><div class=\"artifact-fields\">${multiRelationControl('Linked Milestones','milestoneRefs','MILESTONES',row.milestoneRefs)}${multiRelationControl('Linked Decisions','decisionRefs','DECISION_RIGHTS',row.decisionRefs)}${multiRelationControl('Linked Delegations','delegationRefs','DELEGATION',row.delegationRefs)}${multiRelationControl('Linked Debriefs','debriefRefs','DEBRIEF',row.debriefRefs)}${multiRelationControl('Linked Calendar Events','calendarRefs','TEAM_CALENDAR',row.calendarRefs)}</div></div>`;\n    if (active==='MILESTONES') return `<div class=\"artifact-relations\"><span class=\"section-kicker\">CROSS-LINKS</span><div class=\"artifact-fields\">${multiRelationControl('Linked Work','workRefs','WORK_MAP',row.workRefs)}${multiRelationControl('Linked Decisions','decisionRefs','DECISION_RIGHTS',row.decisionRefs)}${multiRelationControl('Linked Calendar Events','calendarRefs','TEAM_CALENDAR',row.calendarRefs)}</div></div>`;\n    if (active==='DECISION_RIGHTS') return `<div class=\"artifact-relations\"><span class=\"section-kicker\">CROSS-LINKS</span><div class=\"artifact-fields\">${multiRelationControl('Linked Work','workRefs','WORK_MAP',row.workRefs)}${multiRelationControl('Linked Milestones','milestoneRefs','MILESTONES',row.milestoneRefs)}</div></div>`;\n    if (active==='DELEGATION') return `<div class=\"artifact-relations\"><span class=\"section-kicker\">CROSS-LINKS</span><div class=\"artifact-fields\">${multiRelationControl('Linked Work','workRefs','WORK_MAP',row.workRefs)}${multiRelationControl('1:1 Commitments','commitmentRefs','ONE_ON_ONE_COMMITMENT',row.commitmentRefs)}</div></div>`;\n    if (active==='DEBRIEF') return `<div class=\"artifact-relations\"><span class=\"section-kicker\">CROSS-LINKS</span><div class=\"artifact-fields\">${multiRelationControl('Linked Work','workRefs','WORK_MAP',row.workRefs)}${multiRelationControl('1:1 Commitments as Evidence','commitmentRefs','ONE_ON_ONE_COMMITMENT',row.commitmentRefs)}</div></div>`;\n    if (active==='TEAM_CALENDAR') return `<div class=\"artifact-relations\"><span class=\"section-kicker\">OPERATING LINKS</span><div class=\"artifact-fields\">${multiRelationControl('Linked Work','workRefs','WORK_MAP',row.workRefs)}${multiRelationControl('Linked Milestones','milestoneRefs','MILESTONES',row.milestoneRefs)}</div></div>`;\n    if (active==='ONE_ON_ONE_COMMITMENT') return `<div class=\"artifact-relations\"><span class=\"section-kicker\">FOLLOW-UP LINKS</span><div class=\"artifact-fields\">${multiRelationControl('Delegation','delegationRefs','DELEGATION',row.delegationRefs)}${multiRelationControl('Debrief Evidence','debriefRefs','DEBRIEF',row.debriefRefs)}</div></div>`;\n    return '';\n};\nconst relationSummaryHtml = (row) => {\n    const configs=[['WORK_MAP','workRefs'],['MILESTONES','milestoneRefs'],['DECISION_RIGHTS','decisionRefs'],['DELEGATION','delegationRefs'],['DEBRIEF','debriefRefs'],['TEAM_CALENDAR','calendarRefs'],['ONE_ON_ONE_COMMITMENT','commitmentRefs'],['NEXT_60_PLAN','planRef']];\n    const chips=[];\n    for(const [type,field] of configs){\n      const refs=field==='planRef'?refArray(row[field]):refArray(row[field]);\n      for(const id of refs){const item=artifactRecordById(id);chips.push(`<span>${escapeHtml(type.replaceAll('_',' '))}: ${escapeHtml(item?artifactPrimary(type,item):'Missing link')}</span>`);}\n    }\n    return chips.length?`<div class=\"relation-chip-set\">${chips.join('')}</div>`:'';\n};\n\nconst renderArtifactWorkspace = () => {\n    const active = artifactDefinitions[questStore.artifactTab] ? questStore.artifactTab : 'TEAM_MAP';\n    questStore.artifactTab = active;\n    const def = artifactDefinitions[active];\n    const editRow = editingArtifactId ? artifactRows(active).find((row)=>row.id===editingArtifactId) : null;\n    if (editingArtifactId && !editRow) editingArtifactId = null;\n    artifactTabsRoot.innerHTML = Object.entries(artifactDefinitions).map(([id,item])=>`<button type=\"button\" class=\"${active===id?'active':''}\" data-artifact-tab=\"${id}\">${escapeHtml(item.label)} <span class=\"artifact-count\">${artifactRows(id).length}</span></button>`).join('');\n    const calendarImport = active === 'TEAM_CALENDAR' ? `<details class=\"calendar-import\"><summary>Calendar Import Adapter · 일정 텍스트 가져오기</summary><textarea data-calendar-import placeholder=\"2026-10-05 | MON | 09:30 | Weekly Priority | Ritual | 이번 주 Top 3 확정 | Team Lead | Weekly Commitments | Priority Project | Concept Lock&#10;FRI | 16:00 | Team Debrief | Debrief | Keep / Change / Next | Team | Next rule\"></textarea><div class=\"artifact-actions\"><button type=\"button\" data-calendar-import-run>일정 가져오기</button></div><div class=\"calendar-import-help\">현재 Preview는 붙여넣기 어댑터입니다. Google Calendar / Outlook 연결은 Production connector가 연결될 때 이 동일 schema로 매핑합니다.</div></details>` : '';\n    artifactEditorRoot.innerHTML = `<div class=\"artifact-editor-head\"><div><span class=\"section-kicker\">${editRow?'EDIT + VERSION':'NEW ARTIFACT'}</span><h3>${escapeHtml(def.label)} ${editRow?'수정':'작성'}</h3></div>${editRow?`<span class=\"artifact-version\">editing v${escapeHtml(editRow.version||1)}</span>`:''}</div><div class=\"artifact-fields\">${def.fields.map(fieldControlHtml).join('')}</div>${relationControlsHtml(active,editRow||{})}<div class=\"artifact-actions\"><button type=\"button\" class=\"primary\" data-artifact-save>${editRow?'변경 저장':'내 팀에 추가'}</button><button type=\"button\" data-artifact-sample>Role Pack 예시 채우기</button>${editRow?'<button type=\"button\" data-artifact-cancel>수정 취소</button>':''}</div>${calendarImport}<div class=\"review-meta\" style=\"margin-top:8px\">확정 Fact가 아니라 리더가 작성한 운영 Artifact입니다. 변경 저장 시 이전 버전은 History에 남습니다.</div><div class=\"backend-contract-note\">${artifactRuntimeState().signedIn&&artifactRuntimeState().workspaceId?'Workspace DB Sync 활성 · Artifact는 versioned EVIDENCE로 저장되며 Human Confirm도 자동 Domain Truth 승격은 하지 않습니다.':'Local-first 모드 · 로그인 + Workspace 선택 시 versioned EVIDENCE로 서버 동기화됩니다.'}</div>`;\n    if (editRow) for(const input of artifactEditorRoot.querySelectorAll('[data-artifact-field]')) input.value=editRow[input.dataset.artifactField]??'';\n    const rows = artifactRows(active);\n    artifactPreviewRoot.innerHTML = `<h3>저장된 ${escapeHtml(def.label)} <span class=\"artifact-count\">${rows.length} items</span></h3><div class=\"artifact-list\">${rows.length?rows.map((row)=>artifactRowHtml(active,def,row)).join(''):`<div class=\"artifact-empty\">아직 내 팀 데이터가 없습니다.<br>Role Pack 예시를 채운 뒤 ‘내 팀에 추가’를 눌러보세요.</div>`}</div>`;\n    if (artifactStorageStatus) {\n        const state=artifactRuntimeState();\n        const synced=allArtifactRecords().filter((row)=>row.serverVersion).length;\n        artifactStorageStatus.textContent=state.signedIn&&state.workspaceId\n            ? `LOCAL + WORKSPACE DB · ${allArtifactRecords().length} OBJECTS · ${synced} SYNCED`\n            : `LOCAL PREVIEW · ARTIFACT SCHEMA v6 · ${allArtifactRecords().length} OBJECTS`;\n        artifactStorageStatus.dataset.storageTone=state.signedIn&&state.workspaceId?'server':'local';\n    }\n    for (const button of artifactTabsRoot.querySelectorAll('[data-artifact-tab]')) button.addEventListener('click',()=>{editingArtifactId=null;questStore.artifactTab=button.dataset.artifactTab;saveQuestStore();renderArtifactWorkspace();});\n    artifactEditorRoot.querySelector('[data-artifact-sample]')?.addEventListener('click',()=>{\n        const sample=sampleArtifactRecordsForRole()[active];\n        for(const input of artifactEditorRoot.querySelectorAll('[data-artifact-field]')) input.value=sample?.[input.dataset.artifactField]??'';\n    });\n    artifactEditorRoot.querySelector('[data-artifact-cancel]')?.addEventListener('click',()=>{editingArtifactId=null;renderArtifactWorkspace();});\n    artifactEditorRoot.querySelector('[data-artifact-save]')?.addEventListener('click',()=>{\n        const record={};\n        for(const input of artifactEditorRoot.querySelectorAll('[data-artifact-field]')) record[input.dataset.artifactField]=String(input.value||'').trim();\n        for(const input of artifactEditorRoot.querySelectorAll('[data-artifact-relation]')) record[input.dataset.artifactRelation]=input.multiple?[...input.selectedOptions].map((option)=>option.value).filter(Boolean):refArray(input.value);\n        if(!Object.values(record).some(Boolean)) return;\n        if (editingArtifactId) { updateArtifactRecord(active,editingArtifactId,record); editingArtifactId=null; renderArtifactWorkspace(); renderSetupChecklist(); renderQuestList(); renderTodayLeaderNudge(); }\n        else addArtifactRecord(active,record);\n        renderQuestDetail(questStore.selectedDay);\n    });\n    artifactEditorRoot.querySelector('[data-calendar-import-run]')?.addEventListener('click',()=>{\n        const area=artifactEditorRoot.querySelector('[data-calendar-import]');\n        const rows=parseCalendarImport(area?.value);\n        for(const record of rows) addArtifactRecord('TEAM_CALENDAR',record);\n        if (area) area.value='';\n    });\n    for (const button of artifactPreviewRoot.querySelectorAll('[data-artifact-state]')) button.addEventListener('click',()=>{\n        const id=button.dataset.artifactState; const next=button.dataset.nextState; if(!id||!next) return;\n        setArtifactState(active,id,next);\n        renderArtifactWorkspace(); renderSetupChecklist(); renderQuestList(); renderQuestDetail(questStore.selectedDay); renderTodayLeaderNudge(); renderRecovery14Surfaces();\n    });\n    for (const button of artifactPreviewRoot.querySelectorAll('[data-artifact-edit]')) button.addEventListener('click',()=>{editingArtifactId=button.dataset.artifactEdit;renderArtifactWorkspace();artifactEditorRoot.scrollIntoView({behavior:'smooth',block:'center'});});\n    for (const button of artifactPreviewRoot.querySelectorAll('[data-artifact-delete]')) button.addEventListener('click',()=>{\n        const id=button.dataset.artifactDelete;\n        const deleting=artifactRows(active).find((item)=>item.id===id)||null;\n        if(deleting) deleteOperatingArtifactFromServer(active,deleting);\n        artifactStore[active]=artifactRows(active).filter((item)=>item.id!==id);\n        if (editingArtifactId===id) editingArtifactId=null;\n        removeArtifactRefs(id);\n        detachArtifactRelations(id);\n        saveArtifactStore();\n        renderArtifactWorkspace();\n        renderSetupChecklist();\n        renderQuestList();\n        renderQuestDetail(questStore.selectedDay);\n        renderTodayLeaderNudge();\n    });\n    renderDiagnostics();\n    renderWeeklyOperatingReview();\n    renderRecovery14Surfaces();\n    if (typeof renderRecovery15Surfaces === 'function') renderRecovery15Surfaces();\n};\nsetTimeout(()=>hydrateOperatingArtifactsFromServer(false),1700);\nsetInterval(()=>{\n    if(!switchArtifactStoreScope()) return;\n    if(typeof renderArtifactWorkspace==='function') renderArtifactWorkspace();\n    if(typeof renderSetupChecklist==='function') renderSetupChecklist();\n    setTimeout(()=>hydrateOperatingArtifactsFromServer(true),120);\n},1300);\nwindow.addEventListener('focus',()=>hydrateOperatingArtifactsFromServer(false));\ndocument.addEventListener('click',(event)=>{\n    if(event.target?.closest?.('[data-route=\"ONBOARDING\"],[data-page-link=\"ONBOARDING\"],[data-r21-path=\"DAY30\"],[data-r21-go-quest]')){\n        setTimeout(()=>hydrateOperatingArtifactsFromServer(false),320);\n    }\n},true);\nObject.defineProperty(window,'LeaderOsOperatingArtifactBridge',{\n    value:{\n        hydrate:()=>hydrateOperatingArtifactsFromServer(true),\n        sync:(type,id)=>syncOperatingArtifactToServer(type,id),\n        create:(type,payload={})=>{\n            if(!artifactDefinitions[type]) throw new Error('ARTIFACT_TYPE_UNSUPPORTED');\n            const id=addArtifactRecord(type,{...payload});\n            return artifactRows(type).find((row)=>row.id===id)||null;\n        },\n        openType:(type)=>{\n            if(!artifactDefinitions[type]) return false;\n            questStore.artifactTab=type;\n            saveQuestStore();\n            navigation.goTo('ONBOARDING');\n            renderArtifactWorkspace();\n            setTimeout(()=>artifactEditorRoot?.scrollIntoView({behavior:'smooth',block:'start'}),80);\n            return true;\n        },\n        snapshot:()=>JSON.parse(JSON.stringify(artifactStore)),\n        byType:(type)=>artifactRows(type).map((row)=>({...row})),\n        all:()=>allArtifactRecords().map((row)=>({...row})),\n        state:()=>({\n            scope:activeArtifactStorageScope,\n            workspaceId:artifactServerWorkspace,\n            count:allArtifactRecords().length,\n            synced:allArtifactRecords().filter((row)=>row.serverVersion).length\n        })\n    },\n    enumerable:false,\n    configurable:true\n});\nconst renderTodayLeaderNudge = () => {\n    const manager = artifactRows('MANAGER_CONTRACT')[0];\n    const team = artifactRows('TEAM_MAP');\n    const patterns = artifactRows('TEAM_PATTERN');\n    const stakeholders = artifactRows('STAKEHOLDER_MAP');\n    const calendar = artifactRows('TEAM_CALENDAR');\n    const work = artifactRows('WORK_MAP');\n    const milestones = artifactRows('MILESTONES');\n    const priorities = artifactRows('PRIORITY_CONTRACT')[0];\n    const badMilestone = milestones.find((item)=>!String(item.owner||'').trim() || !String(item.evidence||'').trim() || !String(item.decision||'').trim());\n    const missingDecision = artifactRows('DECISION_RIGHTS').find((item)=>!String(item.decide||'').trim());\n    const multiDecision = artifactRows('DECISION_RIGHTS').find((item)=>hasMultipleDeciders(item.decide));\n    const decision = artifactRows('DECISION_RIGHTS')[0];\n    const delegation = artifactRows('DELEGATION')[0];\n    const debrief = artifactRows('DEBRIEF')[0];\n    const nextChecklist = LEADERSHIP_SETUP_CHECKLIST.find((item)=>!setupDone(item).done);\n    let title='첫 30일 세팅을 시작하세요.';\n    let copy='상급자의 기대와 팀의 실제 역할을 먼저 보이게 만들면 이후 우선순위·결정권·위임을 더 정확히 설계할 수 있습니다.';\n    let label='Manager Contract 만들기';\n    let route='ONBOARDING';\n    let state='open';\n    let targetArtifact='MANAGER_CONTRACT';\n    let targetDay=2;\n    if (!manager) { title='먼저 “무엇을 성공으로 볼지” 상급자와 맞추세요.'; copy='30일 성공 기준 · Top 3 기대 · 보고 리듬 · 즉시 공유 조건을 Manager Contract 한 장으로 정리합니다.'; label='Manager Contract 작성'; targetArtifact='MANAGER_CONTRACT'; targetDay=2; }\n    else if (!team.length) { title='직함보다 실제 역할을 먼저 파악하세요.'; copy='Team Map에 역할·책임·의존성·UNKNOWN을 기록하세요. 사람 평가는 하지 않습니다.'; label='Team Map 작성'; targetArtifact='TEAM_MAP'; targetDay=3; }\n    else if (!patterns.length) { title='1:1의 개별 이야기를 팀 패턴으로 묶어보세요.'; copy='두 번 이상 반복되는 blocker만 Team Pattern Board에 올리고 검증 질문을 남깁니다.'; label='Team Pattern 작성'; targetArtifact='TEAM_PATTERN'; targetDay=5; }\n    else if (!stakeholders.length) { title='팀 밖의 숨은 의존성을 지도에 올리세요.'; copy='결과에 영향을 주는 이해관계자와 기대·영향도·다음 접점을 기록합니다.'; label='Stakeholder Map 작성'; targetArtifact='STAKEHOLDER_MAP'; targetDay=6; }\n    else if (!calendar.length) { title='팀이 시간을 어디에 쓰는지 보세요.'; copy='반복 일정을 Ritual / 1:1 / Milestone / Decision / Debrief로 분류하면 실제 운영 리듬이 보입니다.'; label='Team Calendar 작성'; targetArtifact='TEAM_CALENDAR'; targetDay=8; }\n    else if (!work.length) { title='현재 진행 중인 일을 한 장으로 연결하세요.'; copy='각 프로젝트의 Goal · Owner · Next Milestone · Open Decision을 Work Map에 올립니다.'; label='Work Map 작성'; targetArtifact='WORK_MAP'; targetDay=10; }\n    else if (!milestones.length) { title='날짜가 아니라 판단 가능한 Milestone을 만드세요.'; copy='Outcome · Evidence · Owner · Decision이 있는 마일스톤부터 1개 작성하세요.'; label='Milestone 작성'; targetArtifact='MILESTONES'; targetDay=11; }\n    else if (badMilestone) { title='완료 기준이 빠진 Milestone이 있습니다.'; copy=`${badMilestone.milestone||'Milestone'}에 Owner · Evidence · Decision을 채워 다음 판단 지점으로 만드세요.`; label='Milestone 보완'; targetArtifact='MILESTONES'; targetDay=11; }\n    else if (!priorities) { title='이제 이번 주 Top 3를 계약처럼 명확히 하세요.'; copy='Priority 1–3, Not now, Success signal, Review date를 합의하면 팀이 같은 기준으로 움직입니다.'; label='Priority Contract 작성'; targetArtifact='PRIORITY_CONTRACT'; targetDay=13; }\n    else if (missingDecision) { title='결정권자가 비어 있는 Decision이 있습니다.'; copy=`${missingDecision.decision||'중요 결정'}의 최종 Decide(D)를 지정해 병목을 줄이세요.`; label='Decision Rights 열기'; targetArtifact='DECISION_RIGHTS'; targetDay=16; }\n    else if (multiDecision) { title='최종 결정권자 D가 여러 명으로 보입니다.'; copy=`${multiDecision.decision||'중요 결정'}의 D를 한 역할로 명확히 하세요.`; label='Decision Rights 점검'; targetArtifact='DECISION_RIGHTS'; targetDay=16; }\n    else if (decision && !delegation) { title='결정권은 정리됐습니다. 이제 실제 업무 하나를 위임해보세요.'; copy=`${decision.decision||'중요 결정'}의 권한 구조를 기준으로 Outcome · Guardrail · Checkpoint를 합의해보세요.`; label='Delegation 작성'; targetArtifact='DELEGATION'; targetDay=19; }\n    else if (delegation && !debrief) { title='위임을 했으면 결과를 Debrief로 학습에 연결하세요.'; copy=`${delegation.task||'위임 업무'}에서 예상과 실제의 차이를 기록하면 다음 운영 룰을 만들 수 있습니다.`; label='Debrief 작성'; targetArtifact='DEBRIEF'; targetDay=26; }\n    else if (stakeholders.some((item)=>String(item.influence||'').toUpperCase()==='UNKNOWN' || !String(item.nextTouch||'').trim())) { const s=stakeholders.find((item)=>String(item.influence||'').toUpperCase()==='UNKNOWN' || !String(item.nextTouch||'').trim()); title='확인되지 않은 Stakeholder 의존성이 있습니다.'; copy=`${s?.stakeholder||'핵심 이해관계자'}의 영향도 또는 다음 접점을 확인해 운영 리스크를 줄이세요.`; label='Stakeholder Map 점검'; targetArtifact='STAKEHOLDER_MAP'; targetDay=6; }\n    else if (nextChecklist) { title=`다음 Setup: ${nextChecklist.title}`; copy=`Day ${nextChecklist.day} Quest · ${nextChecklist.artifact}를 만들 차례입니다.`; label=`Day ${nextChecklist.day} 열기`; targetArtifact=SETUP_ARTIFACT_TYPE[nextChecklist.id]||questStore.artifactTab; targetDay=nextChecklist.day; }\n    else { const charter=artifactRows('TEAM_OS_CHARTER')[0]; const next60=artifactRows('NEXT_60_PLAN')[0]; if(!charter){title='첫 30일의 운영 Artifact를 Team OS Charter로 통합하세요.';copy='Confirmed 운영 기준을 한 장으로 조립해 팀이 반복해서 쓸 규칙을 남깁니다.';label='Team OS Charter 만들기';targetArtifact='TEAM_OS_CHARTER';targetDay=30;} else if(!next60){title='30일 온보딩에서 다음 60일 실행으로 넘어가세요.';copy='Outcomes 3개 · System Upgrade · Leader Experiment · Review Rhythm을 Next 60 Plan으로 정리합니다.';label='Next 60 Plan 만들기';targetArtifact='NEXT_60_PLAN';targetDay=30;} else {title='Team Operating System v1이 운영 사이클로 전환됐습니다.';copy='Weekly Operating Review에서 실제 결과·결정·위임·학습을 확인하고 Charter를 필요할 때 업데이트하세요.';label='Weekly Review 보기';targetArtifact='WEEKLY_REVIEW';targetDay=30;state='complete';} route='ONBOARDING'; }\n    todayNudgeRoot.dataset.state=state; todayNudgeTitle.textContent=title; todayNudgeCopy.textContent=copy; todayNudgeAction.textContent=label;\n    todayNudgeAction.onclick=()=>{navigation.goTo(route); if(route==='ONBOARDING'){ if(targetArtifact && artifactDefinitions[targetArtifact]){questStore.artifactTab=targetArtifact;saveQuestStore();renderArtifactWorkspace();} if(targetDay) renderQuestDetail(targetDay); }};\n};\nconst chiefArtifactSummary = (type) => {\n    const rows=artifactRows(type);\n    if (!rows.length) return '아직 Artifact 없음';\n    return `${rows.length}개 · ${artifactPrimary(type,rows[rows.length-1])}`;\n};\nconst renderQuestChiefRail = (quest) => {\n    if (!questChiefRailRoot || !quest) return;\n    const type=QUEST_ARTIFACT_TYPE[quest.day]||null;\n    const refs=artifactRefsForDay(quest.day);\n    const nextQuestions=(quest.debrief||[]).slice(0,2);\n    const artifactSummary=type?chiefArtifactSummary(type):'이 Quest는 자유 Evidence 또는 연결된 Artifact로 완료할 수 있습니다.';\n    questChiefRailRoot.innerHTML=`<div class=\"chief-rail-card\"><span class=\"section-kicker\">WHY NOW?</span><strong>${escapeHtml(quest.outcome)}</strong><p>${escapeHtml(quest.knowledge)}</p></div><div class=\"chief-rail-card\"><span class=\"section-kicker\">I NOTICE</span><strong>${escapeHtml(type?artifactDefinitions[type]?.label||type:'Practice')}</strong><p>${escapeHtml(artifactSummary)}</p><span class=\"chief-evidence\">Evidence refs · ${refs.length}</span></div><div class=\"chief-rail-card\"><span class=\"section-kicker\">SUGGESTED QUESTIONS</span>${nextQuestions.map((q)=>`<button type=\"button\" class=\"chief-question\">${escapeHtml(q)}</button>`).join('')}</div><div class=\"chief-rail-card emphasis\"><span class=\"section-kicker\">SUGGESTED NEXT</span><strong>${refs.length?'Debrief를 남기고 다음 행동을 정하세요.':type?'예시를 본 뒤 내 팀 Artifact를 하나 만드세요.':'Evidence를 한 줄 기록하세요.'}</strong>${type?`<button type=\"button\" class=\"primary\" data-chief-open-artifact=\"${escapeHtml(type)}\">${escapeHtml(artifactDefinitions[type]?.label||type)} 열기</button>`:''}</div>`;\n    questChiefRailRoot.querySelector('[data-chief-open-artifact]')?.addEventListener('click',(event)=>{const target=event.currentTarget.dataset.chiefOpenArtifact;if(target&&artifactDefinitions[target]){questStore.artifactTab=target;saveQuestStore();renderArtifactWorkspace();document.querySelector('[data-artifact-tabs]')?.scrollIntoView({behavior:'smooth',block:'center'});}});\n};\nconst latestArtifact = (type, confirmedOnly=false) => { const rows=confirmedOnly?confirmedArtifactRows(type):artifactRows(type); return rows[rows.length-1]||null; };\nconst formatArtifactLink = (type,id) => { const row=id?artifactRecordById(id):null; return row?artifactPrimary(type,row):'연결 없음'; };\nconst buildTeamOsCharterDraft = () => {\n    const manager=latestArtifact('MANAGER_CONTRACT',true)||latestArtifact('MANAGER_CONTRACT');\n    const calendar=confirmedArtifactRows('TEAM_CALENDAR');\n    const priority=latestArtifact('PRIORITY_CONTRACT',true)||latestArtifact('PRIORITY_CONTRACT');\n    const decisions=confirmedArtifactRows('DECISION_RIGHTS');\n    const delegations=confirmedArtifactRows('DELEGATION');\n    const debrief=latestArtifact('DEBRIEF',true)||latestArtifact('DEBRIEF');\n    const rhythm=calendar.length?calendar.slice(0,6).map((r)=>`${r.day||''} ${r.time||''} ${r.title||''}`).join(' · '):(manager?.reportRhythm||'운영 리듬 확인 필요');\n    const decisionRule=decisions.length?`${decisions.length}개 Confirmed Decision · D: ${[...new Set(decisions.map((r)=>r.decide).filter(Boolean))].join(', ')||'확인 필요'}`:'중요 결정에 RAPID와 최종 D를 명시';\n    const delegationRule=delegations.length?`${delegations.length}개 Confirmed Delegation · ${delegations.map((r)=>r.level).filter(Boolean).join(' / ')}`:'Outcome / Guardrail / Authority / Checkpoint를 함께 합의';\n    const supports=[manager,...calendar,priority,...decisions,...delegations,debrief].filter(Boolean);\n    const supportRefs=[...new Set(supports.map((row)=>row.id).filter(Boolean))];\n    const supportVersions=Object.fromEntries(supports.filter((row)=>row.id).map((row)=>[row.id,Number(row.version)||1]));\n    return {versionLabel:'v1',successDefinition:manager?.success30||priority?.successSignal||'팀의 성공 정의를 합의하세요.',operatingRhythm:rhythm,decisionRule,delegationRule,reviewRule:debrief?.next?`Debrief learning: ${debrief.next}`:'금요일 Weekly Review에서 Keep / Change / Next',escalationRule:manager?.escalation||'예산·외부 약속·핵심 일정 변경은 즉시 공유',supportRefs:supportRefs.join(','),supportVersions:JSON.stringify(supportVersions)};\n};\nconst renderTeamOsCharter = () => {\n    if(!teamOsCharterRoot) return;\n    const draft=buildTeamOsCharterDraft();\n    const confirmedCount=Object.keys(artifactDefinitions).filter((t)=>!['TEAM_OS_CHARTER','NEXT_60_PLAN'].includes(t)).reduce((sum,t)=>sum+confirmedArtifactRows(t).length,0);\n    const required=['MANAGER_CONTRACT','TEAM_MAP','TEAM_CALENDAR','WORK_MAP','MILESTONES','PRIORITY_CONTRACT','DECISION_RIGHTS','DELEGATION','DEBRIEF'];\n    const missing=required.filter((t)=>!confirmedArtifactRows(t).length);\n    teamOsCharterRoot.innerHTML=`<div class=\"charter-status\"><span class=\"state-badge ${missing.length?'':'confirmed'}\">${missing.length?`REVIEW NEEDED · ${missing.length} areas`:'READY TO CHARTER'}</span><span>${confirmedCount} Confirmed operating artifacts</span></div><div class=\"charter-grid\"><div><small>SUCCESS DEFINITION</small><b>${escapeHtml(draft.successDefinition)}</b></div><div><small>OPERATING RHYTHM</small><b>${escapeHtml(draft.operatingRhythm)}</b></div><div><small>DECISION RULE</small><b>${escapeHtml(draft.decisionRule)}</b></div><div><small>DELEGATION RULE</small><b>${escapeHtml(draft.delegationRule)}</b></div><div><small>REVIEW RULE</small><b>${escapeHtml(draft.reviewRule)}</b></div><div><small>ESCALATION</small><b>${escapeHtml(draft.escalationRule)}</b></div></div>${missing.length?`<div class=\"safe\">Charter는 DRAFT를 자동으로 사실화하지 않습니다. 먼저 확인할 영역: ${escapeHtml(missing.map((t)=>artifactDefinitions[t]?.label||t).join(' · '))}</div>`:'<div class=\"safe\">Confirmed Artifact만 운영 기준으로 우선 사용합니다. Charter 저장 후에도 Human Review로 수정할 수 있습니다.</div>'}`;\n    if(teamOsCharterSave) teamOsCharterSave.disabled=false;\n};\nteamOsCharterSave?.addEventListener('click',()=>{ const draft=buildTeamOsCharterDraft(); addArtifactRecord('TEAM_OS_CHARTER',draft); questStore.artifactTab='TEAM_OS_CHARTER'; saveQuestStore(); renderArtifactWorkspace(); });\nconst buildNext60Draft = () => { const pack=ROLE_PACKS[questStore.rolePack]||ROLE_PACKS.TEAM_MANAGER; const charter=latestArtifact('TEAM_OS_CHARTER',true)||latestArtifact('TEAM_OS_CHARTER'); const priority=latestArtifact('PRIORITY_CONTRACT',true)||latestArtifact('PRIORITY_CONTRACT'); return {period:'Day 31–90',outcome1:priority?.priority1||pack.starter.milestone,outcome2:`${pack.starter.role}의 독립 결정 범위를 한 단계 확장`,outcome3:'운영 리듬을 4주 이상 반복해 병목 변화 확인',systemUpgrade:'Work → Milestone → Decision → Delegation 관계를 실제 링크로 유지',leaderExperiment:'1:1과 피드백에서 Tell보다 Ask를 한 번 더 사용',reviewRhythm:'Weekly Review + Day 60 / Day 90',charterRef:charter?.id||''}; };\nconst renderDay30Transition = () => {\n    if(!day30TransitionRoot) return;\n    const progress=questProgressSummary(questStore.completed); const charter=latestArtifact('TEAM_OS_CHARTER'); const next=latestArtifact('NEXT_60_PLAN'); const draft=buildNext60Draft(); const eligible=progress.done>=30 && Boolean(charter);\n    day30TransitionRoot.innerHTML=`<div class=\"transition-gate\"><div><span class=\"section-kicker\">30-DAY COMPLETION REVIEW</span><strong>${progress.done}/30 Quest · ${charter?'Charter saved':'Charter not saved'}</strong><p>${eligible?'첫 30일의 관찰·정렬 단계에서 다음 60일의 실행·위임·성과 검증 단계로 넘어갈 준비가 됐습니다.':'Day 30을 마치기 전에 Quest Evidence와 Team OS Charter를 확인하세요.'}</p></div><span class=\"state-badge ${eligible?'confirmed':''}\">${eligible?'READY FOR NEXT 60':'GATE OPEN'}</span></div><div class=\"next60-preview\"><div><small>OUTCOME 1</small><b>${escapeHtml(draft.outcome1)}</b></div><div><small>OUTCOME 2</small><b>${escapeHtml(draft.outcome2)}</b></div><div><small>OUTCOME 3</small><b>${escapeHtml(draft.outcome3)}</b></div><div><small>SYSTEM UPGRADE</small><b>${escapeHtml(draft.systemUpgrade)}</b></div><div><small>LEADER EXPERIMENT</small><b>${escapeHtml(draft.leaderExperiment)}</b></div><div><small>REVIEW RHYTHM</small><b>${escapeHtml(draft.reviewRhythm)}</b></div></div>${next?`<div class=\"safe\">저장된 Next 60 Plan: ${escapeHtml(artifactPrimary('NEXT_60_PLAN',next))}</div>`:''}`;\n    if(next60Save) next60Save.disabled=!charter;\n};\nnext60Save?.addEventListener('click',()=>{ const draft=buildNext60Draft(); addArtifactRecord('NEXT_60_PLAN',draft); questStore.artifactTab='NEXT_60_PLAN'; saveQuestStore(); renderArtifactWorkspace(); });\nconst renderManagerReportingRhythm = () => {\n    const manager=latestArtifact('MANAGER_CONTRACT',true)||latestArtifact('MANAGER_CONTRACT'); const reviews=artifactRows('WEEKLY_REVIEW');\n    if(todayReportingRoot) todayReportingRoot.innerHTML=manager?`<span class=\"section-kicker\">REPORTING RHYTHM</span><strong>${escapeHtml(manager.reportRhythm||'리듬 미입력')}</strong><p>${escapeHtml(manager.escalation||'즉시 공유 조건을 Manager Contract에 기록하세요.')}</p><span class=\"review-meta\">${reviews.length?`Weekly Review ${reviews.length}회 저장`:'아직 Weekly Review Snapshot 없음'}</span>`:`<span class=\"section-kicker\">REPORTING RHYTHM</span><strong>Manager Contract가 필요합니다.</strong><p>상급자에게 언제 무엇을 보고하고 어떤 조건에서 즉시 공유할지 먼저 합의하세요.</p>`;\n    if(reportOperatingRoot) { const charter=latestArtifact('TEAM_OS_CHARTER',true)||latestArtifact('TEAM_OS_CHARTER'); reportOperatingRoot.innerHTML=`<div class=\"section-kicker\">OPERATING SYSTEM REPORT</div><h2>${charter?'Team OS Charter':'Manager Contract → Charter'}</h2><div class=\"context-list\"><div class=\"context-row\"><span>Reporting</span><span>${escapeHtml(manager?.reportRhythm||'미설정')}</span></div><div class=\"context-row\"><span>Escalation</span><span>${escapeHtml(manager?.escalation||'미설정')}</span></div><div class=\"context-row\"><span>Charter</span><span>${escapeHtml(charter?`${charter.versionLabel||'v1'} · ${charter.artifactState||'DRAFT'}`:'아직 없음')}</span></div><div class=\"context-row\"><span>Weekly Reviews</span><span>${reviews.length}</span></div></div>`; }\n};\nconst renderStakeholderNudge = () => {\n    if(!todayStakeholderRoot) return; const stakeholders=artifactRows('STAKEHOLDER_MAP'); const high=stakeholders.filter((r)=>String(r.influence||'').toUpperCase()==='HIGH'); const unknown=stakeholders.filter((r)=>String(r.influence||'').toUpperCase()==='UNKNOWN'||!String(r.nextTouch||'').trim()); const target=unknown[0]||high.find((r)=>String(r.nextTouch||'').trim())||stakeholders[0];\n    todayStakeholderRoot.innerHTML=target?`<span class=\"section-kicker\">STAKEHOLDER NUDGE</span><strong>${escapeHtml(target.stakeholder||'Stakeholder')} · ${escapeHtml(target.influence||'UNKNOWN')}</strong><p>${escapeHtml(target.nextTouch||'다음 접점을 정하고 기대를 확인하세요.')}</p><span class=\"review-meta\">Expectation: ${escapeHtml(target.expectation||'확인 필요')}</span>`:`<span class=\"section-kicker\">STAKEHOLDER NUDGE</span><strong>팀 밖의 핵심 의존성이 아직 보이지 않습니다.</strong><p>Stakeholder Map에서 실제 영향력이 큰 사람과 다음 접점을 기록하세요.</p>`;\n};\nconst renderRecovery14Surfaces = () => { renderTeamOsCharter(); renderDay30Transition(); renderManagerReportingRhythm(); renderStakeholderNudge(); };\n\nconst currentWeekLabel = () => {\n    const d=new Date(); const jan1=new Date(d.getFullYear(),0,1); const days=Math.floor((d-jan1)/86400000); const week=Math.ceil((days+jan1.getDay()+1)/7); return `${d.getFullYear()}-W${String(week).padStart(2,'0')}`;\n};\nconst buildWeeklyOperatingReview = () => {\n    const cal=artifactRows('TEAM_CALENDAR');\n    const miles=artifactRows('MILESTONES');\n    const work=artifactRows('WORK_MAP');\n    const decisions=artifactRows('DECISION_RIGHTS');\n    const delegations=artifactRows('DELEGATION');\n    const debriefs=artifactRows('DEBRIEF');\n    const priorities=artifactRows('PRIORITY_CONTRACT');\n    const openMiles=miles.filter((r)=>!String(r.evidence||'').trim() || !String(r.decision||'').trim()).length;\n    const noD=decisions.filter((r)=>!String(r.decide||'').trim() || hasMultipleDeciders(r.decide)).length;\n    const looseDelegation=delegations.filter((r)=>!String(r.guardrail||'').trim() || !String(r.checkpoint||'').trim()).length;\n    const ownerless=work.filter((r)=>!String(r.owner||'').trim()).length;\n    const latestDebrief=debriefs[debriefs.length-1]||null;\n    const latestPriority=priorities[priorities.length-1]||null;\n    const attention = ownerless?`Owner가 비어 있는 Work ${ownerless}개`:openMiles?`Evidence/Decision이 부족한 Milestone ${openMiles}개`:noD?`Decision Rights 점검 필요 ${noD}개`:looseDelegation?`Guardrail/Checkpoint 보완 ${looseDelegation}개`:'핵심 운영 Artifact의 기본 필드가 채워져 있습니다.';\n    return {week:currentWeekLabel(),attention,calendar:`${cal.length}개 일정 · ${new Set(cal.map((r)=>r.type).filter(Boolean)).size}개 유형`,milestones:`${miles.length}개 · 보완 ${openMiles}`,decisions:`${decisions.length}개 · D 점검 ${noD}`,delegation:`${delegations.length}개 · 보완 ${looseDelegation}`,learning:latestDebrief?`${latestDebrief.change||latestDebrief.why||latestDebrief.next||'Debrief 기록 있음'}`:'아직 Debrief 없음',next:latestPriority?.priority1||latestDebrief?.next||'다음 주 Priority Contract를 업데이트하세요.'};\n};\nconst renderWeeklyOperatingReview = () => {\n    if (!weeklyReviewRoot) return;\n    const draft=buildWeeklyOperatingReview();\n    weeklyReviewRoot.innerHTML=`<div class=\"weekly-review-grid\"><div class=\"weekly-review-cell\"><small>CALENDAR</small><b>${escapeHtml(draft.calendar)}</b></div><div class=\"weekly-review-cell\"><small>MILESTONE</small><b>${escapeHtml(draft.milestones)}</b></div><div class=\"weekly-review-cell\"><small>DECISION</small><b>${escapeHtml(draft.decisions)}</b></div><div class=\"weekly-review-cell\"><small>DELEGATION</small><b>${escapeHtml(draft.delegation)}</b></div><div class=\"weekly-review-cell\"><small>LEARNING</small><b>${escapeHtml(draft.learning)}</b></div><div class=\"weekly-review-cell emphasis\"><small>NEXT</small><b>${escapeHtml(draft.next)}</b></div></div><div class=\"weekly-review-attention\"><span class=\"section-kicker\">CHIEF OF STAFF · THIS WEEK</span><strong>${escapeHtml(draft.attention)}</strong><p>이 리뷰는 사람 점수가 아니라 운영 객체의 완성도와 연결 상태를 봅니다.</p></div>`;\n};\nweeklyReviewSave?.addEventListener('click',()=>{\n    const draft=buildWeeklyOperatingReview();\n    addArtifactRecord('WEEKLY_REVIEW',{week:draft.week,attention:draft.attention,decisions:draft.decisions,delegation:draft.delegation,learning:draft.learning,next:draft.next});\n    questStore.artifactTab='WEEKLY_REVIEW'; saveQuestStore(); renderArtifactWorkspace();\n});\nconst renderQuestProgress = () => {\n    const summary = questProgressSummary(questStore.completed);\n    questProgressRoot.style.width = `${summary.percent}%`;\n    questProgressText.textContent = `${summary.done} / ${summary.total} 완료 · ${summary.percent}%`;\n};\nconst sourceLinks = (keys) => keys.map((key) => {\n    const source = LEADERSHIP_KNOWLEDGE_SOURCES[key];\n    if (!source) return '';\n    return `<a class=\"quest-source-link\" href=\"${escapeHtml(source.url)}\" target=\"_blank\" rel=\"noreferrer\">${escapeHtml(source.name)}</a>`;\n}).filter(Boolean).join('');\nconst renderQuestDetail = (day) => {\n    const quest = LEADERSHIP_QUESTS.find((item) => item.day === Number(day)) ?? LEADERSHIP_QUESTS[0];\n    const selectionChanged = Number(questStore.selectedDay) !== quest.day;\n    questStore.selectedDay = quest.day;\n    if (selectionChanged) {\n        questStore.questProgressUpdatedAt = new Date().toISOString();\n        saveQuestStore();\n        queueQuestProgressServerSave();\n    }\n    const done = questStore.completed.includes(quest.day);\n    const saved = questStore.notes[String(quest.day)] ?? {};\n    const mission = missionForDay(quest.day);\n    const missionProgress = missionCheckProgress(quest.day);\n    const selfLevel = String(questStore.selfVerification[String(quest.day)] || 'NOT_YET');\n    const pillarMeta = LEADERSHIP_MISSION_PILLARS[mission.pillar] || {label:mission.pillar,short:mission.pillar};\n    const linkedRefs = artifactRefsForDay(quest.day);\n    const expectedType = QUEST_ARTIFACT_TYPE[quest.day] || null;\n    const candidateRows = expectedType ? artifactRows(expectedType) : allArtifactRecords();\n    const hasEvidence = Boolean(String(questStore.evidence[String(quest.day)] ?? '').trim()) || linkedRefs.length > 0;\n    const coachKey = QUEST_COACH_SCENARIO_BY_DAY[quest.day] || 'TASK';\n    const coachScenario = LEADER_COACH_SCENARIOS[coachKey] || LEADER_COACH_SCENARIOS.TASK;\n    const phaseFinish = LEADERSHIP_HARNESS_PHASES[quest.phase]?.finish || '';\n    const linkedHtml = linkedRefs.length ? linkedRefs.map((id)=>{\n        const row=artifactRecordById(id); if(!row) return '';\n        return `<span class=\"evidence-ref\">${escapeHtml(artifactPrimary(row.artifactType,row))}<button type=\"button\" aria-label=\"Evidence 연결 해제\" data-evidence-unlink=\"${escapeHtml(id)}\">×</button></span>`;\n    }).join('') : '<span class=\"quest-evidence-state\">연결된 Artifact 없음</span>';\n    const candidateHtml = candidateRows.filter((row)=>!linkedRefs.includes(row.id)).map((row)=>{ const rowType=expectedType||row.artifactType; return `<option value=\"${escapeHtml(row.id)}\">${escapeHtml(artifactPrimary(rowType,row))} · ${escapeHtml(rowType||'ARTIFACT')}</option>`; }).join('');\n    const artifactLinker = `<div class=\"artifact-linker\"><div class=\"artifact-linker-head\"><b>Operating Artifact 연결</b><span>${expectedType ? escapeHtml(expectedType) : '모든 Artifact'}</span></div><div class=\"artifact-linker-controls\"><select data-quest-artifact-select><option value=\"\">${candidateHtml?'Evidence로 연결할 Artifact 선택':'연결 가능한 Artifact가 없습니다'}</option>${candidateHtml}</select><button type=\"button\" data-quest-artifact-link ${candidateHtml?'':'disabled'}>연결</button></div><div class=\"evidence-ref-list\">${linkedHtml}</div></div>`;\n    questDetailRoot.innerHTML = `\n      <div class=\"quest-detail-head\">\n        <div>\n          <div class=\"lens-kicker\">DAY ${quest.day} · ${escapeHtml(quest.phase)} · ${escapeHtml(quest.duration)}</div>\n          <h2>${escapeHtml(quest.title)}</h2>\n          <p class=\"quest-outcome\">${escapeHtml(quest.outcome)}</p>\n        </div>\n        <button type=\"button\" class=\"${done ? '' : 'primary'}\" data-quest-complete ${!done && !(hasEvidence && missionProgress.complete && selfLevel!=='NOT_YET') ? 'disabled' : ''}>${done ? '✓ 완료 취소' : 'Mission 완료'}</button>\n      </div>\n      <section class=\"quest-box mission-checklist-box\">\n        <div class=\"mission-checklist-head\">\n          <div><span>MISSION CHECKLIST · ${escapeHtml(pillarMeta.label)}</span><strong>${escapeHtml(mission.title)}</strong><p>${escapeHtml(mission.target)}</p></div>\n          <div class=\"mission-day-progress\"><b>${missionProgress.done}/${missionProgress.total}</b><small>필수 행동</small></div>\n        </div>\n        <div class=\"mission-meta-row\"><span>대상 · ${escapeHtml(mission.stakeholder)}</span><span>남길 결과 · ${escapeHtml(mission.proof)}</span></div>\n        <div class=\"mission-check-items\">\n          ${mission.checklist.map((item)=>`<label class=\"mission-check-item ${missionProgress.checked.includes(item.id)?'checked':''}\"><input type=\"checkbox\" data-mission-check=\"${escapeHtml(item.id)}\" ${missionProgress.checked.includes(item.id)?'checked':''}><span>${escapeHtml(item.label)}</span></label>`).join('')}\n        </div>\n        <div class=\"mission-complete-rule\">${missionProgress.complete?'✓ 필수 행동 체크 완료 · Evidence와 Self Verification까지 남기면 Mission을 닫을 수 있습니다.':'체크리스트 → Evidence → Self Verification 세 단계를 모두 완료해야 Mission 완료가 활성화됩니다.'}</div>\n      </section>\n      <div class=\"quest-learning-grid\">\n        <section class=\"quest-box knowledge\"><span>REFERENCE · WHY</span><strong>핵심 원칙</strong><p>${escapeHtml(quest.knowledge)}</p></section>\n        <section class=\"quest-box case\"><span>REFERENCE · CASE</span><strong>상황</strong><p>${escapeHtml(quest.case)}</p></section>\n      </div>\n      <section class=\"quest-box practice\"><span>DO</span><strong>실습</strong><ol>${quest.practice.map((step) => `<li>${escapeHtml(step)}</li>`).join('')}</ol></section>\n      <div class=\"quest-learning-grid\">\n        <section class=\"quest-box artifact\"><span>ARTIFACT</span><strong>${escapeHtml(quest.artifact)}</strong><p>${escapeHtml(quest.evidence)}</p><button type=\"button\" data-quest-route data-route=\"${escapeHtml(quest.route)}\">Leader OS에서 적용 →</button><div class=\"quest-evidence-field\"><label><strong>완료 Evidence 메모</strong><textarea data-quest-evidence placeholder=\"Artifact가 없거나 추가 설명이 필요할 때만 메모를 남겨도 됩니다.\">${escapeHtml(questStore.evidence[String(quest.day)] ?? '')}</textarea></label>${artifactLinker}<div class=\"quest-evidence-actions\"><button type=\"button\" data-quest-evidence-save>Evidence 저장</button><span class=\"quest-evidence-state\" data-quest-evidence-state>${hasEvidence ? `Evidence 있음 · ${linkedRefs.length} Artifact 연결` : '메모 또는 실제 Artifact를 연결하면 Quest 완료가 활성화됩니다.'}</span></div></div></section>\n        <section class=\"quest-box nudge harness-coach\"><span>LEADER COACH · BEFORE / AFTER</span><strong>${escapeHtml(coachScenario.name)}</strong><p><b>실행 전 질문</b><br>${escapeHtml(coachScenario.coach)}</p><div class=\"harness-coach-script\"><small>대화 구조</small><b>${escapeHtml(coachScenario.script)}</b></div><p><b>오늘의 체크</b><br>${escapeHtml(quest.nudge)}</p><details class=\"harness-coach-learn\"><summary>왜 이렇게 코칭하나</summary><p>${escapeHtml(coachScenario.learn)}</p></details><div class=\"harness-coach-finish\">이 Phase의 도착점 · ${escapeHtml(phaseFinish)}</div><div class=\"harness-coach-actions\">${expectedType?`<button type=\"button\" data-open-artifact=\"${escapeHtml(expectedType)}\">내 ${escapeHtml(artifactDefinitions[expectedType]?.label||expectedType)} 작성 →</button>`:''}<button type=\"button\" data-open-leader-coach>Leader Coach에서 더 연습 →</button></div></section>\n      </div>\n      <section class=\"quest-box self-verification\">\n        <span>SELF VERIFICATION · 사람 점수화 아님</span><strong>${escapeHtml(mission.selfQuestion)}</strong>\n        <div class=\"self-levels\">\n          ${[\n            ['NOT_YET','아직 하지 않음'],\n            ['TRIED','실행해봄'],\n            ['EVIDENCED','Evidence로 확인'],\n            ['REPEATABLE','반복 가능한 방식']\n          ].map(([value,label])=>`<button type=\"button\" class=\"${selfLevel===value?'active':''}\" data-self-level=\"${value}\">${label}</button>`).join('')}\n        </div>\n        <div class=\"review-meta\">이 값은 팀원을 평가하는 점수가 아니라, 리더 자신이 이 행동을 얼마나 실제 운영 습관으로 만들었는지 확인하는 개인 자기검증입니다.</div>\n      </section>\n      <section class=\"quest-box reflection\">\n        <span>DEBRIEF</span><strong>리더 자기점검</strong>\n        <div class=\"quest-reflection-questions\">${quest.debrief.map((q) => `<label>${escapeHtml(q)}<textarea data-quest-note placeholder=\"짧게 기록해도 충분합니다.\">${escapeHtml(saved[q] ?? '')}</textarea></label>`).join('')}</div>\n        <div class=\"review-meta\">이 기록은 사람 평가가 아니라 리더 자신의 판단과 운영 선택을 돌아보기 위한 메모입니다.</div>\n      </section>\n      <section class=\"quest-box sources\"><span>SOURCES</span><strong>Knowledge provenance</strong><div class=\"quest-source-list\">${sourceLinks(quest.sources)}</div></section>`;\n    const evidenceArea = questDetailRoot.querySelector('[data-quest-evidence]');\n    const evidenceSave = questDetailRoot.querySelector('[data-quest-evidence-save]');\n    const evidenceState = questDetailRoot.querySelector('[data-quest-evidence-state]');\n    renderQuestChiefRail(quest);\n    const completeButton = questDetailRoot.querySelector('[data-quest-complete]');\n    const currentHasEvidence = () => Boolean(String(questStore.evidence[String(quest.day)] ?? evidenceArea?.value ?? '').trim()) || artifactRefsForDay(quest.day).length > 0;\n    const currentMissionComplete = () => missionCheckProgress(quest.day).complete;\n    const currentSelfVerified = () => String(questStore.selfVerification[String(quest.day)]||'NOT_YET') !== 'NOT_YET';\n    const syncEvidenceButton = () => { if (completeButton && !done) completeButton.disabled = !(currentHasEvidence() && currentMissionComplete() && currentSelfVerified()); };\n    for (const checkbox of questDetailRoot.querySelectorAll('[data-mission-check]')) {\n        checkbox.addEventListener('change',()=>{\n            const mission=missionForDay(quest.day);\n            const allowed=new Set(mission.checklist.map((item)=>item.id));\n            const selected=Array.from(questDetailRoot.querySelectorAll('[data-mission-check]:checked')).map((el)=>el.dataset.missionCheck).filter((id)=>allowed.has(id));\n            questStore.missionChecks[String(quest.day)]=selected;\n            questStore.missionUpdatedAt=new Date().toISOString();\n            saveQuestStore();\n            queueMissionChecklistSave();\n            renderQuestDetail(quest.day);\n            renderQuestList();\n        });\n    }\n    for (const button of questDetailRoot.querySelectorAll('[data-self-level]')) {\n        button.addEventListener('click',()=>{\n            questStore.selfVerification[String(quest.day)]=button.dataset.selfLevel||'NOT_YET';\n            questStore.selfCheckUpdatedAt=new Date().toISOString();\n            saveQuestStore();\n            queueLeadershipSelfCheckSave();\n            renderQuestDetail(quest.day);\n            renderQuestList();\n        });\n    }\n    evidenceArea?.addEventListener('input', syncEvidenceButton);\n    evidenceSave?.addEventListener('click', () => {\n        const value = String(evidenceArea?.value ?? '').trim();\n        if (value) questStore.evidence[String(quest.day)] = value; else delete questStore.evidence[String(quest.day)];\n        saveQuestStore();\n        if (evidenceState) evidenceState.textContent = currentHasEvidence() ? `Evidence 저장됨 · ${artifactRefsForDay(quest.day).length} Artifact 연결` : '메모 또는 실제 Artifact를 연결하면 Quest 완료가 활성화됩니다.';\n        syncEvidenceButton();\n        renderQuestList();\n        renderSetupChecklist();\n    });\n    questDetailRoot.querySelector('[data-quest-artifact-link]')?.addEventListener('click', () => {\n        const select=questDetailRoot.querySelector('[data-quest-artifact-select]');\n        const id=select?.value;\n        if(!id) return;\n        linkArtifactToQuest(quest.day,id);\n        renderQuestDetail(quest.day);\n        renderQuestList();\n        renderSetupChecklist();\n    });\n    for (const button of questDetailRoot.querySelectorAll('[data-evidence-unlink]')) button.addEventListener('click',()=>{\n        unlinkArtifactFromQuest(quest.day,button.dataset.evidenceUnlink);\n        renderQuestDetail(quest.day);\n        renderQuestList();\n        renderSetupChecklist();\n    });\n    questDetailRoot.querySelector('[data-open-leader-coach]')?.addEventListener('click',()=>navigation.goTo('LEADER_COACH'));\n    questDetailRoot.querySelector('[data-open-artifact]')?.addEventListener('click',(event)=>{\n        const type=event.currentTarget.dataset.openArtifact;\n        if (type && artifactDefinitions[type]) { questStore.artifactTab=type; saveQuestStore(); renderArtifactWorkspace(); document.querySelector('[data-artifact-tabs]')?.scrollIntoView({behavior:'smooth',block:'center'}); }\n    });\n    completeButton?.addEventListener('click', () => {\n        const set = new Set(questStore.completed);\n        if (set.has(quest.day)) set.delete(quest.day); else if (currentHasEvidence() && currentMissionComplete() && currentSelfVerified()) set.add(quest.day); else return;\n        questStore.completed = [...set].sort((a,b) => a-b);\n        questStore.questProgressUpdatedAt = new Date().toISOString();\n        saveQuestStore();\n        queueQuestProgressServerSave();\n        renderQuestProgress();\n        renderQuestList();\n        renderSetupChecklist();\n        renderQuestDetail(quest.day);\n        renderTodayLeaderNudge();\n    });\n    questDetailRoot.querySelector('[data-quest-route]')?.addEventListener('click', (event) => {\n        const route = event.currentTarget.dataset.route;\n        if (route) navigation.goTo(route);\n    });\n    for (const area of questDetailRoot.querySelectorAll('[data-quest-note]')) {\n        area.addEventListener('input', () => {\n            const labels = Array.from(questDetailRoot.querySelectorAll('.quest-reflection-questions label'));\n            const noteMap = {};\n            labels.forEach((label) => {\n                const question = label.firstChild?.textContent?.trim() || '';\n                const textArea = label.querySelector('textarea');\n                if (question && textArea) noteMap[question] = textArea.value;\n            });\n            questStore.notes[String(quest.day)] = noteMap;\n            saveQuestStore();\n        });\n    }\n    for (const card of questListRoot.querySelectorAll('[data-quest-day]')) {\n        card.classList.toggle('selected', Number(card.dataset.questDay) === quest.day);\n    }\n};\nconst renderQuestList = () => {\n    const phase = questStore.phase || 'ALL';\n    const items = LEADERSHIP_QUESTS.filter((quest) => phase === 'ALL' || quest.phase === phase);\n    questListRoot.innerHTML = items.map((quest) => {\n        const done = questStore.completed.includes(quest.day);\n        const hasEvidence = Boolean(String(questStore.evidence[String(quest.day)] ?? '').trim()) || artifactRefsForDay(quest.day).length > 0;\n        const mission=missionForDay(quest.day);\n        const missionProgress=missionCheckProgress(quest.day);\n        const pillar=LEADERSHIP_MISSION_PILLARS[mission.pillar]||{short:mission.pillar};\n        return `<button type=\"button\" class=\"quest-row ${done ? 'done' : ''} ${hasEvidence ? 'evidence' : ''} ${missionProgress.complete?'mission-ready':''} ${quest.day === questStore.selectedDay ? 'selected' : ''}\" data-quest-day=\"${quest.day}\">\n            <span class=\"quest-day\">${String(quest.day).padStart(2,'0')}</span>\n            <span class=\"quest-row-copy\"><strong>${escapeHtml(mission.title)}</strong><small>${escapeHtml(pillar.short)} · Checklist ${missionProgress.done}/${missionProgress.total} · ${escapeHtml(quest.artifact)}</small></span>\n            <span class=\"quest-status\">${done ? '✓' : missionProgress.complete&&hasEvidence ? '◎' : `${missionProgress.done}/${missionProgress.total}`}</span>\n        </button>`;\n    }).join('');\n    for (const button of questListRoot.querySelectorAll('[data-quest-day]')) {\n        button.addEventListener('click', () => renderQuestDetail(Number(button.dataset.questDay)));\n    }\n};\nconst phaseButtons = [{ id: 'ALL', label: 'All 30' }, ...Object.entries(LEADERSHIP_QUEST_PHASES).map(([id, value]) => ({ id, label: `${id} · ${value.days}` }))];\nquestPhaseFilters.innerHTML = phaseButtons.map((item) => `<button type=\"button\" class=\"${questStore.phase === item.id ? 'active' : ''}\" data-quest-phase=\"${item.id}\">${escapeHtml(item.label)}</button>`).join('');\nfor (const button of questPhaseFilters.querySelectorAll('[data-quest-phase]')) {\n    button.addEventListener('click', () => {\n        questStore.phase = button.dataset.questPhase || 'ALL';\n        saveQuestStore();\n        for (const el of questPhaseFilters.querySelectorAll('button')) el.classList.toggle('active', el === button);\n        renderQuestList();\n        const first = LEADERSHIP_QUESTS.find((quest) => questStore.phase === 'ALL' || quest.phase === questStore.phase);\n        if (first) renderQuestDetail(first.day);\n    });\n}\n\nObject.defineProperty(window,'LeaderOsMissionBridge',{\n    value:{\n        snapshot:()=>JSON.parse(JSON.stringify(missionSummarySnapshot())),\n        day:(day)=>JSON.parse(JSON.stringify(missionSummarySnapshot().days.find((item)=>item.day===Number(day))||null)),\n        hydrate:()=>Promise.all([hydrateMissionChecklistFromServer(true),hydrateLeadershipSelfCheckFromServer(true)])\n    },\n    enumerable:false,configurable:true\n});\n\n// Recovery 15 · Integration & Reliability\nconst dependencyMapRoot=document.querySelector('[data-operating-dependency-map]');\nconst systemHealthRoot=document.querySelector('[data-system-health]');\nconst r15HealthBadge=document.querySelector('[data-r15-health-badge]');\nconst evidenceInspectorRoot=document.querySelector('[data-evidence-inspector]');\nconst graduationReviewRoot=document.querySelector('[data-graduation-review]');\nconst next60TrackerRoot=document.querySelector('[data-next60-tracker]');\nconst next60OutcomeInput=document.querySelector('[data-next60-outcome]');\nconst next60StatusInput=document.querySelector('[data-next60-status]');\nconst next60EvidenceInput=document.querySelector('[data-next60-evidence]');\nconst next60LearningInput=document.querySelector('[data-next60-learning]');\nconst next60NextInput=document.querySelector('[data-next60-next]');\nconst next60CheckinSave=document.querySelector('[data-next60-checkin-save]');\nconst managerBriefRoot=document.querySelector('[data-manager-brief]');\nconst managerBriefCopy=document.querySelector('[data-manager-brief-copy]');\nconst managerBriefSave=document.querySelector('[data-manager-brief-save]');\n\nconst artifactTypeForId=(id)=>{ const found=allArtifactRecords().find((row)=>row.id===id); return found?.artifactType||null; };\nconst relationIntegrityIssues=()=>{\n    const issues=[];\n    for(const pair of RELATION_PAIRS){\n        for(const source of artifactRows(pair.aType)){\n            for(const targetId of refArray(source[pair.aField])){\n                const target=artifactRows(pair.bType).find((row)=>row.id===targetId);\n                if(!target){ issues.push({level:'critical',type:pair.aType,id:source.id,title:'끊어진 관계',copy:`${artifactPrimary(pair.aType,source)} → ${pair.bType} 참조가 존재하지 않습니다.`}); continue; }\n                const reciprocal=refArray(target[pair.bField]);\n                if(!reciprocal.includes(source.id)) issues.push({level:'warn',type:pair.aType,id:source.id,title:'비대칭 관계',copy:`${artifactPrimary(pair.aType,source)} ↔ ${artifactPrimary(pair.bType,target)}의 양방향 링크가 일치하지 않습니다.`});\n                if(String(source.artifactState||'DRAFT')==='CONFIRMED' && String(target.artifactState||'DRAFT')!=='CONFIRMED') issues.push({level:'warn',type:pair.aType,id:source.id,title:'Confirmed → Draft 의존성',copy:`Confirmed ${artifactDefinitions[pair.aType]?.label||pair.aType}가 Draft ${artifactDefinitions[pair.bType]?.label||pair.bType}를 참조합니다.`});\n            }\n        }\n    }\n    for(const [day,refs] of Object.entries(questStore.evidenceRefs||{})) for(const id of Array.isArray(refs)?refs:[]) if(!artifactRecordById(id)) issues.push({level:'warn',type:'QUEST',id:String(day),title:'Quest Evidence 참조 끊김',copy:`Day ${day}의 Evidence ${id}가 삭제되었거나 찾을 수 없습니다.`});\n    return issues;\n};\nconst openArtifactType=(type,id=null)=>{\n    if(!artifactDefinitions[type]) return;\n    questStore.artifactTab=type; saveQuestStore();\n    if(id) editingArtifactId=id;\n    renderArtifactWorkspace();\n    document.querySelector('[data-artifact-tabs]')?.scrollIntoView({behavior:'smooth',block:'center'});\n};\nconst dependencyFilterProject=document.querySelector('[data-r16-filter-project]');\nconst dependencyFilterOwner=document.querySelector('[data-r16-filter-owner]');\nconst dependencyFilterAttention=document.querySelector('[data-r16-filter-attention]');\nlet dependencyFilterState={project:'ALL',owner:'ALL',attention:'ALL'};\nconst workAttention=(w)=>{\n    if(String(w.status||'').toUpperCase()==='AT_RISK'||!String(w.owner||'').trim()||!refArray(w.milestoneRefs).length||!refArray(w.decisionRefs).length) return 'CRITICAL';\n    if(String(w.artifactState||'DRAFT').toUpperCase()!=='CONFIRMED'||refArray(w.milestoneRefs).some((id)=>String(artifactRecordById(id)?.artifactState||'DRAFT')!=='CONFIRMED')||refArray(w.decisionRefs).some((id)=>String(artifactRecordById(id)?.artifactState||'DRAFT')!=='CONFIRMED')) return 'CHECK';\n    return 'CLEAR';\n};\nconst renderDependencyFilterOptions=()=>{\n    if(!dependencyFilterProject||!dependencyFilterOwner||!dependencyFilterAttention) return;\n    const works=artifactRows('WORK_MAP');\n    const projects=[...new Set(works.map((r)=>String(r.project||'').trim()).filter(Boolean))].sort();\n    const owners=[...new Set(works.map((r)=>String(r.owner||'').trim()).filter(Boolean))].sort();\n    const option=(value,label,current)=>`<option value=\"${escapeHtml(value)}\" ${current===value?'selected':''}>${escapeHtml(label)}</option>`;\n    dependencyFilterProject.innerHTML=option('ALL','All projects',dependencyFilterState.project)+projects.map((x)=>option(x,x,dependencyFilterState.project)).join('');\n    dependencyFilterOwner.innerHTML=option('ALL','All owners',dependencyFilterState.owner)+owners.map((x)=>option(x,x,dependencyFilterState.owner)).join('');\n    dependencyFilterAttention.value=dependencyFilterState.attention;\n};\nconst dependencyCluster=(type,ids,label)=>{\n    const refs=refArray(ids);\n    return `<div class=\"dependency-cluster\"><small>${escapeHtml(label)} · ${refs.length}</small>${refs.length?refs.map((id)=>{const item=artifactRecordById(id);const state=item?String(item.artifactState||'DRAFT').toLowerCase():'missing';return item?`<button type=\"button\" class=\"dependency-node ${state==='confirmed'?'confirmed':''}\" data-r15-open-type=\"${type}\" data-r15-open-id=\"${escapeHtml(id)}\"><b>${escapeHtml(artifactPrimary(type,item))}</b></button>`:`<div class=\"dependency-node missing\"><b>Missing ${escapeHtml(id)}</b></div>`;}).join(''):'<div class=\"dependency-node missing\"><b>연결 필요</b></div>'}</div>`;\n};\nconst renderDependencyMap=()=>{\n    if(!dependencyMapRoot) return;\n    renderDependencyFilterOptions();\n    let work=artifactRows('WORK_MAP');\n    work=work.filter((w)=>(dependencyFilterState.project==='ALL'||String(w.project||'')===dependencyFilterState.project)&&(dependencyFilterState.owner==='ALL'||String(w.owner||'')===dependencyFilterState.owner)&&(dependencyFilterState.attention==='ALL'||workAttention(w)===dependencyFilterState.attention));\n    if(!work.length){ dependencyMapRoot.innerHTML='<div class=\"safe\">현재 필터에 해당하는 Work가 없습니다. 필터를 조정하거나 Work Map을 먼저 만드세요.</div>'; return; }\n    dependencyMapRoot.innerHTML=work.map((w)=>{const attention=workAttention(w);const calendars=refArray(w.calendarRefs);return `<div class=\"dependency-lane\"><div class=\"dependency-lane-head\"><div><strong>${escapeHtml(artifactPrimary('WORK_MAP',w))}</strong><div class=\"relation-chip-set\">${calendars.map((id)=>{const c=artifactRecordById(id);return c?`<span>CAL ${escapeHtml(c.day||'')} ${escapeHtml(c.time||'')} · ${escapeHtml(c.title||'')}</span>`:''}).join('')}</div></div><div><span class=\"r16-attention ${attention.toLowerCase()}\">${attention}</span> <span class=\"artifact-version ${String(w.artifactState||'').toLowerCase()==='confirmed'?'confirmed':''}\">v${escapeHtml(w.version||1)} · ${escapeHtml(w.artifactState||'DRAFT')}</span></div></div><div class=\"dependency-flow r16-flow\">${dependencyCluster('WORK_MAP',[w.id],'WORK')}${dependencyCluster('MILESTONES',w.milestoneRefs,'MILESTONES')}${dependencyCluster('DECISION_RIGHTS',w.decisionRefs,'DECISIONS')}${dependencyCluster('DELEGATION',w.delegationRefs,'DELEGATION')}${dependencyCluster('DEBRIEF',w.debriefRefs,'DEBRIEF')}</div></div>`;}).join('');\n    for(const button of dependencyMapRoot.querySelectorAll('[data-r15-open-type]')) button.addEventListener('click',()=>openArtifactType(button.dataset.r15OpenType,button.dataset.r15OpenId));\n};\nfor(const [input,key] of [[dependencyFilterProject,'project'],[dependencyFilterOwner,'owner'],[dependencyFilterAttention,'attention']]) input?.addEventListener('change',()=>{dependencyFilterState[key]=input.value||'ALL';renderDependencyMap();});\nconst renderSystemHealth=()=>{\n    if(!systemHealthRoot) return;\n    const issues=[...relationIntegrityIssues()];\n    const diagnostics=artifactDiagnostics().filter((d)=>d.level!=='good').map((d)=>({level:d.level==='critical'?'critical':'warn',title:d.title,copy:d.copy,type:null,id:null}));\n    const combined=[...issues,...diagnostics];\n    if(!combined.length){ combined.push({level:'good',title:'운영 객체와 링크의 기본 무결성이 확인됐습니다.',copy:'현재 로컬 Preview 기준으로 끊어진 참조와 핵심 필드 오류가 없습니다.'}); }\n    systemHealthRoot.innerHTML=combined.slice(0,8).map((item)=>`<div class=\"health-item ${escapeHtml(item.level)}\"><span class=\"health-icon\">${item.level==='critical'?'!':item.level==='warn'?'?':'✓'}</span><div><strong>${escapeHtml(item.title)}</strong><p>${escapeHtml(item.copy)}</p></div>${item.type&&artifactDefinitions[item.type]?`<button type=\"button\" data-health-open-type=\"${escapeHtml(item.type)}\" data-health-open-id=\"${escapeHtml(item.id||'')}\">열기</button>`:'<span></span>'}</div>`).join('');\n    const critical=combined.filter((x)=>x.level==='critical').length; const warn=combined.filter((x)=>x.level==='warn').length;\n    if(r15HealthBadge){ r15HealthBadge.textContent=critical?`CRITICAL ${critical}`:warn?`CHECK ${warn}`:'INTEGRATION PASS'; r15HealthBadge.classList.toggle('confirmed',!critical&&!warn); }\n    const badge=document.querySelector('[data-contract-status]'); if(badge) badge.textContent=critical?`Integration ${critical} critical`:warn?`Integration ${warn} checks`:'Core + Integration PASS';\n    for(const button of systemHealthRoot.querySelectorAll('[data-health-open-type]')) button.addEventListener('click',()=>openArtifactType(button.dataset.healthOpenType,button.dataset.healthOpenId));\n};\nconst parseSupportVersions=(charter)=>{ try{return JSON.parse(charter?.supportVersions||'{}')||{};}catch{return {};} };\nconst charterEvidenceRows=()=>{\n    const charter=latestArtifact('TEAM_OS_CHARTER',true)||latestArtifact('TEAM_OS_CHARTER'); if(!charter) return {charter:null,rows:[]};\n    let refs=String(charter.supportRefs||'').split(',').map((x)=>x.trim()).filter(Boolean);\n    let versions=parseSupportVersions(charter);\n    if(!refs.length){ const draft=buildTeamOsCharterDraft(); refs=String(draft.supportRefs||'').split(',').filter(Boolean); versions=parseSupportVersions(draft); }\n    return {charter,rows:refs.map((id)=>{const item=artifactRecordById(id); const savedVersion=Number(versions[id]||0); return {id,item,savedVersion,missing:!item,stale:Boolean(item&&savedVersion&&Number(item.version)!==savedVersion),draft:Boolean(item&&String(item.artifactState||'DRAFT')!=='CONFIRMED')};})};\n};\nconst renderEvidenceInspector=()=>{\n    if(!evidenceInspectorRoot) return;\n    const {charter,rows}=charterEvidenceRows();\n    if(!charter){ evidenceInspectorRoot.innerHTML='<div class=\"safe\">Team OS Charter를 저장하면 근거 Artifact와 Version을 역추적할 수 있습니다.</div>'; return; }\n    const bad=rows.filter((r)=>r.missing||r.stale||r.draft).length;\n    evidenceInspectorRoot.innerHTML=`<div class=\"evidence-summary\"><span class=\"state-badge ${bad?'':'confirmed'}\">${bad?`REVIEW ${bad}`:'EVIDENCE CURRENT'}</span><span class=\"review-meta\">Charter v${escapeHtml(charter.version||1)} · ${escapeHtml(charter.artifactState||'DRAFT')} · ${rows.length} sources</span></div>${rows.length?rows.map((r)=>{const type=r.item?.artifactType||artifactTypeForId(r.id)||'ARTIFACT'; const cls=r.missing?'bad':r.stale||r.draft?'warn':'ok'; const state=r.missing?'MISSING':r.stale?`STALE v${r.savedVersion}→v${r.item.version}`:r.draft?'DRAFT':'CURRENT'; return `<div class=\"evidence-row\"><div><strong>${escapeHtml(r.item?artifactPrimary(type,r.item):r.id)}</strong><small>${escapeHtml(type.replaceAll('_',' '))} · saved v${escapeHtml(r.savedVersion||'—')} · current ${escapeHtml(r.item?.version||'—')}</small></div><span class=\"evidence-state ${cls}\">${escapeHtml(state)}</span></div>`;}).join(''):'<div class=\"safe\">이전 Charter에는 Support Snapshot이 없습니다. 새 Charter Snapshot을 저장하면 Version 추적이 활성화됩니다.</div>'}`;\n};\nconst graduationSnapshot=()=>{\n    const required=['MANAGER_CONTRACT','TEAM_MAP','TEAM_CALENDAR','WORK_MAP','MILESTONES','PRIORITY_CONTRACT','DECISION_RIGHTS','DELEGATION','DEBRIEF'];\n    const confirmed=required.filter((t)=>confirmedArtifactRows(t).length).length;\n    const draft=required.filter((t)=>artifactRows(t).length && !confirmedArtifactRows(t).length).length;\n    const missing=required.filter((t)=>!artifactRows(t).length).length;\n    const unknown=artifactRows('TEAM_MAP').filter((r)=>String(r.state||'').toUpperCase()==='UNKNOWN').length + artifactRows('STAKEHOLDER_MAP').filter((r)=>String(r.influence||'').toUpperCase()==='UNKNOWN').length;\n    const progress=questProgressSummary(questStore.completed);\n    const charter=latestArtifact('TEAM_OS_CHARTER',true);\n    const critical=relationIntegrityIssues().filter((x)=>x.level==='critical').length;\n    return {required,confirmed,draft,missing,unknown,progress,charter,critical,ready:progress.done>=30&&Boolean(charter)&&critical===0};\n};\nconst renderGraduationReview=()=>{\n    if(!graduationReviewRoot) return;\n    const g=graduationSnapshot();\n    graduationReviewRoot.innerHTML=`<div class=\"section-kicker\">DAY 30 · GRADUATION REVIEW</div><h3 style=\"margin:6px 0 4px\">완료가 아니라 운영 준비도를 확인합니다</h3><p class=\"why\">사람의 리더십 점수가 아니라 Quest·Artifact·근거 연결의 상태입니다.</p><div class=\"graduation-grid\"><div class=\"graduation-card\"><small>QUEST</small><strong>${g.progress.done}/30</strong></div><div class=\"graduation-card\"><small>CONFIRMED AREAS</small><strong>${g.confirmed}/${g.required.length}</strong></div><div class=\"graduation-card\"><small>DRAFT / MISSING</small><strong>${g.draft} / ${g.missing}</strong></div><div class=\"graduation-card\"><small>TRACKED UNKNOWN</small><strong>${g.unknown}</strong></div></div><div class=\"graduation-gate ${g.ready?'ready':''}\"><div><strong>${g.ready?'NEXT 60 전환 조건 충족':'아직 확인할 운영 조건이 있습니다'}</strong><div class=\"review-meta\">${g.charter?'Confirmed Charter 있음':'Confirmed Charter 필요'} · Critical link issue ${g.critical}</div></div><span class=\"state-badge ${g.ready?'confirmed':''}\">${g.ready?'READY':'REVIEW'}</span></div>`;\n};\nconst latestNext60Plan=()=>latestArtifact('NEXT_60_PLAN',true)||latestArtifact('NEXT_60_PLAN');\nconst renderNext60Tracker=()=>{\n    if(!next60TrackerRoot) return;\n    const plan=latestNext60Plan(); const checks=artifactRows('NEXT_60_CHECKIN').filter((r)=>!plan||!r.planRef||r.planRef===plan.id);\n    if(!plan){ next60TrackerRoot.innerHTML='<div class=\"safe\">Next 60 Plan을 먼저 저장하세요. Outcome이 생성되면 주간 Check-in이 활성화됩니다.</div>'; if(next60CheckinSave) next60CheckinSave.disabled=true; return; }\n    if(next60CheckinSave) next60CheckinSave.disabled=false;\n    next60TrackerRoot.innerHTML=['outcome1','outcome2','outcome3'].map((key,index)=>{const latest=[...checks].reverse().find((r)=>r.outcomeKey===key);return `<div class=\"outcome-card\"><small>OUTCOME ${index+1}</small><strong>${escapeHtml(plan[key]||'미입력')}</strong><div class=\"checkin-meta\">${latest?`${escapeHtml(latest.status||'CHECK')} · ${escapeHtml(latest.week||'')} · ${escapeHtml(latest.evidence||'근거 없음')}`:'아직 Weekly Check-in 없음'}</div></div>`;}).join('');\n};\nnext60CheckinSave?.addEventListener('click',()=>{\n    const plan=latestNext60Plan(); if(!plan) return;\n    const outcomeKey=next60OutcomeInput?.value||'outcome1'; const record={week:currentWeekLabel(),outcomeKey,status:next60StatusInput?.value||'ON_TRACK',evidence:String(next60EvidenceInput?.value||'').trim(),learning:String(next60LearningInput?.value||'').trim(),next:String(next60NextInput?.value||'').trim(),planRef:plan.id,outcomeText:plan[outcomeKey]||''};\n    if(!record.evidence && !record.learning && !record.next) return;\n    addArtifactRecord('NEXT_60_CHECKIN',record);\n    if(next60EvidenceInput) next60EvidenceInput.value=''; if(next60LearningInput) next60LearningInput.value=''; if(next60NextInput) next60NextInput.value='';\n});\nconst confirmedOrLatest=(type)=>latestArtifact(type,true)||latestArtifact(type);\nconst r17Next60SummaryForBrief=()=>{\n    const plan=latestNext60Plan();\n    if(!plan) return 'Next 60 Plan 미설정';\n    const checks=artifactRows('NEXT_60_CHECKIN').filter((r)=>!r.planRef||r.planRef===plan.id).sort((a,b)=>String(a.updatedAt||a.week||'').localeCompare(String(b.updatedAt||b.week||'')));\n    return ['outcome1','outcome2','outcome3'].map((key,index)=>{const series=checks.filter((r)=>r.outcomeKey===key);const latest=series[series.length-1];return `O${index+1} ${latest?.status||'NO_CHECKIN'}${latest?.next?` → ${latest.next}`:''}`;}).join(' / ');\n};\nconst buildManagerBriefDraft=()=>{\n    const manager=confirmedOrLatest('MANAGER_CONTRACT'); const priority=confirmedOrLatest('PRIORITY_CONTRACT'); const weekly=confirmedOrLatest('WEEKLY_REVIEW'); const debrief=confirmedOrLatest('DEBRIEF');\n    const works=confirmedArtifactRows('WORK_MAP').length?confirmedArtifactRows('WORK_MAP'):artifactRows('WORK_MAP'); const decisions=confirmedArtifactRows('DECISION_RIGHTS').length?confirmedArtifactRows('DECISION_RIGHTS'):artifactRows('DECISION_RIGHTS');\n    const riskWork=works.filter((r)=>String(r.status||'').toUpperCase()==='AT_RISK'||String(r.risk||'').trim());\n    const openDecisions=decisions.filter((r)=>!['DECIDED','CANCELLED'].includes(String(r.decisionStatus||'OPEN').toUpperCase())||!String(r.decide||'').trim());\n    const next60Plan=latestNext60Plan(); const next60Checks=artifactRows('NEXT_60_CHECKIN').filter((r)=>!next60Plan||!r.planRef||r.planRef===next60Plan.id).slice(-3);\n    const sources=[manager,priority,weekly,debrief,...works.slice(0,3),...decisions.slice(0,3),next60Plan,...next60Checks].filter(Boolean); const sourceRefs=[...new Set(sources.map((r)=>r.id).filter(Boolean))];\n    return {week:currentWeekLabel(),executiveSummary:priority?.priority1||weekly?.attention||'이번 주 Top Priority를 확인하세요.',progress:works.slice(0,3).map((r)=>`${r.project||'Work'}: ${r.nextMilestone||r.status||'진행 중'}`).join(' / ')||'Work Map 확인 필요',decisionsNeeded:openDecisions.slice(0,3).map((r)=>`${r.decision||'Decision'} · D ${r.decide||'미정'}`).join(' / ')||'현재 명시된 결정 이슈 없음',risks:riskWork.slice(0,3).map((r)=>`${r.project||'Work'}: ${r.risk||r.status}`).join(' / ')||manager?.escalation||'특이 리스크 없음',next:weekly?.next||debrief?.next||priority?.priority2||'다음 Weekly Review에서 확인',reportRhythm:manager?.reportRhythm||'보고 리듬 미설정',next60Trend:r17Next60SummaryForBrief(),sourceRefs:sourceRefs.join(','),sourceVersions:JSON.stringify(Object.fromEntries(sources.filter((r)=>r.id).map((r)=>[r.id,Number(r.version)||1])))};\n};\nconst managerBriefText=(b)=>`[${b.week}] LEADER OPERATING BRIEF\\n\\nSTATUS\\n${b.executiveSummary}\\n\\nPROGRESS\\n${b.progress}\\n\\nDECISIONS NEEDED\\n${b.decisionsNeeded}\\n\\nRISKS / ESCALATION\\n${b.risks}\\n\\nNEXT\\n${b.next}\\n\\nREPORTING RHYTHM\\n${b.reportRhythm}\\n\\nNEXT 60 TREND\\n${b.next60Trend||'Next 60 check-in 없음'}`;\nconst renderManagerBrief=()=>{\n    if(!managerBriefRoot) return; const draft=buildManagerBriefDraft(); const text=managerBriefText(draft); managerBriefRoot.textContent=text;\n    if(reportOperatingRoot){ let block=reportOperatingRoot.querySelector('[data-r15-report-brief]'); if(!block){block=document.createElement('div');block.dataset.r15ReportBrief='';block.className='r15-inline-report';reportOperatingRoot.append(block);} block.innerHTML=`<span class=\"section-kicker\">LATEST MANAGER BRIEF</span><strong>${escapeHtml(draft.executiveSummary)}</strong><p>${escapeHtml(draft.risks)} · Next: ${escapeHtml(draft.next)}</p>`; }\n};\nmanagerBriefCopy?.addEventListener('click',async()=>{const text=managerBriefRoot?.textContent||''; try{await navigator.clipboard.writeText(text);navigation.announce('Manager Reporting Brief를 복사했습니다.');}catch{navigation.announce('복사 권한을 확인하세요.');}});\nmanagerBriefSave?.addEventListener('click',()=>{addArtifactRecord('REPORT_BRIEF',buildManagerBriefDraft());});\nconst weeklyReviewDiffRoot=document.querySelector('[data-weekly-review-diff]');\nconst next60TrendRoot=document.querySelector('[data-next60-trend]');\nconst commitmentPersonInput=document.querySelector('[data-r16-commitment-person]');\nconst commitmentDueInput=document.querySelector('[data-r16-commitment-due]');\nconst commitmentTextInput=document.querySelector('[data-r16-commitment-text]');\nconst commitmentDelegationInput=document.querySelector('[data-r16-commitment-delegation]');\nconst commitmentDebriefInput=document.querySelector('[data-r16-commitment-debrief]');\nconst commitmentSaveButton=document.querySelector('[data-r16-commitment-save]');\nconst commitmentListRoot=document.querySelector('[data-r16-commitment-list]');\nconst renderWeeklyReviewDiff=()=>{\n    if(!weeklyReviewDiffRoot) return;\n    const rows=[...artifactRows('WEEKLY_REVIEW')].sort((a,b)=>String(a.updatedAt||'').localeCompare(String(b.updatedAt||'')));\n    if(rows.length<2){weeklyReviewDiffRoot.innerHTML='<div class=\"safe\">Weekly Review Snapshot이 2개 이상 쌓이면 지난 주 대비 변화가 나타납니다.</div>';return;}\n    const prev=rows[rows.length-2],curr=rows[rows.length-1];\n    const fields=[['attention','Attention'],['decisions','Decisions'],['delegation','Delegation'],['learning','Learning'],['next','Next']];\n    weeklyReviewDiffRoot.innerHTML=`<div class=\"review-meta\" style=\"margin:6px 0 10px\">${escapeHtml(prev.week||'Previous')} → ${escapeHtml(curr.week||'Current')}</div><div class=\"r16-diff-grid\">${fields.map(([key,label])=>{const changed=String(prev[key]||'')!==String(curr[key]||'');return `<div class=\"r16-diff-card ${changed?'changed':'same'}\"><small>${escapeHtml(label)} · ${changed?'CHANGED':'SAME'}</small><strong>${escapeHtml(curr[key]||'—')}</strong>${changed?`<div class=\"review-meta\" style=\"margin-top:7px\">Before: ${escapeHtml(prev[key]||'—')}</div>`:''}</div>`;}).join('')}</div>`;\n};\nconst renderNext60Trend=()=>{\n    if(!next60TrendRoot) return;\n    const plan=latestNext60Plan(); if(!plan){next60TrendRoot.innerHTML='<div class=\"safe\">Next 60 Plan을 저장하면 Outcome별 주간 상태 추세가 나타납니다.</div>';return;}\n    const checks=artifactRows('NEXT_60_CHECKIN').filter((r)=>!r.planRef||r.planRef===plan.id).sort((a,b)=>String(a.updatedAt||a.week||'').localeCompare(String(b.updatedAt||b.week||'')));\n    next60TrendRoot.innerHTML=`<div class=\"r16-trend-grid\">${['outcome1','outcome2','outcome3'].map((key,index)=>{const series=checks.filter((r)=>r.outcomeKey===key);const latest=series[series.length-1];return `<div class=\"r16-trend-card\"><small class=\"section-kicker\">OUTCOME ${index+1}</small><strong>${escapeHtml(plan[key]||'미입력')}</strong><div class=\"r16-trend-line\">${series.length?series.map((r)=>`<span class=\"r16-status-point ${String(r.status||'').toLowerCase()}\">${escapeHtml(r.week||'W')} · ${escapeHtml(r.status||'CHECK')}</span>`).join(''):'<span class=\"review-meta\">아직 Check-in 없음</span>'}</div>${latest?`<p class=\"review-meta\">Latest evidence · ${escapeHtml(latest.evidence||'—')}<br>Next · ${escapeHtml(latest.next||'—')}</p>`:''}</div>`;}).join('')}</div>`;\n};\nconst renderCommitmentBridge=()=>{\n    if(!commitmentListRoot) return;\n    if(commitmentDelegationInput){const selected=[...commitmentDelegationInput.selectedOptions].map((o)=>o.value);commitmentDelegationInput.innerHTML=relationOptionHtml('DELEGATION',selected);}\n    if(commitmentDebriefInput){const selected=[...commitmentDebriefInput.selectedOptions].map((o)=>o.value);commitmentDebriefInput.innerHTML=relationOptionHtml('DEBRIEF',selected);}\n    const rows=artifactRows('ONE_ON_ONE_COMMITMENT');\n    commitmentListRoot.innerHTML=rows.length?rows.slice().reverse().map((r)=>`<div class=\"commitment-bridge-item\"><div><strong>${escapeHtml(r.person||'Person')} · ${escapeHtml(r.commitment||'Commitment')}</strong><p>Due ${escapeHtml(r.due||'—')} · ${escapeHtml(r.status||'OPEN')} · Evidence ${escapeHtml(r.evidence||'미정')}</p>${relationSummaryHtml(r)}</div><button type=\"button\" data-r16-commitment-open=\"${escapeHtml(r.id)}\">열기</button></div>`).join(''):'<div class=\"safe\">아직 운영 Commitment가 없습니다. 1:1에서 합의한 후속 행동을 연결해보세요.</div>';\n    for(const b of commitmentListRoot.querySelectorAll('[data-r16-commitment-open]')) b.addEventListener('click',()=>openArtifactType('ONE_ON_ONE_COMMITMENT',b.dataset.r16CommitmentOpen));\n};\ncommitmentSaveButton?.addEventListener('click',()=>{\n    const commitment=String(commitmentTextInput?.value||'').trim(); if(!commitment) return;\n    addArtifactRecord('ONE_ON_ONE_COMMITMENT',{person:String(commitmentPersonInput?.value||'').trim(),commitment,due:String(commitmentDueInput?.value||'').trim(),evidence:'1:1에서 사람 확인 후 저장',status:'OPEN',delegationRefs:commitmentDelegationInput?[...commitmentDelegationInput.selectedOptions].map((o)=>o.value):[],debriefRefs:commitmentDebriefInput?[...commitmentDebriefInput.selectedOptions].map((o)=>o.value):[]});\n    if(commitmentTextInput) commitmentTextInput.value=''; renderCommitmentBridge();\n});\nconst renderRecovery16Surfaces=()=>{renderDependencyMap();renderWeeklyReviewDiff();renderNext60Trend();renderCommitmentBridge();};\nconst renderRecovery15Surfaces=()=>{ renderDependencyMap(); renderSystemHealth(); renderEvidenceInspector(); renderGraduationReview(); renderNext60Tracker(); renderManagerBrief(); renderRecovery16Surfaces(); if(typeof renderRecovery17Surfaces==='function') renderRecovery17Surfaces(); };\n\nconst renderToolkit = () => {\n    toolkitRoot.innerHTML = Object.entries(LEADERSHIP_TOOLKITS).map(([id, item]) => {\n        const rows = item.example.map((row) => `<tr>${row.map((cell) => `<td>${escapeHtml(cell)}</td>`).join('')}</tr>`).join('');\n        return `<details class=\"toolkit-card\"${id === 'TEAM_CALENDAR' ? ' open' : ''}><summary><strong>${escapeHtml(item.name)}</strong><span>${escapeHtml(item.purpose)}</span></summary><div class=\"toolkit-table-wrap\"><table class=\"toolkit-table\"><tbody>${rows}</tbody></table></div></details>`;\n    }).join('');\n};\nconst renderSources = () => {\n    sourceRoot.innerHTML = Object.values(LEADERSHIP_KNOWLEDGE_SOURCES).map((source) => `<article class=\"source-card\">\n        <span class=\"state-badge\">${escapeHtml(source.tier)}</span>\n        <h3>${escapeHtml(source.name)}</h3>\n        <p>${escapeHtml(source.principle)}</p>\n        <a href=\"${escapeHtml(source.url)}\" target=\"_blank\" rel=\"noreferrer\">원문 보기 ↗</a>\n    </article>`).join('');\n};\n\n// Recovery 17 · Time-aware operating graph, follow-up and decision velocity\nconst r17DateOnly=(date)=>new Date(date.getFullYear(),date.getMonth(),date.getDate());\nconst r17ParseDate=(value,timeValue='23:59')=>{\n  const raw=String(value||'').trim(); if(!raw) return null;\n  const iso=raw.match(/^(\\d{4})-(\\d{2})-(\\d{2})(?:[ T](\\d{1,2}):(\\d{2}))?$/);\n  if(iso){const d=new Date(Number(iso[1]),Number(iso[2])-1,Number(iso[3]),Number(iso[4]||String(timeValue).split(':')[0]||23),Number(iso[5]||String(timeValue).split(':')[1]||59));return Number.isNaN(d.getTime())?null:d;}\n  const weekday={MON:1,TUE:2,WED:3,THU:4,FRI:5,SAT:6,SUN:0};\n  const wd=raw.toUpperCase().match(/\\b(MON|TUE|WED|THU|FRI|SAT|SUN)\\b/); const tm=raw.match(/(\\d{1,2}):(\\d{2})/);\n  if(wd){const now=new Date();const target=weekday[wd[1]];const current=now.getDay();const delta=target-current;const d=new Date(now);d.setDate(now.getDate()+delta);d.setHours(Number(tm?.[1]||23),Number(tm?.[2]||59),0,0);return d;}\n  const parsed=new Date(raw); return Number.isNaN(parsed.getTime())?null:parsed;\n};\nconst r17DueMeta=(date)=>{if(!date)return{state:'NONE',label:'No date',hours:null};const diff=(date.getTime()-Date.now())/36e5;if(diff<0)return{state:'OVERDUE',label:`${Math.max(1,Math.ceil(Math.abs(diff)/24))}일 지남`,hours:diff};if(diff<=48)return{state:'DUE_SOON',label:diff<24?'24시간 내':'48시간 내',hours:diff};return{state:'CLEAR',label:date.toLocaleDateString('ko-KR'),hours:diff};};\nconst r17ArtifactDue=(type,row)=>{if(type==='MILESTONES')return r17DueMeta(r17ParseDate(row.date));if(type==='ONE_ON_ONE_COMMITMENT')return r17DueMeta(r17ParseDate(row.due));if(type==='TEAM_CALENDAR')return r17DueMeta(r17ParseDate(row.date,row.time));if(type==='DECISION_RIGHTS')return r17DueMeta(r17ParseDate(row.dueDate));return{state:'NONE',label:'',hours:null};};\nconst r17LeadDays=(row)=>{const start=r17ParseDate(row.requestedAt);if(!start)return null;const end=r17ParseDate(row.decidedAt)||new Date();return Math.max(0,(end-start)/864e5);};\nconst r17LatestReview=()=>[...artifactRows('WEEKLY_REVIEW')].sort((a,b)=>String(a.updatedAt||a.week||'').localeCompare(String(b.updatedAt||b.week||''))).pop()||null;\nconst r17LatestPriority=()=>latestArtifact('PRIORITY_CONTRACT',false);\nlet r17GroupBy='project'; let r17Zoom='detail';\nconst r17EnsureSurface=(page,selector,html,position='beforeend')=>{const root=document.querySelector(`[data-page=\"${page}\"]`);if(!root)return null;let node=root.querySelector(selector);if(!node){root.insertAdjacentHTML(position,html);node=root.querySelector(selector);}return node;};\nconst r17EnsureSurfaces=()=>{\n  r17EnsureSurface('TODAY','[data-r17-followups]',`<section class=\"r17-shell\" data-r17-followups><div class=\"r17-head\"><div><div class=\"section-kicker\">FOLLOW-UP · 1:1 COMMITMENTS</div><h2>오늘 다시 확인해야 할 약속</h2><p>1:1의 전체 대화를 공유하지 않습니다. Human-reviewed Operating Commitment 중 미완료·마감 임박 항목만 Today에 올립니다.</p></div><span class=\"pill\" data-r17-followup-count>0</span></div><div class=\"r17-followups\" data-r17-followup-list></div></section>`);\n  r17EnsureSurface('ONBOARDING','[data-r17-ops]',`<section class=\"r17-shell\" data-r17-ops><div class=\"r17-head\"><div><div class=\"section-kicker\">RECOVERY 17 · TIME & DECISION VELOCITY</div><h2>Operating Graph를 시간과 Follow-up까지 연결합니다</h2><p>Project/Workstream 묶음, Due/Overdue, Decision Lead Time, Commitment Follow-up을 같은 운영 맥락으로 봅니다.</p></div><div class=\"r17-controls\"><label>Group <select data-r17-group><option value=\"project\">Project</option><option value=\"workstream\">Workstream</option><option value=\"none\">None</option></select></label><label>Zoom <select data-r17-zoom><option value=\"detail\">Detail</option><option value=\"summary\">Summary</option></select></label></div></div><div class=\"r17-metrics\" data-r17-metrics></div><div data-r17-grouped-graph></div><div class=\"r17-head\" style=\"margin-top:18px\"><div><div class=\"section-kicker\">DECISION VELOCITY</div><h2>결정이 얼마나 오래 열려 있는지 봅니다</h2><p>리더의 속도를 평가하는 점수가 아니라, 어떤 결정이 업무 흐름을 오래 막는지 확인하는 운영 신호입니다.</p></div></div><div class=\"r17-decision-list\" data-r17-decisions></div><div class=\"r17-head\" style=\"margin-top:18px\"><div><div class=\"section-kicker\">WEEKLY REVIEW → PRIORITY CONTRACT</div><h2>지난 리뷰의 Next를 다음 주 Top 3 후보로 전환합니다</h2><p>자동 확정하지 않습니다. 제안은 DRAFT Priority Contract로만 생성되고 Human Confirm을 거쳐야 합니다.</p></div></div><div data-r17-priority></div></section>`);\n  r17EnsureSurface('REPORTS','[data-r17-report-ext]',`<section class=\"r17-shell\" data-r17-report-ext><div class=\"r17-head\"><div><div class=\"section-kicker\">OPERATING SIGNALS</div><h2>마감·결정속도·Next 60을 함께 보고합니다</h2><p>Manager Brief의 요약 근거를 별도 점수 없이 운영 신호로 표시합니다.</p></div></div><div class=\"r17-metrics\" data-r17-report-metrics></div><div class=\"r17-report-ext\"><strong>Next 60 Trend</strong><p data-r17-report-next60></p></div></section>`);\n  document.querySelector('[data-r17-group]')?.addEventListener('change',(e)=>{r17GroupBy=e.target.value;r17RenderGroupedGraph();});\n  document.querySelector('[data-r17-zoom]')?.addEventListener('change',(e)=>{r17Zoom=e.target.value;r17RenderGroupedGraph();});\n};\nconst r17WorkAttention=(work)=>{const ms=refArray(work.milestoneRefs).map((id)=>artifactRecordById(id)).filter(Boolean);const overdue=ms.some((m)=>r17ArtifactDue('MILESTONES',m).state==='OVERDUE');if(overdue)return'CRITICAL';return workAttention(work);};\nconst r17Metrics=()=>{const calendar=artifactRows('TEAM_CALENDAR').filter((r)=>String(r.date||'').trim());const milestones=artifactRows('MILESTONES');const commitments=artifactRows('ONE_ON_ONE_COMMITMENT').filter((r)=>!['DONE','CANCELLED'].includes(String(r.status||'OPEN').toUpperCase()));const decisions=artifactRows('DECISION_RIGHTS').filter((r)=>!['DECIDED','CANCELLED'].includes(String(r.decisionStatus||'OPEN').toUpperCase()));const timeItems=[...calendar.map((r)=>['TEAM_CALENDAR',r]),...milestones.map((r)=>['MILESTONES',r]),...commitments.map((r)=>['ONE_ON_ONE_COMMITMENT',r]),...decisions.map((r)=>['DECISION_RIGHTS',r])];const overdue=timeItems.filter(([t,r])=>r17ArtifactDue(t,r).state==='OVERDUE').length;const dueSoon=timeItems.filter(([t,r])=>r17ArtifactDue(t,r).state==='DUE_SOON').length;const lead=decisions.map(r17LeadDays).filter((x)=>x!=null);return{overdue,dueSoon,openCommitments:commitments.length,avgLead:lead.length?lead.reduce((a,b)=>a+b,0)/lead.length:0};};\nconst r17RenderMetrics=()=>{const m=r17Metrics();for(const root of document.querySelectorAll('[data-r17-metrics],[data-r17-report-metrics]'))root.innerHTML=`<div class=\"r17-metric\"><small>OVERDUE OPERATING ITEMS</small><strong>${m.overdue}</strong><p>Milestone · Commitment · Decision due</p></div><div class=\"r17-metric\"><small>DUE WITHIN 48H</small><strong>${m.dueSoon}</strong><p>지금 확인하면 지연을 예방할 수 있는 항목</p></div><div class=\"r17-metric\"><small>OPEN 1:1 COMMITMENTS</small><strong>${m.openCommitments}</strong><p>공유된 Operating Commitment만 포함</p></div><div class=\"r17-metric\"><small>AVG OPEN DECISION AGE</small><strong>${m.avgLead.toFixed(1)}d</strong><p>평가 점수가 아닌 흐름 지연 신호</p></div>`;};\nconst r17NodeHtml=(type,row)=>{const due=r17ArtifactDue(type,row);return `<div class=\"r17-node\"><small>${escapeHtml(artifactDefinitions[type]?.label||type)}</small><b>${escapeHtml(artifactPrimary(type,row))}</b>${due.state!=='NONE'?`<p><span class=\"r17-chip ${due.state==='OVERDUE'?'overdue':due.state==='DUE_SOON'?'due-soon':'clear'}\">${due.state} · ${escapeHtml(due.label)}</span></p>`:''}</div>`;};\nconst r17RenderGroupedGraph=()=>{const root=document.querySelector('[data-r17-grouped-graph]');if(!root)return;const works=artifactRows('WORK_MAP');const groups=new Map();for(const w of works){const key=r17GroupBy==='project'?String(w.project||'Unassigned Project'):r17GroupBy==='workstream'?String(w.workstream||'General'):r17GroupBy==='none'?'All Work':'All Work';if(!groups.has(key))groups.set(key,[]);groups.get(key).push(w);}root.innerHTML=[...groups.entries()].map(([key,items])=>`<div class=\"r17-group\"><div class=\"r17-group-title\"><strong>${escapeHtml(key)}</strong><span>${items.length} Work · ${items.filter(w=>r17WorkAttention(w)==='CRITICAL').length} Critical</span></div><div class=\"r17-lanes\">${items.map((w)=>{const attention=r17WorkAttention(w);const all=[...refArray(w.milestoneRefs).map(id=>['MILESTONES',artifactRecordById(id)]),...refArray(w.decisionRefs).map(id=>['DECISION_RIGHTS',artifactRecordById(id)]),...refArray(w.delegationRefs).map(id=>['DELEGATION',artifactRecordById(id)]),...refArray(w.debriefRefs).map(id=>['DEBRIEF',artifactRecordById(id)])].filter(x=>x[1]);return `<details class=\"r17-lane\" ${r17Zoom==='detail'?'open':''}><summary><div><div class=\"r17-lane-title\">${escapeHtml(w.project||'Work')} · ${escapeHtml(w.owner||'Owner 미정')}</div><div class=\"r17-lane-meta\"><span class=\"r17-chip ${attention==='CRITICAL'?'overdue':attention==='CHECK'?'due-soon':'clear'}\">${attention}</span><span class=\"r17-chip\">${escapeHtml(w.workstream||'General')}</span><span class=\"r17-chip\">${all.length} linked</span></div></div><button type=\"button\" data-r17-open-work=\"${escapeHtml(w.id)}\">열기</button></summary>${r17Zoom==='detail'?`<div class=\"r17-detail-grid\">${all.length?all.map(([t,r])=>r17NodeHtml(t,r)).join(''):'<div class=\"r17-node\"><small>RELATION</small><b>연결 필요</b></div>'}</div>`:''}</details>`;}).join('')}</div></div>`).join('')||'<div class=\"safe\">Work Map을 만들면 Project/Workstream 단위 운영 그래프가 나타납니다.</div>';for(const b of root.querySelectorAll('[data-r17-open-work]'))b.addEventListener('click',(e)=>{e.preventDefault();openArtifactType('WORK_MAP',b.dataset.r17OpenWork);});};\nconst r17RenderFollowups=()=>{const root=document.querySelector('[data-r17-followup-list]');const count=document.querySelector('[data-r17-followup-count]');if(!root)return;const rows=artifactRows('ONE_ON_ONE_COMMITMENT').filter((r)=>!['DONE','CANCELLED'].includes(String(r.status||'OPEN').toUpperCase())).sort((a,b)=>(r17ArtifactDue('ONE_ON_ONE_COMMITMENT',a).hours??99999)-(r17ArtifactDue('ONE_ON_ONE_COMMITMENT',b).hours??99999));if(count)count.textContent=String(rows.length);root.innerHTML=rows.length?rows.slice(0,5).map((r)=>{const due=r17ArtifactDue('ONE_ON_ONE_COMMITMENT',r);const cls=due.state==='OVERDUE'?'overdue':String(r.status).toUpperCase()==='BLOCKED'?'blocked':'';return `<div class=\"r17-followup ${cls}\"><div><strong>${escapeHtml(r.person||'Person')} · ${escapeHtml(r.commitment||'Commitment')}</strong><p>${escapeHtml(r.status||'OPEN')} · Due ${escapeHtml(r.due||'미정')} · ${escapeHtml(due.state==='NONE'?'날짜 확인 필요':due.label)}</p></div><button type=\"button\" data-r17-open-commitment=\"${escapeHtml(r.id)}\">Follow-up</button></div>`;}).join(''):'<div class=\"safe\">미완료 Operating Commitment가 없습니다.</div>';for(const b of root.querySelectorAll('[data-r17-open-commitment]'))b.addEventListener('click',()=>{navigation.setActive('ONE_ON_ONE','1:1');openArtifactType('ONE_ON_ONE_COMMITMENT',b.dataset.r17OpenCommitment);});};\nconst r17RenderDecisionVelocity=()=>{const root=document.querySelector('[data-r17-decisions]');if(!root)return;const rows=artifactRows('DECISION_RIGHTS');root.innerHTML=rows.length?rows.map((r)=>{const lead=r17LeadDays(r);const due=r17ArtifactDue('DECISION_RIGHTS',r);const status=String(r.decisionStatus|| (r.decidedAt?'DECIDED':'OPEN')).toUpperCase();return `<div class=\"r17-decision\"><div><b>${escapeHtml(r.decision||'Decision')}</b><span> · D ${escapeHtml(r.decide||'미정')}</span></div><span>${escapeHtml(status)}</span><span>${lead==null?'Lead time 미정':`${lead.toFixed(1)} days`}</span><span class=\"${due.state==='OVERDUE'?'risk':''}\">${escapeHtml(due.state==='NONE'?'Due 미정':`${due.state} · ${due.label}`)}${r.escalationHistory?`<br><small>Escalation · ${escapeHtml(r.escalationHistory)}</small>`:''}</span></div>`;}).join(''):'<div class=\"safe\">Decision Rights를 만들면 Decision Lead Time이 나타납니다.</div>';};\nconst r17PriorityDraft=()=>{const w=r17LatestReview();if(!w)return null;const prev=r17LatestPriority();return{priority1:String(w.next||w.attention||'').trim()||'다음 주 핵심 변화',priority2:String(w.decisions||'').trim()||'미해결 결정 정리',priority3:String(w.delegation||'').trim()||'위임/체크포인트 확인',notNow:prev?.notNow||'새로운 비핵심 업무 추가',successSignal:String(w.learning||'').trim()||'다음 Weekly Review에서 변화 확인',reviewDate:'FRI 16:00',sourceWeeklyRef:w.id,sourceWeeklyVersion:Number(w.version)||1};};\nconst r17RenderPriorityProposal=()=>{const root=document.querySelector('[data-r17-priority]');if(!root)return;const draft=r17PriorityDraft();if(!draft){root.innerHTML='<div class=\"safe\">Weekly Review Snapshot을 저장하면 다음 주 Priority Contract 후보가 생성됩니다.</div>';return;}const existing=artifactRows('PRIORITY_CONTRACT').find((r)=>r.sourceWeeklyRef===draft.sourceWeeklyRef);root.innerHTML=`<div class=\"r17-priority-proposal\"><div><small>PRIORITY 1</small><b>${escapeHtml(draft.priority1)}</b></div><div><small>PRIORITY 2</small><b>${escapeHtml(draft.priority2)}</b></div><div><small>PRIORITY 3</small><b>${escapeHtml(draft.priority3)}</b></div></div><div class=\"r17-actions\"><span class=\"review-meta\">${existing?'이미 이 Weekly Review에서 Draft가 생성되었습니다.':'Human Confirm 전까지 DRAFT로만 저장됩니다.'}</span><button type=\"button\" class=\"primary\" data-r17-create-priority ${existing?'disabled':''}>DRAFT Priority Contract 만들기</button></div>`;root.querySelector('[data-r17-create-priority]')?.addEventListener('click',()=>{const id=addArtifactRecord('PRIORITY_CONTRACT',draft);questStore.artifactTab='PRIORITY_CONTRACT';saveQuestStore();renderArtifactWorkspace();r17RenderPriorityProposal();navigation.announce('Weekly Review에서 Draft Priority Contract를 만들었습니다. Human Confirm이 필요합니다.');});};\nconst r17RenderReportExtension=()=>{const root=document.querySelector('[data-r17-report-next60]');if(root)root.textContent=r17Next60SummaryForBrief();};\nconst renderRecovery17Surfaces=()=>{r17EnsureSurfaces();r17RenderMetrics();r17RenderGroupedGraph();r17RenderFollowups();r17RenderDecisionVelocity();r17RenderPriorityProposal();r17RenderReportExtension();};\n\nrenderRolePack();\nrenderSetupChecklist();\nrenderSampleBoards();\nrenderArtifactWorkspace();\nrenderQuestProgress();\nrenderQuestList();\nrenderQuestDetail(questStore.selectedDay);\nrenderWeeklyOperatingReview();\nrenderToolkit();\nrenderSources();\nrenderTodayLeaderNudge();\nrenderRecovery15Surfaces();\n\nonboardingOpen?.addEventListener('click', () => navigation.setActive('ONBOARDING', '30-Day Quest'));\nconfirmButton.addEventListener('click', () => { const confirmed = confirmOnboardingUnderstanding(onboardingState, { type: 'HUMAN', id: 'CURRENT_USER' }); onboardingResultRoot.hidden = false; onboardingResultRoot.textContent = confirmed.ok ? 'AI Understanding confirmed by human. Day 1 Quest가 준비되었습니다.' : 'Human confirmation required.'; });\n\n// Leader Coach · 3-stage nudge\nconst coachScenario = document.querySelector('[data-coach-scenario]');\nconst coachLevel = document.querySelector('[data-coach-level]');\nconst coachOutput = document.querySelector('[data-coach-output]');\nconst coachScript = document.querySelector('[data-coach-script]');\nconst coachCopy = document.querySelector('[data-coach-copy]');\nif (!coachScenario || !coachLevel || !coachOutput || !coachScript || !coachCopy)\n    throw new Error('LEADER_COACH_ROOT_MISSING');\ncoachScenario.innerHTML = Object.entries(LEADER_COACH_SCENARIOS).map(([id, scenario]) => `<option value=\"${id}\">${escapeHtml(scenario.name)}</option>`).join('');\nconst renderCoach = () => {\n    const scenario = LEADER_COACH_SCENARIOS[coachScenario.value] ?? LEADER_COACH_SCENARIOS.TASK;\n    const level = coachLevel.value || 'coach';\n    const levelLabel = level === 'gentle' ? 'LEVEL 1 · Gentle' : level === 'learn' ? 'LEVEL 3 · Learn' : 'LEVEL 2 · Coach';\n    coachOutput.innerHTML = `<span class=\"state-badge\">${levelLabel}</span><h3>${escapeHtml(scenario.name)}</h3><p>${escapeHtml(scenario[level])}</p>`;\n    coachScript.textContent = scenario.script;\n};\ncoachScenario.addEventListener('change', renderCoach);\ncoachLevel.addEventListener('change', renderCoach);\ncoachCopy.addEventListener('click', async () => {\n    const scenario = LEADER_COACH_SCENARIOS[coachScenario.value] ?? LEADER_COACH_SCENARIOS.TASK;\n    const level = coachLevel.value || 'coach';\n    const text = `[Leader OS · ${scenario.name}]\\n${scenario[level]}\\n\\nGuide: ${scenario.script}`;\n    try { await navigator.clipboard.writeText(text); coachCopy.textContent = '복사됨 ✓'; setTimeout(() => coachCopy.textContent = '코칭 문장 복사', 1200); } catch { coachCopy.textContent = '복사 실패'; }\n});\nrenderCoach();\nconst skillDefinitions = [\n    { id: 'SK-QUICK', name: 'Quick Decision Check', whyNow: '빠르게 열린 결정을 점검', mode: 'QUICK', scope: 'STANDARD', prepare: ['Decision context'], run: ['Check evidence', 'Confirm owner'] },\n    { id: 'SK-STANDARD', name: '1:1 Follow-up', whyNow: '미해결 Commitment가 있음', mode: 'STANDARD', scope: 'STANDARD', prepare: ['Last notes', 'Commitments'], run: ['Clarify', 'Capture', 'Follow-up'] },\n    { id: 'SK-FULL', name: 'Project Recovery', whyNow: '마일스톤 지연과 dependency가 있음', mode: 'FULL', scope: 'COMPANY', prepare: ['Project evidence', 'Dependencies'], run: ['Symptom', 'Cause', 'Dependency', 'Decision', 'Recovery'] }\n];\nconst skillRoot = document.querySelector('[data-skills-grid]');\nif (!skillRoot) throw new Error('SKILLS_ROOT_MISSING');\nconst SKILL_STORAGE_BASE='leader-os:skill-run-state:v2';\nconst skillStorageScope=()=>{try{const state=reportRuntimeBridge.state();return state.signedIn&&state.userId&&state.workspaceId?`${state.userId}:${state.workspaceId}`:'guest'}catch{return'guest'}};\nconst skillStorageKey=()=>`${SKILL_STORAGE_BASE}:${skillStorageScope()}`;\nlet activeSkillScope=skillStorageScope();\nconst readSkillState=()=>{try{const parsed=JSON.parse(browserStorage.getItem(skillStorageKey())||'{}');return parsed&&typeof parsed==='object'?parsed:{}}catch{return {}}};\nlet skillState=readSkillState();\nconst saveSkillState=()=>{try{browserStorage.setItem(skillStorageKey(),JSON.stringify(skillState))}catch{}};\nsetInterval(()=>{\n    const next=skillStorageScope();\n    if(next===activeSkillScope)return;\n    activeSkillScope=next;\n    skillState=readSkillState();\n    renderSkills();\n},1400);\nconst skillStages=['PREPARE','RUN','CAPTURE','ACTION'];\nconst renderSkills=()=>{\n    skillRoot.innerHTML='';\n    for (const definition of skillDefinitions) {\n        const run = buildSkillRun(definition);\n        const state=skillState[definition.id]||{stage:'PREPARE',completed:false,updatedAt:null};\n        const stageIndex=Math.max(0,skillStages.indexOf(state.stage));\n        const card = document.createElement('article');\n        card.className = 'skill-card';\n        card.innerHTML = `<span class=\"state-badge\">${escapeHtml(run.mode)}</span><h3>${escapeHtml(run.name)}</h3><div class=\"why\">Why now: ${escapeHtml(run.whyNow)}</div><div class=\"skill-progress\">${skillStages.map((stage,index)=>`<button type=\"button\" class=\"skill-step ${index<stageIndex?'done':''} ${index===stageIndex&&!state.completed?'active':''} ${state.completed?'done':''}\" data-skill-stage=\"${stage}\" data-skill-id=\"${definition.id}\">${index+1} · ${stage}</button>`).join('')}</div><div class=\"safe\">${state.completed?'Human-reviewed practice completed.':'단계를 눌러 현재 실행 위치를 저장하세요. Capture는 자동 Fact가 아니라 후보 기록입니다.'}</div><div class=\"skill-state-row\"><span>${state.updatedAt?`Last saved · ${new Date(state.updatedAt).toLocaleString()}`:'아직 저장된 진행 없음'}</span><button type=\"button\" class=\"skill-reset\" data-skill-reset=\"${definition.id}\">초기화</button></div>`;\n        skillRoot.append(card);\n    }\n    for(const button of skillRoot.querySelectorAll('[data-skill-stage]')) button.addEventListener('click',()=>{\n        const id=button.dataset.skillId, stage=button.dataset.skillStage;\n        skillState[id]={stage,completed:stage==='ACTION',updatedAt:new Date().toISOString()};\n        saveSkillState(); renderSkills();\n    });\n    for(const button of skillRoot.querySelectorAll('[data-skill-reset]')) button.addEventListener('click',()=>{delete skillState[button.dataset.skillReset];saveSkillState();renderSkills();});\n};\nrenderSkills();\nconst sampleReviews = [\n    {\n        recommendationId: 'REC-008',\n        reviewStatus: 'PENDING_HUMAN_REVIEW',\n        summary: '프로젝트 A의 의사결정 지연 원인을 다시 확인하세요.',\n        reason: '결정 지연 이후 Outcome Evidence가 들어왔고 실제 개선 여부를 확인할 시점입니다.',\n        evidenceRefs: ['REC-008', 'DEC-014', 'EV-A-044'],\n        confidence: 0.77,\n        decisionState: 'ADOPTED',\n        targetType: 'RECOMMENDATION'\n    },\n    {\n        recommendationId: 'REC-011',\n        reviewStatus: 'PENDING_HUMAN_REVIEW',\n        summary: '다음 1:1에서 Commitment를 Follow-up 하세요.',\n        reason: '지난 대화에서 합의된 Commitment의 완료 근거가 아직 없습니다.',\n        evidenceRefs: ['1ON1-031', 'COM-019'],\n        confidence: 0.82,\n        decisionState: 'DEFERRED',\n        targetType: 'RECOMMENDATION'\n    }\n];\nconst reviewQueue = buildReviewQueue(sampleReviews);\nconst reviewRoot = document.querySelector('[data-review-list]');\nif (!reviewRoot)\n    throw new Error('REVIEW_LIST_ROOT_MISSING');\nfor (const item of reviewQueue.accepted) {\n    const card = document.createElement('article');\n    card.className = 'review-card';\n    card.dataset.recommendationId = item.recommendationId;\n    const head = document.createElement('div');\n    head.className = 'review-head';\n    const copy = document.createElement('div');\n    const title = document.createElement('strong');\n    title.textContent = item.summary;\n    const why = document.createElement('div');\n    why.className = 'why';\n    why.textContent = `Reason: ${item.reason}`;\n    copy.append(title, why);\n    const meta = document.createElement('div');\n    meta.className = 'review-meta';\n    const decisionStateLabel = { ADOPTED: '채택', REJECTED: '거절', DEFERRED: '보류', NOT_DECIDED: '미결정' }[item.decisionState];\n    meta.textContent = `결정 상태 ${decisionStateLabel} · 신뢰도 ${Math.round(item.confidence * 100)}% (확정 사실 아님)`;\n    head.append(copy, meta);\n    const evidence = document.createElement('div');\n    evidence.className = 'safe';\n    evidence.textContent = `연결 근거: ${item.evidenceRefs.join(' · ')}`;\n    const verdicts = ['USEFUL', 'NOT_USEFUL', 'WRONG', 'NEEDS_MORE_EVIDENCE'];\n    const verdictLabels = { USEFUL: '도움 됨', NOT_USEFUL: '도움 안 됨', WRONG: '틀림', NEEDS_MORE_EVIDENCE: '근거 더 필요' };\n    const actions = document.createElement('div');\n    actions.className = 'review-actions';\n    let selected = null;\n    for (const verdict of verdicts) {\n        const button = document.createElement('button');\n        button.type = 'button';\n        button.textContent = verdictLabels[verdict];\n        button.addEventListener('click', () => {\n            selected = verdict;\n            for (const sibling of actions.querySelectorAll('button'))\n                sibling.classList.remove('selected');\n            button.classList.add('selected');\n        });\n        actions.append(button);\n    }\n    const evidenceField = document.createElement('div');\n    evidenceField.className = 'field';\n    const evidenceLabel = document.createElement('label');\n    evidenceLabel.textContent = '결과 근거 연결';\n    const evidenceInput = document.createElement('input');\n    const evidenceInputId = `review-evidence-${item.recommendationId}`;\n    evidenceInput.id = evidenceInputId;\n    evidenceLabel.htmlFor = evidenceInputId;\n    evidenceInput.placeholder = '근거 ID를 입력하거나 아래 항목을 선택';\n    const picker = document.createElement('div');\n    picker.className = 'evidence-picker';\n    for (const ref of item.evidenceRefs) {\n        const chip = document.createElement('button');\n        chip.type = 'button';\n        chip.textContent = ref;\n        chip.addEventListener('click', () => {\n            const current = evidenceInput.value.split(',').map((value) => value.trim()).filter(Boolean);\n            if (!current.includes(ref))\n                current.push(ref);\n            evidenceInput.value = current.join(', ');\n            navigation.announce(`${ref} 근거를 Review에 연결했습니다.`);\n        });\n        picker.append(chip);\n    }\n    evidenceField.append(evidenceLabel, evidenceInput, picker);\n    const noteField = document.createElement('div');\n    noteField.className = 'field';\n    const noteLabel = document.createElement('label');\n    noteLabel.textContent = '검수 메모';\n    const noteInput = document.createElement('textarea');\n    const noteInputId = `review-note-${item.recommendationId}`;\n    noteInput.id = noteInputId;\n    noteLabel.htmlFor = noteInputId;\n    noteInput.rows = 2;\n    noteInput.placeholder = '왜 그렇게 판단했는지 짧게 남기면 다음 추천 품질을 개선할 수 있습니다.';\n    noteField.append(noteLabel, noteInput);\n    const submit = document.createElement('button');\n    submit.type = 'button';\n    submit.textContent = '내 검수 결과 확정';\n    submit.className = 'primary';\n    submit.style.marginTop = '12px';\n    const result = document.createElement('div');\n    result.className = 'review-result';\n    result.hidden = true;\n    submit.addEventListener('click', () => {\n        if (!selected) {\n            result.hidden = false;\n            result.textContent = '검수 결과를 먼저 선택하세요.';\n            return;\n        }\n        const submission = buildReviewSubmission({\n            recommendationId: item.recommendationId,\n            verdict: selected,\n            outcomeEvidenceRefs: evidenceInput.value.split(','),\n            reviewerType: 'HUMAN',\n            reviewerId: 'CURRENT_USER',\n            notes: noteInput.value\n        });\n        result.hidden = false;\n        result.textContent = submission.ok\n            ? '검수 결과 저장 준비 완료 · 사람에 대한 평가나 확정 사실은 자동 변경되지 않습니다.'\n            : `검수 실패: ${(submission.violations ?? ['UNKNOWN_REVIEW_ERROR']).join(' · ')}`;\n    });\n    card.append(head, evidence, actions, evidenceField, noteField, submit, result);\n    reviewRoot.append(card);\n}\nconst reviewCount = document.querySelector('[data-review-count]');\nif (reviewCount)\n    reviewCount.textContent = String(reviewQueue.accepted.length);\nconst contractBadge = document.querySelector('[data-contract-status]');\nif (contractBadge) {\n    contractBadge.textContent = 'Core checks PASS';\n    contractBadge.title = 'Navigation + Today + Review contracts PASS';\n}\nnavigation.activateFromHash();\nvoid liveUi.restorePersistedSession();\n","billing.js":"const assertPositiveInteger = (value, code) => {\n    if (!Number.isInteger(value) || value <= 0)\n        throw new Error(code);\n};\nexport function buildBillingSnapshot(state) {\n    const totalCreditsAdded = state.ledger.filter((entry) => entry.creditDelta > 0).reduce((sum, entry) => sum + entry.creditDelta, 0);\n    const totalCreditsUsed = Math.abs(state.ledger.filter((entry) => entry.creditDelta < 0).reduce((sum, entry) => sum + entry.creditDelta, 0));\n    return { ...state, availableCredits: state.ledger.reduce((sum, entry) => sum + entry.creditDelta, 0), totalCreditsAdded, totalCreditsUsed };\n}\nexport function createManualTopUpRequest(input) {\n    assertPositiveInteger(input.amountKrw, 'TOPUP_AMOUNT_REQUIRED');\n    assertPositiveInteger(input.requestedCredits, 'TOPUP_CREDITS_REQUIRED');\n    const payerReference = input.payerReference.trim();\n    if (!payerReference)\n        throw new Error('PAYER_REFERENCE_REQUIRED');\n    return { ...input, payerReference, status: 'PENDING' };\n}\nexport function approveManualTopUpRequest(state, requestId, reviewedAt, ledgerId) {\n    const request = state.topUpRequests.find((item) => item.id === requestId);\n    if (!request)\n        throw new Error('TOPUP_REQUEST_NOT_FOUND');\n    if (request.status !== 'PENDING')\n        throw new Error('TOPUP_REQUEST_NOT_PENDING');\n    const updatedRequests = state.topUpRequests.map((item) => item.id === requestId ? { ...item, status: 'APPROVED', reviewedAt } : item);\n    const entry = { id: ledgerId, kind: 'TOPUP_APPROVED', creditDelta: request.requestedCredits, createdAt: reviewedAt, description: `Manual top-up approved · ₩${request.amountKrw.toLocaleString('ko-KR')}`, referenceId: request.id };\n    return { ...state, topUpRequests: updatedRequests, ledger: [entry, ...state.ledger] };\n}\nexport function recordPlatformUsage(state, input) {\n    assertPositiveInteger(input.credits, 'USAGE_CREDITS_REQUIRED');\n    const snapshot = buildBillingSnapshot(state);\n    if (snapshot.availableCredits < input.credits)\n        throw new Error('INSUFFICIENT_PLATFORM_CREDITS');\n    const entry = { id: input.id, kind: 'USAGE_DEBIT', creditDelta: -input.credits, createdAt: input.createdAt, description: input.description, provider: input.provider, model: input.model };\n    return { ...state, ledger: [entry, ...state.ledger] };\n}\nexport function usageFundingDecision(state, hasUsableByok) {\n    if (state.mode === 'BYOK')\n        return { source: hasUsableByok ? 'BYOK' : 'BLOCKED', reason: hasUsableByok ? 'USER_PROVIDER_KEY' : 'BYOK_KEY_REQUIRED' };\n    if (state.mode === 'PLATFORM_CREDITS') {\n        const ok = buildBillingSnapshot(state).availableCredits > 0;\n        return { source: ok ? 'PLATFORM_CREDITS' : 'BLOCKED', reason: ok ? 'PLATFORM_BALANCE' : 'INSUFFICIENT_PLATFORM_CREDITS' };\n    }\n    if (hasUsableByok)\n        return { source: 'BYOK', reason: 'BYOK_FIRST' };\n    const ok = buildBillingSnapshot(state).availableCredits > 0;\n    return { source: ok ? 'PLATFORM_CREDITS' : 'BLOCKED', reason: ok ? 'EXPLICIT_FALLBACK' : 'NO_FUNDING_SOURCE' };\n}\nexport function maskApiKey(rawKey) {\n    const key = rawKey.trim();\n    if (key.length < 10)\n        throw new Error('API_KEY_TOO_SHORT');\n    const prefix = key.slice(0, Math.min(6, Math.max(3, Math.floor(key.length / 4))));\n    const suffix = key.slice(-4);\n    return `${prefix}${'•'.repeat(8)}${suffix}`;\n}\nexport function createProviderCredentialMetadata(input) {\n    return { id: input.id, provider: input.provider, label: input.label.trim() || input.provider, maskedKey: maskApiKey(input.rawKey), status: 'READY_FOR_SECURE_SAVE', createdAt: input.createdAt };\n}\nexport function validateBillingState(state) {\n    const violations = [];\n    const seen = new Set();\n    for (const entry of state.ledger) {\n        if (seen.has(entry.id))\n            violations.push('LEDGER_ID_DUPLICATED');\n        seen.add(entry.id);\n        if (entry.creditDelta === 0)\n            violations.push('ZERO_LEDGER_ENTRY');\n    }\n    for (const request of state.topUpRequests) {\n        if (request.status === 'PENDING' && state.ledger.some((entry) => entry.referenceId === request.id && entry.kind === 'TOPUP_APPROVED'))\n            violations.push('PENDING_TOPUP_MUST_NOT_CREDIT_BALANCE');\n    }\n    return { ok: violations.length === 0, violations };\n}\nexport function createDemoBillingState() {\n    return {\n        mode: 'AUTO_FALLBACK',\n        ledger: [\n            { id: 'LED-003', kind: 'USAGE_DEBIT', creditDelta: -860, createdAt: '2026-09-29T08:30:00+09:00', description: 'Executive weekly brief', provider: 'GOOGLE_GEMINI', model: 'flash' },\n            { id: 'LED-002', kind: 'USAGE_DEBIT', creditDelta: -340, createdAt: '2026-09-28T14:20:00+09:00', description: 'Meeting evidence extraction', provider: 'OPENROUTER', model: 'auto' },\n            { id: 'LED-001', kind: 'TOPUP_APPROVED', creditDelta: 30000, createdAt: '2026-09-27T11:00:00+09:00', description: 'Manual top-up approved · ₩30,000', referenceId: 'TOP-001' }\n        ],\n        topUpRequests: [{ id: 'TOP-001', amountKrw: 30000, requestedCredits: 30000, paymentMethod: 'BANK_TRANSFER', payerReference: 'PETER VANILLA', status: 'APPROVED', createdAt: '2026-09-27T10:10:00+09:00', reviewedAt: '2026-09-27T11:00:00+09:00' }],\n        providerKeys: [{ id: 'KEY-001', provider: 'OPENROUTER', label: 'OpenRouter personal', maskedKey: 'sk-or-••••••••A7x9', status: 'CONNECTED', createdAt: '2026-09-27T09:00:00+09:00' }]\n    };\n}\n","browser-runtime.js":"import { createLeaderOsGateway, projectGatewayContext } from './gateway.js';\nexport const projectBrowserContext = (pack) => projectGatewayContext(pack);\n/** @deprecated Compatibility facade. New application code should use LeaderOsGateway. */\nexport function createLeaderOsBrowserRuntime(config, transport = fetch, authStorage = null) { return createLeaderOsGateway(config, transport, authStorage); }\n","controllers/application-controllers.js":"export class AuthController {\n    session;\n    constructor(session) {\n        this.session = session;\n    }\n    signIn(email, password) { return this.session.signInWithPassword(email, password); }\n    restore() { return this.session.restoreSession(); }\n    signOut() { return this.session.signOut(); }\n    get identity() { return this.session.currentIdentity; }\n    get isSignedIn() { return this.session.isSignedIn; }\n}\nexport class WorkspaceController {\n    session;\n    constructor(session) {\n        this.session = session;\n    }\n    list() { return this.session.currentWorkspaces; }\n    byId(workspaceId) { return this.session.workspaceById(workspaceId); }\n    select(workspaceId) { return this.session.selectWorkspace(workspaceId); }\n    create(workspaceName) { return this.session.createWorkspaceExplicitly(workspaceName); }\n    get active() { return this.session.currentWorkspace; }\n}\nexport class PreferencesController {\n    session;\n    constructor(session) {\n        this.session = session;\n    }\n    get current() { return this.session.currentPreferences; }\n    save(patch) { return this.session.savePreferences(patch); }\n    reload() { return this.session.reloadPreferences(); }\n}\nexport class ContextController {\n    session;\n    constructor(session) {\n        this.session = session;\n    }\n    get current() { return this.session.currentContextPack; }\n    refresh() { return this.session.refreshContext(); }\n}\nexport class DomainActionController {\n    session;\n    constructor(session) {\n        this.session = session;\n    }\n    confirmDecision(input) {\n        return this.session.confirmDecision(input);\n    }\n    completeFirstUse(input) {\n        return this.session.saveFirstUseSetup(input);\n    }\n}\nexport const createLeaderOsControllers = (session) => ({\n    auth: new AuthController(session),\n    workspaces: new WorkspaceController(session),\n    preferences: new PreferencesController(session),\n    context: new ContextController(session),\n    domainActions: new DomainActionController(session)\n});\n","decisions.js":"function refs(values) {\n    return [...new Set(values.map((value) => value.trim()).filter(Boolean))];\n}\nexport function validateDecisionDraft(input) {\n    const violations = [];\n    if (!input?.id)\n        violations.push('DECISION_ID_REQUIRED');\n    if (!input?.what?.trim())\n        violations.push('DECISION_WHAT_REQUIRED');\n    if (!input?.why?.trim())\n        violations.push('DECISION_WHY_REQUIRED');\n    if (refs(input?.evidenceRefs ?? []).length === 0)\n        violations.push('DECISION_EVIDENCE_REQUIRED');\n    if (!input?.owner?.trim())\n        violations.push('DECISION_OWNER_REQUIRED');\n    if (!input?.reviewDate?.trim())\n        violations.push('DECISION_REVIEW_DATE_REQUIRED');\n    return { ok: violations.length === 0, violations };\n}\nexport function confirmDecision(input, reviewer) {\n    const validation = validateDecisionDraft(input);\n    if (!validation.ok)\n        return { ok: false, error: 'INVALID_DECISION', violations: validation.violations };\n    if (reviewer.type !== 'HUMAN' || !reviewer.id) {\n        return { ok: false, error: 'HUMAN_CONFIRMATION_REQUIRED' };\n    }\n    return {\n        ok: true,\n        decision: {\n            ...input,\n            what: input.what.trim(),\n            why: input.why.trim(),\n            evidenceRefs: refs(input.evidenceRefs),\n            owner: input.owner.trim(),\n            reviewDate: input.reviewDate.trim(),\n            status: 'CONFIRMED',\n            confirmedBy: { type: 'HUMAN', id: reviewer.id }\n        }\n    };\n}\nexport function proposeDecisionImpact(input) {\n    return {\n        decisionId: input.decisionId,\n        affectedProjectIds: [...new Set(input.affectedProjectIds ?? [])],\n        suggestedDateChanges: input.suggestedDateChanges ?? [],\n        appliedAutomatically: false,\n        humanReviewRequired: true\n    };\n}\nexport function decisionDraftFromContext(item) {\n    if (item.objectType !== 'DECISION')\n        return { ok: false, error: 'DECISION_CONTEXT_REQUIRED' };\n    const data = item.data;\n    const text = (key) => typeof data[key] === 'string' && String(data[key]).trim() ? String(data[key]).trim() : '';\n    const evidenceRefs = Array.isArray(data.evidenceRefs)\n        ? data.evidenceRefs.filter((value) => typeof value === 'string').map((value) => value.trim()).filter(Boolean)\n        : [];\n    const draft = {\n        id: item.objectId,\n        what: text('what') || text('title'),\n        why: text('why') || text('reason'),\n        evidenceRefs,\n        owner: text('owner') || text('ownerUserId'),\n        reviewDate: text('reviewDate'),\n        status: item.confirmed ? 'CONFIRMED' : 'DRAFT'\n    };\n    const validation = validateDecisionDraft(draft);\n    return validation.ok\n        ? { ok: true, draft }\n        : { ok: false, error: 'INVALID_DECISION', violations: validation.violations, draft };\n}\n","gateway.js":"import { LeaderOsRuntimeClient, allContextItems } from './runtime.js';\nimport { createRuntimeRepositories } from './runtime-repositories.js';\nimport { SupabasePasswordAuthClient } from './supabase-auth.js';\nimport { WorkspaceDirectoryClient } from './workspace-directory.js';\nimport { UserPreferencesClient } from './user-preferences.js';\nexport function projectGatewayContext(pack) { const items = allContextItems(pack); return { workspaceId: pack.workspaceId, viewerRole: pack.viewerRole, generatedAt: pack.generatedAt, counts: pack.counts, people: items.filter(x => x.objectType === 'PERSON'), projects: items.filter(x => x.objectType === 'PROJECT'), decisions: items.filter(x => x.objectType === 'DECISION'), evidence: pack.evidence }; }\nconst clean = (v) => typeof v === 'string' && v.trim() ? v.trim() : null;\nexport class LeaderOsGateway {\n    config;\n    auth;\n    runtime;\n    directory;\n    preferences;\n    activeWorkspaceId;\n    activeWorkspaceName;\n    repos;\n    constructor(config, transport = fetch, storage = null) {\n        this.config = config;\n        this.auth = new SupabasePasswordAuthClient({ supabaseUrl: config.supabaseUrl, publishableKey: config.publishableKey, storage }, transport);\n        const common = { supabaseUrl: config.supabaseUrl, publishableKey: config.publishableKey, accessTokenProvider: () => this.auth.getAccessToken() };\n        this.runtime = new LeaderOsRuntimeClient(common, transport);\n        this.directory = new WorkspaceDirectoryClient(common, transport);\n        this.preferences = new UserPreferencesClient(common, transport);\n        this.activeWorkspaceId = clean(config.workspaceId);\n        this.activeWorkspaceName = config.workspaceName?.trim() || this.activeWorkspaceId;\n        this.repos = this.activeWorkspaceId ? createRuntimeRepositories({ runtime: this.runtime, workspaceId: this.activeWorkspaceId, idFactory: config.idFactory }) : null;\n    }\n    get currentWorkspaceId() { return this.activeWorkspaceId; }\n    get repositories() { if (!this.repos)\n        throw new Error('ACTIVE_WORKSPACE_REQUIRED'); return this.repos; }\n    commitWorkspace(id, name) { this.activeWorkspaceId = id; this.activeWorkspaceName = name?.trim() || id; this.repos = createRuntimeRepositories({ runtime: this.runtime, workspaceId: id, idFactory: this.config.idFactory }); }\n    signInWithPassword(email, password) { return this.auth.signInWithPassword(email, password); }\n    restoreSession() { return this.auth.restoreSession(); }\n    signUp(email, password) { return this.auth.signUp(email, password); }\n    signOut() { return this.auth.signOut(); }\n    discoverWorkspaces() { return this.directory.list(); }\n    getPreferences() { return this.preferences.get(); }\n    savePreferences(v, p) { return this.preferences.save(v, p); }\n    async createWorkspaceExplicitly(input) {\n        const workspaceId = clean(input.workspaceId);\n        const workspaceName = clean(input.workspaceName);\n        if (!workspaceId)\n            throw new Error('WORKSPACE_ID_REQUIRED');\n        if (!workspaceName)\n            throw new Error('WORKSPACE_NAME_REQUIRED');\n        return this.runtime.bootstrapWorkspace({ workspaceId, workspaceName });\n    }\n    async switchWorkspace(id, name, expectedUserId) { const requested = clean(id); if (!requested)\n        throw new Error('WORKSPACE_ID_REQUIRED'); const result = await this.runtime.getContext(requested); if (!result.contextPack)\n        throw new Error('CONTEXT_PACK_REQUIRED'); if (result.contextPack.workspaceId !== requested)\n        throw new Error('CONTEXT_WORKSPACE_ID_MISMATCH'); if (expectedUserId && result.contextPack.viewerUserId !== expectedUserId)\n        throw new Error('CONTEXT_VIEWER_ID_MISMATCH'); this.commitWorkspace(requested, name); return { requestId: result.requestId, contextPack: result.contextPack, projection: projectGatewayContext(result.contextPack) }; }\n    async hydrate() { if (!this.activeWorkspaceId)\n        throw new Error('ACTIVE_WORKSPACE_REQUIRED'); const result = await this.runtime.getContext(this.activeWorkspaceId); if (!result.contextPack)\n        throw new Error('CONTEXT_PACK_REQUIRED'); if (result.contextPack.workspaceId !== this.activeWorkspaceId)\n        throw new Error('CONTEXT_WORKSPACE_ID_MISMATCH'); return { requestId: result.requestId, contextPack: result.contextPack, projection: projectGatewayContext(result.contextPack) }; }\n    async connect() { if (!this.activeWorkspaceId)\n        throw new Error('ACTIVE_WORKSPACE_REQUIRED'); await this.runtime.bootstrapWorkspace({ workspaceId: this.activeWorkspaceId, workspaceName: this.activeWorkspaceName || this.activeWorkspaceId }); return this.hydrate(); }\n    setWorkspace(id, name) { const next = clean(id); if (!next)\n        throw new Error('WORKSPACE_ID_REQUIRED'); this.commitWorkspace(next, name); return next; }\n    savePerson(input) { return this.repositories.team.savePerson(input); }\n    saveProject(input) { return this.repositories.projects.save(input); }\n    saveAction(input) { return this.repositories.actions.save(input); }\n    analyzeOpicker(input) { return this.repositories.addonEvidence.analyze(input); }\n    reviewAddonEvidence(input) { return this.repositories.addonEvidence.review(input); }\n    confirmDecision(input) { return this.repositories.decisions.confirm(input); }\n}\nexport const createLeaderOsGateway = (config, transport = fetch, storage = null) => new LeaderOsGateway(config, transport, storage);\n","learning.js":"const DELTA = {\n    USEFUL: 1,\n    NOT_USEFUL: -1,\n    WRONG: -2,\n    NEEDS_MORE_EVIDENCE: 0\n};\nconst PROHIBITED_DIMENSIONS = new Set([\n    'personId', 'employeeId', 'email', 'personality', 'performanceRating',\n    'motivation', 'potential', 'promotionReadiness', 'loyalty', 'cultureFit'\n]);\nexport function aggregateLearning(observations, minimumSamples = 3) {\n    const accepted = [];\n    const rejected = [];\n    for (const observation of observations ?? []) {\n        if (observation.reviewedBy?.type !== 'HUMAN') {\n            rejected.push({ reason: 'HUMAN_FINAL_REVIEW_REQUIRED' });\n            continue;\n        }\n        if (Object.keys(observation.dimensions ?? {}).some((key) => PROHIBITED_DIMENSIONS.has(key))) {\n            rejected.push({ reason: 'PEOPLE_LEARNING_DIMENSION_PROHIBITED' });\n            continue;\n        }\n        accepted.push(observation);\n    }\n    const grouped = new Map();\n    for (const observation of accepted) {\n        const rows = grouped.get(observation.recommendationType) ?? [];\n        rows.push(observation);\n        grouped.set(observation.recommendationType, rows);\n    }\n    const profiles = [...grouped.entries()].map(([recommendationType, rows]) => {\n        const raw = rows.reduce((sum, row) => sum + DELTA[row.verdict], 0);\n        const sufficientEvidence = rows.length >= minimumSamples;\n        return {\n            recommendationType,\n            sampleCount: rows.length,\n            sufficientEvidence,\n            appliedWeight: sufficientEvidence ? Math.max(-3, Math.min(3, raw)) : 0,\n            truthMutationAllowed: false,\n            personRatingAllowed: false,\n            autoPriorityChangeAllowed: false\n        };\n    });\n    return { acceptedCount: accepted.length, rejected, profiles };\n}\n","live-today.js":"import { buildTodayView } from './today.js';\nconst verbs = new Set(['DECIDE', 'TALK', 'PREPARE', 'UNBLOCK', 'FOLLOW_UP', 'ALIGN', 'REVIEW']);\nfunction stringValue(data, ...keys) {\n    for (const key of keys) {\n        const value = data[key];\n        if (typeof value === 'string' && value.trim())\n            return value.trim();\n    }\n    return null;\n}\nfunction numberValue(data, key, fallback) {\n    const value = Number(data[key]);\n    return Number.isFinite(value) ? value : fallback;\n}\nfunction refs(item) {\n    const raw = item.data.evidenceRefs;\n    const values = Array.isArray(raw) ? raw.map(String).map((x) => x.trim()).filter(Boolean) : [];\n    return [...new Set([item.objectId, ...values])];\n}\nfunction explicitAttention(item) {\n    if (item.objectType !== 'ATTENTION')\n        return null;\n    const verb = stringValue(item.data, 'verb');\n    const title = stringValue(item.data, 'title');\n    const reason = stringValue(item.data, 'reason', 'why');\n    if (!verb || !verbs.has(verb) || !title || !reason)\n        return null;\n    return {\n        id: item.objectId,\n        verb,\n        title,\n        reason,\n        evidenceRefs: refs(item),\n        confidence: Math.min(1, Math.max(0, numberValue(item.data, 'confidence', 0.8))),\n        attentionPriority: numberValue(item.data, 'attentionPriority', 80),\n        criticality: ['P0', 'P1', 'P2', 'P3'].includes(String(item.data.criticality)) ? item.data.criticality : undefined,\n        humanPinned: item.data.humanPinned === true\n    };\n}\nfunction derivedAttention(item) {\n    const d = item.data;\n    if (item.objectType === 'RECOMMENDATION') {\n        return {\n            id: `LIVE-${item.objectId}`,\n            verb: 'REVIEW',\n            title: stringValue(d, 'title', 'recommendation', 'summary') ?? `추천 검수 · ${item.objectId}`,\n            reason: stringValue(d, 'reason', 'why') ?? 'Human Review가 필요한 Recommendation입니다.',\n            evidenceRefs: refs(item),\n            confidence: Math.min(1, Math.max(0, numberValue(d, 'confidence', 0.7))),\n            attentionPriority: 75\n        };\n    }\n    if (item.objectType === 'ACTION' || item.objectType === 'COMMITMENT') {\n        return {\n            id: `LIVE-${item.objectId}`,\n            verb: 'FOLLOW_UP',\n            title: stringValue(d, 'title', 'text', 'what', 'summary') ?? `${item.objectType} 후속 확인`,\n            reason: stringValue(d, 'reason', 'why', 'status') ?? `열린 ${item.objectType}의 진행 상태를 확인합니다.`,\n            evidenceRefs: refs(item),\n            confidence: 0.85,\n            attentionPriority: numberValue(d, 'attentionPriority', item.objectType === 'COMMITMENT' ? 72 : 68)\n        };\n    }\n    if (item.objectType === 'PROJECT') {\n        const name = stringValue(d, 'name', 'title') ?? item.objectId;\n        const blocker = stringValue(d, 'blocker', 'knownRisk');\n        const openDecision = stringValue(d, 'openDecision');\n        if (blocker)\n            return {\n                id: `LIVE-${item.objectId}-BLOCKER`, verb: 'UNBLOCK', title: `${name} 막힘 확인`, reason: blocker,\n                evidenceRefs: refs(item), confidence: 0.9, attentionPriority: 82, criticality: 'P1',\n                subject: { type: 'PROJECT', id: item.objectId, label: name }\n            };\n        if (openDecision)\n            return {\n                id: `LIVE-${item.objectId}-DECISION`, verb: 'DECIDE', title: `${name} 결정 필요`, reason: openDecision,\n                evidenceRefs: refs(item), confidence: 0.9, attentionPriority: 78, criticality: 'P2',\n                subject: { type: 'PROJECT', id: item.objectId, label: name }\n            };\n        return null;\n    }\n    if (item.objectType === 'DECISION') {\n        const reviewDate = stringValue(d, 'reviewDate');\n        if (!reviewDate)\n            return null;\n        return {\n            id: `LIVE-${item.objectId}-REVIEW`, verb: 'REVIEW',\n            title: `결정 리뷰 · ${stringValue(d, 'what', 'title') ?? item.objectId}`,\n            reason: `Review date ${reviewDate} · 결정의 결과와 전제를 다시 확인합니다.`,\n            evidenceRefs: refs(item), confidence: 0.95, attentionPriority: 64,\n            subject: { type: 'DECISION', id: item.objectId, label: stringValue(d, 'what', 'title') ?? item.objectId }\n        };\n    }\n    return null;\n}\nexport function buildLiveTodayProjection(pack) {\n    const all = [...pack.truth, ...pack.evidence, ...pack.recommendations, ...pack.operational, ...pack.candidates];\n    const explicit = all.map(explicitAttention).filter((x) => Boolean(x));\n    const candidates = explicit.length > 0\n        ? explicit\n        : all.map(derivedAttention).filter((x) => Boolean(x));\n    return {\n        today: buildTodayView(candidates),\n        counts: pack.counts,\n        viewerRole: pack.viewerRole,\n        generatedAt: pack.generatedAt,\n        workspaceId: pack.workspaceId,\n        source: 'RUNTIME_CONTEXT'\n    };\n}\n","meetings.js":"export function buildMeetingView(input) {\n    const captures = (input.captures ?? [])\n        .filter((item) => item?.id && item?.text?.trim())\n        .map((item) => ({\n        ...item,\n        text: item.text.trim(),\n        evidenceRefs: [...new Set((item.evidenceRefs ?? []).filter(Boolean))],\n        status: 'CANDIDATE',\n        humanReviewRequired: ['DECISION', 'COMMITMENT', 'MEMORY_CANDIDATE', 'ACTION'].includes(item.type),\n        confirmed: false\n    }));\n    return {\n        view: 'MEETING',\n        meetingId: input.id,\n        title: input.title,\n        before: {\n            objective: input.objective ?? null,\n            prepQuestions: input.prepQuestions ?? []\n        },\n        during: {\n            participants: input.participants ?? [],\n            liveCaptureAllowed: true\n        },\n        after: {\n            captures\n        },\n        directFactWrite: false,\n        directMemoryWrite: false\n    };\n}\nexport function validateMeetingView(view) {\n    const violations = [];\n    if (view.directFactWrite !== false)\n        violations.push('DIRECT_FACT_WRITE_PROHIBITED');\n    if (view.directMemoryWrite !== false)\n        violations.push('DIRECT_MEMORY_WRITE_PROHIBITED');\n    for (const item of view.after.captures) {\n        if (item.confirmed !== false)\n            violations.push('CAPTURE_MUST_START_UNCONFIRMED');\n        if (['DECISION', 'COMMITMENT', 'MEMORY_CANDIDATE', 'ACTION'].includes(item.type)\n            && item.humanReviewRequired !== true) {\n            violations.push('HUMAN_REVIEW_REQUIRED');\n        }\n    }\n    return { ok: violations.length === 0, violations };\n}\n","navigation.js":"export const PRIMARY_ROUTES = [\n    { id: 'TODAY', label: 'Today', path: '/today', purpose: 'Top 3 leadership attention for today.', group: 'FOCUS' },\n    { id: 'REVIEW', label: 'Review', path: '/review', purpose: 'Verify recommendation and decision outcomes.', group: 'FOCUS', firstClass: true },\n    { id: 'ONBOARDING', label: '30-Day Quest', path: '/30-day-quest', purpose: 'Practice leadership through a 30-day experiential curriculum.', group: 'FOCUS' },\n    { id: 'LEADER_COACH', label: 'Leader Coach', path: '/leader-coach', purpose: 'Contextual nudges for delegation, feedback, meetings and decisions.', group: 'FOCUS' },\n    { id: 'TEAM', label: 'Team', path: '/team', purpose: 'Understand team operating flow without ranking people.', group: 'PEOPLE' },\n    { id: 'PEOPLE', label: 'People', path: '/people', purpose: 'Understand people context without person scores.', group: 'PEOPLE' },\n    { id: 'ONE_ON_ONE', label: '1:1', path: '/one-on-one', purpose: 'Prepare → Talk → Capture → Follow-up.', group: 'PEOPLE' },\n    { id: 'WORK', label: 'Work', path: '/work', purpose: 'Projects, milestones, open decisions, blockers.', group: 'EXECUTION' },\n    { id: 'MEETINGS', label: 'Meetings', path: '/meetings', purpose: 'Before → During → After.', group: 'EXECUTION' },\n    { id: 'DECISIONS', label: 'Decisions', path: '/decisions', purpose: 'What + Why + Evidence + Owner + Review date.', group: 'EXECUTION' },\n    { id: 'WAYS_OF_WORKING', label: 'Ways of Working', path: '/ways-of-working', purpose: 'Practice candid feedback, collaborative execution, meetings and learning loops.', group: 'EXECUTION' },\n    { id: 'REPORTS', label: 'Reports', path: '/reports', purpose: 'Show operating change and unresolved flow.', group: 'SYSTEM' },\n    { id: 'SKILLS', label: 'Skills', path: '/skills', purpose: 'Leadership playbooks: Quick / Standard / Full.', group: 'SYSTEM' },\n    { id: 'ADD_ONS', label: 'Add-ons', path: '/add-ons', purpose: 'Connect specialist intermediary tools.', group: 'SYSTEM' },\n    { id: 'BILLING', label: 'Billing & AI', path: '/billing', purpose: 'Credits, BYOK, AI usage and payment history.', group: 'SYSTEM' }\n];\nexport const NESTED_ROUTES = [\n    { id: 'PERSON', path: '/people/:personId', parent: 'PEOPLE' },\n    { id: 'PROJECT', path: '/work/:projectId', parent: 'WORK' },\n    { id: 'MEETING', path: '/meetings/:meetingId', parent: 'MEETINGS' },\n    { id: 'DECISION', path: '/decisions/:decisionId', parent: 'DECISIONS' },\n    { id: 'ADD_ON_DETAIL', path: '/add-ons/:addonId', parent: 'ADD_ONS' }\n];\nexport function validateNavigationContract() {\n    const ids = PRIMARY_ROUTES.map((route) => route.id);\n    const violations = [];\n    if (ids[0] !== 'TODAY')\n        violations.push('TODAY_MUST_BE_FIRST');\n    if (!ids.includes('REVIEW'))\n        violations.push('REVIEW_REQUIRED');\n    if (!ids.includes('ADD_ONS'))\n        violations.push('ADD_ONS_REQUIRED');\n    if (PRIMARY_ROUTES.filter((r) => r.id === 'TODAY').length !== 1)\n        violations.push('TODAY_DUPLICATED');\n    if (PRIMARY_ROUTES.find((r) => r.id === 'REVIEW')?.firstClass !== true)\n        violations.push('REVIEW_MUST_BE_FIRST_CLASS');\n    if (new Set(PRIMARY_ROUTES.map((r) => r.group)).size !== 4)\n        violations.push('NAV_GROUPS_REQUIRED');\n    return { ok: violations.length === 0, violations };\n}\n","object-detail.js":"const routeConfig = {\n    PERSON: { prefix: 'people', parentRouteId: 'PEOPLE' },\n    PROJECT: { prefix: 'work', parentRouteId: 'WORK' },\n    MEETING: { prefix: 'meetings', parentRouteId: 'MEETINGS' },\n    DECISION: { prefix: 'decisions', parentRouteId: 'DECISIONS' }\n};\nexport function objectRoute(objectType, objectId) {\n    if (!(objectType in routeConfig) || !objectId.trim())\n        return null;\n    const config = routeConfig[objectType];\n    return `/${config.prefix}/${encodeURIComponent(objectId.trim())}`;\n}\nexport function parseObjectRoute(hashOrPath) {\n    const raw = hashOrPath.replace(/^#/, '').replace(/^\\//, '');\n    const [prefix, encodedId, ...rest] = raw.split('/');\n    if (!prefix || !encodedId || rest.length > 0)\n        return null;\n    const entry = Object.entries(routeConfig).find(([, config]) => config.prefix === prefix);\n    if (!entry)\n        return null;\n    const [objectType, config] = entry;\n    try {\n        const objectId = decodeURIComponent(encodedId).trim();\n        if (!objectId)\n            return null;\n        return { objectType, objectId, parentRouteId: config.parentRouteId, path: `/${prefix}/${encodeURIComponent(objectId)}` };\n    }\n    catch {\n        return null;\n    }\n}\nexport function buildSharePolicy(accessScope) {\n    if (accessScope === 'PRIVATE') {\n        return {\n            accessScope,\n            canPrepareShare: false,\n            canCopyLink: false,\n            requiresRecipientCheck: false,\n            label: '나만',\n            reason: 'PRIVATE Context는 공유 초안과 링크 복사를 차단합니다.'\n        };\n    }\n    if (accessScope === 'RESTRICTED') {\n        return {\n            accessScope,\n            canPrepareShare: true,\n            canCopyLink: true,\n            requiresRecipientCheck: true,\n            label: '특정 멤버',\n            reason: 'RESTRICTED Context는 수신자의 접근 권한을 확인한 뒤에만 공유합니다.'\n        };\n    }\n    return {\n        accessScope,\n        canPrepareShare: true,\n        canCopyLink: true,\n        requiresRecipientCheck: false,\n        label: 'Workspace',\n        reason: 'Workspace 멤버에게 공유할 수 있습니다. 외부 전송은 사람이 최종 실행합니다.'\n    };\n}\nfunction stringValue(data, ...keys) {\n    for (const key of keys) {\n        const value = data[key];\n        if (typeof value === 'string' && value.trim())\n            return value.trim();\n    }\n    return null;\n}\nexport function objectTitle(item) {\n    return stringValue(item.data, 'name', 'title', 'what', 'summary', 'text') ?? item.objectId;\n}\nexport function objectSummary(item) {\n    return stringValue(item.data, 'reason', 'why', 'goal', 'currentPriority', 'status', 'summary')\n        ?? `${item.objectType} Context`;\n}\nexport function objectDetailRows(item) {\n    const rows = [\n        ['ID', item.objectId],\n        ['Version', String(item.version)],\n        ['Confirmed', item.confirmed ? 'YES' : 'NO'],\n        ['Scope', item.accessScope],\n        ['Updated', item.updatedAt],\n        ['Owner', stringValue(item.data, 'owner')],\n        ['Role', stringValue(item.data, 'role')],\n        ['Goal', stringValue(item.data, 'goal')],\n        ['Priority', stringValue(item.data, 'currentPriority')],\n        ['Project', stringValue(item.data, 'currentProject')],\n        ['Blocker', stringValue(item.data, 'blocker', 'knownRisk')],\n        ['Open decision', stringValue(item.data, 'openDecision')],\n        ['Why', stringValue(item.data, 'why', 'reason')],\n        ['Review date', stringValue(item.data, 'reviewDate')]\n    ];\n    return rows.filter((row) => Boolean(row[1]));\n}\nexport function findContextItem(pack, objectType, objectId) {\n    const all = [\n        ...pack.truth,\n        ...pack.evidence,\n        ...pack.recommendations,\n        ...pack.operational,\n        ...pack.candidates\n    ];\n    return all.find((item) => item.objectType === objectType && item.objectId === objectId) ?? null;\n}\nexport function buildShareDraft(item, url, recipientChecked = false) {\n    const policy = buildSharePolicy(item.accessScope);\n    if (!policy.canPrepareShare)\n        return { ok: false, error: 'PRIVATE_SHARE_BLOCKED', policy };\n    if (policy.requiresRecipientCheck && !recipientChecked) {\n        return { ok: false, error: 'RECIPIENT_PERMISSION_CHECK_REQUIRED', policy };\n    }\n    return {\n        ok: true,\n        policy,\n        text: [\n            `Leader OS · ${item.objectType}`,\n            objectTitle(item),\n            objectSummary(item),\n            `상태: ${item.confirmed ? 'Confirmed' : 'Needs review'} · 범위: ${policy.label}`,\n            `링크: ${url}`,\n            '',\n            'Human preview required before external send.'\n        ].join('\\n')\n    };\n}\n","onboarding.js":"export const ONBOARDING_PHASES = Object.freeze([\n    { id: 'UNDERSTAND', days: '1–7', goal: '팀과 일의 실제 흐름을 이해한다' },\n    { id: 'ALIGN', days: '8–14', goal: '우선순위·시간·마일스톤을 같은 기준으로 맞춘다' },\n    { id: 'EMPOWER', days: '15–21', goal: '결정권과 위임 범위를 명확히 해 팀이 움직이게 한다' },\n    { id: 'COACH', days: '22–30', goal: '피드백·코칭·회고를 반복 가능한 운영 리듬으로 만든다' }\n]);\nexport const FIRST_USE_30_DAY_TASKS = Object.freeze([\n    {\n        id: 'UNDERSTAND-TEAM', phase: 'UNDERSTAND', days: '1–7',\n        title: '팀원들과 첫 1:1을 하고 사람·업무·막힘을 이해하기',\n        reason: '첫 주에는 평가보다 실제 역할·업무 흐름·반복되는 제약을 이해하는 것이 우선입니다.', attentionPriority: 96\n    },\n    {\n        id: 'ALIGN-OPERATING', phase: 'ALIGN', days: '8–14',\n        title: '우선순위·캘린더·Work·Milestone을 하나의 운영 기준으로 맞추기',\n        reason: '팀이 같은 방향으로 움직이려면 중요한 일, 시간, 완료 기준과 다음 판단 지점이 연결되어야 합니다.', attentionPriority: 90\n    },\n    {\n        id: 'EMPOWER-DECISION', phase: 'EMPOWER', days: '15–21',\n        title: '결정권과 위임 범위를 명확히 해 팀이 스스로 움직이게 하기',\n        reason: '리더가 모든 결정을 들고 있지 않도록 Decision Rights와 Delegation Guardrail을 실제 업무에 적용합니다.', attentionPriority: 84\n    },\n    {\n        id: 'COACH-RHYTHM', phase: 'COACH', days: '22–30',\n        title: '피드백·1:1·회고를 코칭 리듬으로 만들고 Team OS Charter로 통합하기',\n        reason: '30일의 목적은 과정 수료가 아니라 팀이 계속 사용할 운영·코칭 시스템을 남기는 것입니다.', attentionPriority: 78\n    }\n]);\nexport function buildOnboardingState(input) {\n    const fields = Object.values(input);\n    const invalid = fields.filter((field) => !['KNOWN', 'UNKNOWN', 'NEEDS_CONFIRMATION', 'NOT_APPLICABLE'].includes(field.state));\n    if (invalid.length > 0) {\n        return { ok: false, error: 'INVALID_KNOWLEDGE_STATE' };\n    }\n    const understanding = fields.map((field) => ({\n        id: field.id,\n        label: field.label,\n        value: field.value,\n        state: field.state,\n        aiMayGuess: false\n    }));\n    return {\n        ok: true,\n        state: {\n            mode: 'ONBOARDING',\n            steps: [\n                'WELCOME', 'CURRENT_SITUATION', 'ROLE', 'TOP_CONCERNS', 'BOSS_REPORTING', 'TEAM', 'PROJECTS',\n                '30_DAY_GOAL', 'AI_UNDERSTANDING', '30_DAY_PLAN', 'DAY_1_TODAY', 'FIRST_SKILL'\n            ],\n            understanding,\n            understandingConfirmed: false,\n            phases: ONBOARDING_PHASES,\n            timeToFirstUsefulTodayReady: understanding.some((field) => field.state === 'KNOWN')\n        }\n    };\n}\nexport function confirmOnboardingUnderstanding(state, reviewer) {\n    if (reviewer.type !== 'HUMAN' || !reviewer.id) {\n        return { ok: false, error: 'HUMAN_CONFIRMATION_REQUIRED' };\n    }\n    return { ok: true, state: { ...state, understandingConfirmed: true, confirmedBy: { type: 'HUMAN', id: reviewer.id } } };\n}\n\nexport const LEADERSHIP_MISSION_PILLARS = Object.freeze({\"ORG_GOAL\":{\"label\":\"조직·목표 이해\",\"short\":\"목표 이해\",\"description\":\"회사·조직·팀의 목표와 내 역할을 연결합니다.\"},\"PEOPLE\":{\"label\":\"팀·사람 이해\",\"short\":\"팀 이해\",\"description\":\"사람을 점수화하지 않고 역할·강점·막힘·지원 필요를 이해합니다.\"},\"OPERATING\":{\"label\":\"운영 시스템\",\"short\":\"운영\",\"description\":\"일·회의·마일스톤·리듬을 반복 가능한 운영 방식으로 만듭니다.\"},\"DECISION\":{\"label\":\"결정·위임\",\"short\":\"결정/위임\",\"description\":\"누가 결정하고 어디까지 위임하는지를 명확하게 합니다.\"},\"COMM_COACH\":{\"label\":\"커뮤니케이션·코칭\",\"short\":\"소통/코칭\",\"description\":\"질문·피드백·인정·어려운 대화를 리더의 기술로 만듭니다.\"},\"SELF\":{\"label\":\"자기검증·학습\",\"short\":\"자기검증\",\"description\":\"사람이 아니라 리더 자신의 판단과 행동을 검증합니다.\"}});\nexport const LEADERSHIP_MISSIONS = Object.freeze([{\"day\":1,\"pillar\":\"ORG_GOAL\",\"title\":\"판단보다 관찰로 시작하기\",\"target\":\"새 팀의 현재 상태를 바꾸기 전에 사실·가설·모르는 것을 구분한다.\",\"stakeholder\":\"팀 전체 / 기존 문서\",\"proof\":\"Observation Log\",\"selfQuestion\":\"내가 사실보다 첫인상에 근거해 사람이나 팀을 판단한 부분은 없었나?\",\"checklist\":[{\"id\":\"D01-C01\",\"label\":\"최근 팀 목표·프로젝트·회의 자료를 모았다\",\"required\":true},{\"id\":\"D01-C02\",\"label\":\"관찰한 사실과 내 해석을 분리해 적었다\",\"required\":true},{\"id\":\"D01-C03\",\"label\":\"아직 확인하지 못한 Unknown을 3개 이상 적었다\",\"required\":true},{\"id\":\"D01-C04\",\"label\":\"첫 주에 먼저 확인할 사람과 자료를 정했다\",\"required\":true},{\"id\":\"D01-C05\",\"label\":\"오늘은 개선안을 발표하지 않고 Context 수집에 집중했다\",\"required\":true}]},{\"day\":2,\"pillar\":\"ORG_GOAL\",\"title\":\"회사·팀 목표와 내 역할 맞추기\",\"target\":\"회사 목표 → 조직 목표 → 팀 목표 → 내 역할 → 성공 기준을 상급자와 연결한다.\",\"stakeholder\":\"상급자 / 회사·조직 자료\",\"proof\":\"Manager Contract + Goal Alignment\",\"selfQuestion\":\"내가 중요하다고 생각한 것과 회사·상급자가 중요하게 보는 것이 어디서 달랐나?\",\"checklist\":[{\"id\":\"D02-C01\",\"label\":\"회사의 올해 핵심 목표를 확인했다\",\"required\":true},{\"id\":\"D02-C02\",\"label\":\"우리 조직·부서의 핵심 목표를 확인했다\",\"required\":true},{\"id\":\"D02-C03\",\"label\":\"우리 팀이 회사 목표에 기여하는 지점을 적었다\",\"required\":true},{\"id\":\"D02-C04\",\"label\":\"상급자와 첫 30일 성공 기준 3개를 합의했다\",\"required\":true},{\"id\":\"D02-C05\",\"label\":\"보고 리듬·KPI·하지 않아도 되는 일을 확인했다\",\"required\":true}]},{\"day\":3,\"pillar\":\"PEOPLE\",\"title\":\"Team Map 만들기\",\"target\":\"팀원이 누구이며 실제로 어떤 책임과 의존관계 속에서 일하는지 파악한다.\",\"stakeholder\":\"팀원 전체\",\"proof\":\"Team Map\",\"selfQuestion\":\"직급이나 평판만으로 역할을 추정한 사람은 없었나?\",\"checklist\":[{\"id\":\"D03-C01\",\"label\":\"모든 팀원의 이름·역할·주요 책임을 적었다\",\"required\":true},{\"id\":\"D03-C02\",\"label\":\"공식 직무와 실제로 맡는 일을 구분했다\",\"required\":true},{\"id\":\"D03-C03\",\"label\":\"업무상 자주 의존하는 사람·팀을 연결했다\",\"required\":true},{\"id\":\"D03-C04\",\"label\":\"각 팀원이 현재 책임지는 핵심 결과물을 확인했다\",\"required\":true},{\"id\":\"D03-C05\",\"label\":\"아직 역할이 불명확한 영역을 표시했다\",\"required\":true}]},{\"day\":4,\"pillar\":\"PEOPLE\",\"title\":\"첫 1:1 — 듣는 리더 되기\",\"target\":\"팀원의 업무·막힘·지원 필요를 직접 듣고 다음 대화를 만든다.\",\"stakeholder\":\"팀원\",\"proof\":\"1:1 Context Card\",\"selfQuestion\":\"나는 답을 주기 전에 충분히 들었나?\",\"checklist\":[{\"id\":\"D04-C01\",\"label\":\"최소 한 명과 30분 이상 1:1을 했다\",\"required\":true},{\"id\":\"D04-C02\",\"label\":\"현재 가장 중요한 업무를 물었다\",\"required\":true},{\"id\":\"D04-C03\",\"label\":\"업무에서 반복되는 막힘을 물었다\",\"required\":true},{\"id\":\"D04-C04\",\"label\":\"리더에게 필요한 지원을 물었다\",\"required\":true},{\"id\":\"D04-C05\",\"label\":\"다음 Follow-up 행동과 시점을 합의했다\",\"required\":true}]},{\"day\":5,\"pillar\":\"PEOPLE\",\"title\":\"1:1 패턴 찾기\",\"target\":\"개별 1:1을 사람 평가가 아니라 팀 운영 패턴으로 묶는다.\",\"stakeholder\":\"팀원 / 1:1 기록\",\"proof\":\"Team Pattern Board\",\"selfQuestion\":\"한 사람의 이야기를 팀 전체의 문제로 일반화하지 않았나?\",\"checklist\":[{\"id\":\"D05-C01\",\"label\":\"여러 1:1에서 반복된 이슈를 모았다\",\"required\":true},{\"id\":\"D05-C02\",\"label\":\"개인 문제와 시스템 문제를 구분했다\",\"required\":true},{\"id\":\"D05-C03\",\"label\":\"반복되는 승인·정보·역할 병목을 표시했다\",\"required\":true},{\"id\":\"D05-C04\",\"label\":\"강점은 ‘행동/기여’ 기준으로 기록했다\",\"required\":true},{\"id\":\"D05-C05\",\"label\":\"아직 추가 확인이 필요한 가설을 분리했다\",\"required\":true}]},{\"day\":6,\"pillar\":\"ORG_GOAL\",\"title\":\"Stakeholder Map 만들기\",\"target\":\"팀 밖에서 결과에 영향을 주는 핵심 이해관계자와 기대를 파악한다.\",\"stakeholder\":\"관계부서 / 상급자 / 고객\",\"proof\":\"Stakeholder Map\",\"selfQuestion\":\"내 팀의 관점만으로 다른 조직의 필요를 판단하고 있지 않나?\",\"checklist\":[{\"id\":\"D06-C01\",\"label\":\"핵심 이해관계자 5명/팀을 적었다\",\"required\":true},{\"id\":\"D06-C02\",\"label\":\"각 이해관계자가 기대하는 결과를 확인했다\",\"required\":true},{\"id\":\"D06-C03\",\"label\":\"우리 팀이 그들에게 의존하는 지점을 적었다\",\"required\":true},{\"id\":\"D06-C04\",\"label\":\"갈등 가능성이 있는 목표·일정을 표시했다\",\"required\":true},{\"id\":\"D06-C05\",\"label\":\"누구와 어떤 주기로 정렬할지 정했다\",\"required\":true}]},{\"day\":7,\"pillar\":\"SELF\",\"title\":\"Week 1 Debrief\",\"target\":\"첫 주의 관찰을 사실·가설·학습·다음 질문으로 정리한다.\",\"stakeholder\":\"리더 자신\",\"proof\":\"Week 1 AAR\",\"selfQuestion\":\"첫 주 동안 내가 너무 빨리 해결하려 했던 것은 무엇인가?\",\"checklist\":[{\"id\":\"D07-C01\",\"label\":\"첫 주에 새롭게 알게 된 사실 5개를 적었다\",\"required\":true},{\"id\":\"D07-C02\",\"label\":\"처음 가졌던 가설 중 틀린 것을 적었다\",\"required\":true},{\"id\":\"D07-C03\",\"label\":\"아직 모르는 질문을 남겼다\",\"required\":true},{\"id\":\"D07-C04\",\"label\":\"다음 주 반드시 확인할 운영 이슈 3개를 정했다\",\"required\":true},{\"id\":\"D07-C05\",\"label\":\"팀에게 성급하게 바꾸지 않을 것을 구분했다\",\"required\":true}]},{\"day\":8,\"pillar\":\"OPERATING\",\"title\":\"Team Calendar 수집하기\",\"target\":\"팀이 실제로 시간을 어디에 쓰는지 반복 일정과 리듬으로 확인한다.\",\"stakeholder\":\"팀 캘린더 / 회의\",\"proof\":\"Team Calendar\",\"selfQuestion\":\"말로 말한 우선순위와 실제 캘린더가 일치하나?\",\"checklist\":[{\"id\":\"D08-C01\",\"label\":\"반복 회의·보고·1:1 일정을 모았다\",\"required\":true},{\"id\":\"D08-C02\",\"label\":\"각 일정의 목적을 적었다\",\"required\":true},{\"id\":\"D08-C03\",\"label\":\"결정이 일어나는 회의를 표시했다\",\"required\":true},{\"id\":\"D08-C04\",\"label\":\"집중 업무 시간을 확인했다\",\"required\":true},{\"id\":\"D08-C05\",\"label\":\"팀 목표와 무관해 보이는 시간 사용을 표시했다\",\"required\":true}]},{\"day\":9,\"pillar\":\"OPERATING\",\"title\":\"회의 목적 Audit\",\"target\":\"회의마다 왜 존재하는지와 어떤 결과를 내야 하는지 명확히 한다.\",\"stakeholder\":\"회의 Owner / 참석자\",\"proof\":\"Meeting Purpose Audit\",\"selfQuestion\":\"내가 싫어하는 회의라는 이유만으로 없애려 하지는 않았나?\",\"checklist\":[{\"id\":\"D09-C01\",\"label\":\"주요 회의를 정보·논의·결정·회고로 분류했다\",\"required\":true},{\"id\":\"D09-C02\",\"label\":\"목적이 섞인 회의를 표시했다\",\"required\":true},{\"id\":\"D09-C03\",\"label\":\"회의별 Owner/Facilitator를 확인했다\",\"required\":true},{\"id\":\"D09-C04\",\"label\":\"회의가 끝날 때 남아야 할 Output을 적었다\",\"required\":true},{\"id\":\"D09-C05\",\"label\":\"없애기 전에 존재 이유를 확인했다\",\"required\":true}]},{\"day\":10,\"pillar\":\"OPERATING\",\"title\":\"Work Map 만들기\",\"target\":\"현재 진행 중인 일을 Outcome·Owner·Risk·Dependency로 한눈에 본다.\",\"stakeholder\":\"프로젝트 Owner / 팀원\",\"proof\":\"Work Map\",\"selfQuestion\":\"업무량을 보는 데 그치지 않고 실제 결과와 책임자를 보고 있나?\",\"checklist\":[{\"id\":\"D10-C01\",\"label\":\"현재 프로젝트·핵심 업무를 모두 적었다\",\"required\":true},{\"id\":\"D10-C02\",\"label\":\"각 업무의 Owner를 확인했다\",\"required\":true},{\"id\":\"D10-C03\",\"label\":\"해야 할 일보다 기대 Outcome을 적었다\",\"required\":true},{\"id\":\"D10-C04\",\"label\":\"주요 Risk/Blocker를 표시했다\",\"required\":true},{\"id\":\"D10-C05\",\"label\":\"외부 의존관계를 연결했다\",\"required\":true}]},{\"day\":11,\"pillar\":\"OPERATING\",\"title\":\"Milestone을 결과로 정의하기\",\"target\":\"날짜가 아니라 결과·근거·Owner·판단 지점으로 마일스톤을 다시 정의한다.\",\"stakeholder\":\"프로젝트 Owner\",\"proof\":\"Milestone Card\",\"selfQuestion\":\"‘언제까지’만 있고 ‘무엇이 달라져야 하는지’가 없는 일정은 없나?\",\"checklist\":[{\"id\":\"D11-C01\",\"label\":\"핵심 마일스톤을 3개 이상 확인했다\",\"required\":true},{\"id\":\"D11-C02\",\"label\":\"각 마일스톤의 완료 결과를 문장으로 적었다\",\"required\":true},{\"id\":\"D11-C03\",\"label\":\"완료를 증명할 Evidence를 정했다\",\"required\":true},{\"id\":\"D11-C04\",\"label\":\"Owner와 Due Date를 확인했다\",\"required\":true},{\"id\":\"D11-C05\",\"label\":\"다음 Decision Point를 표시했다\",\"required\":true}]},{\"day\":12,\"pillar\":\"ORG_GOAL\",\"title\":\"WVR — Work · Value · Result\",\"target\":\"팀의 일을 회사/고객 가치와 측정 가능한 결과로 연결한다.\",\"stakeholder\":\"팀 목표 / 고객·내부 고객\",\"proof\":\"WVR Card\",\"selfQuestion\":\"우리 팀이 바쁜 이유와 중요한 이유를 구분할 수 있나?\",\"checklist\":[{\"id\":\"D12-C01\",\"label\":\"핵심 업무 3개를 Work 문장으로 적었다\",\"required\":true},{\"id\":\"D12-C02\",\"label\":\"각 업무가 만드는 Value를 적었다\",\"required\":true},{\"id\":\"D12-C03\",\"label\":\"기대 Result를 측정 가능한 표현으로 바꿨다\",\"required\":true},{\"id\":\"D12-C04\",\"label\":\"가치가 불분명한 일을 표시했다\",\"required\":true},{\"id\":\"D12-C05\",\"label\":\"회사·팀 목표와 연결되지 않는 일을 확인했다\",\"required\":true}]},{\"day\":13,\"pillar\":\"ORG_GOAL\",\"title\":\"Team Top 3 Priority 정렬\",\"target\":\"팀 전체가 같은 세 가지 우선순위와 Not Now를 말할 수 있게 한다.\",\"stakeholder\":\"팀 전체 / 상급자\",\"proof\":\"Priority Contract\",\"selfQuestion\":\"내가 중요하다고 한 일이 팀원의 실제 시간 배분에도 반영됐나?\",\"checklist\":[{\"id\":\"D13-C01\",\"label\":\"이번 기간 Top 3를 정했다\",\"required\":true},{\"id\":\"D13-C02\",\"label\":\"각 Priority의 이유를 회사/팀 목표와 연결했다\",\"required\":true},{\"id\":\"D13-C03\",\"label\":\"Priority별 Owner를 확인했다\",\"required\":true},{\"id\":\"D13-C04\",\"label\":\"성공 기준을 적었다\",\"required\":true},{\"id\":\"D13-C05\",\"label\":\"Not Now 목록을 팀에 공유했다\",\"required\":true}]},{\"day\":14,\"pillar\":\"SELF\",\"title\":\"Week 2 Operating Gap Review\",\"target\":\"캘린더·업무·마일스톤·우선순위 사이의 운영 Gap을 찾는다.\",\"stakeholder\":\"리더 자신 / 운영 데이터\",\"proof\":\"Operating Gap Review\",\"selfQuestion\":\"문제를 사람의 태도로 설명하기 전에 시스템 Gap을 확인했나?\",\"checklist\":[{\"id\":\"D14-C01\",\"label\":\"Calendar와 Priority의 불일치를 찾았다\",\"required\":true},{\"id\":\"D14-C02\",\"label\":\"Owner가 모호한 업무를 표시했다\",\"required\":true},{\"id\":\"D14-C03\",\"label\":\"Milestone Evidence가 없는 항목을 찾았다\",\"required\":true},{\"id\":\"D14-C04\",\"label\":\"결정 지연으로 막힌 일을 확인했다\",\"required\":true},{\"id\":\"D14-C05\",\"label\":\"다음 주 바꿀 운영 규칙 하나를 정했다\",\"required\":true}]},{\"day\":15,\"pillar\":\"DECISION\",\"title\":\"Decision Inventory 만들기\",\"target\":\"팀에서 반복되는 중요한 결정을 목록화한다.\",\"stakeholder\":\"팀원 / 회의 / 프로젝트\",\"proof\":\"Decision Inventory\",\"selfQuestion\":\"내가 모든 결정의 병목이 되고 있는 영역은 어디인가?\",\"checklist\":[{\"id\":\"D15-C01\",\"label\":\"반복되는 핵심 결정 5개 이상을 적었다\",\"required\":true},{\"id\":\"D15-C02\",\"label\":\"현재 누가 결정하는지 확인했다\",\"required\":true},{\"id\":\"D15-C03\",\"label\":\"결정 빈도와 영향도를 적었다\",\"required\":true},{\"id\":\"D15-C04\",\"label\":\"자주 지연되는 결정을 표시했다\",\"required\":true},{\"id\":\"D15-C05\",\"label\":\"결정에 필요한 정보/Evidence를 적었다\",\"required\":true}]},{\"day\":16,\"pillar\":\"DECISION\",\"title\":\"Decision Rights — RAPID\",\"target\":\"핵심 결정의 Recommend·Input·Agree·Decide·Perform 역할을 명확히 한다.\",\"stakeholder\":\"Decider / 관계자\",\"proof\":\"Decision Rights Map\",\"selfQuestion\":\"최종 결정자가 여러 명처럼 보이는 결정은 없나?\",\"checklist\":[{\"id\":\"D16-C01\",\"label\":\"중요 결정 3개를 선택했다\",\"required\":true},{\"id\":\"D16-C02\",\"label\":\"각 결정의 최종 Decider를 한 명으로 정했다\",\"required\":true},{\"id\":\"D16-C03\",\"label\":\"Recommend와 Input 역할을 분리했다\",\"required\":true},{\"id\":\"D16-C04\",\"label\":\"Agree가 꼭 필요한 경우만 남겼다\",\"required\":true},{\"id\":\"D16-C05\",\"label\":\"결정 Deadline과 공유 방식을 정했다\",\"required\":true}]},{\"day\":17,\"pillar\":\"DECISION\",\"title\":\"Decision Case Simulation\",\"target\":\"실제 결정을 옵션·기준·Evidence·Deadline으로 연습한다.\",\"stakeholder\":\"Decider / Input 관계자\",\"proof\":\"Decision Brief\",\"selfQuestion\":\"의견이 아니라 판단 기준으로 결정을 설명할 수 있나?\",\"checklist\":[{\"id\":\"D17-C01\",\"label\":\"실제 미결정 사안 하나를 골랐다\",\"required\":true},{\"id\":\"D17-C02\",\"label\":\"가능한 옵션을 2개 이상 적었다\",\"required\":true},{\"id\":\"D17-C03\",\"label\":\"판단 기준을 명시했다\",\"required\":true},{\"id\":\"D17-C04\",\"label\":\"필요 Evidence와 부족한 정보를 구분했다\",\"required\":true},{\"id\":\"D17-C05\",\"label\":\"누가 언제 결정할지 확정했다\",\"required\":true}]},{\"day\":18,\"pillar\":\"DECISION\",\"title\":\"Delegation Inventory\",\"target\":\"리더가 직접 쥐고 있는 일과 결정을 위임 후보로 분류한다.\",\"stakeholder\":\"리더 자신 / 팀원\",\"proof\":\"Delegation Inventory\",\"selfQuestion\":\"내가 잘해서 계속 하는 일과 내가 해야만 하는 일을 구분했나?\",\"checklist\":[{\"id\":\"D18-C01\",\"label\":\"내가 직접 처리하는 반복 업무를 적었다\",\"required\":true},{\"id\":\"D18-C02\",\"label\":\"팀원이 맡을 수 있는 후보를 표시했다\",\"required\":true},{\"id\":\"D18-C03\",\"label\":\"위임 시 위험을 적었다\",\"required\":true},{\"id\":\"D18-C04\",\"label\":\"내가 놓지 못하는 이유를 적었다\",\"required\":true},{\"id\":\"D18-C05\",\"label\":\"위임하면 생기는 성장/속도 효과를 적었다\",\"required\":true}]},{\"day\":19,\"pillar\":\"DECISION\",\"title\":\"Delegation Matrix 만들기\",\"target\":\"업무별 위임 수준·권한·Guardrail·Checkpoint를 명확히 한다.\",\"stakeholder\":\"업무 담당자\",\"proof\":\"Delegation Matrix\",\"selfQuestion\":\"위임이 ‘일 시키기’가 아니라 권한과 기준을 넘기는 구조가 되었나?\",\"checklist\":[{\"id\":\"D19-C01\",\"label\":\"위임 후보별 권한 수준을 정했다\",\"required\":true},{\"id\":\"D19-C02\",\"label\":\"결과 기준을 명확히 적었다\",\"required\":true},{\"id\":\"D19-C03\",\"label\":\"하면 안 되는 Guardrail을 적었다\",\"required\":true},{\"id\":\"D19-C04\",\"label\":\"중간 Checkpoint를 정했다\",\"required\":true},{\"id\":\"D19-C05\",\"label\":\"문제가 생기면 Escalation할 조건을 정했다\",\"required\":true}]},{\"day\":20,\"pillar\":\"DECISION\",\"title\":\"실제 업무 하나 위임하기\",\"target\":\"실제 업무에 위임 계약을 적용하고 이해 여부를 확인한다.\",\"stakeholder\":\"위임받는 팀원\",\"proof\":\"Delegation Contract\",\"selfQuestion\":\"결과를 맡겼는가, 방법까지 통제하고 있는가?\",\"checklist\":[{\"id\":\"D20-C01\",\"label\":\"실제 업무 하나를 선택했다\",\"required\":true},{\"id\":\"D20-C02\",\"label\":\"Outcome과 완료 기준을 설명했다\",\"required\":true},{\"id\":\"D20-C03\",\"label\":\"권한 범위를 명확히 말했다\",\"required\":true},{\"id\":\"D20-C04\",\"label\":\"Checkpoint와 Deadline을 합의했다\",\"required\":true},{\"id\":\"D20-C05\",\"label\":\"상대가 이해한 내용을 자신의 말로 설명하게 했다\",\"required\":true}]},{\"day\":21,\"pillar\":\"SELF\",\"title\":\"Week 3 Bottleneck Debrief\",\"target\":\"결정·위임 변경 후 실제 흐름이 빨라졌는지 확인한다.\",\"stakeholder\":\"리더 자신 / 팀원\",\"proof\":\"Delegation AAR\",\"selfQuestion\":\"내 불안 때문에 다시 권한을 회수한 순간은 없었나?\",\"checklist\":[{\"id\":\"D21-C01\",\"label\":\"변경 전 병목을 적었다\",\"required\":true},{\"id\":\"D21-C02\",\"label\":\"결정 속도/대기 시간이 어떻게 달라졌는지 봤다\",\"required\":true},{\"id\":\"D21-C03\",\"label\":\"팀원이 스스로 결정한 사례를 확인했다\",\"required\":true},{\"id\":\"D21-C04\",\"label\":\"내가 다시 가져온 권한이 있었는지 적었다\",\"required\":true},{\"id\":\"D21-C05\",\"label\":\"다음 주 유지/수정할 Guardrail을 정했다\",\"required\":true}]},{\"day\":22,\"pillar\":\"COMM_COACH\",\"title\":\"SBI+Intent 피드백 실행\",\"target\":\"사람 평가 대신 관찰 가능한 행동·영향·질문으로 실제 피드백을 한다.\",\"stakeholder\":\"피드백 대상 팀원\",\"proof\":\"Feedback Practice\",\"selfQuestion\":\"나는 사람을 평가했나, 행동과 영향에 대해 대화했나?\",\"checklist\":[{\"id\":\"D22-C01\",\"label\":\"피드백할 Situation을 구체적으로 적었다\",\"required\":true},{\"id\":\"D22-C02\",\"label\":\"성격이 아닌 관찰 가능한 Behavior를 적었다\",\"required\":true},{\"id\":\"D22-C03\",\"label\":\"업무/팀에 미친 Impact를 설명했다\",\"required\":true},{\"id\":\"D22-C04\",\"label\":\"상대의 의도를 묻는 Inquiry를 준비했다\",\"required\":true},{\"id\":\"D22-C05\",\"label\":\"다음 행동/기대를 함께 합의했다\",\"required\":true}]},{\"day\":23,\"pillar\":\"COMM_COACH\",\"title\":\"칭찬을 행동 학습으로 바꾸기\",\"target\":\"좋았던 행동과 영향을 구체적으로 말해 반복 가능한 학습으로 만든다.\",\"stakeholder\":\"팀원\",\"proof\":\"Recognition Note\",\"selfQuestion\":\"칭찬이 기분 좋은 말에 그치지 않고 학습 포인트가 되었나?\",\"checklist\":[{\"id\":\"D23-C01\",\"label\":\"구체적인 좋은 행동을 하나 골랐다\",\"required\":true},{\"id\":\"D23-C02\",\"label\":\"그 행동이 만든 Impact를 설명했다\",\"required\":true},{\"id\":\"D23-C03\",\"label\":\"막연한 ‘잘했어요’를 사용하지 않았다\",\"required\":true},{\"id\":\"D23-C04\",\"label\":\"앞으로 반복했으면 하는 행동을 말했다\",\"required\":true},{\"id\":\"D23-C05\",\"label\":\"상대가 어떤 선택을 했는지 물었다\",\"required\":true}]},{\"day\":24,\"pillar\":\"COMM_COACH\",\"title\":\"1:1에서 답 대신 질문하기\",\"target\":\"리더가 답을 주기 전에 팀원의 사고와 선택을 끌어낸다.\",\"stakeholder\":\"팀원\",\"proof\":\"Coaching Question Set\",\"selfQuestion\":\"내 답을 증명하는 질문이 아니라 상대의 사고를 여는 질문을 했나?\",\"checklist\":[{\"id\":\"D24-C01\",\"label\":\"문제를 들은 뒤 바로 답하지 않았다\",\"required\":true},{\"id\":\"D24-C02\",\"label\":\"상황을 더 이해하는 질문을 했다\",\"required\":true},{\"id\":\"D24-C03\",\"label\":\"선택지를 스스로 말하게 했다\",\"required\":true},{\"id\":\"D24-C04\",\"label\":\"본인이 추천하는 다음 행동을 물었다\",\"required\":true},{\"id\":\"D24-C05\",\"label\":\"필요한 지원만 합의했다\",\"required\":true}]},{\"day\":25,\"pillar\":\"COMM_COACH\",\"title\":\"어려운 대화 준비하기\",\"target\":\"감정적 언어를 사실·영향·기대·지원의 언어로 바꾼다.\",\"stakeholder\":\"팀원 / 관계자\",\"proof\":\"Difficult Conversation Plan\",\"selfQuestion\":\"내 감정을 전달하는 것이 목적이 아니라 일을 더 잘하게 하는 대화가 되었나?\",\"checklist\":[{\"id\":\"D25-C01\",\"label\":\"관찰 가능한 사실을 적었다\",\"required\":true},{\"id\":\"D25-C02\",\"label\":\"업무/팀에 미친 영향을 적었다\",\"required\":true},{\"id\":\"D25-C03\",\"label\":\"‘너는 원래’ 같은 인격 평가를 제거했다\",\"required\":true},{\"id\":\"D25-C04\",\"label\":\"앞으로 기대하는 행동을 구체화했다\",\"required\":true},{\"id\":\"D25-C05\",\"label\":\"상대 관점과 필요한 지원을 물을 질문을 준비했다\",\"required\":true}]},{\"day\":26,\"pillar\":\"SELF\",\"title\":\"프로젝트 Debrief — AAR\",\"target\":\"Expected·Actual·Why·Learn·Next로 팀의 경험을 다음 실행에 연결한다.\",\"stakeholder\":\"프로젝트 팀\",\"proof\":\"Project AAR\",\"selfQuestion\":\"실패 원인을 특정 사람에게 돌리기 전에 과정과 판단을 검토했나?\",\"checklist\":[{\"id\":\"D26-C01\",\"label\":\"처음 기대한 결과를 적었다\",\"required\":true},{\"id\":\"D26-C02\",\"label\":\"실제 결과를 사실 기준으로 적었다\",\"required\":true},{\"id\":\"D26-C03\",\"label\":\"차이가 생긴 이유를 시스템/판단 관점에서 봤다\",\"required\":true},{\"id\":\"D26-C04\",\"label\":\"유지할 행동과 바꿀 행동을 구분했다\",\"required\":true},{\"id\":\"D26-C05\",\"label\":\"다음 프로젝트에서 적용할 한 가지를 정했다\",\"required\":true}]},{\"day\":27,\"pillar\":\"OPERATING\",\"title\":\"Process Change 하나 실험하기\",\"target\":\"회고에서 나온 학습을 작은 운영 실험으로 바꾼다.\",\"stakeholder\":\"프로세스 Owner / 팀\",\"proof\":\"Process Experiment\",\"selfQuestion\":\"큰 제도 변경보다 검증 가능한 작은 실험으로 만들었나?\",\"checklist\":[{\"id\":\"D27-C01\",\"label\":\"바꿀 프로세스 하나를 선택했다\",\"required\":true},{\"id\":\"D27-C02\",\"label\":\"왜 바꾸는지 가설을 적었다\",\"required\":true},{\"id\":\"D27-C03\",\"label\":\"Owner를 정했다\",\"required\":true},{\"id\":\"D27-C04\",\"label\":\"실험 기간과 성공 지표를 정했다\",\"required\":true},{\"id\":\"D27-C05\",\"label\":\"언제 Review할지 캘린더에 넣었다\",\"required\":true}]},{\"day\":28,\"pillar\":\"OPERATING\",\"title\":\"Team Operating Rhythm 확정\",\"target\":\"Priority·1:1·Decision·Debrief·Reporting을 반복 가능한 주기로 만든다.\",\"stakeholder\":\"팀 전체 / 상급자\",\"proof\":\"Operating Rhythm v1\",\"selfQuestion\":\"이 운영 리듬이 리더 개인의 기억이 아니라 캘린더와 규칙으로 남았나?\",\"checklist\":[{\"id\":\"D28-C01\",\"label\":\"Weekly Priority 정렬 시간을 정했다\",\"required\":true},{\"id\":\"D28-C02\",\"label\":\"1:1 주기와 기본 Agenda를 정했다\",\"required\":true},{\"id\":\"D28-C03\",\"label\":\"Decision Review 주기를 정했다\",\"required\":true},{\"id\":\"D28-C04\",\"label\":\"Debrief/AAR 리듬을 정했다\",\"required\":true},{\"id\":\"D28-C05\",\"label\":\"상급자 Reporting 리듬을 정했다\",\"required\":true}]},{\"day\":29,\"pillar\":\"SELF\",\"title\":\"Leader Self Review\",\"target\":\"팀원이 아니라 지난 29일의 내 리더십 선택과 습관을 검증한다.\",\"stakeholder\":\"리더 자신 / 팀 피드백\",\"proof\":\"Leader Review\",\"selfQuestion\":\"나는 ‘좋은 리더처럼 보였는가’가 아니라 실제 팀이 더 명확하게 움직였는가를 보고 있나?\",\"checklist\":[{\"id\":\"D29-C01\",\"label\":\"내가 잘한 리더 행동 3개를 Evidence로 적었다\",\"required\":true},{\"id\":\"D29-C02\",\"label\":\"너무 빨리 판단했던 순간을 적었다\",\"required\":true},{\"id\":\"D29-C03\",\"label\":\"결정을 과도하게 쥐고 있었던 사례를 적었다\",\"required\":true},{\"id\":\"D29-C04\",\"label\":\"질문/코칭이 효과적이었던 사례를 적었다\",\"required\":true},{\"id\":\"D29-C05\",\"label\":\"다음 60일에 바꿀 리더 행동 2개를 정했다\",\"required\":true}]},{\"day\":30,\"pillar\":\"ORG_GOAL\",\"title\":\"Team OS Charter + Next 60 Days\",\"target\":\"30일의 학습을 팀이 실제로 사용할 운영 원칙과 다음 60일 계획으로 통합한다.\",\"stakeholder\":\"팀 전체 / 상급자\",\"proof\":\"Team OS Charter + Next 60 Plan\",\"selfQuestion\":\"30일이 끝난 뒤에도 팀이 이 운영체계를 스스로 사용할 수 있는가?\",\"checklist\":[{\"id\":\"D30-C01\",\"label\":\"팀 목적·Top Priority·성공 기준을 Charter에 넣었다\",\"required\":true},{\"id\":\"D30-C02\",\"label\":\"역할·Decision Rights·Delegation 원칙을 넣었다\",\"required\":true},{\"id\":\"D30-C03\",\"label\":\"회의·1:1·피드백·Debrief 리듬을 넣었다\",\"required\":true},{\"id\":\"D30-C04\",\"label\":\"팀/상급자와 Charter를 검토했다\",\"required\":true},{\"id\":\"D30-C05\",\"label\":\"다음 60일 Outcome·Experiment·Review Date를 정했다\",\"required\":true}]}]);\nexport const LEADERSHIP_QUEST_PHASES = Object.freeze({\"UNDERSTAND\":{\"days\":\"1–7\",\"goal\":\"판단보다 이해 · 사람과 일의 실제 흐름 파악\",\"color\":\"#0f766e\"},\"ALIGN\":{\"days\":\"8–14\",\"goal\":\"목표·시간·마일스톤을 같은 기준으로 정렬\",\"color\":\"#2563eb\"},\"EMPOWER\":{\"days\":\"15–21\",\"goal\":\"결정권과 위임을 명확히 해 팀이 움직이게 하기\",\"color\":\"#7c3aed\"},\"COACH\":{\"days\":\"22–30\",\"goal\":\"피드백·코칭·회고를 반복 가능한 습관으로 만들기\",\"color\":\"#c2410c\"}});\nexport const LEADERSHIP_QUESTS = Object.freeze([{\"day\":1,\"phase\":\"UNDERSTAND\",\"title\":\"판단보다 관찰로 시작하기\",\"duration\":\"20–30분\",\"outcome\":\"새 팀에 대한 첫인상을 Fact / Hypothesis / Unknown으로 분리한다.\",\"knowledge\":\"새 역할의 초반에는 ‘고치기’보다 조직과 팀의 실제 작동 방식을 빠르게 학습하는 것이 중요합니다.\",\"case\":\"첫 출근 3일째. 회의가 길고 승인도 느립니다. 바로 회의를 줄이고 승인 절차를 바꾸고 싶습니다.\",\"practice\":[\"오늘 본 팀의 반복 행동 5개를 적습니다.\",\"각 항목을 FACT / HYPOTHESIS / UNKNOWN으로 분류합니다.\",\"아직 확인하지 않은 원인을 ‘사람의 문제’로 단정하지 않습니다.\"],\"artifact\":\"Observation Log\",\"evidence\":\"Fact 3개 + Hypothesis 2개 + 확인 질문 2개\",\"debrief\":[\"나는 오늘 무엇을 너무 빨리 해석했나?\",\"확인 전까지 보류해야 할 판단은 무엇인가?\"],\"nudge\":\"고치기 전에 패턴을 3번 이상 관찰했나요?\",\"route\":\"TEAM\",\"sources\":[\"WHARTON\",\"HBR90\"]},{\"day\":2,\"phase\":\"UNDERSTAND\",\"title\":\"회사·팀 목표와 내 역할 맞추기\",\"duration\":\"30분\",\"outcome\":\"회사 목표 → 조직 목표 → 팀 목표 → 내 역할 → 첫 30일 성공 기준을 상급자와 연결한다.\",\"knowledge\":\"새 팀장은 사람만 파악하면 부족합니다. 회사와 조직이 무엇을 이루려는지, 그 안에서 팀이 왜 존재하는지, 그리고 리더에게 기대하는 성공을 먼저 연결해야 합니다.\",\"case\":\"상급자는 ‘빨리 안정화해달라’고 말했고 팀은 신규 프로젝트와 기존 운영 사이에서 우선순위를 다르게 이해하고 있습니다. 회사 목표와 팀 목표의 연결부터 확인해야 합니다.\",\"practice\":[\"회사의 올해 핵심 목표와 우리 조직의 목표를 확인합니다.\",\"우리 팀이 회사 목표에 기여하는 지점을 한 문장으로 적습니다.\",\"상급자와 ‘30일 뒤 무엇이 달라져 있으면 성공인가?’를 합의합니다.\",\"Top 3 기대 결과·KPI·하지 않아도 되는 일을 분리합니다.\",\"보고 빈도와 결정이 필요한 사안을 합의합니다.\"],\"artifact\":\"Manager Contract + Goal Alignment\",\"evidence\":\"회사/조직/팀 목표 연결 + 30일 성공 기준 3개 + KPI + 보고 리듬\",\"debrief\":[\"회사·상급자의 기대와 내가 중요하다고 본 것이 어디서 달랐나?\",\"팀원에게 전달해야 할 ‘왜 이 일을 하는가’의 맥락은 무엇인가?\"],\"nudge\":\"팀 목표를 회사 목표와 연결해서 설명할 수 있나요?\",\"route\":\"WORK_REPORTS\",\"sources\":[\"HBR90\"]},{\"day\":3,\"phase\":\"UNDERSTAND\",\"title\":\"Team Map 만들기\",\"duration\":\"30–45분\",\"outcome\":\"누가 무슨 책임을 맡고 어떤 의존관계 속에서 일하는지 보이게 만든다.\",\"knowledge\":\"조직도는 보고선만 보여줍니다. 실제 운영에는 역할·의존성·미확인 영역이 더 중요합니다.\",\"case\":\"직함은 PM인 두 사람이 실제로는 한 명은 고객, 한 명은 내부 운영을 맡고 있습니다.\",\"practice\":[\"팀원별 핵심 책임 1~3개를 기록합니다.\",\"자주 협업하는 사람·팀을 연결합니다.\",\"모르는 역할은 UNKNOWN으로 남깁니다.\"],\"artifact\":\"Team Map\",\"evidence\":\"팀원 전원의 Role / Current Work / Dependency / Unknown\",\"debrief\":[\"실제 권한과 직함이 다른 사람은 누구인가?\",\"한 사람에게 의존성이 몰려 있는가?\"],\"nudge\":\"사람을 평가하지 말고 ‘역할과 흐름’을 먼저 그려보세요.\",\"route\":\"TEAM\",\"sources\":[\"WHARTON\"]},{\"day\":4,\"phase\":\"UNDERSTAND\",\"title\":\"첫 1:1 — 듣는 리더 되기\",\"duration\":\"30분\",\"outcome\":\"팀원의 업무·막힘·필요 지원을 직접 확인한다.\",\"knowledge\":\"관계 기반 리더십 학습은 실제 상호작용 속에서 자신의 행동이 상대에게 미치는 영향을 관찰하고 피드백받을 때 강화됩니다.\",\"case\":\"팀원이 ‘괜찮습니다’라고만 답합니다. 팀장은 조언을 많이 해주려 합니다.\",\"practice\":[\"최근 가장 중요한 일은 무엇인지 묻습니다.\",\"무엇이 일을 느리게 하는지 묻습니다.\",\"리더에게 필요한 지원이 무엇인지 묻습니다.\",\"해결책을 말하기 전에 한 번 더 질문합니다.\"],\"artifact\":\"1:1 Context Card\",\"evidence\":\"Priority / Blocker / Decision Needed / Support Needed\",\"debrief\":[\"내가 말한 시간과 질문한 시간은 어느 쪽이 더 길었나?\",\"내가 답을 대신 준 순간은 있었나?\"],\"nudge\":\"Tell보다 Ask를 한 번 더 해보세요.\",\"route\":\"ONE_ON_ONE\",\"sources\":[\"STANFORD\"]},{\"day\":5,\"phase\":\"UNDERSTAND\",\"title\":\"1:1 패턴 찾기\",\"duration\":\"30분\",\"outcome\":\"개별 이야기를 사람 평가가 아닌 팀 운영 패턴으로 묶는다.\",\"knowledge\":\"한 사람의 불편은 개인 문제일 수 있지만 여러 사람에게 반복되면 운영 시스템 문제일 가능성이 커집니다.\",\"case\":\"세 명의 팀원이 서로 다른 표현으로 ‘승인 대기’를 이야기했습니다.\",\"practice\":[\"1:1 메모에서 반복되는 blocker를 묶습니다.\",\"개인 이슈와 시스템 이슈를 분리합니다.\",\"반복되는 질문을 팀 운영 가설로 작성합니다.\"],\"artifact\":\"Team Pattern Board\",\"evidence\":\"반복 이슈 3개 + 가설 + 확인할 증거\",\"debrief\":[\"한 사람의 문제로 봤던 것이 시스템 문제였던 것은?\",\"추가로 누구에게 확인해야 하나?\"],\"nudge\":\"한 번의 사례보다 반복 패턴을 찾으세요.\",\"route\":\"ONE_ON_ONE\",\"sources\":[\"WHARTON\",\"STANFORD\"]},{\"day\":6,\"phase\":\"UNDERSTAND\",\"title\":\"Stakeholder Map 만들기\",\"duration\":\"30분\",\"outcome\":\"팀 밖에서 결과에 영향을 주는 이해관계자와 기대를 파악한다.\",\"knowledge\":\"새 리더는 공식 조직도뿐 아니라 실제 의사결정·정보·자원 흐름을 이해해야 합니다.\",\"case\":\"팀은 대표 승인을 기다리지만 실제로는 재무팀의 사전 확인이 없으면 아무 것도 진행되지 않습니다.\",\"practice\":[\"내 팀 결과에 영향을 주는 외부 이해관계자를 적습니다.\",\"각 사람의 기대·필요 정보·결정 영향력을 기록합니다.\",\"정기적으로 맞춰야 할 관계를 표시합니다.\"],\"artifact\":\"Stakeholder Map\",\"evidence\":\"핵심 이해관계자 5명 + 기대 + 접점\",\"debrief\":[\"공식 권한보다 실제 영향력이 큰 사람은 누구인가?\",\"내가 아직 만나지 않은 핵심 관계는?\"],\"nudge\":\"팀 밖의 ‘숨은 의존성’을 찾으세요.\",\"route\":\"TEAM\",\"sources\":[\"HBR90\"]},{\"day\":7,\"phase\":\"UNDERSTAND\",\"title\":\"Week 1 Debrief\",\"duration\":\"20분\",\"outcome\":\"첫 주 관찰을 사실·가설·학습으로 정리한다.\",\"knowledge\":\"AAR은 ‘누가 잘못했나’를 찾는 대신 기대와 실제의 차이를 통해 다음 수행을 개선하는 학습 루프입니다.\",\"case\":\"첫 주에 바꾸고 싶은 것이 10개 생겼습니다. 하지만 무엇부터 바꿔야 할지 불분명합니다.\",\"practice\":[\"예상했던 팀 모습과 실제를 비교합니다.\",\"잘 작동하는 것 / 막히는 것 / 아직 모르는 것을 나눕니다.\",\"다음 주에 확인할 가설 3개를 고릅니다.\"],\"artifact\":\"Week 1 AAR\",\"evidence\":\"Expected / Actual / Gap / Learn / Next\",\"debrief\":[\"첫 주에 가장 크게 바뀐 내 가정은?\",\"다음 주까지 판단을 보류할 것은?\"],\"nudge\":\"회고의 목적은 평가가 아니라 다음 행동을 더 정확히 만드는 것입니다.\",\"route\":\"REVIEW\",\"sources\":[\"ARMY_AAR\"]},{\"day\":8,\"phase\":\"ALIGN\",\"title\":\"Team Calendar 수집하기\",\"duration\":\"30분\",\"outcome\":\"팀이 실제로 시간을 어디에 쓰는지 한 주 단위로 시각화한다.\",\"knowledge\":\"캘린더는 일정표가 아니라 팀의 운영 리듬과 병목을 보여주는 데이터입니다.\",\"case\":\"회의가 많다고 느끼지만 어떤 회의가 필요한지 근거가 없습니다.\",\"practice\":[\"모든 반복 회의를 수집합니다.\",\"Ritual / 1:1 / Milestone / Decision / External / Debrief로 분류합니다.\",\"각 일정의 목적과 산출물을 한 줄로 적습니다.\"],\"artifact\":\"Team Calendar\",\"evidence\":\"반복 일정 전수 + 목적 + Owner + Output\",\"debrief\":[\"상태 공유만 하는 회의는 몇 개인가?\",\"결정 회의인데 결정권자가 없는 일정은?\"],\"nudge\":\"시간을 보면 팀의 실제 우선순위가 보입니다.\",\"route\":\"MEETINGS\",\"sources\":[\"BAIN_RAPID\"]},{\"day\":9,\"phase\":\"ALIGN\",\"title\":\"회의 목적 Audit\",\"duration\":\"30분\",\"outcome\":\"회의를 정보공유·논의·결정·회고로 구분하고 불필요한 혼합을 줄인다.\",\"knowledge\":\"결정이 필요한 회의는 누가 어떤 기준으로 언제 결정할지 미리 명시할수록 실행으로 이어지기 쉽습니다.\",\"case\":\"60분 회의에서 50분을 보고하고 마지막 10분에 중요한 결정을 급하게 합니다.\",\"practice\":[\"각 회의의 목적을 한 가지로 정합니다.\",\"결정 회의에는 Decision Owner와 Decision Deadline을 넣습니다.\",\"비동기로 대체 가능한 보고를 표시합니다.\"],\"artifact\":\"Meeting Purpose Audit\",\"evidence\":\"유지 / 변경 / 비동기 전환 회의 목록\",\"debrief\":[\"회의가 아니라 문서로 대체할 수 있는 것은?\",\"결정을 위해 꼭 필요한 사람만 참석하고 있는가?\"],\"nudge\":\"회의 전에 ‘이 시간이 끝나면 무엇이 달라져야 하나?’를 적으세요.\",\"route\":\"MEETINGS\",\"sources\":[\"BAIN_RAPID\"]},{\"day\":10,\"phase\":\"ALIGN\",\"title\":\"Work Map 만들기\",\"duration\":\"30–45분\",\"outcome\":\"현재 진행 중인 프로젝트와 Owner·목표·리스크를 한눈에 본다.\",\"knowledge\":\"리더가 직접 모든 일을 관리하기보다 팀의 핵심 결과물과 의존 관계를 보이게 만들어야 합니다.\",\"case\":\"팀원마다 ‘가장 중요한 프로젝트’라고 말하는 일이 다릅니다.\",\"practice\":[\"현재 프로젝트를 모두 적습니다.\",\"각 프로젝트의 Goal / Owner / Next Milestone / Open Decision을 채웁니다.\",\"Owner가 없거나 Goal이 모호한 일을 표시합니다.\"],\"artifact\":\"Work Map\",\"evidence\":\"핵심 프로젝트별 Goal / Owner / Milestone / Decision\",\"debrief\":[\"Owner 없는 일은 무엇인가?\",\"진행 중이지만 왜 하는지 설명하기 어려운 일은?\"],\"nudge\":\"업무량보다 ‘명확한 Owner와 다음 Milestone’을 확인하세요.\",\"route\":\"WORK\",\"sources\":[\"WHARTON\"]},{\"day\":11,\"phase\":\"ALIGN\",\"title\":\"Milestone을 결과로 정의하기\",\"duration\":\"30분\",\"outcome\":\"날짜 중심 일정에서 Outcome·Evidence·Owner·Decision 중심 마일스톤으로 바꾼다.\",\"knowledge\":\"마일스톤은 단순 날짜가 아니라 다음 판단을 가능하게 하는 검증 가능한 결과 지점이어야 합니다.\",\"case\":\"‘10/15 중간보고’가 잡혀 있지만 무엇이 준비되어야 하는지 아무도 모릅니다.\",\"practice\":[\"중요 프로젝트의 다음 마일스톤 3개를 고릅니다.\",\"Outcome / Evidence / Owner / Decision을 각각 작성합니다.\",\"완료 기준이 없는 마일스톤을 다시 씁니다.\"],\"artifact\":\"Milestone Card\",\"evidence\":\"3개 Milestone의 Outcome / Evidence / Owner / Decision\",\"debrief\":[\"날짜만 있고 결과 기준이 없던 일정은?\",\"마일스톤에서 결정해야 할 것이 분명한가?\"],\"nudge\":\"‘언제’보다 ‘그때 무엇을 결정할 수 있어야 하는가’를 먼저 적으세요.\",\"route\":\"WORK\",\"sources\":[\"BAIN_RAPID\"]},{\"day\":12,\"phase\":\"ALIGN\",\"title\":\"WVR — Work · Value · Result\",\"duration\":\"25분\",\"outcome\":\"업무를 ‘할 일’이 아니라 가치와 결과가 연결된 문장으로 바꾼다.\",\"knowledge\":\"업무의 목적과 완료 기준이 보이면 팀원은 리더의 머릿속 기준을 추측하지 않아도 됩니다.\",\"case\":\"‘제안서 수정’이라는 업무가 반복되지만 무엇이 좋아져야 하는지는 공유되지 않습니다.\",\"practice\":[\"핵심 업무 3개를 고릅니다.\",\"Work: 무엇을 하는가 / Value: 누구에게 어떤 가치인가 / Result: 무엇이 달라지면 완료인가를 작성합니다.\",\"측정이 어려운 일은 숫자 대신 관찰 가능한 Evidence를 둡니다.\"],\"artifact\":\"WVR Card\",\"evidence\":\"업무 3개의 W / V / R\",\"debrief\":[\"팀원이 내 설명 없이도 Done을 판단할 수 있는가?\",\"Value가 없는 업무는 왜 계속하고 있는가?\"],\"nudge\":\"Task만 주지 말고 ‘Why + Done’을 함께 주세요.\",\"route\":\"WORK\",\"sources\":[\"WHARTON\"]},{\"day\":13,\"phase\":\"ALIGN\",\"title\":\"Team Top 3 Priority 정렬\",\"duration\":\"30분\",\"outcome\":\"팀 전체가 같은 세 가지 우선순위를 말할 수 있게 만든다.\",\"knowledge\":\"정렬은 모두가 같은 일을 하는 것이 아니라 무엇을 먼저 보호할지 같은 기준을 갖는 것입니다.\",\"case\":\"모든 프로젝트가 P1이라 실제 우선순위가 없습니다.\",\"practice\":[\"현재 업무에서 Top 3만 선택합니다.\",\"각 우선순위의 이유와 포기하거나 미룰 일을 함께 적습니다.\",\"팀과 상급자에게 동일한 문장으로 확인합니다.\"],\"artifact\":\"Priority Contract\",\"evidence\":\"Top 3 + 이유 + Not Now 목록\",\"debrief\":[\"무엇을 ‘안 하기로’ 했는가?\",\"팀원들이 각자 Top 3를 같은 순서로 말하는가?\"],\"nudge\":\"우선순위는 추가가 아니라 선택입니다.\",\"route\":\"TODAY\",\"sources\":[\"WHARTON\",\"HBR90\"]},{\"day\":14,\"phase\":\"ALIGN\",\"title\":\"Week 2 Operating Gap Review\",\"duration\":\"20분\",\"outcome\":\"팀 캘린더·업무·마일스톤에서 운영상 빈틈을 찾는다.\",\"knowledge\":\"시스템을 바꾸기 전에 반복되는 병목이 어디에서 생기는지 Evidence로 확인합니다.\",\"case\":\"일정은 많은데 중요한 결정은 계속 늦어집니다.\",\"practice\":[\"회의·프로젝트·마일스톤을 나란히 봅니다.\",\"Owner 없음 / Decision 없음 / Evidence 없음 / 중복 회의를 표시합니다.\",\"다음 주에 바꿀 운영 규칙 1개만 고릅니다.\"],\"artifact\":\"Operating Gap Review\",\"evidence\":\"Gap 3개 + 다음 실험 1개\",\"debrief\":[\"우리 팀의 가장 큰 운영 병목은 사람인가, 구조인가?\",\"한 주에 하나만 바꾼다면 무엇인가?\"],\"nudge\":\"문제를 한꺼번에 고치지 말고 가장 영향 큰 운영 규칙 하나를 실험하세요.\",\"route\":\"REVIEW\",\"sources\":[\"ARMY_AAR\"]},{\"day\":15,\"phase\":\"EMPOWER\",\"title\":\"Decision Inventory 만들기\",\"duration\":\"30분\",\"outcome\":\"팀에서 반복되는 중요한 결정을 목록화한다.\",\"knowledge\":\"결정권을 명확히 하려면 먼저 어떤 결정이 반복되고 가치에 영향을 주는지 알아야 합니다.\",\"case\":\"‘팀장 승인’이 필요한 일이 너무 많지만 정확히 무엇이 승인 대상인지 정의되지 않았습니다.\",\"practice\":[\"최근 2주간 팀장에게 올라온 결정을 적습니다.\",\"가치 영향과 빈도로 상위 10개를 고릅니다.\",\"결정이 늦어지는 이유를 함께 적습니다.\"],\"artifact\":\"Decision Inventory\",\"evidence\":\"Critical Decision 10개 + 현재 병목\",\"debrief\":[\"내가 불필요하게 쥐고 있는 결정은?\",\"결정이 아니라 정보 공유인데 승인처럼 운영되는 것은?\"],\"nudge\":\"위임 전에 ‘무슨 결정을 누가 매번 하는가’를 먼저 보세요.\",\"route\":\"DECISIONS\",\"sources\":[\"BAIN_RAPID\"]},{\"day\":16,\"phase\":\"EMPOWER\",\"title\":\"Decision Rights — RAPID로 역할 분리\",\"duration\":\"35분\",\"outcome\":\"핵심 결정의 Recommend / Input / Agree / Decide / Perform을 분명히 한다.\",\"knowledge\":\"RAPID는 중요한 결정에서 추천·입력·동의·최종결정·실행 역할을 분리해 책임의 모호함을 줄입니다.\",\"case\":\"신규 캠페인 예산을 PM, 팀장, 재무, 대표가 모두 ‘승인’한다고 생각합니다.\",\"practice\":[\"Critical Decision 3개를 고릅니다.\",\"각 결정에 R / I / A / D / P를 지정합니다.\",\"D는 하나만 두고 A는 꼭 필요한 경우에만 둡니다.\"],\"artifact\":\"Decision Rights Map\",\"evidence\":\"3개 결정의 RAPID 역할표\",\"debrief\":[\"D가 두 명 이상인 결정은?\",\"Input이 너무 많아 결정이 느려지는 곳은?\"],\"nudge\":\"중요한 결정에는 ‘누가 D인가?’를 한 문장으로 말할 수 있어야 합니다.\",\"route\":\"DECISIONS\",\"sources\":[\"BAIN_RAPID\"]},{\"day\":17,\"phase\":\"EMPOWER\",\"title\":\"Decision Case Simulation\",\"duration\":\"30분\",\"outcome\":\"실제 결정을 Case로 연습하며 기준·옵션·Deadline을 명확히 한다.\",\"knowledge\":\"좋은 결정은 ‘무엇을 할까?’보다 목표와 기준, 진짜 대안, 결정 시점을 먼저 명확히 합니다.\",\"case\":\"콘텐츠 출시를 일주일 미룰지 그대로 갈지 논쟁 중입니다. 품질·매출·고객 약속이 충돌합니다.\",\"practice\":[\"결정 질문을 한 문장으로 다시 씁니다.\",\"결정 기준 3개와 실제 대안 2개 이상을 만듭니다.\",\"D가 언제까지 결정할지 지정합니다.\"],\"artifact\":\"Decision Brief\",\"evidence\":\"Question / Criteria / Options / D / Deadline\",\"debrief\":[\"의견 충돌이 사실은 기준 충돌이었던 부분은?\",\"추가 정보가 정말 결정을 바꿀 만큼 중요한가?\"],\"nudge\":\"토론이 길어지면 ‘무슨 기준으로 언제 누가 결정하는가’를 다시 확인하세요.\",\"route\":\"DECISIONS\",\"sources\":[\"BAIN_RAPID\"]},{\"day\":18,\"phase\":\"EMPOWER\",\"title\":\"Delegation Inventory\",\"duration\":\"25분\",\"outcome\":\"리더가 직접 쥐고 있는 업무·결정을 위임 후보로 분류한다.\",\"knowledge\":\"위임은 일을 떠넘기는 것이 아니라 권한·책임·자원·지원까지 함께 넘기는 리더십 행동입니다.\",\"case\":\"팀장이 모든 문서의 최종 문장을 직접 고치느라 전략 업무가 밀립니다.\",\"practice\":[\"이번 주 내가 직접 처리한 반복 업무를 적습니다.\",\"나만 해야 하는 일 / 다른 사람이 성장하며 맡을 수 있는 일 / 즉시 위임 가능한 일을 분리합니다.\",\"위임 후보 3개를 고릅니다.\"],\"artifact\":\"Delegation Inventory\",\"evidence\":\"Keep / Grow / Delegate 목록\",\"debrief\":[\"내가 ‘내가 하면 더 빠르다’는 이유로 쥔 일은?\",\"위임하지 않아 팀원의 성장을 막는 일은?\"],\"nudge\":\"위임은 시간 절약뿐 아니라 팀의 판단력을 키우는 투자입니다.\",\"route\":\"WORK\",\"sources\":[\"CCL_DELEGATION\"]},{\"day\":19,\"phase\":\"EMPOWER\",\"title\":\"Delegation Matrix 만들기\",\"duration\":\"35분\",\"outcome\":\"업무별로 필요한 위임 수준과 Checkpoint를 명확히 한다.\",\"knowledge\":\"사람을 한 등급으로 분류하지 말고 ‘업무별 권한 수준’을 합의하는 것이 안전합니다.\",\"case\":\"한 팀원에게는 SNS 콘텐츠는 완전 위임 가능하지만 예산 계약은 아직 지원이 필요합니다.\",\"practice\":[\"위임 후보 업무를 세로축에 놓습니다.\",\"L1 Direct / L2 Research / L3 Recommend / L4 Decide+Check / L5 Own 중 현재 수준을 정합니다.\",\"한 단계 높이기 위한 조건을 적습니다.\"],\"artifact\":\"Delegation Matrix\",\"evidence\":\"업무 5개 × 현재 Level × 다음 Level 조건\",\"debrief\":[\"업무와 사람을 혼동해 ‘이 사람은 L3’처럼 평가하지 않았나?\",\"권한은 줬는데 정보·자원은 주지 않은 일은?\"],\"nudge\":\"위임 수준은 ‘사람 등급’이 아니라 ‘이 업무에서의 권한 계약’입니다.\",\"route\":\"WORK\",\"sources\":[\"CCL_DELEGATION\",\"M30_DELEGATION\"]},{\"day\":20,\"phase\":\"EMPOWER\",\"title\":\"실제 업무 하나 위임하기\",\"duration\":\"20분 + 실행\",\"outcome\":\"Outcome·Guardrail·Authority·Checkpoint가 있는 위임 계약을 실행한다.\",\"knowledge\":\"좋은 위임에는 기대 결과뿐 아니라 경계조건과 확인 시점이 포함됩니다.\",\"case\":\"‘알아서 해주세요’라고 맡겼더니 팀원은 계속 승인을 요청합니다.\",\"practice\":[\"실제 업무 하나를 고릅니다.\",\"Outcome / Guardrail / Authority Level / Checkpoint를 합의합니다.\",\"필요 자원과 도움을 확인합니다.\"],\"artifact\":\"Delegation Contract\",\"evidence\":\"실제 1건의 위임 계약 + 다음 Checkpoint\",\"debrief\":[\"나는 권한을 주면서도 방법까지 통제하려 했나?\",\"팀원이 성공하는 데 필요한 자원은 충분한가?\"],\"nudge\":\"‘알아서’ 대신 어디까지 스스로 결정할 수 있는지 말해주세요.\",\"route\":\"WORK\",\"sources\":[\"CCL_DELEGATION\"]},{\"day\":21,\"phase\":\"EMPOWER\",\"title\":\"Week 3 Bottleneck Debrief\",\"duration\":\"20분\",\"outcome\":\"결정권과 위임을 바꾼 뒤 실제 흐름이 빨라졌는지 검토한다.\",\"knowledge\":\"변화는 의도가 아니라 결과 Evidence로 검증해야 합니다.\",\"case\":\"권한표는 만들었지만 팀원은 여전히 팀장에게 묻습니다.\",\"practice\":[\"이번 주 승인 대기·재작업·결정시간 변화를 봅니다.\",\"권한이 실제로 사용된 사례를 찾습니다.\",\"막힌 이유가 신뢰·정보·기준·자원 중 무엇인지 분리합니다.\"],\"artifact\":\"Delegation AAR\",\"evidence\":\"개선 1개 / 미개선 1개 / 다음 조정 1개\",\"debrief\":[\"권한만 주고 기준을 주지 않은 것은?\",\"내가 다시 가져온 결정은 무엇이며 왜 그랬나?\"],\"nudge\":\"권한표를 만든 것이 완료가 아니라 실제 사용됐는지가 Evidence입니다.\",\"route\":\"REVIEW\",\"sources\":[\"ARMY_AAR\",\"CCL_DELEGATION\"]},{\"day\":22,\"phase\":\"COACH\",\"title\":\"SBI+Intent 피드백 연습\",\"duration\":\"30분\",\"outcome\":\"평가 언어를 관찰 가능한 Situation / Behavior / Impact / Inquiry로 바꾼다.\",\"knowledge\":\"CCL의 SBI는 특정 상황과 관찰 가능한 행동, 그 영향에 초점을 두어 피드백을 구체화합니다. 의도를 묻는 Inquiry를 더하면 대화가 됩니다.\",\"case\":\"‘이번 기획은 너무 소극적이었어요’라고 말하려 합니다.\",\"practice\":[\"실제 피드백 1건을 고릅니다.\",\"Situation / Behavior / Impact를 사실 중심으로 씁니다.\",\"‘그때 어떤 의도로 그렇게 했나요?’ 같은 Inquiry를 추가합니다.\"],\"artifact\":\"Feedback Draft\",\"evidence\":\"S / B / I / Inquiry / Next 문장\",\"debrief\":[\"성격·의도를 추정한 표현이 있었나?\",\"상대가 자신의 판단을 설명할 여지를 줬나?\"],\"nudge\":\"평가보다 관찰, 단정보다 질문.\",\"route\":\"ONE_ON_ONE\",\"sources\":[\"CCL_SBI\"]},{\"day\":23,\"phase\":\"COACH\",\"title\":\"칭찬을 행동 학습으로 바꾸기\",\"duration\":\"20분\",\"outcome\":\"‘잘했어요’를 Behavior → Impact → Repeat으로 구체화한다.\",\"knowledge\":\"구체적 긍정 피드백은 어떤 행동을 반복해야 하는지 알려주는 학습 신호가 됩니다.\",\"case\":\"PT가 잘 끝났고 팀원에게 ‘좋았어요’라고만 말했습니다.\",\"practice\":[\"좋았던 구체적 행동을 한 문장으로 적습니다.\",\"그 행동이 팀·고객·결과에 준 영향을 적습니다.\",\"다음에도 반복했으면 하는 행동을 명시합니다.\"],\"artifact\":\"Recognition Note\",\"evidence\":\"Behavior / Impact / Repeat 1건\",\"debrief\":[\"내 칭찬만 듣고도 무엇을 반복해야 할지 알 수 있는가?\",\"결과만 칭찬하고 좋은 과정은 놓치지 않았나?\"],\"nudge\":\"‘좋다’ 대신 무엇이 좋았는지 말해주세요.\",\"route\":\"ONE_ON_ONE\",\"sources\":[\"CCL_SBI\"]},{\"day\":24,\"phase\":\"COACH\",\"title\":\"1:1에서 답 대신 질문하기\",\"duration\":\"30분\",\"outcome\":\"코칭 질문으로 팀원의 문제해결 사고를 끌어낸다.\",\"knowledge\":\"리더가 모든 해답을 주는 대신 상대가 상황·옵션·다음 행동을 스스로 정리하도록 돕는 것이 코칭 대화의 핵심입니다.\",\"case\":\"팀원이 문제를 말하자 팀장이 바로 해결책 5개를 제시합니다.\",\"practice\":[\"문제 설명 후 바로 답하지 않고 3초 멈춥니다.\",\"‘지금 가장 큰 제약은?’, ‘어떤 옵션을 생각했나요?’, ‘내가 무엇을 도우면 좋나요?’를 사용합니다.\",\"마지막에 팀원이 Next를 말하게 합니다.\"],\"artifact\":\"Coaching Question Set\",\"evidence\":\"질문 5개 + 팀원이 정한 Next\",\"debrief\":[\"내가 대신 풀어준 문제는?\",\"팀원이 자신의 선택을 말한 순간은?\"],\"nudge\":\"답을 주기 전 ‘당신은 어떻게 보고 있나요?’를 먼저 물어보세요.\",\"route\":\"ONE_ON_ONE\",\"sources\":[\"STANFORD\"]},{\"day\":25,\"phase\":\"COACH\",\"title\":\"어려운 대화 준비하기\",\"duration\":\"30분\",\"outcome\":\"감정적 평가 대신 사실·영향·기대·지원으로 대화를 준비한다.\",\"knowledge\":\"어려운 대화일수록 관찰 사실과 영향, 상대의 관점 탐색, 다음 기대 행동을 분리하면 방어성을 낮출 수 있습니다.\",\"case\":\"반복 지연으로 팀장이 화가 났고 ‘왜 이것도 아직 안 됐어요?’라고 말하고 싶습니다.\",\"practice\":[\"감정을 문장 밖에 따로 적습니다.\",\"사실로 확인된 상황과 행동을 씁니다.\",\"영향을 설명하고 상대 관점을 묻습니다.\",\"다음 기대와 지원을 합의합니다.\"],\"artifact\":\"Difficult Conversation Plan\",\"evidence\":\"Fact / Impact / Inquiry / Expectation / Support\",\"debrief\":[\"사람에 대한 평가와 행동에 대한 피드백을 구분했나?\",\"상대가 설명할 여지가 있었나?\"],\"nudge\":\"문제의 사람을 만들지 말고, 해결할 상황을 만드세요.\",\"route\":\"ONE_ON_ONE\",\"sources\":[\"CCL_SBI\",\"STANFORD\"]},{\"day\":26,\"phase\":\"COACH\",\"title\":\"프로젝트 Debrief — AAR\",\"duration\":\"30–45분\",\"outcome\":\"프로젝트 결과에서 다음 실행에 쓸 학습을 뽑는다.\",\"knowledge\":\"AAR은 계획과 실제를 비교하고 차이의 원인을 함께 탐색해 다음 수행 방식을 개선하는 전문적 토론입니다.\",\"case\":\"프로젝트가 끝났고 매출은 좋았지만 팀은 지쳤습니다. ‘성공’으로만 마무리하면 같은 문제가 반복됩니다.\",\"practice\":[\"무엇을 기대했나?\",\"실제로 무엇이 일어났나?\",\"왜 차이가 났나?\",\"유지할 것과 바꿀 것을 정합니다.\",\"다음 프로젝트에 적용할 한 가지 규칙을 기록합니다.\"],\"artifact\":\"Project AAR\",\"evidence\":\"Expected / Actual / Why / Keep / Change / Next\",\"debrief\":[\"성과가 좋아서 놓친 비용이나 위험은?\",\"실패 속에서 유지해야 할 좋은 판단은?\"],\"nudge\":\"성과가 좋았어도 반드시 학습할 것이 있습니다.\",\"route\":\"REVIEW\",\"sources\":[\"ARMY_AAR\"]},{\"day\":27,\"phase\":\"COACH\",\"title\":\"Process Change 하나 실험하기\",\"duration\":\"20분 + 실행\",\"outcome\":\"회고에서 나온 학습을 실제 운영 규칙 변경으로 연결한다.\",\"knowledge\":\"회고의 가치는 문서가 아니라 다음 행동이 바뀔 때 생깁니다.\",\"case\":\"매주 ‘승인 지연’을 회고하지만 프로세스는 그대로입니다.\",\"practice\":[\"Debrief에서 반복된 문제 하나를 고릅니다.\",\"프로세스 변경 가설을 작게 설계합니다.\",\"Owner / 시작일 / 관찰할 Evidence를 정합니다.\"],\"artifact\":\"Process Experiment\",\"evidence\":\"변경 규칙 1개 + Owner + Evidence\",\"debrief\":[\"이번 변화가 실제 문제 원인을 겨냥하는가?\",\"2주 뒤 무엇을 보면 성공인지 알 수 있는가?\"],\"nudge\":\"Learning을 운영 규칙 하나로 번역하세요.\",\"route\":\"WORK\",\"sources\":[\"ARMY_AAR\"]},{\"day\":28,\"phase\":\"COACH\",\"title\":\"Team Operating Rhythm 확정\",\"duration\":\"40분\",\"outcome\":\"회의·1:1·결정·마일스톤·디브리핑의 반복 리듬을 팀 캘린더로 확정한다.\",\"knowledge\":\"운영 리듬은 팀이 매번 리더의 지시를 기다리지 않고 같은 주기로 준비·결정·실행·회고하도록 돕습니다.\",\"case\":\"좋은 도구는 많지만 언제 무엇을 하는지 정해지지 않아 사용되지 않습니다.\",\"practice\":[\"주간 Team Calendar를 다시 봅니다.\",\"Priority / 1:1 / Milestone / Decision / Debrief 슬롯을 배치합니다.\",\"각 슬롯의 Input / Output / Owner를 적습니다.\"],\"artifact\":\"Operating Rhythm v1\",\"evidence\":\"주간 캘린더 + 각 Ritual의 Input / Output / Owner\",\"debrief\":[\"리더가 없어도 이 리듬이 돌아갈 수 있는가?\",\"회의가 아니라 시스템이 만든 반복은 무엇인가?\"],\"nudge\":\"좋은 팀은 ‘매번 기억해서’가 아니라 ‘리듬으로’ 움직입니다.\",\"route\":\"MEETINGS\",\"sources\":[\"WHARTON\",\"BAIN_RAPID\"]},{\"day\":29,\"phase\":\"COACH\",\"title\":\"Leader Self Review\",\"duration\":\"25분\",\"outcome\":\"팀원이 아니라 자신의 리더십 선택을 리뷰한다.\",\"knowledge\":\"리더십 개발은 자기 행동이 타인과 팀에 미친 영향을 되돌아보고 다음 실험을 정할 때 강화됩니다.\",\"case\":\"팀 성과는 나아졌지만 모든 중요한 회의에서 팀장이 여전히 가장 많이 말합니다.\",\"practice\":[\"이번 달 내가 잘한 리더 행동 2개를 적습니다.\",\"과잉 개입 / 미흡한 지원 1개씩 적습니다.\",\"다음 달에 바꿀 행동 하나를 정합니다.\"],\"artifact\":\"Leader Review\",\"evidence\":\"Keep 2 / Change 1 / Next 1\",\"debrief\":[\"내가 팀의 병목이 된 순간은?\",\"내가 만든 좋은 행동이 팀원에게 반복 가능하게 남았나?\"],\"nudge\":\"사람을 평가하기 전에 내 운영 선택을 먼저 봅니다.\",\"route\":\"REVIEW\",\"sources\":[\"STANFORD\",\"WHARTON\"]},{\"day\":30,\"phase\":\"COACH\",\"title\":\"Team Operating System Charter + Next 60 Days\",\"duration\":\"45–60분\",\"outcome\":\"30일 동안 만든 팀 이해·운영 기준·결정/위임·코칭 리듬을 Team OS Charter와 다음 60일 계획으로 통합한다.\",\"knowledge\":\"30일 과정의 목적은 지식을 많이 아는 것이 아니라 실제 팀이 사용할 운영 체계를 남기는 것입니다.\",\"case\":\"30일 동안 많은 것을 배웠지만 문서와 회의가 각각 흩어져 있습니다.\",\"practice\":[\"DRAFT Artifact를 검토하고 실제 운영 기준으로 쓸 항목만 CONFIRMED로 전환합니다.\",\"Manager Contract / Calendar / Priority / Work / Milestone / Decision / Delegation / Debrief를 Team OS Charter 한 장으로 조립합니다.\",\"다음 60일의 Outcomes 3개, 운영 시스템 개선 1개, 리더 행동 실험 1개를 정합니다.\"],\"artifact\":\"Team OS Charter v1 + Next 60 Plan\",\"evidence\":\"CONFIRMED 운영 Artifact + Charter Snapshot + 다음 60일 Outcomes / Experiment / Review Rhythm\",\"debrief\":[\"30일 동안 만든 것 중 실제 팀이 계속 사용할 규칙은 무엇인가?\",\"다음 60일 동안 내가 직접 하는 일보다 팀이 스스로 결정하도록 만들 것은 무엇인가?\"],\"nudge\":\"30일의 끝은 수료가 아니라 ‘팀이 리더 없이도 더 명확하게 움직이는 운영 체계’의 시작입니다.\",\"route\":\"WORK_REPORTS\",\"sources\":[\"WHARTON\",\"STANFORD\",\"BAIN_RAPID\",\"CCL_SBI\",\"ARMY_AAR\",\"CCL_DELEGATION\"]}]);\nexport const LEADERSHIP_KNOWLEDGE_SOURCES = Object.freeze({\"WHARTON\":{\"name\":\"Wharton MGMT 6100 · Foundations of Teamwork and Leadership\",\"tier\":\"A · MBA / University\",\"principle\":\"시뮬레이션, 사례, 팀 활동, 디브리핑, 개인·그룹 피드백을 결합해 리더십 행동·팀 다이내믹스·조직 인식을 경험으로 학습합니다.\",\"url\":\"https://leadership.wharton.upenn.edu/management-6100/\"},\"STANFORD\":{\"name\":\"Stanford GSB · Interpersonal Dynamics\",\"tier\":\"A · MBA / University\",\"principle\":\"소그룹의 실제 상호작용에서 자신의 행동이 다른 사람에게 미치는 영향을 관찰하고, 피드백과 실험을 통해 관계·소통·영향력을 학습합니다.\",\"url\":\"https://www.gsb.stanford.edu/experience/learning/leadership/interpersonal-dynamics\"},\"CCL_SBI\":{\"name\":\"Center for Creative Leadership · SBI Feedback\",\"tier\":\"A · Leadership Research\",\"principle\":\"Situation → Behavior → Impact의 사실 기반 피드백에 Inquiry를 더해 의도와 영향을 탐색하는 대화로 확장합니다.\",\"url\":\"https://www.ccl.org/articles/leading-effectively-articles/sbi-feedback-model-a-quick-win-to-improve-talent-conversations-development/\"},\"BAIN_RAPID\":{\"name\":\"Bain & Company · RAPID Decision Rights\",\"tier\":\"B · Management Framework\",\"principle\":\"Recommend / Input / Agree / Decide / Perform을 분리해 중요한 의사결정의 책임·시점·실행을 명확하게 합니다.\",\"url\":\"https://media.bain.com/Images/BAIN_BRIEF_Decision_Insights_The_five_steps_to_better_decisions.pdf\"},\"ARMY_AAR\":{\"name\":\"U.S. Army · After Action Review\",\"tier\":\"A · Operational Learning\",\"principle\":\"예상과 실제를 비교하고 차이와 원인을 스스로 발견해 다음 수행 방식을 개선하는 반복 학습 프로세스입니다.\",\"url\":\"https://www.army.mil/article/283214/\"},\"CCL_DELEGATION\":{\"name\":\"Center for Creative Leadership · Delegation Cycle\",\"tier\":\"A · Leadership Research\",\"principle\":\"위임은 단순 업무 할당이 아니라 권한·책임·자원·방향·지원까지 함께 제공하는 과정이며 신뢰와 자율성을 함께 설계해야 합니다.\",\"url\":\"https://www.ccl.org/leadership-solutions/leadership-topics/delegating-effectively/\"},\"M30_DELEGATION\":{\"name\":\"Management 3.0 · Delegation Board\",\"tier\":\"C · Practitioner Tool\",\"principle\":\"결정 영역별 위임 수준을 시각적으로 합의해 권한의 경계를 명확히 하는 실무 도구입니다.\",\"url\":\"https://management30.com/practice/delegation-poker/\"},\"HBR90\":{\"name\":\"Michael D. Watkins / HBR · Leadership Transition\",\"tier\":\"B · Transition Practice\",\"principle\":\"새 역할의 초기 행동은 이후 신뢰와 변화의 모멘텀에 큰 영향을 주므로 빠른 학습과 이해관계 정렬이 중요합니다.\",\"url\":\"https://hbr.org/2009/06/obamas-first-90-days-2\"}});\nexport const LEADER_COACH_SCENARIOS = Object.freeze({\"TASK\":{\"name\":\"업무를 맡길 때\",\"gentle\":\"목적과 완료 기준도 한 줄 추가해보세요.\",\"coach\":\"이 업무가 끝났을 때 ‘무엇이 달라져야’ 완료라고 볼 수 있나요?\",\"learn\":\"Task만 주면 팀원은 리더의 머릿속 기준을 추측하게 됩니다. Work → Value → Result로 목적과 완료 기준을 함께 명확히 해보세요.\",\"script\":\"Work: 무엇을 할지 · Value: 왜 필요한지 · Result: 어떤 상태가 되면 Done인지\"},\"REPORT\":{\"name\":\"보고를 받을 때\",\"gentle\":\"‘무엇을 했나’ 다음에 ‘그래서 무엇이 달라졌나’를 물어보세요.\",\"coach\":\"이 결과가 원래 기대와 어떻게 달랐고, 다음 결정이 필요한 부분은 무엇인가요?\",\"learn\":\"좋은 보고는 활동량보다 가치·결과·이슈·요청을 보여줍니다. Work → Value → Result → Issue → Ask로 정리하면 의사결정 속도가 빨라집니다.\",\"script\":\"Work / Value / Result / Issue / Ask\"},\"FEEDBACK\":{\"name\":\"피드백할 때\",\"gentle\":\"평가보다 관찰한 행동부터 말해보세요.\",\"coach\":\"어떤 상황에서 어떤 행동을 봤고, 그 행동이 어떤 영향을 만들었나요?\",\"learn\":\"SBI는 성격이나 의도를 단정하지 않고 Situation → Behavior → Impact에 집중합니다. 그 다음 Intent를 물어보면 일방적 평가가 아니라 대화가 됩니다.\",\"script\":\"Situation → Behavior → Impact → Inquiry → Next\"},\"ONEONONE\":{\"name\":\"1:1을 할 때\",\"gentle\":\"답을 주기 전에 질문을 하나 더 해보세요.\",\"coach\":\"지금 가장 큰 제약은 무엇이고, 본인은 어떤 옵션을 생각하고 있나요?\",\"learn\":\"1:1은 해결책 전달 시간이 아니라 상대의 업무 맥락과 판단 과정을 이해하는 시간입니다. Tell보다 Ask 비율을 높여보세요.\",\"script\":\"Priority → Blocker → Options → Support → Next\"},\"DELEGATE\":{\"name\":\"위임할 때\",\"gentle\":\"‘알아서’ 대신 결정 가능한 범위를 말해주세요.\",\"coach\":\"Outcome, Guardrail, Authority, Checkpoint를 각각 한 줄로 합의할 수 있나요?\",\"learn\":\"위임은 책임을 버리는 것이 아니라 권한과 지원을 함께 설계하는 것입니다. 업무별 권한 수준과 확인 시점을 명확히 하세요.\",\"script\":\"Outcome → Guardrail → Authority → Resources → Checkpoint\"},\"MEETING\":{\"name\":\"회의를 열 때\",\"gentle\":\"회의가 끝나면 무엇이 달라져야 하나요?\",\"coach\":\"이 회의는 정보공유·논의·결정·회고 중 무엇이고, 필요한 Output은 무엇인가요?\",\"learn\":\"회의 목적이 섞이면 시간이 늘어납니다. 특히 결정 회의는 Decision Owner와 Deadline을 미리 명시하면 실행으로 연결되기 쉽습니다.\",\"script\":\"Purpose → Input → Decision/Output → Owner → Deadline\"},\"DECISION\":{\"name\":\"결정을 내릴 때\",\"gentle\":\"누가 최종 결정권자(D)인지 명확한가요?\",\"coach\":\"결정 질문, 기준, 대안, 최종 Decider, Deadline을 한 문장씩 적어보세요.\",\"learn\":\"RAPID는 추천·입력·동의·결정·실행 역할을 분리합니다. 중요한 결정일수록 D는 하나, Input은 필요한 사람만 두는 것이 좋습니다.\",\"script\":\"Question → Criteria → Options → RAPID → Deadline\"},\"DEBRIEF\":{\"name\":\"끝난 일을 회고할 때\",\"gentle\":\"‘누가’보다 ‘무엇이 왜 달랐는가’를 보세요.\",\"coach\":\"무엇을 기대했고 실제로 무엇이 일어났으며, 다음에는 무엇을 바꿀까요?\",\"learn\":\"AAR은 잘못한 사람을 찾는 회의가 아닙니다. Expected → Actual → Gap → Learning → Next로 다음 수행 방식을 개선하는 학습 루프입니다.\",\"script\":\"Expected → Actual → Why → Keep → Change → Next\"}});\nexport const LEADERSHIP_TOOLKITS = Object.freeze({\n\"TEAM_MAP\":{\"name\":\"Team Map\",\"purpose\":\"직함이 아니라 실제 역할·책임·의존성·미확인 영역을 FACT / HYPOTHESIS / UNKNOWN으로 기록합니다.\",\"example\":[[\"민지\",\"Brand PM\",\"브랜드 전략 · 고객 커뮤니케이션\",\"Creative Lead\",\"FACT\"],[\"준호\",\"Performance Lead\",\"광고 운영 · 예산 최적화\",\"Finance\",\"HYPOTHESIS\"],[\"Finance Partner\",\"Partner\",\"예산 승인 영향 범위\",\"Team Lead\",\"UNKNOWN\"]]},\n\"TEAM_CALENDAR\":{\"name\":\"Team Calendar\",\"purpose\":\"팀의 시간을 Ritual / 1:1 / Milestone / Decision / External / Debrief로 분류해 실제 운영 리듬을 봅니다.\",\"example\":[[\"MON 09:30\",\"Weekly Priority\",\"Ritual\",\"이번 주 Top 3 확정\",\"Team Lead\"],[\"TUE 14:00\",\"1:1 · 민지\",\"1:1\",\"Priority / Blocker / Support\",\"Leader + 민지\"],[\"WED 11:00\",\"Project Milestone\",\"Milestone\",\"Concept Lock 여부 결정\",\"Creative Lead\"],[\"THU 15:00\",\"Decision Review\",\"Decision\",\"막힌 결정 3건 처리\",\"Decider\"],[\"FRI 16:00\",\"Team Debrief\",\"Debrief\",\"Keep / Change / Next\",\"Team\"]]},\n\"MILESTONES\":{\"name\":\"Milestone Card\",\"purpose\":\"마일스톤을 날짜가 아니라 Outcome / Evidence / Owner / Decision이 연결된 다음 판단 지점으로 정의합니다.\",\"example\":[[\"Campaign Launch\",\"Concept Lock\",\"Outcome: 캠페인 방향 1개 확정\",\"Evidence: Message + KV + Story\",\"Owner: Creative Lead\",\"Decision: Go / Revise\"],[\"MVP\",\"Scope Lock\",\"Outcome: Sprint 범위 확정\",\"Evidence: Stories + acceptance\",\"Owner: Product Lead\",\"Decision: Build / Cut\"]]},\n\"DECISION_RIGHTS\":{\"name\":\"Decision Rights\",\"purpose\":\"중요 결정마다 Recommend / Input / Agree / Decide / Perform 역할을 분리합니다.\",\"example\":[[\"캠페인 전략\",\"CD\",\"Performance/Brand\",\"—\",\"Team Lead\",\"PM\"],[\"광고비 ±10%\",\"Performance\",\"Finance\",\"—\",\"Performance Lead\",\"Performance\"],[\"신규 외주 3천만원\",\"PM\",\"Finance\",\"Finance\",\"Team Lead\",\"PM\"]]},\n\"DELEGATION\":{\"name\":\"Delegation Matrix\",\"purpose\":\"사람을 등급화하지 않고 업무별 권한 수준을 합의합니다.\",\"example\":[[\"SNS 콘텐츠\",\"민지\",\"L5 Own\",\"결과만 공유\"],[\"광고 예산 ±10%\",\"준호\",\"L4 Decide+Check\",\"주간 Checkpoint\"],[\"신규 외주 계약\",\"준호\",\"L3 Recommend\",\"팀장이 최종 결정\"],[\"채용 제안\",\"민지\",\"L2 Research\",\"후보/근거 준비\"]]},\n\"DEBRIEF\":{\"name\":\"Debrief / AAR\",\"purpose\":\"예상과 실제의 차이를 학습으로 바꾸고 다음 운영 규칙에 반영합니다.\",\"example\":[[\"Expected\",\"콘셉트 승인 1회\"],[\"Actual\",\"승인 3회, 4일 지연\"],[\"Why\",\"Final Decider 불명확\"],[\"Keep\",\"초기 고객 리서치\"],[\"Change\",\"Concept Lock에 D 명시\"],[\"Next\",\"다음 프로젝트부터 Decision Rights 적용\"]]},\n\"WVR\":{\"name\":\"WVR Card\",\"purpose\":\"업무를 할 일에서 가치와 결과가 연결된 실행 단위로 바꿉니다.\",\"example\":[[\"Work\",\"브랜드 필름 수정\"],[\"Value\",\"프리미엄 이미지 강화\"],[\"Result\",\"클라이언트 1차 승인 가능한 수준\"],[\"Evidence\",\"Key message / Hero visual / Tone 승인\"]]},\n\"MANAGER_CONTRACT\":{\"name\":\"Manager Contract\",\"purpose\":\"상급자와 첫 30일의 성공 기준·보고 리듬·즉시 에스컬레이션 조건을 합의합니다.\",\"example\":[[\"Success 30D\",\"팀의 Top 3와 Decision Rights가 보이는 상태\"],[\"Report rhythm\",\"월요일 10분 주간 브리프 · 금요일 리스크 업데이트\"],[\"Escalate now\",\"예산 ±15% / 외부 약속 / 일정 3일+ 변경\"]]},\n\"TEAM_PATTERN\":{\"name\":\"Team Pattern Board\",\"purpose\":\"1:1의 개별 사례를 반복 패턴·근거·검증 질문으로 묶습니다.\",\"example\":[[\"승인 대기\",\"3명에게 반복\",\"D가 불명확할 가능성\",\"누가 최종 결정하나요?\"],[\"회의 후 재작업\",\"2개 프로젝트\",\"Done 기준 불명확\",\"완료 기준을 누가 정의하나요?\"]]},\n\"STAKEHOLDER_MAP\":{\"name\":\"Stakeholder Map\",\"purpose\":\"팀 밖에서 결과에 영향을 주는 사람의 기대·영향·접점을 관리합니다.\",\"example\":[[\"CEO\",\"속도 / 리스크 가시성\",\"High\",\"주간 브리프\"],[\"Finance\",\"예산 통제\",\"High\",\"집행 전 확인\"],[\"Sales\",\"고객 약속 정합성\",\"Medium\",\"격주 Sync\"]]},\n\"WORK_MAP\":{\"name\":\"Work Map\",\"purpose\":\"현재 진행 중인 프로젝트의 Goal / Owner / Next Milestone / Open Decision을 연결합니다.\",\"example\":[[\"Project Alpha\",\"10/20 Launch\",\"민지\",\"Concept Lock\",\"예산 증액?\"],[\"Brand Refresh\",\"Q4 가이드 확정\",\"서연\",\"Visual Lock\",\"외주 범위?\"]]},\n\"PRIORITY_CONTRACT\":{\"name\":\"Priority Contract\",\"purpose\":\"이번 주 Top 3, 하지 않을 일, 성공 신호와 리뷰 날짜를 합의합니다.\",\"example\":[[\"P1\",\"Project Alpha Concept Lock\"],[\"P2\",\"Decision Rights 정리\"],[\"P3\",\"핵심 팀원 1:1 완료\"],[\"Not now\",\"회의 툴 교체 / 조직 개편\"]]}});\n\nexport const LEADERSHIP_SETUP_CHECKLIST = Object.freeze([\n  { id:'OBSERVE-ROLE', group:'UNDERSTAND', day:2, title:'상급자와 역할·성공 기준 합의', artifact:'Manager Contract' },\n  { id:'OBSERVE-TEAM', group:'UNDERSTAND', day:3, title:'팀 구성원과 실제 역할 파악', artifact:'Team Map' },\n  { id:'OBSERVE-1ON1', group:'UNDERSTAND', day:5, title:'팀원 1:1로 반복 패턴 확인', artifact:'Team Pattern Board' },\n  { id:'MAP-CALENDAR', group:'ALIGN', day:8, title:'반복 일정과 회의 리듬 수집', artifact:'Team Calendar' },\n  { id:'MAP-WORK', group:'ALIGN', day:10, title:'현재 프로젝트와 Owner 연결', artifact:'Work Map' },\n  { id:'MAP-MILESTONE', group:'ALIGN', day:11, title:'마일스톤을 Outcome 기준으로 재정의', artifact:'Milestone Card' },\n  { id:'ALIGN-PRIORITY', group:'ALIGN', day:13, title:'팀 Top 3 우선순위 합의', artifact:'Priority Contract' },\n  { id:'ALIGN-DECISION', group:'EMPOWER', day:16, title:'중요 결정의 최종 결정권자 명확화', artifact:'Decision Rights' },\n  { id:'ALIGN-DELEGATE', group:'EMPOWER', day:19, title:'업무별 위임 수준과 범위 정의', artifact:'Delegation Matrix' },\n  { id:'OPERATE-FEEDBACK', group:'COACH', day:22, title:'관찰 기반 피드백 방식 적용', artifact:'Feedback Draft' },\n  { id:'OPERATE-DEBRIEF', group:'COACH', day:26, title:'프로젝트 Debrief로 학습 기록', artifact:'Project AAR' },\n  { id:'OPERATE-RHYTHM', group:'COACH', day:30, title:'Team Operating System v1 확정', artifact:'Team OS Charter' }\n]);\nexport const LEADERSHIP_SAMPLE_BOARDS = Object.freeze({\n  REF_TODAY:{ name:'예시 · Today', subtitle:'중요한 것만 Top 3로 보여주고 Chief of Staff가 맥락을 보조합니다.' },\n  REF_PLAN:{ name:'예시 · 30-Day Plan', subtitle:'현재 단계, 이번 주 Focus, 주요 액션을 한 화면에 배치합니다.' },\n  REF_SKILL:{ name:'예시 · Skill Runner', subtitle:'Prepare → Run → Capture → Action으로 복잡한 리더 행동을 단계화합니다.' },\n  REF_DECISION:{ name:'예시 · Decision', subtitle:'질문, 옵션, 장점·리스크, 근거, 영향, 추천을 분리합니다.' },\n  TEAM_MAP:{ name:'팀 구조 파악', subtitle:'조직도보다 역할 · 의존성 · UNKNOWN을 먼저 봅니다.' },\n  TEAM_CALENDAR:{ name:'팀 캘린더', subtitle:'시간을 Ritual / 1:1 / Milestone / Decision / Debrief로 분류합니다.' },\n  MILESTONES:{ name:'마일스톤', subtitle:'날짜가 아니라 Outcome / Evidence / Owner / Decision을 정의합니다.' },\n  DECISION_RIGHTS:{ name:'결정권한', subtitle:'RAPID로 누가 제안하고, 누가 최종 결정하는지 분리합니다.' },\n  DELEGATION:{ name:'위임 매트릭스', subtitle:'사람이 아니라 업무별로 권한 수준을 정합니다.' },\n  DEBRIEF:{ name:'디브리핑', subtitle:'Expected와 Actual의 차이를 다음 운영 규칙으로 바꿉니다.' },\n  MANAGER_CONTRACT:{ name:'상급자 기대 합의', subtitle:'첫 30일 성공 기준과 보고 리듬을 합의합니다.' },\n  TEAM_PATTERN:{ name:'팀 패턴 보드', subtitle:'개별 사례를 반복 패턴과 시스템 가설로 바꿉니다.' },\n  STAKEHOLDER_MAP:{ name:'이해관계자 맵', subtitle:'공식 조직도 밖의 영향·의존성·접점을 봅니다.' },\n  WORK_MAP:{ name:'워크 맵', subtitle:'현재 프로젝트의 Goal / Owner / Milestone / Decision을 한눈에 봅니다.' },\n  PRIORITY_CONTRACT:{ name:'우선순위 계약', subtitle:'Top 3와 하지 않을 일, 리뷰 기준을 명확히 합니다.' },\n  WEEKLY_REVIEW:{ name:'주간 운영 리뷰', subtitle:'Calendar → Milestone → Decision → Delegation → Debrief를 한 화면에서 연결합니다.' }\n});\n\nexport function getLeadershipQuest(day) {\n    return LEADERSHIP_QUESTS.find((quest) => quest.day === Number(day)) ?? null;\n}\nexport function questProgressSummary(completedDays = []) {\n    const completed = new Set((Array.isArray(completedDays) ? completedDays : []).map(Number));\n    const total = LEADERSHIP_QUESTS.length;\n    const done = LEADERSHIP_QUESTS.filter((quest) => completed.has(quest.day)).length;\n    return { total, done, percent: total ? Math.round((done / total) * 100) : 0 };\n}\n\nexport function isRealFirstUse(pack) {\n    if (!pack)\n        return true;\n    const items = [...pack.truth, ...pack.operational, ...pack.candidates, ...pack.recommendations];\n    const meaningful = new Set(['PERSON', 'PROJECT', 'ACTION', 'COMMITMENT', 'MEETING', 'DECISION']);\n    return !items.some((item) => meaningful.has(item.objectType));\n}\nexport function parseFirstUseMembers(raw) {\n    const seen = new Set();\n    return raw.split(/\\r?\\n/).flatMap((line) => {\n        const trimmed = line.trim();\n        if (!trimmed)\n            return [];\n        const [rawName, ...roleParts] = trimmed.split(',');\n        const name = rawName?.trim() ?? '';\n        if (!name)\n            return [];\n        const key = name.toLocaleLowerCase();\n        if (seen.has(key))\n            return [];\n        seen.add(key);\n        const role = roleParts.join(',').trim();\n        return [{ name, role: role || null }];\n    });\n}\nexport function parseFirstUseTasks(raw) {\n    const seen = new Set();\n    return raw.split(/\\r?\\n/).flatMap((line) => {\n        const title = line.trim().replace(/^[-•]\\s*/, '');\n        if (!title)\n            return [];\n        const key = title.toLocaleLowerCase();\n        if (seen.has(key))\n            return [];\n        seen.add(key);\n        return [{ title }];\n    });\n}\n","one-on-one.js":"export function buildOneOnOnePrep(person, openQuestions = []) {\n    const agenda = [];\n    for (const commitment of person.openCommitments ?? []) {\n        agenda.push({\n            type: 'COMMITMENT',\n            title: commitment,\n            sourceRef: `PERSON:${person.id}:COMMITMENT`,\n            humanConfirmationRequired: true\n        });\n    }\n    if (person.blocker) {\n        agenda.push({\n            type: 'BLOCKER',\n            title: person.blocker,\n            sourceRef: `PERSON:${person.id}:BLOCKER`,\n            humanConfirmationRequired: true\n        });\n    }\n    if (person.currentPriority) {\n        agenda.push({\n            type: 'PRIORITY',\n            title: person.currentPriority,\n            sourceRef: `PERSON:${person.id}:PRIORITY`,\n            humanConfirmationRequired: true\n        });\n    }\n    if (person.currentProject) {\n        agenda.push({\n            type: 'PROJECT',\n            title: person.currentProject,\n            sourceRef: `PERSON:${person.id}:PROJECT`,\n            humanConfirmationRequired: true\n        });\n    }\n    for (const question of openQuestions) {\n        if (!question?.id || !question.text?.trim())\n            continue;\n        agenda.push({\n            type: 'OPEN_QUESTION',\n            title: question.text.trim(),\n            sourceRef: `QUESTION:${question.id}`,\n            humanConfirmationRequired: true\n        });\n    }\n    return {\n        view: 'ONE_ON_ONE_PREP',\n        person: {\n            id: person.id,\n            name: person.name,\n            role: person.role ?? null\n        },\n        agenda,\n        interpretation: {\n            personalityInference: false,\n            motivationInference: false,\n            performanceRating: false\n        },\n        captureContract: {\n            allowed: ['DECISION', 'ACTION', 'COMMITMENT', 'OPEN_QUESTION', 'MEMORY_CANDIDATE'],\n            directLongTermMemoryWrite: false,\n            humanReviewRequired: true\n        }\n    };\n}\nexport function validateOneOnOnePrep(view) {\n    const violations = [];\n    if (view.interpretation.personalityInference !== false)\n        violations.push('PERSONALITY_INFERENCE_PROHIBITED');\n    if (view.interpretation.motivationInference !== false)\n        violations.push('MOTIVATION_INFERENCE_PROHIBITED');\n    if (view.interpretation.performanceRating !== false)\n        violations.push('PERFORMANCE_RATING_PROHIBITED');\n    if (view.captureContract.directLongTermMemoryWrite !== false)\n        violations.push('DIRECT_MEMORY_WRITE_PROHIBITED');\n    if (view.captureContract.humanReviewRequired !== true)\n        violations.push('HUMAN_REVIEW_REQUIRED');\n    if (view.agenda.some((item) => item.humanConfirmationRequired !== true))\n        violations.push('AGENDA_CONFIRMATION_REQUIRED');\n    return { ok: violations.length === 0, violations };\n}\n","personalization.js":"import { allContextItems } from './runtime.js';\nconst stringArray = (value) => Array.isArray(value)\n    ? [...new Set(value.filter((item) => typeof item === 'string').map((item) => item.trim()).filter(Boolean))]\n    : [];\nfunction projectExplicitlyBelongsToUser(project, userId) {\n    const data = project.data;\n    const ownerUserId = typeof data.ownerUserId === 'string' ? data.ownerUserId.trim() : '';\n    if (ownerUserId === userId)\n        return true;\n    const membershipKeys = ['memberUserIds', 'assigneeUserIds', 'leadUserIds'];\n    return membershipKeys.some((key) => stringArray(data[key]).includes(userId));\n}\nexport function normalizePersonalPreferences(input = {}) {\n    const clean = (value) => typeof value === 'string' && value.trim() ? value.trim() : null;\n    const roleMode = ['EXECUTIVE', 'TEAM_LEADER', 'PROJECT_LEAD', 'INDIVIDUAL'].includes(String(input.roleMode ?? ''))\n        ? input.roleMode\n        : null;\n    return {\n        displayName: clean(input.displayName),\n        roleMode,\n        defaultWorkspaceId: clean(input.defaultWorkspaceId),\n        timezone: clean(input.timezone)\n    };\n}\nexport function buildPersonalHome(pack, preferences = {}) {\n    const all = allContextItems(pack);\n    const accessibleProjects = all.filter((item) => item.objectType === 'PROJECT');\n    const myProjects = accessibleProjects.filter((project) => projectExplicitlyBelongsToUser(project, pack.viewerUserId));\n    return {\n        userId: pack.viewerUserId,\n        workspaceId: pack.workspaceId,\n        viewerRole: pack.viewerRole,\n        accessibleProjects,\n        myProjects,\n        explicitOwnershipCount: myProjects.length,\n        preferences: normalizePersonalPreferences(preferences),\n        personalizationSource: 'EXPLICIT_ONLY'\n    };\n}\nexport function personalizationSafetyContract() {\n    return {\n        inferPersonality: false,\n        inferPerformanceRating: false,\n        inferPoliticalOrSensitiveTraits: false,\n        inferProjectOwnershipFromNames: false,\n        explicitPreferencesOnly: true,\n        confirmedWorkspaceMembershipOnly: true,\n        privateContextAutoShare: false\n    };\n}\n","reports.js":"export function buildLeadershipReport(input) {\n    const metrics = (input.metrics ?? []).map((metric) => ({\n        ...metric,\n        delta: Number.isFinite(metric.previousValue)\n            ? metric.value - Number(metric.previousValue)\n            : null\n    }));\n    return {\n        view: 'LEADERSHIP_REPORT',\n        periodLabel: input.periodLabel,\n        peopleRanking: false,\n        personScores: [],\n        metrics,\n        unresolvedAttention: (input.unresolvedAttention ?? []).slice(0, 10),\n        reviewVerdicts: {\n            USEFUL: input.reviewVerdicts?.USEFUL ?? 0,\n            NOT_USEFUL: input.reviewVerdicts?.NOT_USEFUL ?? 0,\n            WRONG: input.reviewVerdicts?.WRONG ?? 0,\n            NEEDS_MORE_EVIDENCE: input.reviewVerdicts?.NEEDS_MORE_EVIDENCE ?? 0\n        },\n        addonEvidencePending: input.addonEvidencePending ?? 0,\n        interpretation: 'OPERATING_SYSTEM_ONLY'\n    };\n}\nexport function validateLeadershipReport(report) {\n    const violations = [];\n    if (report.peopleRanking !== false)\n        violations.push('PEOPLE_RANKING_PROHIBITED');\n    if (report.personScores.length > 0)\n        violations.push('PERSON_SCORES_PROHIBITED');\n    if (report.interpretation !== 'OPERATING_SYSTEM_ONLY')\n        violations.push('REPORT_SCOPE_BROKEN');\n    if (report.metrics.some((m) => m.value < 0 || m.value > 100))\n        violations.push('OPERATING_METRIC_RANGE');\n    return { ok: violations.length === 0, violations };\n}\n","review.js":"const STRONG_VERDICTS = new Set(['USEFUL', 'WRONG']);\nfunction unique(values) {\n    return [...new Set(values.map((value) => value.trim()).filter(Boolean))];\n}\nexport function buildReviewQueue(items) {\n    const accepted = [];\n    const rejected = [];\n    for (const item of Array.isArray(items) ? items : []) {\n        if (!item?.recommendationId) {\n            rejected.push({ recommendationId: null, reason: 'RECOMMENDATION_ID_REQUIRED' });\n            continue;\n        }\n        if (item.reviewStatus !== 'PENDING_HUMAN_REVIEW') {\n            rejected.push({ recommendationId: item.recommendationId, reason: 'PENDING_REVIEW_REQUIRED' });\n            continue;\n        }\n        if (!item.reason?.trim()) {\n            rejected.push({ recommendationId: item.recommendationId, reason: 'REASON_REQUIRED' });\n            continue;\n        }\n        if (!Array.isArray(item.evidenceRefs) || unique(item.evidenceRefs).length === 0) {\n            rejected.push({ recommendationId: item.recommendationId, reason: 'EVIDENCE_REQUIRED' });\n            continue;\n        }\n        if (!Number.isFinite(item.confidence) || item.confidence < 0 || item.confidence > 1) {\n            rejected.push({ recommendationId: item.recommendationId, reason: 'INVALID_CONFIDENCE' });\n            continue;\n        }\n        accepted.push({\n            ...item,\n            summary: item.summary.trim(),\n            reason: item.reason.trim(),\n            evidenceRefs: unique(item.evidenceRefs)\n        });\n    }\n    return { accepted, rejected };\n}\nexport function validateReviewSubmission(input) {\n    const violations = [];\n    const refs = unique(input.outcomeEvidenceRefs ?? []);\n    if (!input.recommendationId)\n        violations.push('RECOMMENDATION_ID_REQUIRED');\n    if (!['USEFUL', 'NOT_USEFUL', 'WRONG', 'NEEDS_MORE_EVIDENCE'].includes(input.verdict)) {\n        violations.push('INVALID_VERDICT');\n    }\n    if (input.reviewerType !== 'HUMAN' || !input.reviewerId) {\n        violations.push('HUMAN_REVIEW_REQUIRED');\n    }\n    if (STRONG_VERDICTS.has(input.verdict) && refs.length === 0) {\n        violations.push('OUTCOME_EVIDENCE_REQUIRED');\n    }\n    return {\n        ok: violations.length === 0,\n        violations,\n        normalized: {\n            recommendationId: input.recommendationId,\n            verdict: input.verdict,\n            outcomeEvidenceRefs: refs,\n            reviewerType: input.reviewerType,\n            reviewerId: input.reviewerId,\n            notes: input.notes?.trim() ?? ''\n        }\n    };\n}\nexport function buildReviewSubmission(input) {\n    const validation = validateReviewSubmission(input);\n    if (!validation.ok)\n        return { ok: false, violations: validation.violations };\n    return {\n        ok: true,\n        submission: {\n            ...validation.normalized,\n            reviewerType: 'HUMAN',\n            reviewStatus: 'FINAL',\n            truthMutationAllowed: false,\n            personRatingAllowed: false\n        }\n    };\n}\n","runtime-integration.js":"import { LeaderOsRuntimeClient } from './runtime.js';\nimport { createRuntimeRepositories } from './runtime-repositories.js';\nexport function createLeaderOsRuntimeSession(input) {\n    const runtime = new LeaderOsRuntimeClient(input.config, input.transport);\n    return {\n        runtime,\n        workspaceId: input.workspaceId,\n        repositories: createRuntimeRepositories({\n            runtime,\n            workspaceId: input.workspaceId,\n            idFactory: input.idFactory\n        })\n    };\n}\n","runtime-repositories.js":"import { allContextItems } from './runtime.js';\nimport { isOpickerEvidence, validateOpickerAnalyzeInput } from './addon-runtime.js';\nconst defaultIdFactory = () => crypto.randomUUID();\nfunction recordsOf(pack, objectType) {\n    return allContextItems(pack).filter((item) => item.objectType === objectType);\n}\nclass BaseRepository {\n    runtime;\n    workspaceId;\n    idFactory;\n    constructor(runtime, workspaceId, idFactory = defaultIdFactory) {\n        this.runtime = runtime;\n        this.workspaceId = workspaceId;\n        this.idFactory = idFactory;\n    }\n    async context() {\n        const result = await this.runtime.getContext(this.workspaceId);\n        if (!result.contextPack)\n            throw new Error('CONTEXT_PACK_REQUIRED');\n        return result.contextPack;\n    }\n    async writeObject(input) {\n        return this.runtime.write({\n            workspaceId: this.workspaceId,\n            eventId: `evt-${this.idFactory()}`,\n            objectType: input.objectType,\n            objectId: input.objectId,\n            eventType: input.eventType,\n            expectedVersion: input.expectedVersion,\n            source: 'APP',\n            patch: input.data,\n            confirmed: input.confirmed ?? false,\n            // null means preserve the existing scope on updates. Never widen RESTRICTED/PRIVATE to WORKSPACE implicitly.\n            accessScope: input.accessScope ?? null,\n            granteeUserIds: input.granteeUserIds ?? null\n        });\n    }\n}\nexport class TeamRuntimeRepository extends BaseRepository {\n    async listPeople() {\n        return recordsOf(await this.context(), 'PERSON');\n    }\n    async listTeams() {\n        return recordsOf(await this.context(), 'TEAM');\n    }\n    async savePerson(input) {\n        return this.writeObject({\n            objectType: 'PERSON',\n            objectId: input.personId,\n            eventType: input.expectedVersion === 0 ? 'PERSON_CREATED' : 'PERSON_UPDATED',\n            expectedVersion: input.expectedVersion,\n            data: input.data,\n            confirmed: true,\n            accessScope: input.accessScope,\n            granteeUserIds: input.granteeUserIds\n        });\n    }\n}\nexport class ProjectRuntimeRepository extends BaseRepository {\n    async list() {\n        return recordsOf(await this.context(), 'PROJECT');\n    }\n    async save(input) {\n        return this.writeObject({\n            objectType: 'PROJECT',\n            objectId: input.projectId,\n            eventType: input.expectedVersion === 0 ? 'PROJECT_CREATED' : 'PROJECT_UPDATED',\n            expectedVersion: input.expectedVersion,\n            data: input.data,\n            confirmed: input.confirmed ?? true\n        });\n    }\n}\nexport class DecisionRuntimeRepository extends BaseRepository {\n    async list() {\n        return recordsOf(await this.context(), 'DECISION');\n    }\n    async saveDraft(input) {\n        return this.writeObject({\n            objectType: 'DECISION',\n            objectId: input.decisionId,\n            eventType: input.expectedVersion === 0 ? 'DECISION_DRAFTED' : 'DECISION_DRAFT_UPDATED',\n            expectedVersion: input.expectedVersion,\n            data: input.data,\n            confirmed: false\n        });\n    }\n    async confirm(input) {\n        if (input.humanConfirmed !== true)\n            throw new Error('HUMAN_CONFIRMATION_REQUIRED');\n        return this.writeObject({\n            objectType: 'DECISION',\n            objectId: input.decisionId,\n            eventType: 'DECISION_CONFIRMED',\n            expectedVersion: input.expectedVersion,\n            data: input.data,\n            confirmed: true\n        });\n    }\n}\nexport class ActionRuntimeRepository extends BaseRepository {\n    async list() {\n        return recordsOf(await this.context(), 'ACTION');\n    }\n    async save(input) {\n        return this.writeObject({\n            objectType: 'ACTION',\n            objectId: input.actionId,\n            eventType: input.expectedVersion === 0 ? 'ACTION_CREATED' : 'ACTION_UPDATED',\n            expectedVersion: input.expectedVersion,\n            data: input.data,\n            confirmed: input.confirmed ?? true,\n            accessScope: input.accessScope,\n            granteeUserIds: input.granteeUserIds\n        });\n    }\n}\nexport class AddonEvidenceRuntimeRepository extends BaseRepository {\n    async list() {\n        return (await this.context()).evidence.filter(isOpickerEvidence);\n    }\n    async health() {\n        return this.runtime.addonHealth(this.workspaceId);\n    }\n    async startTrial() {\n        return this.runtime.startAddonTrial(this.workspaceId);\n    }\n    async analyze(input) {\n        const normalized = validateOpickerAnalyzeInput(input);\n        return this.runtime.analyzeAddon({\n            workspaceId: this.workspaceId,\n            ...normalized\n        });\n    }\n    async review(input) {\n        return this.runtime.reviewAddonEvidence({\n            workspaceId: this.workspaceId,\n            eventId: `evt-${this.idFactory()}`,\n            evidenceId: input.evidenceId,\n            expectedVersion: input.expectedVersion,\n            disposition: input.disposition,\n            notes: input.notes ?? null\n        });\n    }\n}\nexport function createRuntimeRepositories(input) {\n    return {\n        team: new TeamRuntimeRepository(input.runtime, input.workspaceId, input.idFactory),\n        projects: new ProjectRuntimeRepository(input.runtime, input.workspaceId, input.idFactory),\n        decisions: new DecisionRuntimeRepository(input.runtime, input.workspaceId, input.idFactory),\n        actions: new ActionRuntimeRepository(input.runtime, input.workspaceId, input.idFactory),\n        addonEvidence: new AddonEvidenceRuntimeRepository(input.runtime, input.workspaceId, input.idFactory)\n    };\n}\n","runtime.js":"export class RuntimeHttpError extends Error {\n    code;\n    status;\n    requestId;\n    constructor(code, status, requestId = null) {\n        super(code);\n        this.code = code;\n        this.status = status;\n        this.requestId = requestId;\n        this.name = 'RuntimeHttpError';\n    }\n}\nfunction required(value, name) {\n    const trimmed = value?.trim();\n    if (!trimmed)\n        throw new Error(`${name}_REQUIRED`);\n    return trimmed;\n}\nexport class LeaderOsRuntimeClient {\n    config;\n    transport;\n    baseUrl;\n    constructor(config, transport = fetch) {\n        this.config = config;\n        this.transport = transport;\n        const supabaseUrl = required(config.supabaseUrl, 'SUPABASE_URL').replace(/\\/+$/, '');\n        required(config.publishableKey, 'SUPABASE_PUBLISHABLE_KEY');\n        if (!config.accessToken?.trim() && !config.accessTokenProvider) {\n            throw new Error('SUPABASE_ACCESS_TOKEN_REQUIRED');\n        }\n        this.baseUrl = `${supabaseUrl}/functions/v1/leader-os-runtime`;\n    }\n    async accessToken() {\n        const raw = this.config.accessTokenProvider\n            ? await this.config.accessTokenProvider()\n            : this.config.accessToken;\n        return required(raw, 'SUPABASE_ACCESS_TOKEN');\n    }\n    async invoke(body) {\n        const accessToken = await this.accessToken();\n        const response = await this.transport(this.baseUrl, {\n            method: 'POST',\n            headers: {\n                apikey: this.config.publishableKey,\n                Authorization: `Bearer ${accessToken}`,\n                'Content-Type': 'application/json'\n            },\n            body: JSON.stringify(body)\n        });\n        let payload = {};\n        try {\n            payload = (await response.json());\n        }\n        catch {\n            // Keep an empty payload so transport failures still map to a stable error.\n        }\n        if (!response.ok) {\n            throw new RuntimeHttpError(typeof payload.error === 'string' ? payload.error : 'RUNTIME_REQUEST_FAILED', response.status, typeof payload.requestId === 'string' ? payload.requestId : response.headers.get('x-request-id'));\n        }\n        return payload;\n    }\n    async bootstrapWorkspace(input) {\n        const workspaceId = required(input.workspaceId, 'WORKSPACE_ID');\n        const workspaceName = required(input.workspaceName, 'WORKSPACE_NAME');\n        return this.invoke({ action: 'bootstrap', workspaceId, workspaceName });\n    }\n    async getContext(workspaceId, maxRecords = 100) {\n        return this.invoke({\n            action: 'context',\n            workspaceId: required(workspaceId, 'WORKSPACE_ID'),\n            maxRecords\n        });\n    }\n    async addonHealth(workspaceId) {\n        return this.invoke({\n            action: 'addon_health',\n            workspaceId: required(workspaceId, 'WORKSPACE_ID')\n        });\n    }\n    async startAddonTrial(workspaceId) {\n        return this.invoke({\n            action: 'addon_trial_start',\n            workspaceId: required(workspaceId, 'WORKSPACE_ID')\n        });\n    }\n    async analyzeAddon(input) {\n        return this.invoke({\n            action: 'addon_analyze',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            requestId: required(input.requestId, 'REQUEST_ID'),\n            capabilities: input.capabilities,\n            input: input.input,\n            routeContext: input.routeContext ?? {}\n        });\n    }\n    async reviewAddonEvidence(input) {\n        return this.invoke({\n            action: 'addon_review',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            eventId: required(input.eventId, 'EVENT_ID'),\n            evidenceId: required(input.evidenceId, 'EVIDENCE_ID'),\n            expectedVersion: input.expectedVersion,\n            disposition: input.disposition,\n            notes: input.notes ?? null\n        });\n    }\n    async reportStatus(workspaceId, limit = 20) {\n        return this.invoke({\n            action: 'report_status',\n            workspaceId: required(workspaceId, 'WORKSPACE_ID'),\n            limit\n        });\n    }\n    async reportOpsStatus(workspaceId) {\n        return this.invoke({\n            action: 'report_ops_status',\n            workspaceId: required(workspaceId, 'WORKSPACE_ID')\n        });\n    }\n    async searchWorkspace(workspaceId, query = '', limit = 20) {\n        return this.invoke({\n            action: 'search',\n            workspaceId: required(workspaceId, 'WORKSPACE_ID'),\n            query: typeof query === 'string' ? query : '',\n            limit\n        });\n    }\n    async searchDetail(workspaceId, objectType, objectId) {\n        return this.invoke({\n            action: 'search_detail',\n            workspaceId: required(workspaceId, 'WORKSPACE_ID'),\n            objectType: required(objectType, 'OBJECT_TYPE'),\n            objectId: required(objectId, 'OBJECT_ID')\n        });\n    }\n    async onboardingContextStatus(workspaceId) {\n        return this.invoke({\n            action: 'onboarding_context_status',\n            workspaceId: required(workspaceId, 'WORKSPACE_ID')\n        });\n    }\n    async saveOnboardingContext(input) {\n        return this.invoke({\n            action: 'onboarding_context_save',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            eventId: required(input.eventId, 'EVENT_ID'),\n            expectedVersion: input.expectedVersion ?? 0,\n            role: input.role ?? 'TEAM_MANAGER',\n            situation: input.situation ?? 'NEW_ROLE',\n            teamName: input.teamName ?? '',\n            manager: input.manager ?? '',\n            startDate: input.startDate ?? '',\n            managerSync: input.managerSync ?? '',\n            question: input.question ?? ''\n        });\n    }\n    async leadershipResumeStatus(workspaceId) {\n        return this.invoke({\n            action: 'leadership_resume_status',\n            workspaceId: required(workspaceId, 'WORKSPACE_ID')\n        });\n    }\n    async leadershipOnboardingRoster(workspaceId) {\n        return this.invoke({\n            action: 'leadership_onboarding_roster',\n            workspaceId: required(workspaceId, 'WORKSPACE_ID')\n        });\n    }\n    async missionChecklistStatus(workspaceId) {\n        return this.invoke({\n            action: 'mission_checklist_status',\n            workspaceId: required(workspaceId, 'WORKSPACE_ID')\n        });\n    }\n    async saveMissionChecklist(input) {\n        return this.invoke({\n            action: 'mission_checklist_save',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            eventId: required(input.eventId, 'EVENT_ID'),\n            expectedVersion: input.expectedVersion ?? 0,\n            checksByDay: input.checksByDay ?? {}\n        });\n    }\n    async leadershipSelfCheckStatus(workspaceId) {\n        return this.invoke({\n            action: 'leadership_self_check_status',\n            workspaceId: required(workspaceId, 'WORKSPACE_ID')\n        });\n    }\n    async saveLeadershipSelfCheck(input) {\n        return this.invoke({\n            action: 'leadership_self_check_save',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            eventId: required(input.eventId, 'EVENT_ID'),\n            expectedVersion: input.expectedVersion ?? 0,\n            levelsByDay: input.levelsByDay ?? {}\n        });\n    }\n    async createPeoplePreferenceRequest(input) {\n        return this.invoke({\n            action: 'people_preference_request_create',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            personId: required(input.personId, 'PERSON_ID'),\n            expiresInDays: input.expiresInDays ?? 7\n        });\n    }\n    async listPeoplePreferenceRequests(workspaceId, personId = null) {\n        return this.invoke({\n            action: 'people_preference_request_list',\n            workspaceId: required(workspaceId, 'WORKSPACE_ID'),\n            personId: personId || null\n        });\n    }\n    async applyPeoplePreferenceRequest(input) {\n        return this.invoke({\n            action: 'people_preference_request_apply',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            preferenceRequestId: required(input.preferenceRequestId, 'PREFERENCE_REQUEST_ID'),\n            expectedProfileVersion: input.expectedProfileVersion ?? 0,\n            eventId: required(input.eventId, 'EVENT_ID')\n        });\n    }\n    async resolvePeoplePreferenceRequest(input) {\n        return this.invoke({\n            action: 'people_preference_request_resolve',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            preferenceRequestId: required(input.preferenceRequestId, 'PREFERENCE_REQUEST_ID'),\n            decision: required(input.decision, 'DECISION')\n        });\n    }\n    async peopleCollaborationStatus(workspaceId, personId = null) {\n        return this.invoke({\n            action: 'people_collaboration_status',\n            workspaceId: required(workspaceId, 'WORKSPACE_ID'),\n            personId: personId || null\n        });\n    }\n    async savePeopleProfile(input) {\n        return this.invoke({\n            action: 'people_profile_save',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            eventId: required(input.eventId, 'EVENT_ID'),\n            expectedVersion: input.expectedVersion ?? 0,\n            personId: required(input.personId, 'PERSON_ID'),\n            personName: input.personName ?? '',\n            role: input.role ?? '',\n            instructionPreference: input.instructionPreference ?? '',\n            autonomyPreference: input.autonomyPreference ?? '',\n            checkpointPreference: input.checkpointPreference ?? '',\n            feedbackPreference: input.feedbackPreference ?? '',\n            reportingPreference: input.reportingPreference ?? '',\n            communicationPreference: input.communicationPreference ?? '',\n            focusPreference: input.focusPreference ?? '',\n            availabilityPreference: input.availabilityPreference ?? '',\n            styleLabel: input.styleLabel ?? '',\n            preferenceConfirmedAt: input.preferenceConfirmedAt ?? '',\n            patterns: Array.isArray(input.patterns) ? input.patterns : []\n        });\n    }\n    async savePeopleSource(input) {\n        return this.invoke({\n            action: 'people_source_save',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            eventId: required(input.eventId, 'EVENT_ID'),\n            expectedVersion: input.expectedVersion ?? 0,\n            personId: required(input.personId, 'PERSON_ID'),\n            sourceId: required(input.sourceId, 'SOURCE_ID'),\n            sourceKind: input.sourceKind ?? 'NOTE',\n            occurredAt: input.occurredAt ?? '',\n            summary: input.summary ?? '',\n            transcriptExcerpt: input.transcriptExcerpt ?? '',\n            candidatePatterns: Array.isArray(input.candidatePatterns) ? input.candidatePatterns : [],\n            consentConfirmed: Boolean(input.consentConfirmed),\n            fileName: input.fileName ?? '',\n            mimeType: input.mimeType ?? '',\n            sizeBytes: input.sizeBytes ?? 0,\n            storagePath: input.storagePath ?? '',\n            linkedInstructionId: input.linkedInstructionId ?? '',\n            reworkRounds: input.reworkRounds ?? null,\n            checkpointOutcome: input.checkpointOutcome ?? '',\n            instructionOutcome: input.instructionOutcome ?? ''\n        });\n    }\n    async savePeopleInstruction(input) {\n        return this.invoke({\n            action: 'people_instruction_save',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            eventId: required(input.eventId, 'EVENT_ID'),\n            expectedVersion: input.expectedVersion ?? 0,\n            personId: required(input.personId, 'PERSON_ID'),\n            instructionId: required(input.instructionId, 'INSTRUCTION_ID'),\n            task: input.task ?? '',\n            goal: input.goal ?? '',\n            context: input.context ?? '',\n            output: input.output ?? '',\n            doneCriteria: input.doneCriteria ?? '',\n            autonomy: input.autonomy ?? '',\n            guardrail: input.guardrail ?? '',\n            checkpoint: input.checkpoint ?? '',\n            reporting: input.reporting ?? '',\n            feedback: input.feedback ?? '',\n            workflow: Array.isArray(input.workflow) ? input.workflow : [],\n            rationaleSources: Array.isArray(input.rationaleSources) ? input.rationaleSources : [],\n            patternRefs: Array.isArray(input.patternRefs) ? input.patternRefs : [],\n            rationaleDetails: Array.isArray(input.rationaleDetails) ? input.rationaleDetails : []\n        });\n    }\n    async setupChecklistStatus(workspaceId) {\n        return this.invoke({\n            action: 'setup_checklist_status',\n            workspaceId: required(workspaceId, 'WORKSPACE_ID')\n        });\n    }\n    async questProgressStatus(workspaceId) {\n        return this.invoke({\n            action: 'quest_progress_status',\n            workspaceId: required(workspaceId, 'WORKSPACE_ID')\n        });\n    }\n    async saveQuestProgress(input) {\n        return this.invoke({\n            action: 'quest_progress_save',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            eventId: required(input.eventId, 'EVENT_ID'),\n            expectedVersion: input.expectedVersion ?? 0,\n            completedDays: Array.isArray(input.completedDays) ? input.completedDays : [],\n            selectedDay: input.selectedDay ?? 1\n        });\n    }\n    async saveSetupChecklist(input) {\n        return this.invoke({\n            action: 'setup_checklist_save',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            eventId: required(input.eventId, 'EVENT_ID'),\n            expectedVersion: input.expectedVersion ?? 0,\n            checkedIds: Array.isArray(input.checkedIds) ? input.checkedIds : []\n        });\n    }\n    async reviewQuestEvidence(input) {\n        return this.invoke({\n            action: 'quest_evidence_review',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            eventId: required(input.eventId, 'EVENT_ID'),\n            evidenceId: required(input.evidenceId, 'EVIDENCE_ID'),\n            expectedVersion: input.expectedVersion,\n            disposition: required(input.disposition, 'DISPOSITION'),\n            notes: input.notes ?? null\n        });\n    }\n    async operatingArtifactsStatus(workspaceId, limit = 200) {\n        return this.invoke({\n            action: 'operating_artifacts_status',\n            workspaceId: required(workspaceId, 'WORKSPACE_ID'),\n            limit\n        });\n    }\n    async saveOperatingArtifact(input) {\n        return this.invoke({\n            action: 'operating_artifact_save',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            eventId: required(input.eventId, 'EVENT_ID'),\n            artifactId: required(input.artifactId, 'ARTIFACT_ID'),\n            artifactType: required(input.artifactType, 'ARTIFACT_TYPE'),\n            artifactState: required(input.artifactState, 'ARTIFACT_STATE'),\n            expectedVersion: input.expectedVersion ?? 0,\n            localVersion: input.localVersion ?? 1,\n            title: input.title ?? null,\n            payload: input.payload ?? {}\n        });\n    }\n    async deleteOperatingArtifact(input) {\n        return this.invoke({\n            action: 'operating_artifact_delete',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            eventId: required(input.eventId, 'EVENT_ID'),\n            artifactId: required(input.artifactId, 'ARTIFACT_ID'),\n            expectedVersion: input.expectedVersion\n        });\n    }\n    async linkQuestEvidence(input) {\n        return this.invoke({\n            action: 'quest_evidence_link',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            eventId: required(input.eventId, 'EVENT_ID'),\n            questDay: input.questDay,\n            questTitle: required(input.questTitle, 'QUEST_TITLE'),\n            artifactType: input.artifactType ?? null,\n            evidenceText: input.evidenceText ?? null,\n            linkedObjectType: input.linkedObjectType ?? null,\n            linkedObjectId: input.linkedObjectId ?? null\n        });\n    }\n    async saveReportSchedule(input) {\n        return this.invoke({\n            action: 'report_schedule_save',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            timezone: input.timezone ?? 'Asia/Seoul',\n            dailyEnabled: input.dailyEnabled === true,\n            dailyTime: input.dailyTime ?? '17:30',\n            dailyWeekdays: input.dailyWeekdays ?? [1, 2, 3, 4, 5],\n            weeklyEnabled: input.weeklyEnabled === true,\n            weeklyIsoDow: input.weeklyIsoDow ?? 5,\n            weeklyTime: input.weeklyTime ?? '16:00'\n        });\n    }\n    async prepareReportNow(input) {\n        return this.invoke({\n            action: 'report_prepare_now',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            reportType: input.reportType\n        });\n    }\n    async confirmReport(input) {\n        return this.invoke({\n            action: 'report_confirm',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            reportId: required(input.reportId, 'REPORT_ID'),\n            expectedVersion: input.expectedVersion,\n            finalPatch: input.finalPatch ?? {}\n        });\n    }\n    async queueReportDelivery(input) {\n        return this.invoke({\n            action: 'report_queue_delivery',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            reportId: required(input.reportId, 'REPORT_ID'),\n            channel: input.channel,\n            targetRef: input.targetRef ?? null\n        });\n    }\n    async write(input) {\n        return this.invoke({\n            action: 'write',\n            workspaceId: required(input.workspaceId, 'WORKSPACE_ID'),\n            eventId: required(input.eventId, 'EVENT_ID'),\n            objectType: input.objectType,\n            objectId: required(input.objectId, 'OBJECT_ID'),\n            eventType: required(input.eventType, 'EVENT_TYPE'),\n            expectedVersion: input.expectedVersion,\n            source: input.source ?? 'APP',\n            patch: input.patch ?? {},\n            confirmed: input.confirmed ?? null,\n            supersededBy: input.supersededBy ?? null,\n            accessScope: input.accessScope ?? null,\n            granteeUserIds: input.granteeUserIds ?? null\n        });\n    }\n}\nexport function allContextItems(pack) {\n    return [\n        ...pack.truth,\n        ...pack.evidence,\n        ...pack.recommendations,\n        ...pack.operational,\n        ...pack.candidates\n    ];\n}\n","skills.js":"export function buildSkillRun(skill) {\n    return {\n        skillId: skill.id,\n        name: skill.name,\n        mode: skill.mode,\n        scope: skill.scope,\n        stages: ['ENTRY', 'WHY_NOW', 'PREPARE', 'RUN', 'CAPTURE', 'DECISION', 'ACTION', 'FOLLOW_UP', 'REVIEW'],\n        currentStage: 'ENTRY',\n        whyNow: skill.whyNow,\n        prepare: skill.prepare,\n        run: skill.run,\n        captures: [],\n        humanDecisionRequired: true,\n        completed: false\n    };\n}\nexport function captureSkillOutput(run, input) {\n    if (!input.text?.trim())\n        return { ok: false, error: 'CAPTURE_TEXT_REQUIRED' };\n    const allowed = new Set(['DECISION_CANDIDATE', 'ACTION_CANDIDATE', 'COMMITMENT_CANDIDATE', 'OPEN_QUESTION', 'FOLLOW_UP']);\n    if (!allowed.has(input.type))\n        return { ok: false, error: 'UNSAFE_SKILL_CAPTURE_TYPE' };\n    return {\n        ok: true,\n        run: {\n            ...run,\n            currentStage: 'CAPTURE',\n            captures: [...run.captures, { type: input.type, text: input.text.trim(), confirmed: false }]\n        }\n    };\n}\nexport function finalizeSkillRun(run, reviewer) {\n    if (reviewer.type !== 'HUMAN' || !reviewer.id)\n        return { ok: false, error: 'HUMAN_REVIEW_REQUIRED' };\n    return { ok: true, run: { ...run, currentStage: 'REVIEW', completed: true, reviewedBy: { type: 'HUMAN', id: reviewer.id } } };\n}\n","supabase-auth.js":"export class SupabaseAuthError extends Error {\n    code;\n    status;\n    constructor(code, status) {\n        super(code);\n        this.code = code;\n        this.status = status;\n        this.name = 'SupabaseAuthError';\n    }\n}\nconst required = (v, n) => { const t = v?.trim(); if (!t)\n    throw new Error(`${n}_REQUIRED`); return t; };\nfunction authErrorCode(p, f) { for (const k of ['error_code', 'code', 'error', 'msg', 'message']) {\n    const v = p[k];\n    if (typeof v === 'string' && v.trim())\n        return v.trim();\n} return f; }\nfunction parseSession(p, now = Date.now()) { const accessToken = typeof p.access_token === 'string' ? p.access_token : null; if (!accessToken)\n    return null; const refreshToken = typeof p.refresh_token === 'string' ? p.refresh_token : null; const expiresIn = Number(p.expires_in ?? 3600); const u = p.user && typeof p.user === 'object' ? p.user : {}; const userId = typeof u.id === 'string' ? u.id : ''; const email = typeof u.email === 'string' && u.email.trim() ? u.email.trim() : null; if (!userId)\n    throw new SupabaseAuthError('AUTH_USER_ID_REQUIRED', 500); return { accessToken, refreshToken, expiresAt: now + Math.max(1, Number.isFinite(expiresIn) ? expiresIn : 3600) * 1000, userId, email }; }\nfunction isSession(v) { if (!v || typeof v !== 'object')\n    return false; const s = v; return typeof s.accessToken === 'string' && s.accessToken.length > 0 && (typeof s.refreshToken === 'string' || s.refreshToken === null) && typeof s.expiresAt === 'number' && Number.isFinite(s.expiresAt) && typeof s.userId === 'string' && s.userId.length > 0 && (typeof s.email === 'string' || s.email === null); }\nfunction defaultStorageKey(baseUrl) { try {\n    return `leader-os:auth:v1:${new URL(baseUrl).hostname}`;\n}\ncatch {\n    return 'leader-os:auth:v1';\n} }\nexport class SupabasePasswordAuthClient {\n    config;\n    transport;\n    baseUrl;\n    session = null;\n    refreshSkewMs;\n    storage;\n    storageKey;\n    refreshInFlight = null;\n    constructor(config, transport = fetch) {\n        this.config = config;\n        this.transport = transport;\n        this.baseUrl = required(config.supabaseUrl, 'SUPABASE_URL').replace(/\\/+$/, '');\n        required(config.publishableKey, 'SUPABASE_PUBLISHABLE_KEY');\n        this.refreshSkewMs = Math.max(5, config.refreshSkewSeconds ?? 60) * 1000;\n        this.storage = config.storage ?? null;\n        this.storageKey = config.storageKey?.trim() || defaultStorageKey(this.baseUrl);\n    }\n    currentSession() { return this.session ? { ...this.session } : null; }\n    get persistedSessionKey() { return this.storageKey; }\n    readPersistedSession() { if (!this.storage)\n        return null; try {\n        const raw = this.storage.getItem(this.storageKey);\n        if (!raw)\n            return null;\n        const parsed = JSON.parse(raw);\n        if (parsed.schemaVersion !== '1' || !isSession(parsed.session)) {\n            this.removePersistedSession();\n            return null;\n        }\n        return { ...parsed.session };\n    }\n    catch {\n        this.removePersistedSession();\n        return null;\n    } }\n    persistSession(s) { if (!this.storage)\n        return; try {\n        this.storage.setItem(this.storageKey, JSON.stringify({ schemaVersion: '1', session: s }));\n    }\n    catch { } }\n    removePersistedSession() { if (!this.storage)\n        return; try {\n        if (this.storage.removeItem)\n            this.storage.removeItem(this.storageKey);\n        else\n            this.storage.setItem(this.storageKey, '');\n    }\n    catch { } }\n    commitSession(s) { this.session = { ...s }; this.persistSession(this.session); return this.currentSession(); }\n    async request(path, init, fallback = 'SUPABASE_AUTH_REQUEST_FAILED') { const r = await this.transport(`${this.baseUrl}${path}`, { ...init, headers: { apikey: this.config.publishableKey, ...(init.headers ?? {}) } }); let p = {}; try {\n        p = await r.json();\n    }\n    catch { } if (!r.ok)\n        throw new SupabaseAuthError(authErrorCode(p, fallback), r.status); return p; }\n    async post(path, body, accessToken) { return this.request(path, { method: 'POST', headers: { ...(accessToken ? { Authorization: `Bearer ${accessToken}` } : {}), 'Content-Type': 'application/json' }, body: JSON.stringify(body) }); }\n    async validateAccessToken(s) { const p = await this.request('/auth/v1/user', { method: 'GET', headers: { Authorization: `Bearer ${s.accessToken}` } }, 'AUTH_SESSION_INVALID'); const userId = typeof p.id === 'string' ? p.id : ''; if (!userId || userId !== s.userId)\n        throw new SupabaseAuthError('AUTH_SESSION_USER_MISMATCH', 401); const email = typeof p.email === 'string' && p.email.trim() ? p.email.trim() : s.email; return { ...s, email }; }\n    async signInWithPassword(email, password) { const p = await this.post('/auth/v1/token?grant_type=password', { email: required(email, 'EMAIL'), password: required(password, 'PASSWORD') }); const s = parseSession(p); if (!s)\n        throw new SupabaseAuthError('AUTH_SESSION_REQUIRED', 401); return this.commitSession(s); }\n    async signUp(email, password) { const p = await this.post('/auth/v1/signup', { email: required(email, 'EMAIL'), password: required(password, 'PASSWORD') }); const s = parseSession(p); if (!s)\n        throw new SupabaseAuthError('EMAIL_CONFIRMATION_REQUIRED', 202); return this.commitSession(s); }\n    async refreshOnce() { const cur = this.session; const rt = cur?.refreshToken; if (!rt)\n        throw new SupabaseAuthError('REFRESH_TOKEN_REQUIRED', 401); const p = await this.post('/auth/v1/token?grant_type=refresh_token', { refresh_token: rt }); const s = parseSession(p); if (!s)\n        throw new SupabaseAuthError('AUTH_SESSION_REQUIRED', 401); if (cur?.userId && s.userId !== cur.userId)\n        throw new SupabaseAuthError('AUTH_SESSION_USER_MISMATCH', 401); return this.commitSession(s); }\n    async refresh() { if (this.refreshInFlight)\n        return this.refreshInFlight; const pending = this.refreshOnce(); this.refreshInFlight = pending; try {\n        return await pending;\n    }\n    finally {\n        if (this.refreshInFlight === pending)\n            this.refreshInFlight = null;\n    } }\n    async restoreSession() { const persisted = this.readPersistedSession(); if (!persisted)\n        return null; this.session = persisted; try {\n        if (Date.now() >= persisted.expiresAt - this.refreshSkewMs)\n            return await this.refresh();\n        return this.commitSession(await this.validateAccessToken(persisted));\n    }\n    catch (error) {\n        let refreshError = null;\n        if (persisted.refreshToken) {\n            try {\n                this.session = persisted;\n                return await this.refresh();\n            }\n            catch (e) {\n                refreshError = e;\n            }\n        }\n        const transient = [error, refreshError].some(x => x instanceof SupabaseAuthError && x.status >= 500);\n        if (transient) {\n            this.session = null;\n            throw (refreshError instanceof SupabaseAuthError && refreshError.status >= 500 ? refreshError : error);\n        }\n        this.clearSession();\n        return null;\n    } }\n    async getAccessToken() { if (!this.session)\n        throw new SupabaseAuthError('AUTH_SESSION_REQUIRED', 401); if (Date.now() >= this.session.expiresAt - this.refreshSkewMs)\n        await this.refresh(); return this.session.accessToken; }\n    async signOut() { const s = this.session ?? this.readPersistedSession(); try {\n        if (s?.accessToken)\n            await this.request('/auth/v1/logout?scope=local', { method: 'POST', headers: { Authorization: `Bearer ${s.accessToken}`, 'Content-Type': 'application/json' }, body: '{}' }, 'AUTH_SIGN_OUT_FAILED');\n    }\n    finally {\n        this.clearSession();\n    } }\n    clearSession() { this.session = null; this.removePersistedSession(); }\n}\n","team.js":"const PROHIBITED_PERSON_FIELDS = new Set([\n    'score',\n    'rank',\n    'performanceRating',\n    'potential',\n    'motivation',\n    'cultureFit',\n    'personality',\n    'highPotential',\n    'lowPerformer'\n]);\nfunction hasProhibitedField(person) {\n    for (const key of Object.keys(person)) {\n        if (PROHIBITED_PERSON_FIELDS.has(key))\n            return key;\n    }\n    return null;\n}\nexport function buildTeamView(team) {\n    const accepted = [];\n    const rejected = [];\n    for (const person of Array.isArray(team?.people) ? team.people : []) {\n        if (!person?.id || !person?.name?.trim()) {\n            rejected.push({ id: person?.id ?? null, reason: 'PERSON_ID_NAME_REQUIRED' });\n            continue;\n        }\n        const prohibited = hasProhibitedField(person);\n        if (prohibited) {\n            rejected.push({ id: person.id, reason: `PROHIBITED_PERSON_FIELD:${prohibited}` });\n            continue;\n        }\n        accepted.push({\n            id: person.id,\n            name: person.name.trim(),\n            role: person.role?.trim() || undefined,\n            currentPriority: person.currentPriority ?? null,\n            currentProject: person.currentProject ?? null,\n            blocker: person.blocker ?? null,\n            openCommitments: [...new Set((person.openCommitments ?? []).filter(Boolean))],\n            lastConversationAt: person.lastConversationAt ?? null,\n            nextConversationAt: person.nextConversationAt ?? null\n        });\n    }\n    return {\n        view: 'TEAM',\n        teamId: team?.id ?? null,\n        teamName: team?.name?.trim() || '',\n        peopleRanking: false,\n        personScores: [],\n        people: accepted,\n        rejected,\n        operatingSummary: {\n            peopleCount: accepted.length,\n            blockedCount: accepted.filter((person) => Boolean(person.blocker)).length,\n            openCommitmentCount: accepted.reduce((sum, person) => sum + (person.openCommitments?.length ?? 0), 0),\n            conversationsScheduled: accepted.filter((person) => Boolean(person.nextConversationAt)).length\n        }\n    };\n}\nexport function validateTeamView(view) {\n    const violations = [];\n    if (view.peopleRanking !== false)\n        violations.push('PEOPLE_RANKING_PROHIBITED');\n    if (view.personScores.length > 0)\n        violations.push('PERSON_SCORES_PROHIBITED');\n    for (const person of view.people) {\n        const prohibited = hasProhibitedField(person);\n        if (prohibited)\n            violations.push(`PROHIBITED_PERSON_FIELD:${prohibited}`);\n    }\n    return { ok: violations.length === 0, violations };\n}\nexport function buildPersonView(person) {\n    const team = buildTeamView({ id: 'single', name: 'single', people: [person] });\n    if (team.people.length !== 1) {\n        return { ok: false, error: team.rejected[0]?.reason ?? 'INVALID_PERSON_CONTEXT' };\n    }\n    const safe = team.people[0];\n    return {\n        ok: true,\n        view: {\n            view: 'PERSON',\n            ...safe,\n            rating: null,\n            rank: null,\n            interpretationStatus: 'CONTEXT_ONLY'\n        }\n    };\n}\n","today.js":"const ALLOWED_VERBS = new Set([\n    'DECIDE',\n    'TALK',\n    'PREPARE',\n    'UNBLOCK',\n    'FOLLOW_UP',\n    'ALIGN',\n    'REVIEW'\n]);\nconst criticalityWeight = {\n    P0: 1000,\n    P1: 500,\n    P2: 100,\n    P3: 0\n};\nfunction uniqueRefs(values) {\n    return [...new Set(values.map((value) => value.trim()).filter(Boolean))];\n}\nfunction validateCandidate(candidate) {\n    if (!candidate?.id)\n        return 'ATTENTION_ID_REQUIRED';\n    if (!ALLOWED_VERBS.has(candidate.verb))\n        return 'INVALID_ATTENTION_VERB';\n    if (!candidate.title?.trim())\n        return 'ATTENTION_TITLE_REQUIRED';\n    if (!candidate.reason?.trim())\n        return 'ATTENTION_REASON_REQUIRED';\n    if (!Array.isArray(candidate.evidenceRefs) || uniqueRefs(candidate.evidenceRefs).length === 0) {\n        return 'ATTENTION_EVIDENCE_REQUIRED';\n    }\n    if (!Number.isFinite(candidate.confidence) || candidate.confidence < 0 || candidate.confidence > 1) {\n        return 'INVALID_ATTENTION_CONFIDENCE';\n    }\n    if (!Number.isFinite(candidate.attentionPriority))\n        return 'ATTENTION_PRIORITY_REQUIRED';\n    return null;\n}\nfunction rankingValue(candidate) {\n    const pinWeight = candidate.humanPinned === true ? 10000 : 0;\n    const criticalWeight = candidate.criticality\n        ? criticalityWeight[candidate.criticality]\n        : 0;\n    return pinWeight + criticalWeight + candidate.attentionPriority;\n}\nexport function buildTodayView(candidates) {\n    const accepted = [];\n    const rejected = [];\n    for (const candidate of Array.isArray(candidates) ? candidates : []) {\n        const error = validateCandidate(candidate);\n        if (error) {\n            rejected.push({ id: candidate?.id ?? null, reason: error });\n            continue;\n        }\n        accepted.push({\n            ...candidate,\n            title: candidate.title.trim(),\n            reason: candidate.reason.trim(),\n            evidenceRefs: uniqueRefs(candidate.evidenceRefs),\n            confidenceIsNotTruth: true,\n            peopleScore: null\n        });\n    }\n    accepted.sort((a, b) => {\n        const diff = rankingValue(b) - rankingValue(a);\n        return diff !== 0 ? diff : a.id.localeCompare(b.id);\n    });\n    return {\n        view: 'TODAY',\n        maxAttention: 3,\n        attention: accepted.slice(0, 3),\n        rejected\n    };\n}\nexport function validateTodayView(view) {\n    const violations = [];\n    if (view.view !== 'TODAY')\n        violations.push('TODAY_VIEW_REQUIRED');\n    if (view.maxAttention !== 3)\n        violations.push('TODAY_TOP3_CONTRACT_BROKEN');\n    if (!Array.isArray(view.attention) || view.attention.length > 3) {\n        violations.push('TODAY_ATTENTION_LIMIT_BROKEN');\n    }\n    for (const item of view.attention ?? []) {\n        if (item.peopleScore !== null)\n            violations.push('PEOPLE_SCORE_PROHIBITED');\n        if (item.confidenceIsNotTruth !== true)\n            violations.push('CONFIDENCE_TRUTH_BOUNDARY_REQUIRED');\n        if (item.evidenceRefs.length === 0)\n            violations.push('ATTENTION_EVIDENCE_REQUIRED');\n    }\n    return { ok: violations.length === 0, violations };\n}\n","ui/billing-ui.js":"import { buildBillingSnapshot, createDemoBillingState, createManualTopUpRequest, createProviderCredentialMetadata, usageFundingDecision, validateBillingState } from '../billing.js';\nimport { escapeHtml } from './helpers.js';\nconst formatCredits = (value) => `${value.toLocaleString('ko-KR')} cr`;\nconst formatKrw = (value) => `₩${value.toLocaleString('ko-KR')}`;\nconst formatDate = (value) => new Intl.DateTimeFormat('ko-KR', { month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }).format(new Date(value));\nconst statusLabel = { PENDING: '확인 대기', APPROVED: '승인', REJECTED: '거절', CANCELLED: '취소' };\nexport function createBillingUi() {\n    const root = document.querySelector('[data-billing-root]');\n    if (!root)\n        throw new Error('BILLING_ROOT_MISSING');\n    let state = createDemoBillingState();\n    const validation = validateBillingState(state);\n    if (!validation.ok)\n        throw new Error(`BILLING_CONTRACT_FAILED:${validation.violations.join(',')}`);\n    const balance = root.querySelector('[data-billing-balance]');\n    const added = root.querySelector('[data-billing-added]');\n    const used = root.querySelector('[data-billing-used]');\n    const funding = root.querySelector('[data-billing-funding]');\n    const modeRoot = root.querySelector('[data-billing-mode]');\n    const history = root.querySelector('[data-billing-history]');\n    const requests = root.querySelector('[data-billing-requests]');\n    const keys = root.querySelector('[data-billing-keys]');\n    const topUpForm = root.querySelector('[data-topup-form]');\n    const topUpAmount = root.querySelector('[data-topup-amount]');\n    const topUpMethod = root.querySelector('[data-topup-method]');\n    const topUpReference = root.querySelector('[data-topup-reference]');\n    const topUpStatus = root.querySelector('[data-topup-status]');\n    const keyForm = root.querySelector('[data-key-form]');\n    const keyProvider = root.querySelector('[data-key-provider]');\n    const keyLabel = root.querySelector('[data-key-label]');\n    const keyValue = root.querySelector('[data-key-value]');\n    const keyStatus = root.querySelector('[data-key-status]');\n    if (!balance || !added || !used || !funding || !modeRoot || !history || !requests || !keys || !topUpForm || !topUpAmount || !topUpMethod || !topUpReference || !topUpStatus || !keyForm || !keyProvider || !keyLabel || !keyValue || !keyStatus)\n        throw new Error('BILLING_UI_CONTRACT_MISSING');\n    const render = () => { const snapshot = buildBillingSnapshot(state); balance.textContent = formatCredits(snapshot.availableCredits); added.textContent = formatCredits(snapshot.totalCreditsAdded); used.textContent = formatCredits(snapshot.totalCreditsUsed); const decision = usageFundingDecision(state, state.providerKeys.some((item) => item.status === 'CONNECTED')); funding.textContent = decision.source === 'BYOK' ? 'BYOK' : decision.source === 'PLATFORM_CREDITS' ? 'Platform credits' : '사용 불가'; for (const button of modeRoot.querySelectorAll('button[data-mode]')) {\n        const active = button.dataset.mode === state.mode;\n        button.classList.toggle('selected', active);\n        button.setAttribute('aria-pressed', String(active));\n    } history.innerHTML = ''; for (const entry of snapshot.ledger) {\n        const row = document.createElement('tr');\n        const sign = entry.creditDelta > 0 ? '+' : '';\n        row.innerHTML = `<td>${escapeHtml(formatDate(entry.createdAt))}</td><td>${escapeHtml(entry.description)}</td><td>${escapeHtml(entry.provider ?? '—')}</td><td class=\"billing-amount ${entry.creditDelta < 0 ? 'debit' : 'credit'}\">${sign}${escapeHtml(formatCredits(entry.creditDelta))}</td>`;\n        history.append(row);\n    } requests.innerHTML = ''; for (const request of snapshot.topUpRequests) {\n        const row = document.createElement('div');\n        row.className = 'billing-request';\n        row.innerHTML = `<div><strong>${escapeHtml(formatKrw(request.amountKrw))}</strong><div class=\"review-meta\">${escapeHtml(request.paymentMethod.replaceAll('_', ' '))} · ${escapeHtml(request.payerReference)}</div></div><div><span class=\"state-badge\">${escapeHtml(statusLabel[request.status])}</span><div class=\"review-meta\">${escapeHtml(formatCredits(request.requestedCredits))}</div></div>`;\n        requests.append(row);\n    } keys.innerHTML = ''; if (!snapshot.providerKeys.length) {\n        keys.innerHTML = '<div class=\"safe\">등록된 BYOK 연결이 없습니다.</div>';\n    }\n    else {\n        for (const key of snapshot.providerKeys) {\n            const card = document.createElement('div');\n            card.className = 'billing-key';\n            card.innerHTML = `<div><strong>${escapeHtml(key.label)}</strong><div class=\"review-meta\">${escapeHtml(key.provider)} · ${escapeHtml(key.maskedKey)}</div></div><span class=\"state-badge\">${escapeHtml(key.status.replaceAll('_', ' '))}</span>`;\n            keys.append(card);\n        }\n    } };\n    modeRoot.addEventListener('click', (event) => { const target = event.target; const button = target?.closest('button[data-mode]'); if (!button)\n        return; state = { ...state, mode: button.dataset.mode }; render(); });\n    topUpForm.addEventListener('submit', (event) => { event.preventDefault(); try {\n        const amountKrw = Number(topUpAmount.value);\n        const request = createManualTopUpRequest({ id: `TOP-${Date.now()}`, amountKrw, requestedCredits: amountKrw, paymentMethod: topUpMethod.value, payerReference: topUpReference.value, createdAt: new Date().toISOString() });\n        state = { ...state, topUpRequests: [request, ...state.topUpRequests] };\n        topUpReference.value = '';\n        topUpStatus.textContent = '충전 요청을 만들었습니다. 입금/증빙 확인 전에는 크레딧 잔액이 증가하지 않습니다.';\n        render();\n    }\n    catch (error) {\n        topUpStatus.textContent = error instanceof Error ? error.message : '충전 요청을 만들 수 없습니다.';\n    } });\n    keyForm.addEventListener('submit', (event) => { event.preventDefault(); try {\n        const metadata = createProviderCredentialMetadata({ id: `KEY-${Date.now()}`, provider: keyProvider.value, label: keyLabel.value, rawKey: keyValue.value, createdAt: new Date().toISOString() });\n        state = { ...state, providerKeys: [metadata, ...state.providerKeys] };\n        keyValue.value = '';\n        keyStatus.textContent = '원문 키를 브라우저에 저장하지 않았습니다. Production에서는 서버 Vault 저장/검증 후 CONNECTED로 전환합니다.';\n        render();\n    }\n    catch (error) {\n        keyStatus.textContent = error instanceof Error ? error.message : 'API 키 형식을 확인하세요.';\n    } });\n    render();\n    return { getSnapshot: () => buildBillingSnapshot(state) };\n}\n","ui/first-use-ui.js":"import { FIRST_USE_30_DAY_TASKS, isRealFirstUse, parseFirstUseMembers, parseFirstUseTasks } from '../onboarding.js';\nconst displayLabel = (label, email) => {\n    const raw = (label || email || '리더').trim();\n    if (raw.includes('@'))\n        return raw.split('@')[0] || '리더';\n    return raw;\n};\nexport function createFirstUseUi(options) {\n    const { controllers } = options;\n    const root = document.querySelector('[data-first-use]');\n    const title = document.querySelector('[data-first-use-title]');\n    const copy = document.querySelector('[data-first-use-copy]');\n    const workspaceForm = document.querySelector('[data-first-workspace-form]');\n    const workspaceName = document.querySelector('[data-first-workspace-name]');\n    const workspaceCreate = document.querySelector('[data-first-workspace-create]');\n    const setupForm = document.querySelector('[data-first-setup-form]');\n    const members = document.querySelector('[data-first-members]');\n    const tasks = document.querySelector('[data-first-tasks]');\n    const setupSave = document.querySelector('[data-first-setup-save]');\n    const status = document.querySelector('[data-first-use-status]');\n    const plan = document.querySelector('[data-first-use-plan]');\n    if (!root || !title || !copy || !workspaceForm || !workspaceName || !workspaceCreate || !setupForm || !members || !tasks || !setupSave || !status || !plan) {\n        throw new Error('FIRST_USE_UI_ROOT_MISSING');\n    }\n    const setStatus = (message, error = false) => {\n        status.textContent = message;\n        status.classList.toggle('error', error);\n    };\n    const renderPlan = () => {\n        plan.replaceChildren();\n        for (const item of FIRST_USE_30_DAY_TASKS) {\n            const card = document.createElement('div');\n            card.className = 'first-use-plan-item';\n            const days = document.createElement('span');\n            days.className = 'state-badge';\n            days.textContent = `Days ${item.days}`;\n            const heading = document.createElement('strong');\n            heading.textContent = item.title;\n            const reason = document.createElement('div');\n            reason.className = 'review-meta';\n            reason.textContent = item.reason;\n            card.append(days, heading, reason);\n            plan.append(card);\n        }\n    };\n    renderPlan();\n    const renderNoWorkspace = () => {\n        const identity = controllers.auth.identity;\n        const label = displayLabel(identity?.label, identity?.email);\n        root.hidden = false;\n        workspaceForm.hidden = false;\n        setupForm.hidden = true;\n        title.textContent = `${label}님, 팀장으로 첫 업무 공간을 만들어볼까요?`;\n        copy.textContent = '샘플 데이터는 넣지 않습니다. 실제 팀 이름부터 시작하고, 다음 단계에서 팀원과 내 과제를 등록합니다.';\n        if (!workspaceName.value.trim())\n            workspaceName.value = `${label} 팀`;\n        setStatus('Workspace는 버튼을 눌렀을 때만 생성됩니다. 자동 생성하지 않습니다.');\n    };\n    const renderEmptyWorkspace = (pack) => {\n        if (!isRealFirstUse(pack)) {\n            hide();\n            return;\n        }\n        const identity = controllers.auth.identity;\n        const label = displayLabel(identity?.label, identity?.email);\n        root.hidden = false;\n        workspaceForm.hidden = true;\n        setupForm.hidden = false;\n        title.textContent = `${label}님, 이제 팀을 Leader OS에 알려주세요.`;\n        copy.textContent = '팀원 이름과 내가 맡은 첫 과제만 적으면 됩니다. 역할을 모르면 비워두세요. Leader OS가 임의로 추측하지 않습니다.';\n        setStatus('등록한 내용은 실제 Workspace Context에 저장됩니다. 30일 계획은 확인 후 함께 생성합니다.');\n    };\n    const hide = () => { root.hidden = true; };\n    workspaceForm.addEventListener('submit', async (event) => {\n        event.preventDefault();\n        const name = workspaceName.value.trim();\n        if (!name) {\n            setStatus('팀 또는 Workspace 이름을 입력하세요.', true);\n            workspaceName.focus();\n            return;\n        }\n        workspaceCreate.disabled = true;\n        setStatus('내 Workspace를 만들고 있습니다…');\n        try {\n            const hydrated = await controllers.workspaces.create(name);\n            renderEmptyWorkspace(hydrated.contextPack);\n            options.onContextChanged(hydrated.contextPack);\n            options.announce(`${name} Workspace를 만들었습니다. 이제 팀원과 첫 과제를 등록하세요.`);\n        }\n        catch (error) {\n            setStatus(`Workspace 생성 실패 · ${error instanceof Error ? error.message : String(error)}`, true);\n        }\n        finally {\n            workspaceCreate.disabled = false;\n        }\n    });\n    setupForm.addEventListener('submit', async (event) => {\n        event.preventDefault();\n        const parsedMembers = parseFirstUseMembers(members.value);\n        const parsedTasks = parseFirstUseTasks(tasks.value);\n        if (parsedMembers.length === 0) {\n            setStatus('팀원 이름을 한 명 이상 입력하세요.', true);\n            members.focus();\n            return;\n        }\n        if (parsedTasks.length === 0) {\n            setStatus('내가 맡은 첫 과제를 한 개 이상 입력하세요.', true);\n            tasks.focus();\n            return;\n        }\n        setupSave.disabled = true;\n        setStatus('팀과 첫 30일 계획을 저장하고 Today를 준비하는 중입니다…');\n        try {\n            const hydrated = await controllers.domainActions.completeFirstUse({ members: parsedMembers, myTasks: parsedTasks });\n            hide();\n            options.onContextChanged(hydrated.contextPack);\n            options.announce('첫 팀 정보와 30일 온보딩 계획을 저장했습니다. Today에서 오늘 할 일을 확인하세요.');\n        }\n        catch (error) {\n            setStatus(`첫 설정 저장 실패 · ${error instanceof Error ? error.message : String(error)}`, true);\n        }\n        finally {\n            setupSave.disabled = false;\n        }\n    });\n    return { renderNoWorkspace, renderEmptyWorkspace, hide };\n}\n","ui/helpers.js":"export const escapeHtml = (value) => String(value ?? '').replace(/[&<>\"']/g, (char) => ({\n    '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;'\n}[char] ?? char));\nexport function requiredElement(selector, name) {\n    const element = document.querySelector(selector);\n    if (!element)\n        throw new Error(`${name}_MISSING`);\n    return element;\n}\nexport async function copyTextToClipboard(text) {\n    try {\n        await navigator.clipboard.writeText(text);\n    }\n    catch {\n        const textarea = document.createElement('textarea');\n        textarea.value = text;\n        textarea.style.position = 'fixed';\n        textarea.style.opacity = '0';\n        document.body.append(textarea);\n        textarea.select();\n        document.execCommand('copy');\n        textarea.remove();\n    }\n}\n","ui/live-session-ui.js":"import { buildLiveTodayProjection } from '../live-today.js';\nimport { objectTitle, parseObjectRoute } from '../object-detail.js';\nimport { buildPersonalHome } from '../personalization.js';\nimport { buildTodayView } from '../today.js';\nimport { browserTimezone, preferenceTodayRoute } from '../user-preferences.js';\nimport { isRealFirstUse } from '../onboarding.js';\nimport { createFirstUseUi } from './first-use-ui.js';\nexport function createLiveSessionUi(options) {\n    const { session, controllers } = options;\n    const liveOpen = document.querySelector('[data-live-open]');\n    const liveDisconnect = document.querySelector('[data-live-disconnect]');\n    const liveCancel = document.querySelector('[data-live-cancel]');\n    const liveForm = document.querySelector('[data-live-form]');\n    const liveEmail = document.querySelector('[data-live-email]');\n    const livePassword = document.querySelector('[data-live-password]');\n    const workspacePicker = document.querySelector('[data-workspace-picker]');\n    const workspaceChoiceCopy = document.querySelector('[data-workspace-choice-copy]');\n    const workspaceSelect = document.querySelector('[data-live-workspace-select]');\n    const workspaceOpen = document.querySelector('[data-live-workspace-open]');\n    const liveConnect = document.querySelector('[data-live-connect]');\n    const liveMessage = document.querySelector('[data-live-connect-message]');\n    const todayMode = document.querySelector('[data-today-mode]');\n    const workspaceBadge = document.querySelector('.workspace-badge');\n    const metricsTitle = document.querySelector('[data-today-metrics-title]');\n    const metricLabels = Array.from(document.querySelectorAll('[data-today-metric-label]'));\n    const metricValues = Array.from(document.querySelectorAll('[data-today-metric-value]'));\n    const metricsNote = document.querySelector('[data-today-metrics-note]');\n    const userBadge = document.querySelector('[data-user-badge]');\n    const personalHome = document.querySelector('[data-personal-home]');\n    const personalName = document.querySelector('[data-personal-name]');\n    const personalMeta = document.querySelector('[data-personal-meta]');\n    const personalSummary = document.querySelector('[data-personal-summary]');\n    const myProjects = document.querySelector('[data-my-projects]');\n    const workspaceSwitcherWrap = document.querySelector('[data-workspace-switcher-wrap]');\n    const workspaceSwitcher = document.querySelector('[data-workspace-switcher]');\n    const workspaceRole = document.querySelector('[data-workspace-role]');\n    const preferenceForm = document.querySelector('[data-preference-form]');\n    const preferenceVersion = document.querySelector('[data-preference-version]');\n    const preferenceDisplayName = document.querySelector('[data-pref-display-name]');\n    const preferenceRoleMode = document.querySelector('[data-pref-role-mode]');\n    const preferenceDefaultWorkspace = document.querySelector('[data-pref-default-workspace]');\n    const preferenceTimezone = document.querySelector('[data-pref-timezone]');\n    const preferenceTodayView = document.querySelector('[data-pref-today-view]');\n    const preferenceWorkStart = document.querySelector('[data-pref-work-start]');\n    const preferenceWorkEnd = document.querySelector('[data-pref-work-end]');\n    const preferenceWeekdays = Array.from(document.querySelectorAll('[data-pref-weekdays] input[type=checkbox]'));\n    const preferenceNotifyBrowser = document.querySelector('[data-pref-notify-browser]');\n    const preferenceNotifyEmail = document.querySelector('[data-pref-notify-email]');\n    const preferenceNotifyDigest = document.querySelector('[data-pref-notify-digest]');\n    const preferenceSave = document.querySelector('[data-pref-save]');\n    const preferenceStatus = document.querySelector('[data-pref-status]');\n    const todayWelcome = document.querySelector('[data-today-welcome]');\n    const todayGreeting = document.querySelector('[data-today-greeting]');\n    const todayWelcomeTitle = document.querySelector('[data-today-welcome-title]');\n    const todayWelcomeCopy = document.querySelector('[data-today-welcome-copy]');\n    let firstUseUi;\n    let defaultViewApplied = false;\n    const workspaces = () => controllers.workspaces.list();\n    const preferences = () => controllers.preferences.current;\n    const setLiveMessage = (message, error = false) => {\n        if (!liveMessage)\n            return;\n        liveMessage.hidden = !message;\n        liveMessage.textContent = message;\n        liveMessage.classList.toggle('error', error);\n    };\n    const setMode = (mode) => {\n        if (!todayMode)\n            return;\n        todayMode.textContent = mode;\n        todayMode.classList.toggle('live', mode === 'LIVE');\n        todayMode.classList.toggle('connecting', mode === 'CONNECTING');\n        todayMode.classList.toggle('signed-in', mode === 'SIGNED IN');\n    };\n    const renderDemoMetrics = () => {\n        if (metricsTitle)\n            metricsTitle.textContent = 'Operating Quality';\n        const labels = ['Decision clarity', 'Follow-up', 'Evidence traceability'];\n        const values = ['82', '74', '91'];\n        metricLabels.forEach((node, index) => node.textContent = labels[index] ?? '');\n        metricValues.forEach((node, index) => node.textContent = values[index] ?? '');\n        if (metricsNote)\n            metricsNote.innerHTML = '<span class=\"pill\">SYSTEM SCORE</span><br><br>사람을 점수화하지 않습니다. 이 점수는 리더십 운영 시스템의 상태만 설명합니다.';\n    };\n    const renderLiveMetrics = (counts) => {\n        if (metricsTitle)\n            metricsTitle.textContent = 'Live Context';\n        const labels = ['Confirmed Truth', 'Evidence', 'Needs review'];\n        const values = [String(counts.truth), String(counts.evidence), String(counts.candidates + counts.recommendations)];\n        metricLabels.forEach((node, index) => node.textContent = labels[index] ?? '');\n        metricValues.forEach((node, index) => node.textContent = values[index] ?? '');\n        if (metricsNote)\n            metricsNote.innerHTML = `<span class=\"pill\">RUNTIME CONTEXT</span><br><br>총 ${counts.total}개 Context · 사람 점수 없음 · 읽기 전용 Today 연결`;\n    };\n    const identityDisplayName = () => {\n        const identity = controllers.auth.identity;\n        const pref = preferences();\n        const raw = (pref?.displayName ?? identity?.label ?? identity?.email ?? '리더').trim();\n        return raw.includes('@') ? (raw.split('@')[0] || '리더') : raw;\n    };\n    const greetingForNow = () => {\n        const timezone = preferences()?.timezone ?? browserTimezone();\n        let hour = new Date().getHours();\n        try {\n            const value = new Intl.DateTimeFormat('en-US', { hour: '2-digit', hour12: false, timeZone: timezone }).format(new Date());\n            hour = Number(value.split(':')[0]);\n        }\n        catch { }\n        if (hour < 12)\n            return '좋은 아침이에요';\n        if (hour < 18)\n            return '좋은 오후예요';\n        return '좋은 저녁이에요';\n    };\n    const renderTodayWelcome = (pack, noWorkspace = false) => {\n        if (!todayWelcome || !todayGreeting || !todayWelcomeTitle || !todayWelcomeCopy)\n            return;\n        todayWelcome.hidden = false;\n        const name = identityDisplayName();\n        todayGreeting.textContent = `${greetingForNow()}, ${name}님.`;\n        if (noWorkspace) {\n            todayWelcomeTitle.textContent = '오늘은 내 팀의 첫 업무 공간을 만드는 것부터 시작하면 됩니다.';\n            todayWelcomeCopy.textContent = '아직 데이터가 없어도 괜찮습니다. 팀 이름, 팀원, 내가 맡은 첫 과제만 등록하면 Leader OS가 첫 30일을 정리합니다.';\n            return;\n        }\n        if (isRealFirstUse(pack)) {\n            todayWelcomeTitle.textContent = '첫 30일을 위한 기본 정보를 조금만 알려주세요.';\n            todayWelcomeCopy.textContent = '팀원과 내 과제를 등록하면 Today가 오늘 확인할 일 3가지를 실제 Context에서 만들어 보여줍니다.';\n            return;\n        }\n        const live = pack ? buildLiveTodayProjection(pack) : null;\n        const count = live?.today.attention.length ?? 0;\n        todayWelcomeTitle.textContent = count > 0 ? `오늘은 ${count}가지만 먼저 보면 됩니다.` : '오늘의 업무 Context를 확인했습니다.';\n        todayWelcomeCopy.textContent = count > 0 ? '결정·대화·후속 확인 중 지금 주의가 필요한 것부터 가볍게 확인해보세요.' : '급하게 확인할 Attention은 없습니다. 필요한 프로젝트나 사람 Context를 열어보세요.';\n    };\n    const roleModeLabel = (roleMode) => {\n        if (roleMode === 'EXECUTIVE')\n            return 'Executive';\n        if (roleMode === 'TEAM_LEADER')\n            return 'Team Leader';\n        if (roleMode === 'PROJECT_LEAD')\n            return 'Project Lead';\n        if (roleMode === 'INDIVIDUAL')\n            return 'Individual';\n        return '기본 보기';\n    };\n    const setPreferenceStatus = (message, error = false) => {\n        if (!preferenceStatus)\n            return;\n        preferenceStatus.textContent = message;\n        preferenceStatus.classList.toggle('error', error);\n    };\n    const renderWorkspaceOptions = (select, list, selectedId) => {\n        if (!select)\n            return;\n        select.replaceChildren();\n        for (const workspace of list) {\n            const option = document.createElement('option');\n            option.value = workspace.workspaceId;\n            option.textContent = `${workspace.name} · ${workspace.role}`;\n            option.selected = workspace.workspaceId === selectedId;\n            select.append(option);\n        }\n    };\n    const renderPreferenceWorkspaceOptions = (selectedId) => {\n        if (!preferenceDefaultWorkspace)\n            return;\n        preferenceDefaultWorkspace.replaceChildren();\n        const none = document.createElement('option');\n        none.value = '';\n        none.textContent = '기본 Workspace 지정 안 함';\n        preferenceDefaultWorkspace.append(none);\n        for (const workspace of workspaces()) {\n            const option = document.createElement('option');\n            option.value = workspace.workspaceId;\n            option.textContent = `${workspace.name} · ${workspace.role}`;\n            option.selected = workspace.workspaceId === selectedId;\n            preferenceDefaultWorkspace.append(option);\n        }\n        preferenceDefaultWorkspace.value = selectedId && workspaces().some((workspace) => workspace.workspaceId === selectedId) ? selectedId : '';\n    };\n    const renderPreferences = (value) => {\n        if (preferenceVersion)\n            preferenceVersion.textContent = value.version > 0 ? `v${value.version} · 서버 저장됨` : '서버 저장 전';\n        if (preferenceDisplayName)\n            preferenceDisplayName.value = value.displayName ?? '';\n        if (preferenceRoleMode)\n            preferenceRoleMode.value = value.roleMode ?? '';\n        renderPreferenceWorkspaceOptions(value.defaultWorkspaceId);\n        if (preferenceTimezone)\n            preferenceTimezone.value = value.timezone ?? browserTimezone();\n        if (preferenceTodayView)\n            preferenceTodayView.value = value.defaultTodayView;\n        if (preferenceWorkStart)\n            preferenceWorkStart.value = value.workingHours.start;\n        if (preferenceWorkEnd)\n            preferenceWorkEnd.value = value.workingHours.end;\n        const days = new Set(value.workingHours.weekdays);\n        preferenceWeekdays.forEach((input) => { input.checked = days.has(Number(input.value)); });\n        if (preferenceNotifyBrowser)\n            preferenceNotifyBrowser.checked = value.notificationPreferences.browser;\n        if (preferenceNotifyEmail)\n            preferenceNotifyEmail.checked = value.notificationPreferences.email;\n        if (preferenceNotifyDigest)\n            preferenceNotifyDigest.checked = value.notificationPreferences.dailyDigest;\n        setPreferenceStatus(value.version > 0 ? '서버에 저장된 개인 설정입니다. 권한에는 영향을 주지 않습니다.' : '아직 서버에 저장하지 않았습니다. 저장 전에는 기본값만 사용합니다.');\n    };\n    const formatLiveTime = (value) => {\n        const timezone = preferences()?.timezone ?? undefined;\n        try {\n            return new Date(value).toLocaleString('ko-KR', timezone ? { timeZone: timezone } : undefined);\n        }\n        catch {\n            return new Date(value).toLocaleString('ko-KR');\n        }\n    };\n    const applyDefaultTodayView = () => {\n        const pref = preferences();\n        if (defaultViewApplied || !pref)\n            return;\n        defaultViewApplied = true;\n        const current = window.location.hash;\n        if (current && current !== '#today')\n            return;\n        const route = preferenceTodayRoute(pref.defaultTodayView);\n        if (route !== 'TODAY')\n            options.goTo(route);\n    };\n    const renderPersonalHome = (pack, identityLabel) => {\n        const pref = preferences();\n        const personal = buildPersonalHome(pack, pref ?? {});\n        if (personalHome)\n            personalHome.hidden = false;\n        const visibleName = pref?.displayName ?? (identityLabel || `User ${personal.userId.slice(0, 8)}`);\n        if (personalName)\n            personalName.textContent = visibleName;\n        if (personalMeta)\n            personalMeta.textContent = `${roleModeLabel(pref?.roleMode ?? null)} · 권한 ${personal.viewerRole} · ${personal.workspaceId}`;\n        if (personalSummary)\n            personalSummary.textContent = `내 프로젝트 ${personal.myProjects.length} · 접근 가능한 프로젝트 ${personal.accessibleProjects.length} · ${pref?.timezone ?? '브라우저 시간대'} · 개인화 EXPLICIT ONLY`;\n        if (pref)\n            renderPreferences(pref);\n        if (myProjects) {\n            myProjects.replaceChildren();\n            if (personal.myProjects.length === 0) {\n                const empty = document.createElement('span');\n                empty.className = 'why';\n                empty.textContent = 'ownerUserId/memberUserIds로 명시된 내 프로젝트가 아직 없습니다.';\n                myProjects.append(empty);\n            }\n            else {\n                for (const project of personal.myProjects) {\n                    const button = document.createElement('button');\n                    button.type = 'button';\n                    button.textContent = objectTitle(project);\n                    button.addEventListener('click', () => options.openObject('PROJECT', project.objectId));\n                    myProjects.append(button);\n                }\n            }\n        }\n    };\n    const selectedWorkspaceById = (workspaceId) => controllers.workspaces.byId(workspaceId);\n    const showWorkspaceChoice = (message, selectedId) => {\n        if (workspacePicker)\n            workspacePicker.hidden = false;\n        if (workspaceChoiceCopy)\n            workspaceChoiceCopy.textContent = message;\n        renderWorkspaceOptions(workspaceSelect, workspaces(), selectedId);\n        if (workspaceOpen)\n            workspaceOpen.disabled = workspaces().length === 0;\n    };\n    const hideWorkspaceChoice = () => { if (workspacePicker)\n        workspacePicker.hidden = true; };\n    const renderWorkspaceSwitcher = (active) => {\n        if (workspaceSwitcherWrap)\n            workspaceSwitcherWrap.hidden = false;\n        renderWorkspaceOptions(workspaceSwitcher, workspaces(), active.workspaceId);\n        if (workspaceSwitcher) {\n            workspaceSwitcher.value = active.workspaceId;\n            workspaceSwitcher.disabled = workspaces().length <= 1;\n        }\n        if (workspaceRole)\n            workspaceRole.textContent = `${active.role} · ACTIVE`;\n    };\n    const renderContext = (pack, statusPrefix = 'Live Context') => {\n        const live = buildLiveTodayProjection(pack);\n        const active = controllers.workspaces.active;\n        const identity = controllers.auth.identity;\n        options.renderToday(live.today);\n        renderLiveMetrics(live.counts);\n        setMode('LIVE');\n        if (workspaceBadge && active)\n            workspaceBadge.textContent = `${active.name} · ${live.viewerRole}`;\n        renderPersonalHome(pack, identity?.label ?? '');\n        renderTodayWelcome(pack);\n        if (isRealFirstUse(pack))\n            firstUseUi.renderEmptyWorkspace(pack);\n        else\n            firstUseUi.hide();\n        if (active)\n            renderWorkspaceSwitcher(active);\n        hideWorkspaceChoice();\n        if (liveForm)\n            liveForm.hidden = true;\n        if (liveOpen)\n            liveOpen.hidden = true;\n        if (liveDisconnect)\n            liveDisconnect.hidden = false;\n        setLiveMessage(`${statusPrefix}${active ? ` · ${active.name}` : ''} · ${live.counts.total} records · ${formatLiveTime(live.generatedAt)}`);\n        return live;\n    };\n    const activateWorkspace = async (workspace) => {\n        setMode('CONNECTING');\n        setLiveMessage(`${workspace.name} Context를 읽는 중입니다…`);\n        const hydrated = await controllers.workspaces.select(workspace.workspaceId);\n        renderContext(hydrated.contextPack, 'Live Context');\n        options.announce(`${workspace.name} Workspace를 열었습니다.`);\n        applyDefaultTodayView();\n        if (parseObjectRoute(window.location.hash))\n            options.activateFromHash();\n    };\n    const renderSignedInWithoutWorkspace = (message) => {\n        options.renderToday(buildTodayView([]));\n        renderLiveMetrics({ truth: 0, evidence: 0, candidates: 0, recommendations: 0, total: 0 });\n        setMode('SIGNED IN');\n        if (workspaceBadge)\n            workspaceBadge.textContent = 'Workspace 선택 필요';\n        if (personalHome)\n            personalHome.hidden = true;\n        if (workspaceSwitcherWrap)\n            workspaceSwitcherWrap.hidden = true;\n        renderTodayWelcome(null, true);\n        if (workspaces().length === 0)\n            firstUseUi.renderNoWorkspace();\n        else\n            firstUseUi.hide();\n        setLiveMessage(message);\n    };\n    const renderDemoState = (announceChange = true) => {\n        defaultViewApplied = false;\n        if (personalHome)\n            personalHome.hidden = true;\n        if (myProjects)\n            myProjects.replaceChildren();\n        if (workspaceSwitcherWrap)\n            workspaceSwitcherWrap.hidden = true;\n        if (todayWelcome)\n            todayWelcome.hidden = true;\n        if (firstUseUi)\n            firstUseUi.hide();\n        hideWorkspaceChoice();\n        if (userBadge) {\n            userBadge.hidden = true;\n            userBadge.textContent = 'Guest';\n        }\n        options.renderToday(options.demoTodayView);\n        renderDemoMetrics();\n        setMode('DEMO');\n        setLiveMessage('');\n        if (workspaceBadge)\n            workspaceBadge.textContent = 'Team Alpha · Core';\n        if (liveDisconnect)\n            liveDisconnect.hidden = true;\n        if (liveOpen)\n            liveOpen.hidden = false;\n        if (liveForm)\n            liveForm.hidden = true;\n        if (livePassword)\n            livePassword.value = '';\n        if (announceChange)\n            options.announce('Demo 데이터로 돌아왔습니다.');\n    };\n    const renderAuthenticatedSession = (selection, restored = false) => {\n        const identity = controllers.auth.identity;\n        defaultViewApplied = false;\n        if (userBadge) {\n            userBadge.hidden = false;\n            userBadge.textContent = identity?.label ?? identity?.email ?? 'Signed in';\n        }\n        if (livePassword)\n            livePassword.value = '';\n        const active = controllers.workspaces.active;\n        const pack = controllers.context.current;\n        if (active && pack) {\n            renderContext(pack, restored ? '세션 복원' : 'Live Context');\n            applyDefaultTodayView();\n            if (parseObjectRoute(window.location.hash))\n                options.activateFromHash();\n            return;\n        }\n        if (selection.source === 'NO_WORKSPACE') {\n            renderSignedInWithoutWorkspace(restored ? '로그인 세션을 복원했습니다. 아직 Workspace가 없습니다. 첫 업무 공간을 만들어 시작하세요.' : '로그인이 완료됐습니다. 샘플 데이터 없이 실제 첫 Workspace부터 시작합니다.');\n            hideWorkspaceChoice();\n        }\n        else {\n            renderSignedInWithoutWorkspace(restored ? '로그인 세션을 복원했습니다. 이번에 사용할 Workspace를 선택하세요.' : '가입된 Workspace가 여러 개입니다. 이번에 사용할 Workspace를 선택하세요.');\n            showWorkspaceChoice('Workspace를 선택하면 My Projects와 Today가 해당 Context로 다시 계산됩니다.');\n        }\n        if (liveForm)\n            liveForm.hidden = true;\n        if (liveOpen)\n            liveOpen.hidden = true;\n        if (liveDisconnect)\n            liveDisconnect.hidden = false;\n    };\n    firstUseUi = createFirstUseUi({\n        controllers,\n        announce: options.announce,\n        onContextChanged: (pack) => {\n            renderContext(pack, 'First 30 Days');\n            applyDefaultTodayView();\n        }\n    });\n    liveOpen?.addEventListener('click', () => { if (liveForm)\n        liveForm.hidden = false; setLiveMessage('로그인 후 내가 가입된 ACTIVE Workspace를 자동으로 찾습니다. Workspace ID를 입력할 필요가 없습니다.'); liveEmail?.focus(); });\n    liveCancel?.addEventListener('click', () => { if (liveForm)\n        liveForm.hidden = true; setLiveMessage(''); if (livePassword)\n        livePassword.value = ''; });\n    liveDisconnect?.addEventListener('click', async () => {\n        if (liveDisconnect)\n            liveDisconnect.disabled = true;\n        setLiveMessage('로그아웃하는 중입니다…');\n        try {\n            await controllers.auth.signOut();\n        }\n        catch (error) {\n            setLiveMessage(`서버 로그아웃 확인 실패 · ${error instanceof Error ? error.message : String(error)}`, true);\n        }\n        finally {\n            renderDemoState(true);\n            if (liveDisconnect)\n                liveDisconnect.disabled = false;\n        }\n    });\n    liveForm?.addEventListener('submit', async (event) => {\n        event.preventDefault();\n        const email = liveEmail?.value.trim() ?? '';\n        const password = livePassword?.value ?? '';\n        if (!email || !password) {\n            setLiveMessage('이메일과 비밀번호를 입력하세요.', true);\n            return;\n        }\n        setMode('CONNECTING');\n        setLiveMessage('로그인하고 내 Workspace를 찾는 중입니다…');\n        if (liveConnect)\n            liveConnect.disabled = true;\n        try {\n            renderAuthenticatedSession(await controllers.auth.signIn(email, password), false);\n        }\n        catch (error) {\n            const code = error instanceof Error ? error.message : String(error);\n            defaultViewApplied = false;\n            setMode('DEMO');\n            const friendly = code.includes('invalid_credentials') || code.includes('Invalid login') ? '로그인 정보가 맞지 않습니다.' : code.includes('WORKSPACE_DISCOVERY') ? 'Workspace 목록을 불러오지 못했습니다. 잠시 후 다시 시도하세요.' : `Live 연결 실패 · ${code}`;\n            setLiveMessage(friendly, true);\n            options.announce('Leader OS 로그인 또는 Workspace 조회에 실패했습니다.');\n        }\n        finally {\n            if (liveConnect)\n                liveConnect.disabled = false;\n            if (livePassword)\n                livePassword.value = '';\n        }\n    });\n    const restorePersistedSession = async () => {\n        setMode('CONNECTING');\n        setLiveMessage('저장된 로그인 세션을 확인하는 중입니다…');\n        try {\n            const selection = await controllers.auth.restore();\n            if (!selection) {\n                renderDemoState(false);\n                return;\n            }\n            renderAuthenticatedSession(selection, true);\n        }\n        catch (error) {\n            renderDemoState(false);\n            const code = error instanceof Error ? error.message : String(error);\n            setLiveMessage(`로그인 세션은 보존됐지만 Workspace/Context 복원에 실패했습니다 · ${code}`, true);\n            options.announce('저장된 Leader OS 세션의 업무 Context 복원에 실패했습니다.');\n        }\n    };\n    workspaceOpen?.addEventListener('click', async () => {\n        const workspace = selectedWorkspaceById(workspaceSelect?.value ?? '');\n        if (!workspace) {\n            setLiveMessage('열 Workspace를 선택하세요.', true);\n            return;\n        }\n        if (workspaceOpen)\n            workspaceOpen.disabled = true;\n        try {\n            await activateWorkspace(workspace);\n        }\n        catch (error) {\n            renderSignedInWithoutWorkspace(`Workspace 연결 실패 · ${error instanceof Error ? error.message : String(error)}`);\n            showWorkspaceChoice('다른 Workspace를 선택하거나 다시 시도하세요.', workspace.workspaceId);\n        }\n        finally {\n            if (workspaceOpen)\n                workspaceOpen.disabled = false;\n        }\n    });\n    workspaceSwitcher?.addEventListener('change', async () => {\n        const workspace = selectedWorkspaceById(workspaceSwitcher.value);\n        const current = controllers.context.current;\n        if (!workspace || workspace.workspaceId === current?.workspaceId)\n            return;\n        workspaceSwitcher.disabled = true;\n        try {\n            await activateWorkspace(workspace);\n        }\n        catch (error) {\n            setLiveMessage(`Workspace 전환 실패 · ${error instanceof Error ? error.message : String(error)}`, true);\n            const retained = controllers.workspaces.active;\n            if (retained)\n                renderWorkspaceSwitcher(retained);\n        }\n        finally {\n            workspaceSwitcher.disabled = workspaces().length <= 1;\n        }\n    });\n    preferenceForm?.addEventListener('submit', async (event) => {\n        event.preventDefault();\n        const current = preferences();\n        if (!controllers.auth.isSignedIn || !current) {\n            setPreferenceStatus('로그인 후 저장할 수 있습니다.', true);\n            return;\n        }\n        const weekdays = preferenceWeekdays.filter((input) => input.checked).map((input) => Number(input.value));\n        if (weekdays.length === 0) {\n            setPreferenceStatus('근무 요일을 하나 이상 선택하세요.', true);\n            return;\n        }\n        const start = preferenceWorkStart?.value || '09:00';\n        const end = preferenceWorkEnd?.value || '18:00';\n        if (start >= end) {\n            setPreferenceStatus('근무 종료 시간은 시작 시간보다 늦어야 합니다.', true);\n            return;\n        }\n        const roleValue = preferenceRoleMode?.value ?? '';\n        const patch = {\n            displayName: preferenceDisplayName?.value.trim() || null,\n            roleMode: roleValue ? roleValue : null,\n            defaultWorkspaceId: preferenceDefaultWorkspace?.value || null,\n            timezone: preferenceTimezone?.value.trim() || null,\n            workingHours: { start, end, weekdays },\n            notificationPreferences: { browser: preferenceNotifyBrowser?.checked === true, email: preferenceNotifyEmail?.checked === true, dailyDigest: preferenceNotifyDigest?.checked === true },\n            defaultTodayView: (preferenceTodayView?.value || 'ATTENTION')\n        };\n        if (preferenceSave)\n            preferenceSave.disabled = true;\n        setPreferenceStatus('개인 설정을 서버에 저장하는 중입니다…');\n        try {\n            const saved = await controllers.preferences.save(patch);\n            const identity = controllers.auth.identity;\n            const pack = controllers.context.current;\n            if (userBadge)\n                userBadge.textContent = identity?.label ?? 'User';\n            if (pack)\n                renderPersonalHome(pack, identity?.label ?? '');\n            setPreferenceStatus(`v${saved.preferences.version}로 저장했습니다. 권한은 변경되지 않았습니다.`);\n            options.announce('개인 설정을 저장했습니다.');\n        }\n        catch (error) {\n            const code = error instanceof Error ? error.message : String(error);\n            if (code === 'VERSION_CONFLICT') {\n                try {\n                    const latest = await controllers.preferences.reload();\n                    renderPreferences(latest.preferences);\n                    setPreferenceStatus('다른 기기에서 설정이 먼저 변경됐습니다. 최신 설정을 불러왔습니다. 다시 확인 후 저장하세요.', true);\n                }\n                catch {\n                    setPreferenceStatus('설정 충돌이 발생했습니다. 다시 로그인해 주세요.', true);\n                }\n            }\n            else if (code === 'DEFAULT_WORKSPACE_MEMBERSHIP_REQUIRED')\n                setPreferenceStatus('현재 ACTIVE membership이 없는 Workspace는 기본값으로 저장할 수 없습니다.', true);\n            else if (code === 'INVALID_TIMEZONE')\n                setPreferenceStatus('유효한 시간대를 입력하세요. 예: Asia/Seoul', true);\n            else\n                setPreferenceStatus(`설정 저장 실패 · ${code}`, true);\n        }\n        finally {\n            if (preferenceSave)\n                preferenceSave.disabled = false;\n        }\n    });\n    renderDemoState(false);\n    return { restorePersistedSession, renderContext, renderDemoState, renderAuthenticatedSession };\n}\n","ui/navigation-ui.js":"import { PRIMARY_ROUTES, validateNavigationContract } from '../navigation.js';\nimport { parseObjectRoute } from '../object-detail.js';\nexport function createNavigationUi(bridge) {\n    const validation = validateNavigationContract();\n    if (!validation.ok)\n        throw new Error(`Leader OS navigation contract failed: ${validation.violations.join(', ')}`);\n    const nav = document.querySelector('[data-primary-nav]');\n    if (!nav)\n        throw new Error('PRIMARY_NAV_MISSING');\n    nav.replaceChildren();\n    const topbarTitle = document.querySelector('[data-topbar-title]');\n    const pages = Array.from(document.querySelectorAll('[data-page]'));\n    const liveStatus = document.querySelector('[data-live-status]');\n    const announce = (message) => { if (liveStatus)\n        liveStatus.textContent = message; };\n    const showPage = (id, label) => {\n        let matched = false;\n        for (const page of pages) {\n            const visible = page.dataset.page === id;\n            page.hidden = !visible;\n            matched ||= visible;\n        }\n        if (!matched) {\n            const today = pages.find((page) => page.dataset.page === 'TODAY');\n            if (today)\n                today.hidden = false;\n        }\n        if (topbarTitle)\n            topbarTitle.textContent = matched ? label : `${label} · queued`;\n    };\n    const setActive = (id, label, syncHash = true) => {\n        for (const anchor of nav.querySelectorAll('a[data-route-id]')) {\n            const active = anchor.dataset.routeId === id;\n            anchor.classList.toggle('active', active);\n            if (active)\n                anchor.setAttribute('aria-current', 'page');\n            else\n                anchor.removeAttribute('aria-current');\n        }\n        showPage(id, label);\n        if (syncHash) {\n            const route = PRIMARY_ROUTES.find((candidate) => candidate.id === id);\n            if (route)\n                history.pushState(null, '', `#${route.path.slice(1)}`);\n        }\n    };\n    const routeLabel = (id) => PRIMARY_ROUTES.find((route) => route.id === id)?.label ?? id;\n    const goTo = (id) => setActive(id, routeLabel(id));\n    const groupLabels = { FOCUS: 'Focus', PEOPLE: 'People', EXECUTION: 'Execution', SYSTEM: 'System' };\n    const groupContainers = new Map();\n    for (const route of PRIMARY_ROUTES) {\n        let section = groupContainers.get(route.group);\n        if (!section) {\n            section = document.createElement('div');\n            section.className = 'nav-section';\n            section.dataset.navGroup = route.group;\n            const label = document.createElement('div');\n            label.className = 'nav-label';\n            label.textContent = groupLabels[route.group];\n            section.append(label);\n            groupContainers.set(route.group, section);\n            nav.append(section);\n        }\n        const anchor = document.createElement('a');\n        anchor.href = `#${route.path.slice(1)}`;\n        anchor.dataset.routeId = route.id;\n        anchor.textContent = route.label;\n        anchor.title = route.purpose;\n        if (route.id === 'TODAY') {\n            anchor.classList.add('active');\n            anchor.setAttribute('aria-current', 'page');\n        }\n        if (route.id === 'REVIEW')\n            anchor.classList.add('review');\n        if (route.id === 'ADD_ONS')\n            anchor.classList.add('addons');\n        anchor.addEventListener('click', (event) => { event.preventDefault(); setActive(route.id, route.label); });\n        section.append(anchor);\n    }\n    const activateFromHash = () => {\n        const hash = window.location.hash.slice(1);\n        if (!hash)\n            return;\n        const nested = parseObjectRoute(hash);\n        if (nested) {\n            const item = bridge.resolveObject(nested.objectType, nested.objectId);\n            setActive(nested.parentRouteId, routeLabel(nested.parentRouteId), false);\n            if (item)\n                bridge.renderObject(item, nested);\n            else\n                bridge.openObject(nested.objectType, nested.objectId);\n            return;\n        }\n        if (bridge.isObjectOpen())\n            bridge.closeObject(false);\n        const route = PRIMARY_ROUTES.find((candidate) => candidate.path === `/${hash}`);\n        if (route)\n            setActive(route.id, route.label, false);\n    };\n    window.addEventListener('hashchange', activateFromHash);\n    document.querySelector('[data-go-review]')?.addEventListener('click', () => goTo('REVIEW'));\n    return { setActive, goTo, routeLabel, activateFromHash, announce };\n}\n","ui/object-detail-ui.js":"import { confirmDecision, decisionDraftFromContext } from '../decisions.js';\nimport { buildShareDraft, buildSharePolicy, findContextItem, objectDetailRows, objectRoute, objectSummary, objectTitle, parseObjectRoute } from '../object-detail.js';\nimport { RuntimeHttpError } from '../runtime.js';\nimport { copyTextToClipboard, requiredElement } from './helpers.js';\nexport function createObjectDetailUi(options) {\n    const { session, controllers, navigation } = options;\n    const demoContextItems = new Map();\n    const demoKey = (objectType, objectId) => `${objectType}:${objectId}`;\n    const nowIso = () => new Date().toISOString();\n    const makeDemoItem = (objectType, objectId, accessScope, data, confirmed = true) => ({\n        objectType, objectId, version: 1, confirmed, accessScope, updatedAt: nowIso(), data,\n        latestEvent: { eventId: null, eventType: null, source: 'DEMO', occurredAt: null }\n    });\n    const registerDemoItem = (item) => demoContextItems.set(demoKey(item.objectType, item.objectId), item);\n    const detailBackdrop = requiredElement('[data-object-detail-backdrop]', 'OBJECT_DETAIL_BACKDROP');\n    const detailPanel = requiredElement('[data-object-detail-panel]', 'OBJECT_DETAIL_PANEL');\n    const detailClose = requiredElement('[data-object-detail-close]', 'OBJECT_DETAIL_CLOSE');\n    const detailType = requiredElement('[data-object-detail-type]', 'OBJECT_DETAIL_TYPE');\n    const detailTitle = requiredElement('[data-object-detail-title]', 'OBJECT_DETAIL_TITLE');\n    const detailSummary = requiredElement('[data-object-detail-summary]', 'OBJECT_DETAIL_SUMMARY');\n    const detailRows = requiredElement('[data-object-detail-rows]', 'OBJECT_DETAIL_ROWS');\n    const detailScope = requiredElement('[data-object-detail-scope]', 'OBJECT_DETAIL_SCOPE');\n    const detailPolicy = requiredElement('[data-object-detail-policy]', 'OBJECT_DETAIL_POLICY');\n    const recipientCheckWrap = requiredElement('[data-object-recipient-wrap]', 'OBJECT_RECIPIENT_WRAP');\n    const recipientCheck = requiredElement('[data-object-recipient-check]', 'OBJECT_RECIPIENT_CHECK');\n    const copyObjectLink = requiredElement('[data-object-copy-link]', 'OBJECT_COPY_LINK');\n    const copyShareDraft = requiredElement('[data-object-copy-share]', 'OBJECT_COPY_SHARE');\n    const shareStatus = requiredElement('[data-object-share-status]', 'OBJECT_SHARE_STATUS');\n    const decisionPersistWrap = requiredElement('[data-object-decision-persist]', 'OBJECT_DECISION_PERSIST');\n    const decisionPersistButton = requiredElement('[data-object-decision-confirm]', 'OBJECT_DECISION_CONFIRM');\n    const decisionPersistStatus = requiredElement('[data-object-decision-status]', 'OBJECT_DECISION_STATUS');\n    let activeDetail = null;\n    let activeDetailRoute = null;\n    const resolveObject = (objectType, objectId) => {\n        const pack = session.currentContextPack;\n        if (pack) {\n            const live = findContextItem(pack, objectType, objectId);\n            if (live)\n                return live;\n        }\n        return demoContextItems.get(demoKey(objectType, objectId)) ?? null;\n    };\n    const setShareStatus = (message, error = false) => {\n        shareStatus.textContent = message;\n        shareStatus.classList.toggle('error', error);\n    };\n    const configureDecisionPersistence = (item) => {\n        const pack = session.currentContextPack;\n        const isLiveDecision = Boolean(session.isSignedIn && pack && item.objectType === 'DECISION' && findContextItem(pack, 'DECISION', item.objectId));\n        decisionPersistWrap.hidden = !isLiveDecision;\n        decisionPersistStatus.classList.remove('error');\n        if (!isLiveDecision)\n            return;\n        if (item.confirmed) {\n            decisionPersistButton.disabled = true;\n            decisionPersistButton.textContent = '확정됨';\n            decisionPersistStatus.textContent = '서버 Context에서 Human-confirmed Decision으로 확인됐습니다.';\n            return;\n        }\n        const prepared = decisionDraftFromContext(item);\n        if (!prepared.ok) {\n            decisionPersistButton.disabled = true;\n            decisionPersistButton.textContent = '확정 정보 확인 필요';\n            decisionPersistStatus.classList.add('error');\n            decisionPersistStatus.textContent = `확정 전에 필요한 정보가 부족합니다 · ${(prepared.violations ?? [prepared.error]).join(' · ')}`;\n            return;\n        }\n        decisionPersistButton.disabled = false;\n        decisionPersistButton.textContent = '내 결정으로 확정';\n        decisionPersistStatus.textContent = `Version ${item.version} 기준 · 성공 시 EventLog 기록 후 Context를 다시 읽습니다.`;\n    };\n    const renderObject = (item, route) => {\n        activeDetail = item;\n        activeDetailRoute = route;\n        const policy = buildSharePolicy(item.accessScope);\n        detailType.textContent = item.objectType;\n        detailTitle.textContent = objectTitle(item);\n        detailSummary.textContent = objectSummary(item);\n        detailScope.textContent = `${policy.label} · ${item.confirmed ? 'Confirmed' : 'Needs review'}`;\n        detailPolicy.textContent = policy.reason;\n        detailRows.replaceChildren();\n        for (const [label, value] of objectDetailRows(item)) {\n            const row = document.createElement('div');\n            row.className = 'context-row';\n            const l = document.createElement('span');\n            l.textContent = label;\n            const v = document.createElement('span');\n            v.textContent = value;\n            row.append(l, v);\n            detailRows.append(row);\n        }\n        configureDecisionPersistence(item);\n        recipientCheck.checked = false;\n        recipientCheckWrap.hidden = !policy.requiresRecipientCheck;\n        copyObjectLink.disabled = !policy.canCopyLink;\n        copyShareDraft.disabled = !policy.canPrepareShare || policy.requiresRecipientCheck;\n        setShareStatus(policy.canPrepareShare ? '공유 초안을 만들 수 있습니다. 외부 전송은 사람이 최종 실행합니다.' : policy.reason, !policy.canPrepareShare);\n        detailBackdrop.hidden = false;\n        detailPanel.hidden = false;\n        document.body.classList.add('detail-open');\n        detailClose.focus();\n    };\n    const closeObject = (syncHash = true) => {\n        detailBackdrop.hidden = true;\n        detailPanel.hidden = true;\n        document.body.classList.remove('detail-open');\n        const parent = activeDetailRoute?.parentRouteId;\n        activeDetail = null;\n        activeDetailRoute = null;\n        setShareStatus('');\n        if (syncHash && parent)\n            navigation.setActive(parent, navigation.routeLabel(parent));\n    };\n    const openObject = (objectType, objectId) => {\n        const path = objectRoute(objectType, objectId);\n        if (!path)\n            return false;\n        const route = parseObjectRoute(path);\n        if (!route)\n            return false;\n        const item = resolveObject(route.objectType, route.objectId);\n        navigation.setActive(route.parentRouteId, navigation.routeLabel(route.parentRouteId), false);\n        history.pushState(null, '', `#${path.slice(1)}`);\n        if (!item) {\n            activeDetailRoute = route;\n            activeDetail = null;\n            detailType.textContent = route.objectType;\n            detailTitle.textContent = route.objectId;\n            detailSummary.textContent = '현재 Context Pack에서 이 객체를 찾을 수 없습니다.';\n            detailRows.replaceChildren();\n            detailScope.textContent = 'Unavailable';\n            detailPolicy.textContent = '권한이 없거나, 오래된 링크이거나, 현재 Context 범위에 포함되지 않은 객체일 수 있습니다.';\n            decisionPersistWrap.hidden = true;\n            recipientCheckWrap.hidden = true;\n            copyObjectLink.disabled = true;\n            copyShareDraft.disabled = true;\n            setShareStatus('공유할 수 없습니다. Context를 새로고침하거나 접근 권한을 확인하세요.', true);\n            detailBackdrop.hidden = false;\n            detailPanel.hidden = false;\n            document.body.classList.add('detail-open');\n            detailClose.focus();\n            return true;\n        }\n        renderObject(item, route);\n        return true;\n    };\n    detailClose.addEventListener('click', () => closeObject());\n    detailBackdrop.addEventListener('click', () => closeObject());\n    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !detailPanel.hidden)\n        closeObject(); });\n    recipientCheck.addEventListener('change', () => {\n        if (!activeDetail)\n            return;\n        const policy = buildSharePolicy(activeDetail.accessScope);\n        copyShareDraft.disabled = !policy.canPrepareShare || (policy.requiresRecipientCheck && !recipientCheck.checked);\n        setShareStatus(recipientCheck.checked ? '수신자가 이 RESTRICTED Context에 접근할 권한이 있음을 사람이 확인했습니다.' : policy.reason, !recipientCheck.checked);\n    });\n    copyObjectLink.addEventListener('click', async () => {\n        if (!activeDetail || !activeDetailRoute)\n            return;\n        const policy = buildSharePolicy(activeDetail.accessScope);\n        if (!policy.canCopyLink) {\n            setShareStatus(policy.reason, true);\n            return;\n        }\n        const url = `${location.origin}${location.pathname}#${activeDetailRoute.path.slice(1)}`;\n        await copyTextToClipboard(url);\n        navigation.announce('객체 링크를 복사했습니다.');\n        setShareStatus('링크를 복사했습니다. 실제 열람 가능 여부는 로그인과 접근 권한으로 다시 확인됩니다.');\n    });\n    copyShareDraft.addEventListener('click', async () => {\n        if (!activeDetail || !activeDetailRoute)\n            return;\n        const url = `${location.origin}${location.pathname}#${activeDetailRoute.path.slice(1)}`;\n        const draft = buildShareDraft(activeDetail, url, recipientCheck.checked);\n        if (!draft.ok) {\n            setShareStatus(draft.policy.reason, true);\n            return;\n        }\n        await copyTextToClipboard(draft.text);\n        navigation.announce('공유 초안을 복사했습니다.');\n        setShareStatus('공유 초안을 복사했습니다. 내용을 확인한 뒤 사람이 최종 전송하세요.');\n    });\n    decisionPersistButton.addEventListener('click', async () => {\n        const pack = session.currentContextPack;\n        if (!session.isSignedIn || !pack || !activeDetail || activeDetail.objectType !== 'DECISION')\n            return;\n        const current = findContextItem(pack, 'DECISION', activeDetail.objectId);\n        if (!current) {\n            decisionPersistStatus.classList.add('error');\n            decisionPersistStatus.textContent = '현재 Live Context에서 이 Decision을 찾을 수 없습니다.';\n            return;\n        }\n        const prepared = decisionDraftFromContext(current);\n        if (!prepared.ok) {\n            configureDecisionPersistence(current);\n            return;\n        }\n        const human = confirmDecision(prepared.draft, { type: 'HUMAN', id: pack.viewerUserId });\n        if (!human.ok) {\n            decisionPersistStatus.classList.add('error');\n            decisionPersistStatus.textContent = `확정 실패 · ${human.error}`;\n            return;\n        }\n        decisionPersistButton.disabled = true;\n        decisionPersistButton.textContent = '저장 중…';\n        decisionPersistStatus.classList.remove('error');\n        decisionPersistStatus.textContent = 'expectedVersion을 확인하고 Human Decision을 저장하는 중입니다…';\n        try {\n            const hydrated = await controllers.domainActions.confirmDecision({\n                decisionId: current.objectId,\n                expectedVersion: current.version,\n                data: { ...current.data, status: 'CONFIRMED' },\n                humanConfirmed: true\n            });\n            options.onContextChanged(hydrated.contextPack);\n            const refreshed = findContextItem(hydrated.contextPack, 'DECISION', current.objectId);\n            if (refreshed && activeDetailRoute) {\n                renderObject(refreshed, activeDetailRoute);\n                decisionPersistStatus.textContent = '저장 완료 · EventLog 기록 후 최신 Context에서 Confirmed 상태를 다시 확인했습니다. 일정/프로젝트는 자동 변경하지 않았습니다.';\n            }\n            navigation.announce('Decision을 서버에 Human-confirmed 상태로 저장했습니다.');\n        }\n        catch (error) {\n            if (error instanceof RuntimeHttpError && error.code === 'VERSION_CONFLICT') {\n                try {\n                    const hydrated = await controllers.context.refresh();\n                    options.onContextChanged(hydrated.contextPack);\n                    const latest = findContextItem(hydrated.contextPack, 'DECISION', current.objectId);\n                    if (latest && activeDetailRoute)\n                        renderObject(latest, activeDetailRoute);\n                }\n                catch { }\n                decisionPersistStatus.classList.add('error');\n                decisionPersistStatus.textContent = '저장 충돌 · 다른 변경이 먼저 저장되었습니다. 최신 Context를 불러왔습니다. 내용을 다시 확인한 뒤 확정하세요.';\n                navigation.announce('Decision 버전 충돌을 감지했습니다. 자동 덮어쓰기는 하지 않았습니다.');\n                return;\n            }\n            const code = error instanceof Error ? error.message : String(error);\n            decisionPersistButton.disabled = false;\n            decisionPersistButton.textContent = '내 결정으로 확정';\n            decisionPersistStatus.classList.add('error');\n            decisionPersistStatus.textContent = `저장 실패 · ${code} · 자동 재시도하지 않았습니다.`;\n        }\n    });\n    return {\n        registerDemoItem,\n        makeDemoItem,\n        resolveObject,\n        renderObject,\n        openObject,\n        closeObject,\n        isOpen: () => !detailPanel.hidden,\n        get activeItem() { return activeDetail; },\n        get activeRoute() { return activeDetailRoute; }\n    };\n}\n","ui/today-ui.js":"import { objectRoute } from '../object-detail.js';\nimport { copyTextToClipboard } from './helpers.js';\nconst attentionDestination = {\n    DECIDE: 'DECISIONS', TALK: 'ONE_ON_ONE', PREPARE: 'MEETINGS', UNBLOCK: 'WORK',\n    FOLLOW_UP: 'PEOPLE', ALIGN: 'WORK', REVIEW: 'REVIEW'\n};\nconst attentionActionLabel = {\n    DECIDE: '결정 보기', TALK: '1:1 준비', PREPARE: '회의 준비', UNBLOCK: '막힘 풀기',\n    FOLLOW_UP: '후속 확인', ALIGN: '업무 정렬', REVIEW: '지금 검수'\n};\nexport function createTodayUi(initialView, callbacks) {\n    const attentionRoot = document.querySelector('[data-today-attention]');\n    if (!attentionRoot)\n        throw new Error('TODAY_ATTENTION_ROOT_MISSING');\n    let activeView = initialView;\n    const render = (view) => {\n        activeView = view;\n        attentionRoot.replaceChildren();\n        if (view.attention.length === 0) {\n            const empty = document.createElement('div');\n            empty.className = 'empty-state';\n            empty.innerHTML = '<strong>지금 표시할 Top 3가 없습니다.</strong><div class=\"why\" style=\"margin-top:6px\">Context는 연결됐지만 Attention으로 전환할 열린 Decision, Action, Commitment, Recommendation 또는 Project blocker가 없습니다.</div>';\n            attentionRoot.append(empty);\n            return;\n        }\n        for (const item of view.attention) {\n            const article = document.createElement('article');\n            article.className = 'attention-item';\n            const verb = document.createElement('div');\n            verb.className = 'verb';\n            verb.textContent = item.verb;\n            const body = document.createElement('div');\n            const title = document.createElement('strong');\n            title.textContent = item.title;\n            const why = document.createElement('div');\n            why.className = 'why';\n            why.textContent = `Why: ${item.reason}`;\n            const details = document.createElement('details');\n            const summary = document.createElement('summary');\n            summary.textContent = '근거와 신뢰도 보기';\n            const evidence = document.createElement('div');\n            evidence.className = 'evidence-list';\n            evidence.textContent = `Evidence: ${item.evidenceRefs.join(' · ')} · Confidence: ${Math.round(item.confidence * 100)}% (not truth)`;\n            details.append(summary, evidence);\n            body.append(title, why, details);\n            const controls = document.createElement('div');\n            controls.className = 'attention-actions';\n            const status = document.createElement('div');\n            status.className = 'status';\n            status.textContent = item.humanPinned ? 'Human pinned' : item.criticality ?? 'Attention';\n            const action = document.createElement('button');\n            action.type = 'button';\n            action.textContent = attentionActionLabel[item.verb] ?? '열기';\n            action.addEventListener('click', () => {\n                const subjectType = item.subject?.type;\n                const subjectId = item.subject?.id;\n                if (subjectType && subjectId && objectRoute(subjectType, subjectId)) {\n                    callbacks.openObject(subjectType, subjectId);\n                    return;\n                }\n                callbacks.goTo(attentionDestination[item.verb] ?? 'TODAY');\n            });\n            controls.append(status, action);\n            article.append(verb, body, controls);\n            attentionRoot.append(article);\n        }\n    };\n    const copyBrief = async () => {\n        const brief = [\n            'Leader OS · Today Brief',\n            ...activeView.attention.map((item, index) => `${index + 1}. [${item.verb}] ${item.title}\\n   ${item.reason}`),\n            '', `화면: ${window.location.href}`, 'AI recommends. Human decides.'\n        ].join('\\n');\n        await copyTextToClipboard(brief);\n        callbacks.announce('오늘 브리프를 클립보드에 복사했습니다.');\n    };\n    document.querySelector('[data-copy-today]')?.addEventListener('click', copyBrief);\n    render(initialView);\n    return { render, copyBrief, get currentView() { return activeView; } };\n}\n","user-preferences.js":"const DEFAULT_WORKING_HOURS = {\n    start: '09:00',\n    end: '18:00',\n    weekdays: [1, 2, 3, 4, 5]\n};\nconst DEFAULT_NOTIFICATIONS = {\n    browser: false,\n    email: false,\n    dailyDigest: false\n};\nfunction required(value, name) {\n    const trimmed = value?.trim();\n    if (!trimmed)\n        throw new Error(`${name}_REQUIRED`);\n    return trimmed;\n}\nfunction asNullableString(value) {\n    return typeof value === 'string' && value.trim() ? value.trim() : null;\n}\nfunction asRoleMode(value) {\n    const role = String(value ?? '');\n    return ['EXECUTIVE', 'TEAM_LEADER', 'PROJECT_LEAD', 'INDIVIDUAL'].includes(role)\n        ? role\n        : null;\n}\nfunction asDefaultTodayView(value) {\n    const view = String(value ?? 'ATTENTION');\n    return ['ATTENTION', 'MY_PROJECTS', 'REVIEWS'].includes(view)\n        ? view\n        : 'ATTENTION';\n}\nfunction asWorkingHours(value) {\n    if (!value || typeof value !== 'object' || Array.isArray(value))\n        return { ...DEFAULT_WORKING_HOURS, weekdays: [...DEFAULT_WORKING_HOURS.weekdays] };\n    const row = value;\n    const start = typeof row.start === 'string' ? row.start : DEFAULT_WORKING_HOURS.start;\n    const end = typeof row.end === 'string' ? row.end : DEFAULT_WORKING_HOURS.end;\n    const weekdays = Array.isArray(row.weekdays)\n        ? [...new Set(row.weekdays.filter((item) => Number.isInteger(item) && Number(item) >= 1 && Number(item) <= 7).map(Number))].sort((a, b) => a - b)\n        : [...DEFAULT_WORKING_HOURS.weekdays];\n    return { start, end, weekdays: weekdays.length ? weekdays : [...DEFAULT_WORKING_HOURS.weekdays] };\n}\nfunction asNotifications(value) {\n    const row = value && typeof value === 'object' && !Array.isArray(value)\n        ? value\n        : {};\n    return {\n        browser: row.browser === true,\n        email: row.email === true,\n        dailyDigest: row.dailyDigest === true\n    };\n}\nfunction parseEnvelope(payload) {\n    const rawPreferences = payload.preferences && typeof payload.preferences === 'object' && !Array.isArray(payload.preferences)\n        ? payload.preferences\n        : {};\n    const userId = typeof rawPreferences.userId === 'string'\n        ? rawPreferences.userId\n        : typeof payload.viewerUserId === 'string' ? payload.viewerUserId : '';\n    return {\n        schemaVersion: typeof payload.schemaVersion === 'string' ? payload.schemaVersion : '1',\n        viewerUserId: typeof payload.viewerUserId === 'string' ? payload.viewerUserId : userId,\n        persisted: payload.persisted === true,\n        preferences: {\n            userId,\n            version: Number.isInteger(Number(rawPreferences.version)) ? Number(rawPreferences.version) : 0,\n            displayName: asNullableString(rawPreferences.displayName),\n            defaultWorkspaceId: asNullableString(rawPreferences.defaultWorkspaceId),\n            roleMode: asRoleMode(rawPreferences.roleMode),\n            timezone: asNullableString(rawPreferences.timezone),\n            workingHours: asWorkingHours(rawPreferences.workingHours),\n            notificationPreferences: asNotifications(rawPreferences.notificationPreferences),\n            defaultTodayView: asDefaultTodayView(rawPreferences.defaultTodayView),\n            updatedAt: typeof rawPreferences.updatedAt === 'string' ? rawPreferences.updatedAt : null\n        }\n    };\n}\nexport class UserPreferencesHttpError extends Error {\n    code;\n    status;\n    constructor(code, status) {\n        super(code);\n        this.code = code;\n        this.status = status;\n        this.name = 'UserPreferencesHttpError';\n    }\n}\nexport class UserPreferencesClient {\n    config;\n    transport;\n    endpoint;\n    constructor(config, transport = fetch) {\n        this.config = config;\n        this.transport = transport;\n        const base = required(config.supabaseUrl, 'SUPABASE_URL').replace(/\\/+$/, '');\n        required(config.publishableKey, 'SUPABASE_PUBLISHABLE_KEY');\n        this.endpoint = `${base}/functions/v1/leader-os-preferences`;\n    }\n    async invoke(body) {\n        const accessToken = required(await this.config.accessTokenProvider(), 'SUPABASE_ACCESS_TOKEN');\n        const response = await this.transport(this.endpoint, {\n            method: 'POST',\n            headers: {\n                apikey: this.config.publishableKey,\n                Authorization: `Bearer ${accessToken}`,\n                'Content-Type': 'application/json'\n            },\n            body: JSON.stringify(body)\n        });\n        let payload = {};\n        try {\n            payload = await response.json();\n        }\n        catch { }\n        if (!response.ok) {\n            throw new UserPreferencesHttpError(typeof payload.error === 'string' ? payload.error : 'PREFERENCE_REQUEST_FAILED', response.status);\n        }\n        return parseEnvelope(payload);\n    }\n    get() {\n        return this.invoke({ action: 'get' });\n    }\n    save(expectedVersion, patch) {\n        if (!Number.isInteger(expectedVersion) || expectedVersion < 0)\n            throw new Error('INVALID_EXPECTED_VERSION');\n        return this.invoke({ action: 'save', expectedVersion, patch });\n    }\n}\nexport function browserTimezone() {\n    try {\n        const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;\n        return timezone && timezone.trim() ? timezone : 'UTC';\n    }\n    catch {\n        return 'UTC';\n    }\n}\nexport function preferenceTodayRoute(view) {\n    if (view === 'MY_PROJECTS')\n        return 'WORK';\n    if (view === 'REVIEWS')\n        return 'REVIEW';\n    return 'TODAY';\n}\n","work.js":"export function buildProjectView(project) {\n    const unknowns = [];\n    if (!project.owner)\n        unknowns.push('OWNER');\n    if (!project.goal)\n        unknowns.push('GOAL');\n    if (!project.nextMilestone)\n        unknowns.push('NEXT_MILESTONE');\n    return {\n        view: 'PROJECT',\n        ...project,\n        unknowns,\n        blameInference: false,\n        recoveryEligible: Boolean(project.knownRisk || project.needsAttention || project.openDecision)\n    };\n}\nexport function buildProjectRecovery(input) {\n    if (!input?.projectId || !input.symptom?.trim()) {\n        return { ok: false, error: 'PROJECT_AND_SYMPTOM_REQUIRED' };\n    }\n    return {\n        ok: true,\n        recovery: {\n            projectId: input.projectId,\n            symptom: input.symptom.trim(),\n            cause: input.cause?.trim() || null,\n            dependency: input.dependency?.trim() || null,\n            decisionNeeded: input.decisionNeeded?.trim() || null,\n            recovery: input.recovery?.trim() || null,\n            owner: input.owner?.trim() || null,\n            blameInference: false,\n            unknowns: [\n                ['CAUSE', input.cause],\n                ['DEPENDENCY', input.dependency],\n                ['DECISION', input.decisionNeeded],\n                ['RECOVERY', input.recovery],\n                ['OWNER', input.owner]\n            ].filter(([, value]) => !value).map(([name]) => name)\n        }\n    };\n}\n","workspace-directory.js":"function required(value, name) {\n    const trimmed = value?.trim();\n    if (!trimmed)\n        throw new Error(`${name}_REQUIRED`);\n    return trimmed;\n}\nexport class WorkspaceDirectoryHttpError extends Error {\n    code;\n    status;\n    constructor(code, status) {\n        super(code);\n        this.code = code;\n        this.status = status;\n        this.name = 'WorkspaceDirectoryHttpError';\n    }\n}\nexport class WorkspaceDirectoryClient {\n    config;\n    transport;\n    endpoint;\n    constructor(config, transport = fetch) {\n        this.config = config;\n        this.transport = transport;\n        const base = required(config.supabaseUrl, 'SUPABASE_URL').replace(/\\/+$/, '');\n        required(config.publishableKey, 'SUPABASE_PUBLISHABLE_KEY');\n        this.endpoint = `${base}/functions/v1/leader-os-workspaces`;\n    }\n    async list() {\n        const accessToken = required(await this.config.accessTokenProvider(), 'SUPABASE_ACCESS_TOKEN');\n        const response = await this.transport(this.endpoint, {\n            method: 'POST',\n            headers: {\n                apikey: this.config.publishableKey,\n                Authorization: `Bearer ${accessToken}`,\n                'Content-Type': 'application/json'\n            },\n            body: '{}'\n        });\n        let payload = {};\n        try {\n            payload = await response.json();\n        }\n        catch { }\n        if (!response.ok) {\n            throw new WorkspaceDirectoryHttpError(typeof payload.error === 'string' ? payload.error : 'WORKSPACE_DISCOVERY_FAILED', response.status);\n        }\n        const raw = Array.isArray(payload.workspaces) ? payload.workspaces : [];\n        const workspaces = raw.flatMap((value) => {\n            if (!value || typeof value !== 'object')\n                return [];\n            const row = value;\n            const role = String(row.role ?? '');\n            if (!['OWNER', 'ADMIN', 'LEADER', 'MEMBER', 'VIEWER'].includes(role))\n                return [];\n            if (row.status !== 'ACTIVE')\n                return [];\n            const workspaceId = typeof row.workspaceId === 'string' ? row.workspaceId.trim() : '';\n            const name = typeof row.name === 'string' ? row.name.trim() : '';\n            if (!workspaceId || !name)\n                return [];\n            return [{\n                    workspaceId,\n                    name,\n                    role,\n                    status: 'ACTIVE',\n                    joinedAt: typeof row.joinedAt === 'string' ? row.joinedAt : '',\n                    createdAt: typeof row.createdAt === 'string' ? row.createdAt : '',\n                    updatedAt: typeof row.updatedAt === 'string' ? row.updatedAt : ''\n                }];\n        });\n        return {\n            schemaVersion: typeof payload.schemaVersion === 'string' ? payload.schemaVersion : '1',\n            viewerUserId: typeof payload.viewerUserId === 'string' ? payload.viewerUserId : '',\n            workspaces\n        };\n    }\n}\nexport function chooseInitialWorkspace(workspaces, lastWorkspaceId, defaultWorkspaceId) {\n    const active = workspaces.filter((workspace) => workspace.status === 'ACTIVE');\n    if (active.length === 0) {\n        return { selected: null, source: 'NO_WORKSPACE', requiresChoice: false };\n    }\n    const preferred = defaultWorkspaceId?.trim();\n    if (preferred) {\n        const found = active.find((workspace) => workspace.workspaceId === preferred);\n        if (found)\n            return { selected: found, source: 'DEFAULT_PREFERENCE', requiresChoice: false };\n    }\n    const last = lastWorkspaceId?.trim();\n    if (last) {\n        const found = active.find((workspace) => workspace.workspaceId === last);\n        if (found)\n            return { selected: found, source: 'LAST_USED', requiresChoice: false };\n    }\n    if (active.length === 1) {\n        return { selected: active[0], source: 'ONLY_WORKSPACE', requiresChoice: false };\n    }\n    return { selected: null, source: 'USER_CHOICE_REQUIRED', requiresChoice: true };\n}\nexport function workspaceStorageKey(userId) {\n    return `leader-os:last-workspace:${userId}`;\n}\n"};
const cache = new Map();
const resolving = new Set();

function normalize(path) {
  const parts = [];
  for (const part of path.split('/')) {
    if (!part || part === '.') continue;
    if (part === '..') parts.pop();
    else parts.push(part);
  }
  return parts.join('/');
}

function resolveSpecifier(fromName, specifier) {
  const base = fromName.includes('/') ? fromName.slice(0, fromName.lastIndexOf('/') + 1) : '';
  return normalize(base + specifier);
}

function relativeSpecifiers(source) {
  const specs = [];
  const re = /(?:from\s+|import\s*)["'](\.\.?\/[^"']+\.js)["']/g;
  let match;
  while ((match = re.exec(source))) specs.push(match[1]);
  return [...new Set(specs)];
}

function build(name) {
  if (cache.has(name)) return cache.get(name);
  if (resolving.has(name)) throw new Error("CIRCULAR_MODULE:" + name);
  const source = MODULES[name];
  if (source == null) throw new Error("MODULE_NOT_FOUND:" + name);
  resolving.add(name);
  let rewritten = source;
  for (const spec of relativeSpecifiers(source)) {
    const depName = resolveSpecifier(name, spec);
    const depUrl = build(depName);
    rewritten = rewritten
      .replaceAll(`from '${spec}'`, `from '${depUrl}'`)
      .replaceAll(`from "${spec}"`, `from "${depUrl}"`)
      .replaceAll(`import '${spec}'`, `import '${depUrl}'`)
      .replaceAll(`import "${spec}"`, `import "${depUrl}"`);
  }
  const url = URL.createObjectURL(new Blob([rewritten], { type: "text/javascript" }));
  cache.set(name, url);
  resolving.delete(name);
  return url;
}

try {
  await import(build("app.js"));
  document.documentElement.dataset.previewReady = "true";
} catch (error) {
  console.error(error);
  const pre = document.createElement("pre");
  pre.style.cssText = "position:fixed;bottom:16px;left:16px;right:16px;z-index:9999;background:#111;color:#fff;padding:14px;border-radius:10px;white-space:pre-wrap";
  pre.textContent = "Leader OS Preview Error\n" + (error?.stack || error);
  document.body.append(pre);
}
</script>
<div class="product-recovery-note">PRODUCT RECOVERY · FULL CORE + ADD-ONS</div>
<script>
(function(){
  const THEME_KEY='leader-os:theme';
  const root=document.documentElement;
  const btn=document.querySelector('[data-theme-toggle]');
  let saved=null; try{saved=localStorage.getItem(THEME_KEY)}catch{}
  const initial=saved || 'light';
  root.dataset.theme=initial;
  function updateThemeLabel(){
    if(!btn) return;
    const dark=root.dataset.theme==='dark';
    btn.innerHTML=`<span aria-hidden="true">${dark?'☾':'☀'}</span>`;
    btn.setAttribute('aria-pressed', String(dark));
    btn.setAttribute('aria-label', dark?'다크 모드 사용 중. 클릭하면 라이트 모드로 전환':'라이트 모드 사용 중. 클릭하면 다크 모드로 전환');
    btn.setAttribute('title', dark?'다크 모드 사용 중. 클릭하면 라이트 모드로 전환':'라이트 모드 사용 중. 클릭하면 다크 모드로 전환');
  }
  updateThemeLabel();
  btn?.addEventListener('click',()=>{
    root.dataset.theme=root.dataset.theme==='dark'?'light':'dark';
    try{localStorage.setItem(THEME_KEY,root.dataset.theme)}catch{}
    updateThemeLabel();
  });

  const CLOCK_MODE_KEY='leader-os:clock-mode';
  const clockToggle=document.querySelector('[data-clock-toggle]');
  const analogWrap=document.querySelector('[data-clock-analog]');
  const digitalWrap=document.querySelector('[data-clock-digital]');
  const digitalTime=document.querySelector('[data-clock-digital-time]');
  const digitalDay=document.querySelector('[data-clock-digital-day]');
  const DAYS=['SUN','MON','TUE','WED','THU','FRI','SAT'];

  function applyClockMode(mode){
    const isDigital=mode==='digital';
    clockToggle?.classList.toggle('digital',isDigital);
    analogWrap?.setAttribute('aria-hidden',String(isDigital));
    digitalWrap?.setAttribute('aria-hidden',String(!isDigital));
    if(clockToggle){
      clockToggle.setAttribute(
        'aria-label',
        isDigital ? '디지털 시계. 클릭하면 아날로그 시계로 전환' : '아날로그 시계. 클릭하면 디지털 시계로 전환'
      );
    }
    try{localStorage.setItem(CLOCK_MODE_KEY,isDigital?'digital':'analog')}catch{}
  }

  function updateClock(){
    const n=new Date(), s=n.getSeconds()+n.getMilliseconds()/1000,
      m=n.getMinutes()+s/60, h=(n.getHours()%12)+m/60;
    const hh=document.querySelector('[data-clock-hour]');
    const mm=document.querySelector('[data-clock-minute]');
    const ss=document.querySelector('[data-clock-second]');
    if(hh) hh.style.transform=`rotate(${h*30}deg)`;
    if(mm) mm.style.transform=`rotate(${m*6}deg)`;
    if(ss) ss.style.transform=`rotate(${s*6}deg)`;
    if(digitalTime) digitalTime.textContent=`${String(n.getHours()).padStart(2,'0')}:${String(n.getMinutes()).padStart(2,'0')}`;
    if(digitalDay) digitalDay.textContent=DAYS[n.getDay()];
    if(clockToggle) clockToggle.title=`${String(n.getHours()).padStart(2,'0')}:${String(n.getMinutes()).padStart(2,'0')} ${DAYS[n.getDay()]} · 클릭하여 시계 전환`;
  }

  let savedClockMode='analog';
  try{savedClockMode=localStorage.getItem(CLOCK_MODE_KEY)||'analog'}catch{}
  applyClockMode(savedClockMode);
  updateClock();
  setInterval(updateClock,250);

  clockToggle?.addEventListener('click',()=>{
    applyClockMode(clockToggle.classList.contains('digital')?'analog':'digital');
    updateClock();
  });

  document.querySelector('[data-brand-home]')?.addEventListener('click',()=>{
    const link=[...document.querySelectorAll('[data-primary-nav] a')].find(a=>/Today/i.test(a.textContent||''));
    if(link) link.click(); else location.hash='#today';
  });

  document.querySelector('[data-showcase-demo]')?.addEventListener('click',()=>{
    const disconnect=document.querySelector('[data-live-disconnect]');
    if(disconnect && !disconnect.hidden) disconnect.click();
    const link=[...document.querySelectorAll('[data-primary-nav] a')].find(a=>/Today/i.test(a.textContent||''));
    if(link) link.click();
    window.scrollTo({top:0,behavior:'smooth'});
  });
})();
</script>
<script>
(function(){
  document.addEventListener('click', function(e){
    const link=e.target.closest('[data-fallback-page]');
    if(!link) return;
    const page=link.getAttribute('data-fallback-page');
    const target=document.querySelector(`[data-page="${page}"]`);
    if(!target) return;
    e.preventDefault();
    document.querySelectorAll('[data-page]').forEach(el=>el.hidden=el!==target);
    document.querySelectorAll('[data-fallback-page]').forEach(a=>a.removeAttribute('aria-current'));
    link.setAttribute('aria-current','page');
    const title=document.querySelector('[data-topbar-title]');
    if(title) title.textContent=(link.textContent||page).trim();
    history.replaceState(null,'',link.getAttribute('href')||'#today');
    window.scrollTo({top:0,behavior:'auto'});
  });
})();
</script>
<script>
(function(){
  const STORAGE_BASE='leader-os:1on1-leadership-lens:v2';
  const store=window.__leaderOsStorage||(()=>{try{return localStorage}catch{return null}})();
  const localScope=()=>{try{const x=window.LeaderOsReportRuntimeBridge?.state?.();return x?.signedIn&&x.userId&&x.workspaceId?`${x.userId}:${x.workspaceId}`:'guest'}catch{return'guest'}};
  const storageKey=()=>`${STORAGE_BASE}:${localScope()}`;
  const qs=(s)=>document.querySelector(s);
  const qa=(s)=>[...document.querySelectorAll(s)];
  const esc=(v)=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const state={motives:[]};

  const modeCopy={
    GUIDE:'구체적인 순서·기준·예시를 제시합니다. 자율을 주기 전에 성공 기준을 먼저 보이게 합니다.',
    COACH:'정답을 바로 주기보다 질문과 피드백으로 스스로 방법을 설계하게 돕습니다.',
    SUPPORT:'실행 판단은 맡기고, 필요한 자원·조율·장애물 제거에 집중합니다.',
    DELEGATE:'왜와 결과 기준만 합의하고 방법은 맡깁니다. 중간 간섭 대신 체크포인트를 합의합니다.'
  };

  function value(sel){ return qs(sel)?.value?.trim() || ''; }
  function mode(){ return qs('[data-lead-mode]')?.value || 'GUIDE'; }
  function updateMode(){ const el=qs('[data-lead-mode-explain]'); if(el) el.textContent=modeCopy[mode()]||''; }

  qa('[data-motive]').forEach(btn=>btn.addEventListener('click',()=>{
    const v=btn.dataset.motive;
    if(state.motives.includes(v)) state.motives=state.motives.filter(x=>x!==v);
    else state.motives.push(v);
    btn.classList.toggle('selected',state.motives.includes(v));
  }));

  qs('[data-lead-mode]')?.addEventListener('change',updateMode);
  updateMode();

  function makeNote(){
    const result=value('[data-lead-result]') || '아직 정의하지 않음';
    const system=value('[data-lead-system]') || '대화 후 필요한 시스템을 정의';
    const change=value('[data-lead-change]') || '30일 뒤의 변화를 대화에서 합의';
    const motive=state.motives.length?state.motives.join(' · '):'가설 없음 — 대화에서 확인';
    const leading=mode();

    const questions=[
      '지금 이 일에서 본인에게 가장 중요하게 느껴지는 것은 무엇인가요?',
      state.motives.length ? `제가 ${state.motives.join(', ')} 쪽이 중요할 수 있다고 생각했는데, 실제로는 어떤가요?` : '이 일을 할 때 더 힘이 나는 조건과 힘이 빠지는 조건은 무엇인가요?',
      `이번 주가 끝났을 때 “잘 됐다”고 말할 수 있는 결과물은 무엇인가요?`,
      '지금 가장 불명확하거나 반복해서 막히는 지점은 어디인가요?',
      leading==='GUIDE' ? '제가 더 구체적으로 기준이나 예시를 줘야 하는 부분은 어디인가요?' :
      leading==='COACH' ? '본인이 생각한 해결 방법은 무엇이고, 그중 먼저 시험해볼 것은 무엇인가요?' :
      leading==='SUPPORT' ? '판단은 맡길게요. 대신 제가 제거해야 할 장애물은 무엇인가요?' :
      '제가 관여하지 않아도 되는 영역과, 반드시 공유해야 할 체크포인트를 어떻게 나눌까요?',
      '이 문제가 다음에도 반복되지 않으려면 어떤 룰·프로세스·기준이 필요할까요?',
      '30일 뒤 지금과 무엇이 달라져 있다면 의미 있는 변화라고 볼 수 있을까요?'
    ];

    const html=`
      <div class="lead-note">
        <div class="summary-side">
          <h3>이번 1:1의 리더 관점</h3>
          <div class="note-row"><span>동기 가설</span><div>${esc(motive)} <small>· 확인 필요</small></div></div>
          <div class="note-row"><span>결과물</span><div>${esc(result)}</div></div>
          <div class="note-row"><span>리딩 방식</span><div>${esc(leading)} · ${esc(modeCopy[leading])}</div></div>
          <div class="note-row"><span>시스템</span><div>${esc(system)}</div></div>
          <div class="note-row"><span>만들 변화</span><div>${esc(change)}</div></div>
          <div class="lead-principles">
            사람을 몰아붙이지 않는다.<br>
            목표와 성과 기준에는 모호함을 남기지 않는다.<br>
            반복되는 문제는 개인의 선의보다 시스템으로 해결한다.<br>
            리더의 질문은 “누가 문제인가?”보다 “무엇이 달라져야 하는가?”에 가깝게 둔다.
          </div>
        </div>
        <div class="question-side">
          <h3>대화에서 확인할 질문</h3>
          <ol>${questions.map(q=>`<li>${esc(q)}</li>`).join('')}</ol>
        </div>
      </div>`;
    const output=qs('[data-lead-output]');
    if(output) output.innerHTML=html;
    return {motive:state.motives,result,system,change,leading,questions};
  }

  function toText(note){
    return [
      '[Leader OS · 1:1 Leadership Lens]',
      '',
      `동기 가설: ${note.motive.length?note.motive.join(', '):'없음 — 대화에서 확인'}`,
      `이번 주 결과물: ${note.result}`,
      `리딩 방식: ${note.leading}`,
      `시스템/룰: ${note.system}`,
      `30일 변화: ${note.change}`,
      '',
      '[대화 질문]',
      ...note.questions.map((q,i)=>`${i+1}. ${q}`),
      '',
      '[리더 마인드]',
      '- 동기를 주입하기보다 발견하고 조직 목표와 연결한다.',
      '- 사람에게 엄격하기보다 목표와 기준에 엄격해진다.',
      '- 반복되는 문제는 개인의 선의보다 시스템으로 해결한다.',
      '- 자율은 방임이 아니다. 필요한 가이드의 양을 상황에 맞춘다.',
      '- 회의와 1:1은 활동량보다 만들어질 결과와 변화를 확인한다.'
    ].join('\\n');
  }

  qs('[data-lead-generate]')?.addEventListener('click',()=>{
    makeNote();
    const st=qs('[data-lead-status]'); if(st) st.textContent='준비 노트를 만들었습니다. 아직 Draft입니다.';
  });

  qs('[data-lead-save]')?.addEventListener('click',()=>{
    const note=makeNote();
    try{
      store?.setItem(storageKey(),JSON.stringify({motives:state.motives,result:note.result,system:note.system,change:note.change,leading:note.leading,updatedAt:new Date().toISOString()}));
      const st=qs('[data-lead-status]'); if(st) st.textContent='이 브라우저에 Draft로 저장했습니다.';
    }catch{
      const st=qs('[data-lead-status]'); if(st) st.textContent='저장할 수 없는 환경입니다. 노트 복사를 사용하세요.';
    }
  });

  qs('[data-lead-copy]')?.addEventListener('click',async()=>{
    const note=makeNote(), text=toText(note);
    try{
      await navigator.clipboard.writeText(text);
      const st=qs('[data-lead-status]'); if(st) st.textContent='1:1 준비 노트를 복사했습니다.';
    }catch{
      const st=qs('[data-lead-status]'); if(st) st.textContent='복사 권한이 없습니다. 화면의 노트를 직접 선택해 복사하세요.';
    }
  });

  function loadScopedDraft(){
    try{
      const raw=store?.getItem(storageKey());
      state.motives=[];
      qa('[data-motive]').forEach(b=>b.classList.remove('selected'));
      if(qs('[data-lead-result]')) qs('[data-lead-result]').value='';
      if(qs('[data-lead-system]')) qs('[data-lead-system]').value='';
      if(qs('[data-lead-change]')) qs('[data-lead-change]').value='';
      if(qs('[data-lead-mode]')) qs('[data-lead-mode]').value='GUIDE';
      if(raw){
        const d=JSON.parse(raw);
        state.motives=Array.isArray(d.motives)?d.motives:[];
        qa('[data-motive]').forEach(b=>b.classList.toggle('selected',state.motives.includes(b.dataset.motive)));
        if(qs('[data-lead-result]')) qs('[data-lead-result]').value=d.result==='아직 정의하지 않음'?'':(d.result||'');
        if(qs('[data-lead-system]')) qs('[data-lead-system]').value=d.system==='대화 후 필요한 시스템을 정의'?'':(d.system||'');
        if(qs('[data-lead-change]')) qs('[data-lead-change]').value=d.change==='30일 뒤의 변화를 대화에서 합의'?'':(d.change||'');
        if(qs('[data-lead-mode]') && d.leading) qs('[data-lead-mode]').value=d.leading;
        const st=qs('[data-lead-status]'); if(st) st.textContent='현재 User + Workspace의 Draft를 불러왔습니다.';
      }
      updateMode();
    }catch{}
  }
  let activeScope=localScope();
  loadScopedDraft();
  setInterval(()=>{const next=localScope();if(next===activeScope)return;activeScope=next;loadScopedDraft()},1450);
})();</script>
<script>
(function(){
  const q=(s)=>document.querySelector(s);
  const qa=(s)=>[...document.querySelectorAll(s)];
  const esc=(v)=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const state={clarity:null,intervention:null,systems:[]};

  const labels={
    clarity:{CLEAR:'명확했다',PARTIAL:'일부 모호했다',REALIGN:'다시 맞춰야 한다'},
    intervention:{BALANCED:'적정했다',TOO_MUCH:'내가 너무 많이 했다',TOO_LITTLE:'지원이 부족했다'},
    system:{STANDARD:'기준 불명확',PROCESS:'프로세스',AUTHORITY:'권한·의사결정',DEPENDENCY:'의존성·협업',RESOURCE:'자원·시간',NONE:'특이 신호 없음'}
  };

  qa('[data-after-clarity] button').forEach(btn=>btn.addEventListener('click',()=>{
    state.clarity=btn.dataset.value;
    qa('[data-after-clarity] button').forEach(x=>x.classList.toggle('selected',x===btn));
  }));
  qa('[data-after-intervention] button').forEach(btn=>btn.addEventListener('click',()=>{
    state.intervention=btn.dataset.value;
    qa('[data-after-intervention] button').forEach(x=>x.classList.toggle('selected',x===btn));
  }));
  qa('[data-after-system] button').forEach(btn=>btn.addEventListener('click',()=>{
    const v=btn.dataset.value;
    if(v==='NONE'){
      state.systems=['NONE'];
    }else{
      state.systems=state.systems.filter(x=>x!=='NONE');
      state.systems=state.systems.includes(v)?state.systems.filter(x=>x!==v):[...state.systems,v];
    }
    qa('[data-after-system] button').forEach(x=>x.classList.toggle('selected',state.systems.includes(x.dataset.value)));
  }));

  function read(){
    return {
      clarity:state.clarity,
      intervention:state.intervention,
      systems:[...state.systems],
      change:q('[data-after-change]')?.value?.trim()||'',
      leaderAction:q('[data-after-leader-action]')?.value?.trim()||''
    };
  }

  function suggestion(d){
    const tips=[];
    if(d.clarity==='PARTIAL') tips.push('다음 체크인 전에 결과물과 완료 기준을 한 문장으로 다시 합의합니다.');
    if(d.clarity==='REALIGN') tips.push('실행을 더 밀기 전에 목표·우선순위·Definition of Done부터 다시 맞춥니다.');
    if(d.intervention==='TOO_MUCH') tips.push('다음에는 방법을 대신 정하기보다 결과 기준과 체크포인트만 합의해 위임 범위를 넓힙니다.');
    if(d.intervention==='TOO_LITTLE') tips.push('필요한 가이드·예시·자원·의사결정 지원 중 무엇이 부족했는지 먼저 보완합니다.');
    if(d.systems.some(x=>x!=='NONE')) tips.push('반복 가능성이 있는 문제는 개인 요청으로 끝내지 말고 룰·프로세스·권한 기준으로 바꿉니다.');
    if(!tips.length) tips.push('현재 방식은 유지하되, 합의한 결과와 실제 변화가 다음 체크인에서 이어지는지 확인합니다.');
    return tips;
  }

  function render(){
    const d=read();
    const sys=d.systems.length?d.systems.map(x=>labels.system[x]||x).join(' · '):'아직 선택하지 않음';
    const tips=suggestion(d);
    const out=q('[data-after-output]');
    if(out) out.innerHTML=`
      <div class="after-summary">
        <div class="after-left">
          <h3>리딩 회고</h3>
          <div class="note-row"><span>목표 선명도</span><div>${esc(labels.clarity[d.clarity]||'아직 선택하지 않음')}</div></div>
          <div class="note-row"><span>개입 정도</span><div>${esc(labels.intervention[d.intervention]||'아직 선택하지 않음')}</div></div>
          <div class="note-row"><span>시스템 신호</span><div>${esc(sys)}</div></div>
          <div class="note-row"><span>생긴 변화</span><div>${esc(d.change||'아직 기록하지 않음')}</div></div>
          <div class="note-row"><span>다음 행동</span><div>${esc(d.leaderAction||'아직 기록하지 않음')}</div></div>
        </div>
        <div class="after-right">
          <h3>다음 리딩에서 조정할 것</h3>
          <div class="after-next">${tips.map((t,i)=>`${i+1}. ${esc(t)}`).join('<br>')}</div>
          <div class="lead-principles" style="margin-top:10px">
            이 결과는 팀원 평가가 아니라 리더의 자기 회고입니다.<br>
            “누가 문제인가?”보다 “목표·개입·시스템 중 무엇을 조정할까?”를 봅니다.
          </div>
        </div>
      </div>`;
    return {...d,tips};
  }

  function asText(d){
    const sys=d.systems.length?d.systems.map(x=>labels.system[x]||x).join(', '):'미선택';
    return [
      '[Leader OS · After 1:1 Leader Review]',
      `목표 선명도: ${labels.clarity[d.clarity]||'미선택'}`,
      `개입 정도: ${labels.intervention[d.intervention]||'미선택'}`,
      `시스템 신호: ${sys}`,
      `대화 후 변화: ${d.change||'미기록'}`,
      `내 다음 리더 행동: ${d.leaderAction||'미기록'}`,
      '',
      '[다음 리딩에서 조정할 것]',
      ...d.tips.map((x,i)=>`${i+1}. ${x}`),
      '',
      '※ 사람 평가가 아닌 리더의 Private Draft.'
    ].join('\\n');
  }

  q('[data-after-generate]')?.addEventListener('click',()=>{
    render();
    const st=q('[data-after-status]'); if(st) st.textContent='리딩 회고를 만들었습니다. Private Draft입니다.';
  });

  q('[data-after-copy]')?.addEventListener('click',async()=>{
    const d=render();
    try{
      await navigator.clipboard.writeText(asText(d));
      const st=q('[data-after-status]'); if(st) st.textContent='회고를 복사했습니다.';
    }catch{
      const st=q('[data-after-status]'); if(st) st.textContent='복사 권한이 없습니다.';
    }
  });

  q('[data-after-to-action]')?.addEventListener('click',()=>{
    const d=render();
    const text=d.leaderAction || d.tips[0] || '';
    const type=q('[data-one-on-one-capture-type]');
    const input=q('[data-one-on-one-capture-text]');
    if(type) type.value='ACTION';
    if(input) input.value=text;
    const st=q('[data-after-status]');
    if(st) st.textContent='Talk & Capture에 ACTION 후보를 준비했습니다. 확인 후 Candidate로 캡처하세요.';
    input?.scrollIntoView({behavior:'smooth',block:'center'});
    input?.focus();
  });
})();
</script>
<script>
(function(){
  let tries=0;
  const openQuest=()=>{
    const page=document.querySelector('[data-page="ONBOARDING"]');
    if(page && !page.hidden){window.scrollTo({top:0,behavior:'auto'});return;}
    const button=document.querySelector('[data-onboarding-open]');
    if(button) button.click();
    tries+=1;
    if((!page || page.hidden) && tries<30) setTimeout(openQuest,100);
    else window.scrollTo({top:0,behavior:'auto'});
  };
  if(document.readyState==='complete') setTimeout(openQuest,50);
  else window.addEventListener('load',()=>setTimeout(openQuest,50),{once:true});
})();
</script>
<script>
(function(){
  const KEY='leader-os:ways-of-working:v1';
  const QUEST_KEY='leader-os:leadership-quest:v4';
  const q=(s,r=document)=>r.querySelector(s), qa=(s,r=document)=>[...r.querySelectorAll(s)];
  const storage=window.__leaderOsStorage;
  const defaults={cycle:[],rules:[],logs:[]};
  let state=defaults;
  try{state={...defaults,...JSON.parse(storage.getItem(KEY)||'{}')}}catch{}
  const save=()=>{try{storage.setItem(KEY,JSON.stringify(state))}catch{}};
  const page=q('[data-page="WAYS_OF_WORKING"]'); if(!page) return;

  function navTo(id){ const a=q(`[data-route-id="${id}"]`) || q(`[data-fallback-page="${id}"]`); if(a){a.click();return;} location.hash=id.toLowerCase(); }
  qa('[data-wow-route]',page).forEach(b=>b.addEventListener('click',()=>navTo(b.dataset.wowRoute)));
  qa('[data-wow-quest-day]',page).forEach(b=>b.addEventListener('click',()=>{
    const day=Number(b.dataset.wowQuestDay)||1;
    try{const raw=JSON.parse(storage.getItem(QUEST_KEY)||'{}');raw.selectedDay=day;storage.setItem(QUEST_KEY,JSON.stringify(raw))}catch{}
    navTo('ONBOARDING');
  }));

  const steps=qa('[data-wow-cycle]',page), progress=q('[data-wow-cycle-progress]',page), count=q('[data-wow-cycle-count]',page);
  function renderCycle(){
    steps.forEach(b=>b.classList.toggle('done',state.cycle.includes(b.dataset.wowCycle)));
    const n=state.cycle.length; if(progress) progress.style.width=`${n/7*100}%`; if(count) count.textContent=`${n} / 7`;
  }
  steps.forEach(b=>b.addEventListener('click',()=>{const k=b.dataset.wowCycle;state.cycle=state.cycle.includes(k)?state.cycle.filter(x=>x!==k):[...state.cycle,k];save();renderCycle()}));

  const rules=qa('[data-wow-rule]',page), ruleCount=q('[data-wow-rule-count]',page);
  function renderRules(){rules.forEach(i=>i.checked=state.rules.includes(i.dataset.wowRule)); if(ruleCount) ruleCount.textContent=`${state.rules.length} / ${rules.length}`}
  rules.forEach(i=>i.addEventListener('change',()=>{const k=i.dataset.wowRule;state.rules=i.checked?[...new Set([...state.rules,k])]:state.rules.filter(x=>x!==k);save();renderRules()}));

  const scenario=q('[data-wow-scenario]',page), input=q('[data-wow-input]',page), output=q('[data-wow-output]',page), saved=q('[data-wow-saved]',page);
  const examples={
    feedback:'기획안의 핵심 고객 문제가 너무 뒤에 나오고 있어 초반 설득력이 약하다.',
    praise:'클라이언트 질문에 바로 답하지 않고 질문 의도를 확인해서 논점이 선명해졌다.',
    meeting:'주간회의가 90분 동안 현황 공유만 하고 실제 결정 없이 끝난다.',
    decision:'캠페인 A 연장 여부를 논의 중이지만 최종 결정권자와 판단 기준이 불명확하다.',
    delegation:'SNS 콘텐츠를 계속 팀장이 최종 승인해서 작업 속도가 느려지고 있다.',
    career:'팀원이 브랜드 전략을 하고 싶다고 하지만 현재는 실행 업무만 반복하고 있다.'
  };
  function draft(type,memo){
    const m=memo||'(내 상황을 구체적으로 적으세요)';
    if(type==='feedback') return `CORE 개선 피드백\n\nContext · 어떤 상황인가?\n${m}\n\nObservation · 판단 대신 실제 행동/결과를 한 문장으로 적습니다.\nResult · 이 행동이 고객·팀·성과에 만든 영향을 적습니다.\nExpected Next · 다음 버전에서 무엇을 바꿀지 합의합니다.\nInquiry · “현재 방식을 선택한 이유가 있었나요?”라고 물어 상대의 관점을 확인합니다.`;
    if(type==='praise') return `CORE 칭찬\n\nContext · ${m}\nObservation · 잘한 행동을 구체적으로 짚습니다.\nResult · 그 행동 덕분에 무엇이 좋아졌는지 연결합니다.\nExpected Next · 다음 프로젝트에서도 반복하거나 팀에 공유하도록 요청합니다.\n\n주의: “역시 센스가 좋아요”처럼 사람의 성격만 칭찬하지 않습니다.`;
    if(type==='meeting') return `회의 재설계\n\n현재 문제 · ${m}\n\n1. 이 회의의 목적을 하나 고릅니다: LISTEN / DEBATE / DECIDE.\n2. 사전 Input을 정합니다.\n3. 회의가 끝나면 남을 Output을 하나 정합니다.\n4. Decision이 필요하면 Decide owner를 지정합니다.\n5. 다음 Action의 Owner / Due를 남깁니다.\n\n회의에서 Debate와 Decision을 동시에 무리하게 해결하지 않습니다.`;
    if(type==='decision') return `Decision Card\n\nContext · ${m}\nDecision · 무엇을 결정해야 하는가?\nOptions · 현실적인 대안은 무엇인가?\nEvidence · 무엇을 근거로 비교할 것인가?\nDecide Owner · 최종 결정자는 누구인가?\nDecision Date · 언제까지 결정해야 하는가?\nReview Date · 결정의 결과를 언제 다시 볼 것인가?`;
    if(type==='delegation') return `Delegation Contract\n\nContext · ${m}\nOutcome · 무엇이 완성되면 성공인가?\nGuardrail · 넘으면 안 되는 범위는?\nAuthority · 팀원이 어디까지 독립 결정 가능한가?\nResources · 무엇을 지원해야 하는가?\nCheckpoint · 언제 다시 확인할 것인가?\n\n“알아서 해주세요” 대신 권한과 경계를 함께 넘깁니다.`;
    return `Career Conversation 준비\n\nContext · ${m}\n\nLife Story · 과거 어떤 선택과 경험이 이 사람을 움직였는가?\nDreams · 제약이 없다면 어떤 문제를 해결하고 싶은가?\nShort-term Plan · 앞으로 6–18개월 동안 어떤 경험이나 역량을 쌓을 것인가?\nManager Support · 현재 Work / Project 중 어떤 기회를 연결할 수 있는가?\n\n이 대화는 성과등급이나 승진 약속과 분리합니다.`;
  }
  q('[data-wow-example]',page)?.addEventListener('click',()=>{input.value=examples[scenario.value]||'';output.textContent=draft(scenario.value,input.value)});
  q('[data-wow-generate]',page)?.addEventListener('click',()=>{output.textContent=draft(scenario.value,String(input.value||'').trim())});
  q('[data-wow-copy]',page)?.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(output.textContent||'')}catch{}});
  function renderLogs(){if(!saved)return;saved.innerHTML=(state.logs||[]).slice(0,4).map(x=>`<div class="wow-saved"><b>${x.label}</b><span>${x.text.replace(/[<>]/g,'').slice(0,180)}</span></div>`).join('')||'<div class="review-meta">아직 저장한 Practice Log가 없습니다.</div>'}
  q('[data-wow-save]',page)?.addEventListener('click',()=>{const text=String(output.textContent||'').trim();if(!text)return;state.logs=[{label:scenario.options[scenario.selectedIndex]?.text||scenario.value,text,at:new Date().toISOString()},...(state.logs||[])].slice(0,12);save();renderLogs()});
  scenario?.addEventListener('change',()=>{input.placeholder=examples[scenario.value]||'내 상황을 적으세요.'});
  renderCycle();renderRules();renderLogs();
})();
</script>
<script id="recovery-19-runtime">
(function(){
  const WOW_KEY='leader-os:ways-of-working:v1';
  const RUNTIME_KEY='leader-os:operating-rules-runtime:v1';
  const ART_KEYS=['leader-os:operating-artifacts:v6','leader-os:operating-artifacts:v5','leader-os:operating-artifacts:v4','leader-os:operating-artifacts:v3'];
  const q=(s,r=document)=>r.querySelector(s), qa=(s,r=document)=>[...r.querySelectorAll(s)];
  const storage=window.__leaderOsStorage||(()=>{const m=new Map();return{getItem:k=>m.has(String(k))?m.get(String(k)):null,setItem:(k,v)=>m.set(String(k),String(v)),removeItem:k=>m.delete(String(k))}})(); window.__leaderOsStorage=storage;
  const safeJson=(raw,fallback={})=>{try{return raw?JSON.parse(raw):fallback}catch{return fallback}};
  const readWow=()=>({cycle:[],rules:[],logs:[],...safeJson(storage.getItem(WOW_KEY),{})});
  const readArtifacts=()=>{for(const k of ART_KEYS){const raw=storage.getItem(k);if(raw)return safeJson(raw,{})}return {}};
  const readRuntime=()=>({checks:{},notes:{},lastAppliedAt:null,...safeJson(storage.getItem(RUNTIME_KEY),{})});
  let runtime=readRuntime();
  const saveRuntime=()=>{runtime.lastAppliedAt=new Date().toISOString();try{storage.setItem(RUNTIME_KEY,JSON.stringify(runtime))}catch{}};
  const esc=(v)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const ruleMeta={
    solicit:{label:'ASK FIRST',title:'리더가 먼저 피드백 요청',surfaces:['TODAY','ONE_ON_ONE'],prompts:{TODAY:'오늘 한 번은 “제가 바꾸면 좋을 한 가지가 있나요?”라고 먼저 물어보세요.',ONE_ON_ONE:'1:1의 첫 피드백은 팀원에게 요구하기보다 리더 자신의 개선점부터 구체적으로 요청합니다.'}},
    specific:{label:'SPECIFIC',title:'행동 중심 피드백',surfaces:['TODAY','ONE_ON_ONE','REVIEW'],prompts:{TODAY:'칭찬 또는 개선 피드백 하나를 상황·관찰·영향까지 구체화하세요.',ONE_ON_ONE:'성격 대신 실제 상황과 관찰한 행동, 그 영향을 말할 준비를 하세요.',REVIEW:'이번 주 피드백 중 “좋았다/아쉬웠다”로 끝난 문장을 Evidence가 있는 문장으로 바꿉니다.'}},
    timely:{label:'TIMELY',title:'가까운 시점에 피드백',surfaces:['TODAY','ONE_ON_ONE'],prompts:{TODAY:'사실관계가 확인된 뒤 미뤄둔 피드백이 있다면 가장 가까운 대화 슬롯에 넣으세요.',ONE_ON_ONE:'오래 묵힌 여러 사건을 한꺼번에 꺼내기보다 가장 최근의 구체적 사례 하나부터 다룹니다.'}},
    private:{label:'PRIVATE',title:'민감 피드백은 사적으로',surfaces:['ONE_ON_ONE'],prompts:{ONE_ON_ONE:'민감한 개선 피드백은 공개 회의가 아니라 이 1:1에서 직접 다룹니다. 공유 범위도 합의합니다.'}},
    debate:{label:'DEBATE≠DECIDE',title:'토론과 결정 분리',surfaces:['TODAY','MEETINGS','DECISIONS'],prompts:{TODAY:'오늘 결정이 필요한 회의가 있다면 “토론 시간”과 “결정 순간”을 분리하세요.',MEETINGS:'회의 목적을 먼저 DEBATE 또는 DECISION으로 선언하고, 둘을 한 회의에서 섞지 않습니다.',DECISIONS:'결정 전에 반대 의견과 대안이 충분히 나온 흔적이 있는지 확인합니다.'}},
    owner:{label:'OWNER',title:'결정 Owner + Review Date',surfaces:['TODAY','MEETINGS','DECISIONS'],prompts:{TODAY:'열린 Decision 중 D(최종 결정자)나 Review Date가 비어 있는 항목을 하나 닫으세요.',MEETINGS:'Decision Meeting이라면 끝나기 전에 D(최종 결정자), 결정 내용, Review Date를 남깁니다.',DECISIONS:'각 Decision에 D가 한 명인지, Due/Review 시점이 있는지 확인합니다.'}},
    delegate:{label:'DELEGATE',title:'Guardrail + Authority',surfaces:['TODAY','ONE_ON_ONE','REVIEW'],prompts:{TODAY:'오늘 팀장 승인에 몰린 일 하나를 Outcome·Guardrail·Authority·Checkpoint로 다시 써보세요.',ONE_ON_ONE:'팀원이 더 독립적으로 판단할 수 있도록 “어디까지 직접 결정해도 되는가?”를 합의합니다.',REVIEW:'반복해서 리더에게 올라온 승인 중 위임 가능한 항목 하나를 골라 다음 주 실험으로 만듭니다.'}},
    learn:{label:'LEARN',title:'Debrief → Next Work',surfaces:['TODAY','REVIEW'],prompts:{TODAY:'최근 Debrief의 Next가 실제 Work/Priority로 이어졌는지 한 번 확인하세요.',REVIEW:'Expected와 Actual의 차이에서 배운 한 가지를 다음 주 Priority 또는 운영 Rule로 변환합니다.'}}
  };
  const surfaceLabels={TODAY:'Today',ONE_ON_ONE:'1:1 Prep',MEETINGS:'Meeting Prep',DECISIONS:'Decision Review',REVIEW:'Weekly Review'};
  const activeRules=()=>readWow().rules.filter(k=>ruleMeta[k]);
  const surfacePriority={TODAY:['owner','delegate','learn','solicit','timely','specific','debate'],ONE_ON_ONE:['solicit','specific','private','delegate','timely'],MEETINGS:['debate','owner'],DECISIONS:['owner','debate'],REVIEW:['learn','delegate','specific']};
  const orderedRules=(surface)=>{const active=activeRules().filter(k=>ruleMeta[k].surfaces.includes(surface));const rank=surfacePriority[surface]||[];return [...active].sort((a,b)=>{const ai=rank.indexOf(a),bi=rank.indexOf(b);return (ai<0?99:ai)-(bi<0?99:bi)})};
  const contextualPrompt=(surface,k)=>{const base=ruleMeta[k]?.prompts?.[surface]||'';const a=readArtifacts();if(surface==='TODAY'&&k==='owner'){const open=(Array.isArray(a.DECISION_RIGHTS)?a.DECISION_RIGHTS:[]).filter(r=>!['DECIDED','CANCELLED'].includes(String(r.decisionStatus||'OPEN').toUpperCase()));if(open[0])return `열린 Decision “${open[0].decision||'이름 미정'}”의 D(${open[0].decide||'미정'})와 Due(${open[0].dueDate||'미정'})를 확인하세요.`;}if(surface==='TODAY'&&k==='delegate'){const c=(Array.isArray(a.ONE_ON_ONE_COMMITMENT)?a.ONE_ON_ONE_COMMITMENT:[]).filter(r=>!['DONE','CANCELLED'].includes(String(r.status||'OPEN').toUpperCase()));if(c[0])return `${c[0].person||'팀원'}의 Commitment “${c[0].commitment||'내용 미정'}”를 Authority·Checkpoint가 있는 위임으로 연결할지 확인하세요.`;}if(surface==='TODAY'&&k==='learn'){const d=(Array.isArray(a.DEBRIEF)?a.DEBRIEF:[]).slice(-1)[0];if(d?.next)return `최근 Debrief의 Next “${d.next}”가 실제 Work / Priority로 이어졌는지 확인하세요.`;}if(surface==='ONE_ON_ONE'&&k==='delegate'){const c=(Array.isArray(a.ONE_ON_ONE_COMMITMENT)?a.ONE_ON_ONE_COMMITMENT:[]).filter(r=>!['DONE','CANCELLED'].includes(String(r.status||'OPEN').toUpperCase()));if(c[0])return `${c[0].person||'팀원'}와 “${c[0].commitment||'Commitment'}”를 어디까지 스스로 결정할지 합의하세요.`;}if(surface==='REVIEW'&&k==='learn'){const d=(Array.isArray(a.DEBRIEF)?a.DEBRIEF:[]).slice(-1)[0];if(d?.next)return `Debrief의 Next “${d.next}”를 다음 Priority 후보로 올릴지 검토하세요.`;}return base;};
  const checkKey=(surface,rule)=>`${surface}:${rule}`;
  const isChecked=(surface,rule)=>Boolean(runtime.checks?.[checkKey(surface,rule)]);
  const setChecked=(surface,rule,val)=>{runtime.checks=runtime.checks||{};runtime.checks[checkKey(surface,rule)]=Boolean(val);saveRuntime()};
  function go(id){
    if(id==='ONBOARDING'){q('[data-onboarding-open]')?.click();return;}
    const a=q(`[data-route-id="${id}"]`)||q(`[data-fallback-page="${id}"]`); if(a)a.click();
  }
  function promptHtml(surface,rules){
    if(!rules.length)return `<div class="r19-empty">활성화된 Team Operating Rule이 없습니다. <button type="button" data-r19-go="WAYS_OF_WORKING">Ways of Working에서 규칙 선택 →</button></div>`;
    const visible=rules.slice(0,4), hidden=Math.max(0,rules.length-visible.length);
    return `<div class="r19-prompt-list">${visible.map(k=>{const m=ruleMeta[k];const txt=contextualPrompt(surface,k);if(!txt)return'';const done=isChecked(surface,k);return `<label class="r19-prompt ${done?'done':''}"><input type="checkbox" data-r19-check="${esc(surface)}:${esc(k)}" ${done?'checked':''}><span><strong>${esc(m.title)}</strong><span>${esc(txt)}</span></span><span class="r19-rule-code">${esc(m.label)}</span></label>`}).join('')}${hidden?`<div class="r19-empty">+ ${hidden}개의 활성 규칙은 Ways of Working에서 확인할 수 있습니다. 지금 화면에는 우선순위가 높은 4개만 표시합니다.</div>`:''}</div>`;
  }
  function makeCard(surface,subtitle){
    const rules=orderedRules(surface);
    const card=document.createElement('section');card.className='r19-policy-card';card.dataset.r19Surface=surface;
    card.innerHTML=`<div class="r19-policy-head"><div><div class="r19-kicker">WAYS OF WORKING · LIVE POLICY</div><h2>${esc(surfaceLabels[surface])}에 적용되는 팀 운영 규칙</h2><p>${esc(subtitle)}</p></div><span class="r19-live-badge">LIVE · ${rules.length} RULES</span></div><div class="r19-rule-strip">${rules.map(k=>`<span class="r19-rule-chip"><b>${esc(ruleMeta[k].label)}</b>${esc(ruleMeta[k].title)}</span>`).join('')}</div>${promptHtml(surface,rules)}<div class="r19-policy-actions"><button type="button" data-r19-go="WAYS_OF_WORKING">운영 규칙 수정</button>${surface==='REVIEW'?'<button type="button" data-r19-go="ONBOARDING">30-Day / Weekly Review 열기</button>':''}</div>`;
    return card;
  }
  function insertAfterSub(page,card){const sub=q(':scope > .sub',page); if(sub)sub.insertAdjacentElement('afterend',card); else page.prepend(card)}
  function ensureSurface(pageId,surface,subtitle){const page=q(`[data-page="${pageId}"]`);if(!page)return;const old=q(`[data-r19-surface="${surface}"]`,page);if(old)old.remove();insertAfterSub(page,makeCard(surface,subtitle))}
  function renderDecisionAudit(){
    const page=q('[data-page="DECISIONS"]');if(!page)return;let root=q('[data-r19-decision-audit]',page);if(!root){root=document.createElement('section');root.className='r19-policy-card';root.dataset.r19DecisionAudit='1';const anchor=q('[data-decisions-list]',page);anchor?.insertAdjacentElement('beforebegin',root)}
    const rules=activeRules();const arts=readArtifacts();const rows=Array.isArray(arts.DECISION_RIGHTS)?arts.DECISION_RIGHTS:[];
    const useOwner=rules.includes('owner'),useDebate=rules.includes('debate');
    const scored=rows.slice(-6).reverse();
    root.innerHTML=`<div class="r19-policy-head"><div><div class="r19-kicker">DECISION POLICY AUDIT</div><h2>Decision Rights가 팀의 Ways of Working을 지키는지 확인</h2><p>사람을 평가하지 않고 결정 구조의 누락만 확인합니다.</p></div><span class="r19-live-badge">${scored.length} DECISIONS</span></div>${scored.length?`<div class="r19-decision-grid">${scored.map(r=>{const owner=String(r.decide||'').trim();const review=String(r.dueDate||r.reviewDate||'').trim();const debate=String(r.input||r.recommend||'').trim();let gaps=[];if(useOwner&&!owner)gaps.push('D 미정');if(useOwner&&!review)gaps.push('Review date 미정');if(useDebate&&!debate)gaps.push('Input/Recommend 근거 미정');const cls=gaps.length?'r19-state-check':'r19-state-ok';return `<div class="r19-decision-row"><b>${esc(r.decision||'Decision')}</b><span>D · ${esc(owner||'미정')}</span><span>${esc(review||'Review 미정')}</span><span class="${cls}">${esc(gaps.join(' · ')||'POLICY OK')}</span></div>`}).join('')}</div>`:'<div class="r19-empty">Decision Rights Artifact를 만들면 Owner / Review / Debate 구조를 자동 점검합니다.</div>'}`;
  }
  function renderWeeklyLearning(){
    const host=q('[data-weekly-operating-review]'); if(!host)return; const shell=host.closest('.weekly-review-shell');if(!shell)return;let root=q('[data-r19-weekly-learning]');if(root)root.remove();root=document.createElement('section');root.className='r19-policy-card';root.dataset.r19WeeklyLearning='1';
    const rules=orderedRules('REVIEW');
    root.innerHTML=`<div class="r19-policy-head"><div><div class="r19-kicker">WEEKLY LEARNING POLICY</div><h2>이번 Review가 다음 행동까지 연결되는지 확인</h2><p>Ways of Working 규칙 중 Review에 영향을 주는 항목만 가져옵니다.</p></div><span class="r19-live-badge">${rules.length} RULES</span></div>${promptHtml('REVIEW',rules)}`;
    shell.insertAdjacentElement('beforebegin',root);
  }
  function renderWaysRuntime(){
    const page=q('[data-page="WAYS_OF_WORKING"]');if(!page)return;let old=q('[data-r19-runtime-board]',page);if(old)old.remove();const rules=activeRules();const op=q('.wow-operating-rules',page);const sec=op?.closest('.wow-section');if(!sec)return;const root=document.createElement('div');root.className='r19-runtime-board';root.dataset.r19RuntimeBoard='1';
    root.innerHTML=`<div class="r19-kicker">OPERATING RULES RUNTIME</div><div style="font-size:13px;font-weight:800;margin-top:4px">선택한 규칙이 실제 업무 화면에서 작동합니다.</div><div class="r19-rule-strip">${rules.length?rules.map(k=>`<span class="r19-rule-chip"><b>${esc(ruleMeta[k].label)}</b>${esc(ruleMeta[k].title)}</span>`).join(''):'<span class="r19-rule-chip">규칙을 선택하세요.</span>'}</div><div class="r19-runtime-grid">${Object.entries(surfaceLabels).map(([id,label])=>{const n=rules.filter(k=>ruleMeta[k].surfaces.includes(id)).length;return `<div class="r19-runtime-surface"><b>${esc(label)}</b><span>${n}개 규칙이 Context Coach에 반영됩니다.</span></div>`}).join('')}</div>`;
    sec.append(root);
  }
  function contextualTodaySubtitle(){const a=readArtifacts();const open=(Array.isArray(a.DECISION_RIGHTS)?a.DECISION_RIGHTS:[]).filter(r=>!['DECIDED','CANCELLED'].includes(String(r.decisionStatus||'OPEN').toUpperCase())).length;const commits=(Array.isArray(a.ONE_ON_ONE_COMMITMENT)?a.ONE_ON_ONE_COMMITMENT:[]).filter(r=>!['DONE','CANCELLED'].includes(String(r.status||'OPEN').toUpperCase())).length;return `현재 Context: 열린 Decision ${open}건 · 미완료 Operating Commitment ${commits}건. 규칙은 실제 우선순위를 보조하지만 자동으로 사람을 평가하거나 메시지를 보내지 않습니다.`}
  function bind(){
    qa('[data-r19-check]').forEach(el=>el.addEventListener('change',()=>{const [surface,rule]=String(el.dataset.r19Check||'').split(':');setChecked(surface,rule,el.checked);renderAll()}));
    qa('[data-r19-go]').forEach(b=>b.addEventListener('click',()=>go(b.dataset.r19Go)));
  }
  function renderAll(){
    runtime=readRuntime();
    ensureSurface('TODAY','TODAY',contextualTodaySubtitle());
    ensureSurface('ONE_ON_ONE','ONE_ON_ONE','대화 전에 질문·피드백·권한을 준비합니다. Private 1:1 내용을 다른 화면으로 자동 공유하지 않습니다.');
    ensureSurface('MEETINGS','MEETINGS','회의 목적과 종료 조건을 먼저 명확히 합니다. 토론과 결정이 섞일 때 생기는 운영 손실을 줄입니다.');
    ensureSurface('DECISIONS','DECISIONS','결정 전에 Debate의 흔적을 확인하고, 결정 후에는 D와 Review 시점을 남깁니다.');
    ensureSurface('REVIEW','REVIEW','회고는 평가가 아니라 Learning을 다음 Work / Priority로 옮기는 시간입니다.');
    renderDecisionAudit();renderWeeklyLearning();renderWaysRuntime();bind();
  }
  document.addEventListener('change',e=>{if(e.target?.matches?.('[data-wow-rule]')){const wow=readWow();const k=e.target.dataset.wowRule;wow.rules=e.target.checked?[...new Set([...(wow.rules||[]),k])]:(wow.rules||[]).filter(x=>x!==k);try{storage.setItem(WOW_KEY,JSON.stringify(wow))}catch{};setTimeout(renderAll,0)}});
  window.addEventListener('storage',e=>{if([WOW_KEY,RUNTIME_KEY,...ART_KEYS].includes(e.key))renderAll()});
  document.addEventListener('click',e=>{if(e.target?.closest?.('[data-weekly-review-save],[data-artifact-save],[data-artifact-confirm],[data-next60-checkin-save]'))setTimeout(renderAll,60)});
  renderAll();
  window.LeaderOsR19={render:renderAll,getActiveRules:activeRules,getRuntime:()=>readRuntime()};
})();
</script>
<script id="recovery-20-working-agreements">
(function(){
  const KEY='leader-os:team-working-agreements:v1';
  const WOW_KEY='leader-os:ways-of-working:v1';
  const ART_KEYS=['leader-os:operating-artifacts:v6','leader-os:operating-artifacts:v5','leader-os:operating-artifacts:v4','leader-os:operating-artifacts:v3'];
  const storage=window.__leaderOsStorage||localStorage;
  const q=(s,r=document)=>r.querySelector(s), qa=(s,r=document)=>[...r.querySelectorAll(s)];
  const esc=(v)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const safe=(raw,fb)=>{try{return raw?JSON.parse(raw):fb}catch{return fb}};
  const today=()=>{const d=new Date(); return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`};
  const RULES={
    solicit:{label:'ASK FIRST',title:'리더가 먼저 피드백 요청',desc:'피드백을 요구하기 전에 리더가 자신의 개선점부터 요청합니다.',meeting:'회의 말미에 리더가 “제가 다음 회의에서 바꾸면 좋을 한 가지?”를 묻습니다.'},
    specific:{label:'SPECIFIC',title:'행동 중심 피드백',desc:'성격이 아니라 상황·관찰·영향을 구체적으로 말합니다.',meeting:'피드백은 실제 발언·자료·결과처럼 관찰 가능한 근거로 말합니다.'},
    timely:{label:'TIMELY',title:'가까운 시점에 피드백',desc:'사실관계가 확인되면 너무 오래 미루지 않습니다.',meeting:'회의에서 확인된 이슈는 가장 가까운 적절한 대화 슬롯에 배치합니다.'},
    private:{label:'PRIVATE',title:'민감 피드백은 사적으로',desc:'민감한 개선 피드백은 공개 자리에서 다루지 않습니다.',meeting:'개인 개선 피드백은 회의 안건에서 분리해 1:1로 옮깁니다.'},
    debate:{label:'DEBATE≠DECIDE',title:'토론과 결정 분리',desc:'아이디어를 논의하는 시간과 최종 결정 순간을 구분합니다.',meeting:'Agenda에 DEBATE 구간과 DECISION 구간을 분리합니다.'},
    owner:{label:'OWNER',title:'Decision Owner + Review Date',desc:'최종 결정자 한 명과 다시 볼 시점을 명확히 합니다.',meeting:'종료 전에 D(최종 결정자), Decision, Review Date를 남깁니다.'},
    delegate:{label:'DELEGATE',title:'Guardrail + Authority',desc:'위임할 때 결과·제약·결정권·체크포인트를 함께 합의합니다.',meeting:'새 Action에는 Owner뿐 아니라 Authority와 Checkpoint도 확인합니다.'},
    learn:{label:'LEARN',title:'Debrief → Next Work',desc:'회고의 학습을 다음 업무나 우선순위로 옮깁니다.',meeting:'마지막 3분에 Keep / Change / Next를 기록하고 Next를 Work로 연결합니다.'}
  };
  const empty=()=>({workspaceId:'DEMO-WORKSPACE',agreements:[],reviews:[],context:{project:'Project Alpha',meetingType:'Decision Review'}});
  let store={...empty(),...safe(storage.getItem(KEY),{}) }; if(!Array.isArray(store.agreements))store.agreements=[]; if(!Array.isArray(store.reviews))store.reviews=[]; store.context={...empty().context,...(store.context||{})};
  const save=()=>{try{storage.setItem(KEY,JSON.stringify(store))}catch{}};
  const readWow=()=>({rules:[],...safe(storage.getItem(WOW_KEY),{})});
  const readArtifacts=()=>{for(const k of ART_KEYS){const raw=storage.getItem(k);if(raw)return safe(raw,{})}return {}};
  const activeStatus=(a)=>{if(a.status==='ARCHIVED')return 'ARCHIVED'; const n=today(); if(a.expiresAt && a.expiresAt<n)return 'EXPIRED'; if(a.startsAt && a.startsAt>n)return 'SCHEDULED'; return a.status||'DRAFT'};
  const confirmedActive=(a)=>activeStatus(a)==='CONFIRMED';
  const norm=(v)=>String(v||'').trim().toLowerCase();
  const applies=(a,ctx={})=>{if(!confirmedActive(a))return false;if(a.scope==='TEAM')return true;if(a.scope==='PROJECT')return norm(a.scopeValue)===norm(ctx.project);if(a.scope==='MEETING_TYPE')return norm(a.scopeValue)===norm(ctx.meetingType);return false};
  const applicable=(ctx)=>store.agreements.filter(a=>applies(a,ctx));
  const uniqRules=(agreements)=>{const scoped=agreements.filter(a=>a.scope!=='TEAM');const override=scoped.some(a=>a.scope==='PROJECT'&&a.inheritTeam===false);const source=override?scoped:agreements;const excluded=new Set(scoped.flatMap(a=>a.excludedRuleIds||[]));return [...new Set(source.flatMap(a=>a.ruleIds||[]).filter(id=>!excluded.has(id)))];};
  const uid=()=>`WA-${Date.now().toString(36)}-${Math.random().toString(36).slice(2,6)}`;
  const snapshot=(a)=>({version:a.version,status:a.status,name:a.name,scope:a.scope,scopeValue:a.scopeValue,ruleIds:[...(a.ruleIds||[])],exceptions:a.exceptions,startsAt:a.startsAt,expiresAt:a.expiresAt,rationale:a.rationale,updatedAt:a.updatedAt,confirmedAt:a.confirmedAt||null});
  function ensureNav(){
    const nav=q('[data-primary-nav]'); if(!nav)return; if(q('[data-fallback-page="TEAM_WORKING_AGREEMENT"]',nav))return;
    const wow=[...nav.querySelectorAll('a')].find(a=>/Ways of Working/i.test(a.textContent||'')); const section=wow?.closest('.nav-section')||nav.querySelectorAll('.nav-section')[2]||nav;
    const a=document.createElement('a');a.href='#team-working-agreement';a.dataset.fallbackPage='TEAM_WORKING_AGREEMENT';a.textContent='Team Working Agreement'; if(wow)wow.insertAdjacentElement('afterend',a);else section.append(a);
  }
  const page=q('[data-page="TEAM_WORKING_AGREEMENT"]'); if(!page)return;
  const form=q('[data-r20-form]',page), picker=q('[data-r20-rule-picker]',page), list=q('[data-r20-list]',page), stats=q('[data-r20-stats]',page), formStatus=q('[data-r20-form-status]',page);
  let editingId=null;
  const fields={name:q('[data-r20-name]',page),scope:q('[data-r20-scope]',page),scopeValue:q('[data-r20-scope-value]',page),startsAt:q('[data-r20-start]',page),expiresAt:q('[data-r20-expire]',page),rationale:q('[data-r20-rationale]',page),exceptions:q('[data-r20-exception]',page)};
  function renderPicker(selected=[]){const wow=readWow();const enabled=new Set(wow.rules||[]);picker.innerHTML=Object.entries(RULES).map(([id,m])=>`<label class="r20-rule-option ${enabled.has(id)?'':'r20-source-disabled'}"><input type="checkbox" data-r20-rule="${id}" ${selected.includes(id)?'checked':''}><span><b>${esc(m.label)} · ${esc(m.title)}</b><span>${esc(m.desc)}${enabled.has(id)?'':' · 개인 Ways of Working에서는 현재 비활성'}</span></span></label>`).join('')}
  const selectedRules=()=>qa('[data-r20-rule]:checked',picker).map(x=>x.dataset.r20Rule);
  function clearForm(){editingId=null;Object.values(fields).forEach(x=>{if(x)x.value=''});fields.scope.value='TEAM';fields.startsAt.value=today();renderPicker(readWow().rules||[]);q('[data-r20-save]',page).textContent='Draft 저장';formStatus.textContent='먼저 DRAFT로 저장됩니다. 팀의 운영 기준으로 사용하려면 Human Confirm이 필요합니다.'}
  function loadForm(a){editingId=a.id;fields.name.value=a.name||'';fields.scope.value=a.scope||'TEAM';fields.scopeValue.value=a.scopeValue||'';fields.startsAt.value=a.startsAt||'';fields.expiresAt.value=a.expiresAt||'';fields.rationale.value=a.rationale||'';fields.exceptions.value=a.exceptions||'';renderPicker(a.ruleIds||[]);q('[data-r20-save]',page).textContent=`v${a.version} 수정 저장`;formStatus.textContent=a.status==='CONFIRMED'?'Confirmed Agreement를 수정하면 새 버전 DRAFT가 되고 다시 Human Confirm이 필요합니다.':'DRAFT를 수정 중입니다.';window.scrollTo({top:page.offsetTop,behavior:'smooth'})}
  function statusClass(st){return st.toLowerCase()}
  function renderStats(){const counts={confirmed:0,draft:0,expired:0,review:store.reviews.length};store.agreements.forEach(a=>{const st=activeStatus(a);if(st==='CONFIRMED')counts.confirmed++;else if(st==='DRAFT'||st==='SCHEDULED')counts.draft++;else if(st==='EXPIRED')counts.expired++});stats.innerHTML=[["CONFIRMED",counts.confirmed],["DRAFT / SCHEDULED",counts.draft],["EXPIRED",counts.expired],["ADOPTION REVIEWS",counts.review]].map(([l,v])=>`<div class="r20-stat"><span>${l}</span><strong>${v}</strong></div>`).join('')}
  function renderList(){
    if(!store.agreements.length){list.innerHTML='<div class="r20-runtime-empty">아직 Working Agreement가 없습니다. 샘플을 채워 구조를 본 뒤 내 팀 기준으로 수정해보세요.</div>';return}
    list.innerHTML=store.agreements.slice().sort((a,b)=>(b.updatedAt||'').localeCompare(a.updatedAt||'')).map(a=>{const st=activeStatus(a);const sourceOff=(a.ruleIds||[]).filter(id=>!(readWow().rules||[]).includes(id));return `<article class="r20-agreement" data-r20-id="${esc(a.id)}" data-expired="${st==='EXPIRED'?1:0}"><div class="r20-agreement-head"><div><h3>${esc(a.name||'Untitled Agreement')}</h3><div class="r20-meta">${esc(a.scope)} · ${esc(a.scopeValue||'전체')} · v${a.version} · ${esc(a.startsAt||'시작 즉시')} → ${esc(a.expiresAt||'만료 없음')}</div></div><span class="r20-state ${statusClass(st)}">${st}</span></div><div class="r20-chiprow">${(a.ruleIds||[]).map(id=>`<span class="r20-chip">${esc(RULES[id]?.label||id)}</span>`).join('')}</div>${a.rationale?`<div class="r20-meta">WHY · ${esc(a.rationale)}</div>`:''}${a.exceptions?`<div class="r20-exception">EXCEPTION · ${esc(a.exceptions)}</div>`:''}${sourceOff.length?`<div class="r20-warn" style="margin-top:7px">참고: ${sourceOff.map(id=>RULES[id]?.label||id).join(', ')} 규칙은 개인 Ways of Working에서 현재 꺼져 있지만, Confirmed Team Agreement는 별도 합의로 유지됩니다.</div>`:''}<div class="r20-card-actions"><button type="button" data-r20-edit="${esc(a.id)}">수정</button>${st==='DRAFT'||st==='SCHEDULED'?`<button type="button" class="primary" data-r20-confirm="${esc(a.id)}">Human Confirm</button>`:''}${st!=='ARCHIVED'?`<button type="button" data-r20-archive="${esc(a.id)}">Archive</button>`:''}</div>${(a.history||[]).length?`<details class="r20-history"><summary>Version history ${a.history.length}</summary>${a.history.slice().reverse().map(h=>`<div class="r20-history-row">v${h.version} · ${esc(h.status)} · ${esc((h.updatedAt||'').replace('T',' ').slice(0,16))}</div>`).join('')}</details>`:''}</article>`}).join('');
    qa('[data-r20-edit]',list).forEach(b=>b.onclick=()=>loadForm(store.agreements.find(a=>a.id===b.dataset.r20Edit)));
    qa('[data-r20-confirm]',list).forEach(b=>b.onclick=()=>{const a=store.agreements.find(x=>x.id===b.dataset.r20Confirm);if(!a)return;a.status='CONFIRMED';a.confirmedAt=new Date().toISOString();a.updatedAt=a.confirmedAt;save();renderAll();emit()});
    qa('[data-r20-archive]',list).forEach(b=>b.onclick=()=>{const a=store.agreements.find(x=>x.id===b.dataset.r20Archive);if(!a)return;a.history=[...(a.history||[]),snapshot(a)];a.version=(a.version||1)+1;a.status='ARCHIVED';a.updatedAt=new Date().toISOString();save();renderAll();emit()});
  }
  function artifactOptions(){const a=readArtifacts(),rows=[];for(const [type,arr] of Object.entries(a)){if(!Array.isArray(arr))continue;for(const r of arr.slice(0,12)){const name=r.project||r.milestone||r.decision||r.task||r.title||r.priority1||r.person||r.id||type;rows.push({id:r.id||`${type}:${name}`,label:`${type} · ${name}`})}}return rows}
  function projectOptions(){const a=readArtifacts(),vals=new Set(['Project Alpha']);for(const r of (a.WORK_MAP||[]))if(r.project)vals.add(r.project);for(const r of (a.MILESTONES||[]))if(r.project)vals.add(r.project);for(const ag of store.agreements)if(ag.scope==='PROJECT'&&ag.scopeValue)vals.add(ag.scopeValue);return [...vals]}
  function renderContext(){const p=q('[data-r20-preview-project]',page),m=q('[data-r20-preview-meeting]',page);const projects=projectOptions();const pv=p.value||store.context.project||projects[0];p.innerHTML=projects.map(x=>`<option ${x===pv?'selected':''}>${esc(x)}</option>`).join('');m.value=store.context.meetingType||m.value||'Decision Review';store.context.project=p.value;store.context.meetingType=m.value;save();const contexts=[{label:'TEAM 기본',ctx:{}},{label:`PROJECT · ${p.value}`,ctx:{project:p.value}},{label:`MEETING · ${m.value}`,ctx:{meetingType:m.value}}];q('[data-r20-context-preview]',page).innerHTML=contexts.map(c=>{const aa=applicable(c.ctx),rr=uniqRules(aa);return `<div class="r20-context-card"><b>${esc(c.label)}</b><span>${aa.length?`${aa.length} Agreement · ${rr.map(id=>RULES[id]?.label||id).join(' / ')}`:'적용되는 Confirmed Agreement 없음'}</span></div>`}).join('')}
  function renderReviewSelectors(){const aSel=q('[data-r20-review-agreement]',page),rSel=q('[data-r20-review-rule]',page),artSel=q('[data-r20-review-artifact]',page);const confirmed=store.agreements.filter(a=>activeStatus(a)==='CONFIRMED');const prev=aSel.value;aSel.innerHTML='<option value="">Agreement 선택</option>'+confirmed.map(a=>`<option value="${esc(a.id)}" ${a.id===prev?'selected':''}>${esc(a.name)} · v${a.version}</option>`).join('');const ag=confirmed.find(a=>a.id===aSel.value)||confirmed[0];if(ag&&!aSel.value)aSel.value=ag.id;rSel.innerHTML=ag?(ag.ruleIds||[]).map(id=>`<option value="${id}">${esc(RULES[id]?.label||id)} · ${esc(RULES[id]?.title||'')}</option>`).join(''):'<option>Rule 없음</option>';artSel.innerHTML='<option value="">연결하지 않음</option>'+artifactOptions().slice(0,80).map(x=>`<option value="${esc(x.id)}">${esc(x.label)}</option>`).join('')}
  function renderReviews(){const root=q('[data-r20-review-list]',page);root.innerHTML=store.reviews.length?store.reviews.slice().reverse().slice(0,12).map(r=>{const ag=store.agreements.find(a=>a.id===r.agreementId);return `<div class="r20-review-item"><b>${esc(ag?.name||'Agreement')} · ${esc(RULES[r.ruleId]?.label||r.ruleId)} · ${esc(r.usefulness)}</b><span>Evidence · ${esc(r.evidence||r.artifactRef||'—')}</span><span>Outcome · ${esc(r.outcome||'—')}</span><span>Next · ${esc(r.recommendation)} · ${esc((r.createdAt||'').replace('T',' ').slice(0,16))}</span></div>`}).join(''):'<div class="r20-runtime-empty">아직 Adoption Review가 없습니다.</div>'}
  function renderAll(){ensureNav();renderStats();renderList();renderContext();renderReviewSelectors();renderReviews();renderRuntime()}
  form.addEventListener('submit',e=>{e.preventDefault();const data={name:fields.name.value.trim(),scope:fields.scope.value,scopeValue:fields.scopeValue.value.trim(),startsAt:fields.startsAt.value,expiresAt:fields.expiresAt.value,rationale:fields.rationale.value.trim(),exceptions:fields.exceptions.value.trim(),ruleIds:selectedRules()};if(!data.name||!data.ruleIds.length){formStatus.textContent='Agreement 이름과 최소 1개의 운영 규칙이 필요합니다.';return}if(data.scope!=='TEAM'&&!data.scopeValue){formStatus.textContent='PROJECT / MEETING TYPE 범위는 범위 값이 필요합니다.';return}const now=new Date().toISOString();if(editingId){const a=store.agreements.find(x=>x.id===editingId);if(!a)return;const before=JSON.stringify({name:a.name,scope:a.scope,scopeValue:a.scopeValue,startsAt:a.startsAt,expiresAt:a.expiresAt,rationale:a.rationale,exceptions:a.exceptions,ruleIds:a.ruleIds});const after=JSON.stringify(data);if(before!==after){a.history=[...(a.history||[]),snapshot(a)];Object.assign(a,data);a.version=(a.version||1)+1;a.status='DRAFT';a.confirmedAt=null;a.updatedAt=now;formStatus.textContent=`v${a.version} DRAFT로 저장했습니다. 다시 Human Confirm이 필요합니다.`}else formStatus.textContent='변경된 내용이 없습니다.'}else{store.agreements.push({id:uid(),...data,version:1,status:'DRAFT',history:[],createdAt:now,updatedAt:now,confirmedAt:null}) ;formStatus.textContent='v1 DRAFT로 저장했습니다. 팀 운영 기준으로 쓰기 전에 Human Confirm하세요.'}save();clearForm();renderAll();emit()});
  q('[data-r20-sample]',page).onclick=()=>{fields.name.value='Decision Meeting Working Agreement';fields.scope.value='MEETING_TYPE';fields.scopeValue.value='Decision Review';fields.startsAt.value=today();const d=new Date();d.setDate(d.getDate()+30);fields.expiresAt.value=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;fields.rationale.value='토론이 길어지고 최종 결정자와 다음 확인 시점이 불명확한 문제를 줄인다.';fields.exceptions.value='긴급 Incident 대응은 Incident Commander 프로토콜을 우선한다.';renderPicker(['debate','owner','learn']);formStatus.textContent='샘플을 불러왔습니다. 내 팀 상황에 맞게 수정한 뒤 Draft로 저장하세요.'};
  q('[data-r20-reset]',page).onclick=clearForm;
  q('[data-r20-preview-project]',page).onchange=()=>{store.context.project=q('[data-r20-preview-project]',page).value;save();renderContext();renderRuntime()};q('[data-r20-preview-meeting]',page).onchange=()=>{store.context.meetingType=q('[data-r20-preview-meeting]',page).value;save();renderContext();renderRuntime()};
  q('[data-r20-review-agreement]',page).onchange=renderReviewSelectors;
  q('[data-r20-review-form]',page).onsubmit=e=>{e.preventDefault();const agreementId=q('[data-r20-review-agreement]',page).value,ruleId=q('[data-r20-review-rule]',page).value;if(!agreementId||!ruleId)return;store.reviews.push({id:`WR-${Date.now().toString(36)}`,agreementId,ruleId,usefulness:q('[data-r20-usefulness]',page).value,evidence:q('[data-r20-review-evidence]',page).value.trim(),artifactRef:q('[data-r20-review-artifact]',page).value,outcome:q('[data-r20-review-outcome]',page).value.trim(),recommendation:q('[data-r20-recommendation]',page).value,createdAt:new Date().toISOString()});save();q('[data-r20-review-evidence]',page).value='';q('[data-r20-review-outcome]',page).value='';renderAll()};
  function runtimeCard(surface,title,ctx,extra=''){const aa=applicable(ctx),rr=uniqRules(aa);return `<section class="r20-runtime-card" data-r20-runtime="${surface}"><div class="r20-runtime-head"><div><div class="r20-kicker">TEAM WORKING AGREEMENT · LIVE</div><h2>${esc(title)}</h2><p>${aa.length?`${aa.length}개의 Confirmed Agreement가 현재 Context에 적용됩니다.`:'현재 Context에 적용되는 Confirmed Agreement가 없습니다.'}</p></div><button type="button" class="r20-link-btn" data-r20-go>Agreement 편집</button></div>${rr.length?`<div class="r20-runtime-list">${rr.slice(0,5).map(id=>`<div class="r20-runtime-rule"><b>${esc(RULES[id]?.label||id)}</b><span>${esc(RULES[id]?.desc||'')}</span></div>`).join('')}</div>`:'<div class="r20-runtime-empty">필요할 때만 팀 합의를 추가합니다. 모든 규칙을 항상 노출하지 않습니다.</div>'}${extra}</section>`}
  function place(pageId,html){const p=q(`[data-page="${pageId}"]`);if(!p)return;const old=q(`[data-r20-runtime]`,p);if(old)old.remove();const anchor=q('.r19-policy-card',p)||p.children[2]||p.firstElementChild;const temp=document.createElement('div');temp.innerHTML=html;const node=temp.firstElementChild;if(anchor)anchor.insertAdjacentElement('beforebegin',node);else p.prepend(node);q('[data-r20-go]',node)?.addEventListener('click',()=>{ensureNav();q('[data-fallback-page="TEAM_WORKING_AGREEMENT"]')?.click()})}
  function meetingExtra(){const ctx={meetingType:store.context.meetingType};const rr=uniqRules(applicable(ctx));const lines=rr.map(id=>`• ${RULES[id]?.meeting||RULES[id]?.desc||id}`);return `<div class="r20-runtime-tools"><label style="font-size:9px">회의 유형 <select data-r20-meeting-type>${['Weekly Priority','Decision Review','Project Review','Debrief'].map(x=>`<option ${x===store.context.meetingType?'selected':''}>${x}</option>`).join('')}</select></label><button type="button" class="r20-link-btn" data-r20-copy-meeting>Template 복사</button></div><div class="r20-meeting-template" data-r20-meeting-template>${lines.length?`MEETING PREFLIGHT · ${esc(store.context.meetingType)}\n${lines.map(esc).join('\n')}`:'이 회의 유형에 적용되는 Agreement가 없습니다.'}</div>`}
  function workExtra(){const projects=projectOptions();return `<div class="r20-runtime-tools"><label style="font-size:9px">Project <select data-r20-work-project>${projects.map(x=>`<option ${x===store.context.project?'selected':''}>${esc(x)}</option>`).join('')}</select></label></div>`}
  function renderRuntime(){place('TODAY',runtimeCard('TODAY','오늘 적용되는 팀 합의',{}));place('MEETINGS',runtimeCard('MEETINGS',`Meeting Agreement · ${store.context.meetingType}`,{meetingType:store.context.meetingType},meetingExtra()));place('WORK',runtimeCard('WORK',`Project Agreement · ${store.context.project}`,{project:store.context.project},workExtra()));qa('[data-r20-meeting-type]').forEach(s=>s.onchange=()=>{store.context.meetingType=s.value;save();renderContext();renderRuntime()});qa('[data-r20-work-project]').forEach(s=>s.onchange=()=>{store.context.project=s.value;save();renderContext();renderRuntime()});qa('[data-r20-copy-meeting]').forEach(b=>b.onclick=async()=>{const text=q('[data-r20-meeting-template]',b.closest('[data-r20-runtime]'))?.textContent||'';try{await navigator.clipboard.writeText(text)}catch{}})}
  function emit(){try{window.dispatchEvent(new CustomEvent('leader-os-working-agreements-changed',{detail:{agreements:store.agreements.length}}))}catch{}}
  window.addEventListener('storage',e=>{if([KEY,WOW_KEY,...ART_KEYS].includes(e.key)){store={...empty(),...safe(storage.getItem(KEY),{})};renderAll()}});document.addEventListener('change',e=>{if(e.target?.matches?.('[data-wow-rule]'))setTimeout(renderAll,20)});
  const obs=new MutationObserver(()=>ensureNav());obs.observe(q('[data-primary-nav]'),{childList:true,subtree:true});
  ensureNav();clearForm();renderAll();
  window.LeaderOsR20={getStore:()=>JSON.parse(JSON.stringify(store)),getApplicable:(ctx)=>applicable(ctx).map(a=>a.id),render:renderAll,activeStatus};
})();
</script>
<script id="recovery-21-runtime">
(()=>{
  const q=(s,r=document)=>r.querySelector(s), qa=(s,r=document)=>[...r.querySelectorAll(s)];
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const safe=(raw,fallback)=>{try{return raw?JSON.parse(raw):fallback}catch{return fallback}};
  const storage={getItem:k=>{try{return localStorage.getItem(k)}catch{return null}},setItem:(k,v)=>{try{localStorage.setItem(k,v)}catch{}}};
  const ON_KEY='leader-os:leader-onboarding:v1', WA_KEY='leader-os:team-working-agreements:v1', PROP_KEY='leader-os:working-agreement-proposals:v1', ACK_KEY='leader-os:working-agreement-onboarding:v1';
  const localScope=()=>{try{const x=window.LeaderOsReportRuntimeBridge?.state?.();return x?.signedIn&&x.userId&&x.workspaceId?`${x.userId}:${x.workspaceId}`:'guest'}catch{return'guest'}};
  const scopedOnKey=()=>`${ON_KEY}:${localScope()}`;
  const ART_KEYS=['leader-os:operating-artifacts:v6','leader-os:operating-artifacts:v5','leader-os:operating-artifacts:v4','leader-os:operating-artifacts:v3'];
  const RULES={ask:{label:'ASK FIRST',title:'먼저 피드백을 요청'},specific:{label:'SPECIFIC',title:'행동 중심 피드백'},private:{label:'PRIVATE',title:'민감 피드백은 사적으로'},debate:{label:'DEBATE ≠ DECIDE',title:'토론과 결정을 분리'},owner:{label:'OWNER + REVIEW',title:'결정자와 다음 확인 시점'},delegate:{label:'DELEGATE',title:'권한·가드레일·체크포인트'},learn:{label:'LEARN → NEXT',title:'회고를 다음 일로'},focus:{label:'FOCUS',title:'생각할 시간과 회의 없는 시간'}};
  const emptyOn=()=>({role:'TEAM_MANAGER',situation:'NEW_ROLE',teamName:'',manager:'',startDate:'',managerSync:'',question:'',lastStep:'CONTEXT',updatedAt:null});
  let onboarding={...emptyOn(),...safe(storage.getItem(scopedOnKey()),{})}, proposals=safe(storage.getItem(PROP_KEY),[]), ack=safe(storage.getItem(ACK_KEY),{});
  const readArtifacts=()=>{
    const live=window.LeaderOsOperatingArtifactBridge?.snapshot?.();
    if(live&&typeof live==='object')return live;
    for(const k of ART_KEYS){const raw=storage.getItem(k);if(raw)return safe(raw,{})}
    return {};
  };
  const readWA=()=>({...{agreements:[],reviews:[],context:{}},...safe(storage.getItem(WA_KEY),{})});
  const saveOn=()=>{onboarding.updatedAt=new Date().toISOString();storage.setItem(scopedOnKey(),JSON.stringify(onboarding))}; const saveProps=()=>storage.setItem(PROP_KEY,JSON.stringify(proposals)); const saveAck=()=>storage.setItem(ACK_KEY,JSON.stringify(ack));
  let onboardingServerVersion=0,onboardingServerScope=null,onboardingServerBusy=false;
  const runtimeState=()=>{try{return window.LeaderOsReportRuntimeBridge?.state?.()||{signedIn:false,userId:null,workspaceId:null}}catch{return{signedIn:false,userId:null,workspaceId:null}}};
  const serverScope=()=>{const x=runtimeState();return x.signedIn&&x.userId&&x.workspaceId?`${x.userId}|${x.workspaceId}`:null};
  const applyServerContext=(ctx)=>{
    if(!ctx||typeof ctx!=='object')return false;
    onboarding={...onboarding,
      role:ctx.role||onboarding.role||'TEAM_MANAGER',
      situation:ctx.situation||onboarding.situation||'NEW_ROLE',
      teamName:ctx.teamName??'',
      manager:ctx.manager??'',
      startDate:ctx.startDate??'',
      managerSync:ctx.managerSync??'',
      question:ctx.question??'',
      updatedAt:ctx.updatedAt||onboarding.updatedAt
    };
    try{storage.setItem(scopedOnKey(),JSON.stringify(onboarding))}catch{}
    renderOnboarding();
    try{window.LeaderOsR22?.render?.()}catch{}
    return true;
  };
  const syncContextToServer=async()=>{
    const state=runtimeState(),scope=serverScope();
    if(!scope||onboardingServerBusy)return null;
    onboardingServerBusy=true;
    try{
      const result=await window.LeaderOsReportRuntimeBridge.saveOnboardingContext({
        eventId:`ONBOARDING-CONTEXT-${Date.now().toString(36)}`,
        expectedVersion:onboardingServerVersion,
        role:onboarding.role,
        situation:onboarding.situation,
        teamName:onboarding.teamName,
        manager:onboarding.manager,
        startDate:onboarding.startDate,
        managerSync:onboarding.managerSync,
        question:onboarding.question
      });
      const record=result?.record||{};
      onboardingServerVersion=Number(record.version||onboardingServerVersion||0);
      onboardingServerScope=scope;
      onboarding.updatedAt=record.updated_at||record.updatedAt||onboarding.updatedAt||new Date().toISOString();
      try{storage.setItem(scopedOnKey(),JSON.stringify(onboarding))}catch{}
      try{window.dispatchEvent(new CustomEvent('leaderos:onboarding-context-changed'))}catch{}
      return record;
    }catch(error){
      if(String(error?.code||error?.message||error).includes('VERSION_CONFLICT')){
        onboardingServerScope=null;
        setTimeout(()=>hydrateContextFromServer(true),120);
      }
      return null;
    }finally{onboardingServerBusy=false}
  };
  const hydrateContextFromServer=async(force=false)=>{
    const scope=serverScope();
    if(!scope)return null;
    if(onboardingServerBusy)return null;
    if(!force&&onboardingServerScope===scope)return null;
    onboardingServerBusy=true;
    try{
      const response=await window.LeaderOsReportRuntimeBridge.onboardingContextStatus();
      const ctx=response?.onboardingContext||{};
      onboardingServerVersion=Number(ctx.version||0);
      onboardingServerScope=scope;
      const serverTime=ctx.updatedAt?new Date(ctx.updatedAt).getTime():0;
      const localTime=onboarding.updatedAt?new Date(onboarding.updatedAt).getTime():0;
      const localMeaningful=Boolean(onboarding.teamName||onboarding.manager||onboarding.question);
      if(onboardingServerVersion===0){
        if(localMeaningful){
          onboardingServerBusy=false;
          return syncContextToServer();
        }
      }else if(localTime>serverTime+1000&&localMeaningful){
        onboardingServerBusy=false;
        return syncContextToServer();
      }else{
        applyServerContext(ctx);
      }
      return ctx;
    }catch{return null}
    finally{onboardingServerBusy=false}
  };

  const array=(a,k)=>Array.isArray(a?.[k])?a[k]:[];
  function artifactReady(keys){const a=readArtifacts();return keys.some(k=>array(a,k).length>0)}
  const confirmedAgreements=()=>readWA().agreements.filter(a=>a.status==='CONFIRMED'&&(!a.startsAt||a.startsAt<=new Date().toISOString().slice(0,10))&&(!a.expiresAt||a.expiresAt>=new Date().toISOString().slice(0,10)));
  const gates=[
    {id:'CONTEXT',title:'역할과 기대',desc:'내 역할·상급자·30일 성공 기준을 먼저 맞춥니다.',ready:()=>!!(onboarding.teamName&&onboarding.manager),page:'LEADER_ONBOARDING',action:'Context 입력'},
    {id:'PEOPLE',title:'사람과 실제 역할',desc:'조직도보다 누가 무엇을 알고 누구에게 의존하는지 봅니다.',ready:()=>artifactReady(['TEAM_MAP']),page:'ONBOARDING',action:'Team Map'},
    {id:'RHYTHM',title:'팀의 시간 사용',desc:'반복 회의·1:1·마일스톤·결정 시점을 캘린더로 봅니다.',ready:()=>artifactReady(['TEAM_CALENDAR']),page:'ONBOARDING',action:'Calendar'},
    {id:'WORK',title:'일과 마일스톤',desc:'진행 중 Work와 다음 Milestone, 열린 Decision을 연결합니다.',ready:()=>artifactReady(['WORK_MAP'])&&artifactReady(['MILESTONES']),page:'ONBOARDING',action:'Work Map'},
    {id:'AUTHORITY',title:'결정과 위임',desc:'누가 결정하고 어디까지 위임되는지 불명확한 곳을 찾습니다.',ready:()=>artifactReady(['DECISION_RIGHTS'])&&artifactReady(['DELEGATION']),page:'DECISIONS',action:'Decision Rights'},
    {id:'AGREEMENT',title:'우리 팀의 일하는 방식',desc:'현재 Working Agreement를 먼저 읽고 필요할 때만 변경 제안합니다.',ready:()=>confirmedAgreements().length>0,page:'TEAM_WORKING_AGREEMENT',action:'Agreement'}
  ];
  function showPage(page){qa('[data-page]').forEach(x=>x.hidden=x.dataset.page!==page);qa('[data-primary-nav] a').forEach(a=>a.removeAttribute('aria-current'));const nav=q(`[data-fallback-page="${page}"]`)||q('[data-r21-onboarding-nav]');if(nav)nav.setAttribute('aria-current','page');const title=q('[data-topbar-title]');if(title)title.textContent=page==='LEADER_ONBOARDING'?'Leader Onboarding':(nav?.textContent?.trim()||page);window.scrollTo({top:0,behavior:'smooth'});}
  function ensureNav(){const nav=q('[data-primary-nav]');if(!nav)return;let a=q('[data-r21-onboarding-nav]',nav);if(!a){const today=q('[data-fallback-page="TODAY"]',nav);a=document.createElement('a');a.href='#leader-onboarding';a.dataset.r21OnboardingNav='';a.textContent='Leader Onboarding';today?today.insertAdjacentElement('afterend',a):nav.prepend(a)}a.onclick=e=>{e.preventDefault();e.stopImmediatePropagation();showPage('LEADER_ONBOARDING');renderOnboarding()}}
  function progress(){const done=gates.filter(g=>g.ready()).length;return {done,total:gates.length,pct:Math.round(done/gates.length*100),next:gates.find(g=>!g.ready())||null}}
  function renderOnboarding(){
    const page=q('[data-page="LEADER_ONBOARDING"]');if(!page)return;
    const p=progress();
    const progressBar=q('[data-r21-progress]',page),progressCopy=q('[data-r21-progress-copy]',page),grid=q('[data-r21-setup-grid]',page);
    if(progressBar)progressBar.style.width=`${p.pct}%`;
    if(progressCopy)progressCopy.textContent=`${p.done} / ${p.total} setup · ${p.pct}%`;
    if(grid)grid.innerHTML=gates.map((g,i)=>{const done=g.ready(),current=p.next?.id===g.id;return `<article class="r21-step ${done?'done':''} ${current?'current':''}"><div class="r21-step-top"><span class="r21-step-no">0${i+1} · ${g.id}</span><span class="r21-state">${done?'READY':current?'NEXT':'PENDING'}</span></div><h3>${esc(g.title)}</h3><p>${esc(g.desc)}</p><div class="r21-actions"><button type="button" ${g.page==='LEADER_ONBOARDING'?'data-r21-focus-context':''} data-r21-open="${g.page}">${esc(g.action)}</button>${!done&&g.page==='ONBOARDING'?`<button type="button" data-r21-open-quest="${[3,8,10,16,19][Math.max(0,i-1)]||1}">관련 Quest</button>`:''}</div></article>`}).join('');
    const title=q('[data-r21-resume-title]',page),copy=q('[data-r21-resume-copy]',page);
    if(title&&copy){if(p.next){title.textContent=`다음: ${p.next.title}`;copy.textContent=p.next.desc}else{title.textContent='기본 온보딩 Context가 준비되었습니다.';copy.textContent='이제 30-Day Quest에서 실제 업무 Evidence를 쌓으며 운영체계를 검증하세요.'}}
    const role=q('[data-r21-role]',page),situation=q('[data-r21-situation]',page),team=q('[data-r21-team-name]',page),manager=q('[data-r21-manager]',page),start=q('[data-r21-start-date]',page),sync=q('[data-r21-manager-sync]',page),question=q('[data-r21-question]',page);
    if(role)role.value=onboarding.role||'TEAM_MANAGER';if(situation)situation.value=onboarding.situation||'NEW_ROLE';if(team)team.value=onboarding.teamName||'';if(manager)manager.value=onboarding.manager||'';if(start)start.value=onboarding.startDate||'';if(sync)sync.value=onboarding.managerSync||'';if(question)question.value=onboarding.question||'';
    const firstWeek=q('[data-r21-first-week]',page);
    if(firstWeek){const fw=[['DAY 1','상급자 기대를 먼저 맞추기','“30일 뒤 제가 무엇을 만들면 잘 시작한 것입니까?”'],['DAY 2–3','팀원 1:1에서 Context 듣기','역할·장애물·반복되는 승인 요청을 기록'],['DAY 4','Team Calendar 보기','회의를 없애기 전에 왜 존재하는지 확인'],['DAY 5','Decision bottleneck 찾기','누가 결정하는지 모호한 3가지만 적기'],['WEEK 1 DEBRIEF','내 판단보다 UNKNOWN 확인','아직 모르는 것과 다음에 물어볼 것을 남기기']];firstWeek.innerHTML=fw.map(x=>`<div class="r21-step"><span class="r21-step-no">${x[0]}</span><h3>${x[1]}</h3><p>${x[2]}</p></div>`).join('')}
    renderAgreementPreview();
    qa('[data-r21-open]',page).forEach(b=>b.onclick=()=>{const dest=b.dataset.r21Open;if(dest==='LEADER_ONBOARDING'){q('[data-r21-context-form]',page)?.scrollIntoView({behavior:'smooth',block:'center'})}else{const a=q(`[data-fallback-page="${dest}"]`);a?a.click():showPage(dest)}});
    qa('[data-r21-open-quest]',page).forEach(b=>b.onclick=()=>openQuest(Number(b.dataset.r21OpenQuest)));
  }
  function renderAgreementPreview(){const root=q('[data-r21-onboarding-agreements]');if(!root)return;const rows=confirmedAgreements();root.innerHTML=rows.length?rows.slice(0,6).map(a=>`<div class="r21-agreement-card"><h4>${esc(a.name)}</h4><p>${esc(a.scope)} · ${esc(a.scopeValue||'전체')} · v${a.version}</p><div class="r21-rulechips">${(a.ruleIds||[]).map(id=>`<span class="r21-rulechip">${esc(RULES[id]?.label||id)}</span>`).join('')}</div></div>`).join(''):'<div class="r21-empty">아직 Confirmed Working Agreement가 없습니다. 새 팀이라면 첫 주 관찰 후 합의를 만들고, 기존 팀이라면 현재 규칙을 먼저 확인하세요.</div>'}
  function openQuest(day){const a=q('[data-onboarding-open]');a?.click();setTimeout(()=>{const target=q(`[data-quest-day="${day}"]`)||qa('[data-quest-item]')[day-1];target?.scrollIntoView({behavior:'smooth',block:'center'});target?.click?.()},80)}
  const page=q('[data-page="LEADER_ONBOARDING"]');if(page){const form=q('[data-r21-context-form]',page);form.onsubmit=e=>{e.preventDefault();onboarding={...onboarding,role:q('[data-r21-role]',page).value,situation:q('[data-r21-situation]',page).value,teamName:q('[data-r21-team-name]',page).value.trim(),manager:q('[data-r21-manager]',page).value.trim(),startDate:q('[data-r21-start-date]',page).value,managerSync:q('[data-r21-manager-sync]',page).value,question:q('[data-r21-question]',page).value.trim(),lastStep:'CONTEXT'};saveOn();const status=q('[data-r21-context-status]',page);if(status)status.textContent=runtimeState().signedIn?'브라우저 저장 완료 · Workspace 개인 Context 동기화 중…':'브라우저에 저장했습니다. 로그인하면 개인 Context가 Workspace에 동기화됩니다.';renderOnboarding();syncContextToServer().then(()=>{if(status&&runtimeState().signedIn)status.textContent='개인 Context를 Workspace에 저장했습니다.'});};q('[data-r21-context-sample]',page).onclick=()=>{q('[data-r21-role]',page).value='CREATIVE_DIRECTOR';q('[data-r21-situation]',page).value='INHERITED_TEAM';q('[data-r21-team-name]',page).value='Brand Experience Team';q('[data-r21-manager]',page).value='CMO';const t=new Date();q('[data-r21-start-date]',page).value=t.toISOString().slice(0,10);q('[data-r21-question]',page).value='실제 승인 병목과 팀원이 스스로 결정할 수 있는 범위를 먼저 알고 싶다.';q('[data-r21-context-status]',page).textContent='샘플은 저장되지 않았습니다. 내 상황에 맞게 수정하세요.'};q('[data-r21-resume]',page)?.addEventListener('click',()=>{const n=progress().next;n&&q(`[data-r21-open="${n.page}"]`,page)?.click()});q('[data-r21-go-quest]',page)?.addEventListener('click',()=>q('[data-onboarding-open]')?.click());qa('[data-r21-path]',page).forEach(b=>b.onclick=()=>{const v=b.dataset.r21Path;if(v==='DAY30')q('[data-onboarding-open]')?.click();else if(v==='WEEK1')openQuest(3);else q('[data-r21-context-form]',page)?.scrollIntoView({behavior:'smooth',block:'center'})});}
  // Convenience: Today resume banner.
  function renderTodayBanner(){const today=q('[data-page="TODAY"]');if(!today)return;let b=q('[data-r21-today-banner]',today);if(!b){b=document.createElement('section');b.className='r21-banner';b.dataset.r21TodayBanner='';const anchor=today.querySelector('h1')?.nextElementSibling||today.firstElementChild;anchor?.insertAdjacentElement('afterend',b)}const p=progress();b.innerHTML=`<div class="r21-banner-copy"><strong>${p.done===p.total?'온보딩 기본 세팅 완료':`Leader Onboarding · ${p.done}/${p.total}`}</strong><span>${p.next?`다음 권장: ${esc(p.next.title)} · ${esc(p.next.desc)}`:'30-Day Quest에서 실제 Evidence로 운영 방식을 검증하세요.'}</span></div><button type="button" class="r21-inline-btn" data-r21-today-open>${p.next?'이어하기':'30-Day Quest'}</button>`;q('[data-r21-today-open]',b).onclick=()=>{if(p.next){showPage('LEADER_ONBOARDING');renderOnboarding()}else q('[data-onboarding-open]')?.click()}}

  // Working Agreement change proposal / team review / evidence inspector.
  const waPage=q('[data-page="TEAM_WORKING_AGREEMENT"]');
  function waStore(){return readWA()} function writeWA(st){storage.setItem(WA_KEY,JSON.stringify(st));try{window.LeaderOsR20?.render?.()}catch{}window.dispatchEvent(new Event('storage'))}
  function renderRulePicker(root,selected=[]){if(!root)return;root.innerHTML=Object.entries(RULES).map(([id,m])=>`<label class="r21-rule-option"><input type="checkbox" value="${id}" ${selected.includes(id)?'checked':''}><span><b>${esc(m.label)}</b><br><span>${esc(m.title)}</span></span></label>`).join('')}
  function selected(root){return qa('input[type=checkbox]:checked',root).map(x=>x.value)}
  function snapshot(a){return {version:a.version,status:a.status,name:a.name,scope:a.scope,scopeValue:a.scopeValue,ruleIds:[...(a.ruleIds||[])],excludedRuleIds:[...(a.excludedRuleIds||[])],inheritTeam:a.inheritTeam!==false,exceptions:a.exceptions,startsAt:a.startsAt,expiresAt:a.expiresAt,rationale:a.rationale,updatedAt:a.updatedAt,confirmedAt:a.confirmedAt||null}}
  function renderProposalControls(){if(!waPage)return;const st=waStore(),sel=q('[data-r21-proposal-agreement]',waPage),insp=q('[data-r21-inspector-agreement]',waPage);const conf=st.agreements.filter(a=>a.status==='CONFIRMED');const opts='<option value="">Agreement 선택</option>'+conf.map(a=>`<option value="${esc(a.id)}">${esc(a.name)} · ${esc(a.scope)} · v${a.version}</option>`).join('');const pv=sel.value,iv=insp.value;sel.innerHTML=opts;insp.innerHTML=opts;if(conf.some(a=>a.id===pv))sel.value=pv;if(conf.some(a=>a.id===iv))insp.value=iv;renderProposalList();renderInspector();renderMemberProjects()}
  function loadProposalAgreement(id){const a=waStore().agreements.find(x=>x.id===id);renderRulePicker(q('[data-r21-proposal-rules]',waPage),a?.ruleIds||[]);renderRulePicker(q('[data-r21-exclude-rules]',waPage),a?.excludedRuleIds||[]);q('[data-r21-inheritance]',waPage).value=a?.inheritTeam===false?'OVERRIDE':'INHERIT'}
  function renderProposalList(){const root=q('[data-r21-proposal-list]',waPage);if(!root)return;root.innerHTML=proposals.length?proposals.slice().reverse().map(p=>`<article class="r21-proposal"><div class="r21-proposal-head"><h3>${esc(p.agreementName||'Agreement')} · v${p.baseVersion} → proposed</h3><span class="r21-proposal-status ${String(p.status).toLowerCase()}">${esc(p.status)}</span></div><p><b>WHY</b> · ${esc(p.reason||'—')}<br><b>QUESTION</b> · ${esc(p.question||'—')}<br><b>RULES</b> · ${(p.ruleIds||[]).map(id=>esc(RULES[id]?.label||id)).join(' / ')||'—'}${p.excludedRuleIds?.length?`<br><b>EXCLUDE</b> · ${p.excludedRuleIds.map(id=>esc(RULES[id]?.label||id)).join(' / ')}`:''}</p>${p.reviewNote?`<div class="r21-review-notice">TEAM REVIEW · ${esc(p.reviewNote)}</div>`:''}<div class="r21-actions">${p.status==='PROPOSED'?`<button type="button" data-r21-review-proposal="${esc(p.id)}">팀 검토 기록</button>`:''}${p.status==='REVIEWED'?`<button type="button" class="primary" data-r21-apply-proposal="${esc(p.id)}">Human Confirm & Apply</button>`:''}${!['APPLIED','REJECTED'].includes(p.status)?`<button type="button" data-r21-reject-proposal="${esc(p.id)}">Reject</button>`:''}</div></article>`).join(''):'<div class="r21-empty">아직 Change Proposal이 없습니다.</div>';qa('[data-r21-review-proposal]',root).forEach(b=>b.onclick=()=>{const note=prompt('팀 검토에서 나온 우려/보완점/지지 근거를 짧게 기록하세요.','실제 업무에 적용해 1주 후 Adoption Review로 확인하기');if(note===null)return;const p=proposals.find(x=>x.id===b.dataset.r21ReviewProposal);p.reviewNote=note;p.status='REVIEWED';p.reviewedAt=new Date().toISOString();saveProps();renderProposalList();renderInspector()});qa('[data-r21-apply-proposal]',root).forEach(b=>b.onclick=()=>applyProposal(b.dataset.r21ApplyProposal));qa('[data-r21-reject-proposal]',root).forEach(b=>b.onclick=()=>{const p=proposals.find(x=>x.id===b.dataset.r21RejectProposal);p.status='REJECTED';p.closedAt=new Date().toISOString();saveProps();renderProposalList();renderInspector()})}
  function applyProposal(id){const p=proposals.find(x=>x.id===id);if(!p||p.status!=='REVIEWED')return;const st=waStore(),a=st.agreements.find(x=>x.id===p.agreementId);if(!a)return;if((a.version||1)!==p.baseVersion){alert(`현재 Agreement가 v${a.version}로 변경되어 Proposal 기준 v${p.baseVersion}와 다릅니다. 새 Proposal을 만들어주세요.`);return}a.history=[...(a.history||[]),snapshot(a)];a.version=(a.version||1)+1;a.ruleIds=[...(p.ruleIds||[])];a.excludedRuleIds=[...(p.excludedRuleIds||[])];a.inheritTeam=p.inheritance!=='OVERRIDE';a.rationale=p.reason||a.rationale;a.status='CONFIRMED';a.updatedAt=new Date().toISOString();a.confirmedAt=a.updatedAt;p.status='APPLIED';p.appliedVersion=a.version;p.appliedAt=a.updatedAt;saveProps();writeWA(st);setTimeout(()=>{renderProposalControls();renderOnboarding();renderTodayBanner()},30)}
  function renderInspector(){const root=q('[data-r21-inspector]',waPage),id=q('[data-r21-inspector-agreement]',waPage)?.value;if(!root)return;const st=waStore(),a=st.agreements.find(x=>x.id===id);if(!a){root.innerHTML='<div class="r21-empty">Agreement를 선택하면 Version·Review·Proposal 근거를 보여줍니다.</div>';return}const rev=(st.reviews||[]).filter(r=>r.agreementId===id);const prop=proposals.filter(p=>p.agreementId===id);root.innerHTML=`<div class="r21-evidence"><b>CURRENT · v${a.version} · ${esc(a.status)}</b><br>Scope: ${esc(a.scope)} · ${esc(a.scopeValue||'전체')}<br>Inheritance: ${a.inheritTeam===false?'OVERRIDE':'INHERIT'}${a.excludedRuleIds?.length?` · Exclude ${a.excludedRuleIds.map(x=>esc(RULES[x]?.label||x)).join(', ')}`:''}<br>WHY: ${esc(a.rationale||'—')}</div>${(a.history||[]).slice().reverse().map(h=>`<div class="r21-evidence"><b>HISTORY · v${h.version} · ${esc(h.status)}</b><br>${esc((h.updatedAt||'').replace('T',' ').slice(0,16))} · ${(h.ruleIds||[]).map(x=>esc(RULES[x]?.label||x)).join(' / ')}</div>`).join('')}${rev.map(r=>`<div class="r21-evidence"><b>ADOPTION REVIEW · ${esc(r.usefulness)}</b><br>${esc(r.evidence||'—')} → ${esc(r.outcome||'—')} · ${esc(r.recommendation||'')}</div>`).join('')}${prop.map(p=>`<div class="r21-evidence"><b>CHANGE PROPOSAL · ${esc(p.status)}</b><br>${esc(p.reason||'—')} ${p.reviewNote?`<br>Review: ${esc(p.reviewNote)}`:''}</div>`).join('')}`}
  function renderMemberProjects(){const sel=q('[data-r21-member-project]',waPage);if(!sel)return;const vals=new Set(['Team only']);for(const a of confirmedAgreements())if(a.scope==='PROJECT'&&a.scopeValue)vals.add(a.scopeValue);sel.innerHTML=[...vals].map(v=>`<option>${esc(v)}</option>`).join('')}
  function effectiveAgreements(project){const all=confirmedAgreements(),team=all.filter(a=>a.scope==='TEAM'),proj=project&&project!=='Team only'?all.filter(a=>a.scope==='PROJECT'&&String(a.scopeValue).toLowerCase()===String(project).toLowerCase()):[];const override=proj.some(a=>a.inheritTeam===false);return override?proj:[...team,...proj]}
  function effectiveRules(project){const ags=effectiveAgreements(project),scoped=ags.filter(a=>a.scope==='PROJECT'),excluded=new Set(scoped.flatMap(a=>a.excludedRuleIds||[]));return [...new Set(ags.flatMap(a=>a.ruleIds||[]).filter(x=>!excluded.has(x)))]}
  function renderMemberChecklist(){const root=q('[data-r21-member-checklist]',waPage);if(!root)return;const name=q('[data-r21-member-name]',waPage).value.trim()||'새 팀원',project=q('[data-r21-member-project]',waPage).value,rules=effectiveRules(project),key=`${name}::${project}`,saved=ack[key]||{checks:[],question:''};root.innerHTML=rules.length?`<div class="r21-onboard-summary"><b>${esc(name)} · ${esc(project)}</b><br>아래 내용은 사람 평가 기준이 아니라, 함께 일할 때 서로 예측 가능하도록 만든 팀 약속입니다.</div>`+rules.map(id=>`<label class="r21-check"><input type="checkbox" value="${id}" ${saved.checks?.includes(id)?'checked':''}><span><b>${esc(RULES[id]?.label||id)}</b> · ${esc(RULES[id]?.title||'')}</span></label>`).join(''):'<div class="r21-empty">이 Context에 적용되는 Confirmed Agreement가 없습니다.</div>'}
  if(waPage){const pform=q('[data-r21-proposal-form]',waPage);renderRulePicker(q('[data-r21-proposal-rules]',waPage),[]);renderRulePicker(q('[data-r21-exclude-rules]',waPage),[]);pform.onsubmit=e=>{e.preventDefault();const agreementId=q('[data-r21-proposal-agreement]',waPage).value,a=waStore().agreements.find(x=>x.id===agreementId);if(!a){alert('Confirmed Agreement를 선택하세요.');return}const reason=q('[data-r21-proposal-reason]',waPage).value.trim();if(!reason){alert('변경 이유를 적어주세요.');return}const now=new Date().toISOString();proposals.push({id:`CP-${Date.now().toString(36)}`,agreementId,agreementName:a.name,baseVersion:a.version,reason,question:q('[data-r21-proposal-question]',waPage).value.trim(),inheritance:q('[data-r21-inheritance]',waPage).value,ruleIds:selected(q('[data-r21-proposal-rules]',waPage)),excludedRuleIds:selected(q('[data-r21-exclude-rules]',waPage)),status:'PROPOSED',createdAt:now});saveProps();q('[data-r21-proposal-reason]',waPage).value='';q('[data-r21-proposal-question]',waPage).value='';renderProposalList();renderInspector()};q('[data-r21-proposal-agreement]',waPage).onchange=e=>loadProposalAgreement(e.target.value);q('[data-r21-inspector-agreement]',waPage).onchange=renderInspector;q('[data-r21-member-generate]',waPage).onclick=renderMemberChecklist;q('[data-r21-member-project]',waPage).onchange=renderMemberChecklist;q('[data-r21-member-save]',waPage).onclick=()=>{const name=q('[data-r21-member-name]',waPage).value.trim()||'새 팀원',project=q('[data-r21-member-project]',waPage).value,key=`${name}::${project}`;ack[key]={checks:qa('[data-r21-member-checklist] input:checked',waPage).map(x=>x.value),question:q('[data-r21-member-question]',waPage).value.trim(),updatedAt:new Date().toISOString()};saveAck();q('[data-r21-member-question]',waPage).value='';renderMemberChecklist()};renderProposalControls()}
  // First-run assist without blocking the app.
  function maybeFirstRun(){if(!onboarding.updatedAt&&!location.hash){setTimeout(()=>{renderTodayBanner()},120)}}
  // Events and observers.
  document.addEventListener('click',e=>{const a=e.target.closest?.('[data-r21-onboarding-nav]');if(a){e.preventDefault();e.stopImmediatePropagation();showPage('LEADER_ONBOARDING');renderOnboarding()}},true);
  window.addEventListener('storage',()=>{onboarding={...emptyOn(),...safe(storage.getItem(ON_KEY),{})};proposals=safe(storage.getItem(PROP_KEY),[]);ack=safe(storage.getItem(ACK_KEY),{});renderOnboarding();renderTodayBanner();renderProposalControls()});
  window.addEventListener('leader-os-working-agreements-changed',()=>{renderOnboarding();renderTodayBanner();renderProposalControls()});
  window.addEventListener('leaderos:artifacts-changed',()=>{renderOnboarding();renderTodayBanner()});
  let r21Scope=localScope();
  setInterval(()=>{const next=localScope();if(next===r21Scope)return;r21Scope=next;onboarding={...emptyOn(),...safe(storage.getItem(scopedOnKey()),{})};onboardingServerVersion=0;onboardingServerScope=null;renderOnboarding();renderTodayBanner();setTimeout(()=>hydrateContextFromServer(true),80)},1200);
  Object.defineProperty(window,'LeaderOsOnboardingContextBridge',{
    value:{
      get:()=>JSON.parse(JSON.stringify(onboarding)),
      hydrate:()=>hydrateContextFromServer(true),
      sync:()=>syncContextToServer(),
      apply:(ctx)=>applyServerContext(ctx),
      state:()=>({serverVersion:onboardingServerVersion,serverScope:onboardingServerScope})
    },
    enumerable:false,configurable:true
  });
  setTimeout(()=>hydrateContextFromServer(false),1700);
  const obs=new MutationObserver(()=>ensureNav());const nav=q('[data-primary-nav]');if(nav)obs.observe(nav,{childList:true,subtree:true});ensureNav();renderOnboarding();renderTodayBanner();maybeFirstRun();
  window.LeaderOsR21={showOnboarding:()=>{showPage('LEADER_ONBOARDING');renderOnboarding()},progress,proposals:()=>JSON.parse(JSON.stringify(proposals)),effectiveRules};
})();
</script>
<script id="recovery-22-runtime">
(()=>{
  'use strict';
  const q=(s,r=document)=>r.querySelector(s), qa=(s,r=document)=>[...r.querySelectorAll(s)];
  const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const safe=(raw,fallback)=>{try{return raw?JSON.parse(raw):fallback}catch{return fallback}};
  const ON='leader-os:leader-onboarding:v1', R22='leader-os:leader-onboarding:r22:v1', CAL='leader-os:onboarding-calendar-draft:v1', TOP3='leader-os:onboarding-today-top3:v1', PROP='leader-os:working-agreement-proposals:v1', COMMENTS='leader-os:working-agreement-comments:v1';
  const localScope=()=>{try{const x=window.LeaderOsReportRuntimeBridge?.state?.();return x?.signedIn&&x.userId&&x.workspaceId?`${x.userId}:${x.workspaceId}`:'guest'}catch{return'guest'}};
  const PERSONAL_KEYS=new Set([ON,R22,CAL,TOP3]);
  const scoped=k=>PERSONAL_KEYS.has(k)?`${k}:${localScope()}`:k;
  const get=k=>{try{return localStorage.getItem(scoped(k))}catch{return null}}, set=(k,v)=>{try{localStorage.setItem(scoped(k),v)}catch{}};
  const ROLE={
    TEAM_MANAGER:{name:'Team Manager',focus:'사람·우선순위·결정·위임의 기본 운영 루프',manager:['첫 30일이 잘 됐다고 판단할 3가지 결과는 무엇인가요?','제가 반드시 직접 결정해야 하는 것과 팀에 맡겨도 되는 것은 무엇인가요?','상급자에게 어떤 주기로 어떤 형식의 보고를 원하시나요?','현재 팀에서 절대 놓치면 안 되는 관계·리스크·약속이 있나요?','첫 30일 동안 바꾸지 말아야 할 것이 있다면 무엇인가요?'],one:['지금 실제로 가장 많은 시간을 쓰는 일은 무엇인가요?','업무가 자주 멈추는 지점은 어디인가요?','제 승인 없이 스스로 결정할 수 있으면 좋은 것은 무엇인가요?','우리 팀에서 잘 작동하니 유지했으면 하는 방식은 무엇인가요?','제가 리더로서 가장 먼저 도와주면 좋은 것은 무엇인가요?'],calendar:['Weekly Priority','1:1','Decision Review','Milestone Review','Debrief']},
    MARKETING_LEADER:{name:'Marketing Leader',focus:'브랜드·퍼포먼스·채널·예산의 의사결정 흐름',manager:['이번 분기 마케팅에서 가장 중요한 Business Outcome은 무엇인가요?','브랜드와 단기 성과가 충돌할 때 최종 판단 기준은 무엇인가요?','예산 변경 권한은 어느 범위까지 팀에 위임할 수 있나요?','CEO/CBO에게 반드시 보이는 KPI와 숨은 선행지표는 무엇인가요?','캠페인 실패보다 더 큰 리스크로 보는 것은 무엇인가요?'],one:['지금 담당 채널/브랜드에서 가장 중요한 목표는 무엇인가요?','성과를 막는 데이터·승인·소재 병목은 무엇인가요?','예산·소재·타겟 중 스스로 결정 가능한 범위는 어디까지인가요?','최근 잘된 캠페인의 반복 가능한 이유는 무엇이라고 보나요?','다음 2주 안에 리더가 없애주면 좋은 장애물은 무엇인가요?'],calendar:['Campaign Review','Creative Review','Budget Decision','CRM / Channel Review','Weekly Learning']},
    CREATIVE_DIRECTOR:{name:'Creative Director',focus:'품질 기준·리뷰·승인·제작 리듬을 명확히',manager:['이 조직에서 “좋은 크리에이티브”의 최종 판단 기준은 무엇인가요?','클라이언트/경영진/팀의 의견이 충돌할 때 최종 결정자는 누구인가요?','제가 독립적으로 결정해도 되는 비주얼·예산·외주 범위는 어디까지인가요?','반드시 지켜야 할 브랜드/품질 Guardrail은 무엇인가요?','첫 30일 안에 개선을 기대하는 제작 병목이 있나요?'],one:['현재 가장 많은 재작업이 생기는 단계는 어디인가요?','좋은 결과를 만들기 위해 반드시 필요한 Context는 무엇인가요?','리뷰에서 가장 애매한 기준은 무엇인가요?','제가 승인자가 아니라 코치가 되어야 하는 영역은 어디인가요?','팀이 더 독립적으로 판단하려면 어떤 기준이 필요할까요?'],calendar:['Creative Review','Concept Lock','Client Review','Production Milestone','Retrospective']},
    PRODUCT_LEAD:{name:'Product Lead',focus:'문제·로드맵·Discovery/Delivery·결정권 정렬',manager:['이번 분기의 Product Outcome과 비협상 지표는 무엇인가요?','Roadmap 우선순위를 바꿀 수 있는 Evidence는 무엇인가요?','Product/Design/Engineering 간 최종 결정권은 어떻게 나뉘나요?','Discovery와 Delivery 중 현재 가장 취약한 쪽은 어디인가요?','첫 30일 동안 사용자/고객에게 직접 확인해야 할 것은 무엇인가요?'],one:['현재 팀이 풀고 있다고 생각하는 가장 중요한 문제는 무엇인가요?','Roadmap에서 실제로 확신이 낮은 항목은 무엇인가요?','결정이 늦어지는 인터페이스는 Product/Design/Engineering 중 어디인가요?','더 빠르게 학습하려면 어떤 Evidence가 필요할까요?','제가 없더라도 팀이 결정할 수 있어야 하는 것은 무엇인가요?'],calendar:['Roadmap Review','Discovery Review','Delivery Milestone','Decision Review','Retro']}
  };
  const SITUATION={
    NEW_ROLE:{name:'새 팀장',principle:'처음 7일은 바꾸기보다 관찰과 기대 정렬',steps:['상급자와 30일 성공 기준 맞추기','팀원 1:1에서 실제 역할·장애물 듣기','반복 회의와 Decision flow 관찰','Top 3 Priority를 임시로 명시','Week 1 Debrief에서 UNKNOWN 남기기'],watch:['첫인상만으로 사람을 분류하지 않기','기존 회의를 이유 없이 바로 없애지 않기','모든 결정을 내가 가져오지 않기']},
    INHERITED_TEAM:{name:'기존 팀 인수',principle:'READ → OBSERVE → ASK → PROPOSE 순서를 지킴',steps:['기존 Working Agreement와 최근 Review 읽기','팀원에게 “무엇을 유지해야 하는가” 질문','기존 Calendar와 승인 병목 관찰','바꾸고 싶은 것은 Change Proposal로 분리','첫 주에는 현 운영의 이유를 설명할 수 있게 만들기'],watch:['전임 리더와 비교하는 언어 피하기','첫날부터 기존 규칙을 덮어쓰지 않기','문제를 개인 성향으로 추정하지 않기']},
    REORG:{name:'조직개편',principle:'역할보다 인터페이스와 결정 공백을 먼저 봄',steps:['변경된 역할/팀 경계 FACT와 UNKNOWN 분리','누가 누구에게 의존하는지 Team Map 작성','중복·공백 Decision owner 찾기','30일 임시 운영 리듬 합의','변경된 책임을 1:1로 재확인'],watch:['조직도만 보고 실제 책임을 가정하지 않기','두 사람이 같은 결정을 가진 상태 방치하지 않기','개편 중 모든 업무를 정상 운영처럼 요구하지 않기']},
    RECOVERY:{name:'위기/문제 수습',principle:'Stabilize → Clarify → Decide → Recover',steps:['오늘 반드시 지켜야 할 Outcome 하나 정하기','Critical Work / Owner / Deadline 확인','열린 Decision과 Escalation path 확정','중단할 일과 보호할 시간을 명시','48시간 단위 Debrief로 회복 계획 수정'],watch:['원인 규명 전에 사람 책임부터 묻지 않기','긴급함 때문에 Decision owner를 생략하지 않기','모든 일을 동시에 살리려 하지 않기']}
  };
  let extras=safe(get(R22),{prepEvidence:'',lastGeneratedAt:null,top3:[]}), cal=safe(get(CAL),{raw:'',rows:[],savedAt:null}), comments=safe(get(COMMENTS),{});
  const readOn=()=>({role:'TEAM_MANAGER',situation:'NEW_ROLE',teamName:'',manager:'',...safe(get(ON),{})});
  function classifyCalendar(line){const s=line.toLowerCase();let type='RITUAL';if(/1:1|one.?on.?one/.test(s))type='1:1';else if(/milestone|lock|launch|delivery|deadline|마일스톤|런칭|납품/.test(s))type='MILESTONE';else if(/decision|approve|budget|결정|승인|예산/.test(s))type='DECISION';else if(/client|customer|partner|external|고객|클라이언트|파트너/.test(s))type='EXTERNAL';else if(/debrief|retro|retrospective|회고|복기/.test(s))type='DEBRIEF';return {raw:line.trim(),type}}
  function current(){const base=readOn(),roleValue=q('[data-r21-role]')?.value||base.role,situationValue=q('[data-r21-situation]')?.value||base.situation;const o={...base,role:roleValue,situation:situationValue};return {o,role:ROLE[o.role]||ROLE.TEAM_MANAGER,sit:SITUATION[o.situation]||SITUATION.NEW_ROLE}}
  function listHtml(items){return items.map((x,i)=>`<div class="r22-item"><span class="r22-item-no">${String(i+1).padStart(2,'0')}</span><div><b>${esc(x)}</b></div></div>`).join('')}
  function renderPersonalized(){const root=q('[data-r22-personalized]');if(!root)return;const {o,role,sit}=current();q('[data-r22-context-strip]',root).innerHTML=`<span class="r22-context-pill"><strong>${esc(role.name)}</strong> · ${esc(role.focus)}</span><span class="r22-context-pill"><strong>${esc(sit.name)}</strong> · ${esc(sit.principle)}</span>${o.teamName?`<span class="r22-context-pill">TEAM · <strong>${esc(o.teamName)}</strong></span>`:''}${o.manager?`<span class="r22-context-pill">MANAGER · <strong>${esc(o.manager)}</strong></span>`:''}`;q('[data-r22-first7]',root).innerHTML=listHtml(sit.steps.map((s,i)=>i===1?`${s} · ${role.focus}`:s));q('[data-r22-manager-questions]',root).innerHTML=listHtml(role.manager);q('[data-r22-watchouts]',root).innerHTML=sit.watch.map((x,i)=>`<div class="r22-question r22-warning"><b>${i+1}.</b> ${esc(x)}</div>`).join('')}
  function render1on1(){const {o,role,sit}=current(),root=q('[data-r22-1on1-questions]');if(!root)return;q('[data-r22-1on1-meta]').innerHTML=`<span class="r22-tag">${esc(role.name)}</span><span class="r22-tag">${esc(sit.name)}</span><span class="r22-tag">ASK & LISTEN</span>`;root.innerHTML=listHtml(role.one);q('[data-r22-1on1-evidence]').value=extras.prepEvidence||''}
  function renderCalendar(){const root=q('[data-r22-calendar-preview]');if(!root)return;q('[data-r22-calendar-input]').value=cal.raw||'';root.innerHTML=cal.rows?.length?cal.rows.map(r=>`<div class="r22-calendar-row"><span class="r22-calendar-type">${esc(r.type)}</span><b>${esc(r.raw)}</b><span>${cal.savedAt?'DRAFT':'PREVIEW'}</span></div>`).join(''):'<div class="r21-empty">일정을 붙여 넣고 “분류하기”를 누르면 팀의 시간 사용이 보입니다.</div>';q('[data-r22-calendar-status]').textContent=cal.savedAt?`온보딩 Draft 저장됨 · ${new Date(cal.savedAt).toLocaleString('ko-KR')}`:'Sample은 자동 저장하지 않습니다. 분류 결과를 확인한 뒤 Draft로 저장하세요.'}
  function top3Candidates(){const {o,role,sit}=current();let arr=[];const p=window.LeaderOsR21?.progress?.();if(p?.next)arr.push(`${p.next.title}: ${p.next.desc}`);arr.push(sit.steps[0],role.manager[0]);return [...new Set(arr)].slice(0,3)}
  function renderCompletion(){const p=window.LeaderOsR21?.progress?.()||{done:0,total:6},root=q('[data-r22-completion]');if(!root)return;const ready=p.done>=p.total;q('[data-r22-completion-title]',root).textContent=ready?'기본 온보딩 Context가 준비되었습니다.':'준비된 Context만으로도 오늘의 Top 3를 만들 수 있습니다.';q('[data-r22-completion-copy]',root).textContent=ready?'이제 Today에서는 학습 메뉴보다 실제 팀의 결정·약속·마일스톤을 우선 보여줍니다.':`${p.done}/${p.total} Gate 준비. 모르는 것은 UNKNOWN으로 남기고 실제 업무에서 확인하세요.`;const rows=extras.top3?.length?extras.top3:top3Candidates();q('[data-r22-top3]',root).innerHTML=rows.map((x,i)=>`<div><b>0${i+1}</b> · ${esc(x)}</div>`).join('')}
  function renderAll(){renderPersonalized();render1on1();renderCalendar();renderCompletion();renderProposalCommentControls()}
  async function copyText(text,statusEl){try{await navigator.clipboard.writeText(text);if(statusEl)statusEl.textContent='클립보드에 복사했습니다.'}catch{if(statusEl)statusEl.textContent='브라우저 권한 때문에 자동 복사가 안 되었습니다. 화면의 질문을 직접 복사해주세요.'}}
  q('[data-r22-refresh]')?.addEventListener('click',renderAll);
  q('[data-r21-role]')?.addEventListener('change',()=>setTimeout(renderAll,0));q('[data-r21-situation]')?.addEventListener('change',()=>setTimeout(renderAll,0));
  q('[data-r22-copy-manager]')?.addEventListener('click',()=>{const {role}=current();copyText(role.manager.map((x,i)=>`${i+1}. ${x}`).join('\n'))});
  q('[data-r22-copy-1on1]')?.addEventListener('click',()=>{const {role}=current();copyText(['[First 1:1 Prep Pack]',...role.one.map((x,i)=>`${i+1}. ${x}`),'','Evidence to capture: '+(q('[data-r22-1on1-evidence]')?.value||'')].join('\n'),q('[data-r22-1on1-status]'))});
  q('[data-r22-save-1on1]')?.addEventListener('click',()=>{extras.prepEvidence=q('[data-r22-1on1-evidence]').value.trim();extras.lastGeneratedAt=new Date().toISOString();set(R22,JSON.stringify(extras));q('[data-r22-1on1-status]').textContent='Prep 메모를 저장했습니다. Private 1:1 원문과 분리해서 보관합니다.'});
  q('[data-r22-open-1on1]')?.addEventListener('click',()=>openPageSafe('ONE_ON_ONE'));
  q('[data-r22-calendar-sample]')?.addEventListener('click',()=>{q('[data-r22-calendar-input]').value='월 10:00 Weekly Team Meeting\n화 14:00 1:1 민지\n수 16:00 Campaign Concept Lock\n목 15:00 Budget Decision Review\n금 16:00 Weekly Debrief';q('[data-r22-calendar-status]').textContent='샘플은 아직 저장되지 않았습니다. “분류하기”로 구조를 확인하세요.'});
  q('[data-r22-calendar-parse]')?.addEventListener('click',()=>{const raw=q('[data-r22-calendar-input]').value.trim();cal={raw,rows:raw.split(/\n+/).map(x=>x.trim()).filter(Boolean).map(classifyCalendar),savedAt:null};renderCalendar()});
  q('[data-r22-calendar-save]')?.addEventListener('click',()=>{if(!cal.rows?.length){q('[data-r22-calendar-status]').textContent='먼저 일정을 분류하세요.';return}cal.savedAt=new Date().toISOString();set(CAL,JSON.stringify(cal));renderCalendar()});
  q('[data-r22-build-top3]')?.addEventListener('click',()=>{extras.top3=top3Candidates();set(R22,JSON.stringify(extras));set(TOP3,JSON.stringify({items:extras.top3,createdAt:new Date().toISOString()}));renderCompletion();renderTodayTop3()});
  function openPageSafe(name){const nav=q(`[data-fallback-page="${name}"]`);try{nav?.click()}catch{}setTimeout(()=>{const target=q(`[data-page="${name}"]`);if(target?.hidden){qa('[data-page]').forEach(x=>x.hidden=x!==target);qa('[data-primary-nav] a').forEach(a=>a.removeAttribute('aria-current'));nav?.setAttribute('aria-current','page');const title=q('[data-topbar-title]');if(title)title.textContent=nav?.textContent?.trim()||name}if(name==='TODAY')renderTodayTop3()},20)}
  q('[data-r22-go-today]')?.addEventListener('click',()=>openPageSafe('TODAY'));
  function renderTodayTop3(){const today=q('[data-page="TODAY"]');if(!today)return;let box=q('[data-r22-today-top3]',today);const saved=safe(get(TOP3),null)||(extras.top3?.length?{items:extras.top3,createdAt:extras.lastGeneratedAt||new Date().toISOString()}:null);if(!saved?.items?.length){box?.remove();return}if(!box){box=document.createElement('section');box.className='card r22-interactive';box.dataset.r22TodayTop3='';const banner=q('[data-r21-today-banner]',today);(banner||today.querySelector('h1'))?.insertAdjacentElement('afterend',box)}box.innerHTML=`<div class="section-kicker">ONBOARDING TOP 3</div><h2>오늘 리더로서 먼저 확인할 3가지</h2><div class="r22-top3">${saved.items.map((x,i)=>`<div><b>0${i+1}</b> · ${esc(x)}</div>`).join('')}</div><div class="r21-actions"><button type="button" data-r22-top3-open>온보딩으로 돌아가기</button></div>`;q('[data-r22-top3-open]',box).onclick=()=>window.LeaderOsR21?.showOnboarding?.()}
  // Change Proposal participant comments.
  function proposalList(){return safe(get(PROP),[])}
  function renderProposalCommentControls(){const sel=q('[data-r22-comment-proposal]');if(!sel)return;const props=proposalList();const old=sel.value;sel.innerHTML='<option value="">Proposal 선택</option>'+props.filter(p=>!['APPLIED','REJECTED'].includes(p.status)).map(p=>`<option value="${esc(p.id)}">${esc(p.agreementName||'Agreement')} · ${esc(p.status)} · v${p.baseVersion}</option>`).join('');if(props.some(p=>p.id===old))sel.value=old;renderComments()}
  function renderComments(){const root=q('[data-r22-comments]'),id=q('[data-r22-comment-proposal]')?.value;if(!root)return;const rows=comments[id]||[];root.innerHTML=id?(rows.length?rows.map(c=>`<div class="r22-comment"><div class="r22-comment-head"><b>${esc(c.name||'Reviewer')}</b><span class="r22-stance">${esc(c.stance)}</span></div>${esc(c.text)}<br><span style="color:#7b847f">${esc((c.createdAt||'').replace('T',' ').slice(0,16))}</span></div>`).join(''):'<div class="r21-empty">아직 코멘트가 없습니다.</div>'):'<div class="r21-empty">Proposal을 선택하세요.</div>'}
  q('[data-r22-comment-proposal]')?.addEventListener('change',renderComments);
  q('[data-r22-comment-add]')?.addEventListener('click',()=>{const id=q('[data-r22-comment-proposal]').value,name=q('[data-r22-comment-name]').value.trim(),text=q('[data-r22-comment-text]').value.trim(),stance=q('[data-r22-comment-stance]').value;if(!id||!name||!text){alert('Proposal, 이름, 코멘트를 입력하세요.');return}(comments[id] ||= []).push({id:'C-'+Date.now().toString(36),name,text,stance,createdAt:new Date().toISOString()});set(COMMENTS,JSON.stringify(comments));q('[data-r22-comment-text]').value='';renderComments()});
  window.addEventListener('storage',()=>{extras=safe(get(R22),extras);cal=safe(get(CAL),cal);comments=safe(get(COMMENTS),comments);renderAll();renderTodayTop3()});
  document.addEventListener('click',e=>{if(e.target.closest?.('[data-r21-onboarding-nav]'))setTimeout(renderAll,40);if(e.target.closest?.('[data-fallback-page="TODAY"]'))setTimeout(renderTodayTop3,50);if(e.target.closest?.('[data-fallback-page="TEAM_WORKING_AGREEMENT"]'))setTimeout(renderProposalCommentControls,50)},true);
  let r22Scope=localScope();
  setInterval(()=>{const next=localScope();if(next===r22Scope)return;r22Scope=next;extras=safe(get(R22),{prepEvidence:'',lastGeneratedAt:null,top3:[]});cal=safe(get(CAL),{raw:'',rows:[],savedAt:null});renderAll();renderTodayTop3()},1250);
  setTimeout(()=>{renderAll();renderTodayTop3()},120);
  window.LeaderOsR22={render:renderAll,current,calendar:()=>JSON.parse(JSON.stringify(cal)),top3:()=>JSON.parse(JSON.stringify(extras.top3||[])),comments:()=>JSON.parse(JSON.stringify(comments))};
})();
</script>
<script id="recovery-23-leadership-jd">
(function(){
  const KEY_BASE='leader-os:leadership-jd-practice:v2';
  const q=(s,r=document)=>r.querySelector(s), qa=(s,r=document)=>[...r.querySelectorAll(s)];
  const store=window.__leaderOsStorage||localStorage;
  const localScope=()=>{try{const x=window.LeaderOsReportRuntimeBridge?.state?.();return x?.signedIn&&x.userId&&x.workspaceId?`${x.userId}:${x.workspaceId}`:'guest'}catch{return'guest'}};
  const key=()=>`${KEY_BASE}:${localScope()}`;
  const esc=(v)=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const read=()=>{try{return JSON.parse(store.getItem(key())||'[]')}catch{return[]}};
  const write=(v)=>{try{store.setItem(key(),JSON.stringify(v))}catch{}};
  const page=q('[data-page="LEADERSHIP_JD"]'); if(!page) return;
  const nav=q('[data-r23-leadership-jd-nav]');
  function show(){
    qa('[data-page]').forEach(p=>p.hidden=p!==page);
    qa('[data-primary-nav] a').forEach(a=>a.removeAttribute('aria-current'));
    nav?.setAttribute('aria-current','page');
    const title=q('[data-topbar-title]'); if(title) title.textContent='Leadership JD';
    window.scrollTo({top:0,behavior:'smooth'});
    renderLogs();
  }
  if(nav) nav.addEventListener('click',e=>{e.preventDefault();e.stopImmediatePropagation();show()});
  let draft=null;
  const fields=()=>Object.fromEntries(qa('[data-r23-field]',page).map(el=>[el.dataset.r23Field,el.value.trim()]));
  function renderDraft(d){
    const box=q('[data-r23-result]',page); if(!box)return;
    box.innerHTML=`<h3>Leadership Reframe Draft</h3>
      <div class="row"><b>Context</b><span>${esc(d.context||'—')}</span></div>
      <div class="row"><b>Old Goal</b><span>${esc(d.oldGoal||'—')}</span></div>
      <div class="row"><b>Broken Assumption</b><span>${esc(d.signal||'—')}</span></div>
      <div class="row"><b>Reframed Outcome</b><span>${esc(d.newGoal||'—')}</span></div>
      <div class="row"><b>DRI</b><span>${esc(d.dri||'미정')}</span></div>
      <div class="row"><b>Guardrail</b><span>${esc(d.guardrail||'미정')}</span></div>
      <div class="row"><b>Escalation</b><span>${esc(d.escalate||'미정')}</span></div>
      <div class="row"><b>Next 24h</b><span>${esc(d.next||'—')}</span></div>`;
    const save=q('[data-r23-save]',page); if(save) save.disabled=false;
  }
  q('[data-r23-sample]',page)?.addEventListener('click',()=>{
    const sample={context:'신규 서비스 공개 3일 전 보안 취약점 발견',oldGoal:'금요일 정식 런칭',signal:'취약점을 해결하지 않은 공개 배포는 고객 데이터와 신뢰에 직접 위험',newGoal:'고객 신뢰를 지키면서 검증 가능한 Pilot 일정 확정',dri:'Product Lead 김민지',guardrail:'보안 검증 완료 전 공개 배포 금지',escalate:'일정 변경이 1주를 넘거나 고객 약속 변경이 필요할 때',next:'공개 배포 중지 → 영향범위 확인 → 경영진/고객 커뮤니케이션 → 수정 Milestone과 Pilot 기준 제안'};
    qa('[data-r23-field]',page).forEach(el=>{el.value=sample[el.dataset.r23Field]||''});
    draft=null; const save=q('[data-r23-save]',page); if(save)save.disabled=true;
  });
  q('[data-r23-generate]',page)?.addEventListener('click',()=>{
    const d=fields();
    if(!d.context && !d.oldGoal && !d.signal){alert('현재 상황이나 기존 목표를 먼저 입력해주세요.');return}
    draft={...d,createdAt:new Date().toISOString()}; renderDraft(draft);
  });
  q('[data-r23-save]',page)?.addEventListener('click',()=>{
    if(!draft)return; const logs=[draft,...read()].slice(0,10); write(logs); renderLogs();
  });
  function renderLogs(){
    const box=q('[data-r23-log]',page); if(!box)return; const logs=read();
    box.innerHTML=logs.length?`<div class="section-kicker">PRACTICE LOG</div>`+logs.map((x,i)=>`<div class="r23-log-item"><b>${esc(x.newGoal||x.context||`Practice ${i+1}`)}</b><span>${esc(x.dri||'DRI 미정')} · ${esc(x.guardrail||'Guardrail 미정')}</span></div>`).join(''):'';
  }
  qa('[data-r23-route]',page).forEach(b=>b.addEventListener('click',()=>{
    const id=b.dataset.r23Route;
    const a=q(`[data-fallback-page="${id}"]`)||q(`[data-route-id="${id}"]`);
    if(a){a.click();return}
    if(id==='LEADER_COACH'){q('[data-leader-coach-nav]')?.click();}
  }));
  // Wrap tables so future columns scroll instead of widening the entire page.
  qa('[data-page] table').forEach(table=>{
    if(table.parentElement?.classList.contains('layout-table-scroll'))return;
    const wrap=document.createElement('div');wrap.className='layout-table-scroll';table.parentNode.insertBefore(wrap,table);wrap.appendChild(table);
  });
  // Lightweight layout sentinel for future recovery builds.
  window.LeaderOsLayoutAudit=()=>({
    viewport:document.documentElement.clientWidth,
    bodyWidth:document.body.scrollWidth,
    overflow:Math.max(0,document.body.scrollWidth-document.documentElement.clientWidth),
    wide:[...document.querySelectorAll('.content *')].filter(el=>{const r=el.getBoundingClientRect();return r.width>0&&r.right>document.documentElement.clientWidth+2}).slice(0,20).map(el=>({tag:el.tagName,id:el.id,cls:String(el.className).slice(0,100)}))
  });
  renderLogs();
})();
</script>
<script>
(function(){
 const q=(s,r=document)=>r.querySelector(s), qa=(s,r=document)=>[...r.querySelectorAll(s)];
 const page=q('[data-page="AI_WORK_OS"]'); if(!page)return;
 const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const num=(name,def=0)=>Number(q(`[data-ai24-cost="${name}"]`,page)?.value||def);
 function calc(){
   const req=num('requests'), inp=num('inputTokens'), out=num('outputTokens'), cache=Math.max(0,Math.min(100,num('cachePct')))/100;
   const inRate=num('inputRate'), cRate=num('cachedRate'), outRate=num('outputRate'), budget=num('budget');
   const inTokens=req*inp, outTokens=req*out, cached=inTokens*cache, normal=inTokens-cached;
   const cost=normal/1e6*inRate+cached/1e6*cRate+outTokens/1e6*outRate; const pct=budget>0?cost/budget*100:0;
   q('[data-ai24-est-cost]',page).textContent='$'+cost.toFixed(2); q('[data-ai24-budget-pct]',page).textContent=pct.toFixed(1)+'%'; q('[data-ai24-total-tokens]',page).textContent=(inTokens+outTokens).toLocaleString();
   const el=q('[data-ai24-budget-pct]',page);el.style.color=pct>=100?'#a33a35':pct>=85?'#9b6517':pct>=70?'#76601e':'';
 }
 qa('[data-ai24-cost]',page).forEach(x=>x.addEventListener('input',calc)); calc();
 function ratioStatus(){const a=Number(q('[data-ai24-ratio="ai"]',page).value||0),h=Number(q('[data-ai24-ratio="human"]',page).value||0),r=Number(q('[data-ai24-ratio="review"]',page).value||0),sum=a+h+r;const s=q('[data-ai24-ratio-status]',page);s.textContent=`합계 ${sum}% · ${sum===100?'운영 가설로 사용 가능':'100%가 되도록 조정하세요'}`;s.style.color=sum===100?'#356148':'#a14c42'}
 qa('[data-ai24-ratio]',page).forEach(x=>x.addEventListener('input',ratioStatus));ratioStatus();
 qa('[data-ai24-split]',page).forEach(card=>card.addEventListener('click',()=>{qa('[data-ai24-split]',page).forEach(x=>x.classList.remove('active'));card.classList.add('active');q('[data-ai24-ratio="ai"]',page).value=card.dataset.ai;q('[data-ai24-ratio="human"]',page).value=card.dataset.human;q('[data-ai24-ratio="review"]',page).value=card.dataset.review;const sel=q('[data-ai24-policy="profile"]',page);if(sel)sel.value=card.dataset.ai24Profile||'analysis';ratioStatus()}));
 let draft=null;
 q('[data-ai24-build]',page)?.addEventListener('click',()=>{
  const team=q('[data-ai24-policy="team"]',page).value.trim()||'우리 팀'; const owner=q('[data-ai24-policy="owner"]',page).value.trim()||'미정'; const budget=Number(q('[data-ai24-policy="budget"]',page).value||0); const profile=q('[data-ai24-policy="profile"]',page).value; const credit=q('[data-ai24-policy="credit"]',page).value; const sensitive=q('[data-ai24-policy="sensitive"]',page).value; const rules=qa('[data-ai24-rule]:checked',page).map(x=>x.dataset.ai24Rule);
  const ratios={ai:Number(q('[data-ai24-ratio="ai"]',page).value||0),human:Number(q('[data-ai24-ratio="human"]',page).value||0),review:Number(q('[data-ai24-ratio="review"]',page).value||0)};
  draft={team,owner,budget,profile,credit,sensitive,rules,ratios,rateCard:q('[data-ai24-cost="rateName"]',page).value,costEstimate:q('[data-ai24-est-cost]',page).textContent,createdAt:new Date().toISOString()};
  q('[data-ai24-policy-preview]',page).textContent=`TEAM · ${team}\nSSOT OWNER · ${owner}\nMONTHLY AI BUDGET · $${budget.toLocaleString()}\nWORK SPLIT · AI ${ratios.ai}% / Human ${ratios.human}% / Review ${ratios.review}%\nTASK PROFILE · ${profile}\nCREDIT · ${credit}\nSENSITIVE DATA · ${sensitive}\nRATE CARD · ${draft.rateCard}\nCURRENT ESTIMATE · ${draft.costEstimate}\n\nRULES\n${rules.map(x=>'• '+x.toUpperCase()).join('\n')}\n\nSTATUS · DRAFT — Human / Finance / Security review required`;
  q('[data-ai24-save]',page).disabled=false;
 });
 q('[data-ai24-save]',page)?.addEventListener('click',()=>{if(!draft)return;localStorage.setItem('leader-os:ai-work-policy:v1',JSON.stringify(draft));const b=q('[data-ai24-save]',page);b.textContent='저장됨 · DRAFT';setTimeout(()=>b.textContent='이 브라우저에 저장',1800)});
 q('[data-ai24-route="BILLING"]',page)?.addEventListener('click',()=>q('[data-fallback-page="BILLING"]')?.click());
})();
</script>
<script>
/* RECOVERY 24.1 · local quest list editor + overflow guard */
(() => {
  const STORAGE_KEY = 'leader-os:r24.1:quest-label-overrides';
  let editMode = false;
  let applying = false;
  const q = (s, root=document) => root.querySelector(s);
  const qa = (s, root=document) => Array.from(root.querySelectorAll(s));
  const read = () => { try { return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}') || {}; } catch { return {}; } };
  const write = (v) => { try { localStorage.setItem(STORAGE_KEY, JSON.stringify(v)); } catch {} };
  const dayOf = row => String(row?.getAttribute('data-quest-day') || row?.getAttribute('data-quest-item') || row?.dataset?.questDay || '').replace(/[^0-9]/g,'');
  const selectedDay = () => dayOf(q('.quest-row.selected,[data-quest-day].selected,[data-quest-item].selected'));

  function applyOverrides(){
    if(applying) return;
    applying=true;
    try{
      const data=read();
      qa('[data-quest-list] .quest-row,[data-quest-list] [data-quest-day],[data-quest-list] [data-quest-item]').forEach(row=>{
        const day=dayOf(row); if(!day) return;
        const title=q('.quest-row-copy strong',row);
        const artifact=q('.quest-row-copy small',row);
        const o=data[day]||{};
        if(title && o.title && title.textContent!==o.title) title.textContent=o.title;
        if(artifact && o.artifact && artifact.textContent!==o.artifact) artifact.textContent=o.artifact;
        row.classList.toggle('is-editing',editMode);
        if(title){title.contentEditable=editMode?'true':'false'; title.spellcheck=false; title.dataset.questEditField='title';}
        if(artifact){artifact.contentEditable=editMode?'true':'false'; artifact.spellcheck=false; artifact.dataset.questEditField='artifact';}
      });
      const day=selectedDay();
      if(day && data[day]?.title){
        const h=q('[data-quest-detail] .quest-detail-head h2');
        if(h && h.textContent!==data[day].title) h.textContent=data[day].title;
      }
    } finally { applying=false; }
  }

  function saveEditable(target){
    const row=target.closest('.quest-row,[data-quest-day],[data-quest-item]');
    const day=dayOf(row); const field=target.dataset.questEditField;
    if(!day || !field) return;
    const data=read(); data[day] ||= {};
    const val=(target.textContent||'').trim();
    if(val) data[day][field]=val; else delete data[day][field];
    if(!Object.keys(data[day]).length) delete data[day];
    write(data); applyOverrides();
  }

  function setup(){
    const list=q('[data-quest-list]');
    const sidebar=q('.quest-sidebar');
    const toggle=q('[data-quest-edit-toggle]');
    const reset=q('[data-quest-edit-reset]');
    const collapse=q('[data-quest-list-collapse]');
    if(!list || !sidebar) return;
    sidebar.setAttribute('data-r24-1-fixed','true');
    toggle?.addEventListener('click',()=>{
      editMode=!editMode;
      toggle.classList.toggle('active',editMode);
      toggle.textContent=editMode?'편집 완료':'목록 편집';
      applyOverrides();
    });
    reset?.addEventListener('click',()=>{
      try{localStorage.removeItem(STORAGE_KEY);}catch{}
      editMode=false;
      if(toggle){toggle.classList.remove('active');toggle.textContent='목록 편집';}
      // Force the curriculum renderer to redraw by clicking current phase filter if available.
      const active=q('[data-quest-phase-filters] button.active');
      if(active) active.click();
      setTimeout(applyOverrides,30);
    });
    collapse?.addEventListener('click',()=>{
      const on=sidebar.classList.toggle('is-collapsed');
      collapse.textContent=on?'목록 펼치기':'목록 접기';
    });
    list.addEventListener('blur',e=>{
      const t=e.target;
      if(t instanceof HTMLElement && t.dataset.questEditField) saveEditable(t);
    },true);
    list.addEventListener('keydown',e=>{
      const t=e.target;
      if(!(t instanceof HTMLElement) || !t.dataset.questEditField) return;
      if(e.key==='Enter') { e.preventDefault(); t.blur(); }
      if(e.key==='Escape') { e.preventDefault(); applyOverrides(); t.blur(); }
    });
    let scheduled=false;
    const obs=new MutationObserver(()=>{
      if(scheduled || applying) return;
      scheduled=true; requestAnimationFrame(()=>{scheduled=false;applyOverrides();});
    });
    obs.observe(list,{childList:true,subtree:true});
    const detail=q('[data-quest-detail]'); if(detail) obs.observe(detail,{childList:true,subtree:true});
    applyOverrides();
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',()=>setTimeout(setup,80),{once:true});
  else setTimeout(setup,80);
})();
</script>
<script id="recovery-25-ai-usage-js">
(function(){
  const q=(s,r=document)=>r.querySelector(s), qa=(s,r=document)=>[...r.querySelectorAll(s)];
  const page=q('[data-page="AI_USAGE"]'); if(!page)return;
  document.title='Leader OS · Recovery 31 · Flow Time & Team Directory';
  function showCustomPage(pageId,label){const target=q(`[data-page="${pageId}"]`);if(!target)return;qa('[data-page]').forEach(x=>x.hidden=x!==target);qa('[data-primary-nav] a').forEach(a=>a.removeAttribute('aria-current'));const link=q(`[data-ai25-system-page="${pageId}"]`)||q(`[data-fallback-page="${pageId}"]`);link?.setAttribute('aria-current','page');const title=q('[data-topbar-title]');if(title)title.textContent=label||link?.textContent?.trim()||pageId;history.replaceState(null,'',pageId==='AI_USAGE'?'#ai-usage':'#ai-work-os');window.scrollTo({top:0,behavior:'auto'});}
  function ensureSystemNav(){const nav=q('[data-primary-nav]');if(!nav)return;const sys=qa('.nav-section',nav).find(sec=>q('.nav-label',sec)?.textContent?.trim()==='SYSTEM')||qa('.nav-section',nav).at(-1);if(!sys)return;const billing=qa('a',sys).find(a=>/Billing/i.test(a.textContent||''));[['AI_WORK_OS','AI Work OS','#ai-work-os'],['AI_USAGE','AI Usage','#ai-usage']].forEach(([id,label,href])=>{let a=q(`[data-ai25-system-page="${id}"]`,sys)||q(`[data-fallback-page="${id}"]`,sys);if(!a){a=document.createElement('a');a.href=href;a.dataset.ai25SystemPage=id;a.textContent=label;if(billing)billing.insertAdjacentElement('beforebegin',a);else sys.append(a)}a.onclick=(e)=>{e.preventDefault();e.stopImmediatePropagation();showCustomPage(id,label);if(id==='AI_USAGE')setTimeout(renderAll,0)}});}
  const KEY='leader-os:ai-usage-runtime:v1';
  const esc=(v)=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const nowIso=()=>new Date().toISOString();
  const day=(iso)=>Math.floor((new Date()-new Date(iso))/(86400000));
  const money=n=>'$'+Number(n||0).toFixed(2);
  const compact=n=>{n=Number(n||0);if(n>=1e6)return (n/1e6).toFixed(n>=1e7?1:2)+'M';if(n>=1e3)return (n/1e3).toFixed(1)+'K';return Math.round(n).toLocaleString()};
  const uid=(p)=>`${p}-${Date.now().toString(36)}-${Math.random().toString(36).slice(2,6)}`;
  const demo=()=>({
    demo:true,
    budgets:[
      {scope:'ORG',id:'Company',amount:150,owner:'Finance'},
      {scope:'TEAM',id:'Creative AI Lab',amount:75,owner:'Creative Lead'},
      {scope:'TEAM',id:'Marketing',amount:60,owner:'Marketing Lead'},
      {scope:'PROJECT',id:'DailySkin',amount:24,owner:'Project Lead'},
      {scope:'PROJECT',id:'Project Alpha',amount:45,owner:'Project Lead'}
    ],
    rateCards:[
      {id:'RC-fast',signature:'Demo Provider|fast-1|standard',provider:'Demo Provider',model:'fast-1',mode:'standard',input:0.5,cached:0.05,output:2,effective:'2026-10-01',owner:'AI Ops',source:'DEMO SAMPLE · replace before production',version:1,status:'SAMPLE',updatedAt:nowIso()},
      {id:'RC-balanced',signature:'Demo Provider|balanced-1|standard',provider:'Demo Provider',model:'balanced-1',mode:'standard',input:1.5,cached:0.15,output:6,effective:'2026-10-01',owner:'AI Ops',source:'DEMO SAMPLE · replace before production',version:1,status:'SAMPLE',updatedAt:nowIso()},
      {id:'RC-reason',signature:'Demo Provider|reason-1|standard',provider:'Demo Provider',model:'reason-1',mode:'standard',input:3,cached:0.3,output:12,effective:'2026-10-01',owner:'AI Ops',source:'DEMO SAMPLE · replace before production',version:1,status:'SAMPLE',updatedAt:nowIso()}
    ],
    prompts:[
      {id:'PROMPT:RESEARCH_SCAN',name:'Research Scan',route:'EXTRACT',owner:'AI Ops',version:4,status:'CONFIRMED',updatedAt:'2026-10-01',note:'Structured extraction + citations.'},
      {id:'PROMPT:CREATIVE_BRIEF',name:'Creative Brief Draft',route:'DRAFT',owner:'Creative Ops',version:5,status:'CONFIRMED',updatedAt:'2026-10-02',note:'Brief schema + campaign evidence.'},
      {id:'PROMPT:EXEC_BRIEF',name:'Executive Brief',route:'REASON',owner:'PMO',version:3,status:'CONFIRMED',updatedAt:'2026-09-29',note:'Recommendation → Reason → Evidence → Confidence.'}
    ],
    contexts:[
      {id:'BRAND_GUIDE',name:'Brand Guide',owner:'Brand',version:12,status:'CONFIRMED',updatedAt:'2026-10-01',freshnessDays:30,access:'WORKSPACE',tokens:4500},
      {id:'DAILYSKIN_BRIEF',name:'DailySkin Campaign Brief',owner:'Project Lead',version:7,status:'CONFIRMED',updatedAt:'2026-09-29',freshnessDays:14,access:'TEAM',tokens:3200},
      {id:'PRODUCT_FACTS',name:'Product Facts',owner:'Product',version:4,status:'CONFIRMED',updatedAt:'2026-09-20',freshnessDays:30,access:'WORKSPACE',tokens:2100},
      {id:'MARKET_RESEARCH',name:'Market Research',owner:'Strategy',version:3,status:'CONFIRMED',updatedAt:'2026-08-20',freshnessDays:14,access:'WORKSPACE',tokens:6800},
      {id:'PRIVATE_1ON1_RAW',name:'Raw 1:1 Notes',owner:'Leader',version:1,status:'CONFIRMED',updatedAt:'2026-10-03',freshnessDays:7,access:'PRIVATE_1ON1',tokens:5000}
    ],
    routing:{
      EXTRACT:{primary:'RC-fast',fallback:'RC-balanced',human:'VALIDATE'},
      DRAFT:{primary:'RC-balanced',fallback:'RC-fast',human:'SELECT'},
      REASON:{primary:'RC-reason',fallback:'RC-balanced',human:'REVIEW'},
      HIGH_STAKES:{primary:'RC-reason',fallback:'NONE',human:'REQUIRED'}
    },
    events:[
      {id:'UE-1',at:'2026-10-01T09:10:00Z',user:'peter',team:'Creative AI Lab',project:'DailySkin',task:'DRAFT',purpose:'Creative concept variants',rateCardId:'RC-balanced',input:2000000,cached:500000,output:500000,retries:1,result:'ACCEPTED',contextIds:['BRAND_GUIDE','DAILYSKIN_BRIEF'],artifact:'CREATIVE_BRIEF:v4'},
      {id:'UE-2',at:'2026-10-01T13:30:00Z',user:'peter',team:'Creative AI Lab',project:'DailySkin',task:'REASON',purpose:'Campaign strategy critique',rateCardId:'RC-reason',input:2000000,cached:200000,output:500000,retries:2,result:'REVISED',contextIds:['BRAND_GUIDE','DAILYSKIN_BRIEF','PRODUCT_FACTS'],artifact:'CAMPAIGN_STRATEGY:v3'},
      {id:'UE-3',at:'2026-10-02T04:10:00Z',user:'peter',team:'Creative AI Lab',project:'DailySkin',task:'DRAFT',purpose:'Short-form hooks',rateCardId:'RC-balanced',input:1000000,cached:400000,output:300000,retries:1,result:'ACCEPTED',contextIds:['DAILYSKIN_BRIEF'],artifact:'CREATIVE_HOOKS:v2'},
      {id:'UE-4',at:'2026-10-03T08:40:00Z',user:'peter',team:'Creative AI Lab',project:'DailySkin',task:'EXTRACT',purpose:'Review clustering',rateCardId:'RC-fast',input:1200000,cached:300000,output:250000,retries:1,result:'ACCEPTED',contextIds:['PRODUCT_FACTS'],artifact:'REVIEW_CLUSTER:v1'},
      {id:'UE-5',at:'2026-10-02T02:20:00Z',user:'analyst',team:'Marketing',project:'Project Alpha',task:'REASON',purpose:'Channel performance analysis',rateCardId:'RC-reason',input:1300000,cached:350000,output:240000,retries:3,result:'REVISED',contextIds:['MARKET_RESEARCH'],artifact:'CHANNEL_REPORT:v3'},
      {id:'UE-6',at:'2026-10-03T06:10:00Z',user:'analyst',team:'Marketing',project:'Project Alpha',task:'DRAFT',purpose:'Weekly report draft',rateCardId:'RC-balanced',input:600000,cached:250000,output:180000,retries:1,result:'ACCEPTED',contextIds:['PRODUCT_FACTS'],artifact:'WEEKLY_REPORT:v5'}
    ]
  });
  let store; try{store=JSON.parse(localStorage.getItem(KEY)||'null')}catch{} if(!store)store=demo();
  const save=()=>{try{localStorage.setItem(KEY,JSON.stringify(store))}catch{}};
  const rate=id=>id==='NONE'?null:(store.rateCards.find(r=>r.id===id)||store.rateCards[0]);
  const eventCost=(e)=>{const r=rate(e.rateCardId);if(!r)return 0;const cached=Math.min(Number(e.cached||0),Number(e.input||0)),normal=Math.max(0,Number(e.input||0)-cached);return normal/1e6*Number(r.input||0)+cached/1e6*Number(r.cached||0)+Number(e.output||0)/1e6*Number(r.output||0)};
  const allCost=evs=>evs.reduce((s,e)=>s+eventCost(e),0);
  const budgetState=p=>p>=100?'STOP / APPROVE':p>=85?'REVIEW':p>=70?'NOTICE':'CLEAR';
  const stateClass=st=>st.startsWith('STOP')?'stop':st==='REVIEW'?'review':st==='NOTICE'?'notice':'clear';
  const contextsByIds=ids=>(ids||[]).map(id=>store.contexts.find(c=>c.id===id)).filter(Boolean);
  const contextState=c=>c.access==='PRIVATE_1ON1'?'BLOCKED':c.status!=='CONFIRMED'?'DRAFT':day(c.updatedAt)>Number(c.freshnessDays||30)?'STALE':'FRESH';
  const validContext=c=>contextState(c)==='FRESH';
  const getFilters=()=>({team:q('[data-ai25-filter="team"]',page)?.value||'ALL',project:q('[data-ai25-filter="project"]',page)?.value||'ALL'});
  const filtered=()=>{const f=getFilters();return store.events.filter(e=>(f.team==='ALL'||e.team===f.team)&&(f.project==='ALL'||e.project===f.project))};
  const unique=(a)=>[...new Set(a.filter(Boolean))].sort();
  function renderFilters(){const team=q('[data-ai25-filter="team"]',page),project=q('[data-ai25-filter="project"]',page);const curT=team.value||'ALL',curP=project.value||'ALL';team.innerHTML='<option>ALL</option>'+unique(store.events.map(e=>e.team)).map(x=>`<option>${esc(x)}</option>`).join('');project.innerHTML='<option>ALL</option>'+unique(store.events.map(e=>e.project)).map(x=>`<option>${esc(x)}</option>`).join('');team.value=[...team.options].some(o=>o.value===curT)?curT:'ALL';project.value=[...project.options].some(o=>o.value===curP)?curP:'ALL'}
  function metrics(){const ev=filtered(),cost=allCost(ev),tokens=ev.reduce((s,e)=>s+Number(e.input||0)+Number(e.output||0),0),cached=ev.reduce((s,e)=>s+Number(e.cached||0),0),input=ev.reduce((s,e)=>s+Number(e.input||0),0),accepted=ev.filter(e=>e.result==='ACCEPTED').length,acceptedCost=allCost(ev.filter(e=>e.result==='ACCEPTED')),retries=ev.reduce((s,e)=>s+Number(e.retries||0),0);return {ev,cost,tokens,cachedRate:input?cached/input*100:0,accepted,costAccepted:accepted?acceptedCost/accepted:0,retries}}
  function scopedSpend(b){const ev=store.events.filter(e=>b.scope==='ORG'?true:b.scope==='TEAM'?e.team===b.id:e.project===b.id);return allCost(ev)};
  function budgetRows(){return store.budgets.map(b=>{const spent=scopedSpend(b),pct=b.amount>0?spent/b.amount*100:0;return {...b,spent,pct,state:budgetState(pct)}})}
  function attentions(){const a=budgetRows().filter(x=>x.state!=='CLEAR').map(x=>({type:'BUDGET',state:x.state,title:`${x.scope} · ${x.id}`,copy:`${money(x.spent)} / ${money(x.amount)} · ${x.pct.toFixed(1)}%`}));const stale=store.contexts.filter(c=>contextState(c)==='STALE');if(stale.length)a.push({type:'SSOT',state:'REVIEW',title:`STALE Context ${stale.length}개`,copy:stale.slice(0,2).map(x=>`${x.name} v${x.version}`).join(' · ')});const heavy=store.events.filter(e=>Number(e.retries||0)>=4);if(heavy.length)a.push({type:'RETRY',state:'NOTICE',title:`Retry ≥4 · ${heavy.length}건`,copy:'Prompt / Context / Route를 먼저 점검하세요.'});return a.slice(0,4)};
  function renderMetrics(){const m=metrics();q('[data-ai25-metrics]',page).innerHTML=[['Spend',money(m.cost),'선택 범위의 Usage Event 비용'],['Tokens',compact(m.tokens),`Cached input ${m.cachedRate.toFixed(1)}%`],['Accepted',m.accepted,'Accepted Output 수'],['Cost / Accepted',money(m.costAccepted),'Accepted Artifact 기준'],['Retry',m.retries,'재시도 총합'],['Events',m.ev.length,'Usage Event 수']].map(([l,v,c])=>`<div class="ai25-metric"><small>${l}</small><strong>${v}</strong><span>${c}</span></div>`).join('')}
  function renderAlerts(){const a=attentions(),root=q('[data-ai25-alerts]',page);q('[data-ai25-alert-count]',page).textContent=`${a.length} Attention`;q('[data-ai25-alert-count]',page).className=`ai25-state ${a.some(x=>x.state.startsWith('STOP'))?'stop':a.some(x=>x.state==='REVIEW')?'review':a.length?'notice':'clear'}`;root.innerHTML=a.length?a.map(x=>`<div class="ai25-alert"><span class="ai25-state ${stateClass(x.state)}">${esc(x.state)}</span><div><strong>${esc(x.title)}</strong><span>${esc(x.copy)}</span></div><button type="button" data-ai25-attention-open>확인</button></div>`).join(''):'<div class="ai25-alert"><span class="ai25-state clear">CLEAR</span><div><strong>현재 Budget / SSOT Attention 없음</strong><span>Guardrail 범위 안입니다.</span></div></div>'}
  function renderBudgets(){q('[data-ai25-budget-list]',page).innerHTML=budgetRows().map(x=>`<div class="ai25-budget-row"><div><b>${esc(x.scope)} · ${esc(x.id)}</b><div class="ai25-budget-track"><i class="${stateClass(x.state)}" style="width:${Math.min(100,x.pct)}%"></i></div></div><span>${money(x.spent)}</span><span>/ ${money(x.amount)}</span><span class="ai25-state ${stateClass(x.state)}">${esc(x.state)}</span></div>`).join('')}
  function renderRates(){const root=q('[data-ai25-rate-list]',page);root.innerHTML=store.rateCards.slice().sort((a,b)=>b.version-a.version).map(r=>`<div class="ai25-rate"><div><strong>${esc(r.provider)} · ${esc(r.model)} · ${esc(r.mode)}</strong><span>v${r.version} · ${esc(r.status)} · Input ${r.input} / Cached ${r.cached} / Output ${r.output} $/1M</span><span>Effective ${esc(r.effective||'—')} · Owner ${esc(r.owner||'—')} · ${esc(r.source||'')}</span></div><div class="buttons">${r.status==='DRAFT'?`<button type="button" data-ai25-rate-confirm="${esc(r.id)}">Human Confirm</button>`:''}<span class="ai25-state ${r.status==='CONFIRMED'?'notice':'clear'}">${esc(r.status)}</span></div></div>`).join('');const active=store.rateCards.filter(r=>r.status==='CONFIRMED');q('[data-ai25-rate-active]',page).textContent=active.length?`${active.length} CONFIRMED`:'DEMO / SAMPLE'}
  function renderPrompts(){q('[data-ai25-prompt-list]',page).innerHTML=store.prompts.map(p=>`<div class="ai25-rate"><div><strong>${esc(p.id)} · ${esc(p.name)}</strong><span>Route ${esc(p.route)} · v${p.version} · ${esc(p.status)} · Owner ${esc(p.owner)}</span><span>${esc(p.note||'')}</span></div><span class="ai25-state ${p.status==='CONFIRMED'?'notice':'clear'}">${esc(p.status)}</span></div>`).join('');const sel=q('[data-ai25-run="prompt"]',page),cur=sel.value;sel.innerHTML=store.prompts.map(p=>`<option value="${esc(p.id)}">${esc(p.name)} · ${esc(p.route)} · v${p.version}</option>`).join('');if([...sel.options].some(o=>o.value===cur))sel.value=cur;syncPromptToTask()}
  function renderContexts(){q('[data-ai25-context-list]',page).innerHTML=store.contexts.map(c=>{const st=contextState(c);return `<div class="ai25-rate"><div><strong>${esc(c.id)} · ${esc(c.name)}</strong><span>v${c.version} · ${esc(c.status)} · Owner ${esc(c.owner)} · Access ${esc(c.access)}</span><span>Updated ${esc(c.updatedAt)} · Freshness ${c.freshnessDays}d · ${compact(c.tokens)} tokens</span></div><span class="ai25-state ${st==='FRESH'?'notice':st==='STALE'?'review':st==='BLOCKED'?'stop':'clear'}">${st}</span></div>`}).join('');const stale=store.contexts.filter(c=>contextState(c)==='STALE').length;q('[data-ai25-freshness-state]',page).textContent=stale?`${stale} STALE`:'FRESH';q('[data-ai25-freshness-state]',page).className=`ai25-state ${stale?'review':'notice'}`;renderContextPicker()}
  function renderContextPicker(){const root=q('[data-ai25-context-picker]',page),selected=new Set(qa('[data-ai25-context-check]:checked',root).map(x=>x.value));root.innerHTML=store.contexts.map(c=>{const st=contextState(c),disabled=st!=='FRESH';const checked=selected.has(c.id)||(!selected.size&&validContext(c)&&['BRAND_GUIDE','DAILYSKIN_BRIEF'].includes(c.id));return `<label class="ai25-context ${st==='STALE'?'is-stale':''} ${disabled?'is-blocked':''}"><input type="checkbox" data-ai25-context-check value="${esc(c.id)}" ${checked&&!disabled?'checked':''} ${disabled?'disabled':''}><span><b>${esc(c.name)} · v${c.version}</b><span>${esc(c.id)} · Owner ${esc(c.owner)} · ${esc(c.access)}</span><small>${st==='FRESH'?'사용 가능':st==='STALE'?'Freshness 만료 · Refresh 필요':st==='BLOCKED'?'Private 1:1 raw context · 자동 사용 금지':'Confirmed 필요'}</small></span><span class="meta">${compact(c.tokens)} tok<br>${st}</span></label>`}).join('');qa('[data-ai25-context-check]',root).forEach(x=>x.addEventListener('change',renderRunPreview));renderRunPreview()}
  function rateOptions(){return store.rateCards.map(r=>`<option value="${esc(r.id)}">${esc(r.model)} · v${r.version} · ${esc(r.status)}</option>`).join('')}
  function renderRouting(){const tbody=q('[data-ai25-routing-table] tbody',page);tbody.innerHTML=Object.entries(store.routing).map(([wf,r])=>`<tr data-ai25-route-row="${wf}"><td><b>${wf}</b></td><td><select data-route-field="primary">${rateOptions()}</select></td><td><select data-route-field="fallback"><option value="NONE">NONE</option>${rateOptions()}</select></td><td><select data-route-field="human"><option>NONE</option><option>VALIDATE</option><option>SELECT</option><option>REVIEW</option><option>REQUIRED</option></select></td></tr>`).join('');qa('[data-ai25-route-row]',tbody).forEach(row=>{const r=store.routing[row.dataset.ai25RouteRow];q('[data-route-field="primary"]',row).value=r.primary;q('[data-route-field="fallback"]',row).value=r.fallback;q('[data-route-field="human"]',row).value=r.human})}
  function syncPromptToTask(){const prompt=store.prompts.find(p=>p.id===q('[data-ai25-run="prompt"]',page)?.value);if(prompt&&q('[data-ai25-run="task"]',page))q('[data-ai25-run="task"]',page).value=prompt.route;renderRunPreview()}
  function runFields(){const get=n=>q(`[data-ai25-run="${n}"]`,page);return {team:get('team').value.trim(),project:get('project').value.trim(),task:get('task').value,purpose:get('purpose').value.trim(),prompt:get('prompt').value,result:get('result').value,input:Number(get('input').value||0),cached:Number(get('cached').value||0),output:Number(get('output').value||0),retries:Number(get('retries').value||0),artifact:get('artifact').value.trim(),contextIds:qa('[data-ai25-context-check]:checked',page).map(x=>x.value)}}
  function renderRunPreview(){if(!q('[data-ai25-route-preview]',page))return;const f=runFields(),route=store.routing[f.task]||store.routing.DRAFT,r=rate(route.primary),ctx=contextsByIds(f.contextIds),tok=ctx.reduce((s,c)=>s+Number(c.tokens||0),0),e={...f,rateCardId:route.primary},cost=eventCost(e);q('[data-ai25-route-preview]',page).innerHTML=`<b>Recommended Route · ${esc(f.task)}</b><p>${esc(r?.provider||'—')} / ${esc(r?.model||'—')} · Fallback ${esc(rate(route.fallback)?.model||route.fallback)} · Human ${esc(route.human)}</p><div class="route-line"><span class="ai25-chip">Selected SSOT ${ctx.length}</span><span class="ai25-chip">Context ≈ ${compact(tok)} tokens</span><span class="ai25-chip">Estimated run ${money(cost)}</span><span class="ai25-chip">Prompt ${esc(f.prompt||'—')}</span></div>`;q('[data-ai25-context-summary]',page).innerHTML=`<b>Context Pack Summary</b><p>${ctx.length?ctx.map(c=>`${esc(c.name)} v${c.version}`).join(' · '):'Context를 선택하세요.'}</p><div class="route-line"><span class="ai25-chip">Selected ${ctx.length}</span><span class="ai25-chip">≈ ${compact(tok)} tokens</span><span class="ai25-chip">Fresh only</span></div>`}
  let attrMode='TEAM';
  function renderAttribution(){const ev=filtered(),key=attrMode==='TEAM'?'team':'project',groups={};ev.forEach(e=>{const k=e[key]||'Unassigned';(groups[k]||(groups[k]=[])).push(e)});const rows=Object.entries(groups).sort((a,b)=>allCost(b[1])-allCost(a[1]));q('[data-ai25-attribution]',page).innerHTML=rows.map(([name,list])=>{const spend=allCost(list),accepted=list.filter(e=>e.result==='ACCEPTED'),tokens=list.reduce((s,e)=>s+Number(e.input||0)+Number(e.output||0),0),retry=list.reduce((s,e)=>s+Number(e.retries||0),0);return `<tr><td><b>${esc(name)}</b></td><td>${money(spend)}</td><td>${list.length}</td><td>${accepted.length}</td><td>${accepted.length?money(allCost(accepted)/accepted.length):'—'}</td><td>${compact(tokens)}</td><td>${retry}</td></tr>`}).join('')||'<tr><td colspan="7">선택 범위에 Usage Event가 없습니다.</td></tr>';qa('[data-ai25-attr-tab]',page).forEach(b=>b.classList.toggle('active',b.dataset.ai25AttrTab===attrMode))}
  function renderEvents(){const ev=filtered().slice().sort((a,b)=>b.at.localeCompare(a.at));q('[data-ai25-event-list]',page).innerHTML=ev.map(e=>{const r=rate(e.rateCardId),ctx=contextsByIds(e.contextIds);return `<tr><td>${new Date(e.at).toLocaleDateString('ko-KR')}</td><td class="wrap"><b>${esc(e.team)}</b><br>${esc(e.project)}</td><td>${esc(e.task)}<br><small>${esc(e.purpose)}</small></td><td>${esc(r?.model||e.rateCardId)}</td><td>${compact(Number(e.input||0)+Number(e.output||0))}<br><small>cached ${compact(e.cached)}</small></td><td>${money(eventCost(e))}</td><td>${esc(e.result)}<br><small>retry ${e.retries||0}</small></td><td class="wrap">${ctx.map(c=>esc(c.id)).join('<br>')}</td><td class="wrap">${esc(e.artifact||'—')}</td></tr>`}).join('')||'<tr><td colspan="9">선택 범위에 Usage Event가 없습니다.</td></tr>'}
  function renderToday(){const a=attentions(),box=q('[data-ai25-today-alert]'),list=q('[data-ai25-today-list]'),badge=q('[data-ai25-top-count]');if(badge)badge.textContent=String(a.length);if(!box||!list)return;box.hidden=!a.length;if(!a.length)return;list.innerHTML=a.slice(0,3).map(x=>`<div class="ai25-today-item"><div><b>${esc(x.title)}</b><span>${esc(x.copy)}</span></div><span class="ai25-state ${stateClass(x.state)}">${esc(x.state)}</span></div>`).join('')}
  function renderAll(){renderFilters();renderMetrics();renderAlerts();renderBudgets();renderRates();renderPrompts();renderContexts();renderRouting();renderAttribution();renderEvents();renderToday();renderRunPreview()}
  function openUsage(){ensureSystemNav();showCustomPage('AI_USAGE','AI Usage');setTimeout(renderAll,20)}
  document.addEventListener('click',e=>{if(e.target.closest('[data-ai25-open],[data-ai25-today-open],[data-ai25-attention-open]')){e.preventDefault();openUsage()}},true);
  qa('[data-ai25-filter]',page).forEach(x=>x.addEventListener('change',()=>{renderMetrics();renderAttribution();renderEvents()}));
  qa('[data-ai25-attr-tab]',page).forEach(b=>b.addEventListener('click',()=>{attrMode=b.dataset.ai25AttrTab;renderAttribution()}));
  q('[data-ai25-reset-demo]',page)?.addEventListener('click',()=>{store=demo();save();renderAll()});
  q('[data-ai25-go-billing]',page)?.addEventListener('click',()=>q('[data-fallback-page="BILLING"]')?.click());
  q('[data-ai25-budget-save]',page)?.addEventListener('click',()=>{const scope=q('[data-ai25-budget="scope"]',page).value,id=q('[data-ai25-budget="id"]',page).value.trim()||'Unassigned',amount=Number(q('[data-ai25-budget="amount"]',page).value||0),owner=q('[data-ai25-budget="owner"]',page).value.trim();const old=store.budgets.find(b=>b.scope===scope&&b.id===id);if(old){old.amount=amount;old.owner=owner}else store.budgets.push({scope,id,amount,owner});save();renderAll()});
  q('[data-ai25-run="prompt"]',page)?.addEventListener('change',syncPromptToTask);q('[data-ai25-run="task"]',page)?.addEventListener('change',renderRunPreview);qa('[data-ai25-run]',page).forEach(x=>x.addEventListener('input',renderRunPreview));q('[data-ai25-run-estimate]',page)?.addEventListener('click',renderRunPreview);
  q('[data-ai25-run-save]',page)?.addEventListener('click',()=>{const f=runFields(),route=store.routing[f.task]||store.routing.DRAFT;if(!f.team||!f.project){alert('Team과 Project를 입력하세요.');return}store.events.push({id:uid('UE'),at:nowIso(),user:'preview-user',team:f.team,project:f.project,task:f.task,purpose:f.purpose,rateCardId:route.primary,input:f.input,cached:Math.min(f.cached,f.input),output:f.output,retries:f.retries,result:f.result,contextIds:f.contextIds,artifact:f.artifact,promptId:f.prompt});save();renderAll()});
  q('[data-ai25-rate-save]',page)?.addEventListener('click',()=>{const g=n=>q(`[data-ai25-rate="${n}"]`,page).value.trim(),sig=[g('provider'),g('model'),g('mode')].join('|');const versions=store.rateCards.filter(r=>r.signature===sig);store.rateCards.push({id:uid('RC'),signature:sig,provider:g('provider'),model:g('model'),mode:g('mode'),effective:g('effective'),input:Number(g('input')||0),cached:Number(g('cached')||0),output:Number(g('output')||0),owner:g('owner'),source:g('source'),version:Math.max(0,...versions.map(x=>Number(x.version||0)))+1,status:'DRAFT',updatedAt:nowIso()});save();renderAll()});
  page.addEventListener('click',e=>{const b=e.target.closest('[data-ai25-rate-confirm]');if(!b)return;const r=store.rateCards.find(x=>x.id===b.dataset.ai25RateConfirm);if(!r)return;store.rateCards.filter(x=>x.signature===r.signature&&x.id!==r.id&&x.status==='CONFIRMED').forEach(x=>x.status='ARCHIVED');r.status='CONFIRMED';r.confirmedAt=nowIso();save();renderAll()});
  q('[data-ai25-routing-save]',page)?.addEventListener('click',()=>{qa('[data-ai25-route-row]',page).forEach(row=>{store.routing[row.dataset.ai25RouteRow]={primary:q('[data-route-field="primary"]',row).value,fallback:q('[data-route-field="fallback"]',row).value,human:q('[data-route-field="human"]',row).value}});save();renderAll()});
  q('[data-ai25-prompt-save]',page)?.addEventListener('click',()=>{const g=n=>q(`[data-ai25-prompt="${n}"]`,page).value.trim(),id=g('id')||uid('PROMPT');const old=store.prompts.filter(p=>p.id===id);store.prompts.push({id,name:g('name')||id,route:g('route')||'DRAFT',owner:g('owner')||'AI Ops',version:Math.max(0,...old.map(x=>Number(x.version||0)))+1,status:'DRAFT',updatedAt:new Date().toISOString().slice(0,10),note:g('note')});save();renderAll()});
  q('[data-ai25-context-save]',page)?.addEventListener('click',()=>{const g=n=>q(`[data-ai25-context="${n}"]`,page).value.trim(),id=g('id')||uid('CTX');store.contexts.push({id,name:g('name')||id,owner:g('owner')||'PMO',version:Number(g('version')||1),status:g('status')||'DRAFT',updatedAt:g('updated')||new Date().toISOString().slice(0,10),freshnessDays:Number(g('freshness')||30),access:g('access')||'WORKSPACE',tokens:Number(g('tokens')||0)});save();renderAll()});
  q('[data-ai25-today-open]')?.addEventListener('click',openUsage);
  document.addEventListener('click',e=>{if(e.target.closest('[data-fallback-page="TODAY"]'))setTimeout(renderToday,30);if(e.target.closest('[data-fallback-page="AI_USAGE"]'))setTimeout(renderAll,30)},true);
  ensureSystemNav();setTimeout(ensureSystemNav,250);setTimeout(ensureSystemNav,1200);
  const navObserver=new MutationObserver(()=>ensureSystemNav());const primary=q('[data-primary-nav]');if(primary)navObserver.observe(primary,{childList:true,subtree:true});
  renderAll();
  window.LeaderOsAiUsageBridge={get:()=>store,save:(next)=>{store=next;save();renderAll();return store},render:renderAll};
  window.LeaderOsAiUsageAudit=()=>({events:store.events.length,budgets:store.budgets.length,rateCards:store.rateCards.length,prompts:store.prompts.length,contexts:store.contexts.length,attentions:attentions(),staleContexts:store.contexts.filter(c=>contextState(c)==='STALE').map(c=>c.id),duplicateIds:[...document.querySelectorAll('[id]')].map(x=>x.id).filter((x,i,a)=>a.indexOf(x)!==i)});
})();
</script>
<script id="recovery-26-team-ssot-js">
(function(){
  const q=(s,r=document)=>r.querySelector(s), qa=(s,r=document)=>[...r.querySelectorAll(s)];
  const page=q('[data-page="TEAM_SSOT_PLAN"]'); if(!page)return;
  const AI_KEY='leader-os:ai-usage-runtime:v1', PLAN_KEY='leader-os:team-ssot-plan:v1', CONF_KEY='leader-os:team-ssot-confirmed:v1';
  const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const load=(key,fallback)=>{try{return JSON.parse(localStorage.getItem(key)||'null')||fallback}catch{return fallback}};
  const save=(key,val)=>{try{localStorage.setItem(key,JSON.stringify(val))}catch{}};
  const uid=p=>`${p}-${Date.now().toString(36)}-${Math.random().toString(36).slice(2,6)}`;
  const now=()=>new Date().toISOString();
  let ai=load(AI_KEY,{events:[],budgets:[],rateCards:[],contexts:[],prompts:[],routing:{}}), plans=load(PLAN_KEY,[]), confirmed=load(CONF_KEY,[]), draft=null;
  const rate=id=>(ai.rateCards||[]).find(r=>r.id===id)||null;
  const eventCost=e=>{const r=rate(e.rateCardId);if(!r)return 0;const cached=Math.min(+e.cached||0,+e.input||0),normal=Math.max(0,(+e.input||0)-cached);return normal/1e6*(+r.input||0)+cached/1e6*(+r.cached||0)+(+e.output||0)/1e6*(+r.output||0)};
  const money=n=>'$'+(+n||0).toFixed(2), compact=n=>{n=+n||0;return n>=1e6?(n/1e6).toFixed(n>=1e7?1:2)+'M':n>=1e3?(n/1e3).toFixed(1)+'K':Math.round(n).toLocaleString()};
  const daysOld=iso=>Math.max(0,Math.floor((Date.now()-new Date(iso).getTime())/86400000));
  const contextState=c=>c.access==='PRIVATE_1ON1'?'BLOCKED':c.status!=='CONFIRMED'?'DRAFT':daysOld(c.updatedAt)>+(c.freshnessDays||30)?'STALE':'FRESH';
  const teams=()=>[...new Set((ai.events||[]).map(e=>e.team).filter(Boolean))].sort();
  function showPage(){qa('[data-page]').forEach(x=>x.hidden=x!==page);qa('[data-primary-nav] a').forEach(a=>a.removeAttribute('aria-current'));q('[data-ai26-nav="TEAM_SSOT_PLAN"]')?.setAttribute('aria-current','page');const t=q('[data-topbar-title]');if(t)t.textContent='Team SSOT Plan';history.replaceState(null,'','#team-ssot-plan');render();window.scrollTo({top:0,behavior:'auto'})}
  function ensureNav(){const nav=q('[data-primary-nav]');if(!nav)return;let a=q('[data-ai26-nav="TEAM_SSOT_PLAN"]',nav);if(!a){const sys=qa('.nav-section',nav).find(sec=>q('.nav-label',sec)?.textContent.trim()==='SYSTEM')||qa('.nav-section',nav).at(-1);if(!sys)return;a=document.createElement('a');a.href='#team-ssot-plan';a.dataset.ai26Nav='TEAM_SSOT_PLAN';a.textContent='Team SSOT Plan';const bill=qa('a',sys).find(x=>/Billing/i.test(x.textContent||''));bill?bill.insertAdjacentElement('beforebegin',a):sys.append(a)}a.onclick=e=>{e.preventDefault();showPage()}}
  function syncAI(){const bridged=window.LeaderOsAiUsageBridge?.get?.();ai=bridged||load(AI_KEY,ai);plans=load(PLAN_KEY,plans);confirmed=load(CONF_KEY,confirmed)}
  function persistAI(){if(window.LeaderOsAiUsageBridge?.save)window.LeaderOsAiUsageBridge.save(ai);else save(AI_KEY,ai)}
  function teamName(){return q('[data-ai26-team]',page)?.value||teams()[0]||'Unassigned'}
  function teamEvents(team=teamName()){return (ai.events||[]).filter(e=>e.team===team)}
  function teamBudget(team=teamName()){return (ai.budgets||[]).find(b=>b.scope==='TEAM'&&b.id===team)||null}
  function usage(team=teamName()){
    const ev=teamEvents(team),spend=ev.reduce((s,e)=>s+eventCost(e),0),tokens=ev.reduce((s,e)=>s+(+e.input||0)+(+e.output||0),0),input=ev.reduce((s,e)=>s+(+e.input||0),0),cached=ev.reduce((s,e)=>s+(+e.cached||0),0),accepted=ev.filter(e=>e.result==='ACCEPTED').length,retry=ev.reduce((s,e)=>s+(+e.retries||0),0),budget=teamBudget(team),pct=budget?.amount?spend/+budget.amount*100:0;
    const ctxIds=[...new Set(ev.flatMap(e=>e.contextIds||[]))],ctx=ctxIds.map(id=>(ai.contexts||[]).find(c=>c.id===id)).filter(Boolean),fresh=ctx.filter(c=>contextState(c)==='FRESH').length;
    return {ev,spend,tokens,input,cached,accepted,retry,budget,pct,contexts:ctx,coverage:ctx.length?fresh/ctx.length*100:0,costAccepted:accepted?spend/accepted:0};
  }
  function generateCandidates(team=teamName()){
    const u=usage(team),counts={},artifacts={},tasks={};
    u.ev.forEach(e=>{(e.contextIds||[]).forEach(id=>counts[id]=(counts[id]||0)+1);if(e.artifact&&e.result==='ACCEPTED')artifacts[e.artifact]=(artifacts[e.artifact]||0)+1;tasks[e.task]=(tasks[e.task]||{count:0,retry:0,accepted:0});tasks[e.task].count++;tasks[e.task].retry+=+e.retries||0;if(e.result==='ACCEPTED')tasks[e.task].accepted++});
    const arr=[];
    Object.entries(counts).sort((a,b)=>b[1]-a[1]).forEach(([id,n])=>{const c=(ai.contexts||[]).find(x=>x.id===id),st=c?contextState(c):'MISSING';arr.push({id:'CTX:'+id,type:'CONTEXT',title:c?.name||id,source:id,priority:st==='STALE'||st==='MISSING'?'P0':n>=2?'P1':'P2',reason:`${n}회 참조 · ${st}`,action:st==='STALE'?'Owner가 Refresh 후 새 Context Pack 버전을 Confirm':'Owner/Freshness/Access를 유지하며 Canonical Context로 관리',owner:c?.owner||q('[data-ai26-owner]',page)?.value||'Team Ops'});});
    Object.entries(artifacts).forEach(([a,n])=>arr.push({id:'ART:'+a,type:'ARTIFACT',title:a,source:a,priority:'P1',reason:`Accepted Output ${n}회 · 재사용 가능성`,action:'Human Review 후 Team Knowledge Context로 승격',owner:q('[data-ai26-owner]',page)?.value||'Team Lead'}));
    Object.entries(tasks).sort((a,b)=>b[1].count-a[1].count).slice(0,2).forEach(([task,x])=>arr.push({id:'WF:'+task,type:'WORKFLOW',title:`${task} Workflow`,source:task,priority:x.retry>=3?'P1':'P2',reason:`${x.count} Runs · Accepted ${x.accepted} · Retry ${x.retry}`,action:x.retry>=3?'Prompt Pack/Context/Stop Condition을 표준화':'재사용 Prompt Pack과 Output Schema를 유지',owner:'AI Ops'}));
    return arr.sort((a,b)=>({P0:0,P1:1,P2:2}[a.priority]-({P0:0,P1:1,P2:2}[b.priority])));
  }
  function buildDraft(){const team=teamName(),horizon=+q('[data-ai26-horizon]',page).value||30,owner=q('[data-ai26-owner]',page).value.trim()||'Team Ops',u=usage(team);draft={id:uid('SSOTPLAN'),team,horizon,owner,status:'DRAFT',version:1,createdAt:now(),snapshot:{spend:u.spend,tokens:u.tokens,accepted:u.accepted,retry:u.retry,coverage:u.coverage},candidates:generateCandidates(team)};render()}
  function currentPlan(){return draft||plans.filter(p=>p.team===teamName()).sort((a,b)=>new Date(b.updatedAt||b.createdAt)-new Date(a.updatedAt||a.createdAt))[0]||null}
  function savePlan(){if(!draft)buildDraft();const p=draft;const prev=plans.filter(x=>x.team===p.team);p.version=Math.max(0,...prev.map(x=>+x.version||0))+1;p.updatedAt=now();plans.push(JSON.parse(JSON.stringify(p)));save(PLAN_KEY,plans);draft=p;render()}
  function confirmPlan(){let p=currentPlan();if(!p){buildDraft();p=draft}p={...p,status:'CONFIRMED',confirmedAt:now(),updatedAt:now()};plans=plans.filter(x=>x.id!==p.id);plans.push(p);save(PLAN_KEY,plans);draft=p;render()}
  function forecast(team=teamName()){
    const u=usage(team),ev=u.ev;if(!ev.length)return {spend:0,forecast:0,days:0};const dates=ev.map(e=>new Date(e.at)).filter(d=>!isNaN(d));const latest=new Date(Math.max(...dates.map(d=>d.getTime()))),monthDays=new Date(latest.getFullYear(),latest.getMonth()+1,0).getDate(),elapsed=Math.max(1,latest.getDate()),fc=u.spend/elapsed*monthDays;return {spend:u.spend,forecast:fc,days:elapsed,monthDays};
  }
  function anomalies(team=teamName()){
    const u=usage(team),out=[];u.ev.filter(e=>(+e.retries||0)>=3).forEach(e=>out.push({kind:'RETRY SPIKE',copy:`${e.purpose} · retry ${e.retries}`,level:'P1'}));
    const ctxCount={};u.ev.forEach(e=>(e.contextIds||[]).forEach(id=>ctxCount[id]=(ctxCount[id]||0)+1));Object.entries(ctxCount).filter(([,n])=>n>=2).forEach(([id,n])=>{const related=u.ev.filter(e=>(e.contextIds||[]).includes(id)),input=related.reduce((s,e)=>s+(+e.input||0),0),cached=related.reduce((s,e)=>s+(+e.cached||0),0);if(input&&cached/input<.25)out.push({kind:'LOW REUSE',copy:`${id} ${n}회 사용 · cached ${(cached/input*100).toFixed(0)}%`,level:'P1'})});
    u.ev.forEach(e=>{const route=ai.routing?.[e.task],expected=route?.primary;if(expected&&e.rateCardId!==expected)out.push({kind:'ROUTE MISMATCH',copy:`${e.purpose} · ${e.rateCardId} (policy ${expected})`,level:'P2'})});
    return out.slice(0,6);
  }
  function renderTeams(){const sel=q('[data-ai26-team]',page),cur=sel.value||teamName(),list=teams();sel.innerHTML=list.map(t=>`<option>${esc(t)}</option>`).join('')||'<option>Unassigned</option>';sel.value=list.includes(cur)?cur:(list[0]||'Unassigned');if(!q('[data-ai26-owner]',page).value){q('[data-ai26-owner]',page).value=teamBudget(sel.value)?.owner||'Team Ops'}}
  function renderMetrics(){const u=usage(),f=forecast(),b=u.budget,pct=b?.amount?u.spend/+b.amount*100:0;const state=pct>=100?'STOP':pct>=85?'REVIEW':pct>=70?'NOTICE':'CLEAR';q('[data-ai26-metrics]',page).innerHTML=[['Credit Spend',money(u.spend),b?`${money(b.amount)} Team Budget · ${pct.toFixed(0)}%`:'Team Budget 미설정'],['Tokens',compact(u.tokens),`${u.ev.length} Usage Events`],['Accepted',u.accepted,`${money(u.costAccepted)} / Accepted`],['SSOT Coverage',u.coverage.toFixed(0)+'%',`${u.contexts.length} referenced contexts`],['Month Forecast',money(f.forecast),`${state} · ${f.days||0}/${f.monthDays||0} days`]].map(x=>`<div class="ai26-metric"><small>${x[0]}</small><strong>${x[1]}</strong><span>${x[2]}</span></div>`).join('')}
  function renderSignals(){const u=usage(),freq={};u.ev.forEach(e=>(e.contextIds||[]).forEach(id=>freq[id]=(freq[id]||0)+1));const top=Object.entries(freq).sort((a,b)=>b[1]-a[1]).slice(0,4);const rows=[...top.map(([id,n])=>({b:`Context ${id}`,s:`${n}회 참조 · ${contextState((ai.contexts||[]).find(c=>c.id===id)||{})}`})),{b:'Accepted Output',s:`${u.accepted}/${u.ev.length} Runs accepted · Cost/Accepted ${money(u.costAccepted)}`},{b:'Retry Load',s:`총 ${u.retry} retries · Retry가 많은 Workflow는 Prompt/Context 표준화 후보`}];q('[data-ai26-signals]',page).innerHTML=rows.map(x=>`<div class="ai26-signal"><b>${esc(x.b)}</b><span>${esc(x.s)}</span></div>`).join('')}
  function renderForecast(){const f=forecast(),u=usage(),b=u.budget,pct=b?.amount?f.forecast/+b.amount*100:0,state=pct>=100?'STOP':pct>=85?'REVIEW':pct>=70?'NOTICE':'CLEAR';q('[data-ai26-forecast]',page).innerHTML=`<div class="ai26-note"><b>${esc(state)}</b> · Current ${money(f.spend)} → Month-end ${money(f.forecast)}${b?` / Budget ${money(b.amount)} (${pct.toFixed(0)}%)`:''}</div>`;const a=anomalies();q('[data-ai26-anomalies]',page).innerHTML=a.length?a.map(x=>`<div class="ai26-anomaly"><b>${esc(x.kind)}</b><span>${esc(x.copy)}</span></div>`).join(''):'<div class="ai26-empty">현재 Demo 데이터에서 강한 Anomaly가 없습니다.</div>'}
  function renderPlan(){const p=currentPlan(),state=q('[data-ai26-plan-state]',page);state.textContent=p?.status||'DRAFT';state.className=`ai26-state ${(p?.status||'DRAFT').toLowerCase()}`;const items=p?.candidates||generateCandidates();q('[data-ai26-plan-list]',page).innerHTML=items.length?items.map(c=>`<div class="ai26-plan-item"><div class="ai26-plan-top"><div><b>${esc(c.title)}</b><span>${esc(c.reason)}</span></div><span class="ai26-state ${c.priority.toLowerCase()}">${esc(c.priority)}</span></div><div class="ai26-plan-meta"><span class="ai26-chip">${esc(c.type)}</span><span class="ai26-chip">Owner · ${esc(c.owner)}</span><span class="ai26-chip">${esc(c.action)}</span></div></div>`).join(''):'<div class="ai26-empty">Usage가 아직 없어 SSOT 후보를 만들 수 없습니다.</div>'}
  function renderResolver(){const root=q('[data-ai26-resolver]',page),team=teamName(),project=q('[data-ai26-resolve-project]',page).value.trim(),task=q('[data-ai26-resolve-task]',page).value;const usedIds=[...new Set(teamEvents(team).filter(e=>!project||e.project===project).flatMap(e=>e.contextIds||[]))];const all=(ai.contexts||[]).filter(c=>contextState(c)==='FRESH'&&c.access!=='PRIVATE_1ON1');const ranked=[...all].sort((a,b)=>(usedIds.includes(b.id)?1:0)-(usedIds.includes(a.id)?1:0));root.innerHTML=ranked.length?ranked.map(c=>`<div class="ai26-resolver-item"><b>${esc(c.name)} · v${esc(c.version)}</b><span>${esc(c.id)} · Owner ${esc(c.owner)} · ${esc(c.access)} · ${usedIds.includes(c.id)?'Team usage evidence 있음':'General confirmed context'}</span></div>`).join(''):'<div class="ai26-empty">Fresh + Confirmed Context가 없습니다.</div>'}
  function reviewCandidates(){const existing=new Set(confirmed.map(x=>x.sourceEvent));return teamEvents().filter(e=>e.artifact&&(e.result==='ACCEPTED'||e.result==='REVISED')&&!existing.has(e.id)).sort((a,b)=>new Date(b.at)-new Date(a.at)).slice(0,8)}
  function renderReview(){const root=q('[data-ai26-review-list]',page),rows=reviewCandidates();root.innerHTML=rows.length?rows.map(e=>`<div class="ai26-review"><div class="ai26-review-top"><div><b>${esc(e.artifact)}</b><span>${esc(e.purpose)} · ${esc(e.result)} · ${money(eventCost(e))}</span></div><button type="button" data-ai26-confirm-artifact="${esc(e.id)}">검토 후 SSOT 승격</button></div></div>`).join(''):'<div class="ai26-empty">현재 팀에서 검토 대기 중인 Output이 없습니다.</div>'}
  function confirmArtifact(id){const e=(ai.events||[]).find(x=>x.id===id);if(!e||!e.artifact)return;const team=teamName(),owner=q('[data-ai26-owner]',page).value.trim()||'Team Lead',rec={id:uid('TSSOT'),name:e.artifact,team,owner,sourceEvent:e.id,sourcePurpose:e.purpose,version:1,status:'CONFIRMED',confirmedAt:now()};confirmed.push(rec);save(CONF_KEY,confirmed);const ctxId='ART_'+e.artifact.replace(/[^A-Za-z0-9]+/g,'_').toUpperCase();if(!(ai.contexts||[]).some(c=>c.id===ctxId)){ai.contexts=ai.contexts||[];ai.contexts.push({id:ctxId,name:e.artifact,owner,version:1,status:'CONFIRMED',updatedAt:new Date().toISOString().slice(0,10),freshnessDays:30,access:'TEAM',tokens:1500,sourceArtifact:e.artifact});persistAI()}render()}
  function renderConfirmed(){const rows=confirmed.filter(x=>x.team===teamName()).sort((a,b)=>new Date(b.confirmedAt)-new Date(a.confirmedAt));q('[data-ai26-confirmed-table]',page).innerHTML=rows.length?rows.map(x=>`<tr><td><b>${esc(x.name)}</b></td><td>${esc(x.team)}</td><td>${esc(x.owner)}</td><td>${esc(x.sourceEvent)}</td><td>v${esc(x.version)}</td><td>${esc(new Date(x.confirmedAt).toLocaleString())}</td></tr>`).join(''):'<tr><td colspan="6">아직 Confirmed Team SSOT가 없습니다.</td></tr>'}
  function renderReconciliation(){const ev=teamEvents(),withP=ev.filter(e=>e.providerReportedCost!=null),norm=withP.reduce((s,e)=>s+eventCost(e),0),prov=withP.reduce((s,e)=>s+(+e.providerReportedCost||0),0),delta=prov-norm;q('[data-ai26-reconciliation]',page).innerHTML=withP.length?`<div class="ai26-note">${withP.length} events reconciled · Provider ${money(prov)} vs Normalized ${money(norm)} · Delta ${delta>=0?'+':''}${money(delta)}</div>`:'<div class="ai26-empty">Provider reported cost가 아직 없습니다. DEMO 정산을 불러오면 비교됩니다.</div>'}
  function ingestProvider(){const ev=teamEvents();ev.forEach((e,i)=>{if(e.providerReportedCost==null)e.providerReportedCost=+(eventCost(e)*(i%2?0.985:1.018)).toFixed(4);e.providerRunId=e.providerRunId||`demo-run-${e.id}`;e.reconciledAt=now()});persistAI();render()}
  function renderRouting(){const u=usage(),by={};u.ev.forEach(e=>{const k=e.task||'UNKNOWN';by[k]=by[k]||{n:0,ok:0,cost:0,retry:0};by[k].n++;if(e.result==='ACCEPTED')by[k].ok++;by[k].cost+=eventCost(e);by[k].retry+=+e.retries||0});q('[data-ai26-routing-rec]',page).innerHTML=Object.entries(by).map(([k,x])=>{const rate=x.n?x.ok/x.n*100:0,avg=x.n?x.cost/x.n:0,msg=x.retry/x.n>1.5?'Retry가 높습니다. Model downgrade 전에 Prompt/Context/Stop Condition을 먼저 점검하세요.':rate>=80?'Accepted Rate가 안정적입니다. 같은 Route를 유지하며 더 저렴한 Fallback A/B를 검토할 수 있습니다.':'Accepted Rate가 낮습니다. Route 변경보다 먼저 Evidence와 Context 품질을 확인하세요.';return `<div class="ai26-resolver-item"><b>${esc(k)} · Accepted ${rate.toFixed(0)}%</b><span>Avg Cost ${money(avg)} · Retry ${x.retry} · ${esc(msg)}</span></div>`}).join('')||'<div class="ai26-empty">Routing 분석할 Event가 없습니다.</div>'}
  function render(){syncAI();renderTeams();renderMetrics();renderSignals();renderForecast();renderPlan();renderResolver();renderReview();renderConfirmed();renderReconciliation();renderRouting()}
  document.addEventListener('click',e=>{if(e.target.closest('[data-ai26-open]')){e.preventDefault();showPage()}},true);
  q('[data-ai26-go-usage]',page)?.addEventListener('click',()=>q('[data-ai25-open]')?.click());
  q('[data-ai26-team]',page)?.addEventListener('change',()=>{draft=null;render()});q('[data-ai26-generate]',page)?.addEventListener('click',()=>{buildDraft();render()});q('[data-ai26-save-plan]',page)?.addEventListener('click',savePlan);q('[data-ai26-confirm-plan]',page)?.addEventListener('click',confirmPlan);q('[data-ai26-resolve]',page)?.addEventListener('click',renderResolver);q('[data-ai26-ingest-provider]',page)?.addEventListener('click',ingestProvider);
  page.addEventListener('click',e=>{const b=e.target.closest('[data-ai26-confirm-artifact]');if(b)confirmArtifact(b.dataset.ai26ConfirmArtifact)});
  q('[data-ai26-owner]',page)?.addEventListener('input',()=>{if(draft){draft.owner=q('[data-ai26-owner]',page).value;draft.candidates.forEach(c=>{if(c.type!=='CONTEXT')c.owner=draft.owner||c.owner});renderPlan()}});
  ensureNav();setTimeout(ensureNav,250);setTimeout(ensureNav,1200);const nav=q('[data-primary-nav]');if(nav)new MutationObserver(ensureNav).observe(nav,{childList:true,subtree:true});
  window.addEventListener('storage',e=>{if([AI_KEY,PLAN_KEY,CONF_KEY].includes(e.key))render()});
  render();
  window.LeaderOsTeamSsotBridge={getPlans:()=>plans,getConfirmed:()=>confirmed,getCurrent:()=>({plans,confirmed,team:teamName()}),render:render};
  window.LeaderOsTeamSsotAudit=()=>({teams:teams(),plans:plans.length,confirmed:confirmed.length,team:teamName(),candidates:(currentPlan()?.candidates||generateCandidates()).length,anomalies:anomalies(),contexts:(ai.contexts||[]).map(c=>({id:c.id,state:contextState(c)})),duplicateIds:[...document.querySelectorAll('[id]')].map(x=>x.id).filter((x,i,a)=>a.indexOf(x)!==i)});
})();
</script>
<script id="recovery-27-ai-operating-review-js">
(()=>{
  const q=(s,r=document)=>r.querySelector(s),qa=(s,r=document)=>[...r.querySelectorAll(s)],esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const page=q('[data-page="AI_OPERATING_REVIEW"]');if(!page)return;
  document.title='Leader OS · Recovery 31 · Flow Time & Team Directory';
  const KEY='leader-os:ai-operating-review:v1', AI_KEY='leader-os:ai-usage-runtime:v1', CONF_KEY='leader-os:team-ssot-confirmed:v1';
  const load=(k,d)=>{try{const v=JSON.parse(localStorage.getItem(k)||'null');return v??d}catch{return d}}, save=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch{}};
  const now=()=>new Date().toISOString(),money=n=>'$'+Number(n||0).toFixed(2),compact=n=>{n=+n||0;return n>=1e6?(n/1e6).toFixed(2)+'M':n>=1e3?(n/1e3).toFixed(1)+'K':Math.round(n).toLocaleString()},norm=s=>String(s||'').toLowerCase().replace(/:v\d+$/,'').replace(/[^a-z0-9가-힣]+/g,'');
  const state=load(KEY,{history:[],packs:[],adapterSync:{},reminders:[]});
  const demoAdapters=[
    {id:'demo',name:'Demo Provider',cap:'Usage + cost + model/mode',status:'DEMO',action:'DEMO Sync'},
    {id:'openai',name:'OpenAI API',cap:'Usage / billing adapter contract',status:'DISCONNECTED',action:'Contract only'},
    {id:'gemini',name:'Google Gemini',cap:'Usage / caching / service mode contract',status:'DISCONNECTED',action:'Contract only'},
    {id:'custom',name:'Custom Gateway',cap:'Normalized usage_event adapter',status:'DISCONNECTED',action:'Contract only'}
  ];
  function ai(){return window.LeaderOsAiUsageBridge?.get?.()||load(AI_KEY,{events:[],budgets:[],rateCards:[],contexts:[],routing:{}})}
  function confirmed(){return window.LeaderOsTeamSsotBridge?.getConfirmed?.()||load(CONF_KEY,[])}
  function teams(){return [...new Set((ai().events||[]).map(e=>e.team).filter(Boolean))].sort()}
  function team(){return q('[data-ai27-team]',page)?.value||'ALL'}
  function events(t=team()){const all=ai().events||[];return t==='ALL'?all:all.filter(e=>e.team===t)}
  function rate(id){return (ai().rateCards||[]).find(r=>r.id===id)||null}
  function eventCost(e){const r=rate(e.rateCardId);if(!r)return 0;const cached=Math.min(+e.cached||0,+e.input||0),normal=Math.max(0,(+e.input||0)-cached);return normal/1e6*(+r.input||0)+cached/1e6*(+r.cached||0)+(+e.output||0)/1e6*(+r.output||0)}
  function ctxState(c){if(c.access==='PRIVATE_1ON1')return'BLOCKED';if(c.status!=='CONFIRMED')return'DRAFT';const age=(Date.now()-new Date(c.updatedAt).getTime())/86400000;return age>(+c.freshnessDays||30)?'STALE':'FRESH'}
  function usedContextIds(t=team()){return [...new Set(events(t).flatMap(e=>e.contextIds||[]))]}
  function metrics(t=team()){
    const ev=events(t),spend=ev.reduce((s,e)=>s+eventCost(e),0),tokens=ev.reduce((s,e)=>s+(+e.input||0)+(+e.output||0),0),accepted=ev.filter(e=>e.result==='ACCEPTED'||e.result==='REVISED').length,retry=ev.reduce((s,e)=>s+(+e.retries||0),0),ids=usedContextIds(t),contexts=ids.map(id=>(ai().contexts||[]).find(c=>c.id===id)).filter(Boolean),fresh=contexts.filter(c=>ctxState(c)==='FRESH').length,coverage=contexts.length?fresh/contexts.length*100:0,assets=confirmed().filter(x=>t==='ALL'||x.team===t).length;
    const budget=(ai().budgets||[]).filter(b=>t==='ALL'?b.scope==='ORG':b.scope==='TEAM'&&b.id===t).reduce((s,b)=>s+(+b.amount||0),0);
    return{ev,spend,tokens,accepted,retry,contexts,fresh,coverage,assets,budget,costAccepted:accepted?spend/accepted:0}
  }
  function anomalies(t=team()){const m=metrics(t),out=[];if(m.ev.length&&m.retry/m.ev.length>1.5)out.push('Retry spike');const input=m.ev.reduce((s,e)=>s+(+e.input||0),0),cached=m.ev.reduce((s,e)=>s+(+e.cached||0),0);if(input&&cached/input<.25)out.push('Low context reuse');m.ev.forEach(e=>{const p=ai().routing?.[e.task]?.primary;if(p&&e.rateCardId!==p&&!out.includes('Route mismatch'))out.push('Route mismatch')});if(m.contexts.some(c=>ctxState(c)==='STALE'))out.push('Stale SSOT');return out}
  function currentCoverage(t=team()){return metrics(t).coverage}
  function coverageHistory(t=team()){
    const real=state.history.filter(x=>x.team===t).slice(-4);if(real.length>=2)return real;
    const c=currentCoverage(t),vals=[Math.max(10,c-28),Math.max(15,c-18),Math.max(20,c-9),c];return vals.map((v,i)=>({team:t,label:i<3?`DEMO W${i+1}`:'NOW',coverage:+v.toFixed(1),demo:i<3,at:i<3?null:now()}))
  }
  function snapshot(){const t=team(),d=new Date();state.history.push({team:t,label:`${String(d.getMonth()+1).padStart(2,'0')}/${String(d.getDate()).padStart(2,'0')}`,coverage:+currentCoverage(t).toFixed(1),at:now()});state.history=state.history.slice(-60);save(KEY,state);renderTrend()}
  function renderTeamSelect(){const s=q('[data-ai27-team]',page),cur=s.value||'ALL';s.innerHTML='<option>ALL</option>'+teams().map(t=>`<option>${esc(t)}</option>`).join('');s.value=[...s.options].some(o=>o.value===cur)?cur:'ALL'}
  function renderMetrics(){const m=metrics(),anom=anomalies(),conv=m.accepted?m.assets/m.accepted*100:0;const rows=[['Spend',money(m.spend),m.budget?`${money(m.budget)} budget`:'Budget scope 없음'],['Tokens',compact(m.tokens),`${m.ev.length} usage events`],['SSOT Coverage',m.coverage.toFixed(0)+'%',`${m.fresh}/${m.contexts.length} referenced contexts fresh`],['Knowledge Conversion',conv.toFixed(0)+'%',`${m.assets} confirmed / ${m.accepted} accepted`],['Operating Risk',anom.length,anom.length?anom.join(' · '):'No strong signal']];q('[data-ai27-metrics]',page).innerHTML=rows.map(x=>`<div class="ai27-metric"><small>${x[0]}</small><strong>${x[1]}</strong><span>${esc(x[2])}</span></div>`).join('')}
  function renderTrend(){const h=coverageHistory();q('[data-ai27-trend]',page).innerHTML=h.map(x=>`<div class="ai27-trend-col"><div class="ai27-trend-bar-wrap"><div class="ai27-trend-bar" style="height:${Math.max(5,Math.min(100,x.coverage))}%"></div></div><b>${x.coverage.toFixed(0)}%</b><small>${esc(x.label)} ${x.demo?'<span class="ai27-demo-badge">DEMO</span>':''}</small></div>`).join('')}
  function renderAdapters(){q('[data-ai27-adapters]',page).innerHTML=demoAdapters.map(a=>{const sync=state.adapterSync[a.id];return `<div class="ai27-row"><div class="ai27-row-main"><b>${esc(a.name)}</b><span>${esc(a.cap)}${sync?` · Last demo sync ${new Date(sync.at).toLocaleString()} · ${sync.events} events`:''}</span></div><div class="ai27-row-actions"><span class="ai27-state ${a.status==='DEMO'?'info':''}">${a.status}</span>${a.id==='demo'?'<button type="button" class="ai27-btn" data-ai27-sync="demo">DEMO Sync</button>':'<span class="ai27-state">Contract only</span>'}</div></div>`}).join('')}
  function syncDemo(){state.adapterSync.demo={at:now(),events:(ai().events||[]).length};save(KEY,state);renderAdapters()}
  function dedupData(){
    const contexts=(ai().contexts||[]).map(c=>({kind:'CONTEXT',name:c.name,id:c.id,teamRefs:[...new Set((ai().events||[]).filter(e=>(e.contextIds||[]).includes(c.id)).map(e=>e.team))]}));
    const assets=confirmed().map(a=>({kind:'TEAM_SSOT',name:a.name,id:a.id,teamRefs:[a.team]}));const groups={};[...contexts,...assets].forEach(r=>{const k=norm(r.name);if(!k)return;(groups[k]||(groups[k]=[])).push(r)});const duplicates=Object.values(groups).filter(g=>g.length>1);const shared=contexts.filter(c=>c.teamRefs.length>1);return{duplicates,shared}
  }
  function renderDedup(){const d=dedupData(),rows=[];d.duplicates.forEach(g=>rows.push({title:`DUPLICATE CANDIDATE · ${g[0].name}`,copy:g.map(x=>`${x.kind}:${x.id}`).join(' ↔ '),state:'warn'}));d.shared.forEach(x=>rows.push({title:`SHARED CANONICAL · ${x.name}`,copy:`${x.teamRefs.join(' · ')}가 같은 정본을 참조 · 중복 생성보다 Workspace canonical 유지`,state:'good'}));q('[data-ai27-dedup]',page).innerHTML=rows.length?rows.map(r=>`<div class="ai27-row"><div class="ai27-row-main"><b>${esc(r.title)}</b><span>${esc(r.copy)}</span></div><span class="ai27-state ${r.state}">${r.state==='warn'?'REVIEW':'KEEP SHARED'}</span></div>`).join(''):'<div class="ai27-empty">현재 Runtime에서 명확한 중복 후보가 없습니다. 공유 정본은 중복으로 세지 않습니다.</div>'}
  function freshnessRows(){return (ai().contexts||[]).map(c=>{const st=ctxState(c),age=Math.floor((Date.now()-new Date(c.updatedAt).getTime())/86400000),due=(+c.freshnessDays||30)-age;return{...c,st,age,due}}).filter(c=>c.st==='STALE'||(c.st==='FRESH'&&c.due<=7)).sort((a,b)=>a.due-b.due)}
  function renderFreshness(){const rows=freshnessRows();q('[data-ai27-freshness]',page).innerHTML=rows.length?rows.map(c=>`<div class="ai27-row"><div class="ai27-row-main"><b>${esc(c.name)} · ${esc(c.st)}</b><span>Owner ${esc(c.owner)} · updated ${esc(c.updatedAt)} · ${c.st==='STALE'?`${Math.abs(c.due)}일 초과`:`${c.due}일 남음`}</span></div><div class="ai27-row-actions"><span class="ai27-state ${c.st==='STALE'?'bad':'warn'}">${c.st}</span><button type="button" class="ai27-btn" data-ai27-remind="${esc(c.id)}">Reminder Draft</button></div></div>`).join(''):'<div class="ai27-empty">Freshness 알림 대상이 없습니다.</div>'}
  function reminder(id){const c=(ai().contexts||[]).find(x=>x.id===id);if(!c)return;const el=q('[data-ai27-reminder]',page);el.hidden=false;el.textContent=`To: ${c.owner}\nSubject: ${c.name} SSOT freshness 확인 요청\n\n${c.name} (v${c.version})의 Freshness 기준을 다시 확인할 시점입니다. 현재 내용을 유지할지, 새 Evidence로 갱신할지, Archive할지 검토해주세요.\n\nAI는 초안만 준비했습니다. 실제 전송은 사람이 결정합니다.`;state.reminders.push({id:c.id,owner:c.owner,at:now()});save(KEY,state)}
  function dependency(){const t=team(),ev=events(t),by={};ev.forEach(e=>{const k=e.task||'UNKNOWN';by[k]||(by[k]={contexts:new Set(),artifacts:new Set()});(e.contextIds||[]).forEach(x=>by[k].contexts.add(x));if(e.artifact)by[k].artifacts.add(e.artifact)});return by}
  function renderDependency(){const by=dependency(),contexts=ai().contexts||[];q('[data-ai27-dependency]',page).innerHTML=Object.keys(by).length?Object.entries(by).map(([route,x])=>`<div class="ai27-lane"><div class="ai27-node route"><b>${esc(route)}</b><span>${events().filter(e=>e.task===route).length} runs</span></div><div class="ai27-arrow">→</div><div class="ai27-node"><b>Context</b><div class="ai27-node-stack">${[...x.contexts].map(id=>{const c=contexts.find(y=>y.id===id);return `<div class="mini">${esc(c?.name||id)} · ${esc(c?ctxState(c):'UNKNOWN')}</div>`}).join('')||'<div class="mini">No context</div>'}</div></div><div class="ai27-arrow">→</div><div class="ai27-node output"><b>Accepted / Revised Artifact</b><div class="ai27-node-stack">${[...x.artifacts].map(a=>`<div class="mini">${esc(a)}</div>`).join('')||'<div class="mini">No artifact</div>'}</div></div></div>`).join(''):'<div class="ai27-empty">선택한 Scope에 Usage Event가 없습니다.</div>'}
  function chargeback(){return teams().map(t=>{const m=metrics(t),a=confirmed().filter(x=>x.team===t).length,conv=m.accepted?a/m.accepted*100:0;return{t,...m,a,conv,per:a?m.spend/a:null}})}
  function renderChargeback(){q('[data-ai27-chargeback]',page).innerHTML=chargeback().map(x=>`<tr><td><b>${esc(x.t)}</b></td><td>${money(x.spend)}</td><td>${compact(x.tokens)}</td><td>${x.accepted}</td><td>${x.a}</td><td>${x.conv.toFixed(0)}%</td><td>${x.per==null?'—':money(x.per)}</td></tr>`).join('')||'<tr><td colspan="7">Team Usage가 없습니다.</td></tr>'}
  function resolve(role=q('[data-ai27-role]',page).value,t=team()){
    const used=new Set(usedContextIds(t)),base=(ai().contexts||[]).map(c=>({source:'CONTEXT',id:c.id,name:c.name,owner:c.owner,access:c.access,status:ctxState(c),team:null})),assets=confirmed().filter(a=>t==='ALL'||a.team===t).map(a=>({source:'TEAM_SSOT',id:a.id,name:a.name,owner:a.owner,access:'TEAM',status:a.status,team:a.team}));
    const all=[...base,...assets];return all.map(x=>{let allow=x.status==='FRESH'||x.status==='CONFIRMED';let reason='eligible';if(x.access==='PRIVATE_1ON1'){allow=false;reason='PRIVATE_1ON1 default deny'}else if(role==='VIEWER'&&x.access==='TEAM'){allow=false;reason='VIEWER workspace-only preview rule'}else if(x.status==='STALE'){allow=false;reason='freshness expired'}else if(x.status==='DRAFT'){allow=false;reason='not confirmed'}return{...x,allow,reason,used:used.has(x.id)}})
  }
  function renderRbac(){const role=q('[data-ai27-role]',page).value,rows=resolve(role),ok=rows.filter(x=>x.allow),no=rows.filter(x=>!x.allow);q('[data-ai27-rbac-summary]',page).innerHTML=`<b>${esc(role)}</b><span style="display:block;margin-top:6px;font-size:10px;color:inherit">Eligible ${ok.length} · Denied ${no.length}<br>Preview policy simulation · Production은 server-side RBAC/Workspace resolver가 최종 강제합니다.</span>`;q('[data-ai27-rbac-list]',page).innerHTML=rows.slice(0,10).map(x=>`<div class="ai27-row"><div class="ai27-row-main"><b>${esc(x.name)}</b><span>${esc(x.source)} · ${esc(x.access)} · Owner ${esc(x.owner)}${x.used?' · used by selected scope':''}</span></div><span class="ai27-state ${x.allow?'good':'bad'}">${x.allow?'ELIGIBLE':esc(x.reason)}</span></div>`).join('');window.LeaderOsWorkspaceContextResolver=(opts={})=>resolve(opts.role||role,opts.team||t)}
  function packData(){const m=metrics(),a=anomalies(),fresh=freshnessRows(),d=dedupData(),cb=chargeback(),teamLabel=team(),budgetPct=m.budget?m.spend/m.budget*100:0,conv=m.accepted?m.assets/m.accepted*100:0;return{at:now(),month:q('[data-ai27-month]',page).value,team:teamLabel,summary:`${teamLabel} scope에서 ${money(m.spend)}를 사용해 ${m.accepted}개의 Accepted/Revised Output을 만들었고, Confirmed Team SSOT는 ${m.assets}개입니다. SSOT Coverage는 ${m.coverage.toFixed(0)}%입니다.`,credit:`Spend ${money(m.spend)}${m.budget?` / Budget ${money(m.budget)} (${budgetPct.toFixed(0)}%)`:''} · Tokens ${compact(m.tokens)} · Cost/Accepted ${money(m.costAccepted)}`,knowledge:`Confirmed SSOT ${m.assets} · Accepted ${m.accepted} · Knowledge Conversion ${conv.toFixed(0)}%`,health:`Fresh ${m.fresh}/${m.contexts.length} referenced contexts · Freshness reminders ${fresh.length} · Duplicate candidates ${d.duplicates.length} · Shared canonical ${d.shared.length}`,risk:a.length?a.join(' · '):'No strong operating anomaly',decisions:[fresh.length?'Freshness owner review 필요':null,d.duplicates.length?'중복 후보 canonical merge 검토':null,budgetPct>=85?'Budget / route review 필요':null,m.assets===0&&m.accepted>0?'Accepted Artifact의 Team SSOT 승격 기준 결정':null].filter(Boolean),next:['Coverage Snapshot을 월 1회 저장','Freshness Owner와 SSOT owner를 명시','Accepted Artifact 중 재사용 자산을 Human Review','다음 달 Model Route / Context reuse 개선 실험']}}
  function renderPack(p){const root=q('[data-ai27-pack]',page);if(!p){root.innerHTML='<div class="ai27-empty">Review Pack을 생성하세요.</div>';return}root.innerHTML=[['Executive Summary',p.summary],['Credit & Efficiency',p.credit],['Knowledge Assetization',p.knowledge],['SSOT Health',p.health],['Risk / Anomaly',p.risk]].map(([h,c])=>`<div class="ai27-pack-section"><small>${h}</small><p>${esc(c)}</p></div>`).join('')+`<div class="ai27-pack-section"><small>DECISIONS NEEDED</small><ul>${(p.decisions.length?p.decisions:['No immediate decision']).map(x=>`<li>${esc(x)}</li>`).join('')}</ul></div><div class="ai27-pack-section"><small>NEXT MONTH</small><ul>${p.next.map(x=>`<li>${esc(x)}</li>`).join('')}</ul></div>`}
  let currentPack=null;
  function generatePack(){currentPack=packData();q('[data-ai27-pack-state]',page).textContent='GENERATED';q('[data-ai27-pack-state]',page).className='ai27-state good';renderPack(currentPack)}
  function savePack(){if(!currentPack)generatePack();state.packs.push({...currentPack,savedAt:now()});state.packs=state.packs.slice(-24);save(KEY,state);q('[data-ai27-pack-state]',page).textContent='SAVED';q('[data-ai27-pack-state]',page).className='ai27-state info'}
  function ensureNav(){const nav=q('[data-primary-nav]');if(!nav)return;const sys=qa('.nav-section',nav).find(sec=>q('.nav-label',sec)?.textContent?.trim()==='SYSTEM')||qa('.nav-section',nav).at(-1);if(!sys)return;let a=q('[data-ai27-nav="AI_OPERATING_REVIEW"]',sys);if(!a){a=document.createElement('a');a.href='#ai-operating-review';a.dataset.ai27Nav='AI_OPERATING_REVIEW';a.textContent='AI Operating Review';const bill=qa('a',sys).find(x=>/Billing/i.test(x.textContent||''));bill?bill.insertAdjacentElement('beforebegin',a):sys.append(a)}a.onclick=e=>{e.preventDefault();showPage()}}
  function ensureTop(){const top=q('.topbar-actions')||q('[data-topbar-actions]')||q('.topbar');if(!top||q('[data-ai27-open]',top))return;const b=document.createElement('button');b.type='button';b.className='ai27-btn';b.dataset.ai27Open='';b.textContent='AI Monthly Review';top.append(b)}
  function showPage(){qa('[data-page]').forEach(x=>x.hidden=x!==page);qa('[data-primary-nav] a').forEach(a=>a.removeAttribute('aria-current'));q('[data-ai27-nav="AI_OPERATING_REVIEW"]')?.setAttribute('aria-current','page');const t=q('[data-topbar-title]');if(t)t.textContent='AI Operating Review';history.replaceState(null,'','#ai-operating-review');render();window.scrollTo({top:0,behavior:'auto'})}
  function render(){renderTeamSelect();renderMetrics();renderTrend();renderAdapters();renderDedup();renderFreshness();renderDependency();renderChargeback();renderRbac();if(currentPack)renderPack(currentPack)}
  document.addEventListener('click',e=>{if(e.target.closest('[data-ai27-open]')){e.preventDefault();showPage()}const sync=e.target.closest('[data-ai27-sync]');if(sync)syncDemo();const rem=e.target.closest('[data-ai27-remind]');if(rem)reminder(rem.dataset.ai27Remind)},true);
  q('[data-ai27-go-usage]',page)?.addEventListener('click',()=>q('[data-ai25-open]')?.click());q('[data-ai27-go-ssot]',page)?.addEventListener('click',()=>q('[data-ai26-open]')?.click());q('[data-ai27-generate]',page)?.addEventListener('click',generatePack);q('[data-ai27-snapshot]',page)?.addEventListener('click',snapshot);q('[data-ai27-save-pack]',page)?.addEventListener('click',savePack);q('[data-ai27-print]',page)?.addEventListener('click',()=>window.print());q('[data-ai27-team]',page)?.addEventListener('change',()=>{currentPack=null;render()});q('[data-ai27-role]',page)?.addEventListener('change',renderRbac);
  // Make Recovery 26 visible entry point to monthly review.
  const ssotHead=q('[data-page="TEAM_SSOT_PLAN"] .ai26-section-head .ai26-actions');if(ssotHead&&!q('[data-ai27-open]',ssotHead)){const b=document.createElement('button');b.type='button';b.dataset.ai27Open='';b.textContent='Monthly AI Review';ssotHead.prepend(b)}
  ensureNav();ensureTop();setTimeout(()=>{ensureNav();ensureTop()},300);const nav=q('[data-primary-nav]');if(nav)new MutationObserver(()=>{ensureNav();ensureTop()}).observe(nav,{childList:true,subtree:true});render();
  window.LeaderOsAiOperatingReviewAudit=()=>({teams:teams(),history:state.history.length,packs:state.packs.length,stale:freshnessRows().filter(x=>x.st==='STALE').map(x=>x.id),dedup:dedupData().duplicates.length,shared:dedupData().shared.length,adapters:demoAdapters.map(x=>({id:x.id,status:x.status,synced:!!state.adapterSync[x.id]})),chargeback:chargeback().map(x=>({team:x.t,spend:x.spend,accepted:x.accepted,confirmed:x.a})),duplicateIds:[...document.querySelectorAll('[id]')].map(x=>x.id).filter((x,i,a)=>a.indexOf(x)!==i)});
})();
</script>
<script id="recovery-28-header-sync-js">
(()=>{
 const root=document.documentElement,top=document.querySelector('.topbar'),head=document.querySelector('.sidebar-head');if(!top||!head)return;
 const sync=()=>{if(matchMedia('(max-width:900px)').matches){root.style.removeProperty('--leader-shell-header-h');return}const h=Math.ceil(top.getBoundingClientRect().height);root.style.setProperty('--leader-shell-header-h',h+'px')};
 sync();window.addEventListener('resize',sync,{passive:true});if(window.ResizeObserver)new ResizeObserver(sync).observe(top);
 window.LeaderOsHeaderAlignmentAudit=()=>({topbar:Math.round(top.getBoundingClientRect().height),sidebarHeader:Math.round(head.getBoundingClientRect().height),delta:Math.abs(Math.round(top.getBoundingClientRect().bottom-head.getBoundingClientRect().bottom))});
})();
</script>
\n<script id="recovery-28-knowledge-lineage-js">
(()=>{
 const q=(s,r=document)=>r.querySelector(s),qa=(s,r=document)=>[...r.querySelectorAll(s)],esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
 const page=q('[data-page="AI_KNOWLEDGE_LINEAGE"]');if(!page)return;
 document.title='Leader OS · Recovery 31 · Flow Time & Team Directory';
 const KEY='leader-os:ai-knowledge-lineage:v1',AI_KEY='leader-os:ai-usage-runtime:v1',CONF_KEY='leader-os:team-ssot-confirmed:v1',R27_KEY='leader-os:ai-operating-review:v1';
 const load=(k,d)=>{try{const v=JSON.parse(localStorage.getItem(k)||'null');return v??d}catch{return d}},save=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch{}},now=()=>new Date().toISOString();
 const state=load(KEY,{lifecycle:{},lifecycleDraft:null,budgetProposal:null,experiments:[],handoff:null,escalations:[]});
 const ai=()=>window.LeaderOsAiUsageBridge?.get?.()||load(AI_KEY,{events:[],budgets:[],rateCards:[],contexts:[],prompts:[],routing:{}});
 const confirmed=()=>window.LeaderOsTeamSsotBridge?.getConfirmed?.()||load(CONF_KEY,[]);
 const r27=()=>load(R27_KEY,{history:[],packs:[]});
 const teams=()=>[...new Set((ai().events||[]).map(e=>e.team).filter(Boolean))].sort();
 const team=()=>q('[data-ai28-team]',page)?.value||teams()[0]||'ALL';
 const events=()=>{const t=team(),all=ai().events||[];return t==='ALL'?all:all.filter(e=>e.team===t)};
 const rate=id=>(ai().rateCards||[]).find(r=>r.id===id)||null;
 const cost=e=>{const r=rate(e.rateCardId);if(!r)return 0;const ca=Math.min(+e.cached||0,+e.input||0),normal=Math.max(0,(+e.input||0)-ca);return normal/1e6*(+r.input||0)+ca/1e6*(+r.cached||0)+(+e.output||0)/1e6*(+r.output||0)};
 const money=n=>'$'+(+n||0).toFixed(2),compact=n=>{n=+n||0;return n>=1e6?(n/1e6).toFixed(1)+'M':n>=1e3?(n/1e3).toFixed(1)+'K':Math.round(n).toLocaleString()};
 const ctxState=c=>{if(!c)return'UNKNOWN';if(c.access==='PRIVATE_1ON1')return'BLOCKED';if(c.status!=='CONFIRMED')return'DRAFT';const age=(Date.now()-new Date(c.updatedAt).getTime())/86400000;return age>(+c.freshnessDays||30)?'STALE':'FRESH'};
 function renderTeam(){const s=q('[data-ai28-team]',page),cur=s.value||teams()[0]||'ALL';s.innerHTML='<option>ALL</option>'+teams().map(x=>`<option>${esc(x)}</option>`).join('');s.value=[...s.options].some(o=>o.value===cur)?cur:'ALL';renderEvents()}
 function renderEvents(){const s=q('[data-ai28-event]',page),cur=s.value;const ev=events();s.innerHTML=ev.map(e=>`<option value="${esc(e.id)}">${esc(e.id)} · ${esc(e.task)} · ${esc(e.purpose)}</option>`).join('')||'<option value="">No events</option>';if(cur&&ev.some(e=>e.id===cur))s.value=cur;renderLineage()}
 function selectedEvent(){const id=q('[data-ai28-event]',page)?.value;return (ai().events||[]).find(e=>e.id===id)||events()[0]||null}
 function promptFor(e){return (ai().prompts||[]).find(p=>p.route===e?.task)||null}
 function ssotFor(e){const list=confirmed(),bySource=list.find(a=>a.sourceEvent===e?.id),byName=list.find(a=>a.name===e?.artifact);return bySource||byName||null}
 function lifeStatus(a){return state.lifecycle[a?.id]||a?.status||'CONFIRMED'}
 function renderLineage(){const root=q('[data-ai28-lineage]',page),e=selectedEvent();if(!e){root.innerHTML='<div class="ai28-empty">선택한 Scope에 Usage Event가 없습니다.</div>';return}const p=promptFor(e),ctx=(e.contextIds||[]).map(id=>(ai().contexts||[]).find(c=>c.id===id)).filter(Boolean),a=ssotFor(e);const ctxCopy=ctx.length?ctx.map(c=>`${c.name} · ${ctxState(c)}`).join('<br>'):'No Context';root.innerHTML=`<div class="ai28-node"><small>01 · USAGE EVENT</small><b>${esc(e.id)}</b><span>${esc(e.team)} · ${esc(e.project)}<br>${esc(e.purpose)} · ${money(cost(e))}</span></div><div class="ai28-node"><small>02 · PROMPT PACK</small><b>${esc(p?.name||'UNKNOWN')}</b><span>${p?`v${esc(p.version)} · ${esc(p.status)}`:'Route와 연결된 Prompt Pack 없음'}</span></div><div class="ai28-node"><small>03 · CONTEXT</small><b>${ctx.length} sources</b><span>${ctxCopy}</span></div><div class="ai28-node"><small>04 · ARTIFACT</small><b>${esc(e.artifact||'No artifact')}</b><span>${esc(e.result)} · Retry ${+e.retries||0}</span></div><div class="ai28-node ${a&&lifeStatus(a)==='CONFIRMED'?'confirmed':''}"><small>05 · TEAM SSOT</small><b>${esc(a?.name||'Not promoted')}</b><span>${a?`${esc(lifeStatus(a))} · Owner ${esc(a.owner)}`:'Human Review 후 승격 가능'}</span></div>`}
 function monthMetrics(){const ev=events(),sp=ev.reduce((s,e)=>s+cost(e),0),tok=ev.reduce((s,e)=>s+(+e.input||0)+(+e.output||0),0),accepted=ev.filter(e=>['ACCEPTED','REVISED'].includes(e.result)).length,assets=confirmed().filter(a=>team()==='ALL'||a.team===team()).filter(a=>lifeStatus(a)==='CONFIRMED').length;return{sp,tok,accepted,assets,conv:accepted?assets/accepted*100:0}}
 function renderCompare(){const cur=monthMetrics(),packs=r27().packs||[],prevReal=[...packs].reverse().find(p=>p.team===team()||team()==='ALL');const prev=prevReal?{sp:parseFloat((prevReal.credit||'').match(/Spend \$([\d.]+)/)?.[1]||0),accepted:0,assets:0,conv:0,label:prevReal.month||'Previous'}:{sp:cur.sp*.82,accepted:Math.max(1,Math.round(cur.accepted*.78)),assets:Math.max(0,Math.round(cur.assets*.6)),conv:Math.max(0,cur.conv-12),label:'DEMO PREVIOUS'};q('[data-ai28-compare]',page).innerHTML=`<div class="ai28-month"><h4>${esc(prev.label)} ${prevReal?'':'<span class="ai28-state info">DEMO</span>'}</h4><dl><dt>Spend</dt><dd>${money(prev.sp)}</dd><dt>Accepted</dt><dd>${prev.accepted||'—'}</dd><dt>Confirmed SSOT</dt><dd>${prev.assets||'—'}</dd><dt>Knowledge Conversion</dt><dd>${prev.conv?prev.conv.toFixed(0)+'%':'—'}</dd></dl></div><div class="ai28-month"><h4>CURRENT RUNTIME</h4><dl><dt>Spend</dt><dd>${money(cur.sp)}</dd><dt>Accepted</dt><dd>${cur.accepted}</dd><dt>Confirmed SSOT</dt><dd>${cur.assets}</dd><dt>Knowledge Conversion</dt><dd>${cur.conv.toFixed(0)}%</dd></dl></div>`}
 function slaRows(){return (ai().contexts||[]).map(c=>{const age=Math.floor((Date.now()-new Date(c.updatedAt).getTime())/86400000),limit=+c.freshnessDays||30,over=age-limit;return{...c,age,limit,over,state:ctxState(c)}}).filter(c=>c.state==='STALE'||(c.state==='FRESH'&&c.limit-c.age<=7)).sort((a,b)=>b.over-a.over)}
 function renderSla(){const rows=slaRows();q('[data-ai28-sla]',page).innerHTML=rows.length?rows.map(c=>`<div class="ai28-row"><div class="ai28-row-main"><b>${esc(c.name)} · ${esc(c.state)}</b><span>Owner ${esc(c.owner)} · SLA ${c.limit}d · ${c.over>0?`${c.over}d overdue`:`${Math.abs(c.over)}d to review`} · escalation after +3d</span></div><div class="ai28-actions"><span class="ai28-state ${c.state==='STALE'?'bad':'warn'}">${esc(c.state)}</span><button type="button" data-ai28-escalate="${esc(c.id)}">Escalation Draft</button></div></div>`).join(''):'<div class="ai28-empty">현재 Freshness SLA 경고 대상이 없습니다.</div>'}
 function renderLifeAssets(){const sel=q('[data-ai28-life-asset]',page),assets=confirmed(),cur=sel.value;sel.innerHTML=assets.map(a=>`<option value="${esc(a.id)}">${esc(a.name)} · ${esc(lifeStatus(a))}</option>`).join('')||'<option value="">No confirmed asset</option>';if(cur&&assets.some(a=>a.id===cur))sel.value=cur;const rows=assets.map(a=>`<div class="ai28-row"><div class="ai28-row-main"><b>${esc(a.name)}</b><span>${esc(a.team)} · Owner ${esc(a.owner)} · Source ${esc(a.sourceEvent)} · v${esc(a.version)}</span></div><span class="ai28-state ${lifeStatus(a)==='CONFIRMED'?'good':lifeStatus(a)==='SUPERSEDED'?'warn':'bad'}">${esc(lifeStatus(a))}</span></div>`);const d=state.lifecycleDraft?`<div class="ai28-row"><div class="ai28-row-main"><b>DRAFT · ${esc(state.lifecycleDraft.assetName)}</b><span>${esc(state.lifecycleDraft.from)} → ${esc(state.lifecycleDraft.to)} · ${esc(state.lifecycleDraft.reason||'Reason required before production')}</span></div><div class="ai28-actions"><span class="ai28-state info">DRAFT</span><button type="button" data-ai28-life-confirm>Human Confirm</button><button type="button" data-ai28-life-cancel>Cancel</button></div></div>`:'';q('[data-ai28-life-list]',page).innerHTML=d+rows.join('')||'<div class="ai28-empty">Confirmed Team SSOT가 없습니다.</div>'}
 function makeLifeDraft(){const id=q('[data-ai28-life-asset]',page).value,a=confirmed().find(x=>x.id===id);if(!a)return;state.lifecycleDraft={assetId:id,assetName:a.name,from:lifeStatus(a),to:q('[data-ai28-life-state]',page).value,reason:q('[data-ai28-life-reason]',page).value.trim(),at:now()};save(KEY,state);renderLifeAssets()}
 function confirmLife(){const d=state.lifecycleDraft;if(!d)return;state.lifecycle[d.assetId]=d.to;state.lifecycleDraft=null;save(KEY,state);renderLifeAssets();renderLineage();renderGaps()}
 function teamStats(t){const ev=(ai().events||[]).filter(e=>e.team===t),b=(ai().budgets||[]).find(x=>x.scope==='TEAM'&&x.id===t),sp=ev.reduce((s,e)=>s+cost(e),0),accepted=ev.filter(e=>['ACCEPTED','REVISED'].includes(e.result)).length,assets=confirmed().filter(a=>a.team===t&&lifeStatus(a)==='CONFIRMED').length;return{team:t,budget:+b?.amount||0,sp,accepted,assets,conv:accepted?assets/accepted*100:0}}
 function createBudgetProposal(){const rows=teams().map(teamStats),total=rows.reduce((s,x)=>s+x.budget,0),avg=rows.length?rows.reduce((s,x)=>s+x.conv,0)/rows.length:0;let raw=rows.map(x=>({...x,factor:(x.sp>x.budget*.8&&x.conv>=avg)?1.1:(x.sp<x.budget*.5&&x.conv<avg)?.9:1}));const rawTotal=raw.reduce((s,x)=>s+x.budget*x.factor,0)||1;state.budgetProposal={status:'DRAFT',at:now(),rows:raw.map(x=>({...x,proposed:+(x.budget*x.factor*total/rawTotal).toFixed(2),reason:x.factor>1?'High utilization + knowledge conversion':x.factor<1?'Low utilization + lower conversion':'Maintain while evidence accumulates'}))};save(KEY,state);renderBudget()}
 function renderBudget(){const p=state.budgetProposal,rows=p?.rows||teams().map(teamStats).map(x=>({...x,proposed:x.budget,reason:'No proposal yet'}));q('[data-ai28-budget-table]',page).innerHTML=rows.map(x=>`<tr><td><b>${esc(x.team)}</b></td><td>${money(x.budget)}</td><td>${money(x.sp)}</td><td>${x.conv.toFixed(0)}%</td><td>${money(x.proposed)}</td><td>${esc(x.reason)}</td></tr>`).join('')||'<tr><td colspan="6">Team budget data가 없습니다.</td></tr>';q('[data-ai28-budget-confirm]',page).disabled=!p||p.status!=='DRAFT';if(p?.status==='CONFIRMED')q('[data-ai28-status]',page).textContent='BUDGET PROPOSAL CONFIRMED'}
 function confirmBudget(){if(!state.budgetProposal)return;state.budgetProposal.status='CONFIRMED';state.budgetProposal.confirmedAt=now();save(KEY,state);renderBudget()}
 function genExperiments(){const routing=ai().routing||{};state.experiments=Object.entries(routing).filter(([,r])=>r.fallback&&r.fallback!=='NONE').map(([task,r],i)=>({id:`EXP-${task}`,task,a:r.primary,b:r.fallback,status:'DRAFT',metric:'Cost / Accepted + Retry + Human Review',proxy:i===0?'Historical proxy only · not randomized':'No production result'}));save(KEY,state);renderExperiments()}
 function renderExperiments(){q('[data-ai28-experiments]',page).innerHTML=state.experiments.length?state.experiments.map(x=>`<div class="ai28-row"><div class="ai28-row-main"><b>${esc(x.task)} · A ${esc(x.a)} vs B ${esc(x.b)}</b><span>${esc(x.metric)} · ${esc(x.proxy)}</span></div><span class="ai28-state info">${esc(x.status)}</span></div>`).join(''):'<div class="ai28-empty">아직 Routing Experiment가 없습니다. 실험안 생성은 실제 Provider 호출을 하지 않습니다.</div>'}
 function gapData(){const out=[];teams().forEach(t=>{const ev=(ai().events||[]).filter(e=>e.team===t),by={};ev.forEach(e=>(by[e.task]||(by[e.task]=[])).push(e));Object.entries(by).forEach(([task,arr])=>{const ids=[...new Set(arr.flatMap(e=>e.contextIds||[]))],fresh=ids.map(id=>(ai().contexts||[]).find(c=>c.id===id)).filter(c=>ctxState(c)==='FRESH').length,prompt=!!(ai().prompts||[]).find(p=>p.route===task),accepted=arr.filter(e=>['ACCEPTED','REVISED'].includes(e.result)).length;let severity='LOW',why=[];if(arr.length>=2&&fresh===0){severity='HIGH';why.push('반복 Run 대비 Fresh SSOT 없음')}else if(arr.length>=2&&fresh<=1){severity='MEDIUM';why.push('Context coverage 얕음')}if(!prompt){severity=severity==='HIGH'?'HIGH':'MEDIUM';why.push('Confirmed Prompt Pack 없음')}if(accepted>0&&confirmed().filter(a=>a.team===t&&lifeStatus(a)==='CONFIRMED').length===0){severity='HIGH';why.push('Accepted Output이 SSOT로 승격되지 않음')}out.push({t,task,runs:arr.length,fresh,prompt,accepted,severity,why:why.join(' · ')||'현재 구조 유지'})})});return out.sort((a,b)=>({HIGH:0,MEDIUM:1,LOW:2}[a.severity]-{HIGH:0,MEDIUM:1,LOW:2}[b.severity]));}
 function renderGaps(){q('[data-ai28-gaps]',page).innerHTML=gapData().map(x=>`<div class="ai28-gap"><span class="ai28-state ${x.severity==='HIGH'?'bad':x.severity==='MEDIUM'?'warn':'good'}">${x.severity}</span><b>${esc(x.t)} · ${esc(x.task)}</b><span>Runs ${x.runs} · Fresh Context ${x.fresh} · Prompt ${x.prompt?'YES':'NO'} · Accepted ${x.accepted}<br>${esc(x.why)}</span></div>`).join('')||'<div class="ai28-empty">Usage data가 없어 Knowledge Gap을 계산할 수 없습니다.</div>'}
 function handoff(){const gaps=gapData().filter(x=>x.severity!=='LOW').slice(0,3),sla=slaRows().slice(0,3),bp=state.budgetProposal;state.handoff={at:now(),team:team(),headline:`AI Operating Handoff · ${team()}`,decisions:[sla.length?`Freshness review ${sla.length}건`:null,gaps.length?`Knowledge gap ${gaps.length}건`:null,bp?.status==='CONFIRMED'?'Next-month Credit allocation confirmed':null].filter(Boolean),next:[...gaps.map(x=>`${x.t}/${x.task}: ${x.why}`),...sla.map(x=>`${x.name}: Owner ${x.owner} review`)].slice(0,5)};save(KEY,state);renderHandoff();injectRuntime()}
 function renderHandoff(){const h=state.handoff,root=q('[data-ai28-handoff-preview]',page);root.innerHTML=h?`<div class="ai28-handoff"><b>${esc(h.headline)}</b><br>${h.decisions.map(x=>`• ${esc(x)}`).join('<br>')||'• No immediate decision'}<br><br><b>Next</b><br>${h.next.map(x=>`• ${esc(x)}`).join('<br>')||'• Continue monitoring'}</div>`:'<div class="ai28-empty">아직 Handoff가 없습니다. 상단의 ‘운영 Handoff 만들기’를 눌러 Review Context를 전달하세요.</div>'}
 function injectRuntime(){const h=state.handoff;if(!h)return;const today=q('[data-page="TODAY"]');if(today){let el=q('[data-ai28-today-handoff]',today);if(!el){el=document.createElement('section');el.className='card ai28-runtime-card';el.dataset.ai28TodayHandoff='';const anchor=today.querySelector('h1')?.nextElementSibling||today.firstElementChild;anchor?.insertAdjacentElement('afterend',el)}el.innerHTML=`<div class="section-kicker">AI OPERATING HANDOFF</div><h2>${esc(h.headline)}</h2><p class="why">${esc(h.decisions.join(' · ')||'No immediate decision')}</p><button type="button" data-ai28-open>Knowledge Lineage 열기</button>`}const rep=q('[data-page="REPORTS"]');if(rep){let el=q('[data-ai28-report-handoff]',rep);if(!el){el=document.createElement('section');el.className='card ai28-report-card';el.dataset.ai28ReportHandoff='';rep.append(el)}el.innerHTML=`<div class="section-kicker">AI OPERATING REVIEW HANDOFF</div><h2>${esc(h.headline)}</h2><p class="why">${esc(h.next.join(' · ')||'No next action')}</p>`}const mb=q('[data-manager-brief]');if(mb){let el=q('[data-ai28-manager-handoff]');if(!el){el=document.createElement('div');el.className='ai28-manager-handoff';el.dataset.ai28ManagerHandoff='';mb.insertAdjacentElement('afterend',el)}el.innerHTML=`<b>AI Operating Context</b><br>${esc(h.decisions.join(' · ')||'No immediate decision')}<br>${esc(h.next.slice(0,2).join(' · '))}`}}
 function ensureNav(){const nav=q('[data-primary-nav]');if(!nav)return;const sys=qa('.nav-section',nav).find(sec=>q('.nav-label',sec)?.textContent?.trim()==='SYSTEM')||qa('.nav-section',nav).at(-1);if(!sys)return;let a=q('[data-ai28-nav]',sys);if(!a){a=document.createElement('a');a.href='#ai-knowledge-lineage';a.dataset.ai28Nav='AI_KNOWLEDGE_LINEAGE';a.textContent='AI Knowledge Lineage';const bill=qa('a',sys).find(x=>/Billing/i.test(x.textContent||''));bill?bill.insertAdjacentElement('beforebegin',a):sys.append(a)}a.onclick=e=>{e.preventDefault();showPage()}}
 function ensureReviewCta(){const actions=q('[data-page="AI_OPERATING_REVIEW"] .ai27-actions');if(actions&&!q('[data-ai28-open]',actions)){const b=document.createElement('button');b.type='button';b.dataset.ai28Open='';b.textContent='Knowledge Lineage';actions.prepend(b)}}
 function showPage(){qa('[data-page]').forEach(x=>x.hidden=x!==page);qa('[data-primary-nav] a').forEach(a=>a.removeAttribute('aria-current'));q('[data-ai28-nav]')?.setAttribute('aria-current','page');const t=q('[data-topbar-title]');if(t)t.textContent='AI Knowledge Lineage';history.replaceState(null,'','#ai-knowledge-lineage');render();window.scrollTo({top:0,behavior:'auto'})}
 function render(){renderTeam();renderCompare();renderSla();renderLifeAssets();renderBudget();renderExperiments();renderGaps();renderHandoff();injectRuntime()}
 document.addEventListener('click',e=>{if(e.target.closest('[data-ai28-open]')){e.preventDefault();showPage()}const es=e.target.closest('[data-ai28-escalate]');if(es){const c=(ai().contexts||[]).find(x=>x.id===es.dataset.ai28Escalate);if(c){state.escalations.push({id:c.id,owner:c.owner,status:'DRAFT',at:now()});save(KEY,state);alert(`DRAFT prepared for ${c.owner}. 자동 전송하지 않습니다.`)}}if(e.target.closest('[data-ai28-life-confirm]'))confirmLife();if(e.target.closest('[data-ai28-life-cancel]')){state.lifecycleDraft=null;save(KEY,state);renderLifeAssets()}},true);
 q('[data-ai28-team]',page)?.addEventListener('change',()=>{renderEvents();renderCompare();renderBudget();renderGaps()});q('[data-ai28-event]',page)?.addEventListener('change',renderLineage);q('[data-ai28-go-review]',page)?.addEventListener('click',()=>q('[data-ai27-open]')?.click());q('[data-ai28-go-ssot]',page)?.addEventListener('click',()=>q('[data-ai26-open]')?.click());q('[data-ai28-handoff]',page)?.addEventListener('click',handoff);q('[data-ai28-life-draft]',page)?.addEventListener('click',makeLifeDraft);q('[data-ai28-budget-propose]',page)?.addEventListener('click',createBudgetProposal);q('[data-ai28-budget-confirm]',page)?.addEventListener('click',confirmBudget);q('[data-ai28-exp-generate]',page)?.addEventListener('click',genExperiments);
 ensureNav();ensureReviewCta();setTimeout(()=>{ensureNav();ensureReviewCta();injectRuntime()},250);const nav=q('[data-primary-nav]');if(nav)new MutationObserver(()=>{ensureNav();ensureReviewCta()}).observe(nav,{childList:true,subtree:true});render();
 window.LeaderOsAiKnowledgeLineageAudit=()=>({teams:teams(),events:(ai().events||[]).length,lineageNodes:q('[data-ai28-lineage]',page)?.children.length||0,lifecycleDraft:!!state.lifecycleDraft,budgetProposal:state.budgetProposal?.status||null,experiments:state.experiments.length,gaps:gapData().length,handoff:!!state.handoff,duplicateIds:[...document.querySelectorAll('[id]')].map(x=>x.id).filter((x,i,a)=>a.indexOf(x)!==i)});
})();
</script>\n

<script>
(() => {
  const q=(s,r=document)=>r.querySelector(s), qa=(s,r=document)=>[...r.querySelectorAll(s)], esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const LKEY='leader-os:r29:language-log', FKEY='leader-os:r29:workflow';
  const localScope=()=>{try{const x=window.LeaderOsReportRuntimeBridge?.state?.();return x?.signedIn&&x.userId&&x.workspaceId?`${x.userId}:${x.workspaceId}`:'guest'}catch{return'guest'}};
  const storageKey=k=>k===LKEY?`${k}:${localScope()}`:k;
  const get=(k,f)=>{try{const v=localStorage.getItem(storageKey(k));return v?JSON.parse(v):f}catch{return f}}, set=(k,v)=>{try{localStorage.setItem(storageKey(k),JSON.stringify(v))}catch{}};
  const patterns=[
    ['DIRECTION','방향 제시','“이거 잘 만들어주세요.”','“이번 결과의 목적은 신규 고객이 10초 안에 핵심 가치를 이해하게 하는 것입니다. 오늘 17시까지 3안, 완료 기준은 고객 문제·제안·CTA가 한 화면에 보이는 것입니다.”'],
    ['QUESTION','코칭 질문','“왜 그렇게 했어요?”','“이 선택을 한 근거는 무엇인가요? 다른 두 가지 옵션과 비교했을 때 무엇을 우선한 건가요?”'],
    ['FEEDBACK','개선 피드백','“뭔가 약해요. 다시 해주세요.”','“오늘 리뷰에서 고객 문제가 8페이지 뒤에 나왔습니다. 초반 설득력이 약해졌어요. 다음 버전은 첫 3페이지 안에 Problem → Insight → Proposition을 배치해봅시다.”'],
    ['DECISION','의사결정','“회의에서 다 같이 정하죠.”','“이 Decision의 DRI는 민지입니다. 오늘은 Input을 듣고, 16시에 민지가 결정합니다. 결정 후 Review Date는 금요일입니다.”'],
    ['DELEGATION','위임','“알아서 진행해주세요.”','“Outcome은 금요일 승인 가능한 시안입니다. 크리에이티브 방향은 당신이 결정하고, 예산 +10% 이상이나 일정 2일 이상 지연 시 에스컬레이션해주세요.”'],
    ['RECOGNITION','칭찬/인정','“수고했어요. 잘했어요.”','“어제 클라이언트 질문을 바로 방어하지 않고 핵심 우려를 다시 확인한 행동이 좋았습니다. 덕분에 수정 범위가 명확해졌어요. 다음 리뷰에서도 그 방식을 유지해주세요.”'],
    ['DIFFICULT','어려운 대화','“요즘 왜 이렇게 책임감이 없어요?”','“지난 두 번의 마일스톤에서 합의한 시간보다 하루씩 늦었습니다. 다음 팀의 작업 시작도 늦어졌어요. 어떤 장애가 있었는지 먼저 듣고 싶습니다. 다음 일정은 어떻게 다시 약속할까요?”'],
    ['UPWARD','상급자 보고','“지금 좀 문제가 있습니다.”','“Headline: 일정이 2일 위험합니다. 원인은 승인 대기 1건입니다. 오늘 필요한 결정은 A/B 중 하나이며, 제 추천은 B입니다. 결정되면 금요일 일정은 유지할 수 있습니다.”'],
    ['CRISIS','위기/변화','“일단 다 멈추고 빨리 해결합시다.”','“바뀐 사실은 보안 이슈로 금요일 전체 출시가 불가능하다는 것입니다. 지금의 새 목표는 고객 신뢰를 지키며 Pilot 일정을 확정하는 것입니다. 오늘 24시간 안에 범위·DRI·재개 조건을 정하겠습니다.”']
  ];
  function renderPatterns(){const root=q('[data-r29-language-patterns]');if(!root)return;root.innerHTML=patterns.map(([k,t,b,g])=>`<article class="r29-language-card"><div class="r29-kicker">${k}</div><h3>${t}</h3><div class="r29-bad">✕ ${esc(b)}</div><div class="r29-good">✓ ${esc(g)}</div></article>`).join('')}
  const templates={
    DIRECTION:(i,e,o)=>`목적: ${o||'원하는 Outcome을 명확히 합니다.'}\n현재 사실: ${e||'관찰 가능한 사실을 적습니다.'}\n요청: ${i||'해야 할 일을 구체적으로 말합니다.'}\n완료 기준: 결과물/Evidence와 Due를 확인합니다.`,
    QUESTION:(i,e,o)=>`제가 먼저 답을 주기보다 묻겠습니다.\n현재 보이는 사실은 “${e||'…'}”입니다.\n${i||'이 선택을 한 근거는 무엇인가요?'}\n당신이 생각하는 다음 옵션 2개와 추천은 무엇인가요?`,
    FEEDBACK:(i,e,o)=>`Context: 지금 이 작업을 리뷰하는 이유를 먼저 맞춥니다.\nObservation: ${e||'관찰 가능한 행동/결과'}\nImpact: 이로 인해 다음 작업/고객에 어떤 영향이 있는지 말합니다.\nNext: ${o||'다음 버전에서 바꿀 한 가지 행동'}\nQuestion: 현재 방식을 선택한 이유가 있었나요?`,
    DECISION:(i,e,o)=>`Decision: ${o||i||'무엇을 결정하는지'}\nEvidence/Input: ${e||'핵심 근거'}\nDRI / D: 한 명을 지정합니다.\nScope: 어디까지 독립적으로 결정 가능한지 정합니다.\nReview: 언제 결과를 다시 볼지 정합니다.`,
    DELEGATION:(i,e,o)=>`Outcome: ${o||'완료 결과'}\nContext: ${e||'왜 중요한가'}\nAuthority: 직접 결정 가능한 범위\nGuardrail: 넘지 말아야 할 경계\nCheckpoint: 확인 시점\nEscalate when: 예산/일정/품질 임계값`,
    RECOGNITION:(i,e,o)=>`관찰한 행동: ${e||i||'구체적인 행동'}\n긍정적 영향: 그 행동이 팀/고객/결과에 만든 변화\nRepeat: ${o||'앞으로도 유지했으면 하는 행동'}\n사람의 성격이 아니라 행동과 영향을 칭찬합니다.`,
    DIFFICULT:(i,e,o)=>`Fact: ${e||'평가 없이 사실'}\nImpact: 이 사실이 일정/고객/팀에 미친 영향\nQuestion: 어떤 장애나 맥락이 있었나요?\nAgreement: ${o||'다음 행동 + Owner + Due'}\nFollow-up: 다시 확인할 날짜를 잡습니다.`,
    UPWARD:(i,e,o)=>`Headline: ${i||'한 문장 상태'}\nEvidence: ${e||'핵심 수치/사실'}\nRisk: 지금 결정하지 않으면 생기는 영향\nAsk: 상급자에게 필요한 결정/지원\nRecommendation: ${o||'내 추천'}\nNext: 결정 후 바로 실행할 다음 행동`,
    CRISIS:(i,e,o)=>`What changed: ${e||'바뀐 사실'}\nWhat remains true: 지켜야 할 원칙/고객 약속\nNew outcome: ${o||'새롭게 정의한 목표'}\nNot now: 지금 중단할 것\nNext 24h: ${i||'즉시 실행할 일'}\nOwner / Review: DRI와 다음 확인 시점`
  };
  function langPage(){const p=q('[data-page="LEADER_LANGUAGE"]');if(!p)return;renderPatterns();const out=q('[data-r29-language-output]',p);const scenario=q('[data-r29-language-scenario]',p), input=q('[data-r29-language-input]',p), evidence=q('[data-r29-language-evidence]',p), outcome=q('[data-r29-language-outcome]',p);const r43Cases=[
{scenario:'FEEDBACK',original:'도대체 이걸 왜 이렇게밖에 못 해?',evidence:'이번 보고서에서 핵심 지표가 누락되어 의사결정에 필요한 정보가 부족함',outcome:'다음 보고서부터 핵심 수치를 가장 앞쪽에 정리'},
{scenario:'DIFFICULT',original:'이걸 가르쳐줘야 하나? 지금 몇 년 차야?',evidence:'몇 차례 경험한 업무에서 같은 유형의 누락이 반복됨',outcome:'어디서 헷갈렸는지 함께 확인하고 다음 수행 기준을 정리'},
{scenario:'FEEDBACK',original:'내가 너 때문에 일을 못 하겠다.',evidence:'보고 일정이 밀리면서 다음 일정 조율도 함께 늦어짐',outcome:'다음부터 마감 하루 전에 중간 확인을 한 번 공유'},
{scenario:'QUESTION',original:'너는 도대체 뭘 잘하냐?',evidence:'최근 업무 속도와 결과물에서 강점이 충분히 활용되지 않는 것으로 보임',outcome:'본인이 강점을 살려 접근할 수 있는 방식과 아이디어를 먼저 제안'},
{scenario:'FEEDBACK',original:'이걸 내가 왜 다시 봐야 돼? 그냥 하지 마. 손 떼.',evidence:'현재 결과물은 내부 공유하기에 필요한 완성도와 핵심 포인트가 부족함',outcome:'핵심 포인트 2~3개를 보완해 다시 검토'}
];const rewrite=()=>{out.textContent=(templates[scenario.value]||templates.DIRECTION)(input.value.trim(),evidence.value.trim(),outcome.value.trim())};q('[data-r29-language-rewrite]',p).onclick=rewrite;q('[data-r29-language-sample]',p).onclick=()=>{scenario.value='FEEDBACK';input.value='이거 좀 약한데 다시 해주세요.';evidence.value='첫 3페이지 안에 고객 문제와 핵심 제안이 보이지 않음';outcome.value='오늘 17시까지 Problem → Insight → Proposition 구조로 수정';rewrite()};qa('[data-r43-use-case]',p).forEach(b=>b.onclick=()=>{
const c=r43Cases[+b.dataset.r43UseCase];if(!c)return;
scenario.value=c.scenario;input.value=c.original;evidence.value=c.evidence;outcome.value=c.outcome;rewrite();
q('[data-r29-language-output]',p)?.scrollIntoView({behavior:'smooth',block:'center'});
});q('[data-r29-language-save]',p).onclick=()=>{const logs=get(LKEY,[]);logs.unshift({scenario:scenario.value,original:input.value.trim(),rewrite:out.textContent,at:new Date().toISOString()});set(LKEY,logs.slice(0,8));renderLogs()};function renderLogs(){const root=q('[data-r29-language-log]',p);const logs=get(LKEY,[]);root.innerHTML=logs.length?`<div class="r29-kicker">RECENT PRACTICE</div>`+logs.slice(0,4).map(x=>`<div class="r29-log-item"><b>${esc(x.scenario)} · ${new Date(x.at).toLocaleDateString()}</b>${esc(x.original||'—')}<br><span>${esc((x.rewrite||'').split('\n')[0])}</span></div>`).join(''):''}renderLogs()}

  const samples={INNOUT:[['Discover','Customer','','Word of Mouth → Intent','방문 의도 형성','정보 부족'],['Arrive','Customer','','Travel → Store','Drive-Thru / 매장 진입','주차·혼잡'],['Queue','Customer','','Arrival → Line','대기 시작','대기시간'],['Order','Frontstage','Order Taker','Choice → Order','주문 확정','옵션 오해'],['Make to Order','Backstage','Kitchen','Order → Meal','신선도·속도','주방 병목'],['Call & Handoff','Handoff','Expeditor','Meal → Customer','정확한 전달','누락·호출 지연'],['Eat','Customer','','Meal → Experience','식사 경험','품질 편차'],['Depart / Signal','Data / SSOT','Manager','Experience → Signal','다음 개선','피드백 미수집']],STARBUCKS:[['Enter','Customer','','Need → Visit','방문 시작','혼잡'],['Choose','Frontstage','Barista','Menu → Choice','선택 용이성','복잡성'],['Customize','Decision','Barista','Choice → Spec','개인화','오주문'],['Make','Backstage','Bar Team','Spec → Drink','품질/속도','큐 병목'],['Handoff','Handoff','Bar Team','Drink → Customer','정확한 수령','대기/혼선'],['Stay / Leave','Customer','','Drink → Experience','공간/이동 경험','좌석/대기'],['Return','Data / SSOT','Store / CRM','Experience → Signal','재방문','신호 단절']]};
  let flow=[];
  function flowPage(){const p=q('[data-page="WORK_FLOW_MAP"]');if(!p)return;flow=get(FKEY,[]);if(!Array.isArray(flow)||!flow.length)flow=samples.STARBUCKS.map(x=>({stage:x[0],layer:x[1],owner:x[2],io:x[3],decision:x[4],impact:'',friction:x[5]}));const list=q('[data-r29-flow-list]',p), form=q('[data-r29-flow-form]',p);function render(){list.innerHTML=flow.map((x,i)=>`<article class="r29-flow-row"><div class="r29-flow-no">${String(i+1).padStart(2,'0')}</div><div class="r29-flow-copy"><strong>${esc(x.stage||'Untitled')}</strong><small>${esc(x.layer||'')} · ${esc(x.owner||'Owner UNKNOWN')}<br>${esc(x.io||'Input → Output')}<br>${esc(x.friction?`Friction: ${x.friction}`:'')}</small></div><button type="button" data-r29-edit-flow="${i}">편집</button></article>`).join('');qa('[data-r29-edit-flow]',list).forEach(b=>b.onclick=()=>load(+b.dataset.r29EditFlow))}function load(i){const x=flow[i]||{};q('[data-r29-flow-index]',p).value=String(i);q('[data-r29-flow-stage]',p).value=x.stage||'';q('[data-r29-flow-layer]',p).value=x.layer||'Customer';q('[data-r29-flow-owner]',p).value=x.owner||'';q('[data-r29-flow-io]',p).value=x.io||'';q('[data-r29-flow-decision]',p).value=x.decision||'';q('[data-r29-flow-impact]',p).value=x.impact||'';q('[data-r29-flow-friction]',p).value=x.friction||'';form.scrollIntoView({behavior:'smooth',block:'nearest'})}form.onsubmit=e=>{e.preventDefault();const x={stage:q('[data-r29-flow-stage]',p).value.trim(),layer:q('[data-r29-flow-layer]',p).value,owner:q('[data-r29-flow-owner]',p).value.trim(),io:q('[data-r29-flow-io]',p).value.trim(),decision:q('[data-r29-flow-decision]',p).value.trim(),impact:q('[data-r29-flow-impact]',p).value.trim(),friction:q('[data-r29-flow-friction]',p).value.trim()};const idx=+q('[data-r29-flow-index]',p).value;if(idx>=0&&flow[idx])flow[idx]=x;else flow.push(x);q('[data-r29-flow-index]',p).value='-1';form.reset();render()};q('[data-r29-flow-add]',p).onclick=()=>{q('[data-r29-flow-index]',p).value='-1';form.reset();q('[data-r29-flow-stage]',p).focus()};q('[data-r29-flow-clear]',p).onclick=()=>{flow=[];render()};q('[data-r29-flow-save]',p).onclick=()=>{set(FKEY,flow);q('[data-r29-flow-save]',p).textContent='저장됨';setTimeout(()=>q('[data-r29-flow-save]',p).textContent='Workflow 저장',900)};qa('[data-r29-load-sample]',p).forEach(b=>b.onclick=()=>{flow=(samples[b.dataset.r29LoadSample]||[]).map(x=>({stage:x[0],layer:x[1],owner:x[2],io:x[3],decision:x[4],impact:'',friction:x[5]}));render();p.querySelector('[data-r29-flow-list]')?.scrollIntoView({behavior:'smooth',block:'center'})});render()}
  function init(){langPage();flowPage()}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
})();
</script>
<script id="recovery-30-operating-context">
(function(){
 const FLOW_KEY='leader-os:r29:workflow', LINK_KEY='leader-os:r30:workflow-links:v1', DRI_KEY='leader-os:r30:dri-owner-model:v1', BASE_KEY='leader-os:r30:workflow-baseline:v1', EXP_KEY='leader-os:r30:process-experiments:v1';
 const ART_KEYS=['leader-os:operating-artifacts:v6','leader-os:operating-artifacts:v5','leader-os:operating-artifacts:v4','leader-os:operating-artifacts:v3'];
 const AI_KEY='leader-os:ai-usage-runtime:v1', CONF_KEY='leader-os:team-ssot-confirmed:v1';
 const CUSTOM_PAGES={LEADER_LANGUAGE:{label:'Leader Language',group:'FOCUS',after:'Leadership JD'},WORK_FLOW_MAP:{label:'Work Flow Map',group:'EXECUTION',after:'Work'}};
 function showCustomPage(id){const page=q(`[data-page="${id}"]`);if(!page)return;qa('[data-page]').forEach(x=>x.hidden=x!==page);qa('[data-primary-nav] a').forEach(a=>a.removeAttribute('aria-current'));q(`[data-r30-custom-page="${id}"]`)?.setAttribute('aria-current','page');const t=q('[data-topbar-title]');if(t)t.textContent=CUSTOM_PAGES[id]?.label||id;try{history.replaceState(null,'',id==='LEADER_LANGUAGE'?'#leader-language':'#work-flow-map')}catch{};window.scrollTo({top:0,behavior:'auto'});if(id==='WORK_FLOW_MAP')setTimeout(renderAll,0)}
 function ensureCustomNav(){const nav=q('[data-primary-nav]');if(!nav)return;for(const [id,cfg] of Object.entries(CUSTOM_PAGES)){let a=q(`[data-r30-custom-page="${id}"]`,nav);if(!a){const groups=qa('.nav-section',nav);const group=groups.find(g=>String(q('.nav-label',g)?.textContent||'').trim().toUpperCase()===cfg.group);if(!group)continue;a=document.createElement('a');a.href=id==='LEADER_LANGUAGE'?'#leader-language':'#work-flow-map';a.dataset.r30CustomPage=id;a.textContent=cfg.label;const target=qa('a',group).find(x=>String(x.textContent||'').trim()===cfg.after);target?target.insertAdjacentElement('afterend',a):group.append(a)}a.onclick=e=>{e.preventDefault();e.stopImmediatePropagation();showCustomPage(id)}}}
 const q=(s,r=document)=>r.querySelector(s),qa=(s,r=document)=>[...r.querySelectorAll(s)];
 const storage=window.__leaderOsStorage||localStorage;
 const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const load=(k,f)=>{try{const v=storage.getItem(k)||localStorage.getItem(k);return v?JSON.parse(v):f}catch{return f}};
 const save=(k,v)=>{try{storage.setItem(k,JSON.stringify(v))}catch{};try{localStorage.setItem(k,JSON.stringify(v))}catch{}};
 const readArtifacts=()=>{
   const live=window.LeaderOsOperatingArtifactBridge?.snapshot?.();
   if(live&&typeof live==='object')return live;
   for(const k of ART_KEYS){try{const raw=storage?.getItem?.(k);if(raw)return JSON.parse(raw)}catch{}}
   return {};
 };
 const arr=(o,k)=>Array.isArray(o?.[k])?o[k]:[];
 const ai=()=>window.LeaderOsAiUsageBridge?.get?.()||load(AI_KEY,{contexts:[]});
 const confirmed=()=>load(CONF_KEY,[]);
 const DEFAULT_FLOW=[
  {stage:'Enter',layer:'Customer',owner:'',io:'Need → Visit',decision:'방문 시작',impact:'',friction:'혼잡'},
  {stage:'Choose',layer:'Frontstage',owner:'Barista',io:'Menu → Choice',decision:'선택 지원',impact:'',friction:'복잡성'},
  {stage:'Customize',layer:'Decision',owner:'Barista',io:'Choice → Spec',decision:'개인화 확정',impact:'',friction:'오주문'},
  {stage:'Make',layer:'Backstage',owner:'Bar Team',io:'Spec → Drink',decision:'품질/속도',impact:'',friction:'큐 병목'},
  {stage:'Handoff',layer:'Handoff',owner:'Bar Team',io:'Drink → Customer',decision:'',impact:'',friction:'대기/혼선'},
  {stage:'Stay / Leave',layer:'Customer',owner:'',io:'Drink → Experience',decision:'',impact:'',friction:'좌석/대기'},
  {stage:'Return',layer:'Data / SSOT',owner:'Store / CRM',io:'Experience → Signal',decision:'재방문 신호',impact:'',friction:'신호 단절'}
 ];
 const idOf=(r,type,i)=>String(r?.id||`${type}:${r?.project||r?.milestone||r?.decision||r?.title||r?.task||i}`);
 const nameOf=(r,type)=>String(r?.project||r?.milestone||r?.decision||r?.event||r?.title||r?.task||r?.priority1||r?.person||r?.id||type);
 const options=(rows,type)=>rows.map((r,i)=>({id:idOf(r,type,i),label:`${type} · ${nameOf(r,type)}`,row:r}));
 function catalog(){const a=readArtifacts();return {work:options(arr(a,'WORK_MAP'),'WORK'),milestone:options(arr(a,'MILESTONES'),'MILESTONE'),decision:options(arr(a,'DECISION_RIGHTS'),'DECISION'),calendar:options(arr(a,'TEAM_CALENDAR'),'CALENDAR'),artifacts:a}}
 function ssotOptions(){const ctx=(ai().contexts||[]).filter(c=>String(c.status||'').toUpperCase()==='CONFIRMED');const promoted=confirmed().filter(x=>String(x.status||'CONFIRMED').toUpperCase()==='CONFIRMED');const a=ctx.map(c=>({id:c.id,label:`CONTEXT · ${c.name||c.id}`}));promoted.forEach(x=>{if(!a.some(y=>y.id===x.id))a.push({id:x.id,label:`TEAM SSOT · ${x.name||x.id}`})});return a}
 function flow(){const f=load(FLOW_KEY,[]);return Array.isArray(f)&&f.length?f:DEFAULT_FLOW.map(x=>({...x,_demo:true}))}
 function links(){const x=load(LINK_KEY,{});return x&&typeof x==='object'&&!Array.isArray(x)?x:{}}
 function driStore(){const x=load(DRI_KEY,{});return x&&typeof x==='object'&&!Array.isArray(x)?x:{}}
 function stepKey(i,x){return `STEP:${i}:${String(x?.stage||'UNTITLED').replace(/[^A-Za-z0-9가-힣]+/g,'_').slice(0,32)}`}
 function selectOpts(items,current){return `<option value="">연결하지 않음</option>`+items.map(x=>`<option value="${esc(x.id)}" ${x.id===current?'selected':''}>${esc(x.label)}</option>`).join('')}
 function recordLabel(id,items){return items.find(x=>x.id===id)?.label||id||'—'}
 function risks(){const f=flow(),l=links(),ss=ssotOptions(),out=[];f.forEach((x,i)=>{const k=stepKey(i,x),ln=l[k]||{},dri=String(ln.dri||x.owner||'').trim(),layer=String(x.layer||'');if(!dri)out.push({level:'BAD',type:'DRI MISSING',stage:x.stage||`Step ${i+1}`,copy:'이 단계의 결과 책임자가 한 명으로 정해지지 않았습니다.',key:k});if(dri&&(!ln.authority||!ln.guardrail))out.push({level:'WARN',type:'AUTHORITY GAP',stage:x.stage||`Step ${i+1}`,copy:'DRI는 있지만 독립 결정 범위 또는 Guardrail이 비어 있습니다.',key:k});if(/Handoff/i.test(layer)&&!String(ln.handoff||x.decision||'').trim())out.push({level:'WARN',type:'HANDOFF RISK',stage:x.stage||`Step ${i+1}`,copy:'다음 Owner에게 무엇을 넘기는지 확인이 필요합니다.',key:k});if(/Data|SSOT/i.test(layer)&&!ln.ssotId)out.push({level:'BAD',type:'SSOT GAP',stage:x.stage||`Step ${i+1}`,copy:'이 단계가 읽는 Canonical Context/SSOT가 연결되지 않았습니다.',key:k});if(String(x.friction||'').trim()&&!ln.workId&&!ln.decisionId)out.push({level:'INFO',type:'UNLINKED FRICTION',stage:x.stage||`Step ${i+1}`,copy:'Friction이 기록됐지만 실제 Work/Decision과 아직 연결되지 않았습니다.',key:k})});return out}
 function ownerSources(){const c=catalog(),f=flow(),rows=[];c.work.forEach(x=>rows.push({ref:x.id,type:'WORK',name:x.label.replace(/^WORK · /,''),owner:x.row?.dri||x.row?.owner||''}));c.milestone.forEach(x=>rows.push({ref:x.id,type:'MILESTONE',name:x.label.replace(/^MILESTONE · /,''),owner:x.row?.dri||x.row?.owner||''}));if(!rows.length)f.forEach((x,i)=>rows.push({ref:stepKey(i,x),type:'WORKFLOW',name:x.stage||`Step ${i+1}`,owner:x.owner||'',demo:true}));return rows}
 function renderOwnerModel(){const root=q('[data-r30-work-owner-model]');if(!root)return;const s=driStore(),rows=ownerSources(),counts={};rows.forEach(r=>{const v=s[r.ref]||{},d=String(v.dri||r.owner||'').trim();if(d)counts[d]=(counts[d]||0)+1});const overload=Object.entries(counts).filter(([,n])=>n>=4);root.innerHTML=`<div class="r30-head"><div><div class="r30-kicker">DRI OWNER MODEL · RECOVERY 30</div><h2>Work / Milestone의 결과 책임자를 한 명으로 명확히</h2><p>DRI는 모든 일을 혼자 하는 사람이 아니라 Outcome을 끝까지 끌고 가는 단일 Owner입니다. 원본 Artifact를 덮어쓰지 않고 ID 기반 Owner Model로 연결합니다.</p></div><span class="r30-badge ${overload.length?'warn':'good'}">${overload.length?`${overload.length} LOAD CHECK`:'OWNER MODEL'}</span></div><div class="r30-grid three" style="margin-bottom:10px"><div class="r30-stat"><span>TRACKED OBJECTS</span><strong>${rows.length}</strong></div><div class="r30-stat"><span>DRI MISSING</span><strong>${rows.filter(r=>!String((s[r.ref]||{}).dri||r.owner||'').trim()).length}</strong></div><div class="r30-stat"><span>LOAD CHECK ≥4</span><strong>${overload.length}</strong></div></div><div class="r30-owner-list">${rows.slice(0,12).map(r=>{const v=s[r.ref]||{},d=v.dri??r.owner??'';return `<div class="r30-owner-row"><div class="r30-owner-copy"><b>${esc(r.name)}</b><small>${esc(r.type)} · ${esc(r.ref)}${r.demo?' · WORKFLOW FALLBACK':''}</small></div><input value="${esc(d)}" data-r30-dri="${esc(r.ref)}" placeholder="DRI"><select data-r30-authority="${esc(r.ref)}"><option value="">Authority UNKNOWN</option>${['EXECUTE','RECOMMEND','DECIDE_WITHIN_GUARDRAIL','ESCALATE'].map(x=>`<option ${v.authority===x?'selected':''}>${x}</option>`).join('')}</select><input value="${esc(v.guardrail||'')}" data-r30-guardrail="${esc(r.ref)}" placeholder="Guardrail / Escalation"><button type="button" data-r30-owner-save="${esc(r.ref)}">저장</button></div>`}).join('')||'<div class="r30-empty">Work/Milestone 또는 Workflow를 만들면 DRI Owner Model이 나타납니다.</div>'}</div>${overload.length?`<div class="safe">Ownership Load는 사람 평가가 아니라 병목 신호입니다. ${overload.map(([n,c])=>`${esc(n)} ${c}개`).join(' · ')}</div>`:''}`;qa('[data-r30-owner-save]',root).forEach(b=>b.onclick=()=>{const ref=b.dataset.r30OwnerSave,all=driStore();all[ref]={dri:q(`[data-r30-dri="${CSS.escape(ref)}"]`,root)?.value.trim()||'',authority:q(`[data-r30-authority="${CSS.escape(ref)}"]`,root)?.value||'',guardrail:q(`[data-r30-guardrail="${CSS.escape(ref)}"]`,root)?.value.trim()||'',updatedAt:new Date().toISOString()};save(DRI_KEY,all);renderAll()})}
 function renderLinker(){const page=q('[data-page="WORK_FLOW_MAP"]');if(!page)return;const f=flow(),l=links(),c=catalog(),ss=ssotOptions(),map=q('[data-r30-connected-map]',page),stepSel=q('[data-r30-step-select]',page);if(!map||!stepSel)return;const old=Number(stepSel.value||0);stepSel.innerHTML=f.map((x,i)=>`<option value="${i}">${String(i+1).padStart(2,'0')} · ${esc(x.stage||'Untitled')}</option>`).join('')||'<option value="0">Workflow 없음</option>';stepSel.value=String(Math.min(old,Math.max(0,f.length-1)));function mapHtml(){map.innerHTML=f.map((x,i)=>{const k=stepKey(i,x),v=l[k]||{},rs=risks().filter(r=>r.key===k);return `<article class="r30-map-row ${Number(stepSel.value)===i?'selected':''}"><div class="r30-map-no">${String(i+1).padStart(2,'0')}</div><div class="r30-map-copy"><b>${esc(x.stage||'Untitled')}</b><small>${esc(x.layer||'')} · DRI ${esc(v.dri||x.owner||'UNKNOWN')}<br>${esc(x.io||'Input → Output')}</small><div class="r30-tags">${v.workId?`<span class="r30-tag">${esc(recordLabel(v.workId,c.work))}</span>`:''}${v.decisionId?`<span class="r30-tag">${esc(recordLabel(v.decisionId,c.decision))}</span>`:''}${v.ssotId?`<span class="r30-tag">SSOT · ${esc(v.ssotId)}</span>`:''}${rs.map(r=>`<span class="r30-tag">${esc(r.type)}</span>`).join('')}</div></div><button type="button" data-r30-map-edit="${i}">연결</button></article>`}).join('')||'<div class="r30-empty">먼저 Workflow Builder에서 AS-IS Flow를 만드세요.</div>';q('[data-r30-link-count]',page).textContent=`${Object.keys(l).length} LINKS`;q('[data-r30-risk-count]',page).textContent=`${risks().length} SIGNALS`;q('[data-r30-risk-count]',page).className=`r30-badge ${risks().some(r=>r.level==='BAD')?'bad':risks().length?'warn':'good'}`;qa('[data-r30-map-edit]',map).forEach(b=>b.onclick=()=>{stepSel.value=b.dataset.r30MapEdit;loadForm();mapHtml()})}
 function loadForm(){const i=Number(stepSel.value||0),x=f[i]||{},v=l[stepKey(i,x)]||{};q('[data-r30-link-step]',page).value=String(i);q('[data-r30-link-dri]',page).value=v.dri||x.owner||'';q('[data-r30-link-work]',page).innerHTML=selectOpts(c.work,v.workId);q('[data-r30-link-milestone]',page).innerHTML=selectOpts(c.milestone,v.milestoneId);q('[data-r30-link-decision]',page).innerHTML=selectOpts(c.decision,v.decisionId);q('[data-r30-link-calendar]',page).innerHTML=selectOpts(c.calendar,v.calendarId);q('[data-r30-link-ssot]',page).innerHTML=selectOpts(ss,v.ssotId);q('[data-r30-link-authority]',page).value=v.authority||'';q('[data-r30-link-guardrail]',page).value=v.guardrail||'';q('[data-r30-link-handoff]',page).value=v.handoff||''}
 stepSel.onchange=()=>{loadForm();mapHtml()};q('[data-r30-link-form]',page).onsubmit=e=>{e.preventDefault();const i=Number(stepSel.value||0),x=f[i];if(!x)return;const k=stepKey(i,x),all=links();all[k]={stepIndex:i,stage:x.stage||'',dri:q('[data-r30-link-dri]',page).value.trim(),workId:q('[data-r30-link-work]',page).value,milestoneId:q('[data-r30-link-milestone]',page).value,decisionId:q('[data-r30-link-decision]',page).value,calendarId:q('[data-r30-link-calendar]',page).value,ssotId:q('[data-r30-link-ssot]',page).value,authority:q('[data-r30-link-authority]',page).value,guardrail:q('[data-r30-link-guardrail]',page).value.trim(),handoff:q('[data-r30-link-handoff]',page).value.trim(),updatedAt:new Date().toISOString()};save(LINK_KEY,all);renderAll()};q('[data-r30-link-clear]',page).onclick=()=>{const i=Number(stepSel.value||0),x=f[i];if(!x)return;const all=links();delete all[stepKey(i,x)];save(LINK_KEY,all);renderAll()};mapHtml();loadForm();renderRisks();renderDiff();renderExperiments()}
 function renderRisks(){const page=q('[data-page="WORK_FLOW_MAP"]'),root=q('[data-r30-flow-risks]',page);if(!root)return;const rs=risks();root.innerHTML=rs.slice(0,8).map(r=>`<div class="r30-risk"><span class="r30-badge ${r.level==='BAD'?'bad':r.level==='WARN'?'warn':'info'}">${esc(r.type)}</span><div><b>${esc(r.stage)}</b><span>${esc(r.copy)}</span></div><code>${esc(r.key)}</code></div>`).join('')||'<div class="r30-empty">현재 연결 기준에서 DRI / Authority / Handoff / SSOT 구조 신호가 없습니다.</div>'}
 function flowSnapshot(){const f=flow(),l=links();return f.map((x,i)=>({...x,link:l[stepKey(i,x)]||{}}))}
 function renderDiff(){const page=q('[data-page="WORK_FLOW_MAP"]');if(!page)return;const base=load(BASE_KEY,null),cur=flowSnapshot(),bs=q('[data-r30-baseline-summary]',page),dr=q('[data-r30-diff]',page);if(!base){bs.className='r30-empty';bs.textContent='아직 AS-IS Snapshot이 없습니다.';dr.className='r30-empty';dr.textContent='Baseline을 저장하면 변경점을 비교합니다.';return}bs.className='';bs.innerHTML=`<div class="r30-diff-row"><b>${new Date(base.at).toLocaleString('ko-KR')}</b><br>${base.flow.length} steps · AS-IS Snapshot</div>`;const map=a=>new Map(a.map((x,i)=>[String(x.stage||`#${i}`),x])),b=map(base.flow),c=map(cur),rows=[];for(const [k,x] of c){if(!b.has(k)){rows.push(`+ ${k} 단계 추가`);continue}const y=b.get(k),changes=[];['owner','decision','friction'].forEach(p=>{if(String(x[p]||'')!==String(y[p]||''))changes.push(p)});['dri','workId','decisionId','ssotId','authority','guardrail','handoff'].forEach(p=>{if(String(x.link?.[p]||'')!==String(y.link?.[p]||''))changes.push(`link.${p}`)});if(changes.length)rows.push(`~ ${k} · ${changes.join(', ')}`)}for(const [k] of b)if(!c.has(k))rows.push(`− ${k} 단계 제거`);dr.className='';dr.innerHTML=rows.length?rows.map(x=>`<div class="r30-diff-row">${esc(x)}</div>`).join(''):'<div class="r30-diff-row">변경 없음 · Baseline과 동일</div>'}
 function bindBaseline(){const page=q('[data-page="WORK_FLOW_MAP"]');const b=q('[data-r30-baseline]',page);if(b)b.onclick=()=>{save(BASE_KEY,{at:new Date().toISOString(),flow:flowSnapshot()});renderDiff()}}
 function renderExperiments(){const page=q('[data-page="WORK_FLOW_MAP"]'),root=q('[data-r30-exp-list]',page),form=q('[data-r30-exp-form]',page);if(!root||!form)return;const list=load(EXP_KEY,[]);root.innerHTML=list.slice().reverse().slice(0,6).map(x=>`<div class="r30-exp-item"><div><b>${esc(x.hypothesis||'Process Experiment')}</b><span>${esc(x.change||'')}<br>Metric · ${esc(x.metric||'—')} · Review ${esc(x.reviewDate||'—')}<br>Evidence · ${esc(x.evidence||'아직 없음')}</span></div><span class="r30-badge ${x.status==='DONE'?'good':x.status==='REVIEW'?'warn':'info'}">${esc(x.status)}</span></div>`).join('')||'<div class="r30-empty">아직 Process Experiment가 없습니다. 한 번에 하나의 변경만 검증하는 것을 권장합니다.</div>';form.onsubmit=e=>{e.preventDefault();const rows=load(EXP_KEY,[]);rows.push({id:`PEX-${Date.now().toString(36)}`,hypothesis:q('[data-r30-exp-hypothesis]',page).value.trim(),metric:q('[data-r30-exp-metric]',page).value.trim(),change