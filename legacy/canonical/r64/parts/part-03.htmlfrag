:q('[data-r30-exp-change]',page).value.trim(),reviewDate:q('[data-r30-exp-date]',page).value,status:q('[data-r30-exp-status]',page).value,evidence:q('[data-r30-exp-evidence]',page).value.trim(),createdAt:new Date().toISOString()});save(EXP_KEY,rows.slice(-30));form.reset();renderExperiments()}}
 function today(){const page=q('[data-page="TODAY"]');if(!page)return;let root=q('[data-r30-today]',page);if(root)root.remove();root=document.createElement('section');root.className='r30-card r30-today-card';root.dataset.r30Today='';const rs=risks();const top=rs.slice(0,4);root.innerHTML=`<div class="r30-head"><div><div class="r30-kicker">OPERATING FLOW ATTENTION</div><h2>고객까지 이어지는 업무 흐름의 구조 신호</h2><p>사람 점수가 아니라 DRI·권한·핸드오프·SSOT 누락을 보여줍니다.</p></div><span class="r30-badge ${rs.some(r=>r.level==='BAD')?'bad':rs.length?'warn':'good'}">${rs.length} SIGNALS</span></div><div class="r30-risk-list">${top.map(r=>`<div class="r30-risk"><span class="r30-badge ${r.level==='BAD'?'bad':r.level==='WARN'?'warn':'info'}">${esc(r.type)}</span><div><b>${esc(r.stage)}</b><span>${esc(r.copy)}</span></div><button type="button" data-r30-open-flow>Flow</button></div>`).join('')||'<div class="r30-empty">현재 Workflow 기준에서 우선 Attention이 필요한 구조 신호가 없습니다.</div>'}</div>`;const sub=q(':scope > .sub',page);sub?.insertAdjacentElement('afterend',root);qa('[data-r30-open-flow]',root).forEach(b=>b.onclick=()=>showCustomPage('WORK_FLOW_MAP'))}
 function contextualNudges(){const rs=risks(),first=rs[0];const configs={ONE_ON_ONE:{mode:first?.type==='AUTHORITY GAP'?'DELEGATION':'QUESTION',title:'1:1에서 권한과 장애를 확인',say:first?`“${first.stage} 단계에서 지금 혼자 결정해도 되는 범위와 제가 확인해야 하는 경계가 어디까지인가요?”`:'“제가 답을 주기 전에, 지금 가장 막히는 의존성과 필요한 권한을 먼저 설명해줄래요?”'},MEETINGS:{mode:'DECISION / HANDOFF',title:'회의 종료 전에 Owner와 Handoff를 닫기',say:first?`“${first.stage} 단계는 오늘 회의에서 Owner, 넘길 Output, 다음 확인 시점까지 닫겠습니다.”`:'“토론이 끝나면 Decision / Owner / Due / Handoff를 한 문장으로 복기하겠습니다.”'},DECISIONS:{mode:'DECISION',title:'결정 언어를 Evidence와 Review Date로 닫기',say:first?`“${first.stage} 관련 결정은 DRI 한 명, 판단 근거, 적용 범위, Review Date까지 기록하겠습니다.”`:'“무엇을 누가 결정하고, 어떤 Evidence로 언제 다시 검토할지 정하겠습니다.”'}};for(const [pageId,cfg] of Object.entries(configs)){const page=q(`[data-page="${pageId}"]`);if(!page)continue;let card=q('[data-r30-context-nudge]',page);if(card)card.remove();card=document.createElement('section');card.className='r30-context-nudge';card.dataset.r30ContextNudge='';card.innerHTML=`<div class="r30-kicker">LEADER LANGUAGE · WORKFLOW CONTEXT</div><h2>${esc(cfg.title)}</h2><p>현재 Workflow Risk를 읽어 이 화면에서 사용할 언어 모드를 제안합니다. 자동 전송하지 않습니다.</p><div class="r30-say"><b>${esc(cfg.mode)}</b><br>${esc(cfg.say)}</div>`;const sub=q(':scope > .sub',page);sub?.insertAdjacentElement('afterend',card)}}
 function renderAll(){ensureCustomNav();renderOwnerModel();renderLinker();bindBaseline();today();contextualNudges()}
 document.addEventListener('click',e=>{if(e.target?.matches?.('[data-r29-flow-save],[data-r29-load-sample]')||e.target?.closest?.('[data-r29-flow-form] button'))setTimeout(renderAll,80)});
 document.addEventListener('submit',e=>{if(e.target?.matches?.('[data-r29-flow-form]'))setTimeout(renderAll,80)});
 window.addEventListener('storage',e=>{if([FLOW_KEY,LINK_KEY,DRI_KEY,BASE_KEY,EXP_KEY,...ART_KEYS,AI_KEY,CONF_KEY].includes(e.key))renderAll()});
 window.addEventListener('leaderos:artifacts-changed',()=>renderAll());
 ensureCustomNav();setTimeout(()=>{ensureCustomNav();renderAll()},80);const nav=q('[data-primary-nav]');if(nav)new MutationObserver(()=>ensureCustomNav()).observe(nav,{childList:true,subtree:true});
 window.LeaderOsR30={render:renderAll,risks,flowSnapshot,showCustomPage};
})();
</script>
<script id="recovery-31-flow-time-directory">
(function(){
 const DIR_KEY='leader-os:r31:team-directory:v1', OWNER_KEY='leader-os:r31:dri-artifacts:v1', METRIC_KEY='leader-os:r31:workflow-metrics:v1', HANDOFF_KEY='leader-os:r31:experiment-handoff:v1', ONBOARD_KEY='leader-os:r31:workflow-onboarding:v1';
 const ART_KEYS=['leader-os:operating-artifacts:v6','leader-os:operating-artifacts:v5','leader-os:operating-artifacts:v4','leader-os:operating-artifacts:v3'];
 const FLOW_KEY='leader-os:r29:workflow', LINK_KEY='leader-os:r30:workflow-links:v1', EXP_KEY='leader-os:r30:process-experiments:v1';
 const storage=window.__leaderOsStorage||localStorage, q=(s,r=document)=>r.querySelector(s), qa=(s,r=document)=>[...r.querySelectorAll(s)];
 const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const load=(k,f)=>{try{const v=storage.getItem(k)||localStorage.getItem(k);return v?JSON.parse(v):f}catch{return f}},save=(k,v)=>{try{storage.setItem(k,JSON.stringify(v))}catch{};try{localStorage.setItem(k,JSON.stringify(v))}catch{}};
 const artifacts=()=>{
   const live=window.LeaderOsOperatingArtifactBridge?.snapshot?.();
   if(live&&typeof live==='object')return live;
   for(const k of ART_KEYS){try{const raw=storage.getItem(k)||localStorage.getItem(k);if(raw)return JSON.parse(raw)}catch{}}
   return {};
 };
 const arr=(o,k)=>Array.isArray(o?.[k])?o[k]:[];
 const slug=s=>String(s||'member').normalize('NFKC').toLowerCase().replace(/[^a-z0-9가-힣]+/g,'-').replace(/^-|-$/g,'').slice(0,36)||'member';
 const memberName=r=>String(r?.person||r?.name||r?.member||r?.owner||r?.title||'').trim(), memberRole=r=>String(r?.role||r?.job||r?.responsibility||r?.team||'Role UNKNOWN').trim();
 const demoDir=[{id:'member:minji',name:'민지',role:'PM',team:'Team Alpha',demo:true},{id:'member:junho',name:'준호',role:'Creative Lead',team:'Team Alpha',demo:true},{id:'member:seoyeon',name:'서연',role:'Operations',team:'Team Alpha',demo:true},{id:'member:jiwoo',name:'지우',role:'Analyst',team:'Team Alpha',demo:true}];
 function teamDirectory(){const a=artifacts(),raw=arr(a,'TEAM_MAP'),seen=new Set(),out=[];raw.forEach((r,i)=>{const name=memberName(r);if(!name)return;const id=String(r.id||`member:${slug(name)}`);if(seen.has(id))return;seen.add(id);out.push({id,name,role:memberRole(r),team:String(r.team||r.department||'Team'),source:'TEAM_MAP'})});const local=load(DIR_KEY,[]);(Array.isArray(local)?local:[]).forEach(m=>{if(m?.id&&!seen.has(m.id)){seen.add(m.id);out.push(m)}});return out.length?out:demoDir}
 function flow(){const base=load(FLOW_KEY,[]);if(Array.isArray(base)&&base.length)return base;return [{stage:'Enter',layer:'Customer',owner:'',io:'Need → Visit',friction:'혼잡'},{stage:'Choose',layer:'Frontstage',owner:'Barista',io:'Menu → Choice',friction:'복잡성'},{stage:'Customize',layer:'Decision',owner:'Barista',io:'Choice → Spec',friction:'오주문'},{stage:'Make',layer:'Backstage',owner:'Bar Team',io:'Spec → Drink',friction:'큐 병목'},{stage:'Handoff',layer:'Handoff',owner:'Bar Team',io:'Drink → Customer',friction:'대기/혼선'},{stage:'Stay / Leave',layer:'Customer',owner:'',io:'Drink → Experience',friction:'좌석/대기'},{stage:'Return',layer:'Data / SSOT',owner:'Store / CRM',io:'Experience → Signal',friction:'신호 단절'}]}
 function stepKey(i,x){return `STEP:${i}:${String(x?.stage||'UNTITLED').replace(/[^A-Za-z0-9가-힣]+/g,'_').slice(0,32)}`}
 function links(){const x=load(LINK_KEY,{});return x&&typeof x==='object'&&!Array.isArray(x)?x:{}}
 function catalog(){const a=artifacts(),make=(rows,t)=>rows.map((r,i)=>({id:String(r.id||`${t}:${r.project||r.milestone||r.title||r.task||i}`),label:String(r.project||r.milestone||r.title||r.task||r.decision||r.event||r.id||`${t} ${i+1}`),row:r}));return {work:make(arr(a,'WORK_MAP'),'WORK'),milestone:make(arr(a,'MILESTONES'),'MILESTONE'),calendar:make(arr(a,'TEAM_CALENDAR'),'CALENDAR'),decision:make(arr(a,'DECISION_RIGHTS'),'DECISION')}}
 function sourceRows(){const c=catalog(),rows=[];c.work.forEach(x=>rows.push({ref:x.id,type:'WORK',name:x.label,row:x.row}));c.milestone.forEach(x=>rows.push({ref:x.id,type:'MILESTONE',name:x.label,row:x.row}));if(!rows.length)flow().forEach((x,i)=>rows.push({ref:stepKey(i,x),type:'WORKFLOW',name:x.stage||`Step ${i+1}`,row:x,demo:true}));return rows}
 function ownerStore(){const x=load(OWNER_KEY,{});return x&&typeof x==='object'&&!Array.isArray(x)?x:{}}
 function directoryOptions(current){return `<option value="">DRI UNKNOWN</option>`+teamDirectory().map(m=>`<option value="${esc(m.id)}" ${m.id===current?'selected':''}>${esc(m.name)} · ${esc(m.role)}</option>`).join('')}
 function memberBy(id){return teamDirectory().find(m=>m.id===id)||null}
 function oldDriStore(){try{return JSON.parse(storage.getItem('leader-os:r30:dri-owner-model:v1')||localStorage.getItem('leader-os:r30:dri-owner-model:v1')||'{}')}catch{return {}}}
 function ensureWorkPanel(){const old=q('[data-r30-work-owner-model]');if(old)old.classList.add('r31-hidden-r30-owner');const page=q('[data-page="WORK"]');if(!page)return null;let root=q('[data-r31-owner-model]',page);if(!root){root=document.createElement('section');root.className='r31-card';root.dataset.r31OwnerModel='';old?old.insertAdjacentElement('afterend',root):(q(':scope > .sub',page)?.insertAdjacentElement('afterend',root));}return root}
 function renderDirectory(){const page=q('[data-page="TEAM"]');if(!page)return;let root=q('[data-r31-directory]',page);if(!root){root=document.createElement('section');root.className='r31-card';root.dataset.r31Directory='';q(':scope > .sub',page)?.insertAdjacentElement('afterend',root)}const d=teamDirectory();root.innerHTML=`<div class="r31-head"><div><div class="r31-kicker">TEAM DIRECTORY · RECOVERY 31</div><h2>DRI는 이름 문자열이 아니라 실제 Member ID로 연결합니다</h2><p>Team Map의 구성원을 우선 사용합니다. Team Map이 없으면 Preview 이해를 위한 DEMO Directory를 표시합니다.</p></div><span class="r31-badge ${d.some(x=>x.demo)?'info':'good'}">${d.some(x=>x.demo)?'DEMO':'TEAM MAP'} · ${d.length}</span></div><div class="r31-dir-grid">${d.map(m=>`<div class="r31-member"><b>${esc(m.name)}</b><small>${esc(m.role)} · ${esc(m.team||'Team')}<br>${esc(m.id)}</small></div>`).join('')}</div>`}
 function renderOwners(){const root=ensureWorkPanel();if(!root)return;const rows=sourceRows(),store=ownerStore(),legacy=oldDriStore(),counts={};rows.forEach(r=>{const a=store[r.ref]||{},m=memberBy(a.memberId),name=m?.name||a.memberName||legacy[r.ref]?.dri||'';if(name)counts[name]=(counts[name]||0)+1});const loads=Object.entries(counts).filter(([,n])=>n>=4);root.innerHTML=`<div class="r31-head"><div><div class="r31-kicker">VERSIONED DRI ARTIFACT · RECOVERY 31</div><h2>실제 팀원 ID + Authority + Human Confirm</h2><p>Confirmed Owner를 수정하면 새 Version의 DRAFT가 만들어집니다. 사람 평가가 아니라 결과 책임과 권한의 운영 계약입니다.</p></div><span class="r31-badge ${loads.length?'warn':'good'}">${loads.length?`${loads.length} LOAD CHECK`:'OWNER CONTRACT'}</span></div><div class="r31-stats"><div class="r31-stat"><span>TRACKED</span><strong>${rows.length}</strong></div><div class="r31-stat"><span>CONFIRMED</span><strong>${rows.filter(r=>store[r.ref]?.status==='CONFIRMED').length}</strong></div><div class="r31-stat"><span>DRAFT</span><strong>${rows.filter(r=>store[r.ref]?.status==='DRAFT').length}</strong></div><div class="r31-stat"><span>LOAD CHECK</span><strong>${loads.length}</strong></div></div><div class="r31-owner-list">${rows.slice(0,14).map(r=>{const a=store[r.ref]||{},legacyD=legacy[r.ref]||{},current=a.memberId||'',status=a.status||'DRAFT',ver=a.version||1;return `<div class="r31-owner-row"><div class="r31-owner-copy"><b>${esc(r.name)}</b><small>${esc(r.type)} · ${esc(r.ref)} · v${ver} · ${status}</small></div><select data-r31-member="${esc(r.ref)}">${directoryOptions(current)}</select><select data-r31-authority="${esc(r.ref)}"><option value="">Authority UNKNOWN</option>${['EXECUTE','RECOMMEND','DECIDE_WITHIN_GUARDRAIL','ESCALATE'].map(x=>`<option ${String(a.authority||legacyD.authority||'')===x?'selected':''}>${x}</option>`).join('')}</select><input data-r31-guardrail="${esc(r.ref)}" value="${esc(a.guardrail??legacyD.guardrail??'')}" placeholder="Guardrail / Escalation"><button type="button" data-r31-owner-save="${esc(r.ref)}">Draft 저장</button><button type="button" ${status==='CONFIRMED'?'disabled':''} class="${status==='DRAFT'?'primary':''}" data-r31-owner-confirm="${esc(r.ref)}">${status==='CONFIRMED'?'Confirmed':'Human Confirm'}</button></div>`}).join('')}</div>${loads.length?`<div class="r31-note">Ownership Load는 개인 성과평가가 아니라 병목 확인 신호입니다. ${loads.map(([n,c])=>`${esc(n)} ${c}개`).join(' · ')}</div>`:''}`;
 qa('[data-r31-owner-save]',root).forEach(b=>b.onclick=()=>{const ref=b.dataset.r31OwnerSave,all=ownerStore(),prev=all[ref]||{},memberId=q(`[data-r31-member="${CSS.escape(ref)}"]`,root)?.value||'',m=memberBy(memberId),authority=q(`[data-r31-authority="${CSS.escape(ref)}"]`,root)?.value||'',guardrail=q(`[data-r31-guardrail="${CSS.escape(ref)}"]`,root)?.value.trim()||'',changed=prev.memberId!==memberId||prev.authority!==authority||prev.guardrail!==guardrail;let version=prev.version||1,history=Array.isArray(prev.history)?prev.history:[];if(prev.status==='CONFIRMED'&&changed){history=[...history,{version:prev.version||1,memberId:prev.memberId||'',memberName:prev.memberName||'',authority:prev.authority||'',guardrail:prev.guardrail||'',status:'CONFIRMED',confirmedAt:prev.confirmedAt||null}].slice(-10);version=(prev.version||1)+1}all[ref]={sourceRef:ref,memberId,memberName:m?.name||'',authority,guardrail,status:'DRAFT',version,history,updatedAt:new Date().toISOString(),confirmedAt:null};save(OWNER_KEY,all);renderAll()});
 qa('[data-r31-owner-confirm]',root).forEach(b=>b.onclick=()=>{const ref=b.dataset.r31OwnerConfirm,all=ownerStore(),a=all[ref];if(!a||!a.memberId||!a.authority){alert('DRI와 Authority를 먼저 지정하세요.');return}a.status='CONFIRMED';a.confirmedAt=new Date().toISOString();a.updatedAt=a.confirmedAt;all[ref]=a;save(OWNER_KEY,all);renderAll()})}
 function metricStore(){const x=load(METRIC_KEY,{});return x&&typeof x==='object'&&!Array.isArray(x)?x:{}}
 function duration(v){const n=Number(v);return Number.isFinite(n)&&n>=0?n:0}
 function dateValue(row){if(!row)return null;for(const k of ['dueDate','due','date','reviewDate','at','startDate','start']){const v=row[k];if(v){const d=new Date(v);if(!isNaN(d))return d}}return null}
 function linkedDue(link){const c=catalog();for(const pair of [[link.milestoneId,c.milestone],[link.calendarId,c.calendar]]){const hit=pair[1].find(x=>x.id===pair[0]);const d=dateValue(hit?.row);if(d)return d}return null}
 function timeSignals(){const f=flow(),l=links(),m=metricStore(),out=[],now=Date.now();f.forEach((x,i)=>{const k=stepKey(i,x),v=m[k]||{},link=l[k]||{},cycle=duration(v.cycleMin),wait=duration(v.waitMin),sla=duration(v.slaMin),lead=cycle+wait;if(sla&&lead>sla)out.push({level:'BAD',type:'SLA RISK',stage:x.stage,copy:`Lead ${lead}m > SLA ${sla}m`,key:k});if(wait>cycle&&wait>=15)out.push({level:'WARN',type:'WAIT DOMINATES',stage:x.stage,copy:`Wait ${wait}m가 Cycle ${cycle}m보다 큽니다.`,key:k});if(!String(v.customerKpi||'').trim())out.push({level:'INFO',type:'CUSTOMER KPI GAP',stage:x.stage,copy:'이 단계의 고객 결과 지표가 아직 없습니다.',key:k});const due=linkedDue(link);if(due){const diff=due.getTime()-now;if(diff<0)out.push({level:'BAD',type:'OVERDUE',stage:x.stage,copy:`연결된 일정이 ${Math.ceil(Math.abs(diff)/86400000)}일 지났습니다.`,key:k});else if(diff<=172800000)out.push({level:'WARN',type:'DUE SOON',stage:x.stage,copy:'연결된 Milestone/Calendar가 48시간 안에 도래합니다.',key:k})}});return out}
 function ensureFlowTime(){const page=q('[data-page="WORK_FLOW_MAP"]');if(!page)return null;let root=q('[data-r31-flow-time]',page);if(!root){root=document.createElement('section');root.className='r31-card';root.dataset.r31FlowTime='';const anchor=q('[data-r30-flow-risks]',page)?.closest('.r30-card')?.parentElement||q('[data-r30-link-form]',page)?.closest('.r30-card');anchor?.insertAdjacentElement('afterend',root)}return root}
 function renderFlowTime(){const root=ensureFlowTime();if(!root)return;const f=flow(),ms=metricStore(),signals=timeSignals(),totalCycle=f.reduce((s,x,i)=>s+duration(ms[stepKey(i,x)]?.cycleMin),0),totalWait=f.reduce((s,x,i)=>s+duration(ms[stepKey(i,x)]?.waitMin),0),lead=totalCycle+totalWait,kpiCount=f.filter((x,i)=>String(ms[stepKey(i,x)]?.customerKpi||'').trim()).length;root.innerHTML=`<div class="r31-head"><div><div class="r31-kicker">FLOW TIME / SLA · RECOVERY 31</div><h2>어디에서 실제 시간이 소모되고 고객 가치가 기다리는가?</h2><p>Cycle Time은 실제 작업 시간, Wait Time은 대기/승인/큐 시간입니다. 사람 속도가 아니라 Flow 구조를 개선합니다.</p></div><span class="r31-badge ${signals.some(s=>s.level==='BAD')?'bad':signals.length?'warn':'good'}">${signals.length} TIME SIGNALS</span></div><div class="r31-stats"><div class="r31-stat"><span>TOTAL LEAD</span><strong>${lead}m</strong></div><div class="r31-stat"><span>WAIT RATIO</span><strong>${lead?Math.round(totalWait/lead*100):0}%</strong></div><div class="r31-stat"><span>SLA RISKS</span><strong>${signals.filter(s=>s.type==='SLA RISK').length}</strong></div><div class="r31-stat"><span>CUSTOMER KPI</span><strong>${kpiCount}/${f.length}</strong></div></div><div class="r31-flow-shell"><div class="r31-flow-list">${f.map((x,i)=>{const k=stepKey(i,x),v=ms[k]||{},sg=signals.filter(s=>s.key===k);return `<article class="r31-flow-row"><div class="r31-flow-no">${String(i+1).padStart(2,'0')}</div><div class="r31-flow-copy"><b>${esc(x.stage||'Untitled')}</b><small>${esc(x.layer||'')} · ${esc(v.customerKpi||'Customer KPI UNKNOWN')}</small><div class="r31-mini-bars"><span class="r31-mini">Cycle ${duration(v.cycleMin)}m</span><span class="r31-mini">Wait ${duration(v.waitMin)}m</span><span class="r31-mini">SLA ${duration(v.slaMin)||'—'}m</span>${sg.map(s=>`<span class="r31-mini">${esc(s.type)}</span>`).join('')}</div></div><button type="button" data-r31-metric-edit="${i}">측정</button></article>`}).join('')}</div><form class="r31-flow-form" data-r31-metric-form><input type="hidden" data-r31-metric-index value="0"><div class="r31-form-grid"><label>Workflow Step<select data-r31-metric-step>${f.map((x,i)=>`<option value="${i}">${String(i+1).padStart(2,'0')} · ${esc(x.stage)}</option>`).join('')}</select></label><label>Customer KPI<input data-r31-kpi placeholder="예: 주문 정확도 / NPS / 승인 리드타임"></label><label>Cycle Time (min)<input type="number" min="0" data-r31-cycle></label><label>Wait Time (min)<input type="number" min="0" data-r31-wait></label><label>SLA / Target (min)<input type="number" min="0" data-r31-sla></label><label>KPI Target<input data-r31-kpi-target placeholder="예: ≥98% / ≤1 day"></label><label class="wide">Evidence / Measurement Note<textarea rows="2" data-r31-evidence placeholder="어떤 로그/고객 데이터/관찰로 측정했는가?"></textarea></label></div><div class="r31-actions"><button type="submit" class="primary">Flow Metric 저장</button></div></form></div><div class="r31-signal-list" style="margin-top:10px">${signals.slice(0,8).map(s=>`<div class="r31-signal"><span class="r31-badge ${s.level==='BAD'?'bad':s.level==='WARN'?'warn':'info'}">${esc(s.type)}</span><div><b>${esc(s.stage)}</b><span>${esc(s.copy)}</span></div><code>${esc(s.key)}</code></div>`).join('')||'<div class="r31-note">현재 입력된 시간/SLA 기준에서 즉시 확인할 병목 신호가 없습니다.</div>'}</div>`;
 const step=q('[data-r31-metric-step]',root),form=q('[data-r31-metric-form]',root);function loadForm(i){const x=f[i]||{},v=metricStore()[stepKey(i,x)]||{};step.value=String(i);q('[data-r31-metric-index]',root).value=String(i);q('[data-r31-cycle]',root).value=v.cycleMin??'';q('[data-r31-wait]',root).value=v.waitMin??'';q('[data-r31-sla]',root).value=v.slaMin??'';q('[data-r31-kpi]',root).value=v.customerKpi??'';q('[data-r31-kpi-target]',root).value=v.kpiTarget??'';q('[data-r31-evidence]',root).value=v.evidence??''}step.onchange=()=>loadForm(+step.value);qa('[data-r31-metric-edit]',root).forEach(b=>b.onclick=()=>{loadForm(+b.dataset.r31MetricEdit);form.scrollIntoView({behavior:'smooth',block:'nearest'})});form.onsubmit=e=>{e.preventDefault();const i=+step.value,x=f[i];if(!x)return;const all=metricStore(),k=stepKey(i,x);all[k]={cycleMin:duration(q('[data-r31-cycle]',root).value),waitMin:duration(q('[data-r31-wait]',root).value),slaMin:duration(q('[data-r31-sla]',root).value),customerKpi:q('[data-r31-kpi]',root).value.trim(),kpiTarget:q('[data-r31-kpi-target]',root).value.trim(),evidence:q('[data-r31-evidence]',root).value.trim(),updatedAt:new Date().toISOString()};save(METRIC_KEY,all);renderAll()};loadForm(0)}
 function runtimeAttention(){const signals=timeSignals();for(const pageId of ['TODAY','REVIEW','REPORTS']){const page=q(`[data-page="${pageId}"]`);if(!page)continue;let el=q(`[data-r31-runtime="${pageId}"]`,page);if(el)el.remove();el=document.createElement('section');el.className=pageId==='TODAY'?'r31-card r31-runtime':'r31-runtime';el.dataset.r31Runtime=pageId;const top=signals.slice(0,pageId==='TODAY'?4:6);el.innerHTML=`<div class="r31-kicker">FLOW TIME RUNTIME · ${pageId}</div><h2>${pageId==='TODAY'?'고객 가치 흐름의 시간 Attention':pageId==='REVIEW'?'이번 주 Flow Review 후보':'Operating Flow Summary'}</h2><p>${top.length?top.map(s=>`${s.type} · ${s.stage}`).join(' / '):'현재 즉시 확인할 시간 기반 Flow Signal이 없습니다.'}</p>${pageId==='TODAY'?'<div class="r31-actions"><button type="button" data-r31-open-flow>Work Flow Map</button></div>':''}`;const sub=q(':scope > .sub',page);sub?.insertAdjacentElement('afterend',el);q('[data-r31-open-flow]',el)?.addEventListener('click',()=>window.LeaderOsR30?.showCustomPage?.('WORK_FLOW_MAP'))}}
 function managerBrief(){const mb=q('[data-manager-brief]');if(!mb)return;let el=q('[data-r31-manager-flow]');if(el)el.remove();const s=timeSignals().slice(0,3);el=document.createElement('div');el.className='r31-runtime';el.dataset.r31ManagerFlow='';el.innerHTML=`<div class="r31-kicker">FLOW TIME CONTEXT</div><b>${s.length?`${s.length}개 시간 기반 운영 신호`:'Flow Time 정상'}</b><p>${s.map(x=>`${esc(x.type)} · ${esc(x.stage)}`).join('<br>')||'즉시 Escalation할 시간 기반 Signal 없음'}</p>`;mb.insertAdjacentElement('afterend',el)}
 function experimentHandoff(){const page=q('[data-page="REVIEW"]');if(!page)return;let root=q('[data-r31-exp-handoff]',page);if(!root){root=document.createElement('section');root.className='r31-card';root.dataset.r31ExpHandoff='';page.append(root)}const ex=load(EXP_KEY,[]).filter(x=>['REVIEW','DONE'].includes(x.status)),hs=load(HANDOFF_KEY,[]);root.innerHTML=`<div class="r31-head"><div><div class="r31-kicker">PROCESS EXPERIMENT → WEEKLY REVIEW</div><h2>실험 결과를 다음 Priority 후보로 연결</h2><p>실험의 결과가 자동으로 우선순위가 되지는 않습니다. Review 후보를 만들고 사람이 Confirm합니다.</p></div><span class="r31-badge info">${ex.length} CANDIDATES</span></div><div class="r31-candidates">${ex.slice(-6).reverse().map(x=>{const done=hs.some(h=>h.experimentId===x.id);return `<div class="r31-candidate"><div><b>${esc(x.hypothesis||x.id)}</b><span>${esc(x.change||'')}<br>Metric · ${esc(x.metric||'—')} · Evidence · ${esc(x.evidence||'—')}</span></div><button type="button" ${done?'disabled':''} data-r31-handoff="${esc(x.id)}">${done?'후보 생성됨':'Priority 후보'}</button></div>`}).join('')||'<div class="r31-note">REVIEW 또는 DONE 상태의 Process Experiment가 아직 없습니다.</div>'}</div>`;qa('[data-r31-handoff]',root).forEach(b=>b.onclick=()=>{const x=ex.find(v=>v.id===b.dataset.r31Handoff);if(!x)return;const list=load(HANDOFF_KEY,[]);if(!list.some(h=>h.experimentId===x.id))list.push({id:`PH-${Date.now().toString(36)}`,experimentId:x.id,title:x.hypothesis||'Process Experiment',reason:x.evidence||x.change||'',status:'DRAFT',createdAt:new Date().toISOString()});save(HANDOFF_KEY,list.slice(-30));renderAll()})}
 function onboarding(){const page=q('[data-page="LEADER_ONBOARDING"]');if(!page)return;let root=q('[data-r31-onboarding]',page);if(!root){root=document.createElement('section');root.className='r31-card';root.dataset.r31Onboarding='';page.append(root)}const state=load(ONBOARD_KEY,{}),items=[['CUSTOMER','고객 Trigger 인터뷰','고객이 이 Flow를 시작하는 실제 이유/요청을 확인합니다.'],['FRONT','Frontstage Shadowing','고객과 직접 맞닿는 장면을 관찰합니다.'],['BACK','Backstage Shadowing','보이지 않는 준비·검수·재작업을 봅니다.'],['HANDOFF','Handoff 따라가기','Output이 다음 Owner에게 어떤 형태로 넘어가는지 확인합니다.'],['DECISION','Decision 관찰','어디서 누가 결정을 기다리고 있는지 기록합니다.'],['SSOT','SSOT 확인','같은 질문에 팀마다 다른 답이 나오는지 확인합니다.'],['TIME','Cycle / Wait 측정','작업시간과 기다리는 시간을 분리해 봅니다.'],['CUSTOMER_KPI','고객 결과 확인','내부 완료가 실제 고객 결과로 이어졌는지 Evidence를 봅니다.']];root.innerHTML=`<div class="r31-head"><div><div class="r31-kicker">NEW LEADER · WORKFLOW INTERVIEW / SHADOWING</div><h2>Day 3–7에는 바꾸지 말고 실제 일을 따라갑니다</h2><p>회의에서 설명을 듣는 것만으로 Flow를 확정하지 않습니다. 실제 고객 접점, Handoff, 대기, Decision, SSOT를 Shadowing하고 Evidence로 확인합니다.</p></div><span class="r31-badge ${items.every(x=>state[x[0]])?'good':'info'}">${items.filter(x=>state[x[0]]).length}/${items.length}</span></div><div class="r31-checklist">${items.map(x=>`<label class="r31-check"><input type="checkbox" data-r31-onboard="${x[0]}" ${state[x[0]]?'checked':''}><span><b>${x[1]}</b><span>${x[2]}</span></span></label>`).join('')}</div><div class="r31-note">권장 질문: “이 단계가 시작되는 실제 Trigger는?”, “누구에게 무엇을 넘길 때 가장 많이 기다리나요?”, “이 단계의 완료를 고객 관점에서 무엇으로 확인하나요?”</div>`;qa('[data-r31-onboard]',root).forEach(i=>i.onchange=()=>{const s=load(ONBOARD_KEY,{});s[i.dataset.r31Onboard]=i.checked;save(ONBOARD_KEY,s);renderAll()})}
 function renderAll(){renderDirectory();renderOwners();renderFlowTime();runtimeAttention();managerBrief();experimentHandoff();onboarding()}
 document.addEventListener('click',e=>{if(e.target?.matches?.('[data-r29-flow-save],[data-r29-load-sample],[data-r30-owner-save],[data-r30-link-clear]'))setTimeout(renderAll,100)});document.addEventListener('submit',e=>{if(e.target?.matches?.('[data-r29-flow-form],[data-r30-link-form],[data-r30-exp-form]'))setTimeout(renderAll,100)});
 window.addEventListener('storage',e=>{if([DIR_KEY,OWNER_KEY,METRIC_KEY,HANDOFF_KEY,ONBOARD_KEY,FLOW_KEY,LINK_KEY,EXP_KEY,...ART_KEYS].includes(e.key))renderAll()});
 window.addEventListener('leaderos:artifacts-changed',()=>renderAll());
 setTimeout(renderAll,140);window.LeaderOsR31={render:renderAll,timeSignals,teamDirectory,ownerStore,metricStore};
})();
</script>
<script id="recovery-32-flow-trend-bottleneck">
(function(){
 const SNAP_KEY='leader-os:r32:flow-snapshots:v1', KPI_KEY='leader-os:r32:customer-kpi:v1', COST_KEY='leader-os:r32:bottleneck-cost:v1', PROP_KEY='leader-os:r32:workflow-proposals:v1', VERSION_KEY='leader-os:r32:workflow-versions:v1';
 const FLOW_KEY='leader-os:r29:workflow', METRIC_KEY='leader-os:r31:workflow-metrics:v1';
 const storage=window.__leaderOsStorage||localStorage, q=(s,r=document)=>r.querySelector(s), qa=(s,r=document)=>[...r.querySelectorAll(s)];
 const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const load=(k,f)=>{try{const v=storage.getItem(k)||localStorage.getItem(k);return v?JSON.parse(v):f}catch{return f}},save=(k,v)=>{try{storage.setItem(k,JSON.stringify(v))}catch{};try{localStorage.setItem(k,JSON.stringify(v))}catch{}};
 const demoFlow=[{stage:'Enter',layer:'Customer'},{stage:'Choose',layer:'Frontstage'},{stage:'Customize',layer:'Decision'},{stage:'Make',layer:'Backstage'},{stage:'Handoff',layer:'Handoff'},{stage:'Stay / Leave',layer:'Customer'},{stage:'Return',layer:'Data / SSOT'}];
 const flow=()=>{const v=load(FLOW_KEY,[]);return Array.isArray(v)&&v.length?v:demoFlow};
 const stepKey=(i,x)=>`STEP:${i}:${String(x?.stage||'UNTITLED').replace(/[^A-Za-z0-9가-힣]+/g,'_').slice(0,32)}`;
 const metrics=()=>{const v=load(METRIC_KEY,{});return v&&typeof v==='object'&&!Array.isArray(v)?v:{}};
 const num=v=>Number.isFinite(Number(v))?Number(v):0, money=v=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(num(v));
 function isoWeek(d=new Date()){const x=new Date(Date.UTC(d.getFullYear(),d.getMonth(),d.getDate()));const day=x.getUTCDay()||7;x.setUTCDate(x.getUTCDate()+4-day);const y=new Date(Date.UTC(x.getUTCFullYear(),0,1));const w=Math.ceil((((x-y)/86400000)+1)/7);return `${x.getUTCFullYear()}-W${String(w).padStart(2,'0')}`}
 function summary(){const f=flow(),m=metrics();let cycle=0,wait=0,slaRisks=0;f.forEach((x,i)=>{const v=m[stepKey(i,x)]||{},c=num(v.cycleMin),w=num(v.waitMin),sla=num(v.slaMin);cycle+=c;wait+=w;if(sla>0&&c+w>sla)slaRisks++});const lead=cycle+wait;return {cycle,wait,lead,waitRatio:lead?Math.round(wait/lead*100):0,slaRisks}}
 function costStore(){const v=load(COST_KEY,{});return v&&typeof v==='object'&&!Array.isArray(v)?v:{}}
 function kpiStore(){const v=load(KPI_KEY,{});return v&&typeof v==='object'&&!Array.isArray(v)?v:{}}
 function costRows(){const f=flow(),m=metrics(),c=costStore();return f.map((x,i)=>{const k=stepKey(i,x),v=c[k]||{},wait=num(m[k]?.waitMin),volume=num(v.volume),waitRate=num(v.waitCostPerMin),reworkRate=num(v.reworkRate),reworkCost=num(v.reworkCost);const waitCost=wait*volume*waitRate,rework=volume*(reworkRate/100)*reworkCost,total=waitCost+rework;return {key:k,stage:x.stage||`Step ${i+1}`,wait,volume,waitRate,reworkRate,reworkCost,waitCost,rework,total,note:v.note||''}})}
 function costTotal(){return costRows().reduce((s,x)=>s+x.total,0)}
 function kpiStatus(row){if(!row||row.actual===''||row.actual==null||row.target===''||row.target==null)return 'UNKNOWN';const a=Number(row.actual),t=Number(row.target);if(!Number.isFinite(a)||!Number.isFinite(t))return 'RECORDED';if(row.direction==='LOWER_BETTER')return a<=t?'ON_TARGET':'GAP';return a>=t?'ON_TARGET':'GAP'}
 function snapshot(){const s=summary(),c=costTotal(),kpis=kpiStore(),coverage=flow().filter((x,i)=>{const k=stepKey(i,x),r=kpis[k];return r&&r.actual!==''&&r.actual!=null}).length;return {id:`SNAP-${Date.now().toString(36)}`,week:isoWeek(),at:new Date().toISOString(),...s,bottleneckCost:c,kpiCoverage:coverage,steps:flow().map((x,i)=>{const k=stepKey(i,x);return {key:k,stage:x.stage,metric:metrics()[k]||{},kpi:kpis[k]||{},cost:costStore()[k]||{}}})}}
 function snapshots(){const v=load(SNAP_KEY,[]);return Array.isArray(v)?v:[]}
 function delta(cur,prev,key){if(!prev)return {value:null,cls:'flat',label:'—'};const d=num(cur[key])-num(prev[key]),cls=d>0?'up':d<0?'down':'flat';return {value:d,cls,label:`${d>0?'+':''}${Math.round(d)}`}}
 function ensureRoot(){const page=q('[data-page="WORK_FLOW_MAP"]');if(!page)return null;let root=q('[data-r32-root]',page);if(!root){root=document.createElement('div');root.className='r32-shell';root.dataset.r32Root='';const anchor=q('[data-r31-flow-time]',page)||q('[data-r30-flow-risks]',page)?.closest('.r30-card');anchor?.insertAdjacentElement('afterend',root)}return root}
 function renderTrend(){const root=ensureRoot();if(!root)return;let card=q('[data-r32-trend]',root);if(!card){card=document.createElement('section');card.className='r32-card';card.dataset.r32Trend='';root.append(card)}const ss=snapshots(),latest=ss.at(-1),prev=ss.at(-2),s=summary(),maxLead=Math.max(1,...ss.slice(-8).map(x=>num(x.lead)),s.lead),dLead=latest&&prev?delta(latest,prev,'lead'):null,dWait=latest&&prev?delta(latest,prev,'waitRatio'):null;card.innerHTML=`<div class="r32-head"><div><div class="r32-kicker">WEEKLY FLOW TREND · RECOVERY 32</div><h2>한 번의 측정이 아니라 주차별로 흐름이 좋아지는지 봅니다</h2><p>Snapshot은 해당 시점의 Cycle / Wait / SLA / Customer KPI / Bottleneck Cost를 저장합니다. 사람이 느리다는 판단보다 Flow 변화가 먼저입니다.</p></div><span class="r32-badge ${ss.length>=2?'good':'info'}">${ss.length} SNAPSHOTS</span></div><div class="r32-stats"><div class="r32-stat"><span>CURRENT LEAD</span><strong>${s.lead}m</strong></div><div class="r32-stat"><span>WAIT RATIO</span><strong>${s.waitRatio}%</strong></div><div class="r32-stat"><span>SLA RISKS</span><strong>${s.slaRisks}</strong></div><div class="r32-stat"><span>BOTTLENECK COST</span><strong>${money(costTotal())}</strong></div><div class="r32-stat"><span>WEEK</span><strong>${isoWeek()}</strong></div></div>${dLead?`<div class="r32-note">전 Snapshot 대비 Lead Time <b class="r32-delta ${dLead.cls}">${dLead.label}m</b> · Wait Ratio <b class="r32-delta ${dWait.cls}">${dWait.label}%p</b>. 감소는 개선 신호일 수 있지만 Customer KPI와 함께 확인합니다.</div>`:''}<div class="r32-trend-list" style="margin-top:10px">${ss.slice(-8).reverse().map(x=>`<div class="r32-trend-row"><div><b>${esc(x.week)}</b><small>${new Date(x.at).toLocaleDateString()}</small></div><div class="r32-bar"><span style="width:${Math.min(100,Math.round(num(x.lead)/maxLead*100))}%"></span></div><div class="r32-trend-num">Lead ${num(x.lead)}m</div><div class="r32-trend-num">Wait ${num(x.waitRatio)}%</div><div class="r32-trend-num">SLA ${num(x.slaRisks)}</div><div class="r32-trend-num">${money(x.bottleneckCost)}</div></div>`).join('')||'<div class="r32-note">아직 Snapshot이 없습니다. 현재 Flow를 기준점으로 저장하면 다음 주부터 비교할 수 있습니다.</div>'}</div><div class="r32-actions"><button type="button" class="primary" data-r32-save-snapshot>현재 주 Snapshot 저장</button></div>`;q('[data-r32-save-snapshot]',card).onclick=()=>{const all=snapshots(),sn=snapshot(),idx=all.findIndex(x=>x.week===sn.week);if(idx>=0)all[idx]=sn;else all.push(sn);save(SNAP_KEY,all.slice(-24));renderAll()}}
 function renderCostKpi(){const root=ensureRoot();if(!root)return;let wrap=q('[data-r32-cost-kpi]',root);if(!wrap){wrap=document.createElement('div');wrap.className='r32-grid';wrap.dataset.r32CostKpi='';root.append(wrap)}const f=flow(),cs=costStore(),ks=kpiStore(),rows=costRows(),top=[...rows].sort((a,b)=>b.total-a.total).slice(0,6);wrap.innerHTML=`<section class="r32-card"><div class="r32-head"><div><div class="r32-kicker">BOTTLENECK COST</div><h2>Wait Time × Rework × Business Impact</h2><p>방향성 있는 운영 추정치입니다. 회계 원가가 아니라 어떤 병목을 먼저 실험할지 비교하기 위한 값입니다.</p></div><span class="r32-badge ${costTotal()>0?'warn':'info'}">${money(costTotal())} / WEEK</span></div><div class="r32-cost-list">${top.map(x=>`<div class="r32-cost-row"><div><b>${esc(x.stage)}</b><span>Wait ${x.wait}m × Volume ${x.volume} × ${money(x.waitRate)}/min<br>Rework ${x.reworkRate}% × ${money(x.reworkCost)} · ${esc(x.note||'Business impact note 없음')}</span></div><div class="r32-cost-value">${money(x.total)}</div></div>`).join('')||'<div class="r32-note">비용 가정을 입력하면 병목별 영향 비교가 나타납니다.</div>'}</div><form class="r32-form" data-r32-cost-form style="margin-top:10px"><div class="r32-form-grid"><label>Workflow Step<select data-r32-cost-step>${f.map((x,i)=>`<option value="${i}">${String(i+1).padStart(2,'0')} · ${esc(x.stage)}</option>`).join('')}</select></label><label>Volume / week<input type="number" min="0" data-r32-volume></label><label>Wait cost / min ($)<input type="number" min="0" step="0.01" data-r32-wait-rate></label><label>Rework rate (%)<input type="number" min="0" max="100" step="0.1" data-r32-rework-rate></label><label>Rework cost / item ($)<input type="number" min="0" step="0.01" data-r32-rework-cost></label><label class="wide">Business impact note<input data-r32-cost-note placeholder="예: 승인 지연으로 캠페인 하루 늦어짐"></label></div><div class="r32-actions"><button type="submit">비용 가정 저장</button></div></form></section><section class="r32-card"><div class="r32-head"><div><div class="r32-kicker">CUSTOMER KPI VALUE</div><h2>내부 완료를 실제 고객 결과와 연결</h2><p>CRM / Analytics / Support / Manual 등 Source를 기록합니다. Preview에서는 값을 수동 입력하고 Backend에서는 Connector contract로 교체합니다.</p></div><span class="r32-badge ${Object.values(ks).filter(x=>x.actual!==''&&x.actual!=null).length?'good':'info'}">${Object.values(ks).filter(x=>x.actual!==''&&x.actual!=null).length} VALUES</span></div><div class="r32-kpi-list">${f.map((x,i)=>{const k=stepKey(i,x),v=ks[k]||{},st=kpiStatus(v);return `<div class="r32-kpi-row"><div><b>${esc(x.stage)}</b><span>${esc(v.name||metrics()[k]?.customerKpi||'Customer KPI UNKNOWN')} · Actual ${esc(v.actual??'—')}${esc(v.unit||'')} / Target ${esc(v.target??metrics()[k]?.kpiTarget??'—')}${esc(v.unit||'')}<br>${esc(v.source||'Source UNKNOWN')} · ${esc(v.sourceRef||'')}</span></div><span class="r32-badge ${st==='ON_TARGET'?'good':st==='GAP'?'bad':'info'}">${st}</span></div>`}).join('')}</div><form class="r32-form" data-r32-kpi-form style="margin-top:10px"><div class="r32-form-grid"><label>Workflow Step<select data-r32-kpi-step>${f.map((x,i)=>`<option value="${i}">${String(i+1).padStart(2,'0')} · ${esc(x.stage)}</option>`).join('')}</select></label><label>KPI name<input data-r32-kpi-name placeholder="예: Order Accuracy"></label><label>Actual value<input data-r32-kpi-actual placeholder="98.2"></label><label>Target value<input data-r32-kpi-target placeholder="99"></label><label>Unit<input data-r32-kpi-unit placeholder="% / min / score"></label><label>Direction<select data-r32-kpi-direction><option value="HIGHER_BETTER">Higher is better</option><option value="LOWER_BETTER">Lower is better</option></select></label><label>Source<select data-r32-kpi-source><option>Manual</option><option>CRM</option><option>Analytics</option><option>Support</option><option>Sales</option><option>Other</option></select></label><label>Source ID / URL<input data-r32-kpi-source-ref placeholder="dataset / report / dashboard id"></label><label class="wide">Evidence note<textarea rows="2" data-r32-kpi-note></textarea></label></div><div class="r32-actions"><button type="submit">Customer KPI 저장</button></div></form></section>`;
 const costStep=q('[data-r32-cost-step]',wrap),costForm=q('[data-r32-cost-form]',wrap);function loadCost(){const i=+costStep.value,k=stepKey(i,f[i]),v=costStore()[k]||{};q('[data-r32-volume]',wrap).value=v.volume??'';q('[data-r32-wait-rate]',wrap).value=v.waitCostPerMin??'';q('[data-r32-rework-rate]',wrap).value=v.reworkRate??'';q('[data-r32-rework-cost]',wrap).value=v.reworkCost??'';q('[data-r32-cost-note]',wrap).value=v.note??''}costStep.onchange=loadCost;costForm.onsubmit=e=>{e.preventDefault();const i=+costStep.value,k=stepKey(i,f[i]),all=costStore();all[k]={volume:num(q('[data-r32-volume]',wrap).value),waitCostPerMin:num(q('[data-r32-wait-rate]',wrap).value),reworkRate:num(q('[data-r32-rework-rate]',wrap).value),reworkCost:num(q('[data-r32-rework-cost]',wrap).value),note:q('[data-r32-cost-note]',wrap).value.trim(),updatedAt:new Date().toISOString()};save(COST_KEY,all);renderAll()};loadCost();
 const kpiStep=q('[data-r32-kpi-step]',wrap),kpiForm=q('[data-r32-kpi-form]',wrap);function loadKpi(){const i=+kpiStep.value,k=stepKey(i,f[i]),v=kpiStore()[k]||{};q('[data-r32-kpi-name]',wrap).value=v.name??metrics()[k]?.customerKpi??'';q('[data-r32-kpi-actual]',wrap).value=v.actual??'';q('[data-r32-kpi-target]',wrap).value=v.target??'';q('[data-r32-kpi-unit]',wrap).value=v.unit??'';q('[data-r32-kpi-direction]',wrap).value=v.direction||'HIGHER_BETTER';q('[data-r32-kpi-source]',wrap).value=v.source||'Manual';q('[data-r32-kpi-source-ref]',wrap).value=v.sourceRef??'';q('[data-r32-kpi-note]',wrap).value=v.note??''}kpiStep.onchange=loadKpi;kpiForm.onsubmit=e=>{e.preventDefault();const i=+kpiStep.value,k=stepKey(i,f[i]),all=kpiStore();all[k]={name:q('[data-r32-kpi-name]',wrap).value.trim(),actual:q('[data-r32-kpi-actual]',wrap).value.trim(),target:q('[data-r32-kpi-target]',wrap).value.trim(),unit:q('[data-r32-kpi-unit]',wrap).value.trim(),direction:q('[data-r32-kpi-direction]',wrap).value,source:q('[data-r32-kpi-source]',wrap).value,sourceRef:q('[data-r32-kpi-source-ref]',wrap).value.trim(),note:q('[data-r32-kpi-note]',wrap).value.trim(),updatedAt:new Date().toISOString()};save(KPI_KEY,all);renderAll()};loadKpi()}
 function versions(){const v=load(VERSION_KEY,[]);return Array.isArray(v)?v:[]};function proposals(){const v=load(PROP_KEY,[]);return Array.isArray(v)?v:[]}
 function currentVersion(){return versions().at(-1)?.version||0}
 function renderGovernance(){const root=ensureRoot();if(!root)return;let wrap=q('[data-r32-governance]',root);if(!wrap){wrap=document.createElement('div');wrap.className='r32-grid';wrap.dataset.r32Governance='';root.append(wrap)}const ps=proposals(),vs=versions(),cv=currentVersion(),f=flow();wrap.innerHTML=`<section class="r32-card"><div class="r32-head"><div><div class="r32-kicker">WORKFLOW CHANGE PROPOSAL</div><h2>바꾸기 전에 제안하고, 확인한 뒤 새 AS-IS Version으로 승격</h2><p>현재 Flow를 직접 수정한 뒤 Proposal을 만들 수 있습니다. Human Confirm 시 현재 Flow가 새로운 AS-IS Version으로 Snapshot됩니다.</p></div><span class="r32-badge info">AS-IS v${cv||'0'}</span></div><form class="r32-form" data-r32-proposal-form><div class="r32-form-grid"><label>Proposal title<input data-r32-prop-title required placeholder="예: 승인 2단계를 1단계로 축소"></label><label>Affected step<select data-r32-prop-step><option value="ALL">ALL FLOW</option>${f.map((x,i)=>`<option value="${stepKey(i,x)}">${String(i+1).padStart(2,'0')} · ${esc(x.stage)}</option>`).join('')}</select></label><label class="wide">Why / Evidence<textarea rows="2" data-r32-prop-reason required></textarea></label><label class="wide">Expected outcome / metric<textarea rows="2" data-r32-prop-expected></textarea></label></div><div class="r32-actions"><button type="submit">DRAFT Proposal 만들기</button></div></form><div class="r32-proposal-list" style="margin-top:10px">${ps.slice(-8).reverse().map(p=>`<div class="r32-proposal"><div><b>${esc(p.title)}</b><span>Based on AS-IS v${p.basedOnVersion} · ${esc(p.affectedStep)} · ${esc(p.reason)}<br>Expected · ${esc(p.expected||'—')} · ${p.status}${p.appliedVersion?` → v${p.appliedVersion}`:''}</span></div><div class="r32-actions" style="margin:0"><button type="button" ${p.status!=='DRAFT'?'disabled':''} data-r32-review="${esc(p.id)}">Team Review</button><button type="button" class="${p.status==='REVIEWED'?'primary':''}" ${p.status!=='REVIEWED'?'disabled':''} data-r32-confirm="${esc(p.id)}">Human Confirm</button></div></div>`).join('')||'<div class="r32-note">아직 Change Proposal이 없습니다.</div>'}</div></section><section class="r32-card"><div class="r32-head"><div><div class="r32-kicker">AS-IS VERSION HISTORY</div><h2>업무 방식도 문서처럼 버전을 남깁니다</h2><p>누가 옳았는지를 기록하는 것이 아니라, 어떤 Flow를 언제 운영 기준으로 확정했는지 추적합니다.</p></div><span class="r32-badge ${vs.length?'good':'info'}">${vs.length} VERSIONS</span></div><div class="r32-version-list">${vs.slice(-8).reverse().map(v=>`<div class="r32-version"><div><b>AS-IS v${v.version}</b><span>${new Date(v.confirmedAt).toLocaleString()} · ${v.flow.length} steps<br>${esc(v.proposalTitle||'Initial workflow')}</span></div><span class="r32-badge good">CONFIRMED</span></div>`).join('')||'<div class="r32-note">첫 Change Proposal을 Human Confirm하면 AS-IS v1이 생성됩니다.</div>'}</div></section>`;
 q('[data-r32-proposal-form]',wrap).onsubmit=e=>{e.preventDefault();const list=proposals();list.push({id:`WCP-${Date.now().toString(36)}`,title:q('[data-r32-prop-title]',wrap).value.trim(),affectedStep:q('[data-r32-prop-step]',wrap).value,reason:q('[data-r32-prop-reason]',wrap).value.trim(),expected:q('[data-r32-prop-expected]',wrap).value.trim(),basedOnVersion:currentVersion(),status:'DRAFT',createdAt:new Date().toISOString()});save(PROP_KEY,list.slice(-30));renderAll()};qa('[data-r32-review]',wrap).forEach(b=>b.onclick=()=>{const list=proposals(),p=list.find(x=>x.id===b.dataset.r32Review);if(!p)return;p.status='REVIEWED';p.reviewedAt=new Date().toISOString();save(PROP_KEY,list);renderAll()});qa('[data-r32-confirm]',wrap).forEach(b=>b.onclick=()=>{const list=proposals(),p=list.find(x=>x.id===b.dataset.r32Confirm);if(!p)return;if(p.basedOnVersion!==currentVersion()){alert(`VERSION CONFLICT · Proposal은 v${p.basedOnVersion} 기준이고 현재 AS-IS는 v${currentVersion()}입니다. 다시 검토하세요.`);return}const vlist=versions(),newVersion=currentVersion()+1;vlist.push({id:`WFV-${Date.now().toString(36)}`,version:newVersion,flow:JSON.parse(JSON.stringify(flow())),metrics:JSON.parse(JSON.stringify(metrics())),customerKpi:JSON.parse(JSON.stringify(kpiStore())),proposalId:p.id,proposalTitle:p.title,confirmedAt:new Date().toISOString(),status:'CONFIRMED'});p.status='APPLIED';p.appliedVersion=newVersion;p.confirmedAt=new Date().toISOString();save(VERSION_KEY,vlist.slice(-20));save(PROP_KEY,list);renderAll()})}
 function runtimeSignals(){const s=summary(),cost=costRows().filter(x=>x.total>0).sort((a,b)=>b.total-a.total),kpis=Object.entries(kpiStore()).map(([key,v])=>({key,...v,status:kpiStatus(v)})).filter(x=>x.status==='GAP'),times=window.LeaderOsR31?.timeSignals?.()||[],out=[];times.slice(0,3).forEach(x=>out.push({type:x.type,copy:`${x.stage} · ${x.copy||''}`,level:x.level==='BAD'?'bad':'warn'}));cost.slice(0,2).forEach(x=>out.push({type:'BOTTLENECK COST',copy:`${x.stage} · ${money(x.total)}/week`,level:'warn'}));kpis.slice(0,2).forEach(x=>out.push({type:'CUSTOMER KPI GAP',copy:`${x.name||x.key} · ${x.actual}${x.unit||''} / ${x.target}${x.unit||''}`,level:'bad'}));if(s.waitRatio>=60)out.push({type:'WAIT RATIO',copy:`전체 Lead Time의 ${s.waitRatio}%가 대기`,level:'warn'});return out.slice(0,6)}
 function renderRuntime(){for(const pageId of ['TODAY','REVIEW','REPORTS']){const page=q(`[data-page="${pageId}"]`);if(!page)continue;let el=q(`[data-r32-runtime="${pageId}"]`,page);if(el)el.remove();el=document.createElement('section');el.className=pageId==='TODAY'?'r32-card r32-runtime':'r32-runtime';el.dataset.r32Runtime=pageId;const sig=runtimeSignals(),ss=snapshots(),cur=ss.at(-1),prev=ss.at(-2);el.innerHTML=`<div class="r32-kicker">FLOW OPERATING REVIEW · RECOVERY 32</div><h2>${pageId==='TODAY'?'오늘 확인할 Flow Signal':pageId==='REVIEW'?'주간 Flow 추세와 개선 후보':'Flow Trend / Customer Impact'}</h2><p>${cur&&prev?`최근 Snapshot ${cur.week}: Lead ${cur.lead}m / Wait ${cur.waitRatio}% / Cost ${money(cur.bottleneckCost)}. 이전 주 대비 Lead ${delta(cur,prev,'lead').label}m.`:'Snapshot을 2주 이상 쌓으면 전주 대비 변화가 나타납니다.'}</p><div class="r32-runtime-list">${sig.slice(0,pageId==='TODAY'?4:6).map(x=>`<div class="r32-runtime-item"><span class="r32-badge ${x.level}">${esc(x.type)}</span><span>${esc(x.copy)}</span></div>`).join('')||'<div class="r32-note">현재 즉시 확인할 Flow Signal이 없습니다.</div>'}</div>${pageId==='TODAY'?'<div class="r32-actions"><button type="button" data-r32-open-flow>Work Flow Map</button></div>':''}`;const anchor=q(`[data-r31-runtime="${pageId}"]`,page)||q(':scope > .sub',page);anchor?.insertAdjacentElement('afterend',el);q('[data-r32-open-flow]',el)?.addEventListener('click',()=>window.LeaderOsR30?.showCustomPage?.('WORK_FLOW_MAP'))}}
 function managerBrief(){const mb=q('[data-manager-brief]');if(!mb)return;let el=q('[data-r32-manager-flow]');if(el)el.remove();const sig=runtimeSignals().slice(0,3),ss=snapshots(),cur=ss.at(-1);el=document.createElement('div');el.className='r32-runtime';el.dataset.r32ManagerFlow='';el.innerHTML=`<div class="r32-kicker">FLOW TREND / BOTTLENECK COST</div><b>${cur?`${cur.week} · Lead ${cur.lead}m · Wait ${cur.waitRatio}% · ${money(cur.bottleneckCost)}`:'Flow Snapshot 아직 없음'}</b><p>${sig.map(x=>`${esc(x.type)} · ${esc(x.copy)}`).join('<br>')||'즉시 보고할 Flow Signal 없음'}</p>`;mb.insertAdjacentElement('afterend',el)}
 function renderAll(){renderTrend();renderCostKpi();renderGovernance();renderRuntime();managerBrief()}
 document.addEventListener('click',e=>{if(e.target?.matches?.('[data-r31-owner-confirm],[data-r31-owner-save],[data-r29-flow-save],[data-r29-load-sample]'))setTimeout(renderAll,100)});document.addEventListener('submit',e=>{if(e.target?.matches?.('[data-r31-metric-form],[data-r29-flow-form]'))setTimeout(renderAll,100)});window.addEventListener('storage',e=>{if([SNAP_KEY,KPI_KEY,COST_KEY,PROP_KEY,VERSION_KEY,FLOW_KEY,METRIC_KEY].includes(e.key))renderAll()});
 setTimeout(renderAll,200);window.LeaderOsR32={render:renderAll,snapshots,costRows,runtimeSignals,versions,proposals};document.title='Leader OS · Recovery 32 · Flow Trend & Bottleneck Cost';
})();
</script>
<script id="recovery-33-event-automation-adapters">
(function(){
 const EVENT_KEY='leader-os:r33:event-timeline:v1', ADAPTER_KEY='leader-os:r33:kpi-adapters:v1', SCENARIO_KEY='leader-os:r33:cost-scenarios:v1', ESC_KEY='leader-os:r33:escalation-drafts:v1';
 const METRIC_KEY='leader-os:r31:workflow-metrics:v1', KPI_KEY='leader-os:r32:customer-kpi:v1';
 let storage=window.__leaderOsStorage; if(!storage){try{storage=localStorage}catch{storage={getItem:()=>null,setItem:()=>{}}}} const q=(s,r=document)=>r.querySelector(s),qa=(s,r=document)=>Array.from(r.querySelectorAll(s));
 const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 const load=(k,f)=>{try{const raw=storage.getItem(k)||localStorage.getItem(k);return raw?JSON.parse(raw):f}catch{return f}},save=(k,v)=>{try{storage.setItem(k,JSON.stringify(v))}catch{};try{localStorage.setItem(k,JSON.stringify(v))}catch{}};
 const num=v=>{const n=Number(v);return Number.isFinite(n)?n:0},money=v=>`$${num(v).toLocaleString(undefined,{maximumFractionDigits:2})}`;
 const flow=()=>window.LeaderOsR30?.flowSnapshot?.()||[];
 const stepKey=(i,x)=>`STEP:${i}:${String(x?.stage||'UNTITLED').replace(/[^A-Za-z0-9가-힣]+/g,'_').slice(0,32)}`;
 const eventStore=()=>{const x=load(EVENT_KEY,{});return x&&typeof x==='object'&&!Array.isArray(x)?x:{}};
 const adapterStore=()=>{const base=[{id:'adapter:crm',name:'CRM',status:'DISCONNECTED',kind:'CRM'},{id:'adapter:analytics',name:'Analytics',status:'DEMO',kind:'ANALYTICS'},{id:'adapter:support',name:'Support',status:'DISCONNECTED',kind:'SUPPORT'}],saved=load(ADAPTER_KEY,[]);return Array.isArray(saved)&&saved.length?saved:base};
 const diffMin=(a,b)=>{const A=new Date(a),B=new Date(b);return (!a||!b||isNaN(A)||isNaN(B))?0:Math.max(0,Math.round((B-A)/60000))};
 function derivedEvents(key){const rows=(eventStore()[key]||[]).filter(x=>x.arrivedAt&&x.startedAt&&x.completedAt).slice(-10);if(!rows.length)return {count:0,wait:0,cycle:0,lead:0};const vals=rows.map(x=>({wait:diffMin(x.arrivedAt,x.startedAt),cycle:diffMin(x.startedAt,x.completedAt),lead:diffMin(x.arrivedAt,x.completedAt)}));return {count:rows.length,wait:Math.round(vals.reduce((a,x)=>a+x.wait,0)/vals.length),cycle:Math.round(vals.reduce((a,x)=>a+x.cycle,0)/vals.length),lead:Math.round(vals.reduce((a,x)=>a+x.lead,0)/vals.length)} }
 function syncMetric(key,derived){const all=load(METRIC_KEY,{}),prev=all[key]||{};all[key]={...prev,cycleMin:derived.cycle,waitMin:derived.wait,evidence:`AUTO · ${derived.count} timestamp events · Recovery 33`,updatedAt:new Date().toISOString(),measurementMode:'EVENT_DERIVED'};save(METRIC_KEY,all)}
 function ensureRoot(){const page=q('[data-page="WORK_FLOW_MAP"]');if(!page)return null;let root=q('[data-r33-root]',page);if(!root){root=document.createElement('div');root.className='r33-shell';root.dataset.r33Root='';const anchor=q('[data-r32-root]',page)||q('[data-r31-flow-time]',page);anchor?.insertAdjacentElement('afterend',root)}return root}
 function renderEvents(){const root=ensureRoot();if(!root)return;let card=q('[data-r33-events]',root);if(!card){card=document.createElement('section');card.className='r33-card';card.dataset.r33Events='';root.append(card)}const f=flow(),events=eventStore(),total=Object.values(events).flat().length,derivedCount=f.filter((x,i)=>derivedEvents(stepKey(i,x)).count).length;card.innerHTML=`<div class="r33-head"><div><div class="r33-kicker">EVENT TIMESTAMP → FLOW TIME · RECOVERY 33</div><h2>ARRIVED → STARTED → COMPLETED로 Wait / Cycle / Lead 자동 계산</h2><p>수동으로 시간을 추정하지 않고 실제 Event Timestamp를 남깁니다. 최근 10건의 평균을 Flow Metric에 반영합니다.</p></div><span class="r33-badge ${derivedCount?'good':'info'}">${total} EVENTS</span></div><div class="r33-stats"><div class="r33-stat"><span>EVENTS</span><strong>${total}</strong></div><div class="r33-stat"><span>AUTO STEPS</span><strong>${derivedCount}/${f.length}</strong></div><div class="r33-stat"><span>MEASURE MODE</span><strong>EVENT</strong></div><div class="r33-stat"><span>WINDOW</span><strong>LAST 10</strong></div></div><div class="r33-list">${f.map((x,i)=>{const k=stepKey(i,x),d=derivedEvents(k),last=(events[k]||[]).at(-1);return `<div class="r33-row"><div><b>${String(i+1).padStart(2,'0')} · ${esc(x.stage)}</b><span>${d.count?`${d.count}건 평균 · Wait ${d.wait}m · Cycle ${d.cycle}m · Lead ${d.lead}m`:'Timestamp 기록 없음'}${last?`<br>Last · ${new Date(last.completedAt||last.startedAt||last.arrivedAt).toLocaleString()}`:''}</span></div><span class="r33-badge ${d.count?'good':'info'}">${d.count?'AUTO':'MANUAL'}</span></div>`}).join('')}</div><form class="r33-form" data-r33-event-form style="margin-top:10px"><div class="r33-form-grid"><label>Workflow Step<select data-r33-event-step>${f.map((x,i)=>`<option value="${i}">${String(i+1).padStart(2,'0')} · ${esc(x.stage)}</option>`).join('')}</select></label><label>Event source<select data-r33-event-source><option>Manual Timestamp</option><option>Project Tool</option><option>CRM</option><option>Support</option><option>Automation</option></select></label><label>ARRIVED<input type="datetime-local" data-r33-arrived required></label><label>STARTED<input type="datetime-local" data-r33-started required></label><label>COMPLETED<input type="datetime-local" data-r33-completed required></label><label>Evidence ID<input data-r33-event-ref placeholder="ticket / task / order id"></label></div><div class="r33-actions"><button type="submit" class="primary">Event 저장 + Flow Time 계산</button></div></form>`;
 q('[data-r33-event-form]',card).onsubmit=e=>{e.preventDefault();const i=+q('[data-r33-event-step]',card).value,x=f[i],k=stepKey(i,x),all=eventStore(),row={id:`EV-${Date.now().toString(36)}`,arrivedAt:q('[data-r33-arrived]',card).value,startedAt:q('[data-r33-started]',card).value,completedAt:q('[data-r33-completed]',card).value,source:q('[data-r33-event-source]',card).value,evidenceRef:q('[data-r33-event-ref]',card).value.trim(),createdAt:new Date().toISOString()};if(diffMin(row.arrivedAt,row.startedAt)+diffMin(row.startedAt,row.completedAt)<=0){alert('Timestamp 순서를 확인하세요.');return}(all[k]||(all[k]=[])).push(row);all[k]=all[k].slice(-30);save(EVENT_KEY,all);syncMetric(k,derivedEvents(k));window.LeaderOsR31?.render?.();window.LeaderOsR32?.render?.();renderAll()}}
 function renderAdapters(){const root=ensureRoot();if(!root)return;let wrap=q('[data-r33-adapters]',root);if(!wrap){wrap=document.createElement('div');wrap.className='r33-grid';wrap.dataset.r33Adapters='';root.append(wrap)}const f=flow(),adapters=adapterStore();wrap.innerHTML=`<section class="r33-card"><div class="r33-head"><div><div class="r33-kicker">KPI ADAPTER REGISTRY</div><h2>CRM / Analytics / Support 데이터를 Customer KPI로 연결</h2><p>Preview에서는 외부 연결을 가장하지 않습니다. DEMO Sync는 샘플 payload를 KPI Artifact로 변환하는 동작만 보여줍니다.</p></div><span class="r33-badge info">${adapters.length} ADAPTERS</span></div><div class="r33-list">${adapters.map(a=>`<div class="r33-row"><div><b>${esc(a.name)}</b><span>${esc(a.kind)} · ${a.status}<br>${a.status==='DEMO'?'Sample payload 사용':'실제 인증/연동 필요'}</span></div><span class="r33-badge ${a.status==='CONNECTED'?'good':a.status==='DEMO'?'warn':'info'}">${a.status}</span></div>`).join('')}</div></section><section class="r33-card"><div class="r33-head"><div><div class="r33-kicker">ADAPTER MAPPING PREVIEW</div><h2>Sample KPI Sync</h2><p>Source → Step → KPI Name → Actual/Target 매핑을 검증합니다.</p></div><span class="r33-badge warn">DEMO ONLY</span></div><form class="r33-form" data-r33-adapter-form><div class="r33-form-grid"><label>Adapter<select data-r33-adapter>${adapters.map(a=>`<option value="${esc(a.id)}">${esc(a.name)} · ${a.status}</option>`).join('')}</select></label><label>Workflow Step<select data-r33-adapter-step>${f.map((x,i)=>`<option value="${i}">${String(i+1).padStart(2,'0')} · ${esc(x.stage)}</option>`).join('')}</select></label><label>KPI name<input data-r33-adapter-kpi value="Customer Resolution Time"></label><label>Actual<input data-r33-adapter-actual value="42"></label><label>Target<input data-r33-adapter-target value="30"></label><label>Unit<input data-r33-adapter-unit value="min"></label><label>Direction<select data-r33-adapter-dir><option value="LOWER_BETTER">Lower is better</option><option value="HIGHER_BETTER">Higher is better</option></select></label><label>Source record<input data-r33-adapter-ref value="DEMO-CRM-2026-W40"></label></div><div class="r33-actions"><button type="submit">DEMO Sync</button></div></form><div class="r33-note">실제 Production에서는 OAuth/API 권한, source timestamp, schema version, sync idempotency가 필요합니다.</div></section>`;
 q('[data-r33-adapter-form]',wrap).onsubmit=e=>{e.preventDefault();const i=+q('[data-r33-adapter-step]',wrap).value,x=f[i],k=stepKey(i,x),all=load(KPI_KEY,{}),aid=q('[data-r33-adapter]',wrap).value,a=adapters.find(v=>v.id===aid);all[k]={name:q('[data-r33-adapter-kpi]',wrap).value.trim(),actual:q('[data-r33-adapter-actual]',wrap).value.trim(),target:q('[data-r33-adapter-target]',wrap).value.trim(),unit:q('[data-r33-adapter-unit]',wrap).value.trim(),direction:q('[data-r33-adapter-dir]',wrap).value,source:a?.name||'Adapter',sourceRef:q('[data-r33-adapter-ref]',wrap).value.trim(),note:'DEMO Adapter Sync · 실제 외부 API 호출 아님',adapterId:aid,syncedAt:new Date().toISOString(),updatedAt:new Date().toISOString()};save(KPI_KEY,all);window.LeaderOsR32?.render?.();renderAll()}}
 function costFor(r,waitReduction=0,reworkReduction=0,volumeChange=0){const volume=Math.max(0,num(r.volume)*(1+volumeChange/100)),wait=Math.max(0,num(r.wait)*(1-waitReduction/100)),rework=Math.max(0,num(r.reworkRate)*(1-reworkReduction/100));return wait*volume*num(r.waitRate)+(rework/100)*volume*num(r.reworkCost)}
 function renderSensitivity(){const root=ensureRoot();if(!root)return;let card=q('[data-r33-sensitivity]',root);if(!card){card=document.createElement('section');card.className='r33-card';card.dataset.r33Sensitivity='';root.append(card)}const rows=window.LeaderOsR32?.costRows?.()||[],saved=load(SCENARIO_KEY,[]),sel=rows[0];card.innerHTML=`<div class="r33-head"><div><div class="r33-kicker">BOTTLENECK COST SENSITIVITY</div><h2>Wait와 Rework를 줄이면 얼마의 운영 영향이 줄어드는가?</h2><p>회계 예측이 아니라 개선 실험의 우선순위를 비교하는 Scenario 도구입니다.</p></div><span class="r33-badge ${rows.length?'warn':'info'}">${rows.length} COST STEPS</span></div>${rows.length?`<form class="r33-form" data-r33-scenario-form><div class="r33-form-grid"><label>Step<select data-r33-scenario-step>${rows.map((r,i)=>`<option value="${i}">${esc(r.stage)} · ${money(r.total)}/wk</option>`).join('')}</select></label><label>Wait reduction %<input type="number" min="0" max="100" value="20" data-r33-wait-red></label><label>Rework reduction %<input type="number" min="0" max="100" value="20" data-r33-rework-red></label><label>Volume change %<input type="number" min="-100" value="0" data-r33-volume-change></label></div><div class="r33-actions"><button type="button" data-r33-calc>Scenario 계산</button><button type="button" data-r33-save-scenario>Scenario 저장</button></div></form><div class="r33-scenario" style="margin-top:10px"><div class="r33-scenario-box"><div class="r33-kicker">BASE</div><strong data-r33-base>${money(sel?.total)}</strong><p>/ week</p></div><div class="r33-scenario-box"><div class="r33-kicker">SCENARIO</div><strong data-r33-scenario>${money(sel?.total)}</strong><p data-r33-saving>saving $0</p></div></div>`:'<div class="r33-note">Recovery 32 Bottleneck Cost에 가정을 입력하면 Sensitivity를 계산할 수 있습니다.</div>'}<div class="r33-list" style="margin-top:10px">${saved.slice(-5).reverse().map(s=>`<div class="r33-row"><div><b>${esc(s.stage)}</b><span>Wait -${s.waitReduction}% · Rework -${s.reworkReduction}% · Volume ${s.volumeChange>=0?'+':''}${s.volumeChange}%</span></div><span class="r33-badge good">SAVE ${money(s.saving)}</span></div>`).join('')}</div>`;
 if(!rows.length)return;function calc(){const r=rows[+q('[data-r33-scenario-step]',card).value],wr=num(q('[data-r33-wait-red]',card).value),rr=num(q('[data-r33-rework-red]',card).value),vc=num(q('[data-r33-volume-change]',card).value),scenario=costFor(r,wr,rr,vc),saving=Math.max(0,num(r.total)-scenario);q('[data-r33-base]',card).textContent=money(r.total);q('[data-r33-scenario]',card).textContent=money(scenario);q('[data-r33-saving]',card).textContent=`saving ${money(saving)} / week`;return {r,wr,rr,vc,scenario,saving}}q('[data-r33-calc]',card).onclick=calc;q('[data-r33-save-scenario]',card).onclick=()=>{const x=calc(),list=load(SCENARIO_KEY,[]);list.push({id:`SC-${Date.now().toString(36)}`,stage:x.r.stage,waitReduction:x.wr,reworkReduction:x.rr,volumeChange:x.vc,base:x.r.total,scenario:x.scenario,saving:x.saving,createdAt:new Date().toISOString()});save(SCENARIO_KEY,list.slice(-20));renderAll()};q('[data-r33-scenario-step]',card).onchange=calc;calc()}
 function versionDiff(a,b){if(!a||!b)return [];const rows=[],am=new Map((a.flow||[]).map((x,i)=>[String(x.stage||i),x])),bm=new Map((b.flow||[]).map((x,i)=>[String(x.stage||i),x]));for(const [k,x] of bm){if(!am.has(k)){rows.push(`+ ${k} 단계 추가`);continue}const y=am.get(k),chg=[];['owner','decision','friction'].forEach(p=>String(x[p]||'')!==String(y[p]||'')&&chg.push(p));if(chg.length)rows.push(`~ ${k} · ${chg.join(', ')}`)}for(const [k] of am)if(!bm.has(k))rows.push(`− ${k} 단계 제거`);const metricKeys=new Set([...Object.keys(a.metrics||{}),...Object.keys(b.metrics||{})]);metricKeys.forEach(k=>{const x=a.metrics?.[k]||{},y=b.metrics?.[k]||{};if(num(x.cycleMin)!==num(y.cycleMin)||num(x.waitMin)!==num(y.waitMin)||num(x.slaMin)!==num(y.slaMin))rows.push(`Δ ${k} · time metric 변경`)});const kpiKeys=new Set([...Object.keys(a.customerKpi||{}),...Object.keys(b.customerKpi||{})]);kpiKeys.forEach(k=>{if(JSON.stringify(a.customerKpi?.[k]||{})!==JSON.stringify(b.customerKpi?.[k]||{}))rows.push(`Δ ${k} · Customer KPI 변경`)});return rows}
 function escalationCandidates(){const t=window.LeaderOsR31?.timeSignals?.()||[],r=window.LeaderOsR32?.runtimeSignals?.()||[],out=[];t.filter(x=>x.type==='SLA RISK'||x.type==='OVERDUE').forEach(x=>out.push({key:`${x.type}:${x.stage}`,type:x.type,stage:x.stage,evidence:x.copy||'Flow time signal',decision:'SLA 회복을 위해 Owner/Decision/Handoff 중 무엇을 변경할지 결정'}));r.filter(x=>['CUSTOMER KPI GAP','BOTTLENECK COST'].includes(x.type)).forEach(x=>out.push({key:`${x.type}:${x.copy}`,type:x.type,stage:x.copy.split(' · ')[0],evidence:x.copy,decision:'고객/비용 영향 기준으로 Process Experiment 우선순위 결정'}));return out.slice(0,6)}
 function renderGovernance(){const root=ensureRoot();if(!root)return;let wrap=q('[data-r33-governance]',root);if(!wrap){wrap=document.createElement('div');wrap.className='r33-grid';wrap.dataset.r33Governance='';root.append(wrap)}const vs=window.LeaderOsR32?.versions?.()||[],drafts=load(ESC_KEY,[]),cands=escalationCandidates(),a=vs.at(-2),b=vs.at(-1),diff=versionDiff(a,b);wrap.innerHTML=`<section class="r33-card"><div class="r33-head"><div><div class="r33-kicker">WORKFLOW VERSION DIFF</div><h2>새 AS-IS에서 실제로 무엇이 달라졌는가?</h2><p>Flow 구조뿐 아니라 Time Metric과 Customer KPI 변화까지 Version 간 비교합니다.</p></div><span class="r33-badge ${vs.length>=2?'good':'info'}">${vs.length} VERSIONS</span></div>${a&&b?`<div class="r33-note">AS-IS v${a.version} → v${b.version}</div><div class="r33-diff" style="margin-top:8px">${diff.map(x=>`<div class="r33-diff-item">${esc(x)}</div>`).join('')||'<div class="r33-diff-item">변경점 없음</div>'}</div>`:'<div class="r33-note">Confirmed AS-IS Version이 2개 이상이면 Diff가 나타납니다.</div>'}</section><section class="r33-card"><div class="r33-head"><div><div class="r33-kicker">SLA / KPI ESCALATION DRAFT</div><h2>자동 전송하지 않고 Evidence가 있는 보고 초안까지만 준비</h2><p>SLA·Customer KPI·Bottleneck Cost Signal을 리더의 판단 질문으로 바꿉니다.</p></div><span class="r33-badge ${cands.length?'warn':'good'}">${cands.length} CANDIDATES</span></div><div class="r33-list">${cands.map((x,i)=>{const saved=drafts.some(d=>d.key===x.key);return `<div class="r33-row"><div><b>${esc(x.type)} · ${esc(x.stage)}</b><span>Evidence · ${esc(x.evidence)}<br>Decision needed · ${esc(x.decision)}</span></div><button type="button" ${saved?'disabled':''} data-r33-escalate="${i}">${saved?'Draft 저장됨':'Escalation Draft'}</button></div>`}).join('')||'<div class="r33-note">현재 Escalation Draft 후보가 없습니다.</div>'}</div><div class="r33-list" style="margin-top:10px">${drafts.slice(-5).reverse().map(d=>`<div class="r33-row"><div><b>${esc(d.type)} · ${esc(d.stage)}</b><span>${esc(d.copy)}<br>DRAFT · 자동 발송 안 됨</span></div><span class="r33-badge info">DRAFT</span></div>`).join('')}</div></section>`;qa('[data-r33-escalate]',wrap).forEach(btn=>btn.onclick=()=>{const x=cands[+btn.dataset.r33Escalate];if(!x)return;const list=load(ESC_KEY,[]);if(!list.some(d=>d.key===x.key))list.push({id:`ESC-${Date.now().toString(36)}`,key:x.key,type:x.type,stage:x.stage,copy:`상황: ${x.stage}에서 ${x.type} 신호가 확인되었습니다. Evidence: ${x.evidence}. 판단 요청: ${x.decision}.`,status:'DRAFT',createdAt:new Date().toISOString()});save(ESC_KEY,list.slice(-20));renderAll()})}
 function runtime(){for(const pageId of ['TODAY','REVIEW','REPORTS']){const page=q(`[data-page="${pageId}"]`);if(!page)continue;let el=q(`[data-r33-runtime="${pageId}"]`,page);el?.remove();const drafts=load(ESC_KEY,[]),autoSteps=flow().filter((x,i)=>derivedEvents(stepKey(i,x)).count).length;el=document.createElement('section');el.className='r33-runtime';el.dataset.r33Runtime=pageId;el.innerHTML=`<div class="r33-kicker">EVENT AUTOMATION / ESCALATION · RECOVERY 33</div><h2>${pageId==='TODAY'?'오늘 자동 측정 / Escalation 확인':'Flow Evidence Automation'}</h2><p>${autoSteps}개 Step이 Event Timestamp로 자동 측정 중 · Escalation Draft ${drafts.length}개. Draft는 자동 전송되지 않습니다.</p>${pageId==='TODAY'?'<div class="r33-actions"><button type="button" data-r33-open-flow>Work Flow Map</button></div>':''}`;const anchor=q(`[data-r32-runtime="${pageId}"]`,page)||q(':scope > .sub',page);anchor?.insertAdjacentElement('afterend',el);q('[data-r33-open-flow]',el)?.addEventListener('click',()=>window.LeaderOsR30?.showCustomPage?.('WORK_FLOW_MAP'))}}
 function renderAll(){renderEvents();renderAdapters();renderSensitivity();renderGovernance();runtime()}
 document.addEventListener('click',e=>{if(e.target?.matches?.('[data-r32-confirm],[data-r32-save-snapshot],[data-r31-owner-confirm]'))setTimeout(renderAll,100)});window.addEventListener('storage',e=>{if([EVENT_KEY,ADAPTER_KEY,SCENARIO_KEY,ESC_KEY,METRIC_KEY,KPI_KEY].includes(e.key))renderAll()});setTimeout(renderAll,250);window.LeaderOsR33={render:renderAll,derivedEvents,adapterStore,escalationCandidates};document.title='Leader OS · Recovery 33 · Event Automation & KPI Adapters';
})();
</script>
<script id="recovery-34-image-modal-script">
document.addEventListener('click',function(e){
  const viewBtn=e.target.closest('[data-r29-view-image]');
  if(viewBtn){
    const card=viewBtn.closest('.r29-sample');
    const img=card?.querySelector('img');
    const title=card?.querySelector('h3')?.textContent?.trim()||'Workflow sample image';
    const kicker=card?.querySelector('.r29-kicker')?.textContent?.trim()||'';
    const desc=card?.querySelector('p')?.textContent?.trim()||'';
    const modal=document.querySelector('[data-r29-image-modal]');
    if(modal&&img){
      modal.querySelector('[data-r29-image-preview]').src=img.src;
      modal.querySelector('[data-r29-image-preview]').alt=img.alt||title;
      modal.querySelector('[data-r29-image-title]').textContent=title;
      modal.querySelector('[data-r29-image-sub]').textContent=kicker;
      modal.querySelector('[data-r29-image-caption]').textContent=desc;
      if(typeof modal.showModal==='function') modal.showModal();
    }
    return;
  }
  if(e.target.closest('[data-r29-image-close]')){
    document.querySelector('[data-r29-image-modal]')?.close();
    return;
  }
  const modal=e.target.closest?.('.r29-image-modal');
  if(modal && e.target===modal) modal.close();
});
document.addEventListener('keydown',function(e){
  if(e.key==='Escape') document.querySelector('[data-r29-image-modal][open]')?.close();
});
</script>
<script id="recovery-35-workflow-review-script">
(function(){
  const FLOW_KEY='leader-os:r29:workflow', LINK_KEY='leader-os:r30:workflow-links:v1', EXP_KEY='leader-os:r30:process-experiments:v1', EVENT_KEY='leader-os:r33:event-timeline:v1';
  const REVIEW_KEY='leader-os:r35:workflow-review:v1', CHECK_KEY='leader-os:r35:workflow-review-checks:v1';
  const CADENCES=[
    {id:'DAILY', title:'Daily signal check', window:'매일 5~10분', note:'당일 Blocker, 지연, 고객 이슈, 갑작스러운 핸드오프 문제를 확인합니다.', bullets:['Blocker 1건 이상', '고객 이슈 발생', '오늘 처리할 결정 지연']},
    {id:'WEEKLY', title:'Weekly workflow review', window:'주 1회 30~45분', note:'운영 리듬상 가장 중요한 리뷰입니다. 병목, DRI, 다음 실험을 결정합니다.', bullets:['병목 1~2개 선정', '다음 실험 1개 확정', '책임/일정 재정렬']},
    {id:'MONTHLY', title:'Monthly redesign review', window:'월 1회 60~90분', note:'구조 자체를 바꿀지 보는 시간입니다. 시스템, SSOT, 권한 범위를 재설계합니다.', bullets:['구조 변경 판단', '자동화/툴 보강', '팀 역할 재정의']},
    {id:'TRIGGER', title:'Triggered review', window:'이벤트 발생 즉시', note:'클레임, 매출 급변, 품질 사고, 일정 슬립, 인수인계 누락 등 이상 신호가 생기면 즉시 실행합니다.', bullets:['지표 급변', 'Escalation / 사고', '주요 고객 불만']}
  ];
  const CHECKS=[
    ['customer-change','이번 주 고객 흐름이나 요구가 바뀌었는가?','고객 Trigger/채널/요청이 바뀌면 Flow를 먼저 다시 봐야 합니다.'],
    ['bottleneck','가장 느린 단계가 어디인지 팀이 알고 있는가?','단순히 바쁜 곳이 아니라, 전체 리드타임을 결정하는 병목을 찍습니다.'],
    ['dri','각 핵심 단계의 DRI가 명확한가?','공동 책임처럼 보이는 구간은 실제 책임자를 다시 지정합니다.'],
    ['handoff','핸드오프 품질이 깨진 구간이 있는가?','누가/언제/무엇을 넘기는지, 입력과 출력이 같은 언어인지 확인합니다.'],
    ['metric','성과 지표와 현장 체감이 같은 방향인가?','체감만 있거나 숫자만 있는 상태를 줄입니다. 둘을 같이 봅니다.'],
    ['next-exp','다음에 검증할 실험이 1개 정의되어 있는가?','한 번에 하나의 변경만 테스트하는 원칙을 권장합니다.']
  ];
  const esc=(v)=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const q=(s,p=document)=>p.querySelector(s), qa=(s,p=document)=>Array.from(p.querySelectorAll(s));
  const read=(k,d)=>{try{const raw=localStorage.getItem(k);return raw?JSON.parse(raw):d}catch{return d}};
  const write=(k,v)=>{try{localStorage.setItem(k,JSON.stringify(v))}catch{}};
  function risks(flow,links){
    const issues=[];
    flow.forEach((step,i)=>{
      const key=Object.keys(links).find(k=>k.includes(`::${String(step.stage||'').toLowerCase()}`))||'';
      const link=key?links[key]||{}:{};
      if(!step.owner) issues.push({type:'DRI GAP',level:'WARN',stage:step.stage||`Step ${i+1}`,copy:'Owner / DRI가 비어 있습니다.'});
      if(step.friction) issues.push({type:'FRICTION',level:'WARN',stage:step.stage||`Step ${i+1}`,copy:step.friction});
      if(!step.io) issues.push({type:'IO GAP',level:'INFO',stage:step.stage||`Step ${i+1}`,copy:'Input / Output 정의가 없습니다.'});
      if(!link.authority && step.layer!=='Customer') issues.push({type:'AUTHORITY GAP',level:'INFO',stage:step.stage||`Step ${i+1}`,copy:'Authority / Decision 범위가 비어 있습니다.'});
    });
    return issues;
  }
  function summarize(){
    const flow=read(FLOW_KEY,[]), links=read(LINK_KEY,{}), ex=read(EXP_KEY,[]), events=read(EVENT_KEY,[]), checks=read(CHECK_KEY,{}), logs=read(REVIEW_KEY,[]);
    const rs=risks(flow,links);
    const openExp=ex.filter(x=>String(x.status||'').toUpperCase()!=='DONE').length;
    const recentEvents=events.filter(x=>{const at=new Date(x.at||x.date||x.createdAt||0); return Number.isFinite(+at) && (Date.now()-+at)<1000*60*60*24*7}).length;
    const doneChecks=Object.values(checks).filter(Boolean).length;
    const due = rs.length>=4 || recentEvents>=3 ? 'TRIGGER' : openExp>0 || flow.length>0 ? 'WEEKLY' : 'MONTHLY';
    return {flow,links,ex,events,checks,logs,rs,openExp,recentEvents,doneChecks,due};
  }
  function ensureRoot(){
    const page=q('[data-page="WORK_FLOW_MAP"]'); if(!page) return null;
    let root=q('[data-r35-root]',page);
    if(!root){
      root=document.createElement('div'); root.className='r35-shell'; root.dataset.r35Root='';
      const anchor=q('[data-r33-root]',page)||q('[data-r32-root]',page)||q('[data-r31-flow-time]',page);
      (anchor?.parentElement||page).appendChild(root);
    }
    return root;
  }
  function draft(s){
    const today=new Date().toISOString().slice(0,10);
    const topRisk=s.rs[0]?`${s.rs[0].stage} · ${s.rs[0].type}`:'주요 리스크 없음';
    return {
      date:today,
      cadence:s.due,
      observation:`Flow ${s.flow.length}단계, 리스크 ${s.rs.length}건, 진행중 실험 ${s.openExp}건, 최근 이벤트 ${s.recentEvents}건을 확인했습니다. 현재 가장 먼저 볼 지점은 ${topRisk} 입니다.`,
      decision:`이번 리뷰에서 결정할 것: 병목 1개, 책임자 정렬 필요 여부, 다음 실험 1개.`,
      next:`다음 액션: 가장 큰 병목 단계의 입력/출력과 DRI를 확정하고, 1주 안에 검증할 작은 실험을 설정합니다.`,
      owner:'Team Lead',
      dueDate:today
    }
  }
  function render(){
    const root=ensureRoot(); if(!root) return;
    const s=summarize();
    const recommend=s.due==='TRIGGER'?'즉시 Triggered Review':s.due==='WEEKLY'?'이번 주 Weekly Review':'월간 Monthly Review';
    root.innerHTML=`
      <section class="r35-card">
        <div class="r35-head">
          <div>
            <div class="r35-kicker">WORKFLOW REVIEW CADENCE</div>
            <h2>업무 플로우는 언제 확인하면 좋은가?</h2>
            <p>정답은 “매일 조금, 매주 깊게, 월간으로 구조를 다시, 이상 신호가 생기면 즉시” 입니다. 아래 영역은 Leader OS 안에서 바로 리뷰 리듬을 만들고 기록하도록 설계된 운영판입니다.</p>
          </div>
          <span class="r35-badge ${s.due==='TRIGGER'?'warn':'good'}">추천 리뷰 · ${recommend}</span>
        </div>
        <div class="r35-grid-4 r35-timing">
          ${CADENCES.map(c=>`<article class="r35-mini"><span class="r35-label">${esc(c.title)}</span><div class="r35-window">${esc(c.window)}</div><p>${esc(c.note)}</p><ul>${c.bullets.map(b=>`<li>${esc(b)}</li>`).join('')}</ul></article>`).join('')}
        </div>
      </section>
      <section class="r35-grid-3">
        <article class="r35-card">
          <div class="r35-head"><div><div class="r35-kicker">READINESS SNAPSHOT</div><h2>이번 리뷰를 열어야 하는 이유</h2><p>현재 저장된 Flow / 실험 / 이벤트 / 리스크 상태를 바탕으로 리뷰 우선순위를 제안합니다.</p></div><span class="r35-badge">LIVE SUMMARY</span></div>
          <div class="r35-grid-4">
            <div class="r35-mini"><span class="r35-label">Flow steps</span><span class="r35-number">${s.flow.length}</span><span class="r35-sub">현재 기록된 단계 수</span></div>
            <div class="r35-mini"><span class="r35-label">Risk signals</span><span class="r35-number">${s.rs.length}</span><span class="r35-sub">DRI / IO / Friction 기반</span></div>
            <div class="r35-mini"><span class="r35-label">Open experiments</span><span class="r35-number">${s.openExp}</span><span class="r35-sub">진행중이거나 리뷰 대기</span></div>
            <div class="r35-mini"><span class="r35-label">Recent events</span><span class="r35-number">${s.recentEvents}</span><span class="r35-sub">최근 7일 이벤트 수</span></div>
          </div>
          <div class="r35-divider"></div>
          ${s.rs.length?`<div class="r35-log-list">${s.rs.slice(0,4).map(r=>`<div class="r35-log-item"><div class="r35-log-meta"><span class="r35-badge ${r.level==='WARN'?'warn':''}">${esc(r.type)}</span></div><b>${esc(r.stage)}</b><span>${esc(r.copy)}</span></div>`).join('')}</div>`:`<div class="r35-empty">아직 감지된 주요 리스크가 없습니다. 그래도 주간 리뷰는 유지하는 것이 좋습니다.</div>`}
        </article>
        <article class="r35-card">
          <div class="r35-head"><div><div class="r35-kicker">WEEKLY CHECKLIST</div><h2>리뷰 전에 확인할 6가지</h2><p>체크리스트는 단순 기록이 아니라, 팀장이 질문할 순서를 정리하는 역할을 합니다.</p></div><span class="r35-badge">${s.doneChecks}/6 CHECKED</span></div>
          <div class="r35-checks">
            ${CHECKS.map(([id,title,desc])=>`<label class="r35-check"><input type="checkbox" data-r35-check="${id}" ${s.checks[id]?'checked':''}><div><strong>${esc(title)}</strong><span>${esc(desc)}</span></div></label>`).join('')}
          </div>
          <div class="r35-actions"><button type="button" data-r35-reset-checks>체크 초기화</button></div>
        </article>
        <article class="r35-card">
          <div class="r35-head"><div><div class="r35-kicker">RECENT REVIEW LOG</div><h2>최근 리뷰 기록</h2><p>회의가 끝나면 최소한 Observation / Decision / Next Action은 남겨 두는 것을 권장합니다.</p></div><span class="r35-badge">${s.logs.length} LOGS</span></div>
          <div class="r35-log-list">${s.logs.length?s.logs.slice().reverse().slice(0,4).map(x=>`<article class="r35-log-item"><div class="r35-log-meta"><span class="r35-badge">${esc(x.cadence||'REVIEW')}</span><span class="r35-note">${esc(x.date||'')}</span></div><b>${esc(x.observation||'Observation')}</b><span>Decision · ${esc(x.decision||'—')}<br>Next · ${esc(x.next||'—')}<br>Owner · ${esc(x.owner||'—')} · Due ${esc(x.dueDate||'—')}</span></article>`).join(''):'<div class="r35-empty">아직 리뷰 로그가 없습니다. 아래 초안 생성 버튼으로 바로 시작할 수 있습니다.</div>'}</div>
        </article>
      </section>
      <section class="r35-grid-2">
        <article class="r35-card">
          <div class="r35-head"><div><div class="r35-kicker">REVIEW DRAFT MAKER</div><h2>Workflow Review 기록 남기기</h2><p>회의 직후 3분 안에 남기는 최소 문서입니다. 팀 운영에 필요한 Evidence를 남기고 다음 행동을 합의합니다.</p></div><span class="r35-badge">ODN FORMAT</span></div>
          <form data-r35-form>
            <div class="r35-field-grid">
              <label><span>Review date</span><input type="date" data-r35-date required></label>
              <label><span>Cadence</span><select data-r35-cadence>${CADENCES.map(c=>`<option value="${c.id}">${c.title}</option>`).join('')}</select></label>
              <label class="full"><span>Observation</span><textarea data-r35-observation placeholder="무슨 일이 일어났는지"></textarea></label>
              <label class="full"><span>Decision / Discussion</span><textarea data-r35-decision placeholder="무엇을 결정하거나 더 알아봐야 하는지"></textarea></label>
              <label class="full"><span>Next action</span><textarea data-r35-next placeholder="누가 무엇을 언제까지 할지"></textarea></label>
              <label><span>Owner</span><input data-r35-owner placeholder="예: Team Lead"></label>
              <label><span>Due date</span><input type="date" data-r35-due></label>
            </div>
            <div class="r35-actions"><button type="button" class="primary" data-r35-make-draft>이번 상태로 초안 생성</button><button type="submit">Review 저장</button><button type="button" data-r35-clear-form>폼 비우기</button></div>
          </form>
        </article>
        <article class="r35-card">
          <div class="r35-head"><div><div class="r35-kicker">LEADER GUIDE</div><h2>팀장이 이 섹션을 쓰는 방식</h2><p>도구를 추가하는 것보다 더 중요한 것은 언제, 어떤 순서로 질문하고 기록하느냐 입니다.</p></div><span class="r35-badge">PRACTICE</span></div>
          <div class="r35-review-item"><h3>1. Daily</h3><p>아침 5분: 오늘 막히는 단계, 고객 이슈, Decision 지연이 있는지 확인합니다.</p></div>
          <div class="r35-review-item"><h3>2. Weekly</h3><p>주 1회 30~45분: 병목 1개, 책임 1개, 실험 1개를 뽑아 팀과 합의합니다.</p></div>
          <div class="r35-review-item"><h3>3. Monthly</h3><p>월 1회 60~90분: 구조를 다시 설계할지 판단합니다. SSOT, 권한, 자동화, 역할을 조정합니다.</p></div>
          <div class="r35-review-item"><h3>4. Triggered</h3><p>클레임, 품질사고, 급격한 KPI 하락, 일정 슬립이 나오면 정규 회의를 기다리지 말고 바로 엽니다.</p></div>
          <div class="r35-actions"><button type="button" data-r35-open-latest>최근 로그 내용을 폼에 불러오기</button></div>
        </article>
      </section>`;
    bind(root,s);
  }
  function bind(root,s){
    qa('[data-r35-check]',root).forEach(box=>box.onchange=()=>{const checks=read(CHECK_KEY,{}); checks[box.dataset.r35Check]=box.checked; write(CHECK_KEY,checks); render();});
    q('[data-r35-reset-checks]',root)?.addEventListener('click',()=>{write(CHECK_KEY,{}); render();});
    const form=q('[data-r35-form]',root); if(form){
      const fill=(x)=>{q('[data-r35-date]',root).value=x.date||''; q('[data-r35-cadence]',root).value=x.cadence||'WEEKLY'; q('[data-r35-observation]',root).value=x.observation||''; q('[data-r35-decision]',root).value=x.decision||''; q('[data-r35-next]',root).value=x.next||''; q('[data-r35-owner]',root).value=x.owner||''; q('[data-r35-due]',root).value=x.dueDate||'';};
      q('[data-r35-make-draft]',root)?.addEventListener('click',()=>fill(draft(s)));
      q('[data-r35-clear-form]',root)?.addEventListener('click',()=>form.reset());
      q('[data-r35-open-latest]',root)?.addEventListener('click',()=>{const latest=s.logs[s.logs.length-1]; if(latest) fill(latest);});
      form.addEventListener('submit',e=>{e.preventDefault(); const rows=read(REVIEW_KEY,[]); rows.push({id:`R35-${Date.now().toString(36)}`,date:q('[data-r35-date]',root).value,cadence:q('[data-r35-cadence]',root).value,observation:q('[data-r35-observation]',root).value.trim(),decision:q('[data-r35-decision]',root).value.trim(),next:q('[data-r35-next]',root).value.trim(),owner:q('[data-r35-owner]',root).value.trim(),dueDate:q('[data-r35-due]',root).value,createdAt:new Date().toISOString()}); write(REVIEW_KEY,rows.slice(-40)); form.reset(); render();});
    }
  }
  function schedule(){setTimeout(render,0)}
  document.addEventListener('click',e=>{const a=e.target.closest('[data-r30-custom-page="WORK_FLOW_MAP"]'); if(a) schedule()});
  window.addEventListener('storage',e=>{if([FLOW_KEY,LINK_KEY,EXP_KEY,EVENT_KEY,REVIEW_KEY,CHECK_KEY].includes(e.key)) render()});
  document.addEventListener('DOMContentLoaded',schedule); schedule(); setTimeout(schedule,120);
})();
</script>
<script id="recovery-36-work-report-script">
(function(){
  const KEY='leader-os:r36:work-reports:v1';
  const FLOW='leader-os:r29:workflow', LINKS='leader-os:r30:workflow-links:v1', EXP='leader-os:r30:process-experiments:v1', EVENTS='leader-os:r33:event-timeline:v1', ESC='leader-os:r33:escalation-drafts:v1', REV='leader-os:r35:workflow-review:v1', SNAP='leader-os:r32:flow-snapshots:v1', KPI='leader-os:r32:customer-kpi:v1', TOP3='leader-os:onboarding-today-top3:v1';
  const localScope=()=>{try{const x=window.LeaderOsReportRuntimeBridge?.state?.();return x?.signedIn&&x.userId&&x.workspaceId?`${x.userId}:${x.workspaceId}`:'guest'}catch{return'guest'}};
  const scopedPersonal=k=>`${k}:${localScope()}`;
  const q=(s,p=document)=>p.querySelector(s), qa=(s,p=document)=>Array.from(p.querySelectorAll(s));
  const r36Storage=window.__leaderOsStorage||(()=>{const m=new Map();return{getItem:k=>m.has(String(k))?m.get(String(k)):null,setItem:(k,v)=>m.set(String(k),String(v)),removeItem:k=>m.delete(String(k))}})();window.__leaderOsStorage=r36Storage;
  const read=(k,d)=>{let x=null;try{x=localStorage.getItem(k)}catch{x=r36Storage.getItem(k)};try{return x?JSON.parse(x):d}catch{return d}};
  const write=(k,v)=>{const raw=JSON.stringify(v);try{localStorage.setItem(k,raw)}catch{r36Storage.setItem(k,raw)}};
  const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  const nl=v=>String(v||'').trim();
  const listify=v=>{if(Array.isArray(v))return v; if(!v||typeof v!=='object')return []; return Object.values(v).flatMap(x=>Array.isArray(x)?x:[x]).filter(x=>x&&typeof x==='object')};
  function context(){
    const flow=read(FLOW,[]), links=read(LINKS,{}), ex=read(EXP,[]), events=read(EVENTS,[]), drafts=read(ESC,[]), reviews=read(REV,[]), snaps=read(SNAP,[]), kpi=read(KPI,[]), top3=read(scopedPersonal(TOP3),null);
    const frictions=(flow||[]).filter(x=>x?.friction).map(x=>({stage:x.stage||'Workflow',friction:x.friction}));
    const missingOwners=(flow||[]).filter(x=>!x?.owner).map(x=>x.stage||'Untitled step');
    const openExp=(ex||[]).filter(x=>String(x?.status||'').toUpperCase()!=='DONE');
    const escalations=listify(drafts).filter(x=>!['CLOSED','DONE','RESOLVED'].includes(String(x.status||'').toUpperCase()));
    const recentReviews=(reviews||[]).slice(-3);
    const recentEvents=(events||[]).filter(x=>{const d=new Date(x.at||x.date||x.createdAt||0);return Number.isFinite(+d)&&(Date.now()-+d)<604800000});
    const recentSnaps=(snaps||[]).slice(-2);
    const kpis=listify(kpi).slice(-6);
    return {flow,links,frictions,missingOwners,openExp,escalations,recentReviews,recentEvents,recentSnaps,kpis,top3};
  }
  function counts(c){return {flow:c.flow.length,risks:c.frictions.length+c.missingOwners.length,experiments:c.openExp.length,events:c.recentEvents.length,reviews:c.recentReviews.length}}
  function sources(c){const out=[]; if(c.flow.length)out.push(`Workflow ${c.flow.length} steps`); if(c.recentEvents.length)out.push(`Recent events ${c.recentEvents.length}`); if(c.openExp.length)out.push(`Open experiments ${c.openExp.length}`); if(c.recentReviews.length)out.push(`Workflow review logs ${c.recentReviews.length}`); if(c.kpis.length)out.push(`Customer KPI records ${c.kpis.length}`); if(c.top3?.items?.length)out.push('Onboarding Today Top 3'); return out}
  function dailyDraft(c){
    const risk=[...c.frictions.map(x=>`${x.stage}: ${x.friction}`),...c.missingOwners.map(x=>`${x}: DRI 미정`),...c.escalations.map(x=>x.title||x.reason||x.type||'Escalation 검토 필요')].slice(0,3);
    const progress=c.openExp.slice(0,3).map(x=>`${x.hypothesis||x.title||'Process Experiment'} · ${x.status||'DRAFT'}`);
    const review=c.recentReviews.at(-1);
    const next=c.top3?.items?.slice(0,3)||[];
    return {outcome:review?.observation||'오늘의 핵심 결과를 한 줄로 입력하세요.',progress:progress.length?progress.map(x=>`- ${x}`).join('\n'):'- 완료/진행 업무를 입력하세요.',risk:risk.length?risk.map(x=>`- ${x}`).join('\n'):'- 현재 Context에서 강한 Blocker 신호가 없습니다. 실제 상황을 확인하세요.',ask:review?.decision||'상급자 결정 또는 지원이 필요한 항목을 입력하세요.',next:next.length?next.map(x=>`- ${x}`).join('\n'):(review?.next||'- 내일 가장 먼저 할 1~3가지를 입력하세요.'),evidence:sources(c).map(x=>`- ${x}`).join('\n')||'- Evidence / Link를 추가하세요.'}
  }
  function weeklyDraft(c){
    const outcomes=c.recentReviews.map(x=>x.observation).filter(Boolean).slice(-3);
    const risks=[...c.frictions.map(x=>`${x.stage}: ${x.friction}`),...c.missingOwners.map(x=>`${x}: DRI 미정`),...c.escalations.map(x=>x.title||x.reason||'Escalation')].slice(0,5);
    const ex=c.openExp.slice(0,4).map(x=>`${x.hypothesis||x.title||'Experiment'} · ${x.status||'DRAFT'}${x.evidence?` · ${x.evidence}`:''}`);
    const next=c.top3?.items?.slice(0,3)||c.recentReviews.at(-1)?.next?.split('\n').filter(Boolean).slice(0,3)||[];
    const kpiLines=c.kpis.slice(0,4).map(x=>`${x.name||x.metric||x.kpi||'KPI'}: ${x.actual??x.value??'값 확인 필요'}${x.target!=null?` / target ${x.target}`:''}`);
    return {summary:`이번 주 Workflow ${c.flow.length}단계, 진행중 실험 ${c.openExp.length}건, 최근 운영 이벤트 ${c.recentEvents.length}건을 기준으로 보고 초안을 만들었습니다. 실제 성과 문장으로 수정하세요.`,outcome:outcomes.length?outcomes.map(x=>`- ${x}`).join('\n'):'- 이번 주 완료된 Outcome / Milestone을 입력하세요.',evidence:[...kpiLines,...sources(c)].slice(0,7).map(x=>`- ${x}`).join('\n')||'- KPI / Evidence / Learning을 입력하세요.',risk:risks.length?risks.map(x=>`- ${x}`).join('\n'):'- 다음 주 결과에 영향을 줄 Risk를 입력하세요.',ask:c.recentReviews.at(-1)?.decision||'상급자/타 팀의 결정 또는 지원이 필요한 항목을 입력하세요.',next:next.length?next.map(x=>`- ${x}`).join('\n'):'- 다음 주 Top 3를 입력하세요.',learning:ex.length?ex.map(x=>`- ${x}`).join('\n'):'- Process / Team Learning을 입력하세요.'}
  }
  function current(type,root){const p=type==='DAILY'?'daily':'weekly', get=n=>q(`[data-r36-${p}-${n}]`,root)?.value||'';if(type==='DAILY')return{type,date:get('date'),to:get('to'),scope:get('scope'),author:get('author'),outcome:get('outcome'),progress:get('progress'),risk:get('risk'),ask:get('ask'),next:get('next'),evidence:get('evidence')};return{type,date:get('date'),to:get('to'),scope:get('scope'),author:get('author'),summary:get('summary'),outcome:get('outcome'),evidence:get('evidence'),risk:get('risk'),ask:get('ask'),next:get('next'),learning:get('learning')}}
  function reportText(r){if(r.type==='DAILY')return `[일일 업무보고] ${r.date||''}\n대상: ${r.to||'—'} · ${r.scope||'—'} · 작성: ${r.author||'—'}\n\n1. 오늘의 핵심 Outcome\n${r.outcome||'—'}\n\n2. 완료 / 진행\n${r.progress||'—'}\n\n3. Blocker / Risk\n${r.risk||'—'}\n\n4. Decision / Support Needed\n${r.ask||'—'}\n\n5. Tomorrow / Next\n${r.next||'—'}\n\nEvidence / Link\n${r.evidence||'—'}`;return `[주간 업무보고] Week of ${r.date||''}\n대상: ${r.to||'—'} · ${r.scope||'—'} · 작성: ${r.author||'—'}\n\n1. 이번 주 한 줄 요약\n${r.summary||'—'}\n\n2. Key Outcomes / Achievements\n${r.outcome||'—'}\n\n3. KPI / Evidence / Learning\n${r.evidence||'—'}\n\n4. Blockers / Risks\n${r.risk||'—'}\n\n5. Decisions / Support Needed\n${r.ask||'—'}\n\n6. Next Week Top 3\n${r.next||'—'}\n\n7. Process / Team Learning\n${r.learning||'—'}`}
  function renderPreview(type,root){const r=current(type,root), box=q(`[data-r36-${type.toLowerCase()}-preview]`,root);if(!box)return;const sections=type==='DAILY'?[['OUTCOME',r.outcome],['PROGRESS',r.progress],['RISK / BLOCKER',r.risk],['DECISION / SUPPORT',r.ask],['NEXT',r.next],['EVIDENCE',r.evidence]]:[['SUMMARY',r.summary],['OUTCOMES',r.outcome],['KPI / EVIDENCE',r.evidence],['RISKS',r.risk],['DECISION / SUPPORT',r.ask],['NEXT WEEK TOP 3',r.next],['LEARNING',r.learning]];box.innerHTML=`<div class="r36-preview-head"><div><strong>${type==='DAILY'?'일일 업무보고':'주간 업무보고'}</strong><div class="r36-note">${esc(r.date||'날짜 미정')} · ${esc(r.scope||'Scope 미정')} · To ${esc(r.to||'—')}</div></div><span class="r36-state">DRAFT PREVIEW</span></div>${sections.map(([h,v])=>`<div class="r36-section"><small>${h}</small><div>${esc(v||'—')}</div></div>`).join('')}`}
  function fill(type,d,root){const p=type==='DAILY'?'daily':'weekly';Object.entries(d).forEach(([k,v])=>{const el=q(`[data-r36-${p}-${k}]`,root);if(el)el.value=v||''});renderPreview(type,root)}
  function today(){return new Date().toISOString().slice(0,10)}
  function monday(){const d=new Date(), day=(d.getDay()+6)%7;d.setDate(d.getDate()-day);return d.toISOString().slice(0,10)}
  function saveReport(r){const rows=read(KEY,[]);rows.push({...r,id:`R36-${Date.now().toString(36)}`,status:'DRAFT',version:1,createdAt:new Date().toISOString(),sources:sources(context())});write(KEY,rows.slice(-80));return rows.at(-1)}
  function renderHistory(root){const rows=read(KEY,[]);const box=q('[data-r36-history]',root);if(!box)return;box.innerHTML=rows.length?rows.slice().reverse().map(r=>`<article class="r36-history-item"><div><div><span class="r36-state ${r.status==='CONFIRMED'?'confirmed':''}">${esc(r.status)}</span></div><b>${r.type==='DAILY'?'일일':'주간'} · ${esc(r.date||'날짜 미정')} · ${esc(r.scope||'Scope 미정')}</b><span>${esc((r.type==='DAILY'?r.outcome:r.summary)||'내용 없음')}<br>v${r.version||1} · ${new Date(r.createdAt).toLocaleString('ko-KR')}</span></div><div class="r36-history-actions"><button type="button" data-r36-open="${r.id}">불러오기</button><button type="button" data-r36-copy-id="${r.id}">복사</button><button type="button" ${r.status==='CONFIRMED'?'disabled':''} data-r36-confirm="${r.id}">${r.status==='CONFIRMED'?'확정됨':'Human Confirm'}</button></div></article>`).join(''):'<div class="r36-empty">아직 저장된 일일/주간 보고가 없습니다.</div>';qa('[data-r36-open]',box).forEach(b=>b.onclick=()=>{const r=rows.find(x=>x.id===b.dataset.r36Open);if(!r)return;show(r.type);fill(r.type,r,root)});qa('[data-r36-copy-id]',box).forEach(b=>b.onclick=()=>{const r=rows.find(x=>x.id===b.dataset.r36CopyId);if(r)copy(reportText(r))});qa('[data-r36-confirm]',box).forEach(b=>b.onclick=()=>{const idx=rows.findIndex(x=>x.id===b.dataset.r36Confirm);if(idx<0)return;rows[idx]={...rows[idx],status:'CONFIRMED',confirmedAt:new Date().toISOString()};write(KEY,rows);renderHistory(root)})}
  async function copy(txt){try{await navigator.clipboard.writeText(txt)}catch{const ta=document.createElement('textarea');ta.value=txt;document.body.append(ta);ta.select();document.execCommand('copy');ta.remove()}}
  function show(type){qa('[data-r36-tab]').forEach(b=>b.classList.toggle('active',b.dataset.r36Tab===type));qa('[data-r36-mode]').forEach(m=>m.classList.toggle('active',m.dataset.r36Mode===type))}
  function showPage(){const page=q('[data-page="WORK_REPORTS"]');if(!page)return;qa('[data-page]').forEach(x=>x.hidden=x!==page);qa('[data-primary-nav] a').forEach(a=>a.removeAttribute('aria-current'));q('[data-r36-nav]')?.setAttribute('aria-current','page');const t=q('[data-topbar-title]');if(t)t.textContent='Daily / Weekly Report';try{history.replaceState(null,'','#work-reports')}catch{};render();window.scrollTo({top:0,behavior:'auto'})}
  function ensureNav(){const nav=q('[data-primary-nav]');if(!nav)return;const groups=qa('.nav-section',nav),sys=groups.find(g=>String(q('.nav-label',g)?.textContent||'').trim().toUpperCase()==='SYSTEM')||groups.at(-1);if(!sys)return;let a=q('[data-r36-nav]',sys);if(!a){a=document.createElement('a');a.href='#work-reports';a.dataset.r36Nav='';a.textContent='Daily / Weekly Report';const reports=qa('a',sys).find(x=>String(x.textContent||'').trim()==='Reports');reports?reports.insertAdjacentElement('beforebegin',a):sys.prepend(a)}a.onclick=e=>{e.preventDefault();e.stopImmediatePropagation();showPage()}}
  function ensureTop(){const top=q('.topbar-actions')||q('[data-topbar-actions]');if(!top||q('[data-r36-top-open]',top))return;const b=document.createElement('button');b.type='button';b.dataset.r36TopOpen='';b.textContent='Work Report';b.onclick=showPage;top.append(b)}
  function render(){const root=q('[data-page="WORK_REPORTS"]');if(!root)return;const c=context(),n=counts(c);q('[data-r36-context]',root).innerHTML=[['FLOW',n.flow,'Workflow steps'],['RISKS',n.risks,'Friction / Owner gap'],['EXPERIMENTS',n.experiments,'Open process experiments'],['EVENTS',n.events,'Recent 7-day events'],['REVIEWS',n.reviews,'Workflow review logs']].map(([l,v,s])=>`<div class="r36-context-card"><span>${l}</span><b>${v}</b><span>${s}</span></div>`).join('');q('[data-r36-sources]',root).innerHTML=sources(c).map(x=>`<div class="r36-source">Source · ${esc(x)}</div>`).join('')||'<div class="r36-source">현재 연결된 운영 Context가 적습니다. 보고 초안을 만든 뒤 사람이 실제 내용을 보완하세요.</div>';const dd=q('[data-r36-daily-date]',root);if(dd&&!dd.value)dd.value=today();const wd=q('[data-r36-weekly-date]',root);if(wd&&!wd.value)wd.value=monday();renderPreview('DAILY',root);renderPreview('WEEKLY',root);renderHistory(root)}
  function bind(){const root=q('[data-page="WORK_REPORTS"]');if(!root)return;qa('[data-r36-tab]',root).forEach(b=>b.onclick=()=>show(b.dataset.r36Tab));qa('.r36-form input,.r36-form textarea,.r36-form select',root).forEach(el=>el.addEventListener('input',()=>renderPreview(el.closest('[data-r36-mode]')?.dataset.r36Mode||'DAILY',root)));q('[data-r36-daily-auto]',root).onclick=()=>fill('DAILY',dailyDraft(context()),root);q('[data-r36-weekly-auto]',root).onclick=()=>fill('WEEKLY',weeklyDraft(context()),root);q('[data-r36-daily-form]',root).onsubmit=e=>{e.preventDefault();const r=saveReport(current('DAILY',root));q('[data-r36-daily-status]',root).textContent=`DRAFT 저장 · ${new Date(r.createdAt).toLocaleTimeString('ko-KR',{hour:'2-digit',minute:'2-digit'})}`;renderHistory(root)};q('[data-r36-weekly-form]',root).onsubmit=e=>{e.preventDefault();const r=saveReport(current('WEEKLY',root));q('[data-r36-weekly-status]',root).textContent=`DRAFT 저장 · ${new Date(r.createdAt).toLocaleTimeString('ko-KR',{hour:'2-digit',minute:'2-digit'})}`;renderHistory(root)};q('[data-r36-daily-copy]',root).onclick=()=>copy(reportText(current('DAILY',root)));q('[data-r36-weekly-copy]',root).onclick=()=>copy(reportText(current('WEEKLY',root)))}
  function addShortcut(){const reports=q('[data-page="REPORTS"]');if(reports&&!q('[data-r36-report-shortcut]',reports)){const box=document.createElement('section');box.className='card';box.dataset.r36ReportShortcut='';box.innerHTML='<div class="section-kicker">WORK REPORT BUILDER</div><h2>일일 / 주간 업무보고</h2><p class="why">Today · Workflow · Review Context를 사용해 보고 초안을 만들고 Human Confirm합니다.</p><button type="button" data-r36-open-page>업무보고 작성</button>';reports.querySelector('.sub')?.insertAdjacentElement('afterend',box);q('[data-r36-open-page]',box).onclick=()=>q('[data-fallback-page="WORK_REPORTS"]')?.click()}}
  document.addEventListener('DOMContentLoaded',()=>{ensureNav();ensureTop();render();bind();addShortcut()});setTimeout(()=>{ensureNav();ensureTop();render();bind();addShortcut()},100);const navRoot=q('[data-primary-nav]');if(navRoot)new MutationObserver(()=>ensureNav()).observe(navRoot,{childList:true,subtree:true});window.addEventListener('storage',e=>{if([KEY,FLOW,LINKS,EXP,EVENTS,ESC,REV,SNAP,KPI,TOP3].includes(e.key))render()});
})();
</script>
<script id="recovery-37-report-rhythm-script">
(()=>{
'use strict';
const q=(s,r=document)=>r.querySelector(s),qa=(s,r=document)=>[...r.querySelectorAll(s)];
const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const safe=(raw,f)=>{try{return raw?JSON.parse(raw):f}catch{return f}};
const r37Storage=window.__leaderOsStorage||(()=>{const m=new Map();return{getItem:k=>m.has(String(k))?m.get(String(k)):null,setItem:(k,v)=>m.set(String(k),String(v)),removeItem:k=>m.delete(String(k))}})();window.__leaderOsStorage=r37Storage;
const get=k=>{try{return localStorage.getItem(k)}catch{return r37Storage.getItem(k)}},set=(k,v)=>{const raw=JSON.stringify(v);try{localStorage.setItem(k,raw)}catch{r37Storage.setItem(k,raw)}};
const RHYTHM='leader-os:r37:report-rhythm:v1', REPORTS='leader-os:r36:work-reports:v1', CAL='leader-os:onboarding-calendar-draft:v1';
const localScope=()=>{try{const x=window.LeaderOsReportRuntimeBridge?.state?.();return x?.signedIn&&x.userId&&x.workspaceId?`${x.userId}:${x.workspaceId}`:'guest'}catch{return'guest'}};
const scopedPersonal=k=>`${k}:${localScope()}`;
const ART_KEYS=['leader-os:operating-artifacts:v6','leader-os:operating-artifacts:v5','leader-os:operating-artifacts:v4','leader-os:operating-artifacts:v3'];
const defaults={dailyEnabled:true,dailyTime:'17:30',weeklyEnabled:true,weeklyDay:5,weeklyTime:'16:00',autoPrepare:true,lastAutoDaily:null,lastAutoWeekly:null};
const read=(k,f)=>safe(get(k),f),write=(k,v)=>set(k,v);
function artifactStore(){
  const live=window.LeaderOsOperatingArtifactBridge?.snapshot?.();
  if(live&&typeof live==='object')return live;
  for(const k of ART_KEYS){const r=get(k);if(r)return safe(r,{})}
  return{};
}
function findCalendar(){const rows=[];const cal=read(scopedPersonal(CAL),{rows:[]});(cal.rows||[]).forEach(x=>rows.push({type:x.type||'CALENDAR',label:x.raw||'',source:'Onboarding Calendar'}));const a=artifactStore(),c=a.TEAM_CALENDAR||a.teamCalendar||a.calendar||[];const arr=Array.isArray(c)?c:(c?.rows||c?.items||[]);(Array.isArray(arr)?arr:[]).forEach(x=>rows.push({type:x.type||x.kind||'CALENDAR',label:x.event||x.title||x.name||x.raw||JSON.stringify(x),source:'TEAM_CALENDAR'}));return rows.slice(0,12)}
function reportRows(){return read(REPORTS,[])}
function dateKey(d=new Date()){return d.toISOString().slice(0,10)}
function mondayKey(d=new Date()){const x=new Date(d),day=(x.getDay()+6)%7;x.setDate(x.getDate()-day);return x.toISOString().slice(0,10)}
function timeMins(t){const [h,m]=String(t||'00:00').split(':').map(Number);return h*60+m}
function nowMins(){const d=new Date();return d.getHours()*60+d.getMinutes()}
function rhythm(){return {...defaults,...read(RHYTHM,{})}}
function hasDaily(){const t=dateKey();return reportRows().some(r=>r.type==='DAILY'&&r.date===t)}
function hasWeekly(){const m=mondayKey();return reportRows().some(r=>r.type==='WEEKLY'&&r.date===m)}
function dueState(){const r=rhythm(),d=new Date(),dailyDue=r.dailyEnabled&&nowMins()>=timeMins(r.dailyTime)&&!hasDaily(),weeklyDue=r.weeklyEnabled&&d.getDay()===Number(r.weeklyDay)&&nowMins()>=timeMins(r.weeklyTime)&&!hasWeekly();return{dailyDue,weeklyDue,r}}
function emptyFields(type,root){const p=type==='DAILY'?'daily':'weekly';return qa(`[data-r36-${p}-form] textarea`,root).every(x=>!x.value.trim())}
function serialize(type,root){const p=type==='DAILY'?'daily':'weekly',v=n=>q(`[data-r36-${p}-${n}]`,root)?.value||'';if(type==='DAILY')return{type,date:v('date'),to:v('to'),scope:v('scope'),author:v('author'),outcome:v('outcome'),progress:v('progress'),risk:v('risk'),ask:v('ask'),next:v('next'),evidence:v('evidence')};return{type,date:v('date'),to:v('to'),scope:v('scope'),author:v('author'),summary:v('summary'),outcome:v('outcome'),evidence:v('evidence'),risk:v('risk'),ask:v('ask'),next:v('next'),learning:v('learning')}}
function fiveLines(r){if(r.type==='DAILY')return [`1. Outcome · ${r.outcome||'—'}`,`2. Progress · ${(r.progress||'—').split('\n')[0]}`,`3. Risk · ${(r.risk||'—').split('\n')[0]}`,`4. Decision/Support · ${(r.ask||'—').split('\n')[0]}`,`5. Next · ${(r.next||'—').split('\n')[0]}`].join('\n');return [`1. Weekly Summary · ${r.summary||'—'}`,`2. Outcome · ${(r.outcome||'—').split('\n')[0]}`,`3. KPI/Risk · ${(r.evidence||r.risk||'—').split('\n')[0]}`,`4. Decision/Support · ${(r.ask||'—').split('\n')[0]}`,`5. Next Week · ${(r.next||'—').split('\n')[0]}`].join('\n')}
function detailed(r){if(r.type==='DAILY')return `[팀 공유용 · 일일업무보고]\n${r.date||''} · ${r.scope||'Scope 미정'}\n\nOUTCOME\n${r.outcome||'—'}\n\n완료 / 진행\n${r.progress||'—'}\n\nRISK / BLOCKER\n${r.risk||'—'}\n\nDECISION / SUPPORT\n${r.ask||'—'}\n\nNEXT\n${r.next||'—'}\n\nEVIDENCE\n${r.evidence||'—'}`;return `[팀 공유용 · 주간업무보고]\nWeek of ${r.date||''} · ${r.scope||'Scope 미정'}\n\nSUMMARY\n${r.summary||'—'}\n\nKEY OUTCOMES\n${r.outcome||'—'}\n\nKPI / EVIDENCE / LEARNING\n${r.evidence||'—'}\n\nRISKS\n${r.risk||'—'}\n\nDECISION / SUPPORT\n${r.ask||'—'}\n\nNEXT WEEK TOP 3\n${r.next||'—'}\n\nPROCESS / TEAM LEARNING\n${r.learning||'—'}`}
function personal(r){if(r.type==='DAILY')return `[개인 업무 기록]\n날짜 · ${r.date||''}\n\n오늘 만든 결과\n${r.outcome||'—'}\n\n내가 실제로 한 일\n${r.progress||'—'}\n\n막힌 것 / 배운 것\n${r.risk||'—'}\n${r.evidence||''}\n\n내일 첫 행동\n${r.next||'—'}`;return `[개인 주간 기록]\nWeek of ${r.date||''}\n\n이번 주 가장 중요한 결과\n${r.summary||r.outcome||'—'}\n\n배운 점\n${r.learning||r.evidence||'—'}\n\n다음 주 집중할 것\n${r.next||'—'}\n\n도움/결정이 필요한 것\n${r.ask||'—'}`}
let activeView='EXEC';
function viewText(r){return activeView==='TEAM'?detailed(r):activeView==='PERSONAL'?personal(r):fiveLines(r)}
async function copy(txt){try{await navigator.clipboard.writeText(txt)}catch{const ta=document.createElement('textarea');ta.value=txt;document.body.append(ta);ta.select();document.execCommand('copy');ta.remove()}}
function ensureUI(){const root=q('[data-page="WORK_REPORTS"]');if(!root)return null;let shell=q('[data-r37-shell]',root);if(!shell){shell=document.createElement('div');shell.className='r37-shell';shell.dataset.r37Shell='';const tabs=q('.r36-tabs',root);tabs?.insertAdjacentElement('beforebegin',shell)}let views=q('[data-r37-views]',root);if(!views){views=document.createElement('section');views.className='r37-card r37-views';views.dataset.r37Views='';const hist=q('[data-r36-history]',root),anchor=hist?.closest('section')||hist?.parentElement;if(anchor)anchor.insertAdjacentElement('beforebegin',views);else root.append(views)}return root}
function renderRhythm(root){const shell=q('[data-r37-shell]',root),s=dueState(),r=s.r,cal=findCalendar();shell.innerHTML=`<section class="r37-card"><div class="r37-head"><div><div class="r37-kicker">REPORT RHYTHM · CALENDAR LINK</div><h2>퇴근 전 Daily / 금요일 Weekly Draft 준비</h2><p>Team Calendar와 로컬 시간을 읽어 보고 시점을 알려줍니다. Preview에서는 앱이 열려 있을 때만 Draft를 자동 준비합니다.</p></div><span class="r37-state ${s.dailyDue||s.weeklyDue?'due':'ready'}">${s.dailyDue||s.weeklyDue?'DRAFT DUE':'RHYTHM READY'}</span></div><div class="r37-grid"><div><div class="r37-settings"><label>Daily draft time<input type="time" data-r37-daily-time value="${esc(r.dailyTime)}"></label><label>Weekly draft day<select data-r37-weekly-day>${[[1,'월'],[2,'화'],[3,'수'],[4,'목'],[5,'금']].map(([v,l])=>`<option value="${v}" ${Number(r.weeklyDay)===v?'selected':''}>${l}요일</option>`).join('')}</select></label><label>Weekly draft time<input type="time" data-r37-weekly-time value="${esc(r.weeklyTime)}"></label><label class="r37-toggle"><input type="checkbox" data-r37-auto ${r.autoPrepare?'checked':''}> 앱이 열려 있을 때 보고 시점이 되면 DRAFT 자동 준비</label></div><div class="r37-actions"><button type="button" class="primary" data-r37-save-rhythm>보고 리듬 저장</button><button type="button" data-r37-prepare-now>지금 초안 준비</button></div><div class="r37-note">Recovery 38 Server Scheduler가 준비되었습니다. 아래 Server Runtime에서 리듬을 저장하면 브라우저가 닫혀 있어도 DRAFT가 준비됩니다. 메일·Slack은 Human Confirm 후 READY까지만 만들며 실제 전송 Connector는 아직 연결하지 않습니다.</div></div><div><div class="r37-kicker">CALENDAR SIGNALS</div><div class="r37-calendar">${cal.length?cal.map(x=>`<div class="r37-cal-row"><span class="r37-cal-type">${esc(x.type)}</span><b>${esc(x.label)}</b><span>${esc(x.source)}</span></div>`).join(''):'<div class="r37-note">TEAM_CALENDAR 또는 Onboarding Calendar Draft가 아직 없습니다.</div>'}</div></div></div><div class="r37-readiness" style="margin-top:12px"><div class="r37-ready-card"><small>DAILY</small><b>${s.dailyDue?'지금 준비할 시간':'다음 Daily'}</b><p>${hasDaily()?'오늘 보고 Draft가 이미 있습니다.':`설정 ${esc(r.dailyTime)} · 오늘 Report 없음`}</p></div><div class="r37-ready-card"><small>WEEKLY</small><b>${s.weeklyDue?'이번 주 보고 준비':'Weekly cadence'}</b><p>${hasWeekly()?'이번 주 Weekly Draft가 이미 있습니다.':`요일 ${['일','월','화','수','목','금','토'][Number(r.weeklyDay)]} · ${esc(r.weeklyTime)}`}</p></div></div></section>`;bindRhythm(root)}
function renderViews(root){const box=q('[data-r37-views]',root),type=q('[data-r36-mode].active',root)?.dataset.r36Mode||'DAILY',r=serialize(type,root);box.innerHTML=`<div class="r37-head"><div><div class="r37-kicker">3 REPORT VIEWS</div><h2>같은 업무를 대상에 맞게 다르게 보여줍니다</h2><p>Executive는 판단에 필요한 5줄, Team은 공유 가능한 상세본, Personal은 나의 실행과 학습 기록입니다.</p></div><span class="r37-state">${type}</span></div><div class="r37-view-tabs"><button type="button" data-r37-view="EXEC" class="${activeView==='EXEC'?'active':''}">Executive · 5줄</button><button type="button" data-r37-view="TEAM" class="${activeView==='TEAM'?'active':''}">Team · 상세</button><button type="button" data-r37-view="PERSONAL" class="${activeView==='PERSONAL'?'active':''}">Personal · 기록</button></div><div class="r37-view-meta"><b>${activeView==='EXEC'?'상급자 판단용 요약':activeView==='TEAM'?'팀 공유용 상세 보고':'개인 업무·학습 기록'}</b><button type="button" data-r37-copy-view>현재 View 복사</button></div><div class="r37-view-output" data-r37-view-output>${esc(viewText(r))}</div>`;qa('[data-r37-view]',box).forEach(b=>b.onclick=()=>{activeView=b.dataset.r37View;renderViews(root)});q('[data-r37-copy-view]',box).onclick=()=>copy(viewText(serialize(type,root)))}
function saveRhythm(root){const r=rhythm();r.dailyTime=q('[data-r37-daily-time]',root)?.value||'17:30';r.weeklyDay=Number(q('[data-r37-weekly-day]',root)?.value||5);r.weeklyTime=q('[data-r37-weekly-time]',root)?.value||'16:00';r.autoPrepare=!!q('[data-r37-auto]',root)?.checked;write(RHYTHM,r);renderRhythm(root)}
function triggerDraft(type,root,saveDraft=false){const auto=q(`[data-r36-${type.toLowerCase()}-auto]`,root),form=q(`[data-r36-${type.toLowerCase()}-form]`,root);if(auto&&emptyFields(type,root))auto.click();if(saveDraft&&form){setTimeout(()=>{if(emptyFields(type,root))return;form.requestSubmit?.();setTimeout(()=>renderAll(),40)},20)}}
function prepareNow(root){const type=q('[data-r36-mode].active',root)?.dataset.r36Mode||'DAILY';triggerDraft(type,root,false);setTimeout(()=>renderAll(),50)}
function autoPrepare(root){const s=dueState(),r=s.r;if(!r.autoPrepare)return;if(s.dailyDue&&r.lastAutoDaily!==dateKey()){q('[data-r36-tab="DAILY"]',root)?.click();triggerDraft('DAILY',root,true);r.lastAutoDaily=dateKey();write(RHYTHM,r)}const wk=mondayKey();if(s.weeklyDue&&r.lastAutoWeekly!==wk){q('[data-r36-tab="WEEKLY"]',root)?.click();triggerDraft('WEEKLY',root,true);r.lastAutoWeekly=wk;write(RHYTHM,r)}}
function bindRhythm(root){q('[data-r37-save-rhythm]',root)?.addEventListener('click',()=>saveRhythm(root));q('[data-r37-prepare-now]',root)?.addEventListener('click',()=>prepareNow(root))}
function renderAll(){const root=ensureUI();if(!root)return;renderRhythm(root);renderViews(root)}
function attach(){const root=ensureUI();if(!root)return;qa('.r36-form input,.r36-form textarea,.r36-form select',root).forEach(el=>{if(el.dataset.r37Bound)return;el.dataset.r37Bound='1';el.addEventListener('input',()=>renderViews(root))});qa('[data-r36-tab]',root).forEach(b=>{if(b.dataset.r37Bound)return;b.dataset.r37Bound='1';b.addEventListener('click',()=>setTimeout(()=>renderViews(root),0))});setTimeout(()=>autoPrepare(root),300)}
document.addEventListener('DOMContentLoaded',()=>{renderAll();attach()});setTimeout(()=>{renderAll();attach()},180);document.addEventListener('click',e=>{if(e.target.closest('[data-r36-nav],[data-r36-top-open],[data-r36-open-page]'))setTimeout(()=>{renderAll();attach();autoPrepare(q('[data-page="WORK_REPORTS"]'))},120)},true);window.addEventListener('storage',e=>{if([RHYTHM,REPORTS,CAL,...ART_KEYS].includes(e.key))renderAll()});
window.addEventListener('leaderos:artifacts-changed',()=>renderAll());
})();
</script>
<style id="recovery-38-server-report-css">
.r38-card{background:var(--ui-surface,#fff);border:1px solid var(--ui-line,#e7e8eb);border-radius:16px;padding:18px;margin-bottom:16px}
.r38-head{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}
.r38-kicker{font-size:9px;font-weight:900;letter-spacing:.09em;color:var(--ui-muted,#6b7280)}
.r38-head h2{margin:5px 0 5px;font-size:17px}.r38-head p{margin:0;color:var(--ui-muted,#6b7280);font-size:11px;line-height:1.6}
.r38-state{display:inline-flex;align-items:center;padding:5px 8px;border-radius:999px;background:#eef2f4;color:#475467;font-size:9px;font-weight:900;white-space:nowrap}
.r38-state.live{background:#eaf7ee;color:#166534}.r38-state.warn{background:#fff7df;color:#854d0e}.r38-state.bad{background:#fef0f0;color:#b42318}
.r38-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:14px;margin-top:14px}
.r38-panel{border:1px solid var(--ui-line,#e7e8eb);border-radius:13px;padding:13px;background:var(--ui-surface-2,#fafbfc)}
.r38-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.r38-form label{display:grid;gap:5px;font-size:10px;font-weight:800;color:var(--ui-muted,#6b7280)}
.r38-form input,.r38-form select{width:100%;min-width:0;border:1px solid var(--ui-line,#dfe2e6);border-radius:8px;padding:8px;background:var(--ui-surface,#fff);color:var(--ui-ink,#16181d)}
.r38-toggle{display:flex!important;align-items:center;gap:7px!important;grid-template-columns:auto 1fr!important}.r38-toggle input{width:auto}
.r38-actions{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}.r38-actions button{min-height:34px}
.r38-note{font-size:10px;line-height:1.55;color:var(--ui-muted,#6b7280);margin-top:9px}
.r38-list{display:grid;gap:7px;margin-top:9px}.r38-row{display:grid;grid-template-columns:1fr auto;gap:9px;align-items:center;border:1px solid var(--ui-line,#e7e8eb);border-radius:10px;padding:9px;background:var(--ui-surface,#fff)}
.r38-row b{display:block;font-size:11px}.r38-row span{display:block;font-size:9px;color:var(--ui-muted,#6b7280);margin-top:2px;overflow-wrap:anywhere}
.r38-empty{padding:13px;border:1px dashed var(--ui-line,#dfe2e6);border-radius:10px;color:var(--ui-muted,#6b7280);font-size:10px;line-height:1.5}
.r38-status{font-size:10px;color:var(--ui-muted,#6b7280);margin-top:8px;min-height:16px}.r38-status.error{color:#b42318}
.r38-delivery{margin-top:12px;padding-top:11px;border-top:1px solid var(--ui-line,#e7e8eb)}
html[data-theme="dark"] .r38-state.live{background:#173922;color:#a7e9b9}
html[data-theme="dark"] .r38-state.warn{background:#45330f;color:#f9d979}
html[data-theme="dark"] .r38-state.bad{background:#451b1b;color:#fdb5b5}
@media(max-width:900px){.r38-grid{grid-template-columns:1fr}}
@media(max-width:620px){.r38-form{grid-template-columns:1fr}.r38-head{flex-direction:column}}
</style>
<script id="recovery-38-server-report-script">
(function(){
'use strict';
const q=(s,r=document)=>r.querySelector(s), qa=(s,r=document)=>Array.from(r.querySelectorAll(s));
const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
let state={runtime:null,loading:false,error:null,message:''};
function bridge(){return window.LeaderOsReportRuntimeBridge||null}
function bridgeState(){try{return bridge()?.state?.()||{signedIn:false,mode:'DEMO',workspaceId:null}}catch{return{signedIn:false,mode:'DEMO',workspaceId:null}}}
function root(){return q('[data-page="WORK_REPORTS"]')}
function reportId(r){return r.report_id||r.reportId||''}
function preparedAt(r){return r.prepared_at||r.preparedAt||''}
function periodKey(r){return r.period_key||r.periodKey||''}
function reportType(r){return r.report_type||r.reportType||''}
function version(r){return Number(r.version||1)}
function scheduleValue(k,def){const s=state.runtime?.schedule||{};return s[k]??def}
function ensure(){
  const page=root();if(!page)return null;
  let card=q('[data-r38-server]',page);
  if(!card){card=document.createElement('section');card.className='r38-card';card.dataset.r38Server='';const anchor=q('[data-r37-shell]',page)||q('.r36-tabs',page);anchor?.insertAdjacentElement('beforebegin',card)}
  return card
}
function stateLabel(){
  const b=bridgeState();
  if(state.loading)return['SERVER CHECK','warn'];
  if(state.error)return['SERVER ERROR','bad'];
  if(b.signedIn&&b.workspaceId&&state.runtime)return['SERVER RUNTIME READY','live'];
  if(b.signedIn&&b.workspaceId)return['SIGNED IN · REFRESH','warn'];
  return['LOGIN REQUIRED','warn'];
}
function fmtDate(v){if(!v)return'—';try{return new Date(v).toLocaleString('ko-KR',{month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'})}catch{return String(v)}}
function render(){
  const card=ensure();if(!card)return;
  const b=bridgeState(), [label,klass]=stateLabel(), rt=state.runtime||{}, reports=Array.isArray(rt.reports)?rt.reports:[], deliveries=Array.isArray(rt.deliveryQueue)?rt.deliveryQueue:[];
  const dailyEnabled=Boolean(scheduleValue('daily_enabled',false)), weeklyEnabled=Boolean(scheduleValue('weekly_enabled',false));
  const dailyTime=String(scheduleValue('daily_local_time','17:30:00')).slice(0,5), weeklyTime=String(scheduleValue('weekly_local_time','16:00:00')).slice(0,5);
  const weeklyDay=Number(scheduleValue('weekly_isodow',5)), tz=String(scheduleValue('timezone','Asia/Seoul'));
  card.innerHTML=`<div class="r38-head"><div><div class="r38-kicker">RECOVERY 38 · SERVER REPORT RUNTIME</div><h2>브라우저 밖에서도 보고 초안을 준비하는 운영 리듬</h2><p>Supabase Cron → Structured Context Draft → Human Confirm → Delivery READY → Audit. 자동 초안은 공유 범위 Context만 사용합니다.</p></div><span class="r38-state ${klass}">${label}</span></div>
  <div class="r38-grid"><div class="r38-panel"><div class="r38-kicker">SERVER SCHEDULE</div><div class="r38-form" style="margin-top:9px">
  <label>Timezone<input data-r38-timezone value="${esc(tz)}" readonly></label>
  <label class="r38-toggle"><input type="checkbox" data-r38-daily-enabled ${dailyEnabled?'checked':''}>Daily Server Draft</label>
  <label>Daily time<input type="time" data-r38-daily-time value="${esc(dailyTime)}"></label>
  <label class="r38-toggle"><input type="checkbox" data-r38-weekly-enabled ${weeklyEnabled?'checked':''}>Weekly Server Draft</label>
  <label>Weekly day<select data-r38-weekly-day>${[[1,'월'],[2,'화'],[3,'수'],[4,'목'],[5,'금'],[6,'토'],[7,'일']].map(([v,l])=>`<option value="${v}" ${weeklyDay===v?'selected':''}>${l}요일</option>`).join('')}</select></label>
  <label>Weekly time<input type="time" data-r38-weekly-time value="${esc(weeklyTime)}"></label></div>
  <div class="r38-actions"><button type="button" class="primary" data-r38-save>Server 리듬 저장</button><button type="button" data-r38-refresh>서버 상태 새로고침</button><select data-r38-prepare-type><option>DAILY</option><option>WEEKLY</option></select><button type="button" data-r38-prepare>서버 초안 지금 준비</button></div>
  <div class="r38-note">Cron은 5분마다 실행되지만 같은 workspace + report type + period는 한 번만 생성됩니다. PRIVATE / RESTRICTED Context는 서버 자동 보고서에서 제외됩니다.</div><div class="r38-status ${state.error?'error':''}" data-r38-status>${esc(state.error||state.message||(b.signedIn?`Workspace · ${b.workspaceName||b.workspaceId||'선택 필요'}`:'Live Runtime에 로그인하면 Server Schedule을 사용할 수 있습니다.'))}</div></div>
  <div class="r38-panel"><div class="r38-kicker">SERVER REPORTS · DRAFT → CONFIRMED</div><div class="r38-list">${reports.length?reports.slice(0,6).map(r=>`<div class="r38-row"><div><b>${esc(reportType(r))} · ${esc(periodKey(r))}</b><span>${esc(r.status)} · v${version(r)} · ${esc(fmtDate(preparedAt(r)))}</span></div>${r.status==='DRAFT'?`<button type="button" data-r38-confirm="${esc(reportId(r))}" data-version="${version(r)}">Human Confirm</button>`:`<button type="button" data-r38-queue="${esc(reportId(r))}">Manual READY</button>`}</div>`).join(''):'<div class="r38-empty">서버에 저장된 보고서가 아직 없습니다. Server 리듬을 저장하거나 지금 초안을 준비하세요.</div>'}</div>
  <div class="r38-delivery"><div class="r38-kicker">DELIVERY QUEUE</div><div class="r38-list">${deliveries.length?deliveries.slice(0,4).map(d=>`<div class="r38-row"><div><b>${esc(d.channel)} · ${esc(d.status)}</b><span>${esc(d.target_ref||'Manual handoff')} · ${esc(fmtDate(d.created_at))}</span></div><span class="r38-state">${esc(d.status)}</span></div>`).join(''):'<div class="r38-empty">외부 자동 전송은 아직 하지 않습니다. Confirmed Report만 READY 상태로 대기열에 올립니다.</div>'}</div></div></div></div>`;
  bind(card)
}
async function run(fn,ok){
  state.loading=true;state.error=null;state.message='';render();
  try{const res=await fn();if(ok)ok(res);state.message='완료';}
  catch(e){state.error=e?.code||e?.message||String(e)}
  finally{state.loading=false;render()}
}
async function refresh(){
  const b=bridge(); if(!b){state.error='REPORT_RUNTIME_BRIDGE_NOT_READY';render();return}
  await run(()=>b.status(20),res=>{state.runtime=res?.reportRuntime||null;state.message='Server Runtime 동기화 완료'})
}
function bind(card){
  q('[data-r38-refresh]',card)?.addEventListener('click',refresh);
  q('[data-r38-save]',card)?.addEventListener('click',()=>run(async()=>{
    const b=bridge();if(!b)throw new Error('REPORT_RUNTIME_BRIDGE_NOT_READY');
    return b.saveSchedule({
      timezone:q('[data-r38-timezone]',card)?.value||'Asia/Seoul',
      dailyEnabled:q('[data-r38-daily-enabled]',card)?.checked===true,
      dailyTime:q('[data-r38-daily-time]',card)?.value||'17:30',
      dailyWeekdays:[1,2,3,4,5],
      weeklyEnabled:q('[data-r38-weekly-enabled]',card)?.checked===true,
      weeklyIsoDow:Number(q('[data-r38-weekly-day]',card)?.value||5),
      weeklyTime:q('[data-r38-weekly-time]',card)?.value||'16:00'
    })
  },async()=>{state.message='Server 리듬 저장 완료';setTimeout(refresh,0)}));
  q('[data-r38-prepare]',card)?.addEventListener('click',()=>run(async()=>{
    const b=bridge();if(!b)throw new Error('REPORT_RUNTIME_BRIDGE_NOT_READY');
    return b.prepareNow(q('[data-r38-prepare-type]',card)?.value||'DAILY')
  },()=>{state.message='Server DRAFT 준비 완료';setTimeout(refresh,0)}));
  qa('[data-r38-confirm]',card).forEach(btn=>btn.addEventListener('click',()=>run(async()=>{
    const b=bridge();if(!b)throw new Error('REPORT_RUNTIME_BRIDGE_NOT_READY');
    return b.confirm(btn.dataset.r38Confirm,Number(btn.dataset.version||1),{confirmedFrom:'RECOVERY_38_UI'})
  },()=>{state.message='Human Confirm 완료';setTimeout(refresh,0)})));
  qa('[data-r38-queue]',card).forEach(btn=>btn.addEventListener('click',()=>run(async()=>{
    const b=bridge();if(!b)throw new Error('REPORT_RUNTIME_BRIDGE_NOT_READY');
    return b.queueManual(btn.dataset.r38Queue)
  },()=>{state.message='Delivery READY 생성 완료';setTimeout(refresh,0)})));
}
function attach(){render();const b=bridgeState();if(b.signedIn&&b.workspaceId&&!state.runtime&&!state.loading)refresh()}
document.addEventListener('DOMContentLoaded',()=>setTimeout(attach,450));
setTimeout(attach,900);
document.addEventListener('click',e=>{if(e.target.closest('[data-r36-nav],[data-r36-top-open],[data-r36-open-page]'))setTimeout(attach,180)},true);
window.LeaderOsR38={render,refresh,state:()=>({...state,bridge:bridgeState()})};
document.title='Leader OS · Recovery 38 · Server Report Runtime';
})();
</script>
<style id="recovery-39-auth-ops-css">
.r39-card{background:var(--ui-surface,#fff);border:1px solid var(--ui-line,#e7e8eb);border-radius:16px;padding:16px;margin:0 0 16px}
.r39-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.r39-kicker{font-size:9px;font-weight:900;letter-spacing:.09em;color:var(--ui-muted,#6b7280)}
.r39-head h2{margin:5px 0 4px;font-size:16px}.r39-head p{margin:0;font-size:10px;color:var(--ui-muted,#6b7280);line-height:1.55}
.r39-badge{display:inline-flex;padding:5px 8px;border-radius:999px;background:#eaf7ee;color:#166534;font-size:9px;font-weight:900;white-space:nowrap}.r39-badge.warn{background:#fff7df;color:#854d0e}.r39-badge.bad{background:#fef0f0;color:#b42318}
.r39-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;margin-top:12px}.r39-stat{border:1px solid var(--ui-line,#e7e8eb);border-radius:11px;padding:10px;background:var(--ui-surface-2,#fafbfc)}
.r39-stat span{display:block;font-size:9px;color:var(--ui-muted,#6b7280);font-weight:800}.r39-stat b{display:block;margin-top:4px;font-size:13px;overflow-wrap:anywhere}.r39-stat small{display:block;margin-top:3px;color:var(--ui-muted,#6b7280);font-size:9px;line-height:1.4}
.r39-note{margin-top:10px;padding:9px 10px;border-radius:10px;background:var(--ui-surface-2,#fafbfc);font-size:10px;line-height:1.55;color:var(--ui-muted,#6b7280)}
.r39-local-locked{opacity:.72}.r39-local-locked::before{content:"LOCAL PREVIEW · FALLBACK ONLY";display:inline-flex;margin:0 0 8px;padding:4px 7px;border:1px solid var(--ui-line,#e7e8eb);border-radius:999px;font-size:9px;font-weight:900;color:var(--ui-muted,#6b7280);background:var(--ui-surface,#fff)}
@media(max-width:900px){.r39-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.r39-grid{grid-template-columns:1fr}.r39-head{flex-direction:column}}
</style>
<script id="recovery-39-auth-ops-script">
(()=>{
'use strict';
const q=(s,r=document)=>r.querySelector(s),qa=(s,r=document)=>Array.from(r.querySelectorAll(s));
const esc=v=>String(v??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
let ops=null,error=null,loading=false;
function bridge(){return window.LeaderOsReportRuntimeBridge||null}
function bs(){try{return bridge()?.state?.()||{signedIn:false,workspaceId:null}}catch{return{signedIn:false,workspaceId:null}}}
function page(){return q('[data-page="WORK_REPORTS"]')}
function lockLocal(){const b=bs(),shell=q('[data-r37-shell]',page());if(!shell)return;const live=b.signedIn&&b.workspaceId;if(live){shell.classList.add('r39-local-locked');qa('input,select,button',shell).forEach(el=>{el.disabled=true});try{const k='leader-os:r37:report-rhythm:v1',r=JSON.parse(localStorage.getItem(k)||'{}');if(r.autoPrepare!==false){r.autoPrepare=false;localStorage.setItem(k,JSON.stringify(r))}}catch{}}else{shell.classList.remove('r39-local-locked')}}
function ensure(){const p=page();if(!p)return null;let c=q('[data-r39-ops]',p);if(!c){c=document.createElement('section');c.className='r39-card';c.dataset.r39Ops='';const anchor=q('[data-r38-server]',p)||q('[data-r37-shell]',p);anchor?.insertAdjacentElement('beforebegin',c)}return c}
function ftime(v){if(!v)return'—';try{return new Date(v).toLocaleString('ko-KR',{month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'})}catch{return String(v)}}
function render(){const c=ensure();if(!c)return;const b=bs(),authority=ops?.authority||{},cron=ops?.cron||{},del=ops?.delivery||{},latest=ops?.latestPeriod||{};const live=b.signedIn&&b.workspaceId;const badge=error?['OPS ERROR','bad']:loading?['OPS CHECK','warn']:live&&ops?['SERVER AUTHORITY','']:live?['REFRESH REQUIRED','warn']:['LOGIN REQUIRED','warn'];c.innerHTML=`<div class="r39-head"><div><div class="r39-kicker">RECOVERY 39 · AUTHENTICATED REPORT OPERATIONS</div><h2>운영 리듬의 Production Truth는 Server Schedule입니다</h2><p>Recovery 37의 로컬 리듬은 Preview/Fallback으로만 남기고, 실제 자동 초안과 감사 기록은 서버 기준으로 운영합니다.</p></div><span class="r39-badge ${badge[1]}">${badge[0]}</span></div><div class="r39-grid"><div class="r39-stat"><span>AUTHORITY</span><b>${esc(authority.productionSchedule||'SERVER')}</b><small>Local · ${esc(authority.localRecovery37||'PREVIEW_FALLBACK_ONLY')}</small></div><div class="r39-stat"><span>CRON</span><b>${esc(cron.lastStatus||'—')}</b><small>${esc(ftime(cron.lastCompletedAt))} · 24h fail ${esc(cron.failures24h??'—')}</small></div><div class="r39-stat"><span>LATEST PERIOD</span><b>${esc(latest.daily||'Daily —')}</b><small>${esc(latest.weekly||'Weekly —')}</small></div><div class="r39-stat"><span>DELIVERY QUEUE</span><b>READY ${esc(del.ready??0)}</b><small>FAILED ${esc(del.failed??0)} · SENT ${esc(del.sent??0)}</small></div></div><div class="r39-note">SENT/FAILED는 Connector의 실제 결과가 들어왔을 때만 기록합니다. UI 버튼은 SENT를 만들 수 없습니다. ${error?`Ops error · ${esc(error)}`:''}</div>`;lockLocal()}
async function refresh(){const b=bridge();if(!b?.ops){error='REPORT_OPS_BRIDGE_NOT_READY';render();return}if(!bs().signedIn||!bs().workspaceId){ops=null;error=null;render();return}loading=true;error=null;render();try{const res=await b.ops();ops=res?.reportOps||null}catch(e){error=e?.code||e?.message||String(e)}finally{loading=false;render()}}
function attach(){render();lockLocal();if(bs().signedIn&&bs().workspaceId&&!ops&&!loading)refresh()}
document.addEventListener('DOMContentLoaded',()=>setTimeout(attach,520));setTimeout(attach,1100);setInterval(()=>{lockLocal();const b=bs();if(b.signedIn&&b.workspaceId&&ops==null&&!loading)refresh()},2500);document.addEventListener('click',e=>{if(e.target.closest('[data-r36-nav],[data-r36-top-open],[data-r36-open-page]'))setTimeout(attach,200)},true);window.LeaderOsR39={refresh,state:()=>({ops,error,loading,bridge:bs()})};document.title='Leader OS · Recovery 39 · Authenticated Report Ops';
})();
</script>
<div aria-hidden="true" class="lo-search-overlay" data-lo-search-overlay="">
<section aria-label="Leader OS 전체 검색" aria-modal="true" class="lo-search-dialog" role="dialog">
<div class="lo-search-head">
<span class="lo-search-icon">⌕</span>
<input aria-label="Leader OS 검색" autocomplete="off" class="lo-search-input" data-lo-search-input="" placeholder="Quest, 도구, Artifact, 보고서, 결정 결과 검색…" type="search"/>
<button class="lo-search-close" data-lo-search-close="" type="button">ESC</button>
</div>
<div class="lo-search-filters" data-lo-search-filters="">
<button class="lo-search-filter active" data-search-filter="ALL" type="button">전체</button>
<button class="lo-search-filter" data-search-filter="TOOL" type="button">도구</button>
<button class="lo-search-filter" data-search-filter="QUEST" type="button">Quest</button>
<button class="lo-search-filter" data-search-filter="ARTIFACT" type="button">Artifact</button>
<button class="lo-search-filter" data-search-filter="RESULT" type="button">결과</button>
<button class="lo-search-filter" data-search-filter="ADDON" type="button">Add-on</button>
</div>
<div class="lo-search-results" data-lo-search-results=""></div>
<div class="lo-search-foot"><span><kbd>↑↓</kbd> 이동 <kbd>Enter</kbd> 열기 <kbd>Esc</kbd> 닫기</span><span>PRIVATE 1:1 메모 본문은 전역 인덱스에서 제외</span></div>
</section>
</div>
<script id="recovery-40-leadership-universal-search">
(function(){
  const q=(s,r=document)=>r.querySelector(s), qa=(s,r=document)=>Array.from(r.querySelectorAll(s));
  const overlay=q('[data-lo-search-overlay]'), input=q('[data-lo-search-input]'), results=q('[data-lo-search-results]'), filters=q('[data-lo-search-filters]');
  if(!overlay||!input||!results)return;
  let activeFilter='ALL', selected=0, current=[];
  const HISTORY_KEY='leader-os:r40:search-history:v1';
  const ARTIFACTS=[
    ['Manager Contract','상급자 기대 · 성공 기준 · 보고 리듬','REPORTS','상급자 기대 성공 기준 보고 manager contract'],
    ['Team Map','역할 · 책임 · 의존성 · Unknown','TEAM','팀맵 조직 역할 의존성 team map'],
    ['Team Pattern Board','1:1 반복 패턴 · 시스템 가설','ONE_ON_ONE','패턴 1:1 blocker team pattern'],
    ['Stakeholder Map','팀 밖 이해관계자 · 영향 · 접점','TEAM','stakeholder 이해관계자 외부 관계'],
    ['Team Calendar','Ritual · 1:1 · Milestone · Decision','MEETINGS','calendar 캘린더 회의 일정 리듬'],
    ['Work Map','Goal · Owner · Milestone · Open Decision','WORK','work map 프로젝트 owner 업무'],
    ['Milestone Card','Outcome · Evidence · Owner · Decision','WORK','milestone 마일스톤 완료기준'],
    ['WVR Card','Work · Value · Result','WORK','wvr work value result 업무 가치 결과'],
    ['Priority Contract','Top 3 · Not Now · Review','TODAY','priority 우선순위 top3'],
    ['Decision Rights Map','RAPID · Recommend · Decide','DECISIONS','decision rights rapid 결정권'],
    ['Delegation Matrix','업무별 권한 수준 · Checkpoint','WORK','delegation 위임 권한'],
    ['Delegation Contract','Outcome · Guardrail · Authority · Resources','WORK','delegation contract 위임 계약'],
    ['Feedback Draft','Situation · Behavior · Impact · Inquiry · Next','SKILLS','feedback sbi 피드백'],
    ['Project AAR','Expected · Actual · Why · Keep · Change · Next','REVIEW','aar debrief 회고'],
    ['Team OS Charter v1','팀 운영 원칙 · 리듬 · 결정 · 위임 · 리뷰','ONBOARDING','team os charter operating system 팀 운영체계']
  ];
  const ALIASES={
    TODAY:'오늘 top3 attention 우선순위',TEAM:'팀 team 사람 구조',PEOPLE:'사람 people context',ONE_ON_ONE:'1:1 원온원 면담 코칭',WORK:'업무 work 프로젝트 milestone',WORK_FLOW_MAP:'workflow flow 프로세스 병목',MEETINGS:'회의 meeting agenda',DECISIONS:'결정 decision rapid 결정권',WAYS_OF_WORKING:'일하는 방식 운영룰',TEAM_WORKING_AGREEMENT:'working agreement 팀 약속',WORK_REPORTS:'업무보고 daily weekly report 일일 주간',REPORTS:'보고 report 상급자 보고',SKILLS:'스킬 feedback coaching skill',ADD_ONS:'addon add-on 애드온 opicker omarket',AI_WORK_OS:'ai work os 자동화',AI_USAGE:'ai usage 비용 사용량',BILLING:'billing 결제 크레딧',REVIEW:'review 회고 aar 주간리뷰',LEADER_LANGUAGE:'leader language 말하기 문장 표현',LEADER_ONBOARDING:'온보딩 onboarding 신임 팀장 첫날 첫주',ONBOARDING:'30일 quest leadership practicum 리더십'};
  const safeText=s=>String(s||'').replace(/\s+/g,' ').trim();
  const norm=s=>safeText(s).toLocaleLowerCase().normalize('NFKC');
  const add=(arr,x)=>{if(!x||!x.title)return;const key=[x.type,x.page,x.title,x.day||'',x.anchor||''].join('|');if(arr.some(v=>v._key===key))return;arr.push({...x,_key:key,search:norm([x.title,x.subtitle,x.keywords,x.page,x.type].join(' '))})};
  function buildIndex(){
    const idx=[];
    qa('[data-primary-nav] a,[data-r21-onboarding-nav],[data-ai25-system-page],[data-ai26-nav]').forEach(a=>{
      const page=a.dataset.fallbackPage||a.dataset.ai25SystemPage||a.dataset.ai26Nav||(a.dataset.r21OnboardingNav!==undefined?'LEADER_ONBOARDING':null);
      if(!page)return; const title=safeText(a.textContent); const type=page==='ADD_ONS'?'ADDON':'TOOL';
      add(idx,{type,title,subtitle:type==='ADDON'?'Leader OS specialist add-on':'Leader OS 화면 / 도구',page,keywords:ALIASES[page]||''});
    });
    // Always make the two onboarding entry points searchable even when their nav is dynamically inserted later.
    add(idx,{type:'TOOL',title:'Leader Onboarding',subtitle:'15분 Quick Start → 첫날 → 첫주 → 첫 30일',page:'LEADER_ONBOARDING',keywords:ALIASES.LEADER_ONBOARDING});
    add(idx,{type:'TOOL',title:'30-Day Leadership Quest',subtitle:'Learn → Case → Do → Evidence → Debrief → Nudge',page:'ONBOARDING',keywords:ALIASES.ONBOARDING});
    qa('[data-quest-day],[data-quest-item]').forEach(row=>{
      const d=Number(String(row.dataset.questDay||row.dataset.questItem||'').replace(/\D/g,'')); if(!d)return;
      const title=safeText(q('.quest-row-copy strong',row)?.textContent||row.textContent); const artifact=safeText(q('.quest-row-copy small',row)?.textContent);
      add(idx,{type:'QUEST',title:`Day ${d} · ${title}`,subtitle:artifact||'30-Day Leadership Quest',page:'ONBOARDING',day:d,keywords:`day ${d} ${artifact}`});
    });
    ARTIFACTS.forEach(([title,subtitle,page,keywords])=>add(idx,{type:'ARTIFACT',title,subtitle,page,artifact:title,keywords}));
    const safePages=['TODAY','WORK','WORK_FLOW_MAP','MEETINGS','DECISIONS','REVIEW','REPORTS','WORK_REPORTS','WAYS_OF_WORKING','TEAM_WORKING_AGREEMENT','AI_WORK_OS','AI_USAGE'];
    safePages.forEach(page=>{
      const root=q(`[data-page="${page}"]`); if(!root)return;
      qa('section.card,.review-card,.decision-card,.flow-step,.r31-signal,.r36-report-card,.r37-report-card',root).slice(0,40).forEach((el,i)=>{
        const title=safeText(q('h2,h3,h4,strong,b',el)?.textContent); if(!title||title.length<3)return;
        const subtitle=safeText(q('p,.why,.review-meta,.status,small',el)?.textContent).slice(0,180);
        if(!el.id)el.id=`lo-r40-${page.toLowerCase()}-${i}`;
        add(idx,{type:'RESULT',title,subtitle:subtitle||`${page} 결과`,page,anchor:el.id,keywords:`${ALIASES[page]||''} ${subtitle}`});
      });
    });
    // Search the existence of sensitive tools without indexing private note bodies.
    add(idx,{type:'TOOL',title:'1:1',subtitle:'PRIVATE 기본값 · 메모 본문은 전역 검색 제외',page:'ONE_ON_ONE',keywords:ALIASES.ONE_ON_ONE});
    add(idx,{type:'TOOL',title:'People',subtitle:'People Context 화면 · 숨은 직원 점수화 금지',page:'PEOPLE',keywords:ALIASES.PEOPLE});
    return idx;
  }
  function score(item,term){if(!term)return item.type==='QUEST'?20:item.type==='TOOL'?18:10;const t=norm(term),parts=t.split(' ').filter(Boolean);let s=0;for(const p of parts){if(norm(item.title).includes(p))s+=14;if(item.search.includes(p))s+=5;if(norm(item.type).includes(p))s+=2}if(norm(item.title).startsWith(t))s+=12;return s}
  function visibleIndex(){const term=input.value;let arr=buildIndex().map(x=>({...x,_score:score(x,term)})).filter(x=>!term||x._score>0);if(activeFilter!=='ALL')arr=arr.filter(x=>x.type===activeFilter);arr.sort((a,b)=>b._score-a._score||a.title.localeCompare(b.title,'ko'));return arr.slice(0,40)}
  function badge(type){return type==='TOOL'?'도구':type==='QUEST'?'QUEST':type==='ARTIFACT'?'ARTIFACT':type==='RESULT'?'결과':'ADD-ON'}
  function render(){current=visibleIndex();selected=Math.min(selected,Math.max(0,current.length-1));results.innerHTML=current.length?current.map((x,i)=>`<button type="button" class="lo-search-result ${i===selected?'selected':''}" data-search-result="${i}"><span class="lo-search-type ${x.type.toLowerCase()}">${badge(x.type)}</span><span class="lo-search-copy"><strong>${escapeHtml(x.title)}</strong><small>${escapeHtml(x.subtitle||'')}</small></span><span class="lo-search-route">${x.day?`DAY ${x.day}`:escapeHtml(x.page||'')}</span></button>`).join(''):`<div class="lo-search-empty"><b>검색 결과가 없습니다.</b><br>예: “결정권”, “보고”, “위임”, “Day 22”, “Team Map”<div class="lo-search-privacy">보안상 PRIVATE 1:1 메모의 본문은 전역 검색하지 않습니다. 1:1 화면은 검색 결과에서 바로 열 수 있습니다.</div></div>`;qa('[data-search-result]',results).forEach(b=>b.onclick=()=>openItem(current[Number(b.dataset.searchResult)]));}
  function escapeHtml(v){return String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}
  function openPage(page){
    if(page==='LEADER_ONBOARDING'){const nav=q('[data-r21-onboarding-nav]');if(nav){nav.click();return}const target=q('[data-page="LEADER_ONBOARDING"]');if(target){qa('[data-page]').forEach(x=>x.hidden=x!==target);q('[data-topbar-title]').textContent='Leader Onboarding';return}}
    if(page==='ONBOARDING'){q('[data-onboarding-open]')?.click();return}
    const nav=q(`[data-fallback-page="${page}"]`)||q(`[data-ai25-system-page="${page}"]`)||q(`[data-ai26-nav="${page}"]`);if(nav){nav.click();return}
    const target=q(`[data-page="${page}"]`);if(target){qa('[data-page]').forEach(x=>x.hidden=x!==target);q('[data-topbar-title]').textContent=safeText(nav?.textContent)||page}
  }
  function remember(x){try{const h=JSON.parse(localStorage.getItem(HISTORY_KEY)||'[]').filter(v=>v._key!==x._key);h.unshift({title:x.title,type:x.type,page:x.page,_key:x._key});localStorage.setItem(HISTORY_KEY,JSON.stringify(h.slice(0,8)))}catch{}}
  function openItem(x){if(!x)return;remember(x);close();openPage(x.page);setTimeout(()=>{
      if(x.type==='QUEST'&&x.day){const row=q(`[data-quest-day="${x.day}"]`)||qa('[data-quest-item]')[x.day-1];row?.click?.();row?.scrollIntoView?.({behavior:'smooth',block:'center'});return}
      if(x.type==='ARTIFACT'){const shell=q('.artifact-shell');if(shell){const btn=qa('[data-artifact-tabs] button',shell).find(b=>norm(b.textContent).includes(norm(x.title.split(' v1')[0]))||norm(x.title).includes(norm(b.textContent)));btn?.click?.();shell.scrollIntoView({behavior:'smooth',block:'start'})}return}
      if(x.anchor){q('#'+CSS.escape(x.anchor))?.scrollIntoView({behavior:'smooth',block:'center'})}
    },120)}
  function open(){overlay.classList.add('open');overlay.setAttribute('aria-hidden','false');selected=0;input.value='';render();setTimeout(()=>input.focus(),10)}
  function close(){overlay.classList.remove('open');overlay.setAttribute('aria-hidden','true')}
  function ensureTrigger(){const top=q('.topbar-actions');if(!top||q('[data-lo-search-open]',top))return;const b=document.createElement('button');b.type='button';b.className='lo-search-trigger';b.dataset.loSearchOpen='';b.innerHTML='<span class="lo-search-left"><span>⌕</span><span>전체 검색</span></span><span class="lo-search-kbd">⌘K</span>';const ask=q('[data-go-ask]',top);ask?ask.insertAdjacentElement('beforebegin',b):top.prepend(b);b.onclick=open}
  input.addEventListener('input',()=>{selected=0;render()});
  filters.addEventListener('click',e=>{const b=e.target.closest('[data-search-filter]');if(!b)return;activeFilter=b.dataset.searchFilter;qa('[data-search-filter]',filters).forEach(x=>x.classList.toggle('active',x===b));selected=0;render()});
  q('[data-lo-search-close]')?.addEventListener('click',close);overlay.addEventListener('mousedown',e=>{if(e.target===overlay)close()});
  document.addEventListener('keydown',e=>{
    const tag=document.activeElement?.tagName;const typing=['INPUT','TEXTAREA','SELECT'].includes(tag);
    if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==='k'){e.preventDefault();overlay.classList.contains('open')?close():open();return}
    if(!overlay.classList.contains('open'))return;
    if(e.key==='Escape'){e.preventDefault();close()}else if(e.key==='ArrowDown'){e.preventDefault();selected=Math.min(current.length-1,selected+1);render();q(`[data-search-result="${selected}"]`)?.scrollIntoView({block:'nearest'})}else if(e.key==='ArrowUp'){e.preventDefault();selected=Math.max(0,selected-1);render();q(`[data-search-result="${selected}"]`)?.scrollIntoView({block:'nearest'})}else if(e.key==='Enter'){e.preventDefault();openItem(current[selected])}
  });
  function makeOnboardingDefault(){if(location.hash)return;setTimeout(()=>{const nav=q('[data-r21-onboarding-nav]');if(nav)nav.click();},260)}
  ensureTrigger();setTimeout(ensureTrigger,400);setTimeout(makeOnboardingDefault,450);
  window.LeaderOsSearch={open,close,buildIndex,openItem};
})();
</script>
<script id="recovery-42-sample-map-library">
(function(){
  const KEY='leader-os:r42:sample-map-library:v1';
  const DEFAULT_IMAGES={STARBUCKS:"data:image/png;base64,